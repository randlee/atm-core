---
required_variables:
  - output_path
  - json_output_path
  - title
  - status
  - status_class
  - summary_html
  - sections_html
defaults:
  subtitle: ""
  generated_at: ""
  recommendations_html: ""
  footer_html: ""
metadata:
  purpose: Main HTML report template for architecture view index
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <style type="text/css">
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 0; padding: 24px; color: #1f2937; background: #f8fafc; }
    header { margin-bottom: 20px; }
    h1 { margin: 0 0 8px 0; }
    h2 { margin-top: 0; }
    .subtitle { color: #475569; margin: 0 0 8px 0; }
    .generated-at { color: #64748b; font-size: 14px; margin: 0; }
    .status { display: inline-block; margin-top: 10px; padding: 4px 10px; border-radius: 999px; font-weight: 700; border: 1px solid transparent; }
    .status-pass { background: #f0fdf4; color: #065f46; border-color: #6ee7b7; }
    .status-drift { background: #fffbeb; color: #92400e; border-color: #f59e0b; }
    .status-error, .status-not-supported { background: #fef2f2; color: #991b1b; border-color: #ef4444; }
    .status-info { background: #eff6ff; color: #1e40af; border-color: #3b82f6; }
    .summary, .section, .recommendations, footer { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px; margin-top: 16px; }
    .section-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .section-actions { display: flex; gap: 8px; }
    .icon-button { width: 30px; height: 30px; border-radius: 999px; border: 1px solid #cbd5e1; background: #ffffff; color: #334155; font-size: 14px; cursor: pointer; }
    .icon-button:hover { background: #f8fafc; }
    .fragments { margin-top: 8px; font-size: 14px; color: #475569; }
    table { width: 100%; border-collapse: collapse; margin: 8px 0; }
    th, td { border: 1px solid #d1d5db; padding: 8px; text-align: left; vertical-align: top; }
    th { background: #f3f4f6; }
    .verdict { background: #f0fdf4; border-left: 4px solid #10b981; padding: 12px; margin-top: 12px; }
    .impact { background: #eff6ff; border-left: 4px solid #3b82f6; padding: 12px; margin-top: 12px; }
    .action { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 12px; margin-top: 12px; }
    .warning { background: #fef2f2; border-left: 4px solid #ef4444; padding: 12px; margin-top: 12px; }
    .scratchpad { margin-top: 12px; padding: 12px; border-left: 4px solid #3b82f6; background: #eff6ff; }
    pre { background: #111827; color: #e5e7eb; padding: 12px; border-radius: 8px; overflow-x: auto; }
    code { background: #f3f4f6; padding: 2px 6px; border-radius: 4px; }
  </style>
</head>
<body>
  <!-- output_path: {{ output_path }} -->
  <!-- json_output_path: {{ json_output_path }} -->
  <header>
    <h1>{{ title }}</h1>
{% if subtitle %}
    <p class="subtitle">{{ subtitle }}</p>
{% endif %}
{% if generated_at %}
    <p class="generated-at">Generated: {{ generated_at }}</p>
{% endif %}
    <div class="status {{ status_class }}">{{ status }}</div>
  </header>

  <section class="summary">
{{ summary_html }}
  </section>

{{ sections_html }}

{% if recommendations_html %}
  <section class="recommendations">
    <h2>Recommendations</h2>
{{ recommendations_html }}
  </section>
{% endif %}

{% if footer_html %}
  <footer>
{{ footer_html }}
  </footer>
{% endif %}
  <script type="text/javascript">
    document.addEventListener("click", async function (event) {
      const button = event.target.closest("[data-copy-text]");
      if (!button) return;
      const text = button.getAttribute("data-copy-text") || "";
      try {
        await navigator.clipboard.writeText(text);
        button.setAttribute("title", "Copied");
      } catch (err) {
        button.setAttribute("title", "Copy failed");
      }
    });
  </script>
</body>
</html>
