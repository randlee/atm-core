%% title: `Query Mailbox Metadata Rows`
%% summary: Public sqlite-store method `query_mailbox_metadata_rows`.
%% commentary: This SQL path returns bounded mailbox header rows. It joins immutable message rows with the unified mutable state row, filters deleted and expired messages, then decodes the row set into `MailboxMetadataRow` values.
%% read_tables: mail_messages, mail_message_states
%% write_tables:
%% notes: reads: 1 | writes: 0 | joins: 1 | transactions: 0
%% sets: query
flowchart TD
    A["<b>Query Mailbox Metadata Rows</b><br/>query_mailbox_metadata_rows"]
    A --> I["Input
team
agent
limit"]
    I --> R["Read bounded rows
SELECT mail_messages ...
LEFT JOIN mail_message_states ...
WHERE team, agent
exclude deleted_at
exclude expired expires_at
ORDER BY message_at DESC, message_key DESC
LIMIT ?"]
    R --> D["Decode result rows
parse message_key
parse message_id?
parse parent_message_id?
parse message_at
derive read and pending_ack"]
    D --> O["Output
Vec<MailboxMetadataRow>"]
    R --> ER["Read failed
Mailbox lock timeout
Mailbox read failed"]
    D --> EM["Decode failed
Validation failed"]

