{
  "schema_version": 1,
  "commands": [
    {
      "id": "start-until-hook",
      "argv": [
        "cron",
        "start",
        "nightly",
        "--cron",
        "0 */5 * * * *",
        "--module",
        "./cron.py",
        "--phase",
        "bk",
        "--cwd",
        ".",
        "--until-hook",
        "--arg",
        "status",
        "--arg",
        "--json",
        "--custom",
        "{\"goal\":\"ship\"}"
      ],
      "valid": true,
      "checks": [
        "six-fields",
        "relative-module-and-cwd",
        "repeated-arg-including-hyphen-value",
        "custom-object",
        "until-hook"
      ]
    },
    {
      "id": "start-until-utc",
      "argv": [
        "cron",
        "start",
        "reminder",
        "--cron",
        "0 0 2 * * * 2030",
        "--module",
        "./cron.py",
        "--phase",
        "bk",
        "--until",
        "2030-11-01T02:00:00+02:00"
      ],
      "valid": true,
      "checks": [
        "seven-fields",
        "rfc3339-normalizes-to-utc",
        "until"
      ]
    },
    {
      "id": "start-alias",
      "argv": [
        "cron",
        "start",
        "hourly",
        "--cron",
        "@hourly",
        "--module",
        "./cron.py",
        "--phase",
        "bk",
        "--until-hook"
      ],
      "valid": true,
      "checks": [
        "supported-alias"
      ]
    },
    {
      "id": "list-json",
      "argv": [
        "cron",
        "list",
        "--phase",
        "bk",
        "--json"
      ],
      "valid": true,
      "checks": [
        "list-filter",
        "json"
      ]
    },
    {
      "id": "end-one",
      "argv": [
        "cron",
        "end",
        "--phase",
        "bk",
        "nightly"
      ],
      "valid": true,
      "checks": [
        "manual-stop-one"
      ]
    },
    {
      "id": "end-phase",
      "argv": [
        "cron",
        "end",
        "--phase",
        "bk"
      ],
      "valid": true,
      "checks": [
        "manual-stop-phase"
      ]
    },
    {
      "id": "reject-five-fields",
      "expression": "* * * * *",
      "valid": false,
      "deferred_execution": false
    },
    {
      "id": "reject-missing-stop",
      "argv": [
        "cron",
        "start",
        "bad",
        "--cron",
        "0 * * * * *",
        "--module",
        "./cron.py",
        "--phase",
        "bk"
      ],
      "valid": false,
      "checks": [
        "exactly-one-stop"
      ]
    },
    {
      "id": "reject-both-stops",
      "argv": [
        "cron",
        "start",
        "bad",
        "--cron",
        "0 * * * * *",
        "--module",
        "./cron.py",
        "--phase",
        "bk",
        "--until",
        "2030-11-01T00:00:00Z",
        "--until-hook"
      ],
      "valid": false,
      "checks": [
        "mutually-exclusive-stop-flags"
      ]
    },
    {
      "id": "reject-invalid-custom",
      "argv": [
        "cron",
        "start",
        "bad",
        "--cron",
        "0 * * * * *",
        "--module",
        "./cron.py",
        "--phase",
        "bk",
        "--until-hook",
        "--custom",
        "[1]"
      ],
      "valid": false,
      "checks": [
        "custom-must-be-object"
      ]
    },
    {
      "id": "reject-foreign-from",
      "classification": "rejection",
      "deferred_execution": true,
      "reply": {
        "result": "handled",
        "atm-action": [
          {
            "command": "send",
            "from": "other@atm-dev",
            "request": {
              "to": "team-lead",
              "message": "status"
            }
          }
        ]
      }
    },
    {
      "id": "reject-malformed-output",
      "classification": "rejection",
      "deferred_execution": true,
      "reply": {
        "result": "pass-through",
        "cron-output": [
          {
            "kind": "message",
            "body": ""
          }
        ]
      }
    },
    {
      "id": "hook-register-json-contract",
      "argv": [
        "hook",
        "register",
        "task.close",
        "--module",
        "./hooks.py",
        "--phase",
        "bk",
        "--json"
      ],
      "valid": true,
      "deferred_execution": true,
      "checks": [
        "frozen-bk9-register-json"
      ]
    },
    {
      "id": "hook-disable-one-json-contract",
      "argv": [
        "hook",
        "disable",
        "--phase",
        "bk",
        "task.close",
        "--json"
      ],
      "valid": true,
      "deferred_execution": true,
      "checks": [
        "frozen-bk9-disable-single-json"
      ]
    },
    {
      "id": "hook-disable-phase-json-contract",
      "argv": [
        "hook",
        "disable",
        "--phase",
        "bk",
        "--json"
      ],
      "valid": true,
      "deferred_execution": true,
      "checks": [
        "frozen-bk9-disable-phase-json"
      ]
    },
    {
      "id": "hook-disable-no-match-json-contract",
      "argv": [
        "hook",
        "disable",
        "--phase",
        "missing",
        "--json"
      ],
      "valid": true,
      "deferred_execution": true,
      "checks": [
        "frozen-bk9-disable-empty-json"
      ]
    }
  ],
  "expressions": [
    {
      "id": "six-field",
      "value": "0 */5 * * * *",
      "valid": true
    },
    {
      "id": "seven-field",
      "value": "0 0 2 * * * 2030",
      "valid": true
    },
    {
      "id": "alias-yearly",
      "value": "@yearly",
      "valid": true
    },
    {
      "id": "alias-monthly",
      "value": "@monthly",
      "valid": true
    },
    {
      "id": "alias-weekly",
      "value": "@weekly",
      "valid": true
    },
    {
      "id": "alias-daily",
      "value": "@daily",
      "valid": true
    },
    {
      "id": "alias-hourly",
      "value": "@hourly",
      "valid": true
    },
    {
      "id": "five-field",
      "value": "* * * * *",
      "valid": false
    },
    {
      "id": "malformed",
      "value": "x y",
      "valid": false
    }
  ],
  "replies": [
    {
      "id": "pass-through",
      "hook": "cron.tick",
      "json": {
        "result": "pass-through"
      },
      "expected_outcome": "ok",
      "outputs": []
    },
    {
      "id": "handled-explicit-creator",
      "hook": "cron.tick",
      "json": {
        "result": "handled",
        "atm-action": [
          {
            "command": "send",
            "from": "creator@atm-dev",
            "request": {
              "home_dir": "/repo",
              "current_dir": "/repo",
              "caller_identity": "cron",
              "caller_team": "atm-dev",
              "to": "team-lead@atm-dev",
              "message_source": {
                "Inline": "Nightly check complete"
              },
              "classification": {
                "category": null,
                "tags": [],
                "content_format": null
              },
              "summary_override": null,
              "requires_ack": false,
              "task_id": null,
              "dry_run": false
            }
          }
        ]
      },
      "expected_outcome": "actions: 1",
      "outputs": []
    },
    {
      "id": "custom-error-output",
      "hook": "cron.tick",
      "json": {
        "result": "pass-through",
        "cron-output": [
          {
            "kind": "error",
            "body": "One source is unavailable"
          }
        ]
      },
      "expected_outcome": "ok",
      "outputs": [
        {
          "sender": "cron@tool",
          "recipient": "creator@atm-dev",
