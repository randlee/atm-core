      "json": {
        "result": "pass-through",
        "cron-output": [
          {
            "kind": "message",
            "body": "All checks passed"
          }
        ]
      },
      "expected_outcome": "ok",
      "outputs": [
        {
          "sender": "cron@tool",
          "recipient": "creator@atm-dev",
          "category": "cron",
          "tag": "output:message",
          "body": "All checks passed"
        }
      ]
    },
    {
      "id": "message-output",
      "hook": "cron.tick",
      "json": {
        "result": "pass-through",
        "cron-output": [
          {
            "kind": "message",
            "body": "All checks passed"
          }
        ]
      },
      "expected_outcome": "ok",
      "outputs": [
        {
          "sender": "cron@tool",
          "recipient": "creator@atm-dev",
          "category": "cron",
          "tag": "output:message",
          "body": "All checks passed"
        }
      ]
    },
    {
      "id": "stop-true",
      "hook": "cron.stop",
      "json": {
        "stop": true,
        "reason": "phase complete",
        "cron-output": [
          {
            "kind": "message",
            "body": "Phase complete"
          }
        ]
      },
      "expected_outcome": "stopped: phase complete",
      "outputs": [
        {
          "sender": "cron@tool",
          "recipient": "creator@atm-dev",
          "category": "cron",
          "tag": "output:message",
          "body": "Phase complete"
        }
      ]
    },
    {
      "id": "stop-false",
