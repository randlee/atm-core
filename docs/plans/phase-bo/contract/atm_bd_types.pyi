# atm-bd-types 0.3.0 plug-in surface: what a profile plug-in imports. The names the lite hooks use, read-only facts,
# Params, the Actions the cron decide returns (Cron), and the Profile manifest. Framework names: atm_bd_core.pyi.
import builtins
import enum
import typing

Sha: typing.TypeAlias = str
r"""40-hex commit id (Rust `Sha`)."""

class Status(enum.Enum):
    OPEN = ...
    IN_PROGRESS = ...
    BLOCKED = ...
    DEFERRED = ...
    CLOSED = ...

class Stage(enum.Enum):
    r"""The bead's stage label; unknown labels are OTHER."""
    DEV = ...
    FIX = ...
    QA = ...
    LAND = ...
    STACK = ...
    OTHER = ...

class AssignTransition(enum.Enum):
    ASSIGN_SAME = ...
    ASSIGN = ...
    ASSIGN_CLOSED = ...
    ASSIGN_NOT_READY = ...
    @staticmethod
    def select(status: Status, assignee: str | None, wanted: str) -> AssignTransition: ...

class StartTransition(enum.Enum):
    START = ...
    START_AGAIN = ...
    START_CLOSED = ...
    START_NOT_READY = ...
    @staticmethod
    def select(status: Status) -> StartTransition: ...

class CloseTransition(enum.Enum):
    GIVE_BACK = ...
    WORK_CLOSE = ...
    QA_PASS = ...
    QA_FINDINGS = ...
    LAND = ...
    @staticmethod
    def select(req: HookRequest, bead: Bead) -> CloseTransition | Refusal:
        r"""outcome x stage (x verdict kind for QA); REQUEST_INVALID / QA_VERDICT when they do not decode."""


class Template(enum.Enum):
    REFUSE = ...
    DEV_CLOSE = ...
    QA_PASS = ...
    QA_FINDINGS = ...
    LAND_CLOSE = ...

class ErrorId(enum.Enum):
    REQUEST_INVALID = ...
    PHASE_UNREADABLE = ...
    PROFILE_MISMATCH = ...
    CACHE_UNAVAILABLE = ...
    BEAD_NOT_FOUND = ...
    BEAD_NOT_READY = ...
    BEAD_CLOSED = ...
    BEAD_RACED = ...
    ASSIGN_NOT_LEAD = ...
    TASK_NOT_ASSIGNEE = ...
    CLOSE_REASON_EMPTY = ...
    CLOSE_REPORT_NOT_INLINE = ...
    STACK_NOT_RECORDED = ...
    QA_VERDICT = ...
    QA_NOT_ON_STACK = ...
    QA_NOTHING_TO_REVIEW = ...
    FINDINGS_NOT_POURED = ...
    POLICY_BAD_PARAMS = ...
    LAND_EVIDENCE = ...

@typing.final
class Refusal:
    def __new__(cls, id: ErrorId, **context: str | list[str]) -> Refusal: ...
    @property
    def id(self) -> ErrorId: ...

@typing.final
class Layer:
    @property
    def branch(self) -> str: ...
    @property
    def head(self) -> Sha: ...
    @property
    def pr(self) -> int: ...
    @property
    def base(self) -> str: ...

@typing.final
class Stack:
    @property
    def layers(self) -> list[Layer]: ...

@typing.final
class Finding:
    @property
    def id(self) -> str: ...
    @property
    def blocking(self) -> bool: ...

@typing.final
class QaPass:
    @property
    def sha(self) -> str: ...

@typing.final
class QaFail:
    @property
    def sha(self) -> str: ...
    @property
    def findings(self) -> list[Finding]: ...

@typing.final
class Bead:
    @property
    def id(self) -> str: ...
    @property
    def status(self) -> Status: ...
    @property
    def stage(self) -> Stage: ...
    @property
    def assignee(self) -> str | None: ...
    @property
    def open_blockers(self) -> list[str]: ...
    @property
    def branch(self) -> str: ...
    @property
    def stack_bead(self) -> str: ...
    @property
    def sprint(self) -> str: ...
    @property
    def phase(self) -> str: ...
    @property
    def checked_bead(self) -> str | None: ...
    def blocks(self, bead_id: str) -> bool: ...
    def layer_for(self, branch: str) -> Layer | None:
        r"""On a stack bead: its ledger layer for `branch`."""

@typing.final
class PhaseFile:
    @property
    def profile(self) -> str: ...
    @property
    def lead(self) -> str: ...
    def template(self, which: Template) -> str: ...
    def key(self, name: str) -> str | None:
        r"""Another top-level string key: root, integration_branch, keys a policy param names."""

@typing.final
class BeadPatch:
    r"""One guarded write: applied only if status and assignee still equal the snapshot's, else BEAD_RACED."""
    @staticmethod
    def assign(snapshot: Bead, agent: str) -> BeadPatch: ...
    @staticmethod
    def start(snapshot: Bead) -> BeadPatch: ...
    @staticmethod
    def reopen(snapshot: Bead) -> BeadPatch: ...
    @staticmethod
    def close(snapshot: Bead, evidence: Layer | QaPass | QaFail | Merged) -> BeadPatch: ...

@typing.final
class HookRequest:
    @staticmethod
    def parse(stdin: str) -> HookRequest | Refusal: ...
    def is_phase_task(self) -> bool: ...
    @property
    def phase(self) -> str: ...
    @property
    def phase_config_path(self) -> str: ...
    @property
    def caller(self) -> str: ...
    @property
    def task_id(self) -> str: ...
    @property
    def assignee(self) -> str | None: ...
    @property
    def close_report(self) -> str | None: ...
    @property
    def close_reason(self) -> str | None: ...
    def qa_pass(self) -> QaPass | Refusal: ...
    def qa_findings(self) -> QaFail | Refusal: ...
    def merged(self) -> Merged | Refusal: ...

@typing.final
class HookAction:
    @staticmethod
    def close(template: str, vars: Layer | QaPass | QaFail | Merged | str) -> HookAction:
        r"""atm task close --template <template> --vars <vars>; str is the give-back reason."""

@typing.final
class HookReply:
    @staticmethod
    def not_applicable() -> HookReply: ...
    @staticmethod
    def pass_through() -> HookReply: ...
    @staticmethod
    def refused(refusal: Refusal) -> HookReply: ...
    @staticmethod
    def handled(actions: list[HookAction]) -> HookReply: ...
    def to_json(self) -> str: ...

class BeadStore(typing.Protocol):
    def refresh(self, bead_ids: list[str]) -> Refusal | None: ...
    def show(self, bead_id: str) -> Bead | Refusal: ...
    def target_layer(self, qa_bead: Bead) -> Layer | Refusal:
        r"""The ledger layer of the QA bead's closed dev/fix blocker, or of its checked_bead."""
    def update(self, patch: BeadPatch, actor: str) -> Refusal | None: ...

class PhaseFiles(typing.Protocol):
    def load(self, path: str, profile: str) -> PhaseFile | Refusal: ...

@typing.final
class PhaseFilesCli(PhaseFiles):
    def __new__(cls) -> PhaseFilesCli: ...
    def load(self, path: str, profile: str) -> PhaseFile | Refusal: ...

@typing.final
class CacheStore(BeadStore):
    r"""The beads-cache adapter the hooks' entry points construct; the framework's BeadsCache port."""
    @staticmethod
    def for_phase(phase: str) -> CacheStore | Refusal: ...
    def refresh(self, bead_ids: builtins.list[str]) -> Refusal | None: ...
    def show(self, bead_id: str) -> Bead | Refusal: ...
    def target_layer(self, qa_bead: Bead) -> Layer | Refusal: ...
    def update(self, patch: BeadPatch, actor: str) -> Refusal | None: ...
    def list(self, phase: str) -> builtins.list[Bead] | Refusal: ...
    def ready(self, phase: str) -> builtins.list[Bead] | Refusal: ...

# ---- Cron: PhaseFacts -> decide -> Action. Times: unix seconds.

_T = typing.TypeVar("_T")

@typing.dataclass_transform(frozen_default=True)
def _record(cls: type[_T]) -> type[_T]:
    r"""Stub-only: a frozen Rust record whose constructor takes every field in order."""


class Hook(enum.Enum):
    r"""The ATM task hook a script is registered for."""
    TASK_ASSIGN = ...
    TASK_START = ...
    TASK_CLOSE = ...

class FactKind(enum.Enum):
    TASKS = ...
    TASK_EVENTS = ...
    REPORTED_KEYS = ...
    REMOTE_BRANCHES = ...
    ANCESTRY = ...
    BEADS = ...
    READY = ...
    STACK = ...
    TOP_CHECKS = ...
    PR_BASES = ...

class TaskState(enum.Enum):
    ASSIGNED = ...
    ACTIVE = ...
    COMPLETE = ...

class CheckState(enum.Enum):
    PASSING = ...
    FAILING = ...
    PENDING = ...
    NONE = ...

@_record
class TaskFact:
    task_id: str
    assignee: str
    state: TaskState
    bead_id: str | None

@_record
class TaskEvents:
    task_id: str
    reminders_since_start: int
    last_start: int | None

@_record
class RemoteBranch:
    name: str
    head: Sha

@_record
class Ancestry:
    below: str
    above: str
    is_ancestor: bool

@_record
class StackFact:
    bead: Bead
    stack: Stack
    trunk: str
    since: int | None

@_record
class TopChecks:
    head: Sha
    state: CheckState

@_record
class PrBase:
    pr: int
    base: str

@_record
class CollectError:
    r"""A failed read; its fact is None this tick."""
    kind: FactKind
    argv: list[str]
    message: str
    fix: str

@_record
class PhaseFacts:
    r"""A fact is None when its read failed this tick (see errors)."""
    phase: str
    now: int
    phase_file: PhaseFile
    tasks: list[TaskFact] | None = None
    task_events: list[TaskEvents] | None = None
    reported_keys: list[str] | None = None
    remote_branches: list[RemoteBranch] | None = None
    ancestry: list[Ancestry] | None = None
    beads: list[Bead] | None = None
    ready: list[Bead] | None = None
    stack: StackFact | None = None
    top_checks: TopChecks | None = None
    pr_bases: list[PrBase] | None = None
    errors: list[CollectError] = ...

@_record
class ReviewTarget:
    repo: str
    pr_number: int
    branch: str
    commit: str

@_record
class Merged:
    sha: str

@_record
class AssignVars:
    task_id: str
    phase: str
    profile: str
    review: ReviewTarget | None = None

@_record
class Assign:
    key: str
    to: str
    bead_id: str
    template: str
    vars: AssignVars

@_record
class Report:
    r"""A Report whose key is already in REPORTED_KEYS stays a view row only."""
    key: str
    queue: str
    bead_id: str | None
    text: str

@_record
class Notify:
    to: str
    keys: list[str]

Action: typing.TypeAlias = Assign | Report | Notify

@typing.final
class Params:
    r"""The params table of the profile's policy.toml."""
    def __init__(self, values: list[tuple[str, builtins.int | str]]) -> None: ...
    def int(self, name: str) -> builtins.int | None: ...
    def text(self, name: str) -> str | None: ...

class Cron(typing.Protocol):
    r"""The profile's cron script (a module): pure, no I/O, imports only atm_bd_types. Called once per tick with every fact."""
    def decide(self, facts: PhaseFacts, params: Params) -> list[Action]: ...

@_record
class Profile:
    r"""A plug-in's profile.toml: the team pipeline (stages in order), ATM hook -> script, templates, policy, optional cron script. Paths relative to the manifest."""
    name: str
    stages: list[str]
    hooks: dict[Hook, str]
    templates: dict[Template, str]
    policy: str
    cron: str | None = None
    startup: dict[str, str] = {}
