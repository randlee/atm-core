@typing.final
class Provider(enum.Enum):
    GITHUB = ...
    AZURE = ...

@typing.final
class Templates:
    r"""All three assignment templates; none optional."""
    def __new__(cls, *, dev: TemplateRef, fix: TemplateRef, qa: TemplateRef) -> Templates: ...

@typing.final
class ProviderConfig:
