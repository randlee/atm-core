          "crates/atm-http-runtime/src/runtime_listener.rs",
          "crates/atm-http-runtime/src/runtime_setup.rs",
          "crates/atm-http-runtime/src/unix_socket.rs",
          "crates/atm/src/main.rs"
        ]
      },
      "reason": "PORT-010: production #[cfg(unix)] helpers lack same-scope #[cfg(windows)] siblings; Windows behavior lives in a different module or is intentionally absent. The listed paths still report findings on sc-lint 0.8.2 when individually unsuppressed; follow randlee/sc-lint#372.",
      "targets": [
        "linux",
        "macos",
        "windows"
      ],
      "unix_path_prefixes": [
        "/tmp/",
        "/home/",
        "/usr/",
        "/etc/"
      ]
    },
    "runtime": {
      "enabled": true,
      "exclude_paths_by_rule": {
        "SCB-RUNTIME-003": [
          "crates/atm/src/commands/internal_nudge.rs",
          "crates/atm-daemon-client/src/lib.rs"
        ]
      },
      "reason": "SCB-RUNTIME-003: internal_nudge.rs tmux delays and subprocess polling run on spawn_blocking, outside Tokio tasks. atm-daemon-client/src/lib.rs launch gate and publication polling are synchronous client APIs, with no production callers in the workspace. See randlee/sc-lint#82."
