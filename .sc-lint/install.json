          "crates/atm-http-runtime/src/unix_socket.rs",
          "crates/atm/src/main.rs",
          "crates/atm-daemon-bootstrap/src/peer_launch_config.rs",
          "crates/atm-daemon-bootstrap/src/protected_trust_root.rs",
          "crates/atm-herdr/src/transport_socket.rs"
        ]
      },
      "reason": "Every remaining exception is rule-scoped: crates/atm-herdr/src/transport_socket.rs remains under PORT-007 for its \\?\\ paths until randlee/sc-lint#192 and under PORT-010 for its paired Unix helper until randlee/sc-lint#372; crates/atm-http-runtime/src/unix_socket.rs remains under PORT-010 until randlee/sc-lint#372 because loopback_tcp.rs is not an out-of-line Windows adapter. peer_launch_config.rs PORT-006/PORT-008 has the platform-neutral path/identity remediation tracked by randlee/sc-lint#372. No analyzer-wide portability exclusion remains.",
      "targets": [
        "linux",
        "macos",
        "windows"
      ],
      "unix_path_prefixes": [
        "/tmp/",
        "/home/",
        "/usr/",
        "/etc/"
      ]
    },
    "runtime": {
      "enabled": true,
      "reason": "Published sc-lint 0.8.0 runtime analyzer replaces the repository-local runtime-waits checker."
    }
  },
