{
  "analyzers": {
    "boundary": {
      "enabled": true,
      "fail_rules": [
        "SCB-CYCLE-001",
        "SCB-CYCLE-002",
        "SCB-CYCLE-003",
        "SCB-BOUNDARY-001",
        "SCB-BOUNDARY-002",
        "SCB-BOUNDARY-003",
        "SCB-CALLER-001",
        "SCB-DEPENDENCY-001",
