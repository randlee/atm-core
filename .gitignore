# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local pre-publish dependency overlays for unpublished shared crates
Cargo.local.toml
Cargo.toml.ci

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Python bytecode caches
**/__pycache__/
scripts/__pycache__/

# Local session artifacts and compose logs from sc tooling
.sc/sessions/
.sc/oversigne/*
.sc-compose/logs/
.just/logs/
artifacts/view/
reports/smoke/[0-9][0-9][0-9][0-9]-*-smoke*.md
reports/smoke/[0-9][0-9][0-9][0-9]-*-smoke*.json
reports/smoke/index.html
reports/smoke/*/*.json
reports/smoke/*/*.xhtml
reports/smoke/*/*.html
reports/coverage/[0-9][0-9][0-9][0-9]-*-mac.md
reports/coverage/[0-9][0-9][0-9][0-9]-*-mac.json
reports/coverage/[0-9][0-9][0-9][0-9]-*-win.md
reports/coverage/[0-9][0-9][0-9][0-9]-*-win.json

# Local prompt scratch, notes, and transient review payloads
.prompts/
memory/
tmp/
.claude/projects/
.DS_Store

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
