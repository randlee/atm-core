---
name: sprint-bead
version: 0.2.0
description: One sprint bead of a plan written to beads. Every mandatory plan field is a required variable, so a strict render fails when one is missing. `requirements` and `adrs` are lists of governing ids, or exactly ["NONE"] when the sprint has none. Render strictly, then `jq -c .` into the import JSONL.
format: json
required_variables:
  - id
  - parent
  - phase
  - sprint
  - title
  - assignee
  - stack
  - layer
  - branch
  - pr_target
  - worktree
  - relation
  - closure_type
  - target_boundary
  - owned_paths
  - description
  - design
  - acceptance_criteria
  - requirements
  - adrs
optional_variables:
  - priority
  - blocked_by
  - model_class
  - release_train
defaults:
  priority: 2
  blocked_by: []
  model_class: ""
  release_train: ""
---
{
  "id": {{ id | tojson }},
  "title": {{ (sprint ~ ": " ~ title) | tojson }},
  "issue_type": "task",
  "status": "open",
  "priority": {{ priority }},
  "assignee": {{ assignee | tojson }},
  "description": {{ description | tojson }},
  "design": {{ design | tojson }},
  "acceptance_criteria": {{ acceptance_criteria | tojson }},
  "labels": {{ (["phase-" ~ phase, "stage:dev", "stack:" ~ stack] + (["train:" ~ release_train] if release_train else [])) | tojson }},
  "dependencies": [
    {"issue_id": {{ id | tojson }}, "depends_on_id": {{ parent | tojson }}, "type": "parent-child"}{% for b in blocked_by %},
    {"issue_id": {{ id | tojson }}, "depends_on_id": {{ b | tojson }}, "type": "blocks"}{% endfor %}
  ],
  "metadata": {
    "phase": {{ phase | tojson }},
    "sprint": {{ sprint | tojson }},
    "stack": {{ stack | tojson }},
    "layer": {{ layer | tojson }},
    "branch": {{ branch | tojson }},
    "pr_target": {{ pr_target | tojson }},
    "worktree": {{ worktree | tojson }},
    "relation": {{ relation | tojson }},
    "closure_type": {{ closure_type | tojson }},
    "target_boundary": {{ target_boundary | tojson }},
    "owned_paths": {{ owned_paths | tojson }},
    "model_class": {{ model_class | tojson }},
    "requirements": {{ requirements | tojson }},
    "adrs": {{ adrs | tojson }},
    "release_train": {{ release_train | tojson }}
  }
}
