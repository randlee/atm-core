---
name: plan-root
version: 0.1.0
description: Root bead of a plan written to beads (the epic or feature every sprint bead sits under). Render strictly, then `jq -c .` into the import JSONL.
format: json
required_variables:
  - id
  - plan_scope
  - phase
  - title
  - description
  - design
  - acceptance_criteria
optional_variables:
  - priority
  - integration_branch
  - parent
defaults:
  priority: 2
  integration_branch: ""
  parent: ""
---
{% if plan_scope not in ["epic", "feature"] %}ERROR: plan_scope must be epic or feature, got {{ plan_scope }}
{% endif %}{
  "id": {{ id | tojson }},
  "title": {{ ("phase-" ~ phase ~ ": " ~ title) | tojson }},
  "issue_type": {{ plan_scope | tojson }},
  "status": "open",
  "priority": {{ priority }},
  "description": {{ description | tojson }},
  "design": {{ design | tojson }},
  "acceptance_criteria": {{ acceptance_criteria | tojson }},
  "labels": {{ ["phase-" ~ phase, "scope:" ~ plan_scope] | tojson }},
  "dependencies": [{% if parent %}
    {"issue_id": {{ id | tojson }}, "depends_on_id": {{ parent | tojson }}, "type": "parent-child"}
  {% endif %}],
  "metadata": {
    "plan_scope": {{ plan_scope | tojson }},
    "phase": {{ phase | tojson }},
    "integration_branch": {{ (integration_branch or "integrate/phase-" ~ phase) | tojson }}
  }
}
