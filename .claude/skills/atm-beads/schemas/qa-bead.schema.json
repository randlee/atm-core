{
  "$defs": {
    "Dependency": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "depends_on_id": {
          "title": "Depends On Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "depends_on_id"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "QaMetadata": {
      "additionalProperties": true,
      "properties": {
        "branch": {
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "worktree": {
          "minLength": 1,
          "title": "Worktree",
          "type": "string"
        },
        "pr_target": {
          "minLength": 1,
          "title": "Pr Target",
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "hard",
            "normal",
            "fast"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "checked_bead": {
          "minLength": 1,
          "title": "Checked Bead",
          "type": "string"
        },
        "round": {
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        },
        "reviewers_round1": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reviewers Round1",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "branch",
        "worktree",
        "pr_target",
        "difficulty",
        "checked_bead",
        "round",
        "reviewers_round1"
      ],
      "title": "QaMetadata",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "dependencies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/QaMetadata"
    }
  },
  "required": [
    "id",
    "metadata"
  ],
  "title": "QaBead",
  "type": "object"
}
