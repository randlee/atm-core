#!/usr/bin/env python3
"""Record the foundational dev/sanity bead IDs for a phase; beads remain authoritative."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

from sprint_index_common import phase_id, run_json, validate_index


FOLDED_INTO = re.compile(r"^folded into\s+(\S+)", re.IGNORECASE)


def metadata(bead: dict[str, Any]) -> dict[str, Any]:
    value = bead.get("metadata")
    return value if isinstance(value, dict) else {}


def dependency_id(edge: dict[str, Any]) -> str:
    return str(edge.get("depends_on_id") or edge.get("id") or "")


def dependency_type(edge: dict[str, Any]) -> str:
    return str(edge.get("type") or edge.get("dependency_type") or "")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True, help="phase root bead id")
    parser.add_argument("--out", required=True, type=Path, help="JSON output path")
    args = parser.parse_args()
    try:
        repo = Path(subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True
        ).strip())
        root_records = run_json(repo, "bd", "show", args.root, "--json")
        if not root_records:
            raise RuntimeError(f"root bead not found: {args.root}")
        root_record = root_records[0]
        phase = phase_id(args.root, root_record)
        children = run_json(
            repo, "bd", "list", "--parent", args.root, "--all", "-n", "0", "--json"
        )
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"export-sprint-index: {exc}", file=sys.stderr)
        return 2

    prefix = args.root.split("-phase-", 1)[0]
    dev_pattern = re.compile(rf"^{re.escape(prefix)}-{re.escape(phase)}-[0-9]+$")
    devs = [bead for bead in children if dev_pattern.fullmatch(str(bead.get("id", "")))]

    def sprint_key(bead: dict[str, Any]) -> tuple[int, str]:
        match = re.search(r"(\d+)$", str(bead.get("id", "")))
        return int(match.group(1)), str(bead["id"])

    sprints = []
    for bead in sorted(devs, key=sprint_key):
        # Absorbed work is history on its bead, not a sprint in the current plan.
        if FOLDED_INTO.match(str(bead.get("close_reason") or "")):
            continue
        gates = [candidate for candidate in children
                 if "stage:dev-sanity" in (candidate.get("labels") or [])
                 and any(dependency_type(edge) == "blocks" and dependency_id(edge) == bead["id"]
                         for edge in candidate.get("dependencies") or [])]
        if len(gates) != 1:
            raise RuntimeError(f"sprint bead {bead['id']} must have exactly one sanity gate; found {len(gates)}")
        sprints.append({
            "dev_bead_id": bead["id"],
            "sanity_bead_id": gates[0]["id"],
        })

    output = {
        "root_bead_id": args.root,
        "sprints": sprints,
    }
    validate_index(output)
    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(json.dumps(output, indent=2) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError, TypeError, KeyError) as exc:
        print(f"export-sprint-index: {exc}", file=sys.stderr)
        raise SystemExit(2)
