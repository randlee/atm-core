#!/usr/bin/env python3
"""Check that the authored phase definition (sprints.jsonl) and the phase DAG HTML were pushed to integration.

The committed sprints.jsonl is the planner's file, never a fresh export; this only verifies it is on the
integration branch, parses, and names the phase root that the HTML embeds."""
import argparse
from html.parser import HTMLParser
from pathlib import Path
import subprocess
import sys
import tempfile

from sprint_index_common import load_phase_plan, phase_id, run_json


class Artifact(HTMLParser):
    def __init__(self):
        super().__init__()
        self.svg = False
        self.root = None

    def handle_starttag(self, tag, attrs):
        if tag == 'svg':
            self.svg = True
        attrs = dict(attrs)
        if tag == 'meta' and attrs.get('name') == 'phase-root-bead':
            self.root = attrs.get('content')


def check_artifact(repo, root, expected_plan_path):
    records = run_json(repo, 'bd', 'show', root, '--json')
    if not records:
        raise RuntimeError(f'phase root missing: {root}')
    phase = phase_id(root, records[0])
    branch = (records[0].get('metadata') or {}).get('integration_branch')
    if not branch:
        raise RuntimeError(f'{root}: integration_branch is required for the phase artifact')
    def git(*args):
        result = subprocess.run(['git', *args], cwd=repo, text=True, capture_output=True)
        if result.returncode:
            raise RuntimeError(result.stderr.strip() or f'git {args[0]} failed')
        return result.stdout
    git('check-ref-format', '--branch', branch)
    ref = f'refs/remotes/origin/{branch}'
    git('fetch', '--no-tags', 'origin', f'refs/heads/{branch}:{ref}')
    base = f'docs/plans/phase-{phase}'
    try:
        page = git('show', f'{ref}:{base}/phase-{phase}-dag.html')
        published_plan = git('show', f'{ref}:{base}/sprints.jsonl')
    except RuntimeError as exc:
        raise RuntimeError(f'{branch}: required phase index/HTML artifact missing or unreadable; run sprint-review --root {root}: {exc}') from exc
    # Validate the remote bytes without treating a Beads projection as input.
    with tempfile.TemporaryDirectory(prefix='phase-artifact-check-') as directory:
        published_path = Path(directory) / 'docs' / 'plans' / f'phase-{phase}' / 'sprints.jsonl'
        published_path.parent.mkdir(parents=True)
        published_path.write_text(published_plan)
        load_phase_plan(published_path, root)
    if published_plan != expected_plan_path.read_text():
        raise RuntimeError(f'{branch}: published phase plan differs from current plan; run sprint-review --root {root}')
    artifact = Artifact()
    artifact.feed(page)
    if not artifact.svg or artifact.root != root:
        raise RuntimeError(f'{branch}: phase HTML must embed SVG and identify root {root}; run sprint-review --root {root}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', required=True)
    parser.add_argument('--index', required=True, type=Path)
    args = parser.parse_args()
    repo = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
    load_phase_plan(args.index, args.root)
    check_artifact(repo, args.root, args.index)
    print('required phase HTML and canonical phase plan are published on integration')


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as exc:
        print(f'check-phase-artifact: {exc}', file=sys.stderr)
        raise SystemExit(5)
