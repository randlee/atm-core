---
name: plan-develop-task
version: 1.0.0
description: team-lead assignment template for formalizing a rough plan into sprint docs before review.
format: xml
required_variables:
  - task_id
  - phase
  - description
  - worktree_path
  - branch
  - source_of_truth
  - references
  - rough_plan_json
---
<atm-task id="{{ task_id }}" sprint="{{ phase }}" assignee="plan-develop" mode="plan-develop">
  <description>{{ description }}</description>

  <worktree>{{ worktree_path }}</worktree>
  <branch>{{ branch }}</branch>

  <source-of-truth>
{{ source_of_truth }}
  </source-of-truth>

  <references>
{{ references }}
  </references>

  <required-input>
    The following fenced JSON handoff is required input from the rough planning
    state. Reject the task if it is missing or malformed.
{{ rough_plan_json }}
  </required-input>

  <workflow>
    <step id="a">ACK this message immediately.</step>
    <step id="b">Read the source-of-truth material, rough planning docs already in the worktree, and the sprint-planning guidelines.</step>
    <step id="c">Formalize the rough plan into phase and sprint docs without changing user-discussed scope.</step>
    <step id="d">Return fenced JSON only. The next step will consume that fenced JSON as required input.</step>
  </workflow>
</atm-task>
