---
name: 01-plan-scope-review-task
version: 1.0.0
description: team-lead assignment template for early sprint-scope and split review before plan hardening.
format: xml
required_variables:
  - task_id
  - phase
  - description
  - worktree_path
  - branch
  - source_of_truth
  - references
---
<atm-task id="{{ task_id }}" sprint="{{ phase }}" assignee="plan-scope-reviewer" mode="plan-scope-review">
  <description>{{ description }}</description>

  <worktree>{{ worktree_path }}</worktree>
  <branch>{{ branch }}</branch>

  <source-of-truth>
{{ source_of_truth }}
  </source-of-truth>

  <references>
{{ references }}
  </references>

  <review-focus>
    Review the current plan state in the planning docs against
    `.claude/skills/plan-hardening/sprint-planning-guidelines.md`.
    Attack sprint shape early:
    - split decisions
    - deliverable ownership
    - production-ready scope
    - checklist authority
    - direct dev/QA consumability
  </review-focus>

  <workflow>
    <step id="a">ACK this message immediately.</step>
    <step id="b">Read the source-of-truth material, the related planning docs, and the sprint-planning guidelines. Sprint docs may be partial or missing; report that as findings.</step>
    <step id="c">Do not edit files.</step>
    <step id="d">Return fenced JSON findings only, matching the `plan-scope-reviewer` output contract. That fenced JSON becomes the required input to sprint-scope hardening.</step>
  </workflow>
</atm-task>
