---
name: critical-plan-review-task
version: 1.0.0
description: team-lead assignment template for late hostile review of a hardened plan before QA.
format: xml
required_variables:
  - task_id
  - phase
  - description
  - worktree_path
  - branch
  - source_of_truth
  - references
  - previous_step_json
---
<atm-task id="{{ task_id }}" sprint="{{ phase }}" assignee="critical-plan-reviewer" mode="critical-plan-review">
  <description>{{ description }}</description>

  <worktree>{{ worktree_path }}</worktree>
  <branch>{{ branch }}</branch>

  <source-of-truth>
{{ source_of_truth }}
  </source-of-truth>

  <references>
{{ references }}
  </references>

  <required-input>
    The following fenced JSON handoff from sprint-scope hardening is required
    input. Reject the task if it is missing or malformed.

    Expected shape:
    ```json
    {
      "status": "PASS",
      "mode": "plan-hardening-sprint-scope",
      "iterations": 0,
      "findings_resolved": 0,
      "final_finding_count": 0,
      "sprint_splits_added": 0,
      "docs_modified": [],
      "docs_created": [],
      "ready_for_next_step": true,
      "errors": []
    }
    ```
{{ previous_step_json }}
  </required-input>

  <review-focus>
    Perform a hostile late-stage review of the hardened plan.
    Focus on:
    - bad architecture decisions
    - weak or missing boundaries
    - false closure
    - contradictory ownership
    - missing ADR coverage
    - unresolved ambiguity that could discard implementation work later
  </review-focus>

  <workflow>
    <step id="a">ACK this message immediately.</step>
    <step id="b">Read the fenced JSON handoff from sprint-scope hardening, the source-of-truth material, the related planning docs, and the sprint-planning guidelines.</step>
    <step id="c">Do not edit files.</step>
    <step id="d">Return fenced JSON findings only, matching the `critical-plan-reviewer` output contract. That fenced JSON becomes the required input to consistency hardening.</step>
  </workflow>
</atm-task>
