{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptic-canvas.dev/plan-anchor/anchor-tuning-result.schema.json",
  "title": "Anchor tuning Standard response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "canceled", "aborted_by", "data", "error", "metadata"],
  "properties": {
    "success": {"type": "boolean"},
    "canceled": {"type": "boolean"},
    "aborted_by": {"type": ["string", "null"], "enum": [null, "user", "policy", "timeout"]},
    "data": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/tuneData"},
        {"$ref": "#/$defs/triageData"}
      ]
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/error"}
      ]
    },
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "allOf": [
    {
      "if": {"properties": {"success": {"const": true}}},
      "then": {"properties": {"canceled": {"const": false}, "aborted_by": {"type": "null"}, "data": {"type": "object"}, "error": {"type": "null"}}}
    },
    {
      "if": {"properties": {"canceled": {"const": true}}},
      "then": {"properties": {"success": {"const": false}, "aborted_by": {"enum": ["user", "policy", "timeout"]}, "error": {"$ref": "#/$defs/error"}}}
    },
    {
      "if": {"properties": {"success": {"const": false}, "canceled": {"const": false}}, "required": ["success", "canceled"]},
      "then": {"properties": {"aborted_by": {"type": "null"}, "data": {"type": "null"}, "error": {"$ref": "#/$defs/error"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sealedQuestionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "questions"],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256"},
        "questions": {"type": "object"}
      }
    },
    "tuneData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "accepted", "authority_citations", "oracle_sha256", "sealed_question_set", "candidate_rankings", "acceptance_table", "evidence", "explanation", "planner_action", "question_action", "sealed_question_set_digest_before", "sealed_question_set_digest_after", "authority_recommendations"],
      "properties": {
        "operation": {"const": "tune"},
        "accepted": {"type": "boolean"},
        "authority_citations": {"type": "array", "items": {"type": "string"}},
        "oracle_sha256": {"$ref": "#/$defs/sha256"},
        "sealed_question_set": {"$ref": "#/$defs/sealedQuestionSet"},
        "candidate_rankings": {"type": "array"},
        "acceptance_table": {"type": "array"},
        "evidence": {"type": "object"},
        "explanation": {"type": "string"},
        "planner_action": {"type": "string"},
        "question_action": {"type": "null"},
        "sealed_question_set_digest_before": {"type": "null"},
        "sealed_question_set_digest_after": {"$ref": "#/$defs/sha256"},
        "authority_recommendations": {"type": "array"}
      }
    },
    "triageData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "disposition", "authority_citations", "oracle_sha256", "sealed_question_set", "candidate_rankings", "acceptance_table", "evidence", "explanation", "planner_action", "question_action", "sealed_question_set_digest_before", "sealed_question_set_digest_after", "authority_recommendations"],
      "properties": {
        "operation": {"const": "triage"},
        "disposition": {"enum": ["plan_violation", "question_defect"]},
        "authority_citations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "oracle_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "sealed_question_set": {"$ref": "#/$defs/sealedQuestionSet"},
        "candidate_rankings": {"type": "array"},
        "acceptance_table": {"type": "array"},
        "evidence": {"type": "object"},
        "explanation": {"type": "string", "minLength": 1},
        "planner_action": {"type": "string", "minLength": 1},
        "question_action": {"enum": ["unchanged", "reopen_affected_tournament"]},
        "sealed_question_set_digest_before": {"$ref": "#/$defs/sha256"},
        "sealed_question_set_digest_after": {"$ref": "#/$defs/sha256"},
        "authority_recommendations": {"type": "array"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "plan_violation"}}, "required": ["disposition"]},
          "then": {"properties": {"question_action": {"const": "unchanged"}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "question_defect"}}, "required": ["disposition"]},
          "then": {"properties": {"question_action": {"const": "reopen_affected_tournament"}}}
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recoverable", "suggested_action"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$"},
        "message": {"type": "string", "minLength": 1},
        "recoverable": {"type": "boolean"},
        "suggested_action": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "tool_calls", "retry_count", "correlation_id", "jev_run_ids", "planner_observation_trust", "authoritative_sources_unchanged"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "correlation_id": {"type": "string", "minLength": 1},
        "jev_run_ids": {"type": "array", "items": {"type": "string"}},
        "planner_observation_trust": {"type": ["string", "null"], "enum": [null, "untrusted"]},
        "authoritative_sources_unchanged": {"type": "boolean"}
      }
    }
  }
}
