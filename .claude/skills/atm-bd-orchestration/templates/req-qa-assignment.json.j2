---
name: req-qa-assignment
version: 2.0.0
description: Render a fenced-JSON assignment for req-qa in atm-bd-orchestration. `sprint_doc` is the file quality-mgr writes by piping `bd show <checked bead> --json` (the bead is the sprint plan); `carry_forward_findings_json` is a JSON array of the reviewer's own finding ids (`metadata.finding_ref` of the carried finding beads). Triage records are replaced by finding beads and are always empty.
format: json
required_variables:
  - reference_docs
  - sprint_doc
  - worktree_path
  - branch
  - commit
optional_variables:
  - phase
  - sprint
  - review_targets
  - round_limit
  - changed_files
  - carry_forward_findings_json
  - notes
defaults:
  phase: ""
  sprint: ""
  review_targets: []
  round_limit: false
  changed_files: []
  carry_forward_findings_json: "[]"
  notes: ""
---
{
  "scope": {
    "phase": {% if phase %}{{ phase }}{% else %}null{% endif %},
    "sprint": {% if sprint %}{{ sprint }}{% else %}null{% endif %}
  },
  "phase_or_sprint_docs": [{% for doc in reference_docs %}{{ doc }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "phase_sprint_documents": [{% for doc in reference_docs %}{{ doc }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "authoritative_sprint_doc": {{ sprint_doc }},
  "worktree_path": {{ worktree_path }},
  "branch": {{ branch }},
  "commit": {{ commit }},
  "review_targets": [{% for target in review_targets %}{{ target }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "round_limit": {% if round_limit %}true{% else %}false{% endif %},
  "changed_files": [{% for file in changed_files %}{{ file }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "triage_records": [],
  "carry_forward_findings": {{ carry_forward_findings_json | safe }},
  "notes": {{ notes }}
}
