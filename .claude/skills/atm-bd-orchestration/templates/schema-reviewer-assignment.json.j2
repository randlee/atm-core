---
name: schema-reviewer-assignment
version: 3.1.0
description: Render a fenced-JSON assignment for schema-reviewer in atm-bd-orchestration, including locked finding verification when carried ids are supplied.
format: json
required_variables:
  - review_mode
  - worktree_path
  - branch
  - commit
  - review_targets
  - policy_path
optional_variables:
  - reference_docs
  - carry_forward_findings_json
  - notes
defaults:
  reference_docs: []
  carry_forward_findings_json: "[]"
  notes: ""
---
{%- set cf = carry_forward_findings_json | replace(" ", "") -%}
{%- set locked = cf not in ["", "[]", "null", "[null]", "[\"\"]"] -%}
{
  "review_mode": {{ review_mode }},
  "worktree_path": {{ worktree_path }},
  "branch": {{ branch }},
  "commit": {{ commit }},
  "policy_path": {{ policy_path }},
  "review_targets": [{% for target in review_targets %}{{ target }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "reference_docs": [{% for doc in reference_docs %}{{ doc }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "carry_forward_findings": {{ carry_forward_findings_json | safe }},
  "findings_scope_locked": {% if locked %}true{% else %}false{% endif %},
  "notes": {{ notes ~ (" SCOPE LOCK: this is a fix-round verification dispatch. Report a disposition (fixed | open | regressed) for each id in carry_forward_findings ONLY. Put unrelated observations under notes, not findings." if locked else "") }}
}
