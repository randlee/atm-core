#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11,<3.12"
# dependencies = ["pydantic>=2", "pyyaml", "sc-compose>=1.8.0,<2"]
# ///
"""Append one PR under a bead claim, keeping bd's TTL alive with 120 s heartbeats."""
from __future__ import annotations

import argparse
import copy
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
from typing import Any
import tempfile
import time

from stack_top import StackTop, StackTopMismatch, select_confirmed_stack_top, select_passed_unlinked_top


PULL_FILTER = '.[] | {number, base: .base.ref, head: .head.ref, sha: .head.sha, draft}'
STACK_FILTER = '.[] | {number, base: .base.ref, prs: [.pull_requests[].number]}'
COMMAND_TIMEOUT = 120
HEARTBEAT_INTERVAL = 120


class StackError(Exception):
    pass


class LayerError(StackError):
    def __init__(self, evidence, fix):
        super().__init__(evidence)
        self.fix = fix


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise StackError(message)


def rows(output):
    try:
        value = json.loads(output)
        return value if isinstance(value, list) else [value]
    except json.JSONDecodeError:
        try:
            return [json.loads(line) for line in output.splitlines() if line.strip()]
        except json.JSONDecodeError as error:
            raise StackError(f"invalid JSON from command: {error}") from error


class Linker:
    def __init__(self, values, runner, clock, actor):
        self.values = values
        self.runner = runner
        self.clock = clock
        self.actor = actor
        self.held = False
        self.heartbeat_at = 0
        self.mode = None
        self.lean_reason = None

    def command(self, argv, *, check=True, allow_transport_failure=False):
        if self.held and argv[:2] != ['bd', 'heartbeat'] and self.clock() - self.heartbeat_at >= HEARTBEAT_INTERVAL:
            self.heartbeat()
        # git and gh act on the checked layer's repository; bd and atm stay in the caller's checkout.
        options = {'cwd': self.values['worktree_path']} if argv[0] in ('git', 'gh') and self.values.get('worktree_path') else {}
        try:
            result = self.runner(argv, capture_output=True, text=True, timeout=COMMAND_TIMEOUT, **options)
        except (OSError, subprocess.TimeoutExpired) as error:
            if allow_transport_failure:
                return subprocess.CompletedProcess(argv, 1, '', str(error))
            raise StackError(f"{' '.join(argv)}: {error}") from error
        if check and result.returncode:
            detail = (result.stderr or '').strip().splitlines()
            raise StackError(f"{' '.join(argv)} [{result.returncode}] {detail[0] if detail else 'command failed'}")
        return result

    def heartbeat(self):
        self.command(['bd', 'heartbeat', self.values['stack_bead'], '--actor', self.actor])
        self.heartbeat_at = self.clock()

    def bead(self):
        result = self.command(['bd', 'show', self.values['stack_bead'], '--json'])
        found = rows(result.stdout)
        if len(found) != 1 or not isinstance(found[0], dict):
            raise StackError('bd show returned an invalid stack bead')
        return found[0]

    def acquire(self):
        result = self.command(['bd', 'update', self.values['stack_bead'], '--claim', '--actor', self.actor], check=False)
        if result.returncode == 0:
            self.held = True
            self.heartbeat_at = self.clock()
            return None
        bead = self.bead()
        if not bead.get('assignee') or bead.get('assignee') == self.actor:
            detail = (result.stderr or '').strip().splitlines()
            raise StackError(f"bd update --claim [{result.returncode}] {detail[0] if detail else 'claim failed'}")
        return {'result': 'lock_timeout', 'holder': bead.get('assignee'), 'claimed_at': bead.get('started_at')}

    def release(self):
        if self.held:
            self.held = False
            self.command(['bd', 'update', self.values['stack_bead'], '--if-assignee', self.actor,
                          '--status', 'open', '--assignee', '', '--actor', self.actor])

    def pulls(self):
        result = self.command(['gh', 'api', 'repos/{owner}/{repo}/pulls?state=open&per_page=100',
                               '--paginate', '--jq', PULL_FILTER])
        found = rows(result.stdout) if result.stdout.strip() else []
        if any(not isinstance(item, dict) or type(item.get('number')) is not int or
               not all(isinstance(item.get(key), str) and item[key] for key in ('base', 'head', 'sha')) or
               type(item.get('draft')) is not bool for item in found):
            raise StackError('filtered pull list has invalid fields')
        if len({item['number'] for item in found}) != len(found):
            raise StackError('filtered pull list contains duplicate pull requests')
        return found

    def lean_mode(self):
        if self.values['budget'] == 'lean':
            self.lean_reason = 'budget_lean'
        else:
            quota = self.command(['gh', 'api', 'rate_limit', '--jq', '.resources.graphql'], check=False, allow_transport_failure=True)
            if quota.returncode:
                self.lean_reason = 'rate_limit_call_failed'
            else:
                try:
                    self.lean_reason = None if json.loads(quota.stdout)['remaining'] > 0 else 'graphql_remaining_0'
                except (ValueError, KeyError, TypeError):
                    self.lean_reason = 'rate_limit_response_invalid'
        self.mode = 'lean' if self.lean_reason else 'full'
        if self.lean_reason:
            print(f'sanity-stack-link: lean mode: {self.lean_reason}', file=sys.stderr)
        return self.mode == 'lean'

    def stacks(self):
        result = self.command(['gh', 'api', 'repos/{owner}/{repo}/stacks', '--paginate', '--jq', STACK_FILTER])
        found = rows(result.stdout) if result.stdout.strip() else []
        if any(not isinstance(item, dict) or type(item.get('number')) is not int or
               not isinstance(item.get('base'), str) or not isinstance(item.get('prs'), list) or
               any(type(number) is not int for number in item['prs']) for item in found):
            raise StackError('filtered hosted stack list has invalid fields')
        return found

    def invalid_layer(self, metadata, layer, invariant, *, remove=False):
        repaired = copy.deepcopy(metadata)
        index = next(i for i, item in enumerate(metadata['layers']) if item is layer)
        if remove:
            removed = repaired['layers'].pop(index)
            if (isinstance(removed, dict) and index < len(repaired['layers']) and
                    isinstance(repaired['layers'][index], dict) and repaired['layers'][index].get('base') == removed.get('branch')):
                repaired['layers'][index]['base'] = removed.get('base')
        else:
            repaired['layers'][index]['linked'] = False
        command = f"bd update {shlex.quote(self.values['stack_bead'])} --metadata {shlex.quote(json.dumps(repaired, separators=(',', ':')))}"
        fields = layer if isinstance(layer, dict) else {}
        raise LayerError(f"PR {fields.get('pr')} branch {fields.get('branch')} head {fields.get('head')}: {invariant}; --set-metadata stores a string",
                         command)

    def reconcile(self, metadata, pulls, stacks):
        layers = metadata['layers']
        known = {entry['pr'] for entry in layers}
        matching = [stack for stack in stacks if stack['number'] == metadata['stack_number'] or
                    (stack['base'] == metadata['trunk'] and known.intersection(stack['prs']))]
        if len(matching) > 1:
            raise StackError('ambiguous hosted stacks overlap the ledger')
        if not matching:
            for layer in layers:
                if layer['linked']:
                    self.invalid_layer(metadata, layer, 'linked: true but absent from the hosted stack')
            if metadata['stack_number'] is not None:
                raise StackError('hosted stack missing for linked ledger')
            return
        stack = matching[0]
        if stack['base'] != metadata['trunk'] or len(set(stack['prs'])) != len(stack['prs']):
            raise StackError('hosted stack has conflicting ancestry')
        by_number = {pull['number']: pull for pull in pulls}
        previous = metadata['trunk']
        for index, number in enumerate(stack['prs']):
            pull = by_number.get(number)
            if not pull or pull['draft'] or pull['base'] != previous:
                raise StackError('hosted stack pull chain is missing or ambiguous')
            ref = self.command(['git', 'rev-parse', 'refs/remotes/origin/' + pull['head']])
            if ref.stdout.strip() != pull['sha']:
                raise StackError('hosted stack head differs from fetched branch')
            if index == 0:
                # A frozen bottom does not track later trunk commits. New ledgers
                # pin its cut base; legacy ledgers can prove common history only.
                cut_base = layers[0].get('base_head') if layers else None
                if cut_base is not None:
                    if not isinstance(cut_base, str) or not re.fullmatch(r'[0-9a-fA-F]{7,64}', cut_base):
                        raise StackError('bottom layer has an invalid recorded cut base')
                    ancestry = self.command(['git', 'merge-base', '--is-ancestor', cut_base, pull['sha']], check=False)
                else:
                    ancestry = self.command(['git', 'merge-base', 'origin/' + previous, pull['sha']], check=False)
                if ancestry.returncode:
                    raise StackError('hosted bottom has conflicting or unavailable cut ancestry')
            else:
                ancestry = self.command(['git', 'merge-base', '--is-ancestor', 'origin/' + previous, pull['sha']], check=False)
                if ancestry.returncode:
                    raise StackError('hosted stack has conflicting git ancestry')
            if index < len(layers) and layers[index]['pr'] != number:
                if layers[index]['linked']:
                    raise StackError('hosted stack conflicts with ledger ancestry')
                held_index = next((i for i in range(index + 1, len(layers)) if layers[i]['pr'] == number), None)
                if held_index is not None:
                    layers.insert(index, layers.pop(held_index))
                else:
                    if (sum(other['head'] == pull['head'] for other in pulls) != 1 or
                            any(layer['branch'] == pull['head'] or layer['pr'] == number for layer in layers)):
                        raise StackError('hosted-only stack layer is not uniquely attributable')
                    layers.insert(index, {'branch': pull['head'], 'pr': number, 'head': pull['sha'], 'base': previous, 'linked': True})
            if index < len(layers):
                layer = layers[index]
                if layer.get('held_on'):
                    if layer['held_on']['branch'] != previous:
                        raise StackError('hosted stack conflicts with held parent')
                    layer['base'] = previous
                if (layer['pr'], layer['branch'], layer['head'], layer['base']) != (number, pull['head'], pull['sha'], previous):
                    raise StackError('hosted stack conflicts with ledger ancestry')
                layer['linked'] = True
                layer.pop('held_on', None)
            else:
                if (sum(other['head'] == pull['head'] for other in pulls) != 1 or
                        any(layer['branch'] == pull['head'] or layer['pr'] == number for layer in layers)):
                    raise StackError('hosted-only stack layer is not uniquely attributable')
                layers.append({'branch': pull['head'], 'pr': number, 'head': pull['sha'], 'base': previous, 'linked': True})
            previous = pull['head']
        for layer in layers[len(stack['prs']):]:
            if layer['linked']:
                self.invalid_layer(metadata, layer, 'linked: true but absent from the hosted stack')
        metadata['stack_number'] = stack['number']

    def git_parent(self, candidate, pulls, base_head):
        ancestors = []
        for pull in pulls:
            if pull['number'] == candidate['number']:
                continue
            contained = self.command(['git', 'merge-base', '--is-ancestor', pull['sha'], base_head], check=False)
            if contained.returncode == 0:
                continue
            if contained.returncode != 1:
                raise StackError('cannot determine parent ancestry relative to stack base')
            result = self.command(['git', 'merge-base', '--is-ancestor', pull['sha'], candidate['sha']], check=False)
            if result.returncode == 0:
                ancestors.append(pull)
            elif result.returncode != 1:
                raise StackError('cannot determine parent ancestry')
        closest = []
        for parent in ancestors:
            if not any(other is not parent and other['sha'] != parent['sha'] and self.command(
                    ['git', 'merge-base', '--is-ancestor', parent['sha'], other['sha']], check=False).returncode == 0
                    for other in ancestors):
                closest.append(parent)
        if len(closest) > 1:
            raise StackError('multiple incomparable open pull request parents')
        return closest[0] if closest else None

    def write(self, metadata):
        with tempfile.NamedTemporaryFile(mode='w', suffix='.json', encoding='utf-8') as stream:
            json.dump(metadata, stream)
            stream.flush()
            self.command(['bd', 'update', self.values['stack_bead'], '--if-assignee', self.actor,
                          '--metadata', '@' + stream.name, '--actor', self.actor])

    def verify_trunk_merge(self, trunk, head):
        merge = self.command(['git', 'merge-tree', '--write-tree', 'origin/' + trunk, head], check=False)
        if merge.returncode:
            raise StackError('stack top does not merge cleanly into current trunk: ' +
                             (merge.stderr or merge.stdout or f'exit {merge.returncode}').strip())

    def execute(self):
        timeout = self.acquire()
        if timeout:
            return timeout
        bead = self.bead()
        metadata = copy.deepcopy(bead.get('metadata'))
        if (not isinstance(metadata, dict) or not isinstance(metadata.get('trunk'), str) or not metadata['trunk'] or
                not isinstance(metadata.get('layers'), list) or
                (metadata.get('stack_number') is not None and (type(metadata['stack_number']) is not int or metadata['stack_number'] <= 0))):
            raise StackError('stack bead metadata is invalid')
        layers = metadata['layers']
        previous = metadata['trunk']
        branches, numbers = set(), set()
        for layer in layers:
            if isinstance(layer, dict) and 'held_on' in layer:
                held_on = layer['held_on']
                if (not isinstance(held_on, dict) or type(held_on.get('pr')) is not int or held_on['pr'] <= 0 or
                        not isinstance(held_on.get('branch'), str) or not held_on['branch'] or
                        layer.get('linked') is not False or ('base' in layer and layer['base'] != held_on['branch']) or
                        held_on['pr'] == layer.get('pr')):
                    self.invalid_layer(metadata, layer, 'invalid held_on parent or linked state', remove=True)
            if isinstance(layer, dict) and type(layer.get('pr')) is int and layer['pr'] in numbers:
                self.invalid_layer(metadata, layer, 'duplicate pr in metadata.layers', remove=True)
            if (not isinstance(layer, dict) or not isinstance(layer.get('branch'), str) or not layer['branch'] or
                    type(layer.get('pr')) is not int or layer['pr'] <= 0 or not isinstance(layer.get('head'), str) or
                    not re.fullmatch(r'[0-9a-fA-F]{7,64}', layer['head']) or type(layer.get('linked')) is not bool or
                    (not layer.get('held_on') and layer.get('base') != previous) or layer['branch'] in branches or layer['pr'] in numbers):
                self.invalid_layer(metadata, layer, 'invalid layer fields, base ancestry, or duplicate branch in metadata.layers', remove=True)
            if not layer.get('held_on'):
                previous = layer['branch']
            branches.add(layer['branch'])
            numbers.add(layer['pr'])
        original = copy.deepcopy(metadata)
        lean = self.lean_mode()
        pulls = self.pulls()
        hosted_prs = None
        if not lean and (layers or metadata['stack_number'] is not None):
            self.command(['git', 'fetch', 'origin'])
            stacks = self.stacks()
            known = {layer['pr'] for layer in layers}
            matching = [stack for stack in stacks if stack['number'] == metadata['stack_number'] or
                        (stack['base'] == metadata['trunk'] and known.intersection(stack['prs']))]
            if len(matching) > 1:
                raise StackError('ambiguous hosted stacks overlap the ledger')
            hosted_prs = matching[0]['prs'] if matching else []
            for layer in layers:
                if layer['linked'] and layer['pr'] not in hosted_prs:
                    self.invalid_layer(metadata, layer, 'linked: true but absent from the hosted stack')
            selected = select_confirmed_stack_top(layers, hosted_prs)
            if isinstance(selected, StackTopMismatch):
                linked_prs = [layer['pr'] for layer in layers if layer['linked']]
                anchors = [layer['pr'] for layer in layers if not layer.get('held_on')]
                if (not anchors or len(hosted_prs) <= len(linked_prs) or
                        hosted_prs[:len(anchors)] != anchors):
                    raise StackError(f'stack top mismatch: ledger {selected.ledger_top}; hosted {selected.hosted_top}')
                try:
                    self.reconcile(metadata, pulls, stacks)
                except StackError as error:
                    raise StackError(f'stack top mismatch: ledger {selected.ledger_top}; hosted {selected.hosted_top}; {error}') from error
            else:
                self.reconcile(metadata, pulls, stacks)
        candidate = next((pull for pull in pulls if pull['number'] == self.values['pr_number']), None)
        if not candidate or candidate['head'] != self.values['branch'] or candidate['sha'] != self.values['commit'] or candidate['draft']:
            raise StackError('checked pull request is missing, draft, or differs from the pinned branch and commit')
        refreshed = self.bead()
        if refreshed.get('assignee') != self.actor or refreshed.get('metadata') != original:
            raise StackError('stack claim or ledger changed during reconciliation')
        self.command(['git', 'fetch', 'origin'])

        def resolve_head(branch):
            return self.command(['git', 'rev-parse', 'refs/remotes/origin/' + branch]).stdout.strip()

        selected = select_confirmed_stack_top(layers, hosted_prs)
        if isinstance(selected, StackTopMismatch):
            raise StackError(f'stack top mismatch: ledger {selected.ledger_top}; hosted {selected.hosted_top}')
        base = selected.branch if selected.branch is not None else metadata['trunk']
        recorded_head = selected.head if selected.head is not None else resolve_head(base)
        # A passed first layer has no hosted stack until its successor passes.
        has_passed = any(not layer.get('held_on') for layer in layers)
        if selected.branch is None:
            passed_top = select_passed_unlinked_top(layers)
            if passed_top is not None:
                assert passed_top.branch is not None and passed_top.head is not None
                base, recorded_head = passed_top.branch, passed_top.head
        if layers and resolve_head(base) != recorded_head:
            raise StackError('recorded stack top differs from its recorded head')
        parent = self.git_parent(candidate, pulls, recorded_head)
        parent_entry = next((layer for layer in layers if parent and layer['pr'] == parent['number']), None)
        if parent and (parent_entry is None or parent_entry.get('held_on')):
            ancestor = self.command(['git', 'merge-base', '--is-ancestor', 'origin/' + base, self.values['commit']], check=False)
            if ancestor.returncode == 0:
                held = next((layer for layer in layers if layer['pr'] == candidate['number']), None)
                if held is not None and (held['branch'] != candidate['head'] or held['head'] != candidate['sha'] or
                                         held.get('held_on') != {'pr': parent['number'], 'branch': parent['head']}):
                    raise StackError('checked held layer conflicts with its pinned commit or parent')
                if resolve_head(candidate['head']) != candidate['sha']:
                    raise StackError('checked held layer differs from fetched branch head')
                if held is None:
                    held = {'branch': candidate['head'], 'pr': candidate['number'], 'head': candidate['sha'],
                            'base': parent['head'], 'linked': False, 'held_on': {'pr': parent['number'], 'branch': parent['head']}}
                    layers.append(held)
                    self.write(metadata)
                return {'result': 'held', 'held_on': held['held_on']}
            if ancestor.returncode != 1:
                raise StackError('cannot determine stack top ancestry')
        recorded = next((layer for layer in layers
                         if layer['pr'] == self.values['pr_number'] or layer['branch'] == self.values['branch']), None)
        if recorded is not None:
            if (recorded['pr'] != self.values['pr_number'] or recorded['branch'] != self.values['branch'] or
                    recorded['head'] != self.values['commit'] or candidate['base'] != recorded['base'] or
                    resolve_head(recorded['branch']) != self.values['commit']):
                raise StackError('checked layer conflicts with its recorded pinned commit')
            selected_head = resolve_head(base)
            if selected_head != recorded_head:
                raise StackError('recorded stack top differs from the fetched branch head')
            if recorded['linked']:
                self.verify_trunk_merge(metadata['trunk'], selected_head)
                if metadata != original:
                    self.write(metadata)
                return {'result': 'stacked', 'top': next(layer for layer in reversed(layers) if layer['linked']),
                        'stack_number': metadata.get('stack_number')}
            if any(not entry.get('held_on') for entry in layers[layers.index(recorded) + 1:]):
                raise StackError('checked unlinked layer is not the next stack layer')
            base = recorded['base']
            recorded_head = resolve_head(base)
        ancestor = self.command(['git', 'merge-base', '--is-ancestor', 'origin/' + base, self.values['commit']], check=False)
        actual = resolve_head(base) if layers else recorded_head
        if actual != recorded_head:
            raise StackError('fetched stack top differs from its recorded head')
        if ancestor.returncode == 1:
            contained = self.command(['git', 'merge-base', '--is-ancestor', self.values['commit'], 'origin/' + base],
                                     check=False).returncode == 0
            return {'result': 'rebase_required', 'top': {'branch': base, 'head': actual},
                    'evidence': f"origin/{base} is not an ancestor of {self.values['commit']}",
                    'next_steps': rebase_steps(self.values, base, metadata, contained)}
        if ancestor.returncode:
            raise StackError(f"git merge-base --is-ancestor [{ancestor.returncode}] {(ancestor.stderr or '').strip()}")
        if (lean or not layers) and candidate['base'] != base:
            raise StackError(f"pull request base {candidate['base']} differs from stack top {base}")
        new = recorded or {'branch': self.values['branch'], 'pr': self.values['pr_number'], 'head': self.values['commit'], 'base': base, 'linked': False}
        if not has_passed and recorded is None:
            new['base_head'] = recorded_head
        self.verify_trunk_merge(metadata['trunk'], self.values['commit'])
        children = []
        next_parent = new
        while True:
            matches = [entry for entry in layers if entry.get('held_on', {}).get('pr') == next_parent['pr']]
            if len(matches) > 1:
                raise StackError('multiple held children share one parent')
            if not matches:
                break
            child = matches[0]
            child_pull = next((pull for pull in pulls if pull['number'] == child['pr']), None)
            if (not child_pull or child_pull['draft'] or child_pull['head'] != child['branch'] or
                    child_pull['sha'] != child['head'] or resolve_head(child['branch']) != child['head']):
                raise StackError('held child is missing, draft or differs from its pinned commit')
            if self.command(['git', 'merge-base', '--is-ancestor', next_parent['head'], child['head']], check=False).returncode:
                raise StackError('held child does not contain its parent')
            children.append(child)
            next_parent = child
        if children and lean:
            if recorded is None:
                insertion = next((i for i, entry in enumerate(layers) if entry.get('held_on')), len(layers))
                layers.insert(insertion, new)
            self.write(metadata)
            return {'result': 'stacked', 'top': new, 'stack_number': metadata.get('stack_number')}
        if children:
            layers[:] = [entry for entry in layers if entry not in children]
            if recorded is None:
                insertion = next((i for i, entry in enumerate(layers) if entry.get('held_on')), len(layers))
                layers.insert(insertion, new)
                recorded = new
            insertion = layers.index(new) + 1
            layers[insertion:insertion] = children
        pending, stack_number = [], metadata.get('stack_number')
        if not lean and layers:
            pending = [entry for entry in layers if not entry['linked'] and (not entry.get('held_on') or entry in children)]
            if new not in pending and not new['linked']:
                pending.append(new)
        # Layer 0 alone cannot form a stack (gh stack link needs two PRs): it waits unlinked until layer 1 links with it.
        if not lean and layers and (stack_number is not None or len(pending) > 1):
            if stack_number is None or children:
                link_layers = [entry for entry in layers if entry['linked'] or entry in pending]
                self.command(['gh', 'stack', 'link', '--base', metadata['trunk']] + [str(entry['pr']) for entry in link_layers] + ([] if new in layers else [str(new['pr'])]))
            else:
                for entry in pending:
                    self.command(['gh', 'stack', 'link', str(stack_number), str(entry['pr'])])
            hosted = self.stacks()
            expected = [entry['pr'] for entry in layers if entry['linked'] or entry in pending]
            if new not in layers:
                expected.append(new['pr'])
            matches = [stack for stack in hosted if stack['base'] == metadata['trunk'] and stack['prs'] == expected
                       and (stack_number is None or stack['number'] == stack_number)]
            if len(matches) != 1:
                raise StackError('linked hosted stack identity or order is missing or ambiguous')
            metadata['stack_number'] = matches[0]['number']
            for entry in pending:
                entry['linked'] = True
                if entry.get('held_on'):
                    entry['base'] = entry['held_on']['branch']
                entry.pop('held_on', None)
        if recorded is None:
            insertion = next((i for i, entry in enumerate(layers) if entry.get('held_on')), len(layers))
            layers.insert(insertion, new)
        self.write(metadata)
        return {'result': 'stacked', 'top': children[-1] if children else new, 'stack_number': metadata.get('stack_number')}


def rebase_steps(values, top, metadata, contained):
    """The lead's options for a rebase_required layer, named so the notice carries the repair."""
    layer, pr, stack = values['branch'], values['pr_number'], metadata.get('stack_number')
    recheck = (f"pour the re-check sanity bead <sanity bead>-r<N> from dev-sanity-bead.json.j2 at the new head of "
               f"{layer}, close the old sanity bead 'superseded by <new>', add the QA bead's blocker on it and dispatch "
               f"templates.sanity with the new commit, base, branch, pr_number and worktree_path (SKILL.md Stack Discipline); "
               f"never reopen a sanity or dev bead or edit bead metadata")
    if contained:
        return [{'option': 'relink_in_git_order',
                 'when': f"{layer} is already in the history of the top {top}: the top was linked before this layer",
                 'steps': [f"do not rebase {layer}",
                           f"gh stack unstack {stack}, then gh stack link --base {metadata['trunk']} <every PR in git order, "
                           f"bottom to top, {pr} included>",
                           f"insert {layer} (PR {pr}, head {values['commit']}) into the stack bead layers at its git position, "
                           f"with the base of the layer above it set to {layer}",
                           "rerun sanity-stack-link with the same input; it returns stacked"]}]
    return [{'option': 'rebase',
             'when': f"{layer} is unlinked, has no children and rebases cleanly onto {top}",
             'steps': [f"in the lead's own worktree: git rebase origin/{top}, push --force-with-lease, "
                       f"gh pr edit {pr} --base {top}", recheck]},
            {'option': 'dev_rebase',
             'when': f"the rebase onto {top} conflicts",
             'steps': ["git rebase --abort",
                       f"re-assign the checked bead's dev to rebase {layer} onto {top} (dev template step f)",
                       "on its close, " + recheck]}]


def main(argv=None, runner=subprocess.run, clock=time.time):
    parser = Parser(description=__doc__)
    parser.add_argument('--input', required=True, type=Path)
    parser.add_argument('--notify-lead')
    linker = None
    args = None
    values = {}
    result: dict[str, Any] | None = None
    try:
        args = parser.parse_args(argv)
        values = json.loads(args.input.read_text(encoding='utf-8'))
        if not isinstance(values, dict) or any(not isinstance(values.get(key), str) or not values[key] for key in ('checked_bead', 'branch', 'commit', 'stack_bead')):
            raise StackError('input requires checked_bead, branch, commit and stack_bead strings')
        if type(values.get('pr_number')) is not int or values['pr_number'] <= 0 or values.get('budget') not in ('full', 'lean'):
            raise StackError('input requires a positive pr_number and budget full or lean')
        if not re.fullmatch(r'[0-9a-fA-F]{7,64}', values['commit']):
            raise StackError('commit must be a hexadecimal Git object ID')
        if not isinstance(values.get('worktree_path', ''), str):
            raise StackError('worktree_path must be a string')
        actor = os.environ.get('ATM_IDENTITY')
        if not actor:
            raise StackError('ATM_IDENTITY is required')
        linker = Linker(values, runner, clock, actor)
        try:
            try:
                result = linker.execute()
            except (StackError, OSError, ValueError, TypeError, KeyError) as error:
                result = {'result': 'stack_failed', 'evidence': str(error)}
                if isinstance(error, LayerError):
                    result['fix'] = error.fix
        finally:
            try:
                linker.release()
            except StackError as error:
                if result is None:
                    raise
                if result['result'] == 'stacked':
                    result['release_warning'] = str(error)
                elif result['result'] == 'stack_failed':
                    result['evidence'] += f'; release failed: {error}'
                else:
                    result = {'result': 'stack_failed', 'evidence': f'release failed after {result["result"]}: {error}'}
    except (StackError, OSError, ValueError, TypeError, KeyError) as error:
        result = {'result': 'stack_failed', 'evidence': str(error)}
    assert result is not None
    if linker is not None and linker.mode is not None:
        result.update(mode=linker.mode, lean_reason=linker.lean_reason)
    lead = (args.notify_lead if args is not None else None) or (values.get('lead') if isinstance(values, dict) else None)
    if lead and lead == os.environ.get('ATM_IDENTITY'):
        result['notified'] = 'skipped (self)'
    elif lead and result['result'] != 'stacked':
        try:
            notice = runner(['atm', 'send', lead,
                             'Sanity task already closed; stack handoff needs lead action: ' + json.dumps(result)],
                            capture_output=True, text=True, timeout=30)
            if notice.returncode:
                result['notification_error'] = notice.stderr or notice.stdout
        except (OSError, subprocess.TimeoutExpired) as error:
            result['notification_error'] = str(error)
    print(json.dumps(result))
    return int(result['result'] == 'stack_failed')


if __name__ == '__main__':
    sys.exit(main())
