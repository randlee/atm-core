#!/usr/bin/env python3
"""Attach the bead groups of sprints and blocking findings, with their relations (diagram 07).

  bead-groups [--validate] [--option A|B|C] [--json] TARGET...

  TARGET (any mix, at least one):
    --sprint ID[,ID...]    sprint containers (repeatable)
    --phase P              every sprint in the plan file `.atm-bd/phase-P.toml` names
    --findings FILE        the blocking findings one QA round raised on one sprint (repeatable):
                             {"sprint": "<sprint container id>", "round": N, "filed_by": "<QA bead id>",
                              "found_at_commit": "<reviewed commit>",
                              "findings": [{"ref": "qa1-f1", "severity": "blocking", "reviewer": "...",
                                            "title": "...", "remedy": "...", "priority": 1}]}
                           a finding may also carry requirements, adrs and difficulty; they default to the
                           sprint container's metadata

A sprint pours dev <- sanity <- qa under its container. Each blocking finding
pours fix <- sanity <- qa as siblings under the same container, at
<sprint>.<ref>-r<round>-<step>; the fix bead carries the finding. Important
and minor findings are not poured (refused): QA files them as plain finding
beads. A finding group is not poured once its `filed_by` QA bead is closed:
quality-mgr pours the groups first, then closes its QA bead.

For every target it attaches the group's formula under the target's sprint
container with `sc-compose bead attach`, together with the relations from
`<formula>.relations.json`: `validates` (E1 option); for a sprint, its dev
bead `blocks` on the initial sanity bead of each predecessor in the phase's
plan file depends_on (under option A, which pours no sanity bead, on its dev
bead); for a fix, `discovered-from` its `filed_by` QA bead.
A relation's bead must exist when its target is attached, so sprints are
attached in dependency order (a predecessor in the same run first), then
findings.

The attach creates only what is missing and never edits an existing bead, so
running it again after sprints are added to the plan fills in only the new
groups. An edge that exists with another type (bd keeps one type per bead
pair), a removed edge, a missing bead, or a bead at a poured id from another
formula revision refuses that target, with sc-compose's typed code, before
anything is written.

--validate writes nothing: it previews each attach (`sc-compose bead
preview-attach`) and reports every missing bead, missing edge and
SanityBead schema problem; a relation to a bead that does not exist yet is
reported as a missing bead.

No poured bead gets an assignee: each carries `difficulty`, and the lead
picks the agent at dispatch. Variables come from the target beads, the
phase file `.atm-bd/phase-<p>.toml` (plan file, root) and the relations file.
For a finding, the branch is `fix/<sprint>-<normalized finding ref>`, the
worktree is beneath the configured `worktree_base`, and `pr_target` is the
stack ledger's last layer branch, or its trunk when no layers exist.
Requests and receipts are written to <repo>/.atm-bd/pour/.

Exit: 0 succeeded (validate: nothing missing or wrong), 5 validate found
problems, 2 a target was refused or failed, 3 usage.
"""
from __future__ import annotations

import argparse
import json
import re
import string
import subprocess
import sys
from pathlib import Path

SCRIPTS = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPTS))
sys.path.insert(0, str(SCRIPTS.parents[1] / "atm-beads" / "scripts"))
import bead_formulas  # noqa: E402
import repo_config  # noqa: E402
import sprint_index_common  # noqa: E402
from bead_formulas import Bd, BdError, attach_id  # noqa: E402
from stack_top import stack_bead_id  # noqa: E402

SCHEMA = "atm-bd-orchestration/bead-groups/v1"
SUCCESS, FAILED, USAGE, PROBLEMS = 0, 2, 3, 5
SPRINT_KEYS = ("phase", "sprint", "stack", "layer", "difficulty", "branch", "worktree", "pr_target")
FINDING_FIELDS = ("ref", "severity", "reviewer", "title", "remedy")
REF = re.compile(r"[a-z0-9]+(-[a-z0-9]+)*")


class TargetError(Exception):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code
        self.target_id: str | None = None


class Strict(dict):
    def __missing__(self, key):
        raise TargetError("BEAD_GROUPS_UNRESOLVED", f"no value for {key!r}")


def fmt(template: str, scope: dict) -> str:
    try:
        return string.Formatter().vformat(template, (), Strict(scope))
    except (KeyError, IndexError) as exc:
        raise TargetError("BEAD_GROUPS_UNRESOLVED", f"{template}: no value for {exc}") from exc


def dependency_order(targets: list[tuple[dict, dict]]) -> list[tuple[dict, dict]]:
    """Sprints before the sprints that depend on them (a relation's bead must exist when it is attached), then findings."""
    sprints = [(e, t) for e, t in targets if t["kind"] == "sprint"]
    container = {t["id"]: i for i, (_, t) in enumerate(sprints)}
    done: list[int] = []

    def visit(i: int, path: tuple[int, ...] = ()) -> None:
        if i in done or i in path:
            return
        for pred in sprints[i][1]["vars"].get("predecessors", []):
            if pred in container:
                visit(container[pred], path + (i,))
        done.append(i)

    for i in range(len(sprints)):
        visit(i)
    return [sprints[i] for i in done] + [(e, t) for e, t in targets if t["kind"] != "sprint"]


def split_ids(values: list[str]) -> list[str]:
    return [v for value in values for v in value.split(",") if v]


class Run:
    def __init__(self, repo: Path, option: str | None):
        self.repo, self.option = repo, option
        self.config = repo_config.load(repo)
        self.bd = Bd()
        self.plans: dict[str, dict] = {}
        self.sidecars: dict[str, dict] = {}

    def sidecar(self, formula: str) -> dict:
        if formula not in self.sidecars:
            path = bead_formulas.relations(formula, self.repo)
            self.sidecars[formula] = {**json.loads(path.read_text()), "_path": str(path)}
        return self.sidecars[formula]

    def plan(self, phase: str) -> dict:
        """sprint name -> (container id, initial sanity id, predecessor sprint names), from the phase's plan file."""
        if phase not in self.plans:
            try:
                config = sprint_index_common.load_phase_config(self.repo, phase)
            except RuntimeError as exc:
                raise TargetError("BEAD_GROUPS_PLAN_NOT_FOUND", str(exc)) from exc
            path = self.repo / config["plan"]
            if not path.is_file():
                raise TargetError("BEAD_GROUPS_PLAN_NOT_FOUND", f"{path} does not exist")
            rows, problems = sprint_index_common.parse_plan(path.read_text(), str(path))
            if problems:
                raise TargetError("BEAD_GROUPS_PLAN_INVALID", "; ".join(problems))
            prefix = sprint_index_common.bead_prefix(config["root"], self.repo)
            ref = self.sidecar("sprint-group")["ref"]
            self.plans[phase] = {r["sprint"]: (f"{prefix}-{r['sprint']}", attach_id(f"{prefix}-{r['sprint']}", ref, "sanity"), r["depends_on"])
                                 for r in rows}
        return self.plans[phase]

    def show(self, bead: str) -> dict:
        row = self.bd.show(bead)
        if row is None:
            raise TargetError("BEAD_GROUPS_TARGET_NOT_FOUND", f"{bead} does not exist")
        return row

    def close_compose(self, phase: str, checked_title: str, stack_bead: str | None = None) -> dict:
        """The close-field compose variables (close_fields.POURED) every poured step carries."""
        features = self.__dict__.setdefault("features", {})
        if phase not in features:
            root = sprint_index_common.load_phase_config(self.repo, phase)["root"]
            title = self.show(root).get("title")
            if not title:
                raise TargetError("BEAD_GROUPS_TARGET_INVALID", f"phase root {root} has no title for phase_feature")
            features[phase] = {"stack_bead": stack_bead or stack_bead_id(root), "phase_feature": title}
        if not checked_title:
            raise TargetError("BEAD_GROUPS_TARGET_INVALID", "the checked work has no title for checked_title")
        return {**features[phase], "checked_title": checked_title, "lint_command": self.config["lint_command"],
                "policy_path": self.config["policy_path"], "max_sanity_rounds": self.config["max_sanity_rounds"]}

    def option_for(self, sidecar: dict) -> str:
        option = self.option or sidecar["default_option"]
        if option not in sidecar["options"]:
            raise TargetError("BEAD_GROUPS_OPTION_UNKNOWN", f"option {option!r} is not in {sorted(sidecar['options'])}")
        return option

    def sprint_target(self, bead: str) -> dict:
        container = self.show(bead)
        meta = container.get("metadata") or {}
        missing = [k for k in SPRINT_KEYS if meta.get(k) in (None, "")]
        if missing:
            raise TargetError("BEAD_GROUPS_TARGET_INVALID", f"{bead} lacks {', '.join(missing)}")
        sidecar = self.sidecar("sprint-group")
        option = self.option_for(sidecar)
        plan = self.plan(str(meta["phase"]))
        if meta["sprint"] not in plan or plan[meta["sprint"]][0] != bead:
            raise TargetError("BEAD_GROUPS_PLAN_MISMATCH", f"{bead} is not sprint {meta['sprint']} of phase {meta['phase']}'s plan file")
        deps = plan[meta["sprint"]][2]
        compose = {"parent": bead, "phase": meta["phase"], "sprint": meta["sprint"], "stack": meta["stack"],
                   "layer": meta["layer"], "difficulty": meta["difficulty"], "priority": container.get("priority", 2),
                   "branch": meta["branch"], "worktree": meta["worktree"], "pr_target": meta["pr_target"],
                   "edge_option": option, **self.close_compose(str(meta["phase"]), container.get("title") or "")}
        compose["ref"] = fmt(sidecar["ref"], {"vars": compose})
        relate_vars = {**sidecar.get("defaults", {}), "predecessor_sanity": [plan[d][1] for d in deps],
                       "predecessors": [plan[d][0] for d in deps],
                       "predecessor_dev": [attach_id(plan[d][0], compose["ref"], "dev") for d in deps]}
        return {"kind": "sprint", "id": bead, "formula": "sprint-group", "option": option, "compose": compose, "vars": relate_vars}

    def finding_targets(self, path: Path) -> list[dict | TargetError]:
        """One target per finding in a findings file; a finding that cannot be poured is a TargetError in its place."""
        try:
            doc = json.loads(Path(path).read_text())
            sprint, round_, filed_by, findings = doc["sprint"], doc["round"], doc["filed_by"], doc["findings"]
            found_at = doc["found_at_commit"]
        except (OSError, ValueError, KeyError, TypeError) as exc:
            raise TargetError("BEAD_GROUPS_FINDINGS_INVALID", f"{path}: {exc!r}; expected sprint, round, filed_by, found_at_commit, findings") from exc
        if not isinstance(round_, int) or round_ < 1 or not isinstance(findings, list):
            raise TargetError("BEAD_GROUPS_FINDINGS_INVALID", f"{path}: round must be an integer >= 1 and findings a list")
        if not isinstance(found_at, str) or not re.fullmatch(r"[0-9a-f]{7,40}", found_at):
            raise TargetError("BEAD_GROUPS_FINDINGS_INVALID", f"{path}: found_at_commit must be a commit sha")
        container = self.show(sprint)
        meta = container.get("metadata") or {}
        phase_end = bool(re.fullmatch(r".+-phase-[a-z0-9]+", sprint)) and not any(meta.get(k) for k in ("sprint", "stack"))
        if phase_end:
            # A phase-end finding traces to the phase epic, which carries phase metadata but no sprint/stack facts: the epic is the "sprint",
            # the phase comes from its id (it wins over the epic's own phase key), the stack is the phase's stack ledger, and difficulty must come per finding.
            meta = {**meta, "phase": sprint_index_common.phase_of_root(sprint), "sprint": sprint, "stack": "stack"}
        missing = [k for k in ("phase", "sprint", "stack", "difficulty") if meta.get(k) in (None, "")]
        if missing and not (phase_end and missing == ["difficulty"]):
            raise TargetError("BEAD_GROUPS_TARGET_INVALID", f"{sprint} lacks {', '.join(missing)}")
        qa_closed = self.show(filed_by).get("status") == "closed"
        sidecar = self.sidecar("finding-group")
        option = self.option_for(sidecar)
        import bead_schema
        stack_id = stack_bead_id(sprint_index_common.load_phase_config(self.repo, str(meta['phase']))['root'])
        stack = self.show(stack_id)
        issues = bead_schema.problems(stack, bead_schema.StackBead)
        if issues:
            raise TargetError("BEAD_GROUPS_TARGET_INVALID", "; ".join(issues))
        stack_meta = bead_schema.StackMetadata.model_validate(stack["metadata"])
        pr_target = stack_meta.layers[-1].branch if stack_meta.layers else stack_meta.trunk
        out: list[dict | TargetError] = []
        for finding in findings:
            ref = finding.get("ref") if isinstance(finding, dict) else None
            try:
                slug = re.sub(r"[^a-z0-9-]", "-", ref.lower()) if isinstance(ref, str) else ""
                if not REF.fullmatch(slug):
                    raise TargetError("BEAD_GROUPS_FINDINGS_INVALID", f"finding ref {ref!r} must normalize to letters, digits and single hyphens")
                lacking = [k for k in FINDING_FIELDS if finding.get(k) in (None, "")]
                if phase_end and finding.get("difficulty") in (None, ""):
                    lacking.append("difficulty (a phase-end finding has no sprint to take it from)")
                if lacking:
                    raise TargetError("BEAD_GROUPS_FINDINGS_INVALID", f"finding {ref} lacks {', '.join(lacking)}")
                # Deleted when a released sc-compose pours a string layer (preview-attach passes).
                layer = finding.get("found_on_layer")
                if layer not in (None, "") and (not isinstance(layer, int) or isinstance(layer, bool)):
                    raise TargetError("BEAD_GROUPS_FOUND_ON_LAYER_NOT_INTEGER",
                                      f"finding {ref}: found_on_layer {layer!r} is not an integer; pass the integer stack layer, "
                                      "or omit found_on_layer and put free text in the finding description")
                branch = f"fix/{meta['sprint']}-{slug}"
                # Layer records carry no difficulty, so the cut takes it from the finding or the sprint and the fix group carries all four keys together.
                cut = {"branch": branch, "worktree": str(Path(self.config["worktree_base"]) / branch), "pr_target": pr_target,
                       "difficulty": finding.get("difficulty") or meta["difficulty"]}
                if finding["severity"] != "blocking":
                    raise TargetError("BEAD_GROUPS_NOT_BLOCKING", f"finding {ref} is {finding['severity']}; only blocking findings are poured, file it as a finding bead")
                ids = {k: finding[k] if k in finding else meta.get(k) for k in ("requirements", "adrs")}
                bad = [k for k, v in ids.items() if not isinstance(v, list) or not v or not all(isinstance(i, str) and i for i in v)]
                if bad:
                    raise TargetError("BEAD_GROUPS_FINDINGS_INVALID", f"finding {ref}: {', '.join(bad)} must be a nonempty list of ids (from the finding or {sprint}'s metadata)")
                compose = {"parent": sprint, "finding_ref": ref, "round": round_, "severity": finding["severity"],
                           "reviewer": finding["reviewer"], "finding_title": finding["title"], "remedy": finding["remedy"],
                           "filed_by": filed_by, "found_at_commit": found_at, **ids,
                           "phase": meta["phase"], "sprint": meta["sprint"], "stack": meta["stack"],
                           **cut,
                           "found_on_layer": finding.get("found_on_layer", ""),
                           "has_found_on_layer": finding.get("found_on_layer") not in (None, ""),
                           "priority": finding.get("priority", 1),
                           "edge_option": option, **self.close_compose(str(meta["phase"]), f"{meta['sprint']}: fix {ref}: {finding['title']}", stack_id)}
                compose["ref"] = fmt(sidecar["ref"], {"vars": {**compose, "finding_ref": slug}})
                existing = self.bd.show(attach_id(sprint, compose["ref"], "fix"))
                existing_cut = (existing or {}).get("metadata") or {}
                if all(existing_cut.get(key) for key in cut):
                    compose.update({key: existing_cut[key] for key in cut})
                out.append({"kind": "finding", "id": f"{sprint}.{compose['ref']}", "formula": "finding-group", "option": option,
                            "compose": compose, "vars": dict(sidecar.get("defaults", {})), "qa_closed": qa_closed})
            except TargetError as exc:
                exc.target_id = f"{sprint}.{ref}-r{round_}" if isinstance(ref, str) else f"{sprint}:{path}"
                out.append(exc)
        return out

    def steps(self, target: dict) -> list[str]:
        names = ("dev", "sanity", "qa") if target["kind"] == "sprint" else ("fix", "sanity", "qa")
        return list(names[:1] if target["option"] == "A" else names)

    def pour(self, target: dict, *, preview: bool) -> dict:
        formula = target["formula"]
        template = bead_formulas.template(formula, self.repo).resolve()
        try:
            template = template.relative_to(self.repo.resolve())
        except ValueError as exc:
            raise TargetError("BEAD_GROUPS_TEMPLATE_OUTSIDE_REPO", f"{template} is outside {self.repo}; sc-compose renders only inside the working directory") from exc
        out = self.repo / ".atm-bd" / "pour"
        out.mkdir(parents=True, exist_ok=True)
        ignore = out / ".gitignore"  # requests, receipts and rendered formulas are run records; only .atm-bd/formula/ is tracked
        if not ignore.exists():
            ignore.write_text("*\n")
        stem = f"{target['id']}.{target['compose']['ref']}.{formula}"
        relations, missing = self.relations(target, preview=preview)
        # The attach reads the rendered formula by path, so it stays beside its request; nothing goes in bd's registry.
        operation = "preview_attach" if preview else "attach"
        request = {
            "schema": "sc-compose/beads/v1", "operation": operation, "working_directory": str(self.repo),
            "template": str(template), "rendered_formula": str(out / f"{stem}.formula.toml"),
            "compose_variables": target["compose"], "formula_name": formula, "bead_variables": {},
            "parent": target["compose"]["parent"], "ref": target["compose"]["ref"], "relations": relations,
            **({} if preview else {"pour_authorization": "CreatePersistentBeads"}),
        }
        path = out / f"{stem}.request.json"
        path.write_text(json.dumps(request, indent=2) + "\n")
        subcommand = operation.replace("_", "-")
        proc = subprocess.run(["sc-compose", "bead", subcommand, "--request", str(path), "--json"], cwd=self.repo, text=True, capture_output=True)
        (out / f"{stem}.{subcommand}.receipt.json").write_text(proc.stdout)
        try:
            payload = json.loads(proc.stdout)["payload"]
        except (ValueError, KeyError, TypeError) as exc:
            raise TargetError("BEAD_GROUPS_POUR_FAILED", f"attach gave no receipt (exit {proc.returncode}): {proc.stderr.strip()}") from exc
        if proc.returncode or payload.get("outcome") != "succeeded":
            outcome = payload.get("outcome")
            diagnostic = (json.loads(proc.stdout).get("diagnostics") or [{}])[0]
            code = ((payload.get("error") or {}).get("code")
                    or (next(iter(next(iter(outcome.values())).values())) if isinstance(outcome, dict) else None)
                    or diagnostic.get("code") or "BEAD_GROUPS_POUR_FAILED")
            failed = [s for s in payload.get("stages") or [] if s.get("outcome") != "succeeded"] or [{}]
            detail = (payload.get("error") or {}).get("message") or failed[-1].get("stderr_excerpt") or diagnostic.get("message", "")
            raise TargetError(code, f"attach of {target['id']} (sc-compose exit {proc.returncode}): {detail}")
        graph = payload["graph"]
        wanted = {(self.endpoint(graph, r["from"]), self.endpoint(graph, r["to"]), r["type"]) for r in relations}
        return {"ids": graph["ids"], "nodes": graph["nodes"], "missing": missing, "graph": graph,
                "edges": [e for e in graph["edges"] if (e["from"], e["to"], e["type"]) in wanted]}

    @staticmethod
    def endpoint(graph: dict, value: str) -> str:
        kind, _, name = value.partition(":")
        if kind == "step":
            return graph["ids"][name]
        return name if kind == "bead" else value

    def relations(self, target: dict, *, preview: bool) -> tuple[list[dict], list[str]]:
        """The attach `relations` from the formula's relations file, and (validate only) a problem for each one
        whose bead does not exist yet; the preview leaves those out, the attach refuses them."""
        sidecar = self.sidecar(target["formula"])
        scope = {"vars": Strict({**target["compose"], **{k: v for k, v in target["vars"].items() if not isinstance(v, list)}})}
        rules = [*sidecar["options"][target["option"]].get("relations", []), *sidecar.get("relations", [])]
        rules = [(r, target["vars"].get(r["each"], []) if "each" in r else [None]) for r in rules]
        relations, missing = [], []
        for rule, values in rules:
            for value in values:
                each = {**scope, "each": value}
                relation = {"from": fmt(rule["from"], each), "to": fmt(rule["to"], each), "type": rule["type"]}
                if relation in relations:
                    continue
                beads = [e.partition(":")[2] for e in (relation["from"], relation["to"]) if e.startswith("bead:")]
                absent = [b for b in beads if preview and self.bd.show(b) is None]
                if absent:
                    missing += [f"missing bead {b} for {relation['from']} -{relation['type']}-> {relation['to']}" for b in absent]
                else:
                    relations.append(relation)
        return relations, missing

    def prospective(self, attachment: dict) -> list[dict]:
        graph = attachment["graph"]
        if not graph.get("plan_path"):
            if all(node["action"] == "existing" for node in graph["nodes"]):
                return []
            raise ValueError("sc-compose preview did not provide its rendered plan")
        path = Path(graph["plan_path"])
        if not path.is_absolute():
            path = self.repo / path
        plan = json.loads(path.read_text())
        nodes = {node["id"]: node for node in plan["nodes"]}
        for edge in graph["edges"]:
            source = self.endpoint(graph, edge["from"])
            target = self.endpoint(graph, edge["to"])
            if source in nodes:
                nodes[source].setdefault("dependencies", []).append({"type": edge["type"], "depends_on_id": target})
        return list(nodes.values())


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="bead-groups", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--sprint", action="append", default=[])
    parser.add_argument("--phase", action="append", default=[])
    parser.add_argument("--findings", action="append", default=[], type=Path)
    parser.add_argument("--option")
    parser.add_argument("--validate", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    if not (args.sprint or args.phase or args.findings):
        parser.error("name at least one --sprint, --phase or --findings")
    result = {"schema": SCHEMA, "mode": "validate" if args.validate else "apply", "targets": []}
    try:
        run = Run(repo_config.repo_root(), args.option)
        sprint_ids = split_ids(args.sprint)
        for phase in args.phase:
            sprint_ids += [row[0] for row in run.plan(phase).values()]
        finding_targets = [t for path in args.findings for t in run.finding_targets(path)]
    except (repo_config.ConfigError, TargetError, RuntimeError, OSError) as exc:
        result.update({"outcome": "failed", "error": {"code": getattr(exc, "code", "BEAD_GROUPS_CANNOT_RUN"), "message": str(exc)}})
        return report(result, args.json, USAGE)

    entries, targets = [], []
    for kind, item in [("sprint", b) for b in dict.fromkeys(sprint_ids)] + [("finding", t) for t in finding_targets]:
        if isinstance(item, TargetError):
            bead = item.target_id or "unknown finding"
        elif isinstance(item, dict):
            bead = item["id"]
        else:
            bead = item
        entry = {"id": bead, "kind": kind, "problems": []}
        entries.append(entry)
        try:
            if isinstance(item, TargetError):
                raise item
            if kind == "sprint":
                target = run.sprint_target(bead)
            else:
                assert isinstance(item, dict)
                target = item
            entry.update({"formula": target["formula"], "option": target["option"]})
            targets.append((entry, target))
        except (TargetError, BdError) as exc:
            entry["error"] = {"code": getattr(exc, "code", "BEAD_GROUPS_BD_FAILED"), "message": str(exc)}
    ordered = dependency_order(targets)
    previews = []
    preview_failed = False
    for entry, target in ordered:
        try:
            if target.get("qa_closed") and not args.validate:
                parent, ref = target["compose"]["parent"], target["compose"]["ref"]
                if any(run.bd.show(attach_id(parent, ref, step)) is None for step in run.steps(target)):
                    raise TargetError("BEAD_GROUPS_QA_CLOSED", f"{target['compose']['filed_by']} is closed; pour before closing QA")
            attachment = run.pour(target, preview=True)
            previews.append((entry, target, attachment))
            entry.update({"ids": attachment["ids"], "nodes": attachment["nodes"], "edges": attachment["edges"]})
            created = {n["id"] for n in attachment["nodes"] if n["action"] == "create"}
            entry["problems"] += [f"missing bead {i}" for i in created] + attachment["missing"]
            edges = [e for e in attachment["edges"] if e["action"] == "add" and e["from"] not in created]
            entry["problems"] += [f"missing edge {e['from']} -{e['type']}-> {e['to']}" for e in edges]
        except (TargetError, BdError, OSError, ValueError, KeyError) as exc:
            preview_failed = True
            entry["error"] = {"code": getattr(exc, "code", "BEAD_GROUPS_BD_FAILED"), "message": str(exc)}
    if previews:
        try:
            import bead_schema
            for phase in sorted({target["compose"]["phase"] for _, target, _ in previews}):
                current = bead_schema.load_phase(phase)
                prospective = [node for _, target, attachment in previews if target["compose"]["phase"] == phase
                               for node in run.prospective(attachment)]
                issues = bead_schema.validate_phase([*current, *prospective])
                if issues:
                    next(entry for entry, target, _ in previews if target["compose"]["phase"] == phase)["problems"] += issues
                    result["schema_problems"] = True
        except (OSError, ValueError, KeyError) as exc:
            result.update({"targets": entries, "outcome": "failed", "error": {"code": "BEAD_GROUPS_CANNOT_RUN", "message": str(exc)}})
            return report(result, args.json, FAILED)
    if not args.validate and not preview_failed and not result.get("schema_problems"):
        for entry, target, _ in previews:
            try:
                attachment = run.pour(target, preview=False)
                entry.update({"ids": attachment["ids"], "nodes": attachment["nodes"], "edges": attachment["edges"], "problems": []})
            except (TargetError, BdError) as exc:
                entry["error"] = {"code": getattr(exc, "code", "BEAD_GROUPS_BD_FAILED"), "message": str(exc)}
    result["targets"] = entries
    if any("error" in e for e in entries):
        result["outcome"], code = "failed", FAILED
    elif result.get("schema_problems") or (args.validate and any(e["problems"] for e in entries)):
        result["outcome"], code = "problems", PROBLEMS
    else:
        result["outcome"], code = "succeeded", SUCCESS
    return report(result, args.json, code)


def report(result: dict, as_json: bool, code: int) -> int:
    if as_json:
        print(json.dumps(result, indent=2))
        return code
    if "error" in result:
        print(f"{result['error']['code']}: {result['error']['message']}", file=sys.stderr)
        return code
    for entry in result["targets"]:
        if "error" in entry:
            print(f"{entry['id']}: {entry['error']['code']}: {entry['error']['message']}", file=sys.stderr)
            continue
        made = [n["id"] for n in entry.get("nodes", []) if n["action"] == "created"]
        added = [r for r in entry.get("edges", []) if r["action"] == "added"]
        print(f"{entry['id']}: {len(made)} bead(s) poured, {len(added)} edge(s) added")
        for problem in entry["problems"]:
            print(f"  {problem}")
    return code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
