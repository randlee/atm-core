#!/usr/bin/env python3
# pyright: strict
"""Fix-verification scope: who may verify a fix, and what the verifier may report.

A review of an assigned fix dispatches only the agent that filed each carried
finding (the finding bead's `metadata.reviewer`), locked to that finding's own id
(`metadata.finding_ref`). The verifier reports fixed, open or regressed for those
ids and files no new findings. A carried id the verifier does not report stays open.

Plan findings are not beads: they are report lines `<bead> <severity> <reviewer>
<field>: <what is wrong>`, and a plan fix round carries them as text. With
`--plan`, `--carried` is that text; the filing reviewer is the line's third word
and the finding id is `<bead> <field>`. `validate-plan` findings are re-checked by
the plan review's own validate-plan step, so it is never a dispatched reviewer.

    owned  --carried <bd show json> [--plan]              {filing reviewer: [its finding_refs]}
    check  --carried <bd show json> --dispatch a,b         exit 5 unless the dispatch set is exactly the filing reviewers
    filter --carried <bd show json> --reviewer <name> --result <json>
                                                           the result reduced to dispositions on that reviewer's carried ids
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import TypedDict
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "atm-beads" / "scripts"))

from operation_models import matches_typeddict

PLAN_LINE = re.compile(r"^\s*(?:[-*]\s+)?(?P<bead>\S+)\s+(?P<severity>blocking|important|minor)\s+"
                       r"(?P<reviewer>\S+)\s+(?P<field>[^:\s][^:]*):")
PLAN_SCRIPT = "validate-plan"
FENCED = re.compile(r"\s*```(?:json)?[ \t]*\n(.*?)\n```\s*", re.S)  # a reviewer result as returned: fenced JSON


class ScopeError(ValueError):
    """A carried finding cannot be locked to its filing reviewer."""


class FindingMetadata(TypedDict, total=False):
    reviewer: str
    finding_ref: str


class CarriedFinding(TypedDict, total=False):
    id: str
    metadata: FindingMetadata


class CarriedFindings(TypedDict):
    findings: list[CarriedFinding]


class ReviewFinding(TypedDict, total=False):
    id: str
    disposition: str
    evidence: str


class ReviewData(TypedDict, total=False):
    findings: list[ReviewFinding]


class ReviewResult(TypedDict, total=False):
    data: ReviewData
    findings: list[ReviewFinding]


class Disposition(TypedDict):
    bead: str
    finding_ref: str
    disposition: str
    evidence: str


class FilteredResult(TypedDict):
    reviewer: str
    dispositions: list[Disposition]
    new_findings: list[ReviewFinding]
    dropped_out_of_scope: list[ReviewFinding]


def carried_findings(value: object) -> list[CarriedFinding]:
    document = {"findings": value}
    if not matches_typeddict(document, CarriedFindings):
        raise ScopeError("carried findings must be an array of bead records with string id and metadata fields")
    return document["findings"]


def owned(carried: list[CarriedFinding]) -> dict[str, list[str]]:
    """Carried finding beads -> {filing reviewer: [its own finding_refs]}; the keys are the whole dispatch set."""
    out: dict[str, list[str]] = {}
    for bead in carried:
        meta = bead.get("metadata") or {}
        reviewer, ref = meta.get("reviewer"), meta.get("finding_ref")
        if not (reviewer and ref):
            raise ScopeError(f"{bead.get('id', '?')}: carried finding has no metadata.reviewer/finding_ref to lock to")
        out.setdefault(reviewer, []).append(ref)
    return out


def plan_carried(text: str) -> list[CarriedFinding]:
    """Carried plan finding lines -> the bead-shaped records owned/check/filter take."""
    out: list[CarriedFinding] = []
    for line in text.splitlines():
        if not line.strip():
            continue
        m = PLAN_LINE.match(line)
        if not m:
            raise ScopeError(f"carried plan finding is not `<bead> <severity> <reviewer> <field>: ...`: {line.strip()}")
        ref = f"{m['bead']} {m['field'].strip()}"
        out.append({"id": ref, "metadata": {"reviewer": m["reviewer"], "finding_ref": ref}})
    return out


def check(carried: list[CarriedFinding], dispatch: list[str]) -> tuple[list[str], list[str]]:
    """(extra, missing): reviewers dispatched that filed no carried finding, and filing reviewers not dispatched."""
    want = set(owned(carried)) - {PLAN_SCRIPT}
    have = set(dispatch)
    return sorted(have - want), sorted(want - have)


def filter_result(reviewer: str, carried: list[CarriedFinding], result: ReviewResult) -> FilteredResult:
    """Reduce a verifier result to dispositions on its own carried beads; nothing else survives."""
    scope: dict[str, str] = {}
    for bead in carried:
        metadata = bead.get("metadata", {})
        if metadata.get("reviewer") == reviewer:
            finding_ref, bead_id = metadata.get("finding_ref"), bead.get("id")
            if not finding_ref or not bead_id:
                raise ScopeError("carried finding has no string id/finding_ref")
            scope[finding_ref] = bead_id
    data = result.get("data")
    findings = data.get("findings", []) if data is not None else result.get("findings", [])
    reported: dict[str, ReviewFinding] = {}
    dropped: list[ReviewFinding] = []
    for finding in findings or []:
        ref = finding.get("id")
        if ref in scope and ref not in reported:
            reported[ref] = finding
        else:
            dropped.append(finding)
    dispositions: list[Disposition] = []
    for ref, bead in scope.items():
        finding = reported.get(ref)
        disposition = finding.get("disposition", "open") if finding else "open"
        evidence = finding.get("evidence", "") if finding else ""
        dispositions.append({"bead": bead, "finding_ref": ref, "disposition": disposition, "evidence": evidence})
    return {"reviewer": reviewer, "dispositions": dispositions, "new_findings": [], "dropped_out_of_scope": dropped}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("owned", "filter", "check"))
    parser.add_argument("--carried", required=True, help="bd show <carried ids> --json; with --plan, the carried plan finding lines")
    parser.add_argument("--plan", action="store_true", help="--carried is a plan review's carried finding lines")
    parser.add_argument("--dispatch", default="", help="check: the reviewers to be dispatched, comma-separated")
    parser.add_argument("--reviewer", default="")
    parser.add_argument("--result", default="", help="the reviewer's fenced-JSON result")
    args = parser.parse_args(argv)
    try:
        carried = plan_carried(open(args.carried).read()) if args.plan else carried_findings(json.load(open(args.carried)))
        filing = owned(carried)
    except ScopeError as exc:
        print(f"fix-round-scope: {exc}", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"fix-round-scope: cannot read --carried {args.carried}: {exc}; pass the path of the file `bd show <fix bead> --json` wrote", file=sys.stderr)
        return 2
    if args.command == "owned":
        print(json.dumps(filing))
        return 0
    if args.command == "check":
        extra, missing = check(carried, [n.strip() for n in args.dispatch.split(",") if n.strip()])
        if extra or missing:
            print("FIX_ROUND_DISPATCH_MISMATCH: not a filing reviewer: " + (" ".join(extra) or "-")
                  + "; filing reviewer not dispatched: " + (" ".join(missing) or "-"), file=sys.stderr)
            return 5
        return 0
    if args.reviewer not in filing or not args.result:
        print(f"filter needs --reviewer in {tuple(filing)} and --result", file=sys.stderr)
        return 2
    try:
        text = open(args.result).read()
    except OSError as exc:
        print(f"fix-round-scope: cannot read --result {args.result}: {exc}; --result is a file path, not inline JSON: save the "
              "reviewer's reply verbatim to <scratch>/<task>-<reviewer>-result.json and pass that path", file=sys.stderr)
        return 2
    fenced = FENCED.fullmatch(text)
    try:
        parsed_result = json.loads(fenced.group(1) if fenced else text)
        if not matches_typeddict(parsed_result, ReviewResult):
            raise ValueError("expected a review result object with typed fields")
        result: ReviewResult = parsed_result
    except ValueError as exc:
        print(f"fix-round-scope: --result is not the reviewer's fenced or raw JSON result: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(filter_result(args.reviewer, carried, result)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
