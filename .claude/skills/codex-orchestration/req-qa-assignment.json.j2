---
name: req-qa-assignment
version: 1.4.0
description: Render a fenced-JSON assignment for req-qa.
format: json
required_variables:
  - reference_docs
defaults:
  sprint_doc: ""
  pr_scope: ""
  pr_number: ""
  pr_head_sha: ""
  phase: ""
  sprint: ""
  worktree_path: ""
  branch: ""
  commit: ""
  review_targets: []
  round_limit: false
  changed_files: []
  carry_forward_findings_json: "[]"
  triage_records: []
  notes: ""
---
{#- Exactly one scope source: a sprint review names its sprint_doc; a standalone PR review carries the reviewed scope text (pr_scope, as the lead captured it into the QA assignment) with the PR number and the head SHA it is judged at; the text's line endings are normalized to LF once (CRLF and lone CR become LF, matching the QA assignment's XML); every other byte is emitted unchanged, trimming is only the empty check. Neither, both, or a PR scope without its head fails the render instead of reviewing open-ended. #}
{%- set sprint_scoped = sprint_doc | trim -%}
{%- set pr_scope = pr_scope | replace("
", "
") | replace("", "
") -%}
{%- set pr_scoped = pr_scope | trim -%}
{%- if not sprint_scoped and not pr_scoped %}SCOPE_SOURCE_REQUIRED{% endif -%}
{%- if sprint_scoped and pr_scoped %}SPRINT_DOC_AND_PR_SCOPE_BOTH_GIVEN{% endif -%}
{%- if pr_scoped and not pr_head_sha | trim %}PR_SCOPE_WITHOUT_PR_HEAD_SHA{% endif -%}
{%- if pr_scoped and not pr_number | trim %}PR_SCOPE_WITHOUT_PR_NUMBER{% endif -%}
{
  "scope": {
    "phase": {% if phase %}{{ phase }}{% else %}null{% endif %},
    "sprint": {% if sprint %}{{ sprint }}{% else %}null{% endif %}
  },
  "phase_or_sprint_docs": [{% for doc in reference_docs %}{{ doc }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "phase_sprint_documents": [{% for doc in reference_docs %}{{ doc }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "authoritative_sprint_doc": {% if sprint_scoped %}{{ sprint_doc | trim }}{% else %}null{% endif %},
  "pr_scope": {% if pr_scoped %}{
    "pr_number": {{ pr_number | trim }},
    "head_sha": {{ pr_head_sha | trim }},
    "text": {{ pr_scope }}
  }{% else %}null{% endif %},
  "worktree_path": {% if worktree_path %}{{ worktree_path }}{% else %}null{% endif %},
  "branch": {% if branch %}{{ branch }}{% else %}null{% endif %},
  "commit": {% if commit %}{{ commit }}{% else %}null{% endif %},
  "review_targets": [{% for target in review_targets %}{{ target }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "round_limit": {% if round_limit %}true{% else %}false{% endif %},
  "changed_files": [{% for file in changed_files %}{{ file }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "triage_records": [{% for record in triage_records %}{{ record }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "carry_forward_findings": {{ carry_forward_findings_json }},
  "notes": {{ notes }}
}
