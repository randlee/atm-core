  a triage:Finding ;
  triage:findingId "AG7-ATM-QA-103-STALE-FRONTMATTER" ;
  triage:title "Sprint-doc frontmatter branch/worktree fields point to stale plan branches" ;
  triage:description "Sprint AG.4-AG.10 doc frontmatter blocks still reference plan/phase-ag-multihost-advertise-allowlist branch and stale worktree paths instead of actual feature branches (pAG-s4 through pAG-s10). This is a more specific variant of AG-FIND-FRONTMATTER (status:planned being stale) - here the branch and worktree metadata fields are incorrect, affecting doc automation and cross-references. Detected in AG.7 (PR #558, feature/pAG-s7-live-revalidation @ 7221d01b) during QA-2 recheck, but appears across all open AG sprint branches. AG.9 and AG.10 partially fixed AG.8 and AG.10 docs in later sprints." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
