<urn:atm:triage:finding/AG10-PUBLIC-FIELDS-BYPASS-VALIDATION>
  a triage:Finding ;
  triage:findingId "AG10-PUBLIC-FIELDS-BYPASS-VALIDATION" ;
  triage:title "AG.10 secured-transport config structs expose public fields that bypass validated constructors" ;
  triage:description "Credential and config structs in AG.10's secured-transport implementation define public fields without requiring construction through validated builder or new() methods. This allows callers to construct instances that bypass invariant checks on host_name, fingerprint_sha256, and approval metadata." ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T22:11:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-PUBLIC-FIELDS-BYPASS-VALIDATION/s9/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-PUBLIC-FIELDS-BYPASS-VALIDATION/s10/1> ;
  triage:openOn <urn:atm:triage:worktree/s9/c47dbae5> ;
