@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AG10-PUBLIC-FIELDS-BYPASS-VALIDATION>
  a triage:Finding ;
  triage:findingId "AG10-PUBLIC-FIELDS-BYPASS-VALIDATION" ;
  triage:title "AG.10 secured-transport config structs expose public fields that bypass validated constructors" ;
  triage:description "Credential and config structs in AG.10's secured-transport implementation define public fields without requiring construction through validated builder or new() methods. This allows callers to construct instances that bypass invariant checks on host_name, fingerprint_sha256, and approval metadata." ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-16T18:35:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-PUBLIC-FIELDS-BYPASS-VALIDATION/s10/fixed> ;
  triage:fixedOn <urn:atm:triage:worktree/s10/7eeeaf2d> .

<urn:atm:triage:occurrence/AG10-PUBLIC-FIELDS-BYPASS-VALIDATION/s10/fixed>
  a triage:Occurrence ;
  triage:file "crates/atm-storage/src/contract/peer_security.rs" ;
  triage:line 74 ;
  triage:snippet "certificate_der: Vec<u8>," ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAG-s10-secured-transport" ;
  triage:headSha "7eeeaf2d" ;
  triage:evidence "LocalPeerIdentityRow (line 73-79): all fields are private; construction requires LocalPeerIdentityRow::new() (lines 82-113) which validates certificate_der and private_key_der are non-empty and normalizes fingerprint_sha256. TrustedPeerRow (lines 137-145): all fields private; construction requires TrustedPeerRow::new() (lines 148-173) which validates approved_by is non-blank and normalizes fingerprint_sha256. Verified via PR #560 AG10-FIX-2-QA verdict (FIXED) and direct file inspection on 7eeeaf2d." ;
  triage:occursIn <urn:atm:triage:worktree/s10/7eeeaf2d> .

