<urn:atm:triage:finding/AG10-PUBLIC-FIELDS-BYPASS-VALIDATION>
  a triage:Finding ;
  triage:findingId "AG10-PUBLIC-FIELDS-BYPASS-VALIDATION" ;
  triage:title "AG.10 PeerCredentialStore/secure-transport struct has public fields allowing construction that bypasses validated constructors" ;
  triage:description "A struct related to PeerCredentialStore or secure-transport config exposes public fields directly, allowing callers to construct instances that bypass the validated new()/builder constructor and its invariant checks. Sweep for struct definitions with pub fields plus a validated constructor pattern in the secure-transport code across worktrees from AG.10 onward." ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
