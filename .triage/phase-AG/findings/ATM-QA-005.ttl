<urn:atm:triage:finding/ATM-QA-005>
  a triage:Finding ;
  triage:findingId "ATM-QA-005" ;
  triage:title "sprint doc code sample cites stale symbol name execute_outbound_send" ;
  triage:description "Quality-mgr AG21-QA-1 pass identified stale symbol citation in docs/plans/phase-AG/sprint-AG21.md line 77 deliverables section, which cites execute_outbound_send(dispatcher, request, post_send_emitter) as the retained explicit canonical outbound symbol. The actual retained implementation is execute_outbound_send_with_runtime_and_post_send_emitter(request, observability, runtime, post_send_emitter) in crates/atm-core/src/send/mod.rs:365. This is the EXACT SAME defect already comprehensively captured and dispatched in AG18-QA-006, which covers the stale symbol across AG18/AG19/AG20/AG21 sprint docs. ATM-QA-005 is a duplicate/subsumption of the canonical AG18-QA-006 finding and does not require separate dispatch or reconciliation work." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:category "documentation-code-mismatch" ;
