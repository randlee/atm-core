<urn:atm:triage:finding/RBP-F004>
  a triage:Finding ;
  triage:findingId "RBP-F004" ;
  triage:title "SendRequest carries two inconsistently-typed fields for the same host concept" ;
  triage:description "SendRequest struct carries both 'validated remote_host: Option<RemoteTargetHost>' and 'raw source_remote_host: Option<String>'. The remote_host field is validated via RemoteTargetHost::parse() with character/emptiness checks. The source_remote_host field is populated directly from peer_addr.ip().to_string() in crates/atm-daemon/src/peer_transport/server.rs:33 without validation. An effective_remote_host() reconciliation helper in crates/atm-core/src/send/context.rs:60-65 tries to bridge them, but the two fields represent the same semantic concept (the remote host that sent this request) with inconsistent type safety." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-AG" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T09:30:00Z"^^xsd:dateTime ;
  triage:supersedes "RBP-F001 (renamed 2026-07-19: original filename was reused in-place on integrate/phase-AG at commit 74bb849f, colliding with the pre-existing heartbeat-recovery finding restored under its original id; this finding was reassigned RBP-F004, the next free id in sequence)" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F004/pAG-s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F004/pAG-s19/1> ;
