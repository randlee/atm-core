<urn:atm:triage:finding/AG5-DNS-HOSTNAME-CLI-UX-TRAP>
  a triage:Finding ;
  triage:findingId "AG5-DNS-HOSTNAME-CLI-UX-TRAP" ;
  triage:title "CLI accepts DNS hostnames for allowlist entries but silently fails to match at runtime" ;
  triage:description "AG.5 QA reported that the host-allowlist CLI accepts a DNS hostname as an allowlist entry but the runtime enforcement path only compares against resolved IPs, so hostname entries silently never match — a UX trap." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "usability" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T23:59:59Z"^^xsd:dateTime ;
