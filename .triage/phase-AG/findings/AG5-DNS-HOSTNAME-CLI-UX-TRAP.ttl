<urn:atm:triage:finding/AG5-DNS-HOSTNAME-CLI-UX-TRAP>
  a triage:Finding ;
  triage:findingId "AG5-DNS-HOSTNAME-CLI-UX-TRAP" ;
  triage:title "AG.5 host-allowlist CLI accepts DNS hostnames but silently mishandles them (UX trap)" ;
  triage:description "The host-allowlist add command accepts free-form hostname strings including DNS names, but downstream matching/storage logic assumes IP-literal semantics, silently producing a confusing non-match/no-op for operators who add a DNS hostname expecting it to work." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "usability" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG5-DNS-HOSTNAME-CLI-UX-TRAP/pAG-s5/1> ;
