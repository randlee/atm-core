<urn:atm:triage:finding/AG18-RBQA-F003-GATE-LITERAL-WEAKNESS>
  a triage:Finding ;
  triage:findingId "AG18-RBQA-F003-GATE-LITERAL-WEAKNESS" ;
  triage:title "Delete-list gate is purely literal/regex, structurally incapable of catching renamed reintroduction" ;
  triage:description "ag18.toml + boundary_enforcement.rs:325-372 -- the gate matches only literal symbol names/regexes, exactly what AG18-RBQA-F002 (rename-to-evade) demonstrates it cannot catch. Important, not blocking on its own, but corroborates why F002 slipped through. Additionally ag18.toml's own forbidden_literals/forbidden_regexes never list 'DirectDeliver' itself (the sprint's namesake symbol), despite it being explicitly named in the sprint doc's Required Validation grep command -- not a live regression today but the gate wouldn't catch one." ;
  triage:category "RBQA" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:severity "important" ;
