<urn:atm:triage:finding/AG3-BYPASS-MISTRACKED>
  a triage:Finding ;
  triage:findingId "AG3-BYPASS-MISTRACKED" ;
  triage:title "AG.3's loopback trust-bypass is mis-tracked in readiness/ledger docs" ;
  triage:description "AG.3 QA-1 Important finding: the loopback client-trust bypass (see AG3-PEER-LOOPBACK-TRUST-BYPASS) is not accurately reflected in docs/plans/phase-AG/readiness.md or cross-host-findings-ledger.md — status/severity language there doesn't match the real bypass. Sweep readiness.md and cross-host-findings-ledger.md for mentions of loopback trust/bypass and compare to actual code state." ;
  triage:category "documentation" ;
  triage:phaseId "phase-AG" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:triageMode "initial_pass" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
