@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AG3-BYPASS-MISTRACKED>
  a triage:Finding ;
  triage:findingId "AG3-BYPASS-MISTRACKED" ;
  triage:title "Bypass/trust-decision path not tracked/logged for audit" ;
  triage:description "AG.3 QA reported that when a connection bypasses normal trust validation (e.g. loopback or allowlisted), the bypass decision itself is not recorded/logged anywhere auditable — meaning there's no way to later verify whether a given connection went through full validation or a bypass path. Verified: authorization denials are logged (outcome=denied) but successful authorizations are not logged. AllowAllPeerAuthorizationPolicy silently accepts all peers with no audit trail. SqliteAllowedHostAuthorizationPolicy succeeds silently with no logging. No audit trail exists to distinguish between bypass and validated connections." ;
  triage:category "observability" ;
  triage:phaseId "phase-AG" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:triageMode "followup_pass" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T20:15:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG3-BYPASS-MISTRACKED/s4/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG3-BYPASS-MISTRACKED/s5/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG3-BYPASS-MISTRACKED/s6/1> ;
