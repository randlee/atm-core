@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/ATM-QA-AG19-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG19-004" ;
  triage:title "AG.19 built on AG.18's unmerged tip despite stated hard dependency on 'AG.18 merged'" ;
  triage:description "docs/plans/phase-AG/sprint-AG19.md declares under 'Hard Dependencies' (line 30): 'AG.18 merged.' AG.18 (feature/pAG-s18-unify-envelope-handler @ 70cce097) has a FAIL verdict and remains open (AG18-QA-002: Compose/DirectDeliver split not collapsed). AG.19's branch (feature/pAG-s19-delete-remote-ack-path @ 59225e0f) builds directly on AG.18's tip commit rather than a merged integrate/phase-AG state. The dispatch_send fork (AG18-QA-003/ATM-QA-AG19-003) is the literal unresolved AG.18 defect carried forward into AG.19, confirming AG.19 proceeded despite its own stated hard dependency being unmet as literally written." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "process/sequencing-violation" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "sprint-doc dependency language for AG.18-AG.25; AG.20 depends on 'AG.19 merged' (sprint-AG20.md:30) and AG.21 depends on 'AG.20 merged' (sprint-AG21.md:34) -- same literal wording pattern, same likely mismatch against actual pipeline execution, present in every downstream sprint doc through AG.25" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-004/pAG-s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-004/pAG-s20/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-004/pAG-s21/1> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s18/70cce097> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s19/59225e0f> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s20/50572166> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s21/56fdcdef> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s21/56fdcdef> ;
  triage:notes """This is a documentation-wording finding, not a code defect: it does not block on any single sprint's code because the underlying execution model (sprints proceed back-to-back on each other's unmerged tips, with arch-ctm merge-forwarding branch-to-branch rather than waiting for merge-to-develop/integrate) is a deliberate, user-authorized ladder policy, not an accidental process violation. 'Unmerged' in each sprint doc's Hard Dependencies section should be read/rewritten as 'not yet integrated to integrate/phase-AG,' which is the actual intended semantics of the pipeline. The finding is that the sprint-doc wording ('AG.18 merged', 'AG.19 merged', 'AG.20 merged') does not reflect this intended semantics and reads as a literal, unmet gate -- which is misleading for anyone auditing sequencing later (as this triage pass demonstrates) and obscures the real defect it happened to surface here, namely that AG.19 inherited AG.18's still-open Compose/DirectDeliver split (AG18-QA-002/AG18-QA-004) unresolved. Recommended fix: clarify the 'Hard Dependencies' section language across sprint-AG18.md through sprint-AG25.md to state the actual pipeline contract (e.g. 'AG.18's commits present in this branch's ancestry; AG.18's open defects are NOT presumed resolved unless explicitly closed') rather than the ambiguous 'AG.N merged.' promoteTo is feature/pAG-s21-collapse-dispatch-routing (highest branch with real commits and dev in progress) since doc language should be corrected once, at the tip, and merge-forwarded; AG.22-AG.25 not yet started so their doc language is out of scope for this pass but should be swept once they have real commits.""" .

