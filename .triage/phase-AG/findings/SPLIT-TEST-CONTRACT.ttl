<urn:atm:triage:finding/SPLIT-TEST-CONTRACT>
  a triage:Finding ;
  triage:findingId "SPLIT-TEST-CONTRACT" ;
  triage:title "split Sent/Acknowledged test contract duplicated across three patterns: 2 helper-pair definitions + 6 direct-match sites" ;
  triage:description "Test code in crates/atm-daemon/src/tests_post_send_graft_warning.rs (lines 50, 55) defines expect_sent_response() and expect_ack_response() helpers. Identical helpers duplicated with pub(super) visibility in crates/atm-daemon/src/tests/runtime_root/mod.rs (lines 48, 53, 57/63: expect_sent_response, sent_response_ref, expect_ack_response). Additionally, peer_transport/tests/harness.rs has 6 sites (lines 110, 161, 286, 409, 529, 686 on s21; lines 111, 162, 287, 410, 530, 692 on s24+) where the ResponseEnvelope pattern is matched. On s18-s20: helpers not yet introduced. On s21-s23: helpers active + direct-match sites present. On s24-s25: helpers exist but are unused (dead code); harness.rs pattern refactored to simpler ResponseEnvelope::Send(outcome) form, no longer using SendResponseEnvelope::Sent inline matching. This indicates the duplication pattern exists across all open branches (s21-s25) though the direct usage varies. Counterpart: AG18-QA-004 identified production code split (composition.rs, atm-graft)." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:category "test-code-structure" ;
  triage:severity "blocking" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T22:45:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SPLIT-TEST-CONTRACT/pAG-s21/1> ;
