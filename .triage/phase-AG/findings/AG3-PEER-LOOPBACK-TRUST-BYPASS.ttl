<urn:atm:triage:finding/AG3-PEER-LOOPBACK-TRUST-BYPASS>
  a triage:Finding ;
  triage:findingId "AG3-PEER-LOOPBACK-TRUST-BYPASS" ;
  triage:title "AG.3 peer_loopback_delivery bypasses client-trust verification" ;
  triage:description "AG.3 QA-1 Blocking finding: the loopback same-host diagnostic delivery path (peer_loopback_delivery) bypasses client-trust/authorization verification that the normal inbound peer listener path enforces. Sweep for the loopback delivery function/module across worktrees and check whether trust verification is invoked on that path. FOLLOWUP: integrate/phase-AG has removed loopback special-case entirely, replacing with unified cross-host delivery contract that treats loopback/localhost as ordinary remote-target hosts. Feature branches (pAG-s4 through pAG-s9) still retain the loopback pattern pending merge-forward of integrate/phase-AG changes." ;
  triage:category "security" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:severity "blocking" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
