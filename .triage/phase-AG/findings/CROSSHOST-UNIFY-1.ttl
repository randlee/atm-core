<urn:atm:triage:finding/CROSSHOST-UNIFY-1>
  a triage:Finding ;
  triage:findingId "CROSSHOST-UNIFY-1" ;
  triage:title "Separate ack send path not deleted" ;
  triage:description "Item 1 of user-mandated 9-point ack/send routing unification checklist VIOLATED. ack/mod.rs:504-566 (persist_sent_ack_reply) builds its own outbound envelope via build_outbound_envelope(...) and its own DeliveryRecipientSnapshot construction, independent of send::send_mail's prepare_send_context/persist_send_message (send/context.rs, send/mod.rs:344-380). Cross-host ack replies travel as SendRequestEnvelope::DirectDeliver (non_claude_outbound_runtime.rs:74-98) while atm send cross-host travels as SendRequestEnvelope::Compose (runtime_health/dispatch_delivery.rs:87-124) -- two distinct wire shapes/handlers, not \"send + acknowledges_message_id\" as the checklist requires. Root cause shared with CROSSHOST-UNIFY-3, -4, -7 (same Compose/DirectDeliver duplication)." ;
  triage:category "architecture-duplication" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-18T16:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-1/pAG-s15-othermac-smoke/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-1/pAG-s15-othermac-smoke/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-1/integrate-phase-AG/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-1/integrate-phase-AG/2> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s15-othermac-smoke/4caa741e> ;
