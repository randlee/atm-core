<urn:atm:triage:finding/ATM-QA-AG19-101>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG19-101" ;
  triage:title "requirements.md AckOutcome JSON contract stale (nested reply_disposition.kind vs shipped flat shape)" ;
  triage:description "docs/requirements.md:1654-1666 still documents AckOutcome's JSON contract as a nested reply_disposition.kind object (\"sent\" | \"suppressed_self_ack\"). Shipped AckOutcome (crates/atm-core/src/ack/mod.rs) is flat (reply_message_id/reply_target, no disposition field, no suppressed_self_ack path possible anymore) on branches pAG-s19 through pAG-s25. Requirements baseline was not updated to match the shipped wire contract on any branch, including branches where the struct itself has reverted to the nested pre-flattening shape (pAG-s18, integrate/phase-AG)." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-AG" ;
  triage:severity "Blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
