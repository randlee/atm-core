<urn:atm:triage:finding/ARCH-AG15-003>
  a triage:Finding ;
  triage:findingId "ARCH-AG15-003" ;
  triage:title "Duplicate Bootstrap type definitions between atm-daemon-client and atm-core" ;
  triage:description "BootstrapConnectOutcome, BootstrapLaunchGateOutcome, BootstrapAutoStartOutcome, and BootstrapTraceReport are byte-for-byte duplicate definitions in crates/atm-daemon-client/src/lib.rs (lines 36-70) of types already canonically defined in crates/atm-core/src/doctor/report.rs (lines 65-99). atm-daemon-client already depends on atm-core and already imports atm_core::protocol and atm_core::caller_context, so there is no circular-dependency justification for the duplication. Recommended remediation: delete duplicate definitions and re-export canonical types from atm-core via pub use atm_core::doctor::report::{BootstrapConnectOutcome, BootstrapLaunchGateOutcome, BootstrapAutoStartOutcome, BootstrapTraceReport};" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RULE-005" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-18T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-AG15-003/s15/1> ;
