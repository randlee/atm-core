<urn:atm:triage:finding/ATM-QA-AG23-005>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG23-005" ;
  triage:title "CROSSHOST-UNIFY-4.ttl and CROSSHOST-UNIFY-7.ttl reference deleted direct_delivery.rs" ;
  triage:description "Triage record staleness detected during AG.23 QA. The triage records CROSSHOST-UNIFY-4.ttl and CROSSHOST-UNIFY-7.ttl were created when direct_delivery.rs existed and assert open status with concrete line-number references. However, direct_delivery.rs has been fully deleted between AG.15 and AG.18 (in commit 9a52c0f0 'Unify cross-host ack/send routing'). The deletion FIXED the underlying architectural issue (duplication), but the triage records have become stale and inconsistent with current code state. They reference file paths and line numbers that no longer exist. This is a triage-hygiene defect: the records must be reconciled to reflect current code state. Scope of reconciliation: check and update all CROSSHOST-UNIFY-*.ttl records (1-8) for similar staleness issues." ;
  triage:category "triage-hygiene" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
