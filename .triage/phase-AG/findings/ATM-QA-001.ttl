<urn:atm:triage:finding/ATM-QA-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-001" ;
  triage:title "AG.9 cross-host-findings-ledger.md cites wrong line range for runtime_health.rs Send dispatch arm" ;
  triage:description "AG.9 QA-1 Important finding (req-qa ATM-QA-001, verified from source): docs/plans/phase-AG/cross-host-findings-ledger.md:54 cites crates/atm-daemon/src/runtime_health.rs:589-596 as the dispatch handling for RequestEnvelope::Send(...), but that range is actually inside an unrelated poison-recovery closure (with_shutdown_finalizer_registry, action = shutdown_registry_lock). The real RequestEnvelope::Send(...) match arm is at lines 608-620 (on feature/pAG-s9-release-verdict @ 462b3ee3). Fix: correct the ledger citation to runtime_health.rs:608-620." ;
  triage:category "documentation" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:severity "important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T19:46:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-001/s9-release-verdict/1> ;
