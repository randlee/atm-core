<urn:atm:triage:finding/ATM-QA-AG10-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG10-002" ;
  triage:title "composition.rs named refactor extraction only partially performed; file grew instead of shrinking" ;
  triage:description "AG.10's addendum required extracting peer transport config loading/validation out of crates/atm-daemon/src/composition.rs. load_peer_transport_config (lines 583-605) was correctly extracted, but refresh_peer_listeners (~line 433 onward) was not, and new AG.10 feature code (peer credential/doctor/allowlist wiring) was layered onto the file concurrently with the refactor. File grew from baseline 945 lines to 1137 lines at commit 88eb5bcf on feature/pAG-s10-secured-transport (PR #560). Confirmed independently 3x by req-qa and arch-qa. Not a RULE-003 hard violation (793 non-test lines, under 1000 cap) but a confirmed acceptance-criteria failure." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "refactor" ;
  triage:severity "Blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-16T00:00:00Z"^^xsd:dateTime ;
