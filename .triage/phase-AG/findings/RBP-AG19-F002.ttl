# --- AG.18: untyped ack-vs-send boolean fork in dispatch_delivery.rs ---
<urn:atm:triage:occurrence/RBP-AG19-F002/s18/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/runtime_health/dispatch_delivery.rs" ;
  triage:line 63 ;
  triage:snippet "if request.acknowledges_message_id.is_some() && request.source_remote_host.is_none() { return Ok(ResponseEnvelope::Ack(ack_mail_with_runtime_and_post_send_emitter(...)?)); }" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAG-s18-unify-envelope-handler" ;
  triage:headSha "1b25b36c" ;
  triage:occursIn <urn:atm:triage:worktree/s18/1b25b36c> .

