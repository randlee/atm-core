# Occurrence s21/2 - dead_code annotation with boundary-violation admission
<urn:atm:triage:occurrence/AG20-BLOCK-003/s21/2>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/peer_transport/mod.rs" ;
