@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AG20-BLOCK-003>
  a triage:Finding ;
  triage:findingId "AG20-BLOCK-003" ;
  triage:title "Transport still owns replay persistence" ;
  triage:description "PeerClientTransport::replay_store (crates/atm-daemon/src/peer_transport/mod.rs:156), resume_pending_replay, persist_replay_request_to_endpoint, and persist_remote_retry all still initiate/own replay persistence from inside the transport module tree, even though AG.20's own sprint doc explicitly names replay_store for deletion/relocation out of the transport layer. Confirmed by req-qa (ATM-QA-AG20-002), arch-qa (ARCH-003/004/005), and ruthless-boundary-qa (RBQA-F002). Independently reconfirmed by direct grep of crates/atm-daemon/src/peer_transport/mod.rs and delivery.rs: replay_store field, resume_pending_replay, persist_replay_request_to_endpoint, and persist_remote_retry (delivery.rs) are present byte-for-byte unchanged across s18 (70cce097), s19 (59225e0f), s20 (50572166), and s21 (56fdcdef, dev in progress) -- AG.20 did not perform the deletion its own sprint doc mandated, and AG.21 has not touched this code path either." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "feature/pAG-s20-move-deferred-policy-out-of-transport" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s20/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s21/1> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s18/70cce097> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s19/59225e0f> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s20/50572166> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s21/56fdcdef> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s21/56fdcdef> ;
  triage:notes "highest_open_branch = feature/pAG-s21-collapse-dispatch-routing (56fdcdef): AG.21 is the only branch currently open with dev in progress (AG.22-25 not started, all parked at 03c873fc which predates AG.21). Fix targets s21 per strict-latest-open-branch dispatch policy; merge-forward will close the occurrence on s18-s20 once s21 lands. Not repeatable outside this single sweep_scope -- pattern is confined to crates/atm-daemon/src/peer_transport/{mod.rs,delivery.rs}, which is exactly the module tree AG.20/AG.21 own." .

