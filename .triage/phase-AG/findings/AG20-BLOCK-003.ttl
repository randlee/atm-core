@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AG20-BLOCK-003>
  a triage:Finding ;
  triage:findingId "AG20-BLOCK-003" ;
  triage:title "Transport still owns replay persistence" ;
  triage:description "PeerClientTransport::replay_store (crates/atm-daemon/src/peer_transport/mod.rs:152), resume_pending_replay (line 215), persist_replay_request (line 289 with #[allow(dead_code)] annotation), persist_replay_request_to_endpoint (line 318), and persist_remote_retry (delivery.rs:154) all still initiate/own replay persistence from inside the transport module tree, even though AG.20's own sprint doc explicitly names replay_store for deletion/relocation out of the transport layer. QA-2 re-triage confirms AG.21 @ bf96dc86 still carries the dead-code annotation on line 285-288: 'retained for legacy replay-persistence contract tests while the explicit-endpoint path is used in production dispatch' — direct admission that the production code path has shifted but the old API remains as dead code in production. This is a boundary violation: even dead code in the transport module tree violates the AG.20/AG.21 scope to remove replay_store ownership entirely from the transport layer." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "architecture" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "feature/pAG-s21-collapse-dispatch-routing" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s20/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s21/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-003/pAG-s21/2> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s18/70cce097> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s19/59225e0f> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s20/50572166> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s21/bf96dc86> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s21/bf96dc86> ;
  triage:notes "Followup_pass QA-2 re-triage confirms AG.21 @ bf96dc86 still open. New evidence (occurrence/AG20-BLOCK-003/pAG-s21/2) documents the #[allow(dead_code)] annotation at line 285-288 that explicitly admits persist_replay_request is retained for legacy tests but no longer used in production dispatch. Production code has shifted to persist_replay_request_to_endpoint (line 318), but the dead-code path remains in the codebase and violates the transport-layer boundary. highest_open_branch = feature/pAG-s21-collapse-dispatch-routing (bf96dc86). AG.22-25 not yet started, still at 03c873fc which predates AG.21. Promote_to = s21 per latest-open-branch policy. Fix targets s21; merge-forward closes lower branches. Not repeatable outside peer_transport/ module tree." .

