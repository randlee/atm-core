<urn:atm:triage:finding/RBQA-F008>
  a triage:Finding ;
  triage:findingId "RBQA-F008" ;
  triage:title "atm-graft test-double still classifies compose-vs-ack via acknowledges_message_id presence -- re-implements the exact leak AG.24 was scoped to eliminate" ;
  triage:description "ruthless-boundary-qa found atm-graft/src/lib.rs:597,654 -- a test-double still classifies compose-vs-ack messages by checking acknowledges_message_id.is_none()/.is_some(), which re-implements exactly the field-presence-based dispatch classification that AG.24 (preserve-request-shape / wire-family collapse) was scoped to eliminate. This is the 3rd occurrence of this leak pattern in the RBQA-F006/F007 lineage (same defect family previously found and partially fixed elsewhere)." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:category "RBQA" ;
  triage:severity "important" ;
