<urn:atm:triage:finding/AG18-RBQA-F002-RESPONSE-SPLIT>
  a triage:Finding ;
  triage:findingId "AG18-RBQA-F002-RESPONSE-SPLIT" ;
  triage:title "Response-side envelope split reintroduced under new names" ;
  triage:description "ResponseEnvelope now has Send(SendOutcome)/Ack(AckOutcome) variants, both serializing to the same wire MessageKind::SendResponse -- recreating the exact SendResponseEnvelope::{Sent,Acknowledged} split the sprint required eliminated, moved to the response side under new names, unified only at the wire-serialization layer, with 20+ call sites still branching on it." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/protocol.rs ResponseEnvelope and all call sites branching on Send/Ack variants" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-19T18:04:00Z"^^xsd:dateTime ;
