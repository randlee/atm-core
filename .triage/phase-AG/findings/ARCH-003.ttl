<urn:atm:triage:finding/ARCH-003>
  a triage:Finding ;
  triage:findingId "ARCH-003" ;
  triage:title "New send/hook.rs module is now the largest file touched by the AG.10 refactor, bundling mixed responsibilities" ;
  triage:description "The AG.10 refactor split crates/atm-core/src/send/mod.rs into sibling files, but the new send/hook.rs module (873 non-test / 1554 total lines) is now the single largest file touched by the sprint, bundling hook-spawn, stdout-capture, result-parsing, and dispatch-routing responsibilities — works against the addendum's 'no additional top-level files with mixed responsibilities' acceptance criterion." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "Important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
