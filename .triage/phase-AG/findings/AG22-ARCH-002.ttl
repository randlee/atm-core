<urn:atm:triage:finding/AG22-ARCH-002>
  a triage:Finding ;
  triage:findingId "AG22-ARCH-002" ;
  triage:title "bound_addr_hint leaks socket-specific semantics into resolver trait" ;
  triage:description "bound_addr_hint on the resolver trait leaks socket-specific semantics into what should be a transport-agnostic resolution boundary, a forward-compat concern for a future HTTP transport." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
