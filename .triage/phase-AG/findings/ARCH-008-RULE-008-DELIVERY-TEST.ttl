<urn:atm:triage:finding/ARCH-008-RULE-008-DELIVERY-TEST>
  a triage:Finding ;
  triage:findingId "ARCH-008-RULE-008-DELIVERY-TEST" ;
  triage:title "RULE-008 violation: production team/identity literals in tests" ;
  triage:description "Test code in peer_transport/delivery.rs and other test files hardcodes production literals 'arch-ctm' and 'atm-dev' instead of using TEST_TEAM and TEST_SENDER-style constants. Per RULE-008: test constants must never hold production values regardless of naming convention." ;
  triage:category "ARCH" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
