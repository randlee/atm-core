@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AG10-TLS-CERT-CHAIN-VALIDATION-DISABLED>
  a triage:Finding ;
  triage:findingId "AG10-TLS-CERT-CHAIN-VALIDATION-DISABLED" ;
  triage:title "AG.10 secured transport disables/skips TLS certificate chain validation and this is undocumented" ;
  triage:description "SecureTransportNegotiator/TLS setup code disables or skips full certificate-chain validation (via permissive verifier) for expedience, and this security-relevant deviation is not documented. The implementation uses rustls::client::danger API and custom PermissiveServerVerifier / PermissiveClientVerifier that assert certificate verification without validating the certificate chain; it relies on post-handshake SHA256 fingerprint matching instead, but this security model is not documented anywhere." ;
  triage:phaseId "phase-AG" ;
  triage:category "security" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-TLS-CERT-CHAIN-VALIDATION-DISABLED/s10/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-TLS-CERT-CHAIN-VALIDATION-DISABLED/s10/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-TLS-CERT-CHAIN-VALIDATION-DISABLED/s10/3> ;
