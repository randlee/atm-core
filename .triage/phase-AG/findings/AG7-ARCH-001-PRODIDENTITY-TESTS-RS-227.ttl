<urn:atm:triage:finding/AG7-ARCH-001-PRODIDENTITY-TESTS-RS-227>
  a triage:Finding ;
  triage:findingId "AG7-ARCH-001-PRODIDENTITY-TESTS-RS-227" ;
  triage:title "Hardcoded production identity literal \"arch-ctm@atm-dev\" in peer_transport/tests.rs test code" ;
  triage:description "arch-qa found in AG7-QA-2 recheck (feature/pAG-s7-live-revalidation @ 44fc490e, PR #558): crates/atm-daemon/src/peer_transport/tests.rs:227, the caller-identity audit field `added_by` of `AllowHostCommand::new(...)` in test `peer_listener_accepts_allowed_socket_host_and_dispatches` is hardcoded to the literal string \"arch-ctm@atm-dev\" (a real production team+identity), despite the same file already using TEST_TEAM/TEST_SENDER/TEST_RECIPIENT constants elsewhere for this purpose. This is the same finding class as the recurring \"production-identity-literal (arch-ctm@atm-dev, 5+ sprints)\" cross-cutting thread noted in the AG.3-AG.10 consolidated triage batch (RULE-008/009 zero tolerance — production team+identity literals in test code are BLOCKING regardless of when introduced). Repeatable sweep identified production literals across atm-daemon test files and storage layer, with highest concentration on pAG-s7 (11 occurrences across peer_transport/tests.rs, tests.rs, tests_cross_host_doctor.rs, and storage layer)." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-16T03:45:22.123456Z"^^xsd:dateTime ;
