@prefix qa:   <urn:atm:qa#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

qa:AG18-QA-005
    a qa:Finding ;
    qa:findingId "AG18-QA-005" ;
    qa:phase "phase-AG" ;
    qa:title "Stale wire-contract ICD" ;
    qa:severity "blocking" ;
    qa:pattern "stale-docs" ;
    qa:repeatable false ;
    qa:sourceReviewers "req-qa (ATM-QA-004)" ;
    qa:description """docs/atm-daemon/protocol-icd.md:329-411 (Section 7.1 packet-kind table and Section 7.2 envelope mapping) still documents `send_compose_request` / `send_acknowledge_request` / `send_sent_response` / `send_acknowledged_response` packet kinds mapped to `RequestEnvelope::Send(SendRequestEnvelope::Compose(...))` and `RequestEnvelope::Send(SendRequestEnvelope::Acknowledge(...))`. The `SendRequestEnvelope` type (with its `Compose`/`Acknowledge` variants) was deleted by AG.18's own commit 70cce097 ('AG.18 unify canonical send envelope'), which collapsed the request side to `RequestEnvelope::Send(Box<SendRequest>)` (crates/atm-core/src/protocol.rs:49-50) with a single `MessageKind::SendRequest = 0x0001` wire kind (protocol.rs:325) -- the compose/acknowledge distinction is no longer expressed via a request-side sub-envelope. (The response side, `SendResponseEnvelope::{Sent,Acknowledged}`, is unaffected and still documented accurately -- see separate finding AG18-QA-002 for that enum's own deletion/deprecation gap.) docs/requirements.md designates the ICD as the sole owner of this wire detail; it was never updated in the same commit and is now factually wrong. Confirmed by req-qa (ATM-QA-004)." """ ;
    qa:sweepScope "feature/pAG-s18-unify-envelope-handler docs only" .

# --- Root-cause / sweep result ---

