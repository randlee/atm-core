<urn:atm:triage:finding/AG19-ATM-QA-AG19-001>
  a triage:Finding ;
  triage:findingId "AG19-ATM-QA-AG19-001" ;
  triage:title "ack path bypasses canonical outbound function" ;
  triage:description "execute_ack_reply_plan (crates/atm-core/src/ack/mod.rs:680-719) contains a dedicated remote-ack execution branch: `if let SendRequestRoute::Remote(remote_host) = route_send_request(&reply.reply_request) { deliver_remote_send_request(...) }`. This path executes independently outside the canonical outbound send executor (execute_delivery_plan / send_mail_with_runtime_and_post_send_emitter) that ordinary sends use, bypassing unified dispatch routing logic." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
