<urn:atm:triage:finding/AG8-UNQUALIFIED-FUNCTIONAL-CLAIM>
  a triage:Finding ;
  triage:findingId "AG8-UNQUALIFIED-FUNCTIONAL-CLAIM" ;
  triage:title "AG.8 docs contain an unqualified claim that 'functional cross-host code paths exist' without noting AG-FIND-005's blocking status" ;
  triage:description "AG.8 QA-1 Important finding: AG.8's transport-security-planning docs state that functional cross-host code paths exist without qualifying that ordinary send dispatch is actually blocked per AG-FIND-005, potentially misleading a reader into thinking cross-host send works." ;
