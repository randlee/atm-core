<urn:atm:triage:finding/AG8-UNQUALIFIED-FUNCTIONAL-CLAIM>
  a triage:Finding ;
  triage:findingId "AG8-UNQUALIFIED-FUNCTIONAL-CLAIM" ;
  triage:title "AG.8 sprint doc makes an unqualified claim that transport security is 'implemented'" ;
  triage:description "AG.8 is a planning-only sprint, but sprint-AG8.md line 26 states 'functional cross-host code paths exist' without qualification. This is unqualified and potentially misleading: it does not note that AG-FIND-005 blocks actual cross-host send dispatch, and it does not qualify that security is not yet implemented in AG.8 (that work belongs to AG.10)." ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-16T06:30:00Z"^^xsd:dateTime ;
