<urn:atm:triage:finding/AG22-RBQA-F001>
  a triage:Finding ;
  triage:findingId "AG22-RBQA-F001" ;
  triage:title "Resolver/CrossHostDelivery traits still physically inside peer_transport module tree" ;
  triage:description "The new resolver/CrossHostDelivery traits+impls are defined inside crates/atm-daemon/src/peer_transport/delivery.rs, itself a pub(crate) submodule of peer_transport (mod.rs:25) -- i.e. still physically inside the transport module tree, not a boundary structurally above/outside transport as sprint-AG22.md's own deliverable requires." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:category "RBQA" ;
