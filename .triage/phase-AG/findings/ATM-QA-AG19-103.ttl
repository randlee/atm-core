<urn:atm:triage:finding/ATM-QA-AG19-103>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG19-103" ;
  triage:title "sprint doc names composition.rs as retention location for loopback/self-poison ack tests, but tests are absent with no pointer note left" ;
  triage:description """sprint-AG19.md names composition.rs (crates/atm/src/composition.rs) specifically as the retention location for loopback/self-poison ack tests ("retained, but updated"); those tests are entirely absent from composition.rs. Equivalent-substance coverage exists (relocated to crates/atm-core/tests/mailbox_locking.rs and crates/atm-daemon/src/tests/runtime_root/self_ip.rs), satisfying "tests may relocate, never be deleted," but no pointer/note was left in composition.rs and the literal in-place-update instruction wasn't followed.""" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:category "documentation-drift" ;
  triage:severity "minor" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-20T01:01:04Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-103/s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-103/s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-103/s20/1> ;
