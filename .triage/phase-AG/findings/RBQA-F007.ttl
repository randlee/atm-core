<urn:atm:triage:finding/RBQA-F007>
  a triage:Finding ;
  triage:findingId "RBQA-F007" ;
  triage:title "no lint gate exists -- 0/4 enforcement surfaces match" ;
  triage:description "No mechanical CI/lint rule pins SendResponseEnvelope::{Sent,Acknowledged} construction to a single call site or blocks a second acknowledges_message_id-branching decision point from appearing. AG21-QA-2 (PR #580, commit bf96dc86) confirms this finding is STILL OPEN on AG.21 (important, not blocking): no lint/CI gate exists for this pattern, 0 of 4 expected enforcement surfaces match. Followup sweep across AG.18-AG.25 confirms no mechanical enforcement has been added in any downstream branch." ;
  triage:category "RBQA" ;
  triage:phaseId "phase-AG" ;
  triage:severity "important" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:isFindingType "process" ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:sourceVerdictRef "ATM-message-01KXXK928XSE7K7PAK56WP1HNF" ;
  triage:sourcePRRef "https://github.com/randlee/atm-core/pull/580#issuecomment-5016482027" ;
  triage:highest_open_branch "AG.25" ;
  triage:promote_to_branch "AG.25" ;
  triage:notes "Recommends a new lint/CI gate rather than a code fix. arch-inj's lint framework (worktree feature/pQ-lint-tools) may be the right home if/when actioned, but do not assign there during triage. This is a meta-finding about missing mechanical enforcement of a pattern constraint. Finding persists across all AG.18-AG.25 branches; no fix has been implemented." ;
  triage:relatedContext "Second consecutive sprint (AG.20, AG.21) where file relocation breaks brittle rg-check targets; mechanical enforcement would have caught this during static analysis before dispatch. Followup pass on AG.22-AG.25 shows finding still open with no added enforcement surface." .

