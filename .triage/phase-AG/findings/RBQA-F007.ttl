<urn:atm:triage:finding/RBQA-F007>
  a triage:Finding ;
  triage:findingId "RBQA-F007" ;
  triage:title "no mechanical lint pins SendResponseEnvelope construction to a single call site" ;
  triage:description "No mechanical CI/lint rule pins SendResponseEnvelope::{Sent,Acknowledged} construction to a single call site or blocks a second acknowledges_message_id-branching decision point from appearing. This is the second consecutive ladder sprint where a 'relocate the file, keep the branch' pattern passed manual rg checks because the target list was tied to specific pre-move file paths." ;
  triage:category "RBQA" ;
  triage:phaseId "phase-AG" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "n/a" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:isFindingType "process" ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:sourceVerdictRef "ATM-message-01KXXK928XSE7K7PAK56WP1HNF" ;
  triage:sourcePRRef "https://github.com/randlee/atm-core/pull/580#issuecomment-5016482027" ;
  triage:notes "Recommends a new lint/CI gate rather than a code fix. arch-inj's lint framework (worktree feature/pQ-lint-tools) may be the right home if/when actioned, but do not assign there during triage. This is a meta-finding about missing mechanical enforcement of a pattern constraint." ;
  triage:relatedContext "Second consecutive sprint (AG.20, AG.21) where file relocation breaks brittle rg-check targets; mechanical enforcement would have caught this during static analysis before dispatch" .
