<urn:atm:triage:finding/AG25-STATUS-READINESS-CONTRADICTION>
  a triage:Finding ;
  triage:findingId "AG25-STATUS-READINESS-CONTRADICTION" ;
  triage:title "sprint doc claims status:complete while readiness.md and its own execution_status contradict it" ;
  triage:description "AG.25 sprint doc frontmatter declares status: complete, but its own execution_status field says not_started. Readiness.md marks AG.25 as PENDING/TBD with no candidate commit. The contradiction is semantic: status:complete is ambiguous when execution_status:not_started. Related to companion findings ATM-QA-AG25-004/005 (req-qa: frontmatter self-contradiction and stale line-citations, both important). Hard dependency on AG.18-24 merged cannot be confirmed from readiness.md as currently written." ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:phaseId "phase-AG" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
