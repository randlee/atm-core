<urn:atm:triage:finding/AG-FIND-ADR028>
  a triage:Finding ;
  triage:findingId "AG-FIND-ADR028" ;
  triage:title "ADR-028 duplicate-id collision: two Accepted ADRs both claim id ADR-028" ;
  triage:description "docs/adr/ADR-028-cross-host-interface-control-plane.md and docs/adr/ADR-028-peer-server-transport-boundary.md both claim id ADR-028, both status Accepted as of AG.4. docs/adr/INDEX.md lists only one. ADR-029 and ADR-030 both cite ADR-028 ambiguously in their Relates-to fields. Open across all current AG sprints (AG.4 through AG.11). Pending fix available in branch docs/cross-host-remote-target-contract (not yet merged); redesign removes the collision by renumbering: peer-server-transport-boundary concept splits into ADR-029-cross-host-host-authorization and ADR-030-cross-host-transport-security-phase." ;
  triage:category "ARCH" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:propagated false ;
  triage:mergeForwardNeeded false ;
  triage:regressed false ;
