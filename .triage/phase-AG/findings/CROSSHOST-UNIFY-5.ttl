<urn:atm:triage:finding/CROSSHOST-UNIFY-5>
  a triage:Finding ;
  triage:findingId "CROSSHOST-UNIFY-5" ;
  triage:title "Transport/host-matching logic duplicated above the parser boundary" ;
  triage:description "Item 5 of user-mandated 9-point ack/send routing unification checklist PARTIAL. Target-string parsing is centralized (send/mod.rs:128-184, parse_send_target_impl) and remote_host storage is centralized (schema/inbox_message.rs:76-105). BUT host-matching/interface-selection logic is duplicated in peer_transport/delivery.rs:318-394 (resolve_remote_port_for_host, remote_host_targets_loopback) -- a second, independent host-classification layer beyond the parser, violating the 'parse/normalize remote target once, no remote-host logic scattered' requirement." ;
  triage:category "architecture-duplication" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-5/pAG-s15/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-5/pAG-s15/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-5/pAG-s15/3> ;
