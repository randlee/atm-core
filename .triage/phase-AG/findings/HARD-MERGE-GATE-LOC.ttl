  triage:snippet "git diff --stat 50572166..e0b2551f -- crates/ => 109 insertions(+), 115 deletions(-) = -6 net LOC vs required >= -100 net LOC; ladder-wide (AG.18->AG.21) measurement from rust-qa-agent shows -577 net LOC, which satisfies aggregate requirement" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAG-s21-collapse-dispatch-routing" ;
  triage:headSha "e0b2551f" ;
  triage:occursIn <urn:atm:triage:worktree/pAG-s21/e0b2551f> .

