<urn:atm:triage:finding/AG-FIND-005>
  a triage:Finding ;
  triage:findingId "AG-FIND-005" ;
  triage:title "Ordinary cross-host atm send never routes through peer_transport_runtime in production" ;
  triage:description "An ordinary `atm send <agent@team>` to a remote host never invokes peer_transport_runtime. RequestEnvelope::Send dispatch only special-cases peer_loopback_host.is_some() -> dispatch_loopback_send; ordinary branch calls send_mail_with_runtime_and_post_send_emitter and never touches self.peer_transport_runtime. prepare_send_context resolves recipients as local mailbox lookups. composition.rs only assembles peer_transport_runtime for listener/replay lifecycle, never send dispatch." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:category "architecture" ;
  triage:severity "blocking" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/cross-host-communication/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s4/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s5/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s6/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s7/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s8/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s10/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s9/1> ;
  triage:openOn <urn:atm:triage:worktree/cross-host-communication/8841e870> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s4/fdfc20c5> ;
