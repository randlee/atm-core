<urn:atm:triage:finding/AG-FIND-005>
  a triage:Finding ;
  triage:findingId "AG-FIND-005" ;
  triage:title "Corrective cross-host dispatch is implemented, but the validation ladder is still incomplete" ;
  triage:description "The original defect was that ordinary host-qualified `atm send` could bypass peer transport and mutate the local mailbox path. AG.11 landed the typed remote-target contract and production cross-host dispatch boundary; AG.13 Group 1 extends that branch with immediate-wait/deferred-replay result handling. The remaining open work on this finding is validation closure, not the original missing dispatch branch: localhost proof, self-IP proof, automated integration coverage, and second-host smoke still need to complete before the finding can close phase-wide." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:category "architecture" ;
  triage:severity "blocking" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/cross-host-communication/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s4/1> ;
