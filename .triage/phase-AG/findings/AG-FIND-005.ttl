  triage:hasOccurrence <urn:atm:triage:occurrence/AG-FIND-005/pAG-s13/1> ;
  triage:openOn <urn:atm:triage:worktree/cross-host-communication/8841e870> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s4/fdfc20c5> ;
