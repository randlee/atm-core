<urn:atm:triage:finding/AG19-ATM-QA-AG19-002>
  a triage:Finding ;
  triage:findingId "AG19-ATM-QA-AG19-002" ;
  triage:title "parallel plan-build stack in ack/mod.rs" ;
  triage:description "ack/mod.rs maintains a parallel plan-build stack (finalize_sent_ack_outcome, build_reply_delivery_plan, reply_post_send_messages) that duplicates the canonical path in send/outcome.rs (build_send_delivery_plan, execute_delivery_plan). Confirmed STILL OPEN on AG.21 via PR #580 (commit bf96dc86). All branches AG.18-AG.25 retain the duplicate stack." ;
  triage:phaseId "phase-AG" ;
