  a triage:Finding ;
  triage:findingId "AG7-RETRY-RECOVERY-NO-TEST" ;
  triage:title "AG.7 test-plan lists a retry-recovery scenario with no attributable test implementing it" ;
  triage:description "AG.7 QA followup: AG.7's integration-test plan includes 'retry-visible recovery remains bounded' but no test currently proves the full scenario: a live-revalidation failure followed by transient recovery and subsequent re-check success with state update. FIXED: real end-to-end test local_peer_listener_harness_recovers_after_transient_connect_failure_and_delivers_on_retry exists at peer_transport/tests.rs:981, verified passing (31/31 tests) by rust-qa-agent on AG10-FIX-2-QA (PR #560, commit cc4ce56d)." ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
