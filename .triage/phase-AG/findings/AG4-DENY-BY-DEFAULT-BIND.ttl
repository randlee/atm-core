<urn:atm:triage:finding/AG4-DENY-BY-DEFAULT-BIND>
  a triage:Finding ;
  triage:findingId "AG4-DENY-BY-DEFAULT-BIND" ;
  triage:title "AG.4 durable interface config violates deny-by-default bind contract" ;
  triage:description "AG.4 QA-1 Blocking finding: the new durable peer-interface bind configuration does not deny-by-default — an interface can end up bound/listening without explicit operator opt-in, violating the sprint's stated security contract." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "security" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
