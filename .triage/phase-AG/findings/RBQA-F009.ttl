<urn:atm:triage:finding/RBQA-F009>
  a triage:Finding ;
  triage:findingId "RBQA-F009" ;
  triage:title "No lint gate exists for the field-presence dispatch-classification pattern (RBQA-F006/007/008 lineage)" ;
  triage:description "ruthless-boundary-qa notes there is no lint/CI gate preventing recurrence of the field-presence-based compose-vs-ack classification pattern (acknowledges_message_id.is_none()/.is_some() used as a discriminator) -- this is the 3rd occurrence (RBQA-F006, F007, F008) of the same leak, each caught only by manual review. A structural lint would prevent a 4th recurrence." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:findingType "meta_infrastructure" ;
  triage:notes "This is a meta-finding about missing lint infrastructure, not a concrete code-location pattern. No repeatable sweep applies. Status reflects that the lint gate has not yet been implemented." .

