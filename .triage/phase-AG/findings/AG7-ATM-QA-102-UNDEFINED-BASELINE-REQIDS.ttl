<urn:atm:triage:finding/AG7-ATM-QA-102-UNDEFINED-BASELINE-REQIDS>
  a triage:Finding ;
  triage:findingId "AG7-ATM-QA-102-UNDEFINED-BASELINE-REQIDS" ;
  triage:title "docs/atm-daemon/requirements.md cites REQ-CORE-TRANSPORT-002D/002E as satisfied baseline requirements that do not exist" ;
  triage:description "req-qa found in AG7-QA-2 recheck: docs/atm-daemon/requirements.md has REQ-DAEMON-TRANSPORT-002D/002E entries claiming 'Satisfies: REQ-CORE-TRANSPORT-002D'/'REQ-CORE-TRANSPORT-002E' respectively, but neither ID exists in baseline docs/requirements.md. The REQ-CORE-TRANSPORT-* series jumps 002C -> 003, skipping 002D/002E entirely. This is exactly the requirement-ID drift class that AG7-FIX-1's earlier requirement-ID sweep was supposed to catch and clearly missed." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "AG7-ATM-QA-102" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_filter" ;
