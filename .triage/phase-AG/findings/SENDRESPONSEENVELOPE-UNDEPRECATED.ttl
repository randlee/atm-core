<urn:atm:triage:finding/SENDRESPONSEENVELOPE-UNDEPRECATED>
  a triage:Finding ;
  triage:findingId "SENDRESPONSEENVELOPE-UNDEPRECATED" ;
  triage:title "SendResponseEnvelope missing #[deprecated] despite sprint doc staged-removal rule" ;
  triage:description "Sprint AG.21 doc (lines 108-112) enforces a staged-removal rule: if AG.18 did not physically remove SendResponseEnvelope and SendRequestEnvelope, then AG.21 must deprecate them with deletion no later than the sprint that physically removes the split wire families. AG.18 did not remove these types (confirmed via AG18-QA-002 record). Therefore, AG.21 must add #[deprecated] attribute to both SendResponseEnvelope and SendRequestEnvelope. As of all current worktrees (AG.18 through AG.25), SendResponseEnvelope at crates/atm-core/src/protocol.rs:42-45 carries no #[deprecated] marker and remains actively constructed/matched at 10-14 call sites per worktree across crates/atm-core, crates/atm-daemon, crates/atm-daemon-client, and crates/atm-graft." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "protocol_staged_removal" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/protocol.rs definition only (single enum); construction sites swept to confirm scope but deprecation is attribute-only edit" ;
  triage:pattern "enum SendResponseEnvelope.*without #[deprecated]" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T09:15:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG20/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG21/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG22/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG23/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG24/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SENDRESPONSEENVELOPE-UNDEPRECATED/AG25/1> ;
