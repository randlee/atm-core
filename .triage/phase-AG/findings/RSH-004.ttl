<urn:atm:triage:finding/RSH-004>
  a triage:Finding ;
  triage:findingId "RSH-004" ;
  triage:title "FOREGROUND_REMOTE_WAIT_BUDGET never enforced as a deadline" ;
  triage:description "rust-service-hardening-agent found a constant FOREGROUND_REMOTE_WAIT_BUDGET defined in peer_transport/mod.rs that is not actually being enforced as an operational deadline in the code path it is meant to bound—a runtime-hardening gap where the intended wait-budget ceiling has no enforcement mechanism." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T18:15:00Z"^^xsd:dateTime ;
