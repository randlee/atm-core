<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "outbound_delivery_policy.rs drops original error's source/backtrace on reconstruction" ;
  triage:description "AG23-QA-1 (rust-best-practices-agent, new, important): in outbound_delivery_policy.rs, an error value is reconstructed (e.g. re-wrapped into a new error type/variant) in a way that drops the original error's source()/backtrace chain, losing diagnostic provenance for failures in this path." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-AG" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
