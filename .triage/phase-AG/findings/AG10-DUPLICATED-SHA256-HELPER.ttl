@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Finding: AG10-DUPLICATED-SHA256-HELPER
# Two identical sha256_hex helper functions exist in different crates,
# representing code duplication that should be refactored to reuse a single impl.

<urn:atm:triage:finding/AG10-DUPLICATED-SHA256-HELPER>
  a triage:Finding ;
  triage:findingId "AG10-DUPLICATED-SHA256-HELPER" ;
  triage:title "AG.10 introduces a duplicated sha256_hex helper function instead of reusing an existing one" ;
  triage:description "AG.10 QA-1 Minor finding: a sha256_hex (or similarly named hashing helper) function was added in the secure-transport module, duplicating an equivalent helper that already exists elsewhere in the codebase (e.g. atm-core or atm-storage-rusqlite). Sweep for sha256_hex/hash-hex helper function definitions across the crates on each worktree from AG.10 onward." ;
  triage:category "simplification" ;
  triage:severity "minor" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "repo" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-DUPLICATED-SHA256-HELPER/atm-daemon/security-rs> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG10-DUPLICATED-SHA256-HELPER/atm-storage-rusqlite/peer-security-store-rs> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s10-secured-transport/16c5ba03> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s9-release-verdict/462b3ee3> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s10-secured-transport/16c5ba03> .

# Occurrence 1: atm-daemon duplicate sha256_hex
<urn:atm:triage:occurrence/AG10-DUPLICATED-SHA256-HELPER/atm-daemon/security-rs>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/peer_transport/security.rs" ;
  triage:line 170 ;
  triage:snippet "fn sha256_hex(bytes: &[u8]) -> String {" ;
  triage:status "open" ;
  triage:closed false ;
  triage:occursIn <urn:atm:triage:worktree/pAG-s10-secured-transport/16c5ba03> ;
  triage:occursIn <urn:atm:triage:worktree/pAG-s9-release-verdict/462b3ee3> .

