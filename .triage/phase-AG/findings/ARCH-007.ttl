<urn:atm:triage:finding/ARCH-007>
  a triage:Finding ;
  triage:findingId "ARCH-007" ;
  triage:title "daemon-layer fork fixed but function-level fork remains" ;
  triage:description "AG21-QA-2 reports partial resolution: daemon-layer dispatch routing fork (SendRequestRoute::Remote branch consolidation) is fixed on AG.21, but function-level fork remains (build_remote_deferred_outcome duplication vs. local-path equivalent outcome building). Acceptance criteria requires both daemon-layer and function-level routing consolidation into shared boundary functions. Remote-path business logic for building deferred outcomes remains separate from any local-path equivalent, blocking full consolidation of delivery-outcome handling." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "acceptance-criteria-not-met" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
