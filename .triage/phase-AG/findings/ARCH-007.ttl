<urn:atm:triage:finding/ARCH-007>
  a triage:Finding ;
  triage:findingId "ARCH-007" ;
  triage:title "routing not fully consolidated into one shared outbound delivery function" ;
  triage:description "Acceptance Criteria requires local-vs-remote routing in one shared outbound delivery function. Remote-path business logic (deliver_remote_send_request, Deferred/RejectedTerminal/OutcomeUnknown handling, build_remote_deferred_outcome) remains inline in crates/atm-daemon/src/runtime_health/dispatch_delivery.rs:69-100 rather than inside the same shared core function used for the Local path (execute_outbound_send_with_runtime_and_post_send_emitter at line 62). Correlation note: related to AG20-BLOCK-001 (shared_outcome_policy never implemented — .triage/phase-AG/findings/AG20-BLOCK-001.ttl, already dispatched in AG21-FIX-1). Both describe missing consolidation of routing and outcome-disposition logic into shared boundary functions." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-daemon/src/runtime_health/dispatch_delivery.rs and crates/atm-core/src/send/mod.rs" ;
  triage:category "acceptance-criteria-not-met" ;
  triage:severity "important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s20/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s21/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s22/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s23/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s24/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-007/pAG-s25/1> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s18/70cce097> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s19/59225e0f> ;
