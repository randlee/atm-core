<urn:atm:triage:finding/AG18-QA-003>
  a triage:Finding ;
  triage:findingId "AG18-QA-003" ;
  triage:title "Daemon dispatch still forks send-vs-ack before routing" ;
  triage:description "Daemon dispatch fork on acknowledges_message_id: AG.18 original finding (dispatch_delivery.rs:63), confirmed across AG.19-20 unchanged. AG.21 relocated fork to send/mod.rs:371-383 (dispatch_delivery.rs fork removed). AG.22-25 fork persists in send/mod.rs at varying line numbers (412-418). Pattern: boolean check on request.acknowledges_message_id.is_some() && request.source_remote_host.is_none() branches unconditionally to ack_mail_with_runtime_and_post_send_emitter vs send_mail_with_runtime_and_post_send_emitter BEFORE any canonical routing decision. This is the core architectural violation: ack-vs-send decision made by runtime boolean flag inside shared function, not at request construction/type level." ;
  triage:category "ATM-QA-003" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG18-QA-003/s18/1> ;
