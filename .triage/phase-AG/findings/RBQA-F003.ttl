<urn:atm:triage:finding/RBQA-F003>
  a triage:Finding ;
  triage:findingId "RBQA-F003" ;
  triage:title "AG.23's own sprint-doc retention condition for resume_pending_replay is unmet by the actual diff" ;
  triage:description "AG.23's sprint-doc text conditions retaining resume_pending_replay on two things being true: (1) replay ownership remains above transport, and (2) no sender receipt semantics survive. Receipt-semantics half is met; the 'above transport' half is NOT — the method still lives fully inside peer_transport/mod.rs. This is the sprint's own stated acceptance condition for keeping this code, unmet by its own diff. Overlaps conceptually with carry-forward findings RBQA-F002-of-AG22 (resume_pending_replay owning an independent endpoint-resolution path via resolve_replay_endpoint) and RSH-003 (unguarded ? on resolve_replay_endpoint) — both already tracked open from AG.22. Determine whether RBQA-F003 is the same root defect as RBQA-F002/RSH-003 (i.e. resume_pending_replay's location) or a distinct scope-claim issue (the sprint doc's own wording vs the diff)." ;
  triage:category "RBQA" ;
  triage:severity "critical" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003/AG23/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003/AG24/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003/AG25/1> ;
  triage:openOn <urn:atm:triage:worktree/AG23/82f38708> ;
  triage:openOn <urn:atm:triage:worktree/AG24/0dd783d4> ;
  triage:openOn <urn:atm:triage:worktree/AG25/03c873fc> ;
  triage:promoteTo <urn:atm:triage:worktree/AG25/03c873fc> ;
  triage:relatedFinding "AG22-RBQA-F002" ;
  triage:relatedFinding "AG22-RSH-003" .

