<urn:atm:triage:finding/AG18-RBP-F001-REMOTETARGETHOST-BYPASS>
  a triage:Finding ;
  triage:findingId "AG18-RBP-F001-REMOTETARGETHOST-BYPASS" ;
  triage:title "Raw Option<String> bypasses validated RemoteTargetHost newtype" ;
  triage:description "ReplyTarget.remote_host (ack/mod.rs) and DeliveryRecipientSnapshot.remote_host (delivery_policy.rs:54) use raw Option<String> instead of the existing validated RemoteTargetHost newtype (send/mod.rs:66); parsing deferred/duplicated in persist_sent_ack_reply (ack/mod.rs:569-573) and test helpers." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
