  triage:promoteTo <urn:atm:triage:worktree/pAG-s19/dc05145b> ;
  triage:notes "STILL OPEN per AG19-FIX-1-QA-RECHECK-1: no fault-injection test found in mailbox_locking.rs or send/tests.rs covering finalize_acknowledgement_after_confirmed_send's local-commit-failure path (send/mod.rs:60-83)." .

