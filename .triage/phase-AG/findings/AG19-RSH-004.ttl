<urn:atm:triage:finding/AG19-RSH-004>
  a triage:Finding ;
  triage:findingId "AG19-RSH-004" ;
  triage:title "No fault-injection test covers commit_ack_mutation failing after a successful send" ;
  triage:description "Test coverage gap: the code path where commit_ack_mutation fails locally AFTER a confirmed Sent outcome (RSH-001) is not covered by fault-injection tests. This would have caught the defect in the critical RSH-001/RSH-002 finding, where a post-send local-state commit failure propagates as if the whole ack failed even though the reply was already delivered." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "Minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-20T05:11:33Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG19-RSH-004/pAG-s19/2> ;
  triage:fixedOn <urn:atm:triage:worktree/pAG-s19/d50e7c92> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s19/d50e7c92> ;
  triage:notes "FIXED at d50e7c92 per AG19-FIX-3-QA-RECHECK-1 (quality-mgr): mailbox_locking.rs's confirmed_acknowledgement_surfaces_local_state_commit_failure_as_warning forces a SQLite writer-lock hold during finalize_acknowledgement_after_confirmed_send, asserting outcome stays \"sent\" with exactly one WarningEntry and pending state preserved. Confirmed passing by rust-qa-agent's live test run; confirmed by req-qa." .

