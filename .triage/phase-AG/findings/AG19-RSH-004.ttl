<urn:atm:triage:finding/AG19-RSH-004>
  a triage:Finding ;
  triage:findingId "AG19-RSH-004" ;
  triage:title "No fault-injection test covers commit_ack_mutation failing after a successful send" ;
  triage:description "Test coverage gap: the code path where commit_ack_mutation fails locally AFTER a confirmed Sent outcome (RSH-001) is not covered by fault-injection tests. This would have caught the defect in the critical RSH-001/RSH-002 finding, where a post-send local-state commit failure propagates as if the whole ack failed even though the reply was already delivered." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
