<urn:atm:triage:finding/RBQA-F004>
  a triage:Finding ;
  triage:findingId "RBQA-F004" ;
  triage:title "3 pub(crate) methods marked #[allow(dead_code)] with test-only-admitting doc comments (repeat of AG20-BLOCK-003 pattern)" ;
  triage:description "AG23-QA-1 (ruthless-boundary-qa): 3 pub(crate) items are marked with #[allow(dead_code)] using #[cfg_attr(not(test), allow(dead_code, reason=\"...\"))] gates. The reason texts explicitly admit these items are test-only, violating the principle that test-only code should either be gated with #[cfg(test)] visibility or removed entirely if genuinely unused outside tests. InboxFileFormat enum and inbox_file_format() function in mailbox/store.rs both cite \"mailbox format detection remains test-only after compat retirement\"; load_compat_mailbox_messages_strict() in mailbox/mod.rs cites \"strict mailbox compatibility reads remain test-only\". This is a repeat of the AG20-BLOCK-003 pattern already flagged in an earlier sprint." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "ruthless-boundary-qa" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T15:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F004/s18/1> ;
