<urn:atm:triage:finding/AG7-CROSS-DOC-INCONSISTENCY-FIND005>
  a triage:Finding ;
  triage:findingId "AG7-CROSS-DOC-INCONSISTENCY-FIND005" ;
  triage:title "AG.7 sprint docs are inconsistent about AG-FIND-005 blocker severity" ;
  triage:description "Cross-host send product bug AG-FIND-005 is marked differently across phase AG documentation: some docs (cross-host-findings-ledger.md, readiness.md AG.9 sections) treat it as a hard FAIL/blocking gate on release viability, while others (plan-phase-AG.md, sprint-AG9.md) use conditional language treating it as merely a noted caveat. This cross-document inconsistency creates ambiguity about whether phase AG can proceed to release." ;
  triage:category "documentation" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "repo" ;
  triage:severity "blocking" ;
