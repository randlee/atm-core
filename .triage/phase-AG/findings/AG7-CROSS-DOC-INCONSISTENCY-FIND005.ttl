<urn:atm:triage:finding/AG7-CROSS-DOC-INCONSISTENCY-FIND005>
  a triage:Finding ;
  triage:findingId "AG7-CROSS-DOC-INCONSISTENCY-FIND005" ;
  triage:title "Cross-document inconsistency in how AG-FIND-005 (ordinary-send dispatch blocker) is described" ;
  triage:description "AG-FIND-005 is described inconsistently across phase-AG documentation: cross-host-findings-ledger.md and readiness.md treat it as a blocking release gate, while plan-phase-AG.md and sprint-AG9.md use conditional language suggesting it could be a noted caveat rather than a hard blocker. This creates ambiguity about phase AG closure readiness." ;
  triage:category "documentation" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
