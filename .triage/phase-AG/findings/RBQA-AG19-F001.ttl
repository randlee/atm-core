<urn:atm:triage:finding/RBQA-AG19-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AG19-F001" ;
  triage:title "Duplicate ack-orchestration wrapper -- public function with zero production callers, production entry point hand-rolls the same sequence inline" ;
  triage:description "crates/atm-core exposes a complete, public ack-orchestration wrapper (ack_mail_with_runtime_and_post_send_emitter, crates/atm-core/src/ack/mod.rs) with zero production callers. The production entry point (DaemonRequestDispatcher::dispatch_send, crates/atm-daemon/src/runtime_health/dispatch_delivery.rs) hand-rolls the identical prepare/send/finalize sequence inline instead of calling it." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "Important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
