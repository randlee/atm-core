  triage:snippet "fn cross_host_send_and_ack_round_trip_and_failed_ack_stays_pending() { ... assert!(still_pending_message.envelope.acknowledged_at.is_some()); }" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAG-s19-delete-remote-ack-path" ;
  triage:headSha "2d1f198c" ;
