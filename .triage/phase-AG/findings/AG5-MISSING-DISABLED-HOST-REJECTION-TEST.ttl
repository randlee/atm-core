<urn:atm:triage:finding/AG5-MISSING-DISABLED-HOST-REJECTION-TEST>
  a triage:Finding ;
  triage:findingId "AG5-MISSING-DISABLED-HOST-REJECTION-TEST" ;
  triage:title "AG.5 no test proving a disabled/non-allowlisted host is actually rejected" ;
  triage:description "AG.5 QA-1 Important finding: the host allowlist is meant to reject sends/binds to hosts not on the allowlist, but no test exercises the actual rejection path end-to-end (e.g. attempting a send/bind to a disabled or non-allowlisted host and asserting failure). Sweep for allowlist enforcement tests across worktrees from AG.5 onward." ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:openOn <urn:atm:triage:worktree/pAG-s5-host-allowlist/90dac63e> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s5-host-allowlist/90dac63e> .

