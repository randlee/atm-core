<urn:atm:triage:finding/AG19-RSH-003-STUCK-PENDING-ACK>
  a triage:Finding ;
  triage:findingId "AG19-RSH-003-STUCK-PENDING-ACK" ;
  triage:title "Deferred/OutcomeUnknown ack-mutation linkage silently dropped -- background replay success can never commit ack state" ;
  triage:description "For Deferred/OutcomeUnknown branches, the resolved AckMutation is a local variable that is silently dropped when dispatch_send returns -- nothing re-invokes commit_ack_mutation when the daemon's background replay later succeeds, so a genuinely-delivered deferred reply can leave the source message stuck in PendingAck forever. Same root cause as the central finding (ack-state commit not correctly wired to actual confirmed-delivery status across all outcome branches), opposite failure direction." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-daemon/src/peer_transport/replay_persistence.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG19-RSH-003-STUCK-PENDING-ACK/pAG-s19/2> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s19-delete-remote-ack-path/dc05145b> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s19-delete-remote-ack-path/dc05145b> ;
  triage:notes "RELOCATED, still open. The original code shape (dropped AckMutation local variable) is gone -- replaced by a genuinely more robust durable replay/receipt mechanism (RemoteReplayStore + receipt finalization). But finalize_replay_receipt / complete_replay_record (replay_persistence.rs) only finalizes the sender-visible informational receipt message via finalize_remote_delivery_receipt_with_runtime and never calls finalize_acknowledgement_after_confirmed_send when the replayed request carries acknowledges_message_id -- so a deferred ack that later succeeds via background replay still leaves the source message stuck in PendingAck forever. Confirmed independently by req-qa, arch-qa (by implication), rust-service-hardening-agent, AND team-lead's own direct code trace at dc05145b." .

<urn:atm:triage:occurrence/AG19-RSH-003-STUCK-PENDING-ACK/pAG-s19/2>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/peer_transport/replay_persistence.rs" ;
  triage:line 155 ;
  triage:lineEnd 178 ;
  triage:snippet "finalize_replay_receipt(...) / complete_replay_record(...) calls finalize_remote_delivery_receipt_with_runtime(...) with RemoteDeliveryReceiptStatus::Delivered but never re-invokes finalize_acknowledgement_after_confirmed_send for record.request.acknowledges_message_id" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAG-s19-delete-remote-ack-path" ;
  triage:headSha "dc05145b" ;
  triage:occursIn <urn:atm:triage:worktree/pAG-s19-delete-remote-ack-path/dc05145b> .

