<urn:atm:triage:finding/AG19-RSH-003-STUCK-PENDING-ACK>
  a triage:Finding ;
  triage:findingId "AG19-RSH-003-STUCK-PENDING-ACK" ;
  triage:title "Deferred/OutcomeUnknown ack-mutation linkage silently dropped -- background replay success can never commit ack state" ;
  triage:description "For Deferred/OutcomeUnknown branches, the resolved AckMutation is a local variable that is silently dropped when dispatch_send returns -- nothing re-invokes commit_ack_mutation when the daemon's background replay later succeeds, so a genuinely-delivered deferred reply can leave the source message stuck in PendingAck forever. Same root cause as the central finding (ack-state commit not correctly wired to actual confirmed-delivery status across all outcome branches), opposite failure direction." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-daemon/src/peer_transport/replay_persistence.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-20T05:11:33Z" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG19-RSH-003-STUCK-PENDING-ACK/pAG-s19/2> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s19-delete-remote-ack-path/ef699b64> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s19-delete-remote-ack-path/ef699b64> ;
  triage:notes "NARROWED to test-gap-only per AG19-FIX-1-QA-RECHECK-2 at ef699b64: the code fix has landed -- complete_replay_record now calls finalize_acknowledgement_after_confirmed_delivery when the replayed record carries acknowledges_message_id, closing the original stuck-PendingAck defect. STILL OPEN only because no regression test proves replay eventually clears pending_ack_at for a deferred/replayed ack. Confirmed independently by req-qa, arch-qa, rust-service-hardening-agent." .

<urn:atm:triage:occurrence/AG19-RSH-003-STUCK-PENDING-ACK/pAG-s19/2>
