<urn:atm:triage:finding/ATM-QA-AG10-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG10-004" ;
  triage:title "send/mod.rs not reduced to public entrypoints only, orchestration helpers remain inline" ;
  triage:description "The AG.10 addendum's recommended split shape for crates/atm-core/src/send/mod.rs was 'public entrypoints only', with orchestration logic moved to sibling modules. prepare_send_context, persist_send_message, build_send_outcome, finalize_send_outcome, and build_send_delivery_plan all remain in mod.rs at commit 88eb5bcf, PR #560, and persist across all subsequent AG sprint branches. File remains ~820-920 lines." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
