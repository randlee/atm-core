@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical triage record for AG19-RSH-001-002: Post-send ack-state commit failure masks
# successful delivery and no idempotency guard exists for retries.
#
# Root cause: dispatch_delivery.rs lines 109-113 calls commit_ack_mutation() after confirming
# SendCommandOutcome::Sent, but if commit_ack_mutation fails, the error propagates as if the
# entire ack failed, even though the reply was already delivered. No idempotency guard means
# a retry will re-resolve and re-dispatch the same SendRequest, creating a duplicate reply.

<urn:atm:triage:finding/AG19-RSH-001-002-ACK-COMMIT-MASKING>
  a triage:Finding ;
  triage:findingId "AG19-RSH-001-002-ACK-COMMIT-MASKING" ;
  triage:title "Post-send local ack-state commit failure masks a successfully-delivered reply, and no idempotency guard exists for retries" ;
  triage:description "rust-service-hardening-agent findings RSH-001 (Critical) and RSH-002 (Critical) from AG19-REAL-QA-2 verdict on PR #578 @ 2d1f198c, corroborating the central ARCH-AG15-004 finding from a runtime-hardening angle. RSH-001: if commit_ack_mutation fails locally AFTER a confirmed Sent outcome, the error propagates to the caller as if the whole ack failed, even though the reply was already delivered. RSH-002: no idempotency guard exists; a caller retrying after RSH-001's false failure will re-resolve and re-dispatch a brand-new SendRequest with the same reply body, producing a duplicate reply with no dedup check." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "Critical" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-20T05:11:33Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG19-RSH-001-002/s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG19-RSH-001-002/s19/2> ;
  triage:fixedOn <urn:atm:triage:worktree/pAG-s19/d50e7c92> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s19/d50e7c92> ;
  triage:notes "RSH-001 FIXED (unregressed since ef699b64). RSH-002 FIXED at d50e7c92 per AG19-FIX-3-QA-RECHECK-1 (quality-mgr): send/persistence.rs's existing_acknowledgement_reply lookup prevents a duplicate reply on retry, independent of prior local-commit outcome. Real regression test cross_host.rs::retrying_a_delivered_acknowledgement_cannot_create_a_second_reply, confirmed passing live by rust-qa-agent. Confirmed by req-qa, rust-qa-agent, arch-qa." .

# Occurrence 1: RSH-001 - commit_ack_mutation failure masks successful delivery -- FIXED at dc05145b
<urn:atm:triage:occurrence/AG19-RSH-001-002/s19/1>
  a triage:Occurrence ;
  triage:findingId "AG19-RSH-001-002-ACK-COMMIT-MASKING" ;
