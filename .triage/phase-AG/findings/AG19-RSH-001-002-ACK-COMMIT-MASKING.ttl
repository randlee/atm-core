# Occurrence 2: RSH-002 - no idempotency guard for retries -- STILL OPEN at ef699b64
<urn:atm:triage:occurrence/AG19-RSH-001-002/s19/2>
  a triage:Occurrence ;
  triage:findingId "AG19-RSH-001-002-ACK-COMMIT-MASKING" ;
  triage:subFindingId "RSH-002" ;
  triage:title "no idempotency guard for ack retries" ;
  triage:file "crates/atm-daemon/src/runtime_health/dispatch_delivery.rs" ;
  triage:line 65 ;
  triage:snippet "dispatch_send has no idempotency key check before re-dispatching a retried ack SendRequest" ;
  triage:description "STILL OPEN. A caller retrying atm ack after RSH-001's warning (per the warning's own advice text) will re-resolve and re-dispatch a brand-new SendRequest with the same reply body, creating a duplicate visible reply. The only added guard checks PendingAck state, which does not stop a second send from occurring." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAG-s19-delete-remote-ack-path" ;
  triage:headSha "d50e7c92" ;
  triage:occursIn <urn:atm:triage:worktree/pAG-s19/d50e7c92> .

