  triage:title "commit_ack_mutation failure masks confirmed delivery" ;
  triage:file "crates/atm-core/src/send/mod.rs" ;
  triage:line 60 ;
  triage:snippet "finalize_acknowledgement_after_confirmed_send now pushes WarningEntry on persist failure instead of propagating an error" ;
  triage:description "FIXED: finalize_acknowledgement_after_confirmed_send (send/mod.rs:60-83) now appends a WarningEntry to outcome.warnings on local-commit failure rather than masking a confirmed-Sent delivery as a hard error. outcome.outcome remains Sent." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAG-s19-delete-remote-ack-path" ;
  triage:headSha "ef699b64" ;
