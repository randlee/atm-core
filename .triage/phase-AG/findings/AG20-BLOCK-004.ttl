<urn:atm:triage:finding/AG20-BLOCK-004>
  a triage:Finding ;
  triage:findingId "AG20-BLOCK-004" ;
  triage:title "Transport tests still assert policy/replay outcomes directly" ;
  triage:description "crates/atm-daemon/src/peer_transport/tests/transport_client.rs still asserts resume_pending_replay, persist_replay_request, and AtmErrorCode::RemoteDeliveryOutcomeUnknown outcomes at the transport-test layer -- no test-surface rewrite occurred, violating sprint AG.20's own acceptance criterion (move deferred policy out of transport). Confirmed by req-qa (ATM-QA-AG20-004). On feature/pAG-s20-move-deferred-policy-out-of-transport @ 50572166, the file contains 18 direct references across these three identifiers (resume_pending_replay at lines 534, 675, 682; persist_replay_request at lines 179, 189, 207, 223, 512, 651, 717, 725; RemoteDeliveryOutcomeUnknown at lines 125, 446, 573, 610). This is downstream of and blocked on AG20-BLOCK-001/002/003 landing the real policy/persistence relocation first -- the test-surface rewrite cannot be done correctly until the production code it asserts against has actually moved. Same branch, same fix unit as AG20-BLOCK-001/002/003." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "feature/pAG-s20-move-deferred-policy-out-of-transport tests only" ;
