<urn:atm:triage:finding/AG20-BLOCK-004>
  a triage:Finding ;
  triage:findingId "AG20-BLOCK-004" ;
  triage:title "transport-owned replay -- companion finding to BLOCK-003" ;
  triage:description "replay ownership not actually moved out of peer_transport/mod.rs despite persistence extraction to remote_replay.rs. AG21-QA-2 (PR #580, commit bf96dc86) confirms STILL OPEN on AG.21. Root cause: replay_resume_worker module remains locally defined in peer_transport/mod.rs, orchestrating replay resumption as a transport concern. AG.21 partially addresses this by extracting replay persistence functions (persist_replay_request, expire_replay_record, complete_replay_record, replay_error_is_terminal) to crate::remote_replay at crate root, but the worker that uses those functions still owns replay orchestration via its local module definition." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:category "architecture-boundary" ;
  triage:severity "blocking" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-004/s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-004/s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-004/s20/1> ;
