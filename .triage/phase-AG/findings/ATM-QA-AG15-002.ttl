<urn:atm:triage:finding/ATM-QA-AG15-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG15-002" ;
  triage:title "DeliveryExecutionDisposition: redundant enum with mislabeling defect" ;
  triage:description "DeliveryExecutionDisposition is a single-variant enum (Delivered only) whose only consumer discards it (emit_delivery_plan_transitions parameter unused). Worse: execute_remote_ack_reply_plan hardcodes DeliveryExecutionDisposition::Delivered for all three RemoteSendDeliveryOutcome arms including Deferred and OutcomeUnknown, mislabeling cases where delivery did not actually complete." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:category "ATM-QA-AG15" ;
  triage:severity "important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-18T00:00:00Z"^^xsd:dateTime ;
