<urn:atm:triage:finding/ATM-QA-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-003" ;
  triage:title "AG.9 cross-host-findings-ledger.md disclaimer wrongly states peer_loopback_host does not exist" ;
  triage:description "AG.9 QA-1 Important finding: docs/plans/phase-AG/cross-host-findings-ledger.md contains a disclaimer stating that QA reports referencing a peer_loopback_host field 'were not source-accurate and were not used here.' This disclaimer is factually wrong: peer_loopback_host IS a real field at crates/atm-core/src/send/mod.rs:111 (pub peer_loopback_host: Option<PeerLoopbackHost>), defaulted None for ordinary sends, populated via loopback@<host> CLI syntax, and the daemon dispatcher hard-branches on it. Prior AG.7/AG.8/AG.10 QA-1 reports describing this mechanism were correct. Fix: correct the ledger note to state that peer_loopback_host is real, scoped to the AG.3 loopback self-test surface only, was never claimed by prior QA to cover genuine remote routing, and that the substantive AG-FIND-005 conclusion (ordinary send never reaches peer_transport_runtime) remains independently correct." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T19:46:48Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-003/pAG-s9/1> ;
  triage:openOn <urn:atm:triage:worktree/pAG-s9/462b3ee3> ;
  triage:promoteTo <urn:atm:triage:worktree/pAG-s9/462b3ee3> .

