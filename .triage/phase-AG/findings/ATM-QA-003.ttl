<urn:atm:triage:finding/ATM-QA-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-003" ;
  triage:title "AG.9 cross-host-findings-ledger.md disclaimer wrongly states peer_loopback_host does not exist" ;
  triage:description "AG.9 QA-1 Important finding: docs/plans/phase-AG/cross-host-findings-ledger.md originally contained an incorrect disclaimer stating that QA reports referencing a peer_loopback_host field 'were not source-accurate and were not used here.' This disclaimer was factually wrong: peer_loopback_host IS a real field at crates/atm-core/src/send/mod.rs:111 (pub peer_loopback_host: Option<PeerLoopbackHost>), defaulted None for ordinary sends, populated via loopback@<host> CLI syntax. FIXED in integrate/phase-AG: The incorrect disclaimer has been removed and AG-FIND-005 now records the correct high-level send-path problem statement without factually wrong disclaimers." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T19:50:00Z"^^xsd:dateTime ;
  triage:fixedOn <urn:atm:triage:worktree/integrate-phase-AG/6e5b1494> ;
  triage:propagated true ;
  triage:mergeForwardNeeded false ;
  triage:regressed false ;
  triage:highestFixedBranch "integrate/phase-AG" ;
  triage:highestFixedBranchIndex 7 .

