<urn:atm:triage:finding/AG18-QA-004>
  a triage:Finding ;
  triage:findingId "AG18-QA-004" ;
  triage:title "caller-side match duplication (composition.rs + atm-graft)" ;
  triage:description "crates/atm/src/composition.rs (send()/ack()) and crates/atm-graft/src/lib.rs (send_message()/acknowledge_message()) each independently match on SendResponseEnvelope::{Sent,Acknowledged} with separate error paths. The original split was relocated from the request side to the response side by AG.18's unify-envelope-handler work, but the duplication itself was not fully removed -- it now exists identically in two crates instead of one. AG.21's collapse-dispatch-routing sprint introduced helper functions (into_send_outcome, into_ack_outcome) in atm-core::protocol to factor out the match logic, but s18-s20 still contain the original inline duplication patterns. Confirmed open by arch-qa (ARCH-002/ARCH-003) and still present on AG.21-QA-2 verdict (PR #580, bf96dc86)." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:category "architecture" ;
  triage:severity "important" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T13:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG18-QA-004/pAG-s18/1> ;
