<urn:atm:triage:finding/CROSSHOST-UNIFY-2>
  a triage:Finding ;
  triage:findingId "CROSSHOST-UNIFY-2" ;
  triage:title "Deferred/replay not on unified outbound path" ;
  triage:description "Item 2 of user-mandated 9-point ack/send routing unification checklist VIOLATED. peer_transport/delivery.rs:216-289 (deliver_remote, used by Compose/send) has full deferred/replay handling (RemoteDeliveryDecision::DeferredRetry, persist_remote_request_for_retry, OutcomeUnknown). deliver_direct (lines 291-315, used exclusively by ack replies) has NO deferred/replay branch -- single send_to_endpoint_immediate_wait(...).map_err(...)? call with no retry persistence. Checklist requires deferred/replay logic to be unchanged in behavior but operating on the SAME unified outbound path as send; currently ack replies bypass it entirely." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture-duplication" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-18T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "integrate/phase-AG" ;
  triage:promoteTo "integrate/phase-AG" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-2/s15/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CROSSHOST-UNIFY-2/int-AG/1> ;
  triage:openOn <urn:atm:triage:worktree/s15/4caa741e> ;
  triage:openOn <urn:atm:triage:worktree/int-AG/e89ad8df> .

