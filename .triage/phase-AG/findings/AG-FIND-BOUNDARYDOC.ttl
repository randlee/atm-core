<urn:atm:triage:finding/AG-FIND-BOUNDARYDOC>
  a triage:Finding ;
  triage:findingId "AG-FIND-BOUNDARYDOC" ;
  triage:title "New sealed-trait storage contracts missing from docs/atm-storage/boundaries.md" ;
  triage:description "Three new sealed-trait contracts introduced across the AG batch have no corresponding section in docs/atm-storage/boundaries.md, breaking this repo's otherwise strictly-enforced documentation-completeness convention: AllowedHostStore (introduced AG.5, gap flagged AG.5 QA-1 Important#2), PeerInterfaceConfigStore (introduced AG.4, same gap flagged AG.4 QA-1), PeerSecurityStore (introduced AG.10, gap flagged AG.10 QA-1 ARCH-004). Plan redesign (commit 4846ab3b) removes loopback framing but these stores remain structural and finding remains fully relevant." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
