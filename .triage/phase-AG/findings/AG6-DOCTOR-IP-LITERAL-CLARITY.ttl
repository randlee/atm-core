<urn:atm:triage:finding/AG6-DOCTOR-IP-LITERAL-CLARITY>
  a triage:Finding ;
  triage:findingId "AG6-DOCTOR-IP-LITERAL-CLARITY" ;
  triage:title "AG.6 doctor output shows raw IP literals without clarifying whether they are bind or advertise addresses" ;
  triage:description "AG.6 QA-1 Minor finding: doctor's cross-host visibility output prints IP address literals for peer interfaces without labeling whether each is a bind address or an advertise address, causing operator confusion. Sweep for the doctor projection output formatting code across worktrees from AG.6 onward." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "usability" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
