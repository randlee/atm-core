<urn:atm:triage:finding/ATM-QA-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-002" ;
  triage:title "AG.9 cross-host-findings-ledger.md cites wrong line range for send/mod.rs recipient/inbox resolution" ;
  triage:description "AG.9 QA-1 Important finding (req-qa ATM-QA-002, verified from source): docs/plans/phase-AG/cross-host-findings-ledger.md:54 cites crates/atm-core/src/send/mod.rs:463-468, which is actually inside post_send_messages_from_persistence's error-mapping closure, unrelated to recipient resolution. The actual resolve_recipient(...)/runtime.inbox_path(...) logic is in prepare_send_context at lines 506-513. Fix: correct the ledger citation to send/mod.rs:506-513." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
