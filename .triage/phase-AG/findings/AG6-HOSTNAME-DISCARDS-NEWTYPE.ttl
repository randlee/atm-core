<urn:atm:triage:finding/AG6-HOSTNAME-DISCARDS-NEWTYPE>
  a triage:Finding ;
  triage:findingId "AG6-HOSTNAME-DISCARDS-NEWTYPE" ;
  triage:title "Hostname value converted to plain String, discarding a newtype wrapper" ;
  triage:description "A typed hostname/newtype value is converted to plain String, losing type-safety/validation. Occurs in doctor report projection row structs: CrossHostAllowedHostDoctorRow and CrossHostTrustedPeerDoctorRow use plain String host_name fields instead of AllowedHostName newtype from AG.5, discarding validation guarantees." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T22:15:00Z"^^xsd:dateTime ;
