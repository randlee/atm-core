<urn:atm:triage:finding/AG6-HOSTNAME-DISCARDS-NEWTYPE>
  a triage:Finding ;
  triage:findingId "AG6-HOSTNAME-DISCARDS-NEWTYPE" ;
  triage:title "AG.6 host_name field discards the AllowedHostName newtype, using raw String instead" ;
  triage:description "AG.6 QA-1 Important finding: a host_name field added in AG.6 (likely in doctor projection or peer interface visibility struct) is typed as plain String instead of reusing the AllowedHostName newtype from AG.5, losing its validation guarantees. Sweep for host_name field declarations vs AllowedHostName usage across worktrees from AG.6 onward." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable true ;
