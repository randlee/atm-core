<urn:atm:triage:finding/AG5-MISSING-LOOPBACK-BYPASS-CLAIM-TEST>
  a triage:Finding ;
  triage:findingId "AG5-MISSING-LOOPBACK-BYPASS-CLAIM-TEST" ;
  triage:title "AG.5 no test proving the loopback-bypass claim (that loopback sends skip the allowlist) is actually consumed/enforced" ;
  triage:description "AG.5 QA-1 Important finding: AG.5's docs/design claim that loopback same-host diagnostic sends intentionally bypass the host allowlist, but no test actually exercises this bypass behavior to confirm the allowlist check is skipped (or correctly applied) for loopback delivery. Sweep for tests covering loopback + allowlist interaction across worktrees." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:openOn <urn:atm:triage:worktree/AG-S9-RV/462b3ee3> ;
