<urn:atm:triage:finding/AG5-MISSING-LOOPBACK-BYPASS-CLAIM-TEST>
  a triage:Finding ;
  triage:findingId "AG5-MISSING-LOOPBACK-BYPASS-CLAIM-TEST" ;
  triage:title "No test validating the claimed loopback-bypasses-allowlist behavior" ;
  triage:description "AG.5 docs/sprint report claims loopback connections bypass the allowlist check entirely, but QA found no test proving this claimed behavior is actually true in code. This may be closely related to AG3-PEER-LOOPBACK-TRUST-BYPASS (being triaged separately) and to arch-ctm's in-flight loopback-removal redesign (docs/cross-host-remote-target-contract, commit 4846ab3b, docs-only so far) — note the relationship, but do not mark not_relevant since the redesign hasn't touched code yet." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "test-coverage" ;
