<urn:atm:triage:finding/ATM-QA-AG19-101-STALE-ACKOUTCOME-DOC>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG19-101-STALE-ACKOUTCOME-DOC" ;
  triage:title "requirements.md still documents nested reply_disposition.kind JSON contract" ;
  triage:description "docs/requirements.md:1654-1662 still documents AckOutcome's JSON contract as a nested reply_disposition.kind object (\"sent\" | \"suppressed_self_ack\"). Shipped AckOutcome (ack/mod.rs:31-43) is flat (reply_message_id/reply_target, no disposition field, no suppressed_self_ack path possible anymore). CLI output test (atm/src/output.rs:962-979) asserts the flat shape. Requirements baseline was not updated to match the shipped wire contract." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "docs/requirements.md AckOutcome section" ;
  triage:status "open" ;
  triage:dispatchReady true ;
