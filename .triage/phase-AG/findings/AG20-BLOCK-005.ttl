<urn:atm:triage:finding/AG20-BLOCK-005>
  a triage:Finding ;
  triage:findingId "AG20-BLOCK-005" ;
  triage:title "missing deprecation on DeliveryPersistenceDisposition/DeliveryPlanKind etc." ;
  triage:description """Five named types in the delivery-policy layer remain untouched with zero #[deprecated] markers across the entire phase-AG sprint chain through AG.25. Named symbols: DeliveryPersistenceDisposition (send/delivery_persistence.rs line 6), DeliveryPlanKind (delivery_plan.rs line 11), LogicalMessage (delivery_plan.rs line 17), DeliveryTarget (delivery_plan.rs line 87), DeliveryPlan (delivery_plan.rs line 102). Sprint AG.20's own plan doc (lines 125-160) lists these as 'Supporting types and staged removal' and provides a fallback staged-deprecation clause (lines 156-160): 'if removal must be staged, deprecate in AG.20 and delete no later than the sprint that lands the shared outbound policy layer.' This requirement was not fulfilled. Followup pass at AG.21 (PR #580, bf96dc86) confirmed the finding remains OPEN. Current sweep through AG.25 (c245c2ea) confirms the deprecation markers are still absent on all five symbols in all eight sprint branches.""" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG20-BLOCK-005/AG18/DeliveryPersistenceDisposition> ;
