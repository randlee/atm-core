  a triage:Finding ;
  triage:findingId "AG22-RSH-003" ;
  triage:title "resume_pending_replay aborts entire replay sweep on first unresolvable host" ;
  triage:description "resume_pending_replay aborts the entire replay sweep on the first unresolvable host via unguarded `?`, unlike the adjacent per-record-handled send_to_endpoint error path three lines below. One bad host starves every other pending replay record." ;
