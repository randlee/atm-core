<urn:atm:triage:finding/AG-FIND-PRODLIT>
  a triage:Finding ;
  triage:findingId "AG-FIND-PRODLIT" ;
  triage:title "Hardcoded production identity/team literal arch-ctm@atm-dev in test fixtures" ;
  triage:description "Production identity string (arch-ctm@atm-dev) hardcoded directly in test code instead of named test-only constants. Per RULE-008, test constants holding production values are BLOCKING regardless of variable naming. Followup pass notes: integrate/phase-AG is clean (fix merged), but feature branches s4-s7, s10, s9 remain open. Merge-forward required to propagate fix to feature branches. Finding unrelated to docs/cross-host-remote-target-contract redesign (commit 4846ab3b)." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:category "ARCH" ;
