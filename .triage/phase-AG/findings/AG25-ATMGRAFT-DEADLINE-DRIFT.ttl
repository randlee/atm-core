<urn:atm:triage:finding/AG25-ATMGRAFT-DEADLINE-DRIFT>
  a triage:Finding ;
  triage:findingId "AG25-ATMGRAFT-DEADLINE-DRIFT" ;
  triage:title "atm-graft SAME_HOST_REQUEST_DEADLINE left at stale 3s after AG.25's 3s->12s retune elsewhere" ;
  triage:description "AG.25's own deadline retune (3s->12s) touched crates/atm/src/composition.rs:42 (SAME_HOST_REQUEST_DEADLINE) but left the identically-named, identically-purposed duplicate constant in crates/atm-graft/src/lib.rs:39 at the stale 3s value. This is a LIVE PRODUCTION BUG: atm-graft's embedded client will spuriously time out at 3s on daemon work the daemon itself treats as legitimately in-budget for up to 12s. Correlate with RBQA-F011 (missing lint gate for this exact drift class) and AG25-LOC-GATE.ttl." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "none" ;
  triage:category "production-bug" ;
  triage:severity "blocking" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AG25-ATMGRAFT-DEADLINE-DRIFT/AG25/1> ;
  triage:openOn <urn:atm:triage:worktree/AG25/c245c2ea> ;
  triage:promoteTo <urn:atm:triage:worktree/AG25/c245c2ea> ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime .

<urn:atm:triage:occurrence/AG25-ATMGRAFT-DEADLINE-DRIFT/AG25/1>
  a triage:Occurrence ;
  triage:file "crates/atm-graft/src/lib.rs" ;
  triage:line 39 ;
  triage:snippet "const SAME_HOST_REQUEST_DEADLINE: Duration = Duration::from_secs(3);" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAG-s25-live-two-daemon-proof" ;
  triage:headSha "c245c2ea" ;
  triage:occursIn <urn:atm:triage:worktree/AG25/c245c2ea> .

