  a triage:Finding ;
  triage:findingId "CROSSHOST-UNIFY-7" ;
  triage:title "Duplicate message-semantic abstractions above transport layer not folded" ;
  triage:description "Item 7 of user-mandated 9-point ack/send routing unification checklist VIOLATED. Duplicate message-semantic paths: 'compose send' (send_mail_with_runtime_and_post_send_emitter) vs 'direct deliver' (deliver_direct_messages_with_runtime_and_post_send_emitter), each with own RequestEnvelope/ResponseEnvelope variants (SendRequestEnvelope::{Compose,DirectDeliver})." ;
