<urn:atm:triage:finding/ATM-QA-AG19-102>
  a triage:Finding ;
  triage:findingId "ATM-QA-AG19-102-STALE-SELFACK-ARCH-DOC" ;
  triage:title "architecture.md still documents SuppressedSelfAck termination behavior, now hard-rejected" ;
  triage:description "docs/architecture.md:1114-1136 (section 6.3) still documents local self-addressed pending-ack messages terminating at (Read, Acknowledged) via AckReplyDisposition::SuppressedSelfAck. Implementation now hard-rejects local self-ack in validate_reply_target (ack/mod.rs lines 431-464) and returns an error instead -- a state-machine behavior change not reflected in the architecture doc. Needs a decision on whether this is intentional scope tightening beyond sprint-doc authorization or an undocumented behavior change, then doc or code brought into alignment." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture-documentation" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "docs/architecture.md section 6.3, crates/atm-core/src/ack/mod.rs validate_reply_target" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-19T18:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-102/s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-102/s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-AG19-102/integrate-ag/1> ;
  triage:openOn <urn:atm:triage:worktree/s18/1b25b36c> ;
  triage:openOn <urn:atm:triage:worktree/s19/4500cf31> ;
  triage:openOn <urn:atm:triage:worktree/integrate-ag/345da805> ;
  triage:promoteTo <urn:atm:triage:worktree/integrate-ag/345da805> ;
  triage:openQuestion "Intentional scope tightening (hard-rejection of local self-ack) beyond sprint-doc authorization in AG.19, or undocumented behavior change from Phase R? This decision gates whether architecture.md section 6.3 should be rewritten to document the rejection flow, or whether the hard-rejection should be reverted to allow SuppressedSelfAck again." .

