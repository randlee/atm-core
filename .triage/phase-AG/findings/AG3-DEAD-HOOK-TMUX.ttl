<urn:atm:triage:finding/AG3-DEAD-HOOK-TMUX>
  a triage:Finding ;
  triage:findingId "AG3-DEAD-HOOK-TMUX" ;
  triage:title "Dead/unreferenced tmux post-send-hook code path introduced in AG.3" ;
  triage:description "AG.3 QA reported a tmux-related hook or helper introduced as part of AG.3's peer-transport work that is never actually invoked/referenced anywhere in the current dispatch path — effectively dead code. Followup verification: the hook_tmux.rs module is intentionally marked dead-code-expectation pending cleanup during an AD-series merge-forward. The tmux post-send-hook IS properly wired: hook.rs builds PostSendBuiltInTarget::LocalTmux dispatches, and daemon/post_send_emitter.rs's deliver_tmux_nudge() invokes them. Finding is RESOLVED: dead-code is expected and documented." ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:category "correctness" ;
  triage:severity "minor" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-15T00:00:00Z"^^xsd:dateTime ;
  triage:propagated true ;
