  a triage:Finding ;
  triage:findingId "AG18-QA-RESPSPLIT-006" ;
  triage:title "Response-side envelope split reintroduced under new names" ;
  triage:description "protocol.rs:55 ResponseEnvelope now has Send(SendOutcome)/Ack(AckOutcome) variants, both serializing to the same wire MessageKind::SendResponse (protocol.rs:752-764) -- recreating the exact SendResponseEnvelope::{Sent,Acknowledged} split the sprint required eliminated, moved to the response side under new names, unified only at the wire-serialization layer, with 40+ call sites still branching on it." ;
