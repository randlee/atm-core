<urn:atm:triage:finding/AG4-LASTBOUND-NULL-OVERWRITE>
  a triage:Finding ;
  triage:findingId "AG4-LASTBOUND-NULL-OVERWRITE" ;
  triage:title "AG.4 last_bound_at column can be overwritten to NULL" ;
  triage:description "AG.4 QA-1 Important finding: the interface config store's last_bound_at timestamp column can be overwritten back to NULL by a subsequent update, losing historical bind evidence. Sweep the interface config store's update/upsert logic for last_bound_at handling." ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:phaseId "phase-AG" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
