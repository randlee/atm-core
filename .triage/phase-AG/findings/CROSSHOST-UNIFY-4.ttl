<urn:atm:triage:finding/CROSSHOST-UNIFY-4>
  a triage:Finding ;
  triage:findingId "CROSSHOST-UNIFY-4" ;
  triage:title "Inbound persistence path partially duplicated" ;
  triage:description "Item 4 of user-mandated 9-point ack/send routing unification checklist PARTIAL. Both Compose and DirectDeliver requests land on the same RequestDispatcher::dispatch (peer_transport/server.rs:743), and a received Compose request re-enters the ordinary local send path (runtime_health/dispatch_delivery.rs:87-94) -- same mailbox write/nudge/response contract as local send. BUT DirectDeliver requests use a distinct handler, deliver_direct_messages_with_runtime_and_post_send_emitter (direct_delivery.rs:10-73), which duplicates persistence/nudge logic instead of reusing send_mail's path. Root cause is the same FINDING-1 wire-shape (Compose vs DirectDeliver) duplication, shared with CROSSHOST-UNIFY-1, -3, -7." ;
  triage:category "architecture-duplication" ;
  triage:phaseId "phase-AG" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "fixed" ;
  triage:severity "important" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-19T00:00:00Z"^^xsd:dateTime ;
