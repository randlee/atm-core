<urn:atm:triage:finding/AW-RAM-B2>
  a triage:Finding ;
  triage:findingId "AW-RAM-B2" ;
  triage:title "service_runtime.rs exceeds the 1000-line decomposition cap after the roster-mirror subsystem was added" ;
  triage:description "quality-mgr, qa-pr1240-r1 (arch-qa): crates/atm-core/src/service_runtime.rs is 1866 total lines; excluding #[cfg(test)] regions, non-test production code is approximately 1147 lines, over the 1000-line decomposition ceiling. This PR added the entire new roster write-through subsystem (RosterMemberEphemeralState, TeamRosterRecord, RosterRuntimeState, RosterRuntimeView, hydrate_roster_runtime_from_durable -- roughly lines 37-297, ~260 non-test lines) into this already-oversized file instead of a dedicated module. Acceptance: extract the roster runtime-mirror subsystem (and its tests) into a new module, e.g. crates/atm-core/src/service_runtime/roster_runtime.rs, re-exported from service_runtime.rs. This also gives AW-RAM-B1's sealed-trait impl site a natural, separately-reviewable home if the ruling keeps the impl in atm-core." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "step2_verdict" ;
  triage:category "code-structure" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T02:10:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AWReadinessReview ;
  triage:foundAt "2026-09-06T01:40:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-RAM-B2/service-runtime-size> ;
  triage:triageRecordVersion "1" .

