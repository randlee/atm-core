<urn:atm:triage:finding/AW-INTEG-001>
  a triage:Finding ;
  triage:findingId "AW-INTEG-001" ;
  triage:title "Diagnostics composition path has zero boundary_enforcement.rs pin" ;
  triage:description "The diagnostics composition path (atm-daemon-bootstrap -> atm-http-runtime -> atm-storage-rusqlite) is correctly layered today but has no boundary_enforcement.rs pin test; a future regression there would slip every existing gate. Filed fresh by arch-qa during the phase-end integration review on integrate/phase-aw @ 4b8726b59 (this finding fell between per-sprint reviewer scopes — no single AW sprint owned a composition-path gate spanning multiple sprints' output). Recommend a test analogous to canonical_write_router_has_one_host_routing_decision (boundary_enforcement.rs:470)." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary-enforcement" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "boundary_enforcement.rs - new test gate required" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T08:05:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AW5 ;
  triage:foundAt "2026-09-05T07:51:15Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-INTEG-001/AW-INTEG-1> ;
  triage:triageRecordVersion "1" .

