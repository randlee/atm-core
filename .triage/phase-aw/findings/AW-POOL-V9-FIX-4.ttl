<urn:atm:triage:finding/AW-POOL-V9-FIX-4>
  a triage:Finding ;
  triage:findingId "AW-POOL-V9-FIX-4" ;
  triage:title "Flaky timing-based test: primary_write_latency_stays_bounded_under_a_full_prune_backlog asserts a fixed wall-clock deadline against a real SQLite insert" ;
  triage:description "quality-mgr's PR #1242 QA verdict (flaky-test-qa): crates/atm-storage-rusqlite/src/writer/mod.rs's primary_write_latency_stays_bounded_under_a_full_prune_backlog test asserts wall-clock elapsed() <= 100ms for a real SQLite insert against a fixed deadline, on a current_thread runtime -- can intermittently fail under CI load with no functional regression. Acceptance: replace the absolute-latency assertion with an ordering/synchronization proof (e.g. assert the primary write completes before/independent of prune-backlog processing via an explicit signal, not a wall-clock race), or move the latency measurement to a separate perf-labeled test excluded from the correctness gate. No sleep/retry/timeout-widening compensating logic." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-flakiness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
