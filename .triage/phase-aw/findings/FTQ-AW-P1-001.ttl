  triage:foundAt "2026-09-05T18:17:37Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-AW-P1-001/AW-P1-001> ;
  triage:triageRecordVersion "1" .

