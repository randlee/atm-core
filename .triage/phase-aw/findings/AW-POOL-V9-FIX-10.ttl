<urn:atm:triage:finding/AW-POOL-V9-FIX-10>
  a triage:Finding ;
  triage:findingId "AW-POOL-V9-FIX-10" ;
  triage:title "doctor_projection.rs fixed worker tasks run unbounded graft-receiver lease lookups inside spawn_blocking" ;
  triage:description "doctor_projection.rs:234 StorageDoctorProjection's fixed worker tasks run the per-roster-member graft-receiver lease lookup inside spawn_blocking with no bound of their own; each lookup can independently wait up to the reader pool's 10s deadline, so under reader-pool saturation a single doctor request can pin a fixed worker for N x up to 10s, well past the client-visible timeout, starving the small worker pool for subsequent doctor requests." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "reliability" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T02:31:26Z"^^xsd:dateTime ;
  triage:foundIn triage:AWWriterPoolAudit ;
  triage:foundAt "2026-09-06T02:26:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-10/AW-POOL-V9-FIX-10-integrate> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-10/AW-POOL-V9-FIX-10-A1> ;
