<urn:atm:triage:finding/AW-READY-O3>
  a triage:Finding ;
  triage:findingId "AW-READY-O3" ;
  triage:title "queue-full classification crosses the atm-storage -> atm-daemon-bootstrap crate boundary via string-sniffing an error message instead of a typed offer enum" ;
  triage:description "fenix-C architecture/boundaries review (01M1S751VVM0K4C7ZW6YDPC7BQ, their F3), elevating fenix-A's minor #8 (`error.message().contains(\"queue is full\")` at crates/atm-storage-rusqlite/src/diagnostic_timeline.rs:226) from brittle-string-match to a cross-boundary contract gap: DiagnosticTimelineStore::record_batch's contract returns an untyped AtmError instead of a typed offer enum (e.g. Accepted/QueueFull/Closed), forcing the daemon-bootstrap consumer to classify drop counters by parsing message text across the crate boundary. quality-mgr confirms this elevation (a crate-boundary API-contract gap is architecturally worse than a brittle string match in isolation). Fix: typed offer/error enum on the storage-side API so daemon-bootstrap classifies drops without string matching." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary-contract" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
