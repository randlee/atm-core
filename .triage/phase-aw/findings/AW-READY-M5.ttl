<urn:atm:triage:finding/AW-READY-M5>
  a triage:Finding ;
  triage:findingId "AW-READY-M5" ;
  triage:title "Diagnostic prune passes run unbounded per-scheduled-pass deletes in one Immediate transaction on the shared writer lane, risking primary-write latency under backlog" ;
  triage:description "arch-ctm review-phase-aw-r1 (01M1S6VD1Y1G7CK9WKKA42DVKM). Both prune passes (age-based and count-based) run as unbounded per-scheduled-pass deletes inside one Immediate transaction (crates/atm-storage-rusqlite/src/writer/ops.rs:214-244) on the shared, priority-biased but non-preemptible durable writer lane (writer/mod.rs:564). A large expired/backlogged table can monopolize the writer and add latency to primary (non-diagnostic) writes. Accepted on arch-ctm's citation, consistent with quality-mgr's own read of the same file for AW-READY-M3/M4. Fix: bounded chunk/transaction per scheduled pass, yield/reselect primary work between chunks, concurrent primary-write latency test under worst-case prune backlog." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "retention-lifecycle" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T16:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AW2 ;
  triage:foundAt "2026-09-05T16:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-READY-M5/occ-195> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-READY-M5/occ-214> ;
  triage:triageRecordVersion "1" .

