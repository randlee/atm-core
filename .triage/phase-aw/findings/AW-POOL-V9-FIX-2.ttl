<urn:atm:triage:finding/AW-POOL-V9-FIX-2>
  a triage:Finding ;
  triage:findingId "AW-POOL-V9-FIX-2" ;
  triage:title "Doctor/diagnostics reader-capacity projection still models two independently-named lanes instead of one shared pool" ;
  triage:description "quality-mgr's PR #1242 QA verdict (req-qa): crates/atm-core/src/doctor/report.rs:285-309, atm-runtime/src/composition.rs:100-200, and atm-storage-rusqlite/src/lib.rs ~660-685 still model reader capacity as two independently-named lanes ('mailbox', 'search') each reporting its own pool_size/queue_depth, even though both now draw from A1's one shared ReaderPool -- misleadingly implies 16 total reader capacity instead of the actual 8, and omits the tool-class cap (6) entirely from doctor/diagnostics output. Acceptance: collapse doctor/diagnostics reporting to one shared-pool projection showing the true pool size (8) and the tool-class sub-cap (6), not two synthetic lane names." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "observability-accuracy" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T02:05:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AW-INTEGRATION-REVIEW ;
  triage:foundAt "2026-09-06T02:00:01Z"^^xsd:dateTime ;
