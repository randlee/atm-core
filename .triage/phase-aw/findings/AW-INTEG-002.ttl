<urn:atm:triage:finding/AW-INTEG-002>
  a triage:Finding ;
  triage:findingId "AW-INTEG-002" ;
  triage:title "Sprint AW.5 doc claims CI matrix coverage that does not exist" ;
  triage:description "Phase-aw integration review (req-qa, at integrate/phase-aw 4b8726b59): docs/plans/phase-aw/sprint-AW.5-native-tool-parity.md:61-62 claims test_cli_parity.py 'is in the 3.11-3.14 matrix'; it actually only runs at one fixed Python version (3.14.7) in the 'test' job. The real 3.11-3.14 matrix job (hermes-atm-abi3-compat) never discovers atm-graft-python tests at all. Filed fresh by req-qa during the phase-end integration review on integrate/phase-aw @ 4b8726b59, independently re-verified against .github/workflows/ci.yml and the sprint doc. Fix is either add it to that matrix job or correct the sprint doc's claim." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "doc-ci-mismatch" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T08:05:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AW5 ;
  triage:foundAt "2026-09-05T07:51:15Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-INTEG-002/AW5-INTEG-1> ;
