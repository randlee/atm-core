  triage:hasOccurrence <urn:atm:triage:occurrence/AW3-CI-002/AW3-3> ;
  triage:closedAt "2026-09-05T08:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "2" .

