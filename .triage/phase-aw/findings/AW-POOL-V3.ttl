  triage:findingId "AW-POOL-V3" ;
  triage:resolutionNote "quality-mgr phase-end gate @94e29a586, fenix ledger hygiene: template_catalog_store.rs reads route through self.db.read; service_runtime_store.rs and read/metadata_selection.rs delegate to SqliteMessageStore::load_message/list_messages which route through self.db.read as of this commit (git blame on the read call sites)." ;
