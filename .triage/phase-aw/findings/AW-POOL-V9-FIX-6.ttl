<urn:atm:triage:finding/AW-POOL-V9-FIX-6>
  a triage:Finding ;
  triage:findingId "AW-POOL-V9-FIX-6" ;
  triage:title "retire_and_replace() can silently ratchet reader pool_size toward zero on respawn failure" ;
  triage:description "reader_pool.rs:838 retire_and_replace(): if spawn_worker() fails while replacing a quarantined/retired worker, pool_size is left permanently decremented with no retry and no unconditional (non-test-only) observability event -- repeated transient respawn failures under the same sustained load that caused the original quarantine can silently ratchet the pool toward zero live workers." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "reliability" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T02:11:57Z"^^xsd:dateTime ;
  triage:foundIn triage:AWWriterPoolAudit ;
  triage:foundAt "2026-09-06T02:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-6/AW1-1> ;
  triage:triageRecordVersion "1" .

