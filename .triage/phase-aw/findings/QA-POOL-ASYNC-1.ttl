<urn:atm:triage:finding/QA-POOL-ASYNC-1>
  a triage:Finding ;
  triage:findingId "QA-POOL-ASYNC-1" ;
  triage:title "graft_receiver_lookup fix uses spawn_blocking+submit_blocking instead of native async submit path" ;
  triage:description "In the AW-POOL-V4 remainder fix (commit 83f3d27cc, later merged to develop via PR #1254 at merge commit a09f60884), the graft_receiver_lookup deadline-bounded read fix in crates/atm-http-runtime/src/storage_and_nudge_router.rs uses spawn_blocking + submit_blocking against control_path_sync_bridge instead of atm-storage-rusqlite's native async submit path (ReaderPool lanes: async submit + deadline + interrupt) that sibling `_async` methods already use. This is architecturally inconsistent with the SQLite reads async via ReaderPool, no join standing pattern (semaphore-around-spawn_blocking is considered a FAIL for read paths elsewhere in this codebase) but quality-mgr scored it non-blocking/minor since it does not regress correctness, only consistency/efficiency." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "consistency" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
