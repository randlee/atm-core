<urn:atm:triage:finding/AW-READY-P1>
  a triage:Finding ;
  triage:findingId "AW-READY-P1" ;
  triage:title "atm send --file zeroes the source file when the path already lives in the team share dir, while reporting success" ;
  triage:description "fenix (01M1S7GTFR44DA787SQQ3N2WTW), live production bug on 1.5.1, unrelated to AW.5's actual sprint scope but filed into the phase-aw ledger per fenix's explicit direction so it can ride the same batched fix round. crates/atm-core/src/send/file_policy.rs:101-104 does `share_copy = share_dir.join(file_name); fs::copy(file_path, &share_copy)` with no same-file/same-inode guard: when <path> already lives in the team share dir (~/.config/atm/share/<team>/), fs::copy truncates the source before copying it to itself, and copied_bytes==0 still passes the size check, so `atm send --file <path>` reports \"Sent to ... [message_id: ...]\" success while the source file has been zeroed (reproduced today on 1.5.1: 80 bytes -> 0 bytes). Root cause is unchanged since the original send implementation (28543ad09) -- an external team's \"changed after Sep 4 10:48 on 1.4.13\" observation is an exposure change (cwd/repo-root or binary swap made is_file_in_repo stop short-circuiting), not a code change; note this in the record rather than treating it as a regression introduced by phase-aw. Fix: same-file/same-inode guard before fs::copy; verify copied_bytes == source file len; regression test asserting the source file's content survives a share-dir send unchanged." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "data-loss" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T16:54:42Z"^^xsd:dateTime ;
  triage:foundIn triage:AW5 ;
  triage:foundAt "2026-09-05T16:48:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-READY-P1/AW1-1> ;
  triage:triageRecordVersion "1" .

