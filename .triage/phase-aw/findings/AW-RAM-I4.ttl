@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AW-RAM-I4>
  a triage:Finding ;
  triage:findingId "AW-RAM-I4" ;
  triage:title "No mechanical boundary/lint guard pins per-tick roster consumers to shared_roster_store_arc(), so a future PR could reintroduce the AW-POOL-V7 failure pattern silently" ;
  triage:description "quality-mgr, qa-pr1240-r1 (ruthless-boundary-qa's RBQA-F002). The original AW-POOL-V7 defect (per-tick roster SQL reads) was not caused by a literal rusqlite/Sqlite* reference in atm-http-runtime -- boundaries/atm-http-runtime/http-runtime.toml's io_forbidden list would not have caught it, because the leak was a trait-level SharedRosterStore handle that happened to be backed by SQLite rather than the RAM mirror. Nothing in boundaries/**/*.toml or crates/atm-architecture/tests/boundary_enforcement.rs mechanically pins 'every long-lived/per-tick roster consumer must obtain its RosterStore handle via LocalServiceRuntime::shared_roster_store_arc()', so a future PR could reintroduce a raw durable-backed roster handle on a hot path with no lint failing. Acceptance: add a boundary/lint rule or an atm-architecture construction-site test (analogous to the existing resolve_picker_recipient() single-construction-site check) asserting that herdr_queue_wake.rs and other per-tick consumers only ever obtain a RosterStore via shared_roster_store_arc(), not via any other SharedRosterStore-producing constructor." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "step2_verdict" ;
  triage:category "boundary-governance" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T02:10:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-06T18:40:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:foundIn triage:AWReadinessReview ;
  triage:foundAt "2026-09-06T01:40:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-RAM-I4/no-mechanical-guard> ;
  triage:triageRecordVersion "1" .

# quality-mgr, 2026-09-06, phase-aw-gate-closeout-fix-round2 (PR #1254 @ ea2b181c6):
# arch-ctm replaced the prior 5-file hardcoded substring check (which I had
# overridden req-qa's "closed" call on, siding with arch-qa's ARCH-002
# finding) with aw_ram_per_tick_roster_consumers_use_only_the_shared_store_
# construction_seam: a live recursive scan (collect_rust_files, confirmed by
# direct read to walk the full directory tree, not a fixed file list) over
# crates/atm-daemon-bootstrap/src and crates/atm-http-runtime/src, finding
# every consumer of the durable RosterStore reads (.load_roster(/.list_teams()
# and asserting each one uses shared_roster_store_arc() and not
# storage_backends.rosters or roster_runtime_mirror(). Asserts
# consumers is non-empty so it cannot pass by silently matching nothing.
# This is now a genuine workspace-scope mechanical guard, analogous in
# spirit to resolve_picker_recipient()'s single-construction-site test,
# satisfying the finding's acceptance criterion.
<urn:atm:triage:occurrence/AW-RAM-I4/no-mechanical-guard>
  a triage:Occurrence ;
  triage:file "crates/atm-architecture/tests/boundary_enforcement.rs" ;
  triage:line 1 ;
  triage:snippet "no construction-site test pins herdr_queue_wake.rs / per-tick roster consumers to shared_roster_store_arc()" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "fix/aw-ram-roster" ;
  triage:headSha "98cea18d7" ;
  triage:occursIn <urn:atm:triage:worktree/fix-aw-ram-roster/98cea18d7-i4> .

