<urn:atm:triage:resolution/AW-RAM-I1/r1>
  a triage:Resolution ;
  triage:findingId "AW-RAM-I1" ;
  triage:resolutionNote "quality-mgr phase-end gate @94e29a586, fenix ledger hygiene: commit message states build_write_through_roster now \"fails closed, propagating a durable read failure at hydration instead of warning and continuing,\" with named regression tests (construction_fails_closed_when_durable_{list_teams,load_roster}_errors, reload_from_durable_fails_closed_on_durable_error)." ;
  triage:resolvedAt "2026-09-06T06:46:36Z"^^xsd:dateTime ;
