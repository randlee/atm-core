<urn:atm:triage:finding/AW-READY-M3>
  a triage:Finding ;
  triage:findingId "AW-READY-M3" ;
  triage:title "7-day age-based diagnostic prune (AW.2 AC4) never fires on a quiet daemon because it is gated by a 500-row batch threshold, not an independent age-based schedule" ;
  triage:description "arch-ctm review-phase-aw-r1 (01M1S6VD1Y1G7CK9WKKA42DVKM), confirmed by quality-mgr via direct read. WriteOp::PruneDiagnostics only runs when diagnostic_rows_since_prune + batch_len >= DIAGNOSTIC_PRUNE_CHECK_EVERY (500) in crates/atm-storage-rusqlite/src/writer/mod.rs:611-668; the 250ms start_flush_worker background thread (crates/atm-daemon-bootstrap/src/diagnostic_timeline.rs:70-92) only calls writer.flush_due(), never independently triggers a time-based prune. A daemon receiving fewer than 500 diagnostic events total therefore never prunes, regardless of row age -- violating sprint AW.2's own AC4 (rows older than 7 days must prune regardless of count, docs/plans/phase-aw/sprint-AW.2-sqlite-diagnostic-timeline.md:114-117). Fix: independent bounded age-prune schedule decoupled from row-count batching, quiet-daemon clock test, overdue-prune health signal." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "retention-lifecycle" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T16:52:20Z"^^xsd:dateTime ;
  triage:foundIn triage:AW2 ;
  triage:foundAt "2026-09-05T16:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-READY-M3/AW2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-READY-M3/AW2-2> ;
  triage:triageRecordVersion "1" .

