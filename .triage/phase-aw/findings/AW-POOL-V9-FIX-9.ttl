<urn:atm:triage:finding/AW-POOL-V9-FIX-9>
  a triage:Finding ;
  triage:findingId "AW-POOL-V9-FIX-9" ;
  triage:title "SharedDb::read/read_tool hardcode static request_deadline() instead of threading caller's remaining deadline" ;
  triage:description "shared_db.rs:212 SharedDb::read/read_tool hardcode the ReaderPool's static 10s request_deadline() instead of threading the caller's remaining deadline, unlike mailbox_reader.rs's sibling lane which does thread deadline.remaining() through submit/submit_tool." ;
