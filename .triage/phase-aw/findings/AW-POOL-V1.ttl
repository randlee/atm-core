<urn:atm:triage:resolution/AW-POOL-V1/r1>
  a triage:Resolution ;
  triage:findingId "AW-POOL-V1" ;
  triage:resolutionNote "quality-mgr phase-end gate @94e29a586, fenix ledger hygiene: persistence.rs now has zero \"template\" references (grep-confirmed); inline template/schema-validation reads were eliminated from the write transaction by the on-demand render refactor (read/render.rs), so the writer path holds no validation read." ;
