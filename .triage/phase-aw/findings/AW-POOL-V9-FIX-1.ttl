<urn:atm:triage:finding/AW-POOL-V9-FIX-1>
  a triage:Finding ;
  triage:findingId "AW-POOL-V9-FIX-1" ;
  triage:title "shared_db.rs with_connection still routes pure reads to writer connection instead of shared ReaderPool" ;
  triage:description "quality-mgr's PR #1244 QA verdict: AW-POOL-V9's fix amended to A2 (fix/aw-pool-read-migration) after A1 deleted control_path_pool.rs. shared_db.rs:248 with_connection still delegates to self.writer_queue instead of shared ReaderPool. Reads in peer_config_store.rs (list_interfaces, local_certificate, list_trusted_peers, trusted_peer), pending_nudge_store.rs (list_pending_members), and nudge_template_override_store.rs (load_template_override) all call self.db.with_connection(...), which resolves to the writer-side connection, not the shared ReaderPool." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "followup_pass" ;
  triage:category "concurrency-architecture" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T20:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AWWriterPoolAudit ;
  triage:foundAt "2026-09-06T02:00:01Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-1/shared-db-248> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-1/peer-config-24> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-1/peer-config-89> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-1/peer-config-132> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-1/peer-config-166> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-1/pending-nudge-152> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-POOL-V9-FIX-1/nudge-template-26> ;
  triage:triageRecordVersion "1" .

