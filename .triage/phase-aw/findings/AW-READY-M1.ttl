<urn:atm:triage:finding/AW-READY-M1>
  a triage:Finding ;
  triage:findingId "AW-READY-M1" ;
  triage:title "command_event_fields() persists team/agent/sender/message_id/task_id/error_message into retained LogEvent, bypassing redaction and reaching atm log --json" ;
  triage:description "arch-ctm review-phase-aw-r1 (msg 01M1S6VD1Y1G7CK9WKKA42DVKM), independently confirmed by quality-mgr via direct read: crates/atm-daemon-bootstrap/src/daemon_observability.rs:227-278 command_event_fields() inserts team, agent, sender, requires_ack, dry_run, and conditionally message_id, task_id, error_code, error_message directly into LogEvent.fields, bypassing the tracing bridge's RETAINED_FIELD_ALLOWLIST redaction path entirely -- this is a second, undocumented retained-sink boundary. crates/atm/src/output.rs print_log_snapshot/print_log_records serializes the full record via serde_json unconditionally, so all of it reaches `atm log --json`. Contradicts docs/atm-daemon/logging.md:7-13 (\"retained records never contain message bodies, recipients, tokens, raw environment/configuration, or absolute user paths\"). Fix: typed redacted command-event projection at the sole retained-sink boundary; exclude identity/address/chat-derived values and arbitrary error strings; end-to-end retained-JSONL and CLI-JSON substring tests. Not a legacy-daemon finding (atm-daemon-bootstrap replacement runtime, not the frozen synchronous daemon)." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "data-hygiene" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T16:51:49Z"^^xsd:dateTime ;
