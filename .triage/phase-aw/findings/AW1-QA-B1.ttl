<urn:atm:triage:finding/AW1-QA-B1>
  a triage:Finding ;
  triage:findingId "AW1-QA-B1" ;
  triage:title "check-runtime-stderr gate splits on first #[cfg(test)] and has no scripts/tests self-test" ;
  triage:description "scripts/check-runtime-stderr.py production_source() splits the file text on the FIRST '#[cfg(test)]' occurrence instead of isolating a trailing test module. crates/atm-daemon-bootstrap/src/daemon_observability.rs has an early #[cfg(test)] at line 13 of 771 lines, so the gate scans only 12 lines and silently exempts all production code after it. AC6 also requires a synthetic-violation self-test under scripts/tests/ which does not exist. Converged: rust-qa-agent QA-001, ruthless-boundary-qa RBQA-F001, arch-qa ARCH-002, req-qa ATM-QA-002." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "AW1-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
