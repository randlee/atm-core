<urn:atm:triage:finding/AW-READY-N4>
  a triage:Finding ;
  triage:findingId "AW-READY-N4" ;
  triage:title "atm-graft-python test_session() shares std::env::temp_dir()/atm-graft-python-tests as its fallback-log path across parallel tests and concurrent test runs on the same host" ;
  triage:description "fenix reviewer-B (01M1S72R6GNBE5ZETPK6943JMX). crates/atm-graft-python/src/lib.rs test_session() (5 call sites: :991,1318,1521,1882,1984,2047) uses the shared std::env::temp_dir()/atm-graft-python-tests path for the fallback logger -- shared across parallel tests within a run and across concurrent cargo test invocations on the same host (rotation/rename collisions). Latent today (no test currently asserts on the file contents) but the exact shared-mutable-path class Family C already exists to catch. Redesign: per-test TempDir, matching the existing test_session_with_fallback_path pattern at :1001." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-determinism" ;
  triage:severity "important" ;
  triage:repeatable true ;
