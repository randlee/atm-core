  a triage:Finding ;
  triage:findingId "AW-POOL-V9-FIX-8" ;
  triage:title "mailbox_reader.rs's storage_error() still does lossy AtmError->ReadLaneError conversion" ;
  triage:description "mailbox_reader.rs's storage_error() still does the lossy AtmError->ReadLaneError{message} conversion (discards code/cause) -- this PR's own two migrated files (graft_receiver_endpoint_store.rs, template_catalog_store.rs) correctly avoid it via GraftEndpointStoreError::storage()/direct AtmError passthrough, but the pre-existing instance in mailbox_reader.rs (in this PR's review scope) was not fixed." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
