<urn:atm:triage:finding/AW-READY-N5>
  a triage:Finding ;
  triage:findingId "AW-READY-N5" ;
  triage:title "test_cli_parity.py isolates HOME/ATM_HOME but current_host_runtime_scope ignores them by design, so the 'disposable' parity daemon owns the real ~/.atm/daemon and can collide with a live host daemon" ;
  triage:description "fenix reviewer-B (01M1S72R6GNBE5ZETPK6943JMX). crates/atm-graft-python/tests/test_cli_parity.py:150-156 isolates HOME/ATM_HOME/ATM_LOG_DIR/TMPDIR, but crates/atm-core/src/home.rs:48-62 current_host_runtime_scope has an inline comment explicitly stating it intentionally ignores HOME/USERPROFILE/ATM_HOME/cwd - process scoped, resolving owner_lock/socket/durable_state_root via libc::getpwuid(libc::geteuid()). The test daemon owns ~/.atm/daemon and ~/.atm/db; any live daemon fails on owner.lock. Masked by CI runs once per job on fresh VMs. Also carries hang hazards: readline() no timeout, stderr PIPE never drained, CliParityTests._cli no subprocess timeout. Architecture mismatch, not timing bug. Fix: runtime-scope override for tests, thread-drained pipes, subprocess timeout." ;
  triage:phaseId "phase-aw" ;
  triage:triageMode "initial_pass" ;
  triage:category "host-isolation" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-06T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T16:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AW5 ;
  triage:foundAt "2026-09-05T16:40:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AW-READY-N5/AW1-1> ;
  triage:triageRecordVersion "1" .

# quality-mgr, 2026-09-06, qa-phase-aw-integration-review-r2: fixed exactly
# per the post-mortem's own prescribed shape -- a scoped, debug-only
# ATM_TEST_RUNTIME_HOME override in crates/atm-core/src/home.rs (gated
# #[cfg(debug_assertions)], compiled out of release builds, so the
# production host-daemon singleton behavior is unweakened), landed via
# b3e37b726 (test: isolate CLI parity runtime scope), an ancestor of
# integrate/phase-aw@062cb44dd. crates/atm-graft-python/tests/
# test_cli_parity.py now sets this var in setUpClass before constructing
# native_tools.AtmNativeTools, with an _assert_debug_native_scope guard
# rejecting a release-wheel/scope mismatch. Independently confirmed by
# arch-qa, req-qa, and fenix's separate production-readiness lane B
# (bounded harness waits also confirmed at test_cli_parity.py:104,136,192-232).
<urn:atm:triage:occurrence/AW-READY-N5/AW1-1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/home.rs" ;
  triage:line 52 ;
  triage:snippet "#[cfg(debug_assertions)] ATM_TEST_RUNTIME_HOME override, validated and compiled out of release" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "integrate/phase-aw" ;
