<urn:atm:triage:finding/ATM-QA-Y6-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-Y6-002" ;
  triage:title "No test for SQLite-success + append-failure → post-send-hook fallback" ;
  triage:description "Sprint Y.6 requires explicit acceptance tests for each approved failure branch including 'append failure -> post-send-hook fallback for notification degradation'. When SQLite succeeds but JSONL append fails, persist_message_and_seed_workflow returns DeliveryPersistenceResult::append_degraded. No test in the reviewed codebase directly proves this disposition triggers post-send-hook execution (RunPostSendHookFallback in ClaudeHarnessNewMessageState). The hook fallback is only exercised via finalize_send_outcome/run_send_post_send_hooks but no test connects these two steps explicitly for the append-degraded case." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
