<urn:atm:triage:finding/ATM-QA-S4-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-004" ;
  triage:title "ThreadUpdateStateMachine missing Rejected terminal state; DispatchByHarness renamed to RouteDelivery without rationale" ;
  triage:description "In crates/atm-core/src/delivery_policy.rs around L198, the ThreadUpdateStateMachine enum: (1) is missing the required Rejected terminal state from the delivery-state-machines.md spec, and (2) renames DispatchByHarness to RouteDelivery without documented rationale. The Rejected state is required as an explicit terminal for policy-rejection paths. The rename creates a discrepancy between the spec and implementation with no spec update." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-16T20:15:00Z"^^xsd:dateTime ;
