<urn:atm:triage:finding/RUST-QA-Y6-002>
  a triage:Finding ;
  triage:findingId "RUST-QA-Y6-002" ;
  triage:title "append_message_cleans_preexisting_stale_lock_sentinel test name contradicts assertion" ;
  triage:description "Test append_message_cleans_preexisting_stale_lock_sentinel at mailbox/mod.rs:373 creates a stale sentinel file, calls append_message, then asserts lock::sentinel_path(&path).exists() — that the sentinel STILL EXISTS. The test name says 'cleans' (implies removal) but the assertion verifies the opposite. The test passes because append_message does not touch the sentinel, but the implied behavioral contract is inverted. Fix: rename to append_message_does_not_remove_preexisting_lock_sentinel (and keep the exists() assertion), OR add sentinel removal to append_message if cleanup behavior is the real intent." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
  triage:category "RUST-QA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/mailbox/mod.rs" ;
  triage:status "open" ;
