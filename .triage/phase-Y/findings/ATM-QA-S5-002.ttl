<urn:atm:triage:finding/ATM-QA-S5-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-S5-002" ;
  triage:title "expiresAt removal lacks explicit absence assertion in export tests" ;
  triage:description "expiresAt is stripped by strip_removed_compatibility_fields() but no export test constructs an envelope with expires_at: Some(...) and asserts !object.contains_key('expiresAt'). Fix: extend one test to set expires_at: Some(IsoTimestamp::...), call to_shared_inbox_value(), assert expiresAt key is absent." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/schema/inbox_message.rs" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
  triage:closureNote "Fixed in Y.5 fix-r1 commit 7a617fc8: new test shared_inbox_write_strips_expires_at at inbox_message.rs:653-689 sets expires_at: Some(IsoTimestamp::from_datetime(...)) and asserts !object.contains_key('expiresAt') with explicit failure message. QA-2 req-qa recheck PASS." ;
  triage:closedOn <urn:atm:triage:worktree/pY-s5/e55b0c89> ;
