  triage:snippet "fn retrieval_stub_text(...) -> Result<String, AtmError> { let Some(message_id) = message.message_id else { return Err(...) }; // dead: only called when should_export_retrieval_stub() == true, which requires message_id.is_some()" ;
  triage:status "open" ;
