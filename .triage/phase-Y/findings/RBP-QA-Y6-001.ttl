<urn:atm:triage:finding/RBP-QA-Y6-001>
  a triage:Finding ;
  triage:findingId "RBP-QA-Y6-001" ;
  triage:title "retrieval_stub_text dead error branch — RBP-007 infallible usage" ;
  triage:description "retrieval_stub_text at inbox_message.rs:386 returns Result<String, AtmError> with an error branch for message_id being None (lines 388-393). The function's only caller (to_shared_inbox_value_with_policy) reaches it exclusively via should_export_retrieval_stub which returns true only when message.message_id.is_some(). The None error arm is structurally unreachable. Fix: remove the Result wrapper and return String directly, or accept message_id by value from the caller which already holds the Some guard." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/schema/inbox_message.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
