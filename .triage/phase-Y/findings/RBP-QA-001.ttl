<urn:atm:triage:finding/RBP-QA-001>
  a triage:Finding ;
  triage:findingId "RBP-QA-001" ;
  triage:title "execute_upsert_message_state returns WriteOpResult::Unit — should return Result<(), AtmError>" ;
  triage:description "crates/atm-rusqlite/src/writer/ops.rs:234 execute_upsert_message_state returns WriteOpResult::Unit on success. WriteOpResult::Unit is semantically equivalent to (). RBP-001: should return Result<(), AtmError> instead. Fix: change return type to Result<(), AtmError> and return Ok(()) on success." ;
