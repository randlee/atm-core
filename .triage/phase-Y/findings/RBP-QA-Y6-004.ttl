<urn:atm:triage:finding/RBP-QA-Y6-004>
  a triage:Finding ;
  triage:findingId "RBP-QA-Y6-004" ;
  triage:title "mailbox_record_parse_error missing .with_recovery() — RBP-001" ;
  triage:description "mailbox_record_parse_error at mailbox/mod.rs:271 constructs an AtmError with MailboxRead code but omits .with_recovery(). This function is called from parse_mailbox_array line 172 on the Err arm which propagates (does not skip). Users who encounter a hard parse failure receive no recovery guidance. Fix: add .with_recovery(\"Inspect the mailbox file for malformed JSON records or partial writes, then retry atm read. If corruption persists, archive or remove the malformed mailbox file.\") to the error." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/mailbox/mod.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
