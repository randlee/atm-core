<urn:atm:triage:finding/ATM-QA-S4-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-003" ;
  triage:title "RestoreInboxRebuildStateMachine introduces unauthorized CleanupStaging state; drops Rejected; unauthorized renames" ;
  triage:description "In crates/atm-core/src/delivery_policy.rs around L274, the RestoreInboxRebuildStateMachine enum: (1) introduces a CleanupStaging state not present in the delivery-state-machines.md spec, (2) drops the required Rejected terminal state, and (3) renames states relative to the spec (ResolveHarness vs ValidateClaudeHarness, LoadProjection vs LoadRestoreProjection, StageOutput vs StageRestoreOutput, PublishOutput vs PublishRestoreOutput, Completed vs Delivered) without documented rationale. Only states from the authoritative spec are permitted; no ad-hoc states may be added without spec update." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-16T20:00:00Z"^^xsd:dateTime ;
