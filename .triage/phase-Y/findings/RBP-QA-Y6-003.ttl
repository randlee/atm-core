<urn:atm:triage:finding/RBP-QA-Y6-003>
  a triage:Finding ;
  triage:findingId "RBP-QA-Y6-003" ;
  triage:title "SendOutcome::outcome bare String status discriminant — RBP-004" ;
  triage:description "SendOutcome::outcome at send/mod.rs:105 is typed as String but used exclusively as a two-value status discriminant ('sent' or 'dry_run'). The literal strings are hardcoded at two separate assignment sites (line 236 and line 259). A raw String provides no exhaustiveness guarantee and can silently diverge. Fix: introduce a small enum (e.g., SendCommandOutcome with Sent and DryRun variants) or extract named constants to prevent silent divergence. This matches the existing CommandAction newtype pattern in the module." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/send/mod.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
