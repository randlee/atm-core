<urn:atm:triage:finding/ATM-QA-S4-005>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-005" ;
  triage:title "append_failure_transitions() NonClaude arm returns post_send_hook_fallback — state does not exist in NonClaudeHarnessNewMessageState" ;
  triage:description "In crates/atm-core/src/delivery_policy.rs around L550, the append_failure_transitions() function's NonClaude harness arm references 'post_send_hook_fallback' (RunPostSendHookFallback transition name), but that state does not exist in NonClaudeHarnessNewMessageState enum. The state exists only in ClaudeCodeHarnessNewMessageState. This is both a spec violation (undefined state reference) and an architectural boundary violation (NonClaude harnesses should not use append paths)." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-Y" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-16T00:00:00Z"^^xsd:dateTime ;
