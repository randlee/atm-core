<urn:atm:triage:finding/ATM-QA-S4-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-001" ;
  triage:title "AckReplyStateMachine has 6 states; spec requires 9" ;
  triage:description "In crates/atm-core/src/delivery_policy.rs, the AckReplyStateMachine enum (around L232) defines only 6 states. The delivery-state-machines.md spec requires 9: the current 6 plus ValidateReplyTargetAllowed, BuildReplyDeliveryRequest, DispatchReplyByHarness, and Rejected. All four missing states are documented in docs/phase-Y/delivery-state-machines.md as mandatory for the AckReply event family." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "initial_pass" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-16T00:00:00Z"^^xsd:dateTime ;
