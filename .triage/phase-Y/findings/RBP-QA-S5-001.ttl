<urn:atm:triage:finding/RBP-QA-S5-001>
  a triage:Finding ;
  triage:findingId "RBP-QA-S5-001" ;
  triage:title "MailStoreIngestReplayState.last_fingerprint bare Option<String> — RBP-001 newtype discipline" ;
  triage:description "crates/atm-core/src/boundary/mail.rs:86 field last_fingerprint: Option<String> is a bare String. Adjacent field replay_source uses the ReplaySource newtype. RBP-001 requires struct fields exposed at the crate boundary to use domain newtypes rather than bare primitives. Fix: introduce a MessageFingerprint newtype wrapping String and update last_fingerprint to Option<MessageFingerprint>. Pre-existing: last_fingerprint was not added in Y.5 diff, but zero-tolerance policy requires reporting regardless of origin." ;
  triage:phaseId "phase-Y" ;
