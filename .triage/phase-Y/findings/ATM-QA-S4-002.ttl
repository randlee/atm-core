<urn:atm:triage:finding/ATM-QA-S4-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-002" ;
  triage:title "InboxRepairStateMachine missing FilterDeletedMessages and Rejected states; unauthorized renames" ;
  triage:description "In crates/atm-core/src/delivery_policy.rs around L259, the InboxRepairStateMachine enum is missing FilterDeletedMessages and Rejected states required by the spec in docs/phase-Y/delivery-state-machines.md. Additional issue: states have been renamed relative to the spec without documented rationale (ResolveHarness vs ValidateClaudeHarness, LoadProjection vs LoadRepairProjection, StageOutput vs StageInboxRebuild, PublishOutput vs PublishInboxRebuild, Completed vs Delivered), creating a mismatch between the implementation and the authoritative delivery-state-machines.md specification." ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-16T00:00:00Z"^^xsd:dateTime ;
