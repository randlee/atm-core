<urn:atm:triage:finding/RBP-QA-Y6-002>
  a triage:Finding ;
  triage:findingId "RBP-QA-Y6-002" ;
  triage:title "execute_upsert_message_state returns WriteOpResult::Unit instead of () — RBP-007" ;
  triage:description "execute_upsert_message_state in ops.rs returns Result<WriteOpResult, AtmError> where the success value is always WriteOpResult::Unit. The Unit variant carries no information; none of the call sites inspect the success payload. Result<(), AtmError> is the correct type for a fallible operation returning no value. Fix: change return type to Result<(), AtmError>, remove WriteOpResult::Unit if it has no other uses." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-rusqlite/src/writer/ops.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
