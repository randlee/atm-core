<urn:atm:triage:finding/ATM-QA-S5-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-S5-001" ;
  triage:title "Kept fields parentMessageId and threadMode lack positive compat-export test assertions" ;
  triage:description "Sprint Y.5 sub-task 1 requires 'schema/export tests cover every surviving field intentionally.' The test shared_inbox_write_keeps_only_approved_immutable_fields fixture sets parent_message_id: None and thread_mode: None. No test constructs an envelope with parent_message_id: Some(...) or thread_mode: Some(...) and positively asserts that parentMessageId and threadMode survive to_shared_inbox_value(). Fix: add test cases setting parent_message_id: Some(AtmMessageId::new()) and thread_mode: Some(ThreadMode::AddDetails), call to_shared_inbox_value(), assert both keys present." ;
  triage:phaseId "phase-Y" ;
  triage:triageMode "sprint_review" ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/schema/inbox_message.rs" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
  triage:closureNote "Fixed in Y.5 fix-r1 commit 7a617fc8: new test shared_inbox_write_keeps_parent_message_id_and_thread_mode_when_set at inbox_message.rs:616-651 sets parent_message_id: Some(AtmMessageId::new()) and thread_mode: Some(ThreadMode::AddDetails), asserts both parentMessageId and threadMode keys present in to_shared_inbox_value() result. QA-2 req-qa recheck PASS." ;
  triage:closedOn <urn:atm:triage:worktree/pY-s5/e55b0c89> ;
