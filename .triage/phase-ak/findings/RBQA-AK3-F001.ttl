<urn:atm:triage:finding/RBQA-AK3-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AK3-F001" ;
  triage:title "IP-literal canonical host escapes AK.3's no-second-spelling invariant" ;
  triage:description "quality-mgr's AK3-QA-1 (PR #746 @ 57daeefa) found that HostName::from_str and the PeerDirectory canonical-peers loop lack the IP-literal guard that the aliases loop already has, contradicting the sprint's own no-second-spelling invariant for canonical peer alias persistence." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-03T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AK-S3 ;
  triage:foundAt "2026-08-04T04:42:31Z"^^xsd:dateTime ;
