<urn:atm:triage:finding/RBQA-F002-AK9>
  a triage:Finding ;
  triage:findingId "RBQA-F002-AK9" ;
  triage:title "No host/message-set-mismatch test for confirm_peer_delivery_batch" ;
  triage:description "Sprint doc docs/plans/phase-ak/sprint-AK9-peer-batch-confirmation.md (lines 133-134) explicitly requires proof that a mismatch of host or message set cannot retire unrelated durable records. Only same-host success and duplicate-ID-within-batch are tested (crates/atm-storage-rusqlite/src/lib.rs:982,1045); the production matches() check (lib.rs:365-385) inside confirm_peer_delivery_batch that a host-mismatch case would exercise is unverified -- no test constructs a mismatched host or a message set that doesn't match the stored markers and asserts zero records retired." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
