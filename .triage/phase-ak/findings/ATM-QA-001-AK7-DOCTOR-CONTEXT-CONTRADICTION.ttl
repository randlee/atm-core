<urn:atm:triage:finding/ATM-QA-001-AK7-DOCTOR-CONTEXT-CONTRADICTION>
  a triage:Finding ;
  triage:findingId "ATM-QA-001-AK7-DOCTOR-CONTEXT-CONTRADICTION" ;
  triage:title "AK.7 doc claims daemon does not read caller env vars, but pre-existing allowlisted read still reports them" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs project_doctor_report reads and reports the daemon's own ATM_TEAM/ATM_IDENTITY into report.daemon_context via read_cli_team_from_env_or_warn/read_cli_identity_from_env_or_warn, a pre-existing exception allowlisted under issue #548 (.just/allowlists/env_var_boundary_allowlist.toml:95-125). This file is untouched by AK.7's diff. AK.7's own new text in docs/atm-daemon/requirements.md:37-39 asserts as unqualified fact that atm-daemon does not read, default from, or report those ambient caller variables, contradicting the still-live read. Deliverable 3 requires proving no production read of ATM_TEAM/ATM_IDENTITY/ATM_ENVIRONMENT exists below crates/atm-daemon/src -- that proof is false." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
