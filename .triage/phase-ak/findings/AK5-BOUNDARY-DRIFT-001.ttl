<urn:atm:triage:finding/AK5-BOUNDARY-DRIFT-001>
  a triage:Finding ;
  triage:findingId "AK5-BOUNDARY-DRIFT-001" ;
  triage:title "post-write-router.toml io_forbidden contradicts peer_delivery_router.rs behavior" ;
  triage:description "ruthless-boundary-qa CRITICAL finding, independently re-verified by quality-mgr and by team-lead via direct grep: boundaries/atm-daemon/post-write-router.toml io_forbidden list still includes sqlite, socket_io, tls, hook_execution, graft_delivery. First occurrence found at head 20841d77 on feature/pak-s5-direct-peer-timer-state; recurred on feature/pak-s10-post-write-router-boundary at head db268df0. peer_delivery_router.rs at lines 57-60 directly calls message_store.confirm_peer_delivery_batch (a real sqlite write into atm-storage), contradicting the TOML boundary declaration. The boundary TOML record and the actual code have drifted apart." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "followup_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
