<urn:atm:triage:finding/ATM-QA-002-AK7-WINDOWS-CFG-GATING>
  a triage:Finding ;
  triage:findingId "ATM-QA-002-AK7-WINDOWS-CFG-GATING" ;
  triage:title "ProcessEnvironmentGuard/std::fs import missing cfg(unix) gate, breaking windows-latest lint" ;
  triage:description "crates/atm-daemon-client/src/lib.rs use std::fs at line 999 and struct ProcessEnvironmentGuard plus its impl and impl Drop at lines 1067-1115 are unconditional, but their sole consumer, the test shared_auto_start_child_cannot_observe_caller_context_environment at line 1141, is cfg(unix)-gated. This code is new to AK.7's own diff, not inherited debt. On windows-latest this produces genuine dead-code clippy errors matching CI logs exactly: unused import std::fs; struct ProcessEnvironmentGuard is never constructed; associated function set is never used. This is the confirmed sprint-attributable CI-red root cause blocking just lint windows-latest." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-04T05:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AK.7 ;
  triage:foundAt "2026-08-03T22:10:00Z"^^xsd:dateTime ;
