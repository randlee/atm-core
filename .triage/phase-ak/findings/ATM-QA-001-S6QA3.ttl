<urn:atm:triage:finding/ATM-QA-001-S6QA3>
  a triage:Finding ;
  triage:findingId "ATM-QA-001-S6QA3" ;
  triage:title "Boundary/doc references non-existent type and module" ;
  triage:description "boundaries/atm-daemon/peer-http-adapter.toml and docs/atm-daemon/boundaries.md reference type 'PeerHttpListenerSet' and module 'atm_daemon::peer_http_listener' which do not exist in crates/. The real type in current codebase is 'HttpsListenerSet' in 'atm_daemon::https_transport'. AK.4's sprint doc (sprint-AK4-direct-peer-http-no-retry.md) intends to create these types as the replacement plain-HTTP receiver, but work was not yet completed at AK.6 branch point. This is a forward-reference to planned AK.4 deliverables, which is acceptable only if AK.4 implements them; otherwise it is a wrong-name error or premature specification. Quality-mgr AK6-QA-3 review confirmed both files require immediate update or AK.4 implementation validation." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
