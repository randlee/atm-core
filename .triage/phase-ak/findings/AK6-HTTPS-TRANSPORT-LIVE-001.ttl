<urn:atm:triage:finding/AK6-HTTPS-TRANSPORT-LIVE-001>
  a triage:Finding ;
  triage:findingId "AK6-HTTPS-TRANSPORT-LIVE-001" ;
  triage:title "HTTPS transport implementation falsely documented as historical" ;
  triage:description "docs/atm-daemon/boundaries.md and docs/atm-storage/boundaries.md falsely claim that crates/atm-daemon/src/https_transport.rs is historical/retired. However, crates/atm-daemon/src/composition.rs lines 298-343 actively wire HttpsTransport/HttpsListenerSet as the production MutualTls default with live listener thread and transport installation." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-04T04:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AK.6 ;
  triage:foundAt "2026-08-04T03:48:49Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-04T04:30:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closedNote "AK6-QA-6 @ 6592c600: HTTPAPI-1, ATMARCH-1, SMOKE-1, and PEERADAPTER-1 all now read as planned/not-implemented language for AK.4's PeerHttpListenerSet and correctly state HttpsTransport/HttpsListenerSet remain the live production path pending AK.2's removal, matching composition.rs reality. Confirmed independently by req-qa, arch-qa, and quality-mgr direct re-read; CI green 8/8. COMPOSITION-1 remains open and unclosed by design -- composition.rs is unchanged and HttpsTransport/HttpsListenerSet deletion is AK.2's scope, not AK.6's, per sprint doc lines 18/22/90; that occurrence will close only when AK.2 lands." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AK6-HTTPS-TRANSPORT-LIVE-001/COMPOSITION-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AK6-HTTPS-TRANSPORT-LIVE-001/BOUNDARIES-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AK6-HTTPS-TRANSPORT-LIVE-001/HTTPAPI-1> ;
