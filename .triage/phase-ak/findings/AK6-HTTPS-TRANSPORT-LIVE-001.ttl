  triage:hasOccurrence <urn:atm:triage:occurrence/AK6-HTTPS-TRANSPORT-LIVE-001/SMOKE-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AK6-HTTPS-TRANSPORT-LIVE-001/PEERADAPTER-1> ;
  triage:triageRecordVersion "4" .

