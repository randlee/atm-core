<urn:atm:triage:finding/RBP-F001-AK9>
  a triage:Finding ;
  triage:findingId "RBP-F001-AK9" ;
  triage:title "Missing error_catalog.rs guidance for AtmErrorCode::RemoteDeliveryUnconfirmed" ;
  triage:description "AtmErrorCode::RemoteDeliveryUnconfirmed has no entry in any of the nine guidance functions (configuration_guidance, identity_guidance, daemon_guidance, local_http_guidance, mailbox_guidance, request_guidance, observability_guidance, warning_guidance, post_send_guidance) in error_catalog.rs. Falls through to generic fallback match arm (line 46) and loses the constructor's documented recovery fact: 'Local persistence completed, but the peer did not accept the immutable write before the caller's shared deadline. Retrying uses the same ULID is safe.' Also untested - error.rs test only asserts wire code, not rendered guidance. Remote delivery is a peer-transport feature introduced in AK.8-AK.9 sprints, spanning peer message array work and direct HTTP transport." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-05T02:35:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AK.9 ;
  triage:foundAt "2026-08-05T02:29:25Z"^^xsd:dateTime ;
