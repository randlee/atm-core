<urn:atm:triage:finding/RBP-AK3-F001>
  a triage:Finding ;
  triage:findingId "RBP-AK3-F001" ;
  triage:title "save_peer_alias collapses all SqliteFailure variants into a generic validation error" ;
  triage:description "crates/atm-storage-rusqlite/src/peer_config_store.rs:296-311 save_peer_alias's INSERT error handler uses matches!(error, rusqlite::Error::SqliteFailure(_, _)) to catch ANY SqliteFailure (constraint violation, DatabaseBusy, DatabaseLocked, OperationInterrupted) and forces it into a generic AtmError::peer_config_validation('already exists or references an invalid canonical peer') message. This discards the real classification that shared_db.rs:822 sqlite_error() already provides for other call sites in this same file (ConstraintViolation -> validation, DatabaseBusy/DatabaseLocked -> mailbox_lock_timeout, OperationInterrupted -> mailbox_lock_timeout). A caller hitting a lock contention or timeout during save_peer_alias sees a misleading 'already exists' validation error instead of a retryable lock-timeout error, and cannot distinguish the two failure classes." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-03T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AK.3 ;
  triage:foundAt "2026-08-04T04:42:31Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-AK3-F001/1> ;
  triage:triageRecordVersion "1" ;
  triage:closedAt "2026-08-04T05:30:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" .

