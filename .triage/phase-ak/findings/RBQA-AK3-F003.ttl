<urn:atm:triage:finding/RBQA-AK3-F003>
  a triage:Finding ;
  triage:findingId "RBQA-AK3-F003" ;
  triage:title "Boundary lint checks dependency-edge granularity only, cannot catch per-trait over-grants" ;
  triage:description "collect_allowed_dependent_violations in .just/lint_boundaries.py only checks Cargo-dependency-edge granularity, not per-trait or per-symbol usage, so it cannot catch an allowed_dependents over-grant like RBQA-AK3-F002 where a listed dependent crate has a valid Cargo dependency edge but never actually references the granted trait or type. The same class of leak will recur on future manifest edits to this crate." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "minor" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
