<urn:atm:triage:finding/AK2-ABSENCE-GATE-SCOPE-001>
  a triage:Finding ;
  triage:findingId "AK2-ABSENCE-GATE-SCOPE-001" ;
  triage:title "Absence gate only greps 11 hardcoded files instead of workspace-wide sweep" ;
  triage:description "The ak2_peer_worker_symbols_are_absent_from_production test in boundary_enforcement.rs only checks a hardcoded list of 11 production source files. This gate should fail CI if any of the deleted constructs (peer coordinator, per-message worker, custom TLS transport, PeerSync, policy/projection scaffolding) reappear anywhere in the workspace, but it only checks these specific files: lib.rs, composition.rs, runtime_health.rs, post_commit_work.rs, peer_delivery_router.rs, api.rs, protocol.rs, peer.rs CLI command, CLI composition, atm-storage contract, and peer_config_store. The test fails to catch reappearances in other crates or modules." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
