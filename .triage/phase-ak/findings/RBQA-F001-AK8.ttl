<urn:atm:triage:finding/RBQA-F001-AK8>
  a triage:Finding ;
  triage:findingId "RBQA-F001-AK8" ;
  triage:title "duplicate/weaker admission-decision logic bypasses atomic check-and-insert" ;
  triage:description "The array admission path in crates/atm-core/src/send/peer_array.rs:189-229 decides new/duplicate/conflicting via a plain load_message_record read, then defers insertion to a later batch persist_message_records_atomically call whose per-item `inserted` result is discarded (`let _ = execute_upsert_message(...)` in atm-storage-rusqlite/src/writer/ops.rs:58-63). The singleton path makes this same decision atomically via admit_message_record -> save_message_if_absent. A race (concurrent singleton send/ack/second array request admitting the same origin ID between the array item's read and the batch commit) is silently swallowed instead of raising MessageIdConflict, breaking the sprint's own idempotent-replay-semantics requirement." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-04T13:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AK.8 ;
  triage:foundAt "2026-08-04T00:00:00Z"^^xsd:dateTime ;
