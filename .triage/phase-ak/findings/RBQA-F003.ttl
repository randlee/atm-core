  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003/AK3-STORAGE-TLS-5> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003/AK6-STORAGE-TLS-PROTOCOL> ;
  triage:triageRecordVersion "1" .

