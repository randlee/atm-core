<urn:atm:triage:finding/RBQA-F003>
  a triage:Finding ;
  triage:findingId "RBQA-F003" ;
  triage:title "TlsIdentity/PinnedClientVerifier/fingerprint helpers relocated into atm-storage public API without boundary governance" ;
  triage:description "AK6-QA-3 regression: The fix removed the direct atm-daemon → atm-peer-tls-interop dependency, but relocated TlsIdentity, PinnedClientVerifier, certificate_fingerprint, and normalize_fingerprint into atm-storage's public API (crates/atm-storage/src/lib.rs:30 pub use re-exports) with zero boundary-manifest governance. This TLS surface is now reachable from atm CLI, atm-runtime, atm-daemon-bootstrap, and atm-daemon-client — unlike every other atm-storage contract which has matching boundaries/atm-storage/*.toml manifest entries. This violates the boundary-architecture contract and the sprint doc's no-active-dependent prohibition." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "followup_pass" ;
  triage:category "architecture" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "regressed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-04T03:17:12Z"^^xsd:dateTime ;
  triage:foundIn triage:AK.6 ;
  triage:foundAt "2026-08-04T03:17:12Z"^^xsd:dateTime ;
