<urn:atm:triage:finding/RBQA-F003>
  a triage:Finding ;
  triage:findingId "RBQA-F003" ;
  triage:title "TlsIdentity/PinnedClientVerifier/fingerprint helpers relocated into atm-storage public API without boundary governance" ;
  triage:description "AK6-QA-4 (second) regression: TlsIdentity, PinnedClientVerifier, certificate_fingerprint, and normalize_fingerprint remain re-exported from atm-storage's public API (crates/atm-storage/src/lib.rs:30-32) without boundary-manifest governance enforcement. The boundaries/atm-storage/tls.toml file exists but is NOT listed in guarded_boundary_files() enforcement (crates/atm-architecture/tests/boundary_enforcement.rs:1965-1978), meaning boundary governance does not apply. Additionally, PinnedClientVerifier implements real TLS 1.2/1.3 protocol logic (verify_tls12_signature/verify_tls13_signature at crates/atm-storage/src/tls.rs:161-177), contradicting the manifest's 'value validation only' claim. The allowed_dependents list remains overly broad, including atm, atm-core, atm-daemon, atm-daemon-bootstrap, atm-daemon-client, and atm-runtime, none of which actually use TLS today." ;
  triage:phaseId "phase-ak" ;
  triage:triageMode "followup_pass" ;
  triage:category "architecture" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "regressed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-04T03:48:34Z"^^xsd:dateTime ;
  triage:foundIn triage:AK.6 ;
  triage:foundAt "2026-08-04T03:48:34Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003/AK3-STORAGE-TLS-1> ;
