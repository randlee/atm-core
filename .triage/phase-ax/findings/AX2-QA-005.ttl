<urn:atm:triage:finding/AX2-QA-005>
  a triage:Finding ;
  triage:findingId "AX2-QA-005" ;
  triage:title "Stale doc comment on render_built_in_nudge_for_dispatch names only Tmux and graft as consumers of the identical text" ;
  triage:description "crates/atm-core/src/send/hook.rs ~99-100 doc comment reads 'Tmux and graft therefore receive identical XML text', but AX.2 D1 added the Herdr call site (~48) to the same shared render function, a third consumer, as verified by tmux_and_herdr_dispatches_share_the_rendered_template in crates/atm-core/src/send/tests.rs. Fix: name Tmux, Herdr, and graft. Found by quality-mgr, corroborated by ruthless-boundary-qa RBQA-F001 on PR #1186 QA-1 (head 4f77d2fff)." ;
