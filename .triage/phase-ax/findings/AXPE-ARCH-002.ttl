<urn:atm:triage:finding/AXPE-ARCH-002>
  a triage:Finding ;
  triage:findingId "AXPE-ARCH-002" ;
  triage:title "atm subprocess spawn missing ATM runtime env isolation" ;
  triage:description "legacy_environment_variable_cannot_bypass_clap_parsing (:72-76) spawns Command::new(atm_bin) for `atm --version` with only ATM_CLI_SURFACE_DUMP set, without ATM_HOME/ATM_CONFIG_HOME/ATM_LOG_DIR/ATM_TEAMS_DIR under a temp dir, unlike live_surface_json() (:50-56) and every other CLI subprocess test (RULE-011, docs/cross-platform-guidelines.md Test Subprocess Isolation). Blast radius is small (clap short-circuits --version before init_observability) but the isolation contract is per spawn. Remediation: reuse the tempdir fixture and env() pattern from live_surface_json()." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "phase_end_review" ;
