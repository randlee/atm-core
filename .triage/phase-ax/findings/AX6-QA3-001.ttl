<urn:atm:triage:finding/AX6-QA3-001>
  a triage:Finding ;
  triage:findingId "AX6-QA3-001" ;
  triage:title "RULE-008: new D8 test escalation_recipients_are_scoped_deduplicated_and_capped in crates/atm-storage-rusqlite/src/task_store.rs hardcodes the production atm-dev literal" ;
  triage:description "AX.6 QA-3 (quality-mgr QA-AX6-R3-1788637011, PR #1204 report 2026-09-05T19:45Z, arch-qa ARCH-101, full-crate sweep) at head 43e1d40b33357024dea87742b4f8a114e7fd4966. The new D8 test escalation_recipients_are_scoped_deduplicated_and_capped at crates/atm-storage-rusqlite/src/task_store.rs:539 (and lines 544, 551, 557, 562, 569, 573, 580, 586, 591) still hardcodes the atm-dev production team literal that this same fix pass removed everywhere else (escalation_admin.rs uses TEST_RECIPIENT, commands/escalation.rs uses TEST_TEAM/TEST_RECIPIENT). The sibling concurrent-add test directly below it already uses the safe @ax6-test pattern. Fix: apply the same test-local non-production constant in this test. Blocking per the zero-tolerance RULE-008 policy; a pre-existing-pattern match is context, not justification." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "arch-qa" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T20:02:30Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Closure confirmed by quality-mgr AX.6 QA-4 recheck (QA-AX6-R4-1788638300) at head ba19d6236; fixed by arch-ctm fix pass GO-AX6-FIX3-1788637962 (Completion c23). Report: PR #1204 comment 5554428957. Sprint verdict remains FAIL on new finding AX6-QA4-001." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T19:48:33Z"^^xsd:dateTime ;
