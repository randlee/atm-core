<urn:atm:triage:finding/AX5-QA1-007>
  a triage:Finding ;
  triage:findingId "AX5-QA1-007" ;
  triage:title "remind_open_tasks reads the task store for every candidate before the HERDR_MAX_PROMPTS_PER_TICK budget check; per-tick DB cost is O(candidates) with Burst missed-tick behaviour" ;
  triage:description "AX.5 QA-1 (quality-mgr ax5-qa-r1, PR #1201 Final Quality Report 2026-09-05T12:38Z) at head da823baaa0018933f8daac388733c51eb14e9335. rust-service-hardening-agent RSH-003: remind_open_tasks (crates/atm-http-runtime/src/herdr_queue_wake.rs:365) performs a task-store read per candidate; the budget check lives inside emit_task_reminder (crates/atm-http-runtime/src/herdr_queue_wake.rs:448) and is reached only after the read. Per-tick DB read cost is therefore O(candidates) not O(budget); combined with tokio::time::interval's default MissedTickBehavior::Burst, a large due-candidate set risks sustained back-to-back tick overruns with no escape valve. Fix: check the remaining budget before issuing each read (stop reading once the budget is exhausted) and/or set MissedTickBehavior::Skip/Delay on the interval; add a test asserting reads stop at the budget." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T15:11:27Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Closure confirmed by quality-mgr follow-up QA; Resolution event triage:r42 in .sprints/AX/events.ttl; final sprint verdict AX5-QA4 PASS (PR #1201 comment 5552870450)." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T12:42:34Z"^^xsd:dateTime ;
  triage:foundIn triage:AX5 ;
  triage:foundAt "2026-09-05T12:38:08Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AX5-QA1-007/ax5-1> ;
  triage:triageRecordVersion "1" .

