<urn:atm:triage:finding/AX6-QA1-001>
  a triage:Finding ;
  triage:findingId "AX6-QA1-001" ;
  triage:title "notify() forwards the escalation message body into Herdr notification argv, violating HR-SAFE-003" ;
  triage:description "AX.6 QA-1 (quality-mgr QA-AX6-R1-1788626395, PR #1204 Final Quality Report 2026-09-05T16:56Z) at head 490a6c42a0f3283c251875d9a61fcf99b641c2a2. CRITICAL (recorded at blocking severity; reviewer-native critical). crates/atm-http-runtime/src/herdr_escalation.rs:236 notify() splits the escalation message body (the same string queued as mail via SendMessageSource::Inline) on the first newline and forwards both halves into Herdr's `notification show --body` argv. HR-SAFE-003 says the sender's original message body is never passed to Herdr on any code path. No ADR amendment or boundary-toml note reconciles a new exception, and fenix grants none: the fix is to stop forwarding the body — the Herdr notification must be built from a fixed template (task id, member, reason/kind) that never shares a source binding with the mail body. Sweep the workspace for any other adapter site that passes a mail body into a Herdr argv." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "ruthless-boundary-qa" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T16:58:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AX6 ;
  triage:foundAt "2026-09-05T16:56:30Z"^^xsd:dateTime ;
