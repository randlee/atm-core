<urn:atm:triage:finding/AX3-010>
  a triage:Finding ;
  triage:findingId "AX3-010" ;
  triage:title "D10 Pydantic-supersession grep gate fails: a third Pydantic mention remains at docs/architecture.md:165" ;
  triage:description "D10's gate says grep -n Pydantic over the docs returns only lines inside the two superseded Phase-AC notes. At 88c579a18 docs/architecture.md:165 (inside the pre-existing, unrelated section 1.2 Phase-AA simplification note, untouched by the AX.3 diff) is a third mention, so the gate fails on a strict reading even though the amendment text at the two named locations (docs/requirements.md and docs/architecture.md:2872-2890) is complete. Fix: either extend the amendment to cover that note or tighten D10's gate wording to the two named blocks." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
