<urn:atm:triage:finding/AX6-QA1-010>
  a triage:Finding ;
  triage:findingId "AX6-QA1-010" ;
  triage:title "blocked_since/last_blocked_notice pruned against transient per-tick task_candidates; a transient list() failure resets the blocked clock" ;
  triage:description "AX.6 QA-1 (quality-mgr QA-AX6-R1-1788626395, PR #1204 Final Quality Report 2026-09-05T16:56Z) at head 490a6c42a0f3283c251875d9a61fcf99b641c2a2. crates/atm-http-runtime/src/herdr_queue_wake_escalation.rs:1-58 prunes the blocked_since and last_blocked_notice maps against the per-tick task_candidates set; a single transient list() failure drops the whole set and the following `.or_insert(now)` resets the blocked-duration clock, so a member can be starved of escalation indefinitely under intermittent store errors. Fix: only prune on a successful, complete list; keep existing timers across failed ticks." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-service-hardening-agent" ;
  triage:severity "important" ;
  triage:repeatable false ;
