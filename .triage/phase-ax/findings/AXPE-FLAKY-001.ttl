<urn:atm:triage:finding/AXPE-FLAKY-001>
  a triage:Finding ;
  triage:findingId "AXPE-FLAKY-001" ;
  triage:title "Reserve-then-drop ephemeral TCP port used as a guaranteed-refused graft endpoint" ;
  triage:description "failed_queue_graft_handoff_retains_marker_at_attempt_zero (:1351) and sweep_dispatched_queue_graft_failure_reports_for_caller_requeue (:1417) bind 127.0.0.1:0, read the port, drop the listener, and register the closed port as the unavailable graft receiver expecting an immediate PostSendGraftUnavailable. Concurrent #[tokio::test] cases in the same binary bind ephemeral listeners and can reclaim the port before the connect, flipping the assertion. Remediation: inject the failure at the client layer (fake/stub emitter returning PostSendGraftUnavailable) or hold a listener the test owns for its lifetime; never synthesize unavailability from a released port." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "phase_end_review" ;
  triage:category "flaky-test-qa" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "phase" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T00:20:56Z"^^xsd:dateTime ;
  triage:foundIn triage:AX6 ;
  triage:foundAt "2026-09-06T00:20:56Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AXPE-FLAKY-001/INTEGRATE-1> ;
  triage:triageRecordVersion "1" .

