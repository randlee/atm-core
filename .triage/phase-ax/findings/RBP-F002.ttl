<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "InternalNudgeInput::from_env discards the env-var and serde_json error causes" ;
  triage:description "crates/atm/src/commands/internal_nudge.rs line 68: InternalNudgeInput::from_env maps the std::env::var error with |_| and the serde_json::from_str error with |_source| into a validation error, discarding the underlying causes instead of attaching them as the error source. Minor idiom note, no correctness impact. Reported by rust-best-practices-agent on PR #1185 QA-1 (commit 1452df008); exact location supplied by quality-mgr. Note: lines predate AX.1 (commit 30d3814e83, 2026-07-08)." ;
  triage:phaseId "phase-ax" ;
