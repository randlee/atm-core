<urn:atm:triage:finding/AX4-QA3-001>
  a triage:Finding ;
  triage:findingId "AX4-QA3-001" ;
  triage:title "Sprint AX.4 doc frontmatter is invalid YAML: the rationale key at line 21 was re-indented from 4 to 2 spaces, breaking nesting under the '- prerequisite: AX.1' list item" ;
  triage:description "AX.4 QA-3 (quality-mgr ax4-qa-r3, PR #1194 Final Quality Report 2026-09-05T10:59Z; filed independently by req-qa, arch-qa and rust-qa-agent, confirmed by quality-mgr) at head 349b694a98bbffe5bc5d720384625d69199846c8. The AX4-QA2-004 fix commit e1f76e5bf corrected the citation text on docs/plans/phase-ax/sprint-AX.4-task-cli-and-docs.md:21 (section 6.6 -> 7.3/7.12) but the same edit changed the indentation of the 'rationale:' key from 4 spaces to 2, so it no longer nests under the '- prerequisite: AX.1' list item in the parallel_safe block; rust-qa-agent ran yaml.safe_load() on the frontmatter and got a parse error at lines 20-21, so this is genuinely invalid YAML, not a style nit. AX4-QA2-004 therefore stays open (its citation residual is fixed but the line is still defective). Fix: re-indent line 21 to 4 spaces so it sits under the list item, and verify the frontmatter parses with yaml.safe_load." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
