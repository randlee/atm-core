  triage:hasOccurrence <urn:atm:triage:occurrence/AX4-QA-012/AX4-2-with-task-complete-opt> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AX4-QA-012/AX4-3-render-tasks> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AX4-QA-012/AX4-4-render-task-events> ;
  triage:triageRecordVersion "1" .

