<urn:atm:triage:finding/AX4-QA-012>
  a triage:Finding ;
  triage:findingId "AX4-QA-012" ;
  triage:title "Small duplication and dead error paths: with_task_complete / with_task_complete_opt near-identical setters in send/mod.rs; render_tasks / render_task_events return Result with no fallible operation" ;
  triage:description "AX.4 QA-1 (quality-mgr ax4-qa-r1, PR #1194 Final Quality Report 2026-09-05T09:14Z; ruthless-boundary-qa RBQA-F004 and rust-best-practices-agent RBP-F002 bundled) at head aaf2e04bf. (1) crates/atm-core/src/send/mod.rs defines with_task_complete and with_task_complete_opt as two near-identical setters that should collapse to one. (2) crates/atm/src/commands/task_ledger.rs render_tasks and render_task_events are declared -> Result<String> though their bodies contain no fallible operation, leaving a dead error path. Fix: collapse the setters; make the renderers return String." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T10:25:28Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Closure confirmed by quality-mgr follow-up QA; Resolution event triage:r30 in .sprints/AX/events.ttl; final sprint verdict AX4-QA4 PASS (PR #1194 comment 5551411069)." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T09:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AX4 ;
  triage:foundAt "2026-09-05T09:14:12Z"^^xsd:dateTime ;
