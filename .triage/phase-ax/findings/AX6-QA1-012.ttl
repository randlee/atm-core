<urn:atm:triage:finding/AX6-QA1-012>
  a triage:Finding ;
  triage:findingId "AX6-QA1-012" ;
  triage:title "Doctor escalation/task/roster projection swallows store failures via .ok()/unwrap_or_default()" ;
  triage:description "AX.6 QA-1 (quality-mgr QA-AX6-R1-1788626395, PR #1204 Final Quality Report 2026-09-05T16:56Z) at head 490a6c42a0f3283c251875d9a61fcf99b641c2a2. crates/atm-core/src/doctor/mod.rs:573-624 projects escalation recipients, tasks and roster with `.ok()...unwrap_or_default()` instead of the DoctorFinding / inspect_doctor_section pattern used by sibling sections, so a store failure is indistinguishable from nothing configured. Repeatable pattern within the file. Fix: surface store failures as doctor findings like the sibling sections." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-best-practices-agent" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
