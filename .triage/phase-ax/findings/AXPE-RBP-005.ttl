<urn:atm:triage:finding/AXPE-RBP-005>
  a triage:Finding ;
  triage:findingId "AXPE-RBP-005" ;
  triage:title "write_escalation_mail discards error structure re-parsing DAEMON_ACTOR_NAME on every call" ;
  triage:description "crates/atm-http-runtime/src/herdr_escalation.rs:398, inside write_escalation_mail, calls atm_core::boundary::DAEMON_ACTOR_NAME.parse() and maps any parse failure through AtmError::validation(format!(\"invalid daemon actor name: {error}\")). DAEMON_ACTOR_NAME is a hardcoded constant, so this fallible re-parse happens on every escalation mail write for a value that can never actually fail at runtime, and the format! discards the original error's structure (type/fields) rather than preserving it. Remediation: parse the constant once (e.g. a lazily-initialized static, or a debug_assert/const-eval-time check) instead of re-parsing per call, and preserve the underlying error via AtmError::validation_source or equivalent structured wrapping instead of format!-flattening it -- no behavior change intended, since the value never actually fails to parse." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "ci_gate" ;
  triage:category "rust-best-practices-agent" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:closedAt "2026-09-06T20:28:23Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "QA-AX-1260-FINAL-RECHECK2 PASS 0/0/0 on PR #1260 (f5c1a577d), reconfirmed herdr_escalation.rs LazyLock DAEMON_ACTOR, no per-call fallible parse. Report: https://github.com/randlee/atm-core/pull/1260#issuecomment-5561957376" ;
  triage:triagedAt "2026-09-06T19:49:16Z"^^xsd:dateTime ;
