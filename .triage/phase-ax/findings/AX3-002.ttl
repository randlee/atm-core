<urn:atm:triage:finding/AX3-002>
  a triage:Finding ;
  triage:findingId "AX3-002" ;
  triage:title "Workspace test build fails: three test struct literals miss the new task_complete field (E0063)" ;
  triage:description "cargo test --workspace --exclude atm-daemon fails to compile at 88c579a18 (cargo build is clean): crates/atm-runtime/src/mailbox_runtime.rs:803 (MessageEnvelope in test helper message()), crates/atm-http-runtime/src/client.rs:1447 and crates/atm-http-runtime/src/message_handler.rs:996 (SendOutcome in test helper sent_response()). D4 added task_complete to MessageEnvelope and SendOutcome without propagating it to these three of 25 construction sites. Found by quality-mgr directly on PR #1191 QA-1. A background CI-fix agent is adding the field at the three sites; QA-2 must re-verify cargo test compiles." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
