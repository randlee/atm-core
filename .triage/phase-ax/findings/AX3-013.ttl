  a triage:Finding ;
  triage:findingId "AX3-013" ;
  triage:title "admit()/transition() rejection message omits the task id required by the spec" ;
  triage:description "The sprint spec requires the rejection text \"no open task <id> for <actor>\"; at 88c579a18 both pure functions in crates/atm-storage/src/task_state.rs emit \"no open task for {actor}\" without the id, while the (currently dead, see AX3-001) writer path formats it correctly. Latent until AX3-001 wires the pure functions in, then a user-facing message mismatch. Found by rust-qa-agent QA-010 on PR #1191 QA-1." ;
