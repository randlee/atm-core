<urn:atm:triage:finding/AX6-QA3-002>
  a triage:Finding ;
  triage:findingId "AX6-QA3-002" ;
  triage:title "RULE-011: peer_mutations_reject_missing_yes_before_touching_durable_configuration in crates/atm/tests/peer_cli.rs spawns the atm subprocess without isolated ATM_HOME/ATM_CONFIG_HOME" ;
  triage:description "The test peer_mutations_reject_missing_yes_before_touching_durable_configuration at crates/atm/tests/peer_cli.rs:66 spawns the atm subprocess with only ATM_LOG_DIR set and no ATM_HOME or ATM_CONFIG_HOME, unlike the sibling escalation_cli.rs test fixed in this sprint. It is currently masked by an early --yes guard that rejects before any config read, but it is not isolated per docs/cross-platform-guidelines.md section Test Subprocess Isolation. Similar isolation gaps exist in compose_passthrough.rs:35 and as a regression in AX7 escalation_cli.rs:7." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "arch-qa" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T20:02:30Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Closure confirmed by quality-mgr AX.6 QA-4 recheck (QA-AX6-R4-1788638300) at head ba19d6236; fixed by arch-ctm fix pass GO-AX6-FIX3-1788637962 (Completion c23). Report: PR #1204 comment 5554428957. Sprint verdict remains FAIL on new finding AX6-QA4-001." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T19:50:00Z"^^xsd:dateTime ;
