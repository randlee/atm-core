  a triage:Finding ;
  triage:findingId "AX5-QA1-014" ;
  triage:title "Several warn! sites in herdr_queue_wake.rs, including the Property-8 task-store-unavailable transition warn, omit the subsystem/action/outcome structured fields" ;
  triage:description "AX.5 QA-1 (quality-mgr ax5-qa-r1, PR #1201 Final Quality Report 2026-09-05T12:38Z) at head da823baaa0018933f8daac388733c51eb14e9335. rust-service-hardening-agent RSH-005: warn! call sites in crates/atm-http-runtime/src/herdr_queue_wake.rs (notably :576 task store unavailable, also :172/:186/:201/:419) omit the subsystem=/action=/outcome= structured fields that the daemon-logging convention follows. Fix: add the structured fields to each warn! in the reminder path." ;
