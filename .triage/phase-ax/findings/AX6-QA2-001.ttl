<urn:atm:triage:finding/AX6-QA2-001>
  a triage:Finding ;
  triage:findingId "AX6-QA2-001" ;
  triage:title "RULE-008: reserved production team literal atm-dev hardcoded in crates/atm/tests/escalation_cli.rs subprocess args and expected stdout" ;
  triage:description "AX.6 QA-2 (quality-mgr QA-AX6-R2-1788630712, PR #1204 report 2026-09-05T19:01Z, arch-qa ARCH-001) at head c3268df8a3dfa5c84f4465459c5d2ba86df1c857. crates/atm/tests/escalation_cli.rs lines 28, 32, 39, 44, 52 hardcode the reserved production team literal atm-dev in subprocess arguments and in asserted stdout, with no TEST_TEAM-style constant and no documented production-compatibility justification, violating RULE-008. Fix: introduce a test-local TEST_TEAM constant (non-production team name) and use it in every argument and assertion." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "arch-qa" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T19:45:51Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Closure confirmed by quality-mgr AX.6 QA-3 recheck (QA-AX6-R3-1788637011) at head 43e1d40b33357024dea87742b4f8a114e7fd4966; fixed by arch-ctm fix pass GO-AX6-FIX2-1788635243 (Completion c22). Report: PR #1204 comment 5554337367. Sprint verdict remains FAIL on AX6-QA3-001/002." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T19:05:00Z"^^xsd:dateTime ;
