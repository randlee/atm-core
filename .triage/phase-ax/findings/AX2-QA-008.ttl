<urn:atm:triage:finding/AX2-QA-008>
  a triage:Finding ;
  triage:findingId "AX2-QA-008" ;
  triage:title "run_command_with_binary drains the Herdr child's stdout/stderr with unbounded read_to_end" ;
  triage:description "crates/atm-herdr/src/lib.rs ~616-627 run_command_with_binary reads a spawned herdr child's pipes to completion with no size cap, so a verbose or misbehaving herdr CLI is buffered fully into memory. Fix: apply an explicit byte cap when draining stdout/stderr (take(N) or equivalent) and surface truncation. Reported by rust-service-hardening-agent RSH-003 (minor) on PR #1186 QA-1 (head 4f77d2fff). In your notes, state whether this code predates the AX.2 diff (compare git show origin/feature/ax1-queue-template-class:crates/atm-herdr/src/lib.rs) so the orchestrator can judge scope." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
