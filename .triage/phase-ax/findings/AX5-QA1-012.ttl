  a triage:Finding ;
  triage:findingId "AX5-QA1-012" ;
  triage:title """delivery_channel.rs test_backend_type_metadata lost its cfg(any(test, feature = "test-utils")) gate and is now compiled into the atm-core production build""" ;
  triage:description """AX.5 QA-1 (quality-mgr ax5-qa-r1, PR #1201 Final Quality Report 2026-09-05T12:38Z) at head da823baaa0018933f8daac388733c51eb14e9335. rust-qa-agent: crates/atm-core/src/delivery_channel.rs:137-139 replaced the #[cfg(any(test, feature = "test-utils"))] gate on test_backend_type_metadata with #[doc(hidden)] only, so a test-only helper is now unconditionally compiled into atm-core's production build and permanently widens its public API surface. Fix: restore the cfg gate (and enable the test-utils feature for the consuming dev-dependency instead), or move the helper into a test-support crate.""" ;
  triage:phaseId "phase-ax" ;
