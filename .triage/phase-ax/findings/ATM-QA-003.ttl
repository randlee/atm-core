<urn:atm:triage:finding/ATM-QA-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-003" ;
  triage:title "Missing CLI-level test: retired nudge kind rejected with exit 3 and a use-task hint" ;
  triage:description "Sprint AX.1 AC1 requires atm teams set-nudge-template <team> delivery_task_ack --file x.xml to exit 3 with a hint to use the task kind. No test under crates/atm/** or in team_admin.rs exercises a retired kind through the CLI/team_admin layer with that hint text; only a generic not-a-kind rejection exists there. The retirement error and hint are proven only at the contract.rs FromStr layer; propagation through team_admin.rs and the CLI exit-code mapping is unproven end-to-end. Reported by req-qa on PR #1185 QA-1 (commit 1452df008)." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
