<urn:atm:triage:finding/AX6-QA1-020>
  a triage:Finding ;
  triage:findingId "AX6-QA1-020" ;
  triage:title "add_escalation_recipient has no write-time cap" ;
  triage:description "AX.6 QA-1 (quality-mgr QA-AX6-R1-1788626395, PR #1204 Final Quality Report 2026-09-05T16:56Z) at head 490a6c42a0f3283c251875d9a61fcf99b641c2a2. crates/atm-storage-rusqlite/src/task_store.rs:380-399 add_escalation_recipient enforces no write-time cap; only reads truncate to ESCALATION_RECIPIENT_CAP=8, so the store can grow unbounded and silently drop recipients on read. Fix: enforce the cap at write time with a clear error." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
