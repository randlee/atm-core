<urn:atm:triage:finding/AX3-001>
  a triage:Finding ;
  triage:findingId "AX3-001" ;
  triage:title "Pure transition()/admit() task state machine is never called by production code; writer/ops.rs reimplements the table in raw SQL string comparisons" ;
  triage:description "crates/atm-storage-rusqlite/src/writer/ops.rs apply_task_assignment (~705), apply_task_completion (~797) and apply_task_acknowledgement (~857) never import or call atm_storage::task_state::{transition, admit}; workspace-wide, those functions are called only from task_state.rs unit tests. The writer reimplements the 12-cell transition table and G1/G2 guards with string literals (assigned/active/complete), including a transcription-drift residue: let next = if state == \"assigned\" { \"active\" } else { \"active\" }. The sprint's tested pure state machine therefore guarantees nothing about production behaviour. Fix: the three apply_task_* functions load the TaskRow, call transition/admit, and persist only the resulting Transition/TaskRejected; delete the SQL-literal reimplementation. Found independently by rust-best-practices-agent RBP-F001, arch-qa ARCH-001, rust-qa-agent QA-002, ruthless-boundary-qa RBQA-F001, req-qa ATM-QA-001 on PR #1191 QA-1 (commit 88c579a18)." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T12:10:20Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Blocking finding closed by a later valid Completion and quality-mgr follow-up QA; final sprint verdict AX3-QA7 PASS 0/0/0 (PR #1191 comment 5551705615)." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T06:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AX3 ;
  triage:foundAt "2026-09-05T06:06:41Z"^^xsd:dateTime ;
