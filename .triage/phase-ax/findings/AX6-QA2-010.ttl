<urn:atm:triage:finding/AX6-QA2-010>
  a triage:Finding ;
  triage:findingId "AX6-QA2-010" ;
  triage:title "TOCTOU in add_escalation_recipient: duplicate/cap check runs under with_connection instead of with_transaction, so concurrent callers can exceed the 8-recipient cap" ;
  triage:description "AX.6 QA-2 (quality-mgr QA-AX6-R2-1788630712, PR #1204 report 2026-09-05T19:01Z, rust-qa-agent QA-2-002) at head c3268df8a3dfa5c84f4465459c5d2ba86df1c857. crates/atm-storage-rusqlite/src/task_store.rs:380-416 add_escalation_recipient performs its duplicate and cap check inside with_connection; the control-path pool hands out up to 8 connections, so two concurrent callers can each observe count < 8 before either inserts. Sibling check-then-mutate writers in the same file (record_reminder, record_lead_notified) already use with_transaction. Fix: move the check and insert into one with_transaction and add a test that proves the cap holds under two interleaved adds." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-qa" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T19:45:51Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Closure confirmed by quality-mgr AX.6 QA-3 recheck (QA-AX6-R3-1788637011) at head 43e1d40b33357024dea87742b4f8a114e7fd4966; fixed by arch-ctm fix pass GO-AX6-FIX2-1788635243 (Completion c22). Report: PR #1204 comment 5554337367. Sprint verdict remains FAIL on AX6-QA3-001/002." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T19:05:00Z"^^xsd:dateTime ;
