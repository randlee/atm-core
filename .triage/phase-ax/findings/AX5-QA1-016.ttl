<urn:atm:triage:finding/AX5-QA1-016>
  a triage:Finding ;
  triage:findingId "AX5-QA1-016" ;
  triage:title "build_task_reminder_dispatch Err is discarded before marking a reminder Unrenderable, making the failure cause unobservable" ;
  triage:description "AX.5 QA-1 (quality-mgr ax5-qa-r1, PR #1201 Final Quality Report 2026-09-05T12:38Z) at head da823baaa0018933f8daac388733c51eb14e9335. rust-best-practices-agent RBP-F002: in emit_task_reminder the build_task_reminder_dispatch result (crates/atm-http-runtime/src/herdr_queue_wake.rs:455) is matched and its Err payload dropped before the reminder is marked Unrenderable, so recipient-snapshot resolution vs message-reload vs host-auth failures are indistinguishable in logs. Fix: log the error (structured) before mapping to Unrenderable." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
