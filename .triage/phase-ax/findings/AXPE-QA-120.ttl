<urn:atm:triage:finding/AXPE-QA-120>
  a triage:Finding ;
  triage:findingId "AXPE-QA-120" ;
  triage:title "Stale manifest_section_rules entry allows atm-storage as an atm-http-runtime dev-dependency after the allowlist removed it" ;
  triage:description "The Phase AW -> integrate/phase-ax merge reconciliation of .just/lint-config.toml narrowed the atm-http-runtime manifest_dependency_allowlists entry to exclude atm-storage (matching Phase AX, which removed the dependency from crates/atm-http-runtime/Cargo.toml entirely) but kept develop's paired manifest_section_rules block (lines 230-234 at db7f31cba) that still permits atm-storage in [dev-dependencies] as a 'test-only fixture dependency'. The two rules in one file contradict each other. The block is vacuous today (no atm-storage reference exists in the manifest, so lint_boundaries.py never evaluates it) but documents a policy the allowlist forbids and would silently sanction a reintroduction as a dev-dependency. The block does not exist on integrate/phase-ax 6e8f33ba5; it is leftover from the merge's own incomplete reconciliation, not develop debt. Remediation: delete the block so both rules reflect the tightened policy; python3 .just/lint_boundaries.py must still pass." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "qa_round" ;
  triage:category "arch-qa" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "phase" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T18:40:06Z"^^xsd:dateTime ;
  triage:foundIn triage:AX6 ;
  triage:foundAt "2026-09-06T18:36:56Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AXPE-QA-120/MERGE-AW-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/AXPE-QA-120/MERGE-AW-1>
  a triage:Occurrence ;
