<urn:atm:triage:finding/AX6-QA1-011>
  a triage:Finding ;
  triage:findingId "AX6-QA1-011" ;
  triage:title "escalate_blocked has no per-tick cap" ;
  triage:description "AX.6 QA-1 (quality-mgr QA-AX6-R1-1788626395, PR #1204 Final Quality Report 2026-09-05T16:56Z) at head 490a6c42a0f3283c251875d9a61fcf99b641c2a2. crates/atm-http-runtime/src/herdr_queue_wake_escalation.rs:138-156 escalate_blocked iterates every blocked member with no per-tick cap (unlike HERDR_MAX_PROMPTS_PER_TICK for prompts); a burst of blocked members stalls the 5s poll cadence by O(blocked_count x 5s). Fix: cap escalations per tick and carry the remainder to the next tick, on cadence." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-service-hardening-agent" ;
  triage:severity "important" ;
