<urn:atm:triage:finding/RSH-001>
  a triage:Finding ;
  triage:findingId "RSH-001" ;
  triage:title "migrate_template_override_kinds_to_seven runs under a Deferred transaction instead of the codebase's Immediate convention" ;
  triage:description "crates/atm-storage-rusqlite/src/shared_db.rs migrate_template_override_kinds_to_seven (~line 870) uses rusqlite's default TransactionBehavior::Deferred, deviating from the SharedDb::with_transaction convention of Immediate, which makes concurrent writers wait under busy_timeout instead of failing during deferred lock escalation on slower schedulers such as Windows CI. Should use Immediate for consistency with the rest of the migration/write path. Reported by rust-service-hardening-agent on PR #1185 QA-1 (commit 1452df008)." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
