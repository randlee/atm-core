<urn:atm:triage:finding/AX3-008>
  a triage:Finding ;
  triage:findingId "AX3-008" ;
  triage:title "TaskEventKind::Rejected audit path is never constructed; rejections return Err without writing an audit row" ;
  triage:description "The schema and enum surface for recording rejections exists (TaskEventKind::Rejected, TaskEventRow.detail) but at 88c579a18 no call site constructs it; every rejection returns Err directly, contradicting the sprint's Audit invariant that every rejection is one row written in the same transaction. Either wire the audit row or correct the doc claim. Found by arch-qa ARCH-003 and ruthless-boundary-qa RBQA-F005 on PR #1191 QA-1." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
