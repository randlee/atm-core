<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "finish_and_mark discards the Result of mark_pending_if_deferred on the sync path" ;
  triage:description "crates/atm-core/src/write/pipeline.rs finish_and_mark (line ~101) writes let _ = self.mark_pending_if_deferred(runtime); on the sync path, silently swallowing a marker-store failure instead of surfacing or logging it. Reported by rust-best-practices-agent on PR #1185 QA-1 (commit 1452df008). The line predates AX.1 (introduced in fix(aq2): close queue marker failure paths). Check whether the async counterpart handles the same Result." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
