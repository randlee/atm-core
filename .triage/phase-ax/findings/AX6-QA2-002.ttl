<urn:atm:triage:finding/AX6-QA2-002>
  a triage:Finding ;
  triage:findingId "AX6-QA2-002" ;
  triage:title "RULE-008: reserved production team literal atm-dev hardcoded in crates/atm-core/src/escalation_admin.rs unit test fixture and assertions" ;
  triage:description "AX.6 QA-2 (quality-mgr QA-AX6-R2-1788630712, PR #1204 report 2026-09-05T19:01Z, arch-qa ARCH-002) at head c3268df8a3dfa5c84f4465459c5d2ba86df1c857. crates/atm-core/src/escalation_admin.rs lines 96, 99, 101 hardcode the reserved production team literal atm-dev inside the in-process unit test fixture and its assertions, violating RULE-008 (no TEST_TEAM-style constant, no justification). Fix: use a test-local non-production team constant." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "arch-qa" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
