<urn:atm:triage:finding/AX4-QA-006>
  a triage:Finding ;
  triage:findingId "AX4-QA-006" ;
  triage:title "task_ledger.rs hand-duplicates enum-to-string mappings that serde rename_all already defines canonically in atm-storage" ;
  triage:description "AX.4 QA-1 (quality-mgr ax4-qa-r1, PR #1194 Final Quality Report 2026-09-05T09:14Z; found by ruthless-boundary-qa RBQA-F003) at head aaf2e04bf. crates/atm/src/commands/task_ledger.rs:75-124 task_state_name, task_event_name, task_actor_name, task_event_marker_name and reminder_outcome_name hand-write match arms reproducing the strings that TaskState, TaskEventKind, TaskEventMarker and ReminderOutcome already produce via #[serde(rename_all = snake_case)] at crates/atm-storage/src/task_state.rs:16-22,139-148 and task_store.rs:11-17. This creates a third independent owner of the same naming decision. Fix: expose a canonical Display or as_str() on the enums in atm-storage and have the human-table renderer call it." ;
  triage:phaseId "phase-ax" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-05T11:00:50Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Closure confirmed by quality-mgr follow-up QA; Resolution event triage:r33 in .sprints/AX/events.ttl; final sprint verdict AX4-QA4 PASS (PR #1194 comment 5551411069)." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-05T09:30:00Z"^^xsd:dateTime ;
