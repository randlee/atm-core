<urn:atm:triage:finding/SCHEMA-AY-R2-002>
  a triage:Finding ;
  triage:findingId "SCHEMA-AY-R2-002" ;
  triage:title "transport field missing from openapi.yaml doctor presence schema and the openapi surface baseline" ;
  triage:description "quality-mgr qa-phase-ay-gate-r2 (PR #1308 integrate/phase-ay -> develop, pinned 0da9a26ec; report: message 01M1Z4RKVAMC1J0GRB15K3D219, PR #1308 issuecomment 5576945237). Important. The doctor payload now carries transport (HerdrTransportKind) but docs/atm-http-runtime/openapi.yaml has no transport property and crates/atm/tests/openapi_surface_baseline.json has no transport entry (grep empty at 0da9a26ec). Required correction (quality-mgr): add transport to the openapi.yaml doctor presence schema (enum cli|socket, added in HTTP API 1.2.0) and bless the openapi surface baseline in the same PR so openapi_surface.rs additions-only check stays consistent. Ride the same fix PR as SCHEMA-AY-R2-001." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "docs" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "docs/atm-http-runtime/openapi.yaml, crates/atm/openapi.yaml, crates/atm/tests/openapi_surface_baseline.json, docs/atm-daemon/http-api.md" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-08T00:20:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-08T04:30:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed at phase-ay gate round 3 (PR #1318, integrate/phase-ay 75c01a5bd). Independently re-verified by quality-mgr via direct file/grep reads (not taken on cipher's commit message alone), cross-checked against schema-reviewer/rust-qa-agent live results. Both crates/atm/openapi.yaml and docs/atm-http-runtime/openapi.yaml (confirmed byte-identical) gained the transport field on HerdrEndpointDoctorReport; openapi_surface_baseline.json updated; openapi_surface_is_additions_only test passes 4/4." ;
  triage:foundIn triage:AY3 ;
  triage:foundAt "2026-09-08T00:05:00Z"^^xsd:dateTime ;
