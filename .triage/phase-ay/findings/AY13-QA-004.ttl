<urn:atm:triage:finding/AY13-QA-004>
  a triage:Finding ;
  triage:findingId "AY13-QA-004" ;
  triage:title "rust-service-hardening RSH-001: doctor_projection.rs per-team Herdr loop discards the entire partial DoctorReport on mid-loop deadline expiry" ;
  triage:description "quality-mgr qa-pr1300-r1 (PR #1300, AY.13 doctor team scope). StorageDoctorProjection::project builds rosters = member_roster.chain(team_rosters) and loops `for roster in rosters { self.append_herdr_report(&mut report, &roster, team_context, deadline).await?; }`. append_herdr_report's `deadline.remaining().ok_or_else(...)?` guard at its top means a deadline expiring after some teams have already been processed propagates a hard Err via the loop's `.await?`, discarding the entire partial DoctorReport built so far -- inconsistent with the sibling per-observation timeout path a few lines below in the same function, which degrades gracefully by pushing a doctor finding and preserving the already-collected report instead of erroring out. Under --all-teams with many teams in scope, one slow/unresponsive team's Herdr endpoint can cause every other already-successfully-probed team's roster/presence data to be silently lost from the response." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-runtime/src/doctor_projection.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T17:40:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AY13 ;
  triage:foundAt "2026-09-07T17:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AY13-QA-004/1> ;
  triage:triageRecordVersion "1" .

