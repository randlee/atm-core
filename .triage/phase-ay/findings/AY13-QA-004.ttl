  triage:hasResolution <urn:atm:triage:resolution/AY13-QA-004/1> ;
  triage:closedAt "2026-09-07T18:05:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "2" .

