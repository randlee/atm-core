<urn:atm:triage:finding/AY2-QA-006>
  a triage:Finding ;
  triage:findingId "AY2-QA-006" ;
  triage:title "fake-herdr test binary not gated behind test-utils feature" ;
  triage:description "The [[bin]] name = fake-herdr entry in crates/atm-herdr/Cargo.toml has test = false, bench = false but lacks required-features = [test-utils]. This causes the test utility binary to be compiled in ordinary cargo build/release builds, unlike the crate's existing #[cfg(feature = test-utils)] testing modules. Must add required-features gating and enable the feature in dev-dependencies or test-harness configuration." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "build-hygiene" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-herdr/Cargo.toml" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T23:10:00Z"^^xsd:dateTime ;
