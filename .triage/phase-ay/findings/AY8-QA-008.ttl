  triage:hasOccurrence <urn:atm:triage:occurrence/AY8-QA-008/ay8-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AY8-QA-008/ay8-3> ;
  triage:hasResolution <urn:atm:triage:resolution/AY8-QA-008/1> ;
  triage:closedAt "2026-09-07T07:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "1" .

