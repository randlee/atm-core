<urn:atm:triage:finding/RBQA-AY1-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AY1-F001" ;
  triage:title "atm-herdr docs contradict each other on HerdrProcessAdapter::notify" ;
  triage:description "quality-mgr qa-pr1270-r1 (PR #1270, reviewed at d2fdd8b9a; important, non-blocking for AY.1's narrow scope; ruthless-boundary-qa, re-verified): docs/atm-herdr/requirements.md lines ~151-155 (HR-CORE-010) define HerdrProcessAdapter::notify as a trait method, while docs/atm-herdr/architecture.md lines ~185-222 normative section 4 trait sketch and requirements.md's own S6 anchor both state the trait has exactly prompt/wait/get/list. The code on integrate/phase-ay (crates/atm-herdr/src/lib.rs) does carry notify (Phase AX.2). Resolve by reconciling the trait sketch and S6 anchor with HR-CORE-010 and the shipped trait; docs only. Note the AY.2 branch (feature/ay2-herdr-transport-seam) also touches docs/atm-herdr and boundaries/atm-herdr, so check whether it already reconciles this before promoting. Full report: https://github.com/randlee/atm-core/pull/1270#issuecomment-5562672298" ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "docs/atm-herdr/*.md, docs/adr/ADR-058-herdr-local-steer-backend-contract.md, boundaries/atm-herdr/*.toml, crates/atm-herdr/src/lib.rs trait block" ;
  triage:status "open" ;
