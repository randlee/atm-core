<urn:atm:triage:finding/CIPHER-NAME-001>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-001" ;
  triage:title "roster-store transaction does not enforce effective-name uniqueness for canonical-only writes or existing duplicates" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. save_roster calls validate_database_wide_aliases, but that validator collects only explicit alias values and compares those values with raw canonical and alias fields. It never computes alias-or-canonical for every row, so a direct RosterStore write can create duplicate canonical effective names, a write can leave pre-existing duplicates in place, and concurrent or restore/import paths are not protected by the transaction. This covers matrix A-21, A-22, A-23, A-24, and A-27. The separate canonical-name-versus-existing-alias defect in A-06/A-07 is already recorded as AY14-QA-003 and is not duplicated here. The write transaction must validate the complete resulting roster against every other team before replacement." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/roster_store.rs; crates/atm-core/src/team_admin/member_mutation.rs; restore and daemon member-write callers" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-07T22:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed at phase-ay gate round 2 (PR #1308, integrate/phase-ay 0da9a26ec9f0493e5b2e6778ebf815efa8b78493). Independently re-verified by quality-mgr plus the round-2 reviewer set (req-qa, arch-qa, ruthless-boundary-qa) against live file:line evidence, not taken on a prior round's say-so." ;
  triage:foundIn triage:AY14 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-001/1> ;
  triage:triageRecordVersion "1" .

