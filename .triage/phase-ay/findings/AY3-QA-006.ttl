<urn:atm:triage:finding/AY3-QA-006>
  a triage:Finding ;
  triage:findingId "AY3-QA-006" ;
  triage:title "transport_cli.rs child.wait() io::Error discarded" ;
  triage:description "crates/atm-herdr/src/transport_cli.rs:134 discards the io::Error from child.wait() before mapping to HerdrError::ServerUnavailable (RBP-F002, rust-best-practices-agent). Same pattern family as AY3-QA-003 (spawn) and AY3-QA-007 (json parse)." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-06T20:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-07T22:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "quality-mgr overrides the prior 'fixed_partial / deferred to post-phase closeout' disposition with evidence at phase-ay gate round 2 (PR #1308, integrate/phase-ay 0da9a26ec9f0493e5b2e6778ebf815efa8b78493): ruthless-boundary-qa disputed fenix's carry-forward framing, citing crates/atm-herdr/src/transport_cli.rs as already fully fixed and merged (PR #1273, commits b8afa814f/c8bfb76e3/d02d621d/52321871b). quality-mgr independently re-verified by direct grep at this head: spawn_unavailable/server_unavailable (transport_cli.rs:191-218) set io_error_kind on both the spawn error path (line 141) and the child.wait() error path (lines 145, 260); decode_envelope (lines 331-337) maps JSON parse failure to HerdrError::ProtocolMismatch instead of discarding it; regression tests spawn_not_found_preserves_io_error_kind, spawn_permission_denied_preserves_io_error_kind, decode_envelope_reports_protocol_mismatch_on_parse_failure (lines 361-395) all present and passing. The fix is complete on this branch, not merely partial; closing as fixed rather than fixed_partial." ;
  triage:foundIn triage:AY3 ;
  triage:foundAt "2026-09-07T03:42:00Z"^^xsd:dateTime ;
