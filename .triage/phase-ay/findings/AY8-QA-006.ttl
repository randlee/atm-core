<urn:atm:triage:finding/AY8-QA-006>
  a triage:Finding ;
  triage:findingId "AY8-QA-006" ;
  triage:title "Unnecessary pub(crate) field widening on HerdrClientConfig.binary_path and socket_path" ;
  triage:description "crates/atm-herdr/src/transport.rs:21-22 widens binary_path and socket_path from private to pub(crate) solely so transport_socket.rs test module could build struct literals. Accessor methods already exist and are the only access pattern used elsewhere in production code. A test-only constructor helper would have avoided the widening. Minor hygiene violation; recommend struct literal building via accessor pattern or dedicated test constructor." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "hygiene" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
