<urn:atm:triage:finding/AY8-QA-005>
  a triage:Finding ;
  triage:findingId "AY8-QA-005" ;
  triage:title "D10 construction-site pin is gameable (string-match on 'HerdrIo::Socket(') and scope-incomplete" ;
  triage:description "crates/atm-herdr/tests/socket_construction_pin.rs enforces confinement via literal substring match on 'HerdrIo::Socket('. This misses: (1) type alias construction (use ... as H; H::Socket(...)), (2) tuple-variant-as-fn-pointer (let ctor = HerdrIo::Socket; ctor(socket)), (3) file-splitting logic only honors first #[cfg(test)], exempting all subsequent production code; (4) only scans crates/atm-herdr/src/**, not the tests/ half of the allowlist. D10 acceptance criterion violated; construction-site guard is not mechanical." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture-pin" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
