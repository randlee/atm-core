<urn:atm:triage:finding/AY13-QA-005>
  a triage:Finding ;
  triage:findingId "AY13-QA-005" ;
  triage:title "rust-best-practices RBP-F001: doctor_projection.rs control-lane errors carry no recovery guidance, unlike the doctor subsystem's DoctorFinding.remediation convention" ;
  triage:description "quality-mgr qa-pr1300-r1 (PR #1300, AY.13 doctor team scope). StorageDoctorProjection::start and ::project construct AtmError values (AtmError::validation, AtmError::daemon_unavailable, AtmError::daemon_connection_saturated) for every control-lane failure mode (zero worker/queue config, projection started outside a Tokio runtime, admission-deadline expiry, queue saturation, closed channel, response-deadline expiry, worker-lane stop) using only a bare message string and no remediation/recovery guidance. Every other error surface in this same doctor subsystem (crates/atm-core/src/doctor/mod.rs, ax6.rs, and doctor_projection.rs's own Herdr-timeout DoctorFinding at line 213) consistently attaches a remediation string. The control-lane errors returned directly from project/start have no comparable actionable next step surfaced to the CLI/HTTP adapter caller." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-runtime/src/doctor_projection.rs" ;
  triage:status "fixed" ;
