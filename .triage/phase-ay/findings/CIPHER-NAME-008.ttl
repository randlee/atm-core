<urn:atm:triage:finding/CIPHER-NAME-008>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-008" ;
  triage:title "atm doctor does not report pre-existing duplicate effective names for the caller team" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. REQ-ROSTER-NAME-009 and matrix F-07 require opening a database containing legacy duplicate effective names to remain successful while atm doctor reports every conflicting team/member pair and the alias remedy for the caller's team. run_doctor_with_runtime and run_doctor_with_runtime_ports load scoped rosters and assemble findings, but no code computes effective names or appends duplicate-name findings. A legacy duplicate therefore remains silent until a later write, contrary to the upgrade diagnostic requirement." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/doctor/mod.rs; crates/atm-runtime/src/doctor_projection.rs; roster diagnostics" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AY14 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-008/1> ;
  triage:triageRecordVersion "1" .

