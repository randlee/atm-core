<urn:atm:triage:finding/CIPHER-NAME-005>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-005" ;
  triage:title "bare roster aliases resolve only within the caller or addressed team instead of database-wide" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. REQ-ROSTER-NAME-007 and matrix D-03 require a bare alias to resolve database-wide to its owning team when sent from another team. resolve_roster_alias receives one team roster and filters both canonical and alias matches by that team; write preparation then loads the recipient roster using the unresolved implicit caller team. A unique alias owned by another team therefore remains an AgentName in the caller team and fails or routes incorrectly instead of replacing the recipient team and canonical member at daemon ingress." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/caller_context.rs; crates/atm-core/src/send/write_context.rs; mailbox and read ingress callers" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-07T22:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed at phase-ay gate round 2 (PR #1308, integrate/phase-ay 0da9a26ec9f0493e5b2e6778ebf815efa8b78493). Independently re-verified by quality-mgr plus the round-2 reviewer set (req-qa, arch-qa, ruthless-boundary-qa) against live file:line evidence, not taken on a prior round's say-so." ;
  triage:foundIn triage:AY14 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-005/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-005/2> ;
  triage:triageRecordVersion "1" .

