<urn:atm:triage:finding/AY3-QA-001>
  a triage:Finding ;
  triage:findingId "AY3-QA-001" ;
  triage:title "Windows CI test fails: herdr_config test hardcodes Unix-only absolute paths" ;
  triage:description "crates/atm-daemon-bootstrap/src/herdr_config.rs:79-97 test reads_valid_absolute_paths_once_from_home_config uses /opt/homebrew/bin/herdr and /tmp/herdr.sock literals; Path::is_absolute() is false on Windows so HerdrClientConfig::try_new (crates/atm-herdr/src/transport.rs:35) rejects and the test panics at herdr_config.rs:88." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
