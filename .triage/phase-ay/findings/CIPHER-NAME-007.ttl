<urn:atm:triage:finding/CIPHER-NAME-007>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-007" ;
  triage:title "Herdr doctor presence output omits the effective Herdr agent name" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. REQ-ROSTER-NAME-006 requires logs and doctor output to show both member = team/agent and herdr_agent = effective name. HerdrRosterMember carries both values and doctor_probe sends Get using herdr_agent, but HerdrMemberPresence serializes only the canonical name and outcome. The resulting doctor JSON and rendered output cannot identify which aliased Herdr agent was probed, so matrix C-05 is not satisfied by the current implementation." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/doctor/herdr_state.rs; crates/atm-herdr/src/doctor_probe.rs; doctor output rendering" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AY3 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
