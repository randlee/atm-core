  triage:hasResolution <urn:atm:triage:resolution/AY2-QA-005/2> ;
  triage:closedAt "2026-09-06T23:55:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "1" .

