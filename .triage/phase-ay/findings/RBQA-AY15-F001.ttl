<urn:atm:triage:finding/RBQA-AY15-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AY15-F001" ;
  triage:title "Database-wide unique_name collision-check algorithm is implemented three times: roster_store.rs enforce_roster_unique_names, member_mutation.rs preflight_roster_unique_names, and doctor/mod.rs push_duplicate_effective_name_warnings" ;
  triage:description "quality-mgr qa-pr1310-r7 (head 10bc123f8; issuecomment 5575994618) ruthless-boundary-qa RBQA-AY15-F001 and arch-qa ARCH-004; scope expanded at qa-pr1310-r8 (head 715ab21ea; issuecomment 5576239134), confirmed by req-qa, arch-qa and ruthless-boundary-qa. The sort-and-scan collision detection over COALESCE(alias, agent_name) exists three times: crates/atm-storage-rusqlite/src/roster_store.rs:245-315 enforce_roster_unique_names (authoritative, inside the save_roster write transaction), crates/atm-core/src/team_admin/member_mutation.rs:452-485 preflight_roster_unique_names (identical loop), and crates/atm-core/src/doctor/mod.rs:935-983 push_duplicate_effective_name_warnings with effective_roster_name, which never touches RosterUniqueName or unique_names(). Three owners of one invariant drift independently. Correction (quality-mgr): extract the shared sort+scan into atm-storage as the single owner and have all three call sites use it, keeping the store-transaction check as the authoritative gate per REQ-ROSTER-NAME-001." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "duplication" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/roster_store.rs, crates/atm-core/src/team_admin/member_mutation.rs, crates/atm-core/src/doctor/mod.rs, crates/atm-storage (shared owner)" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T22:37:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-07T22:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed at phase-ay gate round 2 (PR #1308, integrate/phase-ay 0da9a26ec9f0493e5b2e6778ebf815efa8b78493). Independently re-verified by quality-mgr plus the round-2 reviewer set (req-qa, arch-qa, ruthless-boundary-qa) against live file:line evidence, not taken on a prior round's say-so." ;
  triage:foundIn triage:AY15 ;
  triage:foundAt "2026-09-07T22:31:51Z"^^xsd:dateTime ;
