<urn:atm:triage:finding/RBQA-AY15-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AY15-F001" ;
  triage:title "Database-wide unique_name collision-check algorithm is duplicated between member_mutation.rs preflight_roster_unique_names and roster_store.rs enforce_roster_unique_names" ;
  triage:description "quality-mgr qa-pr1310-r7 (PR #1310, AY.15 herdr-name-uniqueness, FINAL head 10bc123f8; report: PR #1310 issuecomment 5575994618). ruthless-boundary-qa RBQA-AY15-F001, found independently by arch-qa ARCH-004. The sort-and-scan collision detection over COALESCE(alias, agent_name) exists twice: crates/atm-core/src/team_admin/member_mutation.rs:452 fn preflight_roster_unique_names and crates/atm-storage-rusqlite/src/roster_store.rs:245 fn enforce_roster_unique_names. Two owners of one invariant drift independently. Recommended correction (quality-mgr): extract the shared sort+scan into atm-storage as the single owner and have both call sites use it, keeping the store-transaction check as the authoritative gate per REQ-ROSTER-NAME-001." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "duplication" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/team_admin/member_mutation.rs, crates/atm-storage-rusqlite/src/roster_store.rs, crates/atm-storage (shared owner)" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T22:05:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AY15 ;
  triage:foundAt "2026-09-07T21:55:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AY15-F001/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AY15-F001/2> ;
  triage:triageRecordVersion "1" .

