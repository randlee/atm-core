<urn:atm:triage:finding/AY15-QA-002>
  a triage:Finding ;
  triage:findingId "AY15-QA-002" ;
  triage:title "HerdrMemberPresence.herdr_agent is a required non-Option, non-defaulted field added under the 1.1.0 to 1.2.0 minor bump, breaking ADR-061 backward-compatible deserialization" ;
  triage:description "quality-mgr qa-pr1310-r7 (PR #1310, AY.15 herdr-name-uniqueness, FINAL head 10bc123f8; report: PR #1310 issuecomment 5575994618). schema-reviewer, confirmed by quality-mgr direct read. crates/atm-core/src/doctor/herdr_state.rs:218 adds pub herdr_agent: crate::HerdrAgentName to the Serialize/Deserialize struct HerdrMemberPresence with no Option wrapper and no #[serde(default)]. Under ADR-061 a minor version bump must remain backward-compatible: a payload produced by a 1.1.0 peer (older daemon/client pairing) that lacks herdr_agent fails to deserialize on 1.2.0. Required correction: make the field Option<HerdrAgentName> or give it a serde default so absent values deserialize, keep the wire bump at minor, and add a deserialization test for a payload without the field." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "adr-061-compliance" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/doctor/herdr_state.rs; every other Serialize/Deserialize struct that gained a field in this sprint under the 1.2.0 minor bump" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T22:05:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-07T22:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed at phase-ay gate round 2 (PR #1308, integrate/phase-ay 0da9a26ec9f0493e5b2e6778ebf815efa8b78493). Independently re-verified by quality-mgr plus the round-2 reviewer set (req-qa, arch-qa, ruthless-boundary-qa) against live file:line evidence, not taken on a prior round's say-so." ;
  triage:foundIn triage:AY15 ;
  triage:foundAt "2026-09-07T21:55:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AY15-QA-002/1> ;
  triage:triageRecordVersion "1" .

