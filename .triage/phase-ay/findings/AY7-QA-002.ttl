  triage:hasOccurrence <urn:atm:triage:occurrence/AY7-QA-002/AY7-2> ;
  triage:hasResolution <urn:atm:triage:resolution/AY7-QA-002/1> ;
  triage:closedAt "2026-09-07T09:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "1" .

