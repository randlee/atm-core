<urn:atm:triage:finding/SCHEMA-AY-R2-001>
  a triage:Finding ;
  triage:findingId "SCHEMA-AY-R2-001" ;
  triage:title "HerdrTransportKind added to the doctor payload without a serde default (ADR-061 minor bump must be additive)" ;
  triage:description "quality-mgr qa-phase-ay-gate-r2 (PR #1308 integrate/phase-ay -> develop, pinned 0da9a26ec; report: message 01M1Z4RKVAMC1J0GRB15K3D219, PR #1308 issuecomment 5576945237). Important. crates/atm-core/src/doctor/herdr_state.rs:14-19 introduces enum HerdrTransportKind { Cli, Socket } and line 294 adds field transport: HerdrTransportKind to HerdrEndpointObservation (also report.rs:331). The enum has no Default impl and the field carries no #[serde(default)], so a pre-AY doctor payload without transport fails to deserialize; this breaks the ADR-061 additive-minor-bump rule that herdr_agent already follows (#[serde(default, skip_serializing_if)]). Required correction (quality-mgr): add Default for HerdrTransportKind (Cli, the pre-AY.9 sole transport) and mark the field #[serde(default)], or wrap it Option<HerdrTransportKind> with #[serde(default)]; add a backward-compat test analogous to herdr_member_presence_accepts_v1_1_payload_without_herdr_agent (doctor/mod.rs:1242)." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "schema" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "every ADR-061 governed struct field added in phase-ay: serde default present" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-08T00:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AY3 ;
  triage:foundAt "2026-09-08T00:05:00Z"^^xsd:dateTime ;
