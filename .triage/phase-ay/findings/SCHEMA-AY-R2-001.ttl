  triage:hasOccurrence <urn:atm:triage:occurrence/SCHEMA-AY-R2-001/SCHEMA-AY-R2-001/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/SCHEMA-AY-R2-001/SCHEMA-AY-R2-001/3> ;
  triage:triageRecordVersion "1" .

