<urn:atm:triage:finding/CIPHER-NAME-002>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-002" ;
  triage:title "alias collision checks use raw canonical names instead of effective names and reject valid alias combinations" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. ensure_alias_available rejects a proposed alias whenever any existing entry.agent_name equals it, even when that existing member has a different alias and therefore a different effective Herdr name. ensure_canonical_member_name_available has the symmetric raw-canonical comparison. Consequently matrix A-09 and A-10 are rejected although unique_name values do not collide, and set-member A-15 is rejected for the same reason; the store validator repeats the same raw-field mistake for explicit aliases. The checks must compare alias-or-canonical effective names and exclude the member being updated from the candidate comparison." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/team_admin/member_mutation.rs; crates/atm-storage-rusqlite/src/roster_store.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AY14 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-002/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-002/2> ;
  triage:triageRecordVersion "1" .

