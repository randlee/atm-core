<urn:atm:triage:finding/DOCS-AY-R4-001>
  a triage:Finding ;
  triage:findingId "DOCS-AY-R4-001" ;
  triage:title "Phase-ay sprint-doc frontmatter status stale against docs/project-plan.md" ;
  triage:description "quality-mgr phase-ay gate round 4 (PR #1320 fix/ay-gate-r3-arch, head 170ae2dffe4a86f4cb873de76bea8352c2d55352) reported sprint-AY.9 and sprint-AY.13 frontmatter status as stale (draft / dispatched) while docs/project-plan.md records both sprints as merged. Workspace-wide sweep of docs/plans/phase-ay/ shows the pattern is broader than the two reported files: eleven sprint docs carry a non-terminal frontmatter status while the phase AY sprint status table in docs/project-plan.md records each as merged. AY.1 through AY.9 read status: draft; AY.13 and AY.14 read status: dispatched. AY.15 already reads status: complete and is correct. AY.10 and AY.12 read status: gated and are correct because both remain undispatched behind a recorded Rand decision; AY.11 reads status: draft and is correct because it is not present in the project-plan sprint status table and was never executed. Required correction: set status: complete on the eleven listed sprint docs so the sprint-doc frontmatter agrees with the project-plan record. This is the same acceptance-gate item the QA template step d enforces (sprint doc frontmatter must set status: complete before QA can PASS). Non-blocking, docs-only, no code impact." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "all sprint docs under docs/plans/phase-ay/ cross-checked against the phase AY sprint status table in docs/project-plan.md" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-08T06:10:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-08T06:40:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed on PR #1324 (fix/ay-gate-r4-sprintdoc-status, head 2788d3feca0e83edb5998759d779bc14492244d9), merged as 6099e385d then carried forward by develop-merge to integrate/phase-ay@97cf27f51. Independently re-verified by quality-mgr (round-5 gate) via direct reads plus arch-qa and req-qa round-5 re-confirmation: all eleven listed sprint docs (AY.1-AY.9, AY.13, AY.14) now read status: complete at the cited lines, matching docs/project-plan.md's merged entries; AY.10/AY.12 correctly left status: gated, AY.11 correctly left status: draft (never executed, absent from project-plan status table), AY.15 unchanged (already complete). Written to fix/ay-closeout per fenix's branch-redirect (integrate/phase-ay frozen for PR #1308 CI); not committed to integrate/phase-ay directly." ;
  triage:foundIn triage:AY15 ;
  triage:foundAt "2026-09-08T05:50:00Z"^^xsd:dateTime ;
