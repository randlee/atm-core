<urn:atm:triage:finding/CIPHER-NAME-004>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-004" ;
  triage:title "alias validation does not reject the reserved atm-daemon name" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. Matrix B-07 and REQ-ROSTER-NAME-005 require an alias equal to reserved atm-daemon to be rejected. ensure_member_name_available checks only the canonical member argument, and parse_alias only applies the generic segment validator; neither checks the alias against the reserved daemon actor name. The Herdr backend grammar accepts atm-daemon, so both non-Herdr and Herdr add/update paths can persist this reserved alias." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/team_admin/member_mutation.rs; alias parsing and backend transitions" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-07T22:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed at phase-ay gate round 2 (PR #1308, integrate/phase-ay 0da9a26ec9f0493e5b2e6778ebf815efa8b78493). Independently re-verified by quality-mgr plus the round-2 reviewer set (req-qa, arch-qa, ruthless-boundary-qa) against live file:line evidence, not taken on a prior round's say-so." ;
  triage:foundIn triage:AY14 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
