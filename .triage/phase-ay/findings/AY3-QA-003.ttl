<urn:atm:triage:finding/AY3-QA-003>
  a triage:Finding ;
  triage:findingId "AY3-QA-003" ;
  triage:title "transport_cli.rs spawn() io::Error discarded; doctor cannot distinguish BinaryNotFound from BinaryNotExecutable" ;
  triage:description "crates/atm-herdr/src/transport_cli.rs:127 command.spawn().map_err(|_| HerdrError::ServerUnavailable{..}) drops the io::Error kind, so crates/atm-herdr/src/doctor_probe.rs:116-130 cannot map NotFound vs PermissionDenied to HerdrDoctorState::BinaryNotFound vs BinaryNotExecutable per the C4 contract. Fix: match err.kind() before mapping (RBP-F001, rust-best-practices-agent)." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-herdr/src" ;
  triage:status "open" ;
