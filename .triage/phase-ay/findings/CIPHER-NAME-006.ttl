<urn:atm:triage:finding/CIPHER-NAME-006>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-006" ;
  triage:title "retired .atm.toml atm.aliases remains parsed and used for runtime identity, mailbox, and list resolution" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. Rand's ruling in requirements section 3.3 and matrix D-06 says .atm.toml [atm].aliases is retired from atm-core; only the doctor pane-alias consistency diagnostic may read a pane alias. The code still exposes config::aliases, loads parsed.atm.aliases into AtmConfig, resolves mailbox targets through config::aliases::resolve_agent_name, and retains identity alias projection helpers. A stale config alias can therefore affect runtime behavior and violates the single durable roster-alias source of truth." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/config; crates/atm-core/src/mailbox/source.rs; crates/atm-core/src/list.rs; crates/atm-core/src/identity" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-09-07T22:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Confirmed fixed at phase-ay gate round 2 (PR #1308, integrate/phase-ay 0da9a26ec9f0493e5b2e6778ebf815efa8b78493). Independently re-verified by quality-mgr plus the round-2 reviewer set (req-qa, arch-qa, ruthless-boundary-qa) against live file:line evidence, not taken on a prior round's say-so." ;
  triage:foundIn triage:AY15 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-006/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-006/2> ;
  triage:triageRecordVersion "1" .

