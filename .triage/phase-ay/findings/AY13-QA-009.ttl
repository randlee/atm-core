<urn:atm:triage:finding/AY13-QA-009>
  a triage:Finding ;
  triage:findingId "AY13-QA-009" ;
  triage:title "rust-service-hardening RSH-002: per-team Herdr loop passes the full remaining deadline to each team in sequence, letting earlier teams starve later teams' time budget" ;
  triage:description "quality-mgr qa-pr1300-r1 (PR #1300, AY.13 doctor team scope). The per-team loop in doctor_projection.rs passes deadline.remaining() (the full remaining budget, not a divided share) into each team's tokio::time::timeout(...) call in sequence, so earlier teams can consume the entire shared deadline before later teams get a chance to run -- a new risk introduced by the per-team loop that did not exist when there was only ever one roster." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "resource-fairness" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-runtime/src/doctor_projection.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
