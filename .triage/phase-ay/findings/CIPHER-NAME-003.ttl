<urn:atm:triage:finding/CIPHER-NAME-003>
  a triage:Finding ;
  triage:findingId "CIPHER-NAME-003" ;
  triage:title "add-member rejects blank aliases instead of normalizing empty and whitespace aliases to no alias" ;
  triage:description "Independent review of integrate/phase-ay at 10b044c0c. REQ-ROSTER-NAME-002 defines empty or whitespace-only alias as no alias, and matrix A-18 requires the same duplicate-name behavior as an omitted alias. parse_alias returns an add-member validation error for a blank value when allow_clear is false, while update-member uses the same input as a clear operation. The CLI add path therefore rejects input that the requirement says must normalize to None rather than behaving like an omitted alias." ;
  triage:phaseId "phase-ay" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/team_admin/member_mutation.rs; add-member CLI and request DTO parsing" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AY14 ;
  triage:foundAt "2026-09-07T20:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CIPHER-NAME-003/1> ;
  triage:triageRecordVersion "1" .

