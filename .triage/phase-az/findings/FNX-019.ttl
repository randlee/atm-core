<urn:atm:triage:finding/FNX-019>
  a triage:Finding ;
  triage:findingId "FNX-019" ;
  triage:title "service_runtime.rs's map_read_lane_error is a superfluous one-line wrapper" ;
  triage:description "quality-mgr's QA-2 pass on PR #1395 (head 3b8a43fd3) reports crates/atm-core/src/service_runtime.rs:1148's map_read_lane_error(error: atm_storage::ReadLaneError) -> AtmError just returns AtmError::from(error) -- an existing From impl is already available, so the wrapper adds no behavior. Same pattern as the pre-existing task_ledger_read_error wrapper in crates/atm-http-runtime/src/herdr_queue_wake.rs:59 (also just AtmError::from(error)). Recommendation: replace .map_err(map_read_lane_error) at service_runtime.rs:742 with .map_err(AtmError::from) and delete the wrapper fn (updating its direct test-assertion call site at service_runtime.rs:1200); leaving herdr_queue_wake.rs's task_ledger_read_error alone is acceptable since it is pre-existing and out of this PR's diff, but doing both keeps the codebase consistent since quality-mgr flagged the duplication pattern." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "followup_pass" ;
  triage:category "simplification" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/service_runtime.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
