  a triage:Finding ;
  triage:findingId "AZ3-OPENAPI-STALE-BASELINE" ;
  triage:title "openapi.yaml peer_http_api_version field description missed the 1.5.0 version-bump cascade" ;
  triage:description "Both docs/atm-http-runtime/openapi.yaml:174 and crates/atm/openapi.yaml:174 still describe peer_http_api_version's current baseline as '1.4.0' after HTTP_API_VERSION moved to 1.5.0 in this round's SCHEMA-COLLISION fix -- the top-level version fields were updated but this inline field description was missed by the same cascade. Fix: update both field descriptions to 1.5.0. Source: QA-2 on PR #1382 (https://github.com/randlee/atm-core/pull/1382)." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation-consistency" ;
  triage:severity "important" ;
  triage:repeatable true ;
