<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "task-command error handling collapses ~14 distinct failure modes into one generic error code" ;
  triage:description "crates/atm-core/src/task_command/service.rs:695 (task_error() helper) is the sole error constructor for require_member, require_same_team, require_distinct_member, require_existing_state, require_open, require_closed, require_current_assignee, require_active_assignee, require_assigned_or_active, the reassign-active-conflict case, and require_assignee_or_assigner -- all producing the same generic AtmErrorCode::MessageValidationFailed with identical recovery text, even though require_unique_lead two branches later in the same file correctly uses distinct TaskLeadMissing/TaskLeadAmbiguous codes, and the storage layer already codes the identical 'illegal transition' concept as AtmErrorCode::TaskTransitionInvalid. Confirmed at head 6937c547f. Fix: route the transition-shaped checks through TaskTransitionInvalid to match the storage layer, and introduce distinct stable codes for the authorization-shaped checks. Source: QA-1 on PR #1382 (https://github.com/randlee/atm-core/pull/1382#issuecomment-5612459494)." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T03:50:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.3 ;
  triage:foundAt "2026-09-10T03:45:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001/AZ3-1> ;
  triage:triageRecordVersion "1" .

