<urn:atm:triage:finding/AZS4-QA-012>
  a triage:Finding ;
  triage:findingId "AZS4-QA-012" ;
  triage:title "No dedicated boundary tests for the two new sealed traits (AttentionScheduleStore/AsyncAttentionScheduleStore) per ADR-063 Required Evidence" ;
  triage:description "quality-mgr's formal QA-2 verdict (ruthless-boundary-qa, RBQA-AZ4-F001) reports that no dedicated boundary test exists for the two new sealed traits AttentionScheduleStore (crates/atm-storage/src/attention.rs:235) and AsyncAttentionScheduleStore (crates/atm-storage/src/attention.rs:247), unlike every other capability in the repo (e.g. crates/atm-architecture/tests/pending_nudge_store_boundary.rs establishes the existing precedent pattern for a dedicated per-capability boundary test file). ADR-063 (docs/adr/ADR-063-phase-az-task-and-attention-capabilities.md) Required Evidence section, line 205, explicitly demands: 'Boundary tests for all three new sealed traits (two semantic capabilities) and a crate-graph proof that no concrete SQLite type crosses the storage boundary.' This evidence requirement has not been satisfied for the attention-scheduler capability added in AZ.4." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-storage/src/attention.rs, crates/atm-storage-rusqlite/src/attention_schedule_store.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:closedAt "2026-09-10T16:34:10Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
