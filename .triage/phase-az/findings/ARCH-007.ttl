<urn:atm:triage:finding/ARCH-007>
  a triage:Finding ;
  triage:findingId "ARCH-007" ;
  triage:title "task_ledger_read_error helper duplicated instead of shared via pub(super) re-export" ;
  triage:description "quality-mgr's CDR-005 QA verdict (arch-qa) reports that herdr_attention_scheduler.rs and herdr_queue_wake.rs each define their own copy of the same one-line task_ledger_read_error helper (both delegate to the identical AtmError::from(ReadLaneError) mapping) instead of sharing one via a pub(super) re-export, which the codebase already does for TASK_REMINDER_INTERVAL_MS. Flagged IMPORTANT/maintainability but explicitly non-blocking by arch-qa since neither copy duplicates the actual code-mapping logic. Recommend a trivial consolidation in a housekeeping pass." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "followup_pass" ;
  triage:category "maintainability" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_attention_scheduler.rs, crates/atm-http-runtime/src/herdr_queue_wake.rs" ;
  triage:status "fixed" ;
