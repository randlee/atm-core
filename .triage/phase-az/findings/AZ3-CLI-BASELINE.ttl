<urn:atm:triage:finding/AZ3-CLI-BASELINE>
  a triage:Finding ;
  triage:findingId "AZ3-CLI-BASELINE" ;
  triage:title "CLI surface baseline not regenerated for the new atm task subcommand -- CI red" ;
  triage:description "crates/atm/tests/cli_surface_baseline.json was not regenerated after the new `atm task` subcommand (wired in crates/atm/src/commands/mod.rs / task.rs) was added. cli_surface_matches_committed_baseline fails CI red on both ubuntu-latest and macos-latest Test jobs at head b8900296c, confirmed via live CI job logs, and independently reproduced locally by rust-qa-agent with `cargo test -p agent-team-mail --features cli-surface-dump --test cli_surface`. Fix: run `cargo run -p agent-team-mail --features cli-surface-dump --example gen_cli_docs` in the same commit and commit the regenerated baseline plus derived docs/atm/cli-reference-*.md. Source: QA-2 on PR #1382 (https://github.com/randlee/atm-core/pull/1382)." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "ci-regression" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
