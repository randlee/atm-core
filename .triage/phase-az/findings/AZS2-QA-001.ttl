<urn:atm:triage:finding/AZS2-QA-001>
  a triage:Finding ;
  triage:findingId "AZS2-QA-001" ;
  triage:title "Assigned -> Close(Failed) transition not in the Legal Transitions table" ;
  triage:description "crates/atm-storage/src/task_state.rs:107-108 -- lifecycle_transition() accepts (Assigned, Close(Failed)) -> Closed(Failed). This transition does not appear as a row in sprint AZ.2's own Legal Transitions table (only Assigned -> {start, legacy complete, block, reassign, abort} listed). AC1 states the pure table 'accepts every listed transition and rejects every unlisted transition.' Note: docs/task-lifecycle-schema.md:21 documents this exact behavior as intentional, so code is internally consistent with a second authoritative doc -- the defect is the sprint doc's own table is missing this row, not that the code is unsafe. Still a literal AC1 violation as written. Fix: add the missing Assigned|fail|Closed(Failed) row to the sprint doc's Legal Transitions table (and reconcile AC1 text), or remove the code path -- needs an explicit sprint-doc decision." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-storage/src/task_state.rs, docs/plans/phase-az/sprint-AZ.2-task-domain-storage.md, docs/task-lifecycle-schema.md" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T02:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.2 ;
  triage:foundAt "2026-09-10T02:11:59Z"^^xsd:dateTime ;
