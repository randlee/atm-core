<urn:atm:triage:finding/FNX-011>
  a triage:Finding ;
  triage:findingId "FNX-011" ;
  triage:title "idle-opportunity-sink.toml allowed_test_double_paths names modules/paths that do not resolve" ;
  triage:description "fenix's re-verification pass on PR #1395 (head 3b8a43fd3) reports boundaries/atm-http-runtime/idle-opportunity-sink.toml:36's allowed_test_double_paths lists crate::herdr_queue_wake_idle::HerdrQueueWakePump and crate::storage_and_nudge_router::RecordingIdleOpportunitySink, neither of which resolves. herdr_queue_wake_idle.rs is pulled in via #[path] as a submodule of herdr_queue_wake (crate::herdr_queue_wake::idle), not a top-level crate::herdr_queue_wake_idle module, and HerdrQueueWakePump is declared in herdr_queue_wake.rs itself. RecordingIdleOpportunitySink lives inside mod tests at storage_and_nudge_router.rs:1171, missing the tests:: segment that sibling manifests get right. Separately, HerdrQueueWakePump is the production implementor, not a test double, so listing it under [testing] mis-describes it. lint_boundaries.py's validate_rust_path only checks syntax, not existence, so this passes lint. Recommendation: correct to crate::storage_and_nudge_router::tests::RecordingIdleOpportunitySink and drop the pump entry (or move it to a field denoting the production implementor). Deferred: cosmetic manifest-path correction with no mechanical enforcement impact; does not block merge per fenix's PASS verdict." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "followup_pass" ;
  triage:category "documentation-consistency" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "boundaries/atm-http-runtime/idle-opportunity-sink.toml" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T21:05:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.4 ;
  triage:foundAt "2026-09-10T20:36:42Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FNX-011/AZ4-001> ;
  triage:triageRecordVersion "2" .

