<urn:atm:triage:finding/FNX-015>
  a triage:Finding ;
  triage:findingId "FNX-015" ;
  triage:title "created_at DEFAULT 0 discards the entire pre-upgrade terminal-row history on first prune" ;
  triage:description "fenix's re-verification pass on PR #1395 (head 3b8a43fd3) reports attention_schedule_store.rs:54's created_at INTEGER NOT NULL DEFAULT 0 means every row that existed before the additive migration is older than any retention cutoff, so the first post-upgrade reserve_writer call deletes all pre-existing non-reserved rows in one statement rather than aging them out gradually over 30 days. reserved rows are correctly exempt and nothing live is lost, but the discard is immediate and total on upgrade rather than gradual, and the migration comment does not say so. The added test ages rows to created_at = 0 by hand and so cannot distinguish this from intended behavior. Recommendation: either backfill created_at to the migration timestamp so existing rows age out normally, or state in the ensure-step comment that the 2.1 upgrade drops pre-existing terminal opportunity rows on first prune. Deferred: no live data loss, cosmetic/documentation gap in migration behavior; does not block merge per fenix's PASS verdict." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "followup_pass" ;
  triage:category "data-migration" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/attention_schedule_store.rs" ;
  triage:status "deferred" ;
  triage:closedAt "2026-09-10T20:40:00Z"^^xsd:dateTime ;
  triage:closedBy "team-lead" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-09-10T20:40:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.4 ;
  triage:foundAt "2026-09-10T20:36:42Z"^^xsd:dateTime ;
