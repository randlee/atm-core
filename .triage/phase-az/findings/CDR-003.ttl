  triage:sweepScope "crates/atm-storage-rusqlite/src/attention_schedule_store.rs, crates/atm-http-runtime/src/herdr_queue_wake.rs" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-10T18:45:00Z"^^xsd:dateTime ;
