<urn:atm:triage:finding/CDR-003>
  a triage:Finding ;
  triage:findingId "CDR-003" ;
  triage:title "PermanentlyFailed reservations suppress later opportunities for their still-eligible item" ;
  triage:description "solar's critical design review reports that load_unfinished_reservation_for_item (crates/atm-storage-rusqlite/src/attention_schedule_store.rs:225-259,303-365,367-410) treats permanently_failed as unfinished. Every later opportunity selecting the still-eligible item therefore returns the old PermanentlyFailed reservation, and the pump (crates/atm-http-runtime/src/herdr_queue_wake.rs:613-636) skips every non-Reserved reservation. The item is never consumed/closed, so it remains selected but can never be nudged again; FIFO successors can remain trapped behind it. This contradicts sprint-AZ.4-attention-scheduler.md:193-200 and acceptance 7 at 454-458. Recommendation: make PermanentlyFailed cease deduplicating later opportunity ids (or define a separate explicit item suppression policy); preserve same-opportunity replay while allowing a later revision to create a fresh reservation. Add fifth-failure/later-opportunity and successor fairness tests." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "liveness-bug" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/attention_schedule_store.rs, crates/atm-http-runtime/src/herdr_queue_wake.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T17:50:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.4 ;
  triage:foundAt "2026-09-10T17:48:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CDR-003/AZ4-001> ;
  triage:triageRecordVersion "1" .

