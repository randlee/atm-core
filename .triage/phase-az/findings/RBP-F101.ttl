  triage:snippet "cipher: original finding cited crates/atm-core/src/tool_types.rs, which does not exist -- the actual file is crates/atm-graft-python/src/tool_types.rs (relocated by an earlier phase). Fixed by switching to map_or_else at line 404." ;
  triage:status "fixed" ;
