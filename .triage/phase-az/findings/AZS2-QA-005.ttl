  a triage:Finding ;
  triage:findingId "AZS2-QA-005" ;
  triage:title "D6's required 'malformed-legacy' test category is entirely absent" ;
  triage:description "crates/atm-storage-rusqlite/src/schema_version.rs (migration CASE...ELSE fallbacks, e.g. lines ~144, ~231), crates/atm-storage-rusqlite/tests/schema_version_compat.rs -- D6 explicitly names 'malformed-legacy' as one of the required test categories, verbatim. git grep -ni 'malformed' at the pinned commit across crates/atm-storage-rusqlite and crates/atm-storage returns zero task-migration-related hits. The migration SQL's defensive CASE state ... ELSE 'assigned' fallback for out-of-domain legacy state values exists but is exercised by no test. Fix: add a migration test seeding a v1 tasks row with a corrupt/unrecognized state value and assert the documented safe fallback rather than a panic or silent misclassification." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
