<urn:atm:triage:finding/RSH-002>
  a triage:Finding ;
  triage:findingId "RSH-002" ;
  triage:title "backpressure risk contingent on RSH-001" ;
  triage:description "Because the Task mutation path has no tie to the caller's actual request budget (see RSH-001, blocking, same branch/head), a slow-resolving mutation can occupy the single ordered SQLite writer queue (shared with ordinary message sends/receives) for multiples of the daemon's normal per-request budget. Fix alongside RSH-001; add a test proving a stalled Task mutation cannot starve concurrent message writes. Source: QA-1 on PR #1382 (https://github.com/randlee/atm-core/pull/1382#issuecomment-5612459494)." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "runtime-hardening" ;
  triage:severity "important" ;
