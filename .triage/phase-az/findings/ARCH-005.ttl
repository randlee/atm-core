<urn:atm:triage:finding/ARCH-005>
  a triage:Finding ;
  triage:findingId "ARCH-005" ;
  triage:title "Duplicate private run_blocking helper in herdr_attention_scheduler.rs diverges from the shared hardened helper" ;
  triage:description "quality-mgr's QA-3 verdict (arch-qa) reports that crates/atm-http-runtime/src/herdr_attention_scheduler.rs:22 defines its own private run_blocking helper with no built-in timeout, diverging from the shared hardened helper (crates/atm-http-runtime/src/herdr_queue_wake.rs:1028) that cipher fixed under AZS4-QA-011 to wrap tokio::time::timeout(HERDR_REQUEST_DEADLINE, ...). The scheduler's one call site stays bounded only via a second, independently-declared SCHEDULER_REQUEST_DEADLINE constant duplicating HERDR_REQUEST_DEADLINE's value -- two sources of truth for the same timeout bound that can silently drift apart. Recommended fix: delete the local duplicate run_blocking and SCHEDULER_REQUEST_DEADLINE, call the shared helper (and shared deadline constant) directly." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "followup_pass" ;
  triage:category "maintainability" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_attention_scheduler.rs" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-10T17:10:35Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T16:34:10Z"^^xsd:dateTime ;
