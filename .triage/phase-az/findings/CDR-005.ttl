<urn:atm:triage:finding/CDR-005>
  a triage:Finding ;
  triage:findingId "CDR-005" ;
  triage:title "Scheduler flattens structured ReadLaneError into opaque DaemonUnavailable strings" ;
  triage:description "solar's critical design review reports that three scheduler reads (crates/atm-http-runtime/src/herdr_attention_scheduler.rs:111-117; crates/atm-http-runtime/src/herdr_queue_wake.rs:854-873) flatten ReadLaneError into DaemonUnavailable strings although the storage contract (crates/atm-storage/src/contract.rs:405-418) provides a structured conversion preserving saturation, deadline, storage code, and cause. Recommendation: use AtmError::from and add error-code preservation tests for saturated, deadline, and storage failures." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_attention_scheduler.rs, crates/atm-http-runtime/src/herdr_queue_wake.rs" ;
  triage:status "fixed" ;
  triage:closedAt "2026-09-10T18:36:39Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T17:50:00Z"^^xsd:dateTime ;
