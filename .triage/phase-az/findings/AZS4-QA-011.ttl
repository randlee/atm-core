<urn:atm:triage:finding/AZS4-QA-011>
  a triage:Finding ;
  triage:findingId "AZS4-QA-011" ;
  triage:title "Unbounded run_blocking helper in herdr_queue_wake.rs has no timeout wrapper across 6+ call sites" ;
  triage:description "quality-mgr's formal QA-2 verdict (rust-service-hardening-agent, RSH-003) reports that herdr_queue_wake.rs's own run_blocking helper (crates/atm-http-runtime/src/herdr_queue_wake.rs:1028, distinct from the scheduler's already-fixed helper closed under AZS4-QA-008/RSH-001) wraps tokio::task::spawn_blocking with no timeout across 6+ call sites: pending-store reads (line 227), candidate reads (line 248), claim/release (line 723), escalation dispatch (line 786), escalation mail (line 861), and roster reads (line 891) -- all awaited inside the single sequential pump task, so a blocking-store stall at any one call site would hang the whole pump silently with no bound." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "reliability" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_queue_wake.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T16:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.4 ;
  triage:foundAt "2026-09-10T16:00:00Z"^^xsd:dateTime ;
