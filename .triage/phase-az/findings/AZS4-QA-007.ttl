<urn:atm:triage:finding/AZS4-QA-007>
  a triage:Finding ;
  triage:findingId "AZS4-QA-007" ;
  triage:title "Generic InvalidQuery error mapping loses diagnostic context (RBP-F001)" ;
  triage:description "The attention-scheduler storage path maps 11 distinct error conditions down to the single generic rusqlite::Error::InvalidQuery variant across attention_schedule_store.rs, discarding the diagnostic context needed to distinguish cursor-revision mismatch, member mismatch, lane parse failure, opportunity-id parse failure, and other cases at the call site or in logs. Confirmed by quality-mgr's rust-best-practices-agent reviewer, primary site load_cursor's parse_lane mapping at line 187. Workspace sweep (repeatable pattern) confirmed 10 additional sites in the same file at pinned head 7f5df3bfdb90d16dd4fbde2a6e563bac7bba084d." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/attention_schedule_store.rs, crates/atm-storage/src/attention.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:closedAt "2026-09-10T16:09:12Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triagedAt "2026-09-10T15:44:00Z"^^xsd:dateTime ;
