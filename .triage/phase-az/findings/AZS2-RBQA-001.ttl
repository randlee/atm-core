<urn:atm:triage:finding/AZS2-RBQA-001>
  a triage:Finding ;
  triage:findingId "AZS2-RBQA-001" ;
  triage:title "Active>Assigned>Complete precedence logic duplicated across 6+ SQL sites" ;
  triage:description "crates/atm-storage-rusqlite/src/schema_version.rs -- task_v1_insert_bridge trigger and task_v1_update_bridge trigger contain 10 identical CASE chosen.state WHEN 'active' THEN 0 WHEN 'assigned' THEN 1 ELSE 2 END precedence expressions duplicated at lines 117, 119, 155, 193, 195, 210, 216, 226, 236, 245. This contradicts AZ.2 design requirement D4: 'Implement deterministic state precedence and active-conflict demotion once and reuse them for both initial migration and every supported v1 bridge write.' Fix: factor the precedence expression into one canonical SQL artifact referenced by all sites." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary-duplication" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-10T02:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.2 ;
  triage:foundAt "2026-09-10T02:11:59Z"^^xsd:dateTime ;
