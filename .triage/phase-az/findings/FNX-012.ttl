<urn:atm:triage:finding/FNX-012>
  a triage:Finding ;
  triage:findingId "FNX-012" ;
  triage:title "FNX-007's replacement comment asserts task-store.toml covers atm-http-runtime, which it does not" ;
  triage:description "fenix's re-verification pass on PR #1395 (head 3b8a43fd3) reports that the FNX-007 replacement comment in boundaries/atm-storage/async-task-scheduler-audit-store.toml:22 says lint_boundaries.py unions manifests by owner_package and that task-store.toml covers atm-http-runtime's re-exported consumption. The union-semantics half is correct, but task-store.toml's allowed_dependents does NOT list atm-http-runtime and its forbidden_edges explicitly names atm-http-runtime -> atm-storage. The comment sits exactly where a future reader decides whether to add the entry, so as written it invites cipher's original (reverted) mistake back. Recommendation: replace with the actual reason -- atm-http-runtime consumes these types only through atm-core's re-export, there is no atm-http-runtime -> atm-storage Cargo edge, and task-store.toml forbids one; allowed_dependents therefore never lists atm-http-runtime. Deferred: one-line comment correction, no mechanical/lint impact, does not block merge per fenix's PASS verdict." ;
  triage:phaseId "phase-az" ;
  triage:triageMode "followup_pass" ;
  triage:category "documentation-consistency" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "boundaries/atm-storage/async-task-scheduler-audit-store.toml" ;
  triage:status "deferred" ;
  triage:closedAt "2026-09-10T20:40:00Z"^^xsd:dateTime ;
  triage:closedBy "team-lead" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-09-10T20:40:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AZ.4 ;
  triage:foundAt "2026-09-10T20:36:42Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FNX-012/AZ4-001> ;
  triage:triageRecordVersion "1" .

