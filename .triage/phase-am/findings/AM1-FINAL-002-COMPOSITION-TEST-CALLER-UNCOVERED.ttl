<urn:atm:triage:finding/AM1-FINAL-002-COMPOSITION-TEST-CALLER-UNCOVERED>
  a triage:Finding ;
  triage:findingId "AM1-FINAL-002-COMPOSITION-TEST-CALLER-UNCOVERED" ;
  triage:title "Compiled test in composition.rs calls raw HTTP framing symbols with no ledger row" ;
  triage:description "crates/atm/src/composition.rs (a #[cfg(test)] module, confirmed compiled during test builds, around lines 524 and 1129-1131) directly calls decode_request, read_http_request, and write_http_request -- AM1-RM-001's exact target symbols -- but no removal-ledger row in docs/plans/phase-am/am1-removal-ledger.md covers this caller. AM1-RM-001's own validation command (rg -n 'HttpFrameReader|write_http_request|read_http_response_with_frame_reader' crates) omits the bare token 'read_http_request', so re-running the documented validation command cannot even find this caller." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "COMPLETENESS" ;
  triage:severity "blocking" ;
