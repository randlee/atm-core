<urn:atm:triage:finding/AM-END-DISCARDED-ERROR-CAUSE>
  a triage:Finding ;
  triage:findingId "AM-END-DISCARDED-ERROR-CAUSE" ;
  triage:title "systemic .map_err(|_source| ...) pattern discards the underlying OS error before with_cause can use it" ;
  triage:description "QA-AM-CRITICAL-PHASEEND (important, rust-best-practices RBP-F002, scoped to remaining live sites after AM-END-DEAD-COMPOSITION-STACK removed ~22 of the original ~28 occurrences in atm-daemon/host_ownership.rs and lifecycle_control.rs): the systemic .map_err(|_source| AtmError::daemon_unavailable(...)) pattern discards the underlying OS error before with_cause can use it -- inconsistent with the .with_cause(source) pattern used correctly elsewhere in the same phase's code, and violates the project's own map_err_ignore clippy guidance. Remaining live sites: crates/atm-core/src/api.rs:265, crates/atm-core/src/observability.rs:281, crates/atm-core/src/local_http.rs:44 and :154, crates/atm-core/src/protocol.rs:270, crates/atm-core/src/home.rs:97. Fix: change each to retain and pass the source error via with_cause(source) instead of discarding it with |_source|." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-11T05:10:59Z"^^xsd:dateTime ;
  triage:foundIn triage:AM-phase-end ;
  triage:foundAt "2026-08-11T05:10:31Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AM-END-DISCARDED-ERROR-CAUSE/AM-END-DISCARDED-ERROR-CAUSE/AM-END2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AM-END-DISCARDED-ERROR-CAUSE/AM-END-DISCARDED-ERROR-CAUSE/AM-END2-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AM-END-DISCARDED-ERROR-CAUSE/AM-END-DISCARDED-ERROR-CAUSE/AM-END2-3> ;
