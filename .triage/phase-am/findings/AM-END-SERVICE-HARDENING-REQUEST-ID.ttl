<urn:atm:triage:finding/AM-END-SERVICE-HARDENING-REQUEST-ID>
  a triage:Finding ;
  triage:findingId "AM-END-SERVICE-HARDENING-REQUEST-ID" ;
  triage:title "no request-ID allocation/propagation/logging on the server-side HTTP ingress path" ;
  triage:description "QA-AM-CRITICAL-PHASEEND (important, rust-service-hardening RSH-001): crates/atm-http-runtime/src/message_handler.rs:277's handlers (post_messages/dispatch_request) allocate no request-id and propagate/log none on the server-side HTTP ingress path. atm_core::protocol::RequestId/next_request_id() (protocol.rs:187-212) already exists and was used by the legacy daemon's connection observability but is never adopted by atm-http-runtime. Only a client-side span exists (client.rs:605, #[tracing::instrument] on execute_with_deadline). Fix: allocate a RequestId at ingress, wrap the handler body in a span/instrument carrying it, thread it through CommandEvent/observability emissions." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "service-hardening" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "fixed" ;
  triage:closedAt "2026-08-11T07:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "Independently reverified fixed by req-qa and arch-qa at @5e2450d3. post_messages/dispatch_request in message_handler.rs now allocate next_request_id(), wrap the handler in info_span!(\"atm_http_request\", %request_id, ...), and log info!(%request_id, ...) at ingress. Personally spot-verified by quality-mgr via direct grep before this recheck round." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-11T05:10:59Z"^^xsd:dateTime ;
  triage:foundIn triage:AM-phase-end ;
  triage:foundAt "2026-08-11T05:10:31Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AM-END-SERVICE-HARDENING-REQUEST-ID/AM-END-SERVICE-HARDENING-REQUEST-ID/AM-END2-1> ;
  triage:triageRecordVersion "1" .

