<urn:atm:triage:finding/ARCH-AM-END-RECHECK-002>
  a triage:Finding ;
  triage:findingId "ARCH-AM-END-RECHECK-002" ;
  triage:title "fresh dead-code instance survives in post_write.rs after the named-function fix" ;
  triage:description "QA-AM-END-RECHECK (blocking, arch-qa): the two functions named in AM-END-DEAD-POST-WRITE-EMIT (emit_persisted_local_post_write, emit_post_send_effects) are genuinely deleted, but a fresh instance of the identical defect class survives in the same file: build_received_message_hook_dispatches_after_commit (crates/atm-core/src/send/post_write.rs:66) and its private helper load_committed_post_write (post_write.rs:22) have zero production callers workspace-wide. This is hidden from rustc's dead_code lint by pub visibility, and 'verified' only by a tautological string-match assertion in crates/atm-architecture/tests/boundary_enforcement.rs:2272 that checks the source text contains the function name rather than that anything actually calls it. Same failure class as the finding this fix round was supposed to close -- delete both functions and their now-tautological boundary_enforcement.rs assertion (or replace it with a real reachability check), and check for any other now-orphaned support code." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "followup_pass" ;
  triage:category "dead-code-boundary-violation" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
