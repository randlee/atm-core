<urn:atm:triage:finding/AM2-ORPHANED-FUZZ-CAMPAIGN-SCRIPT>
  a triage:Finding ;
  triage:findingId "AM2-ORPHANED-FUZZ-CAMPAIGN-SCRIPT" ;
  triage:title "scripts/fuzz/run_local_http_framing_campaign.py and its live Justfile target still reference raw-framing tests deleted by this sprint" ;
  triage:description "scripts/fuzz/run_local_http_framing_campaign.py's TEST_PREFIX and four worker test names target a cargo test path under agent-team-mail-core's raw HTTP frame reader tests, all of which AM.2 deleted from crates/atm-core/src/api.rs. The script is wired live into the Justfile as the 'fuzz-local-http' recipe, so `just fuzz-local-http` will now find no matching tests and produce a broken/empty campaign report instead of a clear error. Found by ruthless-boundary-qa (RBQA-AM2-F001). AM.2's own sprint doc requires removing docs/deps/exports/tests belonging exclusively to the deleted raw-framing helpers; this orphaned fuzz harness is exactly that class of leftover." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "doc-gap" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
