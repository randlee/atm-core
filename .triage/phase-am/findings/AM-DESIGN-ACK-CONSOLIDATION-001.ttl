  triage:hasOccurrence <urn:atm:triage:occurrence/AM-DESIGN-ACK-CONSOLIDATION-001/o2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AM-DESIGN-ACK-CONSOLIDATION-001/o3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AM-DESIGN-ACK-CONSOLIDATION-001/o4> ;
  triage:triageRecordVersion "1" .

