<urn:atm:triage:finding/AM1-FINAL-001-DELETION-ORDER-CONTRADICTION>
  a triage:Finding ;
  triage:findingId "AM1-FINAL-001-DELETION-ORDER-CONTRADICTION" ;
  triage:title "Removal ledger's deletion-order table contradicts its own caller-before-callee rule" ;
  triage:description "docs/plans/phase-am/am1-removal-ledger.md's deletion-order table is self-contradictory: AM1-RM-002/003/005 say 'after AM1-RM-001', but AM1-RM-001's own row says 'after all listed callers are deleted', and the doc's own call-graph section states callers precede callees. Confirmed live: crates/atm-daemon-client/src/http_exchange.rs and lib.rs, crates/atm-daemon/src/local_ipc_transport.rs (request_worker, shutdown), crates/atm-daemon/src/local_tcp_transport.rs, and crates/atm-daemon/src/https_transport.rs all currently call HttpFrameReader (AM1-RM-001's symbol) -- they are callers and should precede AM1-RM-001 in deletion order, not follow it as the table currently states." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
