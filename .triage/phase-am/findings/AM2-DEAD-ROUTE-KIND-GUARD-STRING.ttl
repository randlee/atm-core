<urn:atm:triage:finding/AM2-DEAD-ROUTE-KIND-GUARD-STRING>
  a triage:Finding ;
  triage:findingId "AM2-DEAD-ROUTE-KIND-GUARD-STRING" ;
  triage:title "route_kind_for_http is dead in production but kept alive with #[allow(dead_code)] purely to satisfy a stale architecture-guard string check" ;
  triage:description "route_kind_for_http's only caller was the deleted decode_route_request; atm-http-runtime::message_handler now decodes requests itself. It was kept in crates/atm-core/src/api.rs marked #[allow(dead_code, reason=...)] (should be #[expect(dead_code, ...)] per guideline M-LINT-OVERRIDE-EXPECT) solely so the AI.23 architecture guard at crates/atm-architecture/tests/boundary_enforcement.rs:162 ('api.contains(\"fn route_kind_for_http\")') keeps passing. Found by rust-qa-agent (QA-002). The guard should instead assert against the new decode boundary (decode_framework_request / http_route_surface()); preserving dead production code purely to keep a textual guard green is backwards." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "guideline" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "function" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-10T20:10:00Z"^^xsd:dateTime ;
