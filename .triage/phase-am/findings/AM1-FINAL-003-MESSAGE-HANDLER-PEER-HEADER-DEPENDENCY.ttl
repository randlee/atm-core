<urn:atm:triage:finding/AM1-FINAL-003-MESSAGE-HANDLER-PEER-HEADER-DEPENDENCY>
  a triage:Finding ;
  triage:findingId "AM1-FINAL-003-MESSAGE-HANDLER-PEER-HEADER-DEPENDENCY" ;
  triage:title "New AL handler imports the peer-only header AM1-RM-006 slates for deletion, uncovered" ;
  triage:description "crates/atm-http-runtime/src/message_handler.rs (lines 11, 185-187, 271, 574 -- the new AL canonical typed HTTP handler) imports and branches on PEER_SOURCE_HOST_HEADER. docs/plans/phase-am/am1-removal-ledger.md's AM1-RM-006 row slates this exact symbol for AM.4 deletion but does not list message_handler.rs as a caller/incoming edge. Deleting PEER_SOURCE_HOST_HEADER as currently scoped would break atm-http-runtime's own build, since even the defensive rejection check at message_handler.rs:185-187 requires the symbol to exist to compile." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "COMPLETENESS" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
