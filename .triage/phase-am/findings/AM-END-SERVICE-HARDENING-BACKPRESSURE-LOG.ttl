  a triage:Finding ;
  triage:findingId "AM-END-SERVICE-HARDENING-BACKPRESSURE-LOG" ;
  triage:title "admission-saturation rejection emits no server-side log/metric" ;
  triage:description "QA-AM-CRITICAL-PHASEEND (minor, rust-service-hardening RSH-002): crates/atm-http-runtime/src/message_handler.rs:427's overload_response returns a typed DaemonConnectionSaturated error to the caller when Tower's LoadShedLayer rejects a request, but emits no server-side log/metric -- admission saturation is invisible from daemon-side logs. Fix: add a tracing::warn! (or observability event) inside overload_response." ;
