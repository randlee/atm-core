<urn:atm:triage:finding/AM5-WAL-TEST-FIXED-TEMPDIR-COLLISION>
  a triage:Finding ;
  triage:findingId "AM5-WAL-TEST-FIXED-TEMPDIR-COLLISION" ;
  triage:title "shared_db.rs WAL test uses a fixed OS temp-dir path instead of tempfile::tempdir()" ;
  triage:description "quality-mgr QA-AM5-1 (FTQ-001, flaky-test-qa): crates/atm-storage-rusqlite/src/shared_db.rs:993's WAL test constructs its path from a fixed OS temp directory plus a process-local counter rather than tempfile::tempdir(), and does not clean up on panic. This is a cross-test-run collision risk (two concurrent CI runs or a crashed prior run can collide on the same path) and a leaked-file risk on panic. Switch to tempfile::tempdir() for panic-safe, collision-free isolation." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-flakiness" ;
  triage:severity "important" ;
