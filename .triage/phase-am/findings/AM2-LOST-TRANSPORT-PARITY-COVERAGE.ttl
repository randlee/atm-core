<urn:atm:triage:finding/AM2-LOST-TRANSPORT-PARITY-COVERAGE>
  a triage:Finding ;
  triage:findingId "AM2-LOST-TRANSPORT-PARITY-COVERAGE" ;
  triage:title "The deleted UDS/TCP response-parity Rust integration test for atm-daemon-client's compatibility exchange was not replaced with an equivalent typed-client test" ;
  triage:description "The old atm-daemon-client integration test 'uds_and_tcp_modes_share_the_http_response_contract' spun up a real listener and round-tripped a request through both UDS and TCP transports, asserting they shared the same HTTP response contract. It was deleted along with the raw-framing helpers it exercised. No equivalent Rust integration test was added for the migrated typed-client path. rust-qa-agent independently did a real empirical check (built and ran `atm doctor --json` against this worktree, confirming daemon_connect: connected round-trips through the migrated typed local client) which is good evidence the migration works functionally, but that is a manual one-off check, not durable regression coverage. Coverage of the retained non-write compatibility exchange over a live socket now rests on unit tests plus the external Python smoke suite only. This directly overlaps arch-ctm's own am2-closure-checklist.md item 3 ('Add focused typed-client compatibility coverage for the retained non-write UDS and loopback-TCP paths, including an in-runtime caller'), which was checked off without adding a durable in-repo test that would catch a future regression the way the deleted test did." ;
  triage:phaseId "phase-am" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-10T20:10:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AM-S2 ;
  triage:foundAt "2026-08-10T20:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AM2-LOST-TRANSPORT-PARITY-COVERAGE/AM2-QA1-1> ;
  triage:triageRecordVersion "1" .

