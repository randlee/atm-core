<urn:atm:triage:finding/AO2-ARCH-BOUNDARY-TESTGAP-001>
  a triage:Finding ;
  triage:findingId "AO2-ARCH-BOUNDARY-TESTGAP-001" ;
  triage:title "AL5/AL6 architecture-fitness tests do not read lifecycle.rs after AO2-ARCH-001 split" ;
  triage:description "quality-mgr's correction to AOS2-QA-1 (PR #943, feature/pao-s2-optional-runtime-activation, commit 8e082939a): the AO2-ARCH-001 fix decomposed crates/atm-http-runtime/src/lib.rs into lib.rs + lifecycle.rs to satisfy the 1000-line lint gate, moving drain_server_group/bind_runtime_listeners/spawn_supervised_server/join_server_group into lifecycle.rs. Tests al5_uds_is_a_framework_adapter_over_the_one_client_and_router and al6_loopback_tcp_is_capability_authentication_over_the_one_client_and_router in crates/atm-architecture/tests/boundary_enforcement.rs only read lib.rs, http1_server.rs, private_staging.rs, unix_socket.rs/loopback_tcp.rs, client.rs -- they never read lifecycle.rs, so they now fail to see the moved functions." ;
  triage:phaseId "phase-ao" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage-gap" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-18T15:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO.2 ;
  triage:foundAt "2026-08-18T15:41:24Z"^^xsd:dateTime ;
