<urn:atm:triage:finding/AO1-BOUNDARY-002>
  a triage:Finding ;
  triage:findingId "AO1-BOUNDARY-002" ;
  triage:title "Boundary TOML missing dev-deps in allowlist" ;
  triage:description "rust-qa-agent/ruthless-boundary-qa flagged that the boundary manifest allowlist is missing required dev-dependency entries introduced by the peer-tls module rehome (feature/pao-s1-tls-module-rehome, PR #942), contributing to CI lint failures. The lint-config.toml file lists rcgen and tempfile in allowed_dependencies for crates/peer-tls/Cargo.toml, but these are dev-dependencies in the Cargo.toml, not production dependencies. They should be declared in a separate allowed_dev_dependencies field." ;
  triage:phaseId "phase-ao" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:closedAt "2026-08-18T06:15:00Z"^^xsd:dateTime ;
