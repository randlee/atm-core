<urn:atm:triage:finding/AO1-RSH-001>
  a triage:Finding ;
  triage:findingId "AO1-RSH-001" ;
  triage:title "Sync store/cert-load work not spawn_blocking'd on async accept/connect path" ;
  triage:description "rust-service-hardening-agent found that synchronous certificate-store loading work runs directly on the async TLS accept/connect path in the peer-tls module (feature/pao-s1-tls-module-rehome, PR #942) instead of being wrapped in spawn_blocking, risking executor-thread stalls under load. Identify the exact function(s)/file:line performing this sync work inline on the async path." ;
  triage:phaseId "phase-ao" ;
  triage:triageMode "initial_pass" ;
  triage:category "runtime-hardening" ;
