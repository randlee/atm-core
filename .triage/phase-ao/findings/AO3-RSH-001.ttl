<urn:atm:triage:finding/AO3-RSH-001>
  a triage:Finding ;
  triage:findingId "AO3-RSH-001" ;
  triage:title "No timeout on HTTP body-read phase in message_handler.rs" ;
  triage:description "rust-service-hardening-agent IMPORTANT finding from AO3-QA-1 (PR #945 @ 4408867ef): crates/atm-http-runtime/src/message_handler.rs:364 -- no timeout bounds the HTTP request body-read phase; a slow-drip body can hold a connection/permit indefinitely despite the byte-size cap. Note: this is the Tokio+Axum atm-http-runtime path (the target architecture), not the frozen legacy sync daemon -- fully in scope to fix." ;
  triage:correctionNote "quality-mgr: S1's own branch (feature/pao-s1-tls-module-rehome) never independently received this fix, but its PR (#942) already merged and closed 2026-08-18, prior to this finding's discovery -- it is dead history, not a live dispatch target. Closing the S1 occurrence on the basis that integrate/phase-ao HEAD b2c9eddbf (which supersedes S1's contribution) verifiably contains the fix, confirmed directly against source." ;
  triage:phaseId "phase-ao" ;
  triage:triageMode "initial_pass" ;
  triage:category "runtime-hardening" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-08-19T00:05:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-18T19:42:55Z"^^xsd:dateTime ;
