<urn:atm:triage:finding/AO1-QA-001>
  a triage:Finding ;
  triage:findingId "AO1-QA-001" ;
  triage:title "Flaky handshake-deadline test: fixed 5ms deadline races config-load against handshake stage" ;
  triage:description "The AO1-RSH-001 fix commit (bede69ff6) introduced a fixed 5ms RequestDeadline that races config-load (spawn_blocking) against the handshake stage at crates/peer-tls/src/lib.rs:850. The test hardcodes an assertion on the handshake-stage error message only; under CI runner load, config-load can consume the whole budget, producing a legitimate but differently-worded deadline error that fails the assertion. Confirmed by quality-mgr as the exact root cause of the live 'Test (macos-latest)' CI failure on PR #942 via job logs; 8/8 local runs passed (CI-load-dependent, not deterministic locally). Recommend widening the margin (>=50ms) and/or accepting either deadline-stage message in the assertion." ;
  triage:phaseId "phase-ao" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:closedAt "2026-08-17T23:58:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triagedAt "2026-08-18T06:40:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO.1 ;
  triage:foundAt "2026-08-18T06:34:12Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO1-QA-001/ao1-qa-001-1> ;
  triage:triageRecordVersion "1" .

