<urn:atm:triage:finding/AO3-RBP-F001>
  a triage:Finding ;
  triage:findingId "AO3-RBP-F001" ;
  triage:title "peer-tls uses generic AtmError::validation instead of peer_config_validation constructor" ;
  triage:description "rust-best-practices-agent IMPORTANT finding from AO3-QA-1 (PR #945 @ 4408867ef): crates/peer-tls/src/lib.rs (multiple lines) -- new TLS code uses generic AtmError::validation(...) instead of the more specific peer_config_validation constructor, misclassifying HTTP status/recovery-guidance contract." ;
  triage:phaseId "phase-ao" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-classification" ;
  triage:severity "important" ;
  triage:repeatable true ;
