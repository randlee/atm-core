  a triage:Finding ;
  triage:findingId "AO3-RBP-F002" ;
  triage:title "atm-storage tls.rs uses generic AtmError::validation instead of certificate_operation constructor" ;
  triage:description "rust-best-practices-agent IMPORTANT finding from AO3-QA-1 (PR #945 @ 4408867ef): crates/atm-storage/src/tls.rs:55-68 -- new TLS code uses generic AtmError::validation(...) instead of the more specific certificate_operation constructor, misclassifying HTTP status/recovery-guidance contract." ;
