<urn:atm:triage:finding/AO1-MINOR-003>
  a triage:Finding ;
  triage:findingId "AO1-MINOR-003" ;
  triage:title "Missing negative test for missing client certificate" ;
  triage:description "quality-mgr flagged (minor, non-blocking) that the peer-tls test suite (feature/pao-s1-tls-module-rehome, PR #942) covers the 'wrong client cert' negative case but not the 'missing client cert' negative case. The suite has: (1) configured_client_certificate_is_accepted_by_one_shot_fixture (positive), (2) mismatched_client_certificate_is_rejected_before_response (wrong cert), (3) rejects_untrusted_client_certificate_before_yielding_a_stream (wrong cert). The gap: no test covers the case where a client does not present a certificate at all (TLS client auth omitted)." ;
  triage:phaseId "phase-ao" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
