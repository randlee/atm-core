<urn:atm:triage:finding/AJ5-RSH-005-RELOAD-RACE-DATALOSS>
  a triage:Finding ;
  triage:findingId "AJ5-RSH-005-RELOAD-RACE-DATALOSS" ;
  triage:title "reload_runtime_view can silently discard concurrent touch_member/heartbeat updates landing during its disk-I/O window" ;
  triage:description "reload_runtime_view can silently discard concurrent touch_member/heartbeat updates that land during its disk-I/O window (refresh_https_trust), since it publishes unconditionally from a pre-reload snapshot. Found by rust-service-hardening-agent RSH-005." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
