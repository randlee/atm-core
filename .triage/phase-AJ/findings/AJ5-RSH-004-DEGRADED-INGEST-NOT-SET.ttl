<urn:atm:triage:finding/AJ5-RSH-004-DEGRADED-INGEST-NOT-SET>
  a triage:Finding ;
  triage:findingId "AJ5-RSH-004-DEGRADED-INGEST-NOT-SET" ;
  triage:title "build_runtime_status_cache_state failure on daemon startup never sets degraded_ingest, masking a genuine hydration failure" ;
  triage:description "On daemon startup, if build_runtime_status_cache_state fails (roster exceeds caps), the error is only logged; degraded_ingest is never set, so an empty-but-failed cache reports readiness=Ready, masking a genuine hydration failure. Found by rust-service-hardening-agent RSH-004. QA source: /Users/randlee/.config/atm/share/atm-dev/aj5-verdict.md, PR #740." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-04T05:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AJ-S5 ;
  triage:foundAt "2026-08-04T04:55:35Z"^^xsd:dateTime ;
