<urn:atm:triage:finding/AJ7-ATM-QA-007-LINT-COMMON-NOT-REUSED>
  a triage:Finding ;
  triage:findingId "AJ7-ATM-QA-007-LINT-COMMON-NOT-REUSED" ;
  triage:title "check_runtime_observation_boundary.py does not reuse lint_common's test-region exclusion helpers" ;
  triage:description "check_runtime_observation_boundary.py does not reuse lint_common's rust_file_test_scope/is_code_line helpers (used by the referenced 'existing environment-boundary guard' pattern) to exclude inline #[cfg(test)] regions from production scanning. It instead uses crude whole-file path/name exclusion, which could false-positive or false-negative on a production file with an inline test module referencing these tokens. Found by req-qa. QA source: PR #742, phase-aj-s7-qa-1." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
