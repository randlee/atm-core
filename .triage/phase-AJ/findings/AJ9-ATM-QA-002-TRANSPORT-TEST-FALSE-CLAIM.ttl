<urn:atm:triage:finding/AJ9-ATM-QA-002-TRANSPORT-TEST-FALSE-CLAIM>
  a triage:Finding ;
  triage:findingId "AJ9-ATM-QA-002-TRANSPORT-TEST-FALSE-CLAIM" ;
  triage:title "ADR-045's evidence table cites an unrelated single-process unit test as satisfying the UDS/TCP/heartbeat convergence requirement" ;
  triage:description "AJ.6's deliverable and the Phase AJ Exit Criteria require an integration test proving UDS+TCP+heartbeat ingress converge on one cache entry. No such test exists (only a single-process cache unit test and an unrelated Doctor-request round-trip). ADR-045's evidence table nonetheless cites runtime_status_cache_scoped_snapshot_reads_do_not_require_shared_locking (a single-process unit test with no transport involved) as if it satisfied this cross-transport requirement. Confirmed by req-qa, arch-qa. QA source: PR #744, phase-aj-s9-qa-1. Cross-reference: AJ6-ATM-QA-002-INTEGRATION-TEST-MISSING." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
