<urn:atm:triage:finding/AJ6-ATM-QA-002-INTEGRATION-TEST-MISSING>
  a triage:Finding ;
  triage:findingId "AJ6-ATM-QA-002-INTEGRATION-TEST-MISSING" ;
  triage:title "Required UDS send/read, heartbeat-without-session, TCP-loopback ack integration test does not exist" ;
  triage:description "Sprint doc requires 'a UDS send/read, heartbeat-without-session, and TCP-loopback ack integration test [that] proves the same member retains its known session when a later trusted command omits session metadata.' The only related test, heartbeat_session_metadata_is_retained_when_a_later_observation_is_absent (runtime_status_cache.rs), calls record_heartbeat_for_test directly in-process -- never touches a real UDS or TCP transport. No crates/atm-daemon/tests/ directory exists. Confirmed by req-qa, arch-qa, ruthless-boundary-qa, rust-qa-agent. QA source: PR #741, phase-aj-s6-qa-1." ;
  triage:phaseId "phase-AJ" ;
