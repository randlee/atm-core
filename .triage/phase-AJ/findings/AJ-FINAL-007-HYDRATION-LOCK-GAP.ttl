<urn:atm:triage:finding/AJ-FINAL-007-HYDRATION-LOCK-GAP>
  a triage:Finding ;
  triage:findingId "AJ-FINAL-007-HYDRATION-LOCK-GAP" ;
  triage:title "RuntimeStatusCache::publish_state is called outside the writer lock during dispatcher construction" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs's DaemonRequestDispatcher::new (~line 350) and new_for_test (~line 509) call status_cache.publish_state(state) directly on the Ok branch of initial hydration, bypassing the writer Mutex that every other cache-mutation path (merge_observation, reload_state, mark_degraded_ingest) serializes through. The sibling Err branch correctly takes the lock via mark_degraded_ingest -- the invariant 'all cache mutations serialize through writer' is inconsistently enforced at this one call site. Currently benign because construction runs single-threaded before any listener starts and has exactly one call site (composition.rs), but a future hot-reload path reusing this constructor is one refactor away from reintroducing the race the writer mutex was built to close. Found by rust-service-hardening-agent during Phase AJ's final holistic gate review. QA source: PR #759." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "phase_end_gate" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-05T18:03:01Z"^^xsd:dateTime ;
