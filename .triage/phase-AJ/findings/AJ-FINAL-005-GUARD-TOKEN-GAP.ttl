<urn:atm:triage:finding/AJ-FINAL-005-GUARD-TOKEN-GAP>
  a triage:Finding ;
  triage:findingId "AJ-FINAL-005-GUARD-TOKEN-GAP" ;
  triage:title "AJ.7 source-use guard is a narrow text-token grep that does not cover RuntimeMemberState/RuntimeStatusSnapshot or field-level names" ;
  triage:description ".just/check_runtime_observation_boundary.py and .just/lint-config.toml's [runtime-observation-boundary].tokens gate only on 3 exact PascalCase tokens (ActivityObservation, RuntimeMemberObservation, RuntimeObservationSource). RuntimeMemberState, RuntimeStatusSnapshot, and snake_case field/wrapper names (session_id, state_changed_by, with_activity_observation) are not covered. No current consumer exploits this -- verified via targeted field-access greps across crates/ -- but a future module that imports only RuntimeStatusSnapshot (already done safely today in crates/atm/src/output.rs for aggregate counts) and then reads per-member fields off it would defeat the guard silently: no token match, no violation flagged. Found independently by arch-qa and ruthless-boundary-qa (RBQA-F002) during Phase AJ's final holistic gate review. QA source: PR #759." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "phase_end_gate" ;
  triage:category "RBQA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-05T18:03:01Z"^^xsd:dateTime ;
  triage:foundIn triage:AJ-S10 ;
  triage:foundAt "2026-08-05T18:03:01Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AJ-FINAL-005-GUARD-TOKEN-GAP/AJFG-1> ;
  triage:triageRecordVersion "1" .

