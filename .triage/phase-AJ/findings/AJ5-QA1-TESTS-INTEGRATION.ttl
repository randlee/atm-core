<urn:atm:triage:finding/AJ5-QA1-TESTS-INTEGRATION>
  a triage:Finding ;
  triage:findingId "AJ5-QA1-TESTS-INTEGRATION" ;
  triage:title "AJ.5 missing 2 of 4 required integration tests: heartbeat_session_id_round_trip and heartbeat_and_local_dispatch_converge_on_cache" ;
  triage:description "Two of the four required integration tests are missing, confirmed by req-qa/arch-qa/ruthless-boundary-qa/rust-qa-agent independently: heartbeat_session_id_round_trip (full 3-step Some->None->Some response-contract round trip -- existing coverage only does 2 of 3 steps and checks the internal cache accessor, not the wire-level TeamMemberHeartbeatResponse.session_id) and heartbeat_and_local_dispatch_converge_on_cache (no test anywhere combines a real UDS/TCP local-dispatch touch with a real HTTP heartbeat decode path against the same identity -- all existing heartbeat tests call the dispatcher method directly in-process, bypassing transport adapters entirely). QA source: /Users/randlee/.config/atm/share/atm-dev/aj5-verdict.md, PR #740." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "TEST" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
