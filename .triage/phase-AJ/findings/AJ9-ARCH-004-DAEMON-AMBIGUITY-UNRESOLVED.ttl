<urn:atm:triage:finding/AJ9-ARCH-004-DAEMON-AMBIGUITY-UNRESOLVED>
  a triage:Finding ;
  triage:findingId "AJ9-ARCH-004-DAEMON-AMBIGUITY-UNRESOLVED" ;
  triage:title "AJ.9 leaves the architecture.md no-daemon-dependency vs sprint-doc daemon-enrichment ambiguity for atm members unresolved" ;
  triage:description "docs/architecture.md Section 6.9 ('Members Service': must succeed without daemon or hook-only state) and Section 21.6.3 (runtime-health observation boundary, the actual AJ.9 exact target) are never cross-referenced with each other or with RuntimeStatusCache/RuntimeMemberObservation. This is the exact ambiguity req-qa flagged in AJ.6 (base command must succeed without daemon state vs. daemon-sourced session/pid enrichment); AJ.9 leaves it unaddressed rather than resolving it with an explicit statement of how/whether atm members degrades when the daemon is unreachable. Found by arch-qa. QA source: PR #744, phase-aj-s9-qa-1. Cross-reference: AJ6-ATM-QA-006-ARCH-DOC-CONFLICT." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
