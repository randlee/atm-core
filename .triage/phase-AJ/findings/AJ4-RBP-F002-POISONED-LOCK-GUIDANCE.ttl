<urn:atm:triage:finding/AJ4-RBP-F002-POISONED-LOCK-GUIDANCE>
  a triage:Finding ;
  triage:findingId "AJ4-RBP-F002-POISONED-LOCK-GUIDANCE" ;
  triage:title "lock_runtime_mutex maps poisoned-lock errors to AtmError::daemon_unavailable with no cause/recovery guidance" ;
  triage:description "lock_runtime_mutex maps poisoned-lock errors to AtmError::daemon_unavailable with no cause/recovery guidance, even though the internal tracing::warn! text ('restart atm-daemon') never reaches the returned error. Found by rust-best-practices-agent RBP-F002. QA source: /Users/randlee/.config/atm/share/atm-dev/aj4-verdict.md, PR #739." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
