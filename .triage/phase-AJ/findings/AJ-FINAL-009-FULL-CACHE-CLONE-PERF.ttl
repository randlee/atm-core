<urn:atm:triage:finding/AJ-FINAL-009-FULL-CACHE-CLONE-PERF>
  a triage:Finding ;
  triage:findingId "AJ-FINAL-009-FULL-CACHE-CLONE-PERF" ;
  triage:title "merge_observation clones the entire bounded RuntimeStatusCache HashMap on every single write" ;
  triage:description "clone_state() (crates/atm-daemon/src/runtime_status_cache.rs, ~line 99) does self.state.load().as_ref().clone() on the full RuntimeStatusCacheState, called from merge_observation on every heartbeat/local-dispatch touch and from reload_state on every reload. This clones up to MAX_STATUS_CACHE_ENTRIES (4096) map entries even though only one entry actually changes per write, so per-write cost scales with total tracked population rather than the size of the update, on the primary write hot path (heartbeats + local dispatch touches). Recommend per-entry Arc-wrapping inside the map, or a structurally-shared map, so the ArcSwap-publish pattern stays O(1) per write. Found by rust-best-practices-agent (RBP-F001) during Phase AJ's final holistic gate review. QA source: PR #759." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "phase_end_gate" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
