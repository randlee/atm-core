<urn:atm:triage:finding/AJ9-ATM-QA-005-STALE-RECONCILIATION-MARKER>
  a triage:Finding ;
  triage:findingId "AJ9-ATM-QA-005-STALE-RECONCILIATION-MARKER" ;
  triage:title "docs/team-member-state.md's reconciliation marker simultaneously claims reconciliation is done and pending" ;
  triage:description "team-member-state.md's header was changed from 'Phase AJ planned target -- not implemented' to 'Phase AJ implemented contract... describes the reconciled AJ implementation,' but the following sentence, 'AJ.9 must reconcile each clause with merged implementation source and named tests before this marker is removed,' was left unchanged. The document now simultaneously claims the marker has already been replaced by a reconciled version and instructs that the marker should be removed only once that reconciliation happens -- and per AJ9-ATM-QA-001/002/003, that reconciliation has not actually happened for the roster-projection clause. Confirmed independently by req-qa, arch-qa, ruthless-boundary-qa, rust-qa-agent. QA source: PR #744, phase-aj-s9-qa-1." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
