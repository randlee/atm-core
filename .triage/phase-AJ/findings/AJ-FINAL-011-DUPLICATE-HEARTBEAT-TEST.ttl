  a triage:Finding ;
  triage:findingId "AJ-FINAL-011-DUPLICATE-HEARTBEAT-TEST" ;
  triage:title "Duplicate heartbeat_session_id_round_trip test left over from the PR #758 merge-content-loss recovery" ;
  triage:description "heartbeat_session_id_round_trip is defined near-verbatim in both crates/atm-daemon/src/tests.rs (~line 429) and crates/atm-daemon/src/integration_tests.rs (~line 26) -- only the session-name literal differs ('round-trip' vs 'three-step'). This is an artifact of PR #758's hunk-recovery reapplying a dropped test without removing the copy that had already been relocated to tests.rs. Recommend keeping the integration_tests.rs copy (that module's doc comment scopes it to cross-transport regressions) and removing the tests.rs duplicate. Found by rust-best-practices-agent during Phase AJ's final holistic gate review. QA source: PR #759." ;
