<urn:atm:triage:finding/AJ7-ATM-QA-001-TEST-NOT-COLLECTED>
  a triage:Finding ;
  triage:findingId "AJ7-ATM-QA-001-TEST-NOT-COLLECTED" ;
  triage:title "The runtime-observation-boundary guard's only regression test is never collected or run by just lint" ;
  triage:description ".just/tests/test_runtime_observation_boundary.py defines a bare 'def test_guard_accepts_phase_aj_sources()' function, not a unittest.TestCase subclass -- every other file in .just/tests/ (including the sprint doc's own named reference pattern, test_check_env_var_boundary.py) uses a TestCase class. .just/run_pytests.py collects tests via unittest.defaultTestLoader.loadTestsFromModule(module), which only discovers TestCase subclasses. Confirmed via direct grep of run_pytests.py's loader mechanism (quality-mgr) and via a local pytest run showing 56 collected fixtures with no test_runtime_observation_boundary entry (req-qa). The guard shipped with zero executing test coverage under just lint despite status:complete. QA source: PR #742, phase-aj-s7-qa-1." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
