<urn:atm:triage:finding/AJ-FINAL-013-AUDIT-LOG-NO-RATE-BOUND>
  a triage:Finding ;
  triage:findingId "AJ-FINAL-013-AUDIT-LOG-NO-RATE-BOUND" ;
  triage:title "emit_metadata_change has no rate/dedup bound even for trusted local callers" ;
  triage:description "The retained observability sink behind emit_metadata_change (crates/atm-daemon/src/runtime_status_cache.rs, ~line 264) has no throttling, coalescing, or per-key cooldown before writing to the retained log; the only guard is 'only emit on state/pid/session change' inside merge_observation itself. A legitimate local session rapidly cycling pid/session_id (e.g. a buggy hook loop) can still write unbounded events to the retained log. Low severity standalone since local ingress is trusted, but it compounds the severity of AJ-FINAL-001 (heartbeat ingress trust-boundary gap, already being fixed under GO-AJ-FINAL-GATE-1) if that gap is ever reopened. Found by rust-service-hardening-agent during Phase AJ's final holistic gate review. QA source: PR #759." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "phase_end_gate" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
