<urn:atm:triage:finding/AJ4-QA1-SESSION-PROVENANCE-BUG>
  a triage:Finding ;
  triage:findingId "AJ4-QA1-SESSION-PROVENANCE-BUG" ;
  triage:title "merge_observation stamps session_changed_by/at unconditionally instead of gating on session_changed" ;
  triage:description "merge_observation's session_changed_by/session_changed_at fields are stamped on every call carrying Some(session_id), even when identical to the cached value -- not gated by the session_changed boolean computed one line above, unlike the correctly-gated state_changed_by/state_changed_at. Violates sprint-AJ4.md's explicit 'session provenance changes only on a session edge' contract. Location: crates/atm-daemon/src/runtime_status_cache.rs ~186-194. Confirmed by req-qa, rust-qa-agent, and quality-mgr direct verification. QA source: /Users/randlee/.config/atm/share/atm-dev/aj4-verdict.md, PR #739." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "BUG" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-04T04:55:01Z"^^xsd:dateTime ;
  triage:foundIn triage:AJ-S4 ;
  triage:foundAt "2026-08-04T04:50:14Z"^^xsd:dateTime ;
