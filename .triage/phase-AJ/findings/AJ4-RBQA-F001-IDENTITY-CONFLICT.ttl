<urn:atm:triage:finding/AJ4-RBQA-F001-IDENTITY-CONFLICT>
  a triage:Finding ;
  triage:findingId "AJ4-RBQA-F001-IDENTITY-CONFLICT" ;
  triage:title "record_identity_conflict duplicates cache-mutation logic; merge_observation silently clears IdentityConflict on ordinary traffic" ;
  triage:description "merge_observation is NOT actually the sole cache-mutation owner the sprint doc claims. record_identity_conflict is a completely separate function that hand-rolls its own cache.members.insert with 3 redundant get() lookups instead of the entry-based merge pattern. Worse: merge_observation's state_changed check (record.state != state) has no special case for RuntimeMemberState::IdentityConflict -- any ordinary local send/read/ack (state=Active) silently clears an existing IdentityConflict flag and flips daemon readiness from Degraded back to Ready, with no dead-pid liveness check (unlike the heartbeat retry path, which correctly gates this via process_is_alive). This directly violates ADR-045's stated rule that identity-conflict resolution occurs only through the heartbeat dead-pid-retry mechanism. Location: crates/atm-daemon/src/runtime_status_cache.rs 149(merge_observation)/222-270(record_identity_conflict). Found by ruthless-boundary-qa RBQA-F001, independently verified by quality-mgr. QA source: /Users/randlee/.config/atm/share/atm-dev/aj4-verdict.md, PR #739." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-03T22:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AJ-S4 ;
  triage:foundAt "2026-08-04T04:50:14Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AJ4-RBQA-F001-IDENTITY-CONFLICT/AJ4-S4-1> ;
  triage:triageRecordVersion "1" .

