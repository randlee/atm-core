<urn:atm:triage:finding/AJ6-ATM-QA-006-ARCH-DOC-CONFLICT>
  a triage:Finding ;
  triage:findingId "AJ6-ATM-QA-006-ARCH-DOC-CONFLICT" ;
  triage:title "docs/architecture.md's no-daemon-dependency claim for atm members conflicts with sprint-AJ6.md's daemon-enrichment requirement" ;
  triage:description "docs/architecture.md states the retained members surface 'must succeed without daemon or hook-only state' (local roster inspection service), while sprint-AJ6.md and plan-phase-aj.md's Phase Exit Criteria require atm members to render live daemon-only RuntimeStatusCache data (state, session, pid). Neither document explains how the daemon-sourced enrichment is reconciled with the architecture's no-daemon-dependency baseline (e.g. via best-effort daemon query with graceful local-only fallback). This ambiguity is a plausible contributing cause of AJ6-ATM-QA-001. Found by req-qa. QA source: PR #741, phase-aj-s6-qa-1." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
