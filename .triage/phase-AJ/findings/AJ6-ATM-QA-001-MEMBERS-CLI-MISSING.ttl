<urn:atm:triage:finding/AJ6-ATM-QA-001-MEMBERS-CLI-MISSING>
  a triage:Finding ;
  triage:findingId "AJ6-ATM-QA-001-MEMBERS-CLI-MISSING" ;
  triage:title "atm members CLI runtime-observation projection was never implemented despite AJ.6 status: complete" ;
  triage:description "crates/atm/src/commands/members.rs is byte-for-byte untouched by any AJ.6 commit. MembersCommand::run still only calls team_admin::list_members_with_roster_store / output::print_members_result -- pure static-roster types (MembersList/MemberSummary) carrying no state/session_id/pid/timestamp fields at all. There is zero code path from atm members into RuntimeStatusCache, snapshot_for_members(), or RuntimeMemberObservation anywhere in the atm crate. The required short_session_id_for_human helper does not exist anywhere in the repository (only mentioned in the sprint doc itself). Confirmed independently by req-qa, arch-qa, ruthless-boundary-qa, and rust-qa-agent via matching grep evidence. QA source: PR #741, phase-aj-s6-qa-1." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
