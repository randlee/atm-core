<urn:atm:triage:finding/AJ4-RSH-001-CONCURRENCY-RACE>
  a triage:Finding ;
  triage:findingId "AJ4-RSH-001-CONCURRENCY-RACE" ;
  triage:title "RuntimeStatusCache clone-mutate-publish over ArcSwap has no CAS retry loop; concurrent dispatch can lose updates" ;
  triage:description "RuntimeStatusCache's clone-mutate-publish over ArcSwap has no compare-and-swap retry loop. Since touch_member now fires on every local Write/Receive dispatch (not just periodic heartbeats), concurrent requests racing through publish_state can silently lose each other's cache updates to any other key in the map -- realistic under normal multi-agent concurrent traffic, not theoretical. reload_runtime_view widens the same race further across a disk-I/O window (refresh_https_trust). Found by rust-service-hardening-agent RSH-001, corroborated from a cost angle by rust-best-practices-agent RBP-F001 (full-map-clone cost concern)." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-03T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AJ-S4 ;
  triage:foundAt "2026-08-04T04:50:14Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AJ4-RSH-001-CONCURRENCY-RACE/S4-1> ;
