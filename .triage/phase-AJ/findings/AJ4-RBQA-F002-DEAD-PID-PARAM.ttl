<urn:atm:triage:finding/AJ4-RBQA-F002-DEAD-PID-PARAM>
  a triage:Finding ;
  triage:findingId "AJ4-RBQA-F002-DEAD-PID-PARAM" ;
  triage:title "dispatch.rs computes cached_pid.is_some_and(...) and passes it as a discarded _pid_changed parameter -- dead duplicated computation" ;
  triage:description "dispatch.rs computes cached_pid.is_some_and(...) and passes it as record_heartbeat's _pid_changed parameter, which is immediately discarded (leading underscore) since merge_observation independently recomputes and returns the real answer via ObservationMergeOutcome.pid_changed -- dead duplicated computation. Found by ruthless-boundary-qa RBQA-F002. QA source: /Users/randlee/.config/atm/share/atm-dev/aj4-verdict.md, PR #739." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "important" ;
  triage:repeatable false ;
