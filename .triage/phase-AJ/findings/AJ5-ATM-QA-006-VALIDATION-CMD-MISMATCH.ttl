<urn:atm:triage:finding/AJ5-ATM-QA-006-VALIDATION-CMD-MISMATCH>
  a triage:Finding ;
  triage:findingId "AJ5-ATM-QA-006-VALIDATION-CMD-MISMATCH" ;
  triage:title "sprint-AJ5.md's Required Validation rg command targets runtime_health.rs directly but the code now lives in runtime_health/dispatch.rs after the split" ;
  triage:description "record_heartbeat/merge_observation now live in runtime_health/dispatch.rs, not runtime_health.rs directly. The sprint doc's own literal Required Validation command (rg -n 'merge_observation|...' crates/atm-daemon/src/runtime_health.rs crates/atm-daemon/src/runtime_status_cache.rs) returns zero matches against runtime_health.rs and so cannot 'show the shared merge flow' as claimed -- the specified evidence command doesn't prove what it's supposed to prove given the actual file layout after the dispatch.rs split (introduced by AJ.4)." ;
  triage:phaseId "phase-AJ" ;
  triage:triageMode "initial_pass" ;
  triage:category "DOC" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
