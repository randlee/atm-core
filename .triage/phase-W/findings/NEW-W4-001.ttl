@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/NEW-W4-001>
  a triage:Finding ;
  triage:findingId "NEW-W4-001" ;
  triage:title "record_heartbeat unconditionally resets sqlite_ready=true, masking prior failure signals" ;
  triage:description "crates/atm-daemon/src/runtime_status_cache.rs:126-127: record_heartbeat unconditionally sets sqlite_ready=true and clears sqlite_detail=None on every successful heartbeat. Any prior mark_sqlite_unavailable_with_detail() signal (e.g., writer_shutdown_join failure, writer_submit timeout) is permanently masked by the next heartbeat. Sprint-W4.md:82-88 requires shared doctor/runtime-health surfaces to accurately reflect SQLite subsystem state. Fix: remove the unconditional sqlite_ready=true / sqlite_detail=None reset from record_heartbeat. Only mark_sqlite_available() or full boundary reassembly should reset the sqlite_ready flag." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-daemon/src" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-13T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/NEW-W4-001/integrate-phase-W/1> ,
                       <urn:atm:triage:occurrence/NEW-W4-001/integrate-phase-W/2> ;
  triage:openOn <urn:atm:triage:worktree/integrate-phase-W/8104e6a> ;
  triage:promoteTo <urn:atm:triage:worktree/integrate-phase-W/8104e6a> ;
  triage:resolutionNote "Verified fixed on the W.7 merge-forward head. RuntimeStatusCache::record_heartbeat no longer resets sqlite_ready/sqlite_detail, so prior sqlite degradation remains visible until mark_sqlite_available() or boundary reassembly clears it." ;
  triage:fixedOn <urn:atm:triage:worktree/pW-s7/4540ef2> ;
  triage:fixedOn <urn:atm:triage:worktree/integrate-phase-W/4540ef2> .

