<urn:atm:triage:finding/ATM-QA-W2-R2-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-W2-R2-002" ;
  triage:title "GraftClient::connect() uses NullObservability — graft bootstrap traceability silently discarded" ;
  triage:description "crates/atm-graft/src/lib.rs line 201: BootstrapTraceability is constructed and ensure_daemon_available_with_traceability is called correctly, but the observability sink is NullObservability which always returns Ok(()) with no output. CLI bootstrap path uses a live CliObservability sink. Sprint-W2.md AC requires same-host interface parity for daemon-unavailable/auto-start/launch-gate failure classes across CLI and atm-graft. Fix: supply a non-null observability sink, or add an explicit comment acknowledging this as an accepted limitation so doc-auditing can verify it is intentional." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "observability" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
