<urn:atm:triage:finding/ATM-QA-W7-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-W7-004" ;
  triage:title "build_runtime_status_cache_state missing sqlite_ready reset comment" ;
  triage:description "runtime_status_cache.rs always initializes sqlite_ready: true in next_state inside build_runtime_status_cache_state. No comment documents that callers (DaemonRequestDispatcher::reload_runtime_view, DaemonRequestDispatcher::new) are responsible for re-calling mark_sqlite_unavailable() if assembly fails. Fix: Add inline comment at the sqlite_ready: true field documenting that this function always initializes sqlite_ready=true and callers own the re-application of unavailability marks." ;
  triage:phaseId "phase-W" ;
  triage:category "missing-invariant-comment" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-13T00:00:00Z"^^xsd:dateTime ;
