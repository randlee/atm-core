@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/RBP-W3-F001>
  a triage:Finding ;
  triage:findingId "RBP-W3-F001" ;
  triage:title "emit_subsystem_event uses bare &'static str for subsystem/action/outcome parameters" ;
  triage:description """DaemonRuntimeObservability trait (crates/atm-daemon/src/daemon_runtime_observability.rs:130-137) uses bare &'static str for subsystem, action, and outcome parameters in emit_subsystem_event. RBP Newtype/Zero-Cost Abstraction pattern requires ActionName/OutcomeLabel/SubsystemName newtypes where they exist, or explicit documentation of why &'static str is acceptable if newtypes are unavailable. Open from W.3 QA-1; carried forward unfixed through W.3 fix-R1. Per initial triage: impl validates via ActionName::new/OutcomeLabel::new inside mapping helpers and &'static str prevents dynamic-string injection, so risk is lower — but the trait boundary itself does not enforce correctness. Severity: minor. Four occurrences confirmed on integrate/phase-W at 8104e6a: trait definition (daemon_runtime_observability.rs:130), pub(crate) helper (daemon_observability.rs:182), DaemonObservability impl (daemon_observability.rs:336), and TestDaemonObservability impl (test_observability.rs:183). All four must be updated together when the fix is applied.""" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-W" ;
  triage:severity "minor" ;
  triage:severityDowngradedFrom "important" ;
  triage:severityDowngradeReason "impl validates via ActionName::new/OutcomeLabel::new mapping helpers and returns Err; &'static str prevents dynamic-string injection; no silent pass possible in practice" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-daemon/src" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-13T00:00:00Z"^^xsd:dateTime ;
  triage:references "TASK-1505 quality-mgr verdict W.3 QA-2 carry-forward" ;
  triage:references "RBP-W3-F001.ttl prior record at pW-s3/2f245dc" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-W3-F001/integrate-phase-W/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-W3-F001/integrate-phase-W/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-W3-F001/integrate-phase-W/3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-W3-F001/integrate-phase-W/4> ;
  triage:openOn <urn:atm:triage:worktree/integrate-phase-W/8104e6a> ;
  triage:promoteTo <urn:atm:triage:worktree/integrate-phase-W/8104e6a> .

