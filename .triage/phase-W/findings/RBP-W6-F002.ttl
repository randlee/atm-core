<urn:atm:triage:finding/RBP-W6-F002>
  a triage:Finding ;
  triage:findingId "RBP-W6-F002" ;
  triage:title "DaemonEvent::new takes &'static str params bypassing ActionName/OutcomeLabel at entry" ;
  triage:description "crates/atm-daemon/src/daemon_runtime_observability.rs:72 — DaemonEvent::new takes action: &'static str, outcome: &'static str and .expect()s them into ActionName/OutcomeLabel at lines 79-81. Public-facing signature bypasses the newtype at entry, introduces two runtime panic sites for what are validated at construction anyway. Fix: Change DaemonEvent::new parameters to ActionName and OutcomeLabel directly. Update SubsystemObservability::event (line 190) to validate literals at that call site instead." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-13T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-W6-F002/pW-s6/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-W6-F002/pW-s6/2> ;
  triage:openOn <urn:atm:triage:worktree/pW-s6/d27de5a2c54db23b4576ca28d57d89b2681f971a> ;
  triage:promoteTo <urn:atm:triage:worktree/pW-s6/d27de5a2c54db23b4576ca28d57d89b2681f971a> .

