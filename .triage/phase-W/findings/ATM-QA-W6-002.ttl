<urn:atm:triage:finding/ATM-QA-W6-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-W6-002" ;
  triage:title "sqlite_ready check priority over degraded_ingest undocumented at runtime_status_cache.rs:511" ;
  triage:description "crates/atm-daemon/src/runtime_status_cache.rs:511 — When sqlite_ready=false AND degraded_ingest=true, WarningSqliteHealthDegraded is emitted because sqlite check is first. The combined case surfaces only the sqlite code, not ingest degradation. Correct per design, but the ordering is undocumented. Fix: Add a comment at line 511 explaining sqlite_ready check takes priority in the combined case so the most actionable code surfaces first." ;
  triage:triageMode "initial_pass" ;
  triage:category "doc/comment" ;
  triage:phaseId "phase-W" ;
