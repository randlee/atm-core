  triage:snippet "let _ =\n            self.composition_observability\n                .emit(\"start_requested\", \"ok\", \"daemon start requested\");" ;
  triage:fixSnippet "self.composition_observability.emit_or_warn(\"start_requested\", \"ok\", \"daemon start requested\");" ;
  triage:context "start()" ;
