  triage:resolutionNote "Verified fixed on the W.7 merge-forward head. peer_transport.rs now carries the required .with_recovery(...) guidance on the four send_once daemon_unavailable branches: connect, read-timeout setup, write-timeout setup, and response-frame decode." ;
  triage:fixedOn <urn:atm:triage:worktree/pW-s7/4540ef2> ;
