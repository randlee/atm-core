# ─── Finding ────────────────────────────────────────────────────────────────
<urn:atm:triage:finding/ATM-QA-W4-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-W4-002" ;
  triage:title "send_once connect failure missing .with_recovery()" ;
  triage:description "crates/atm-daemon/src/peer_transport.rs: AtmError::daemon_unavailable calls in send_once (connect, set_read_timeout, set_write_timeout, decode-response) have no .with_recovery(). V.4 Category Binding maps socket/connect failures to required recovery text. Fix: add .with_recovery('Verify the remote peer endpoint is reachable and the remote daemon is running. Check the peer endpoint configuration.') or equivalent per V.4 table." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-13T00:00:00Z"^^xsd:dateTime ;

  # occurrences on feature/pW-s4-peer-replay-recovery
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-W4-002/pW-s4/1> ;
