<urn:atm:triage:finding/RBP-W1-F003>
  a triage:Finding ;
  triage:findingId "RBP-W1-F003" ;
  triage:title "Silent lock-poison discard in runtime_status_cache.rs" ;
  triage:description "crates/atm-daemon/src/runtime_status_cache.rs:166 — mark_sqlite_unavailable returns () and silently discards a lock-poison error via tracing::error!. Document the silent-discard contract explicitly or return Result<(), AtmError> so callers can escalate." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
