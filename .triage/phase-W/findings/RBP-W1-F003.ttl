<urn:atm:triage:finding/RBP-W1-F003>
  a triage:Finding ;
  triage:findingId "RBP-W1-F003" ;
  triage:title "runtime_status_cache.rs mark_sqlite_unavailable silent-discard contract not documented" ;
  triage:description "mark_sqlite_unavailable Err(_) arm at crates/atm-daemon/src/runtime_status_cache.rs has tracing::error! (added in fix-R1) but still lacks a comment explaining why the error cannot be propagated: function returns () — propagation is impossible, tracing::error! is max-severity available at this boundary. Fix: add inline comment explaining the silent-discard contract." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "followup_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
