  triage:line 370 ;
  triage:snippet "while Instant::now() < deadline { if try_connect().is_ok() { ... } thread::sleep(poll_interval); } // missing: traceability.emit(\"daemon_auto_start\", \"publish_wait_continuing\", None)" ;
  triage:status "open" ;
