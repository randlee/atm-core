<urn:atm:triage:finding/RBP-W7-F001>
  a triage:Finding ;
  triage:findingId "RBP-W7-F001" ;
  triage:title "replay_metadata_for_request unreachable Err variant" ;
  triage:description "peer_transport.rs:657 — replay_metadata_for_request returns Result<Option<(TeamName, AgentName, MessageKey)>, AtmError> but both match arms produce Ok(...) — the AtmError Err variant is never constructed. Caller at line 283 propagates with ? that can never fire. Fix: Simplify return type to Option<(TeamName, AgentName, MessageKey)>. Update call site at line 283 accordingly." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "infallible-result" ;
  triage:severity "minor" ;
  triage:repeatable true ;
