<urn:atm:triage:finding/ARCH-001-W>
  a triage:Finding ;
  triage:findingId "ARCH-001-W" ;
  triage:title "Direct sc_observability import in atm-daemon library crate module — RULE-001 violation" ;
  triage:description "crates/atm-daemon/src/daemon_observability.rs:17-19: Direct `use sc_observability::` import in a library crate module. atm-daemon is a library crate (has lib.rs, no binary entry point). RULE-001 forbids library crate modules from importing sc_observability directly — that wiring belongs at the binary entry point. Remediation: Move DaemonObservability struct (and its sc_observability imports) to the binary crate (crates/atm/src/main.rs or a dedicated binary crate). The library surface already supports injection via run_daemon_with_observability — pass an Arc<dyn DaemonRuntimeObservability> factory from the binary. The atm-daemon library crate retains only the trait definitions (DaemonRuntimeObservability, DaemonRuntimeObservabilityExt), not the sc_observability-backed impl." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-daemon/src" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-13T00:00:00Z"^^xsd:dateTime ;
