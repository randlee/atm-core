  triage:title "Unstructured tracing::warn! in peer_transport.rs" ;
  triage:description "crates/atm-daemon/src/peer_transport.rs:55 has tracing::warn! with no structured fields. Must add: tracing::warn!(subsystem = \"peer_transport\", action = \"env_parse\", \"ignoring non-unicode ATM_DAEMON_PEER_ADDR value\"). Repeatable sweep also found crates/atm-daemon/src/local_ipc_transport.rs:902 with the same unstructured pattern." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "structured-logging" ;
