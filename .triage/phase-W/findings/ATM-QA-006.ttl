<urn:atm:triage:finding/ATM-QA-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-006" ;
  triage:title "GraftClient::connect() calls ensure_daemon_available() without traceability" ;
  triage:description "GraftClient::connect() at crates/atm-graft/src/lib.rs:200 calls ensure_daemon_available() instead of ensure_daemon_available_with_traceability(). Direct parity violation — atm-graft host interface has no W.2 attempt-level traceability." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
