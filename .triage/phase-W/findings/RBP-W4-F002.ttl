<urn:atm:triage:finding/RBP-W4-F002>
  a triage:Finding ;
  triage:findingId "RBP-W4-F002" ;
  triage:title "Mutex guard held across emit() call in mark_sqlite_unavailable" ;
  triage:description "crates/atm-daemon/src/runtime_status_cache.rs line 193 (mark_sqlite_unavailable): holds MutexGuard during self.observability.emit(...) call — emit may block; holding the lock extends critical section unnecessarily. Fix: drop the guard before calling emit(), or restructure to minimize lock scope." ;
