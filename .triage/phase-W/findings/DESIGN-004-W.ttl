<urn:atm:triage:finding/DESIGN-004-W>
  a triage:Finding ;
  triage:findingId "DESIGN-004-W" ;
  triage:title "W.1 partial typed fallback: DaemonEvent.action/outcome still raw &'static str" ;
  triage:description """RBP-W3-F001 improved emit_subsystem_event to use typed ActionName/OutcomeLabel newtypes (daemon_runtime_observability.rs:140-141), but DaemonEvent struct fields action and outcome remain raw &'static str (lines 59-60). DaemonEvent::new() (lines 73-74), SubsystemLogger::event() (lines 189-190), and SubsystemLogger::emit_or_warn() (lines 225-226) all carry the untyped signature through. Downstream: bin_support/daemon_observability.rs EmitLogEvent private struct (lines 367-368) and #[cfg(test)] observability_test_event helper (lines 749-750) construct DaemonEvent with bare &'static str. ActionName/OutcomeLabel are available via sc_observability_types type aliases already imported in daemon_runtime_observability.rs. The type improvement from RBP-W3-F001 is incomplete at the DaemonEvent boundary.""" ;
  triage:triageMode "initial_pass" ;
  triage:category "DESIGN" ;
  triage:phaseId "phase-W" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-13T00:00:00Z"^^xsd:dateTime ;
  triage:references "arch-ctm design review follow-up 2026-05-13" ;
  triage:references "docs/phase-W/sprint-W1.md" ;
  triage:references "integrate/phase-W:.triage/phase-W/findings/RBP-W3-F001.ttl" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/DESIGN-004-W/integrate-phase-W/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/DESIGN-004-W/integrate-phase-W/2> ;
