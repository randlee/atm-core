<urn:atm:triage:finding/ATM-QA-W8-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-W8-002" ;
  triage:title "rustfmt import ordering violation in sqlite_observability.rs" ;
  triage:description "crates/atm-daemon/src/sqlite_observability.rs lines 6-7: `use crate::DaemonSubsystem;` appears before `use crate::DaemonRuntimeObservability;`, violating alphabetical rustfmt import ordering. This is the CI Format FAIL at a2358bd. The integrate branch (a5aa8c4) already has the correct state: DaemonSubsystem import removed entirely (DaemonSubsystem::Sqlite replaced with literal string \"sqlite\" in emit_subsystem_event call at line 60), and DaemonRuntimeObservability remains. Fix on feature/pW-s8: remove `use crate::DaemonSubsystem;` and replace `DaemonSubsystem::Sqlite` at line 60 with `\"sqlite\"` to align with integrate/phase-W state." ;
  triage:category "QA" ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:severity "minor" ;
  triage:repeatable false ;
