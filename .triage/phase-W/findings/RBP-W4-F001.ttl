<urn:atm:triage:finding/RBP-W4-F001>
  a triage:Finding ;
  triage:findingId "RBP-W4-F001" ;
  triage:title "heartbeat_message_key structurally unreachable Result" ;
  triage:description "crates/atm-daemon/src/peer_transport.rs: heartbeat_message_key returns Result<MessageKey, AtmError> but the error arm is structurally unreachable given current call site — misleads callers about fallibility. Fix: return MessageKey directly, or document the invariant with a comment if the Result is kept for future extensibility." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-W" ;
  triage:severity "minor" ;
