<urn:atm:triage:finding/ARCH-002>
  a triage:Finding ;
  triage:findingId "ARCH-002" ;
  triage:title "BootstrapTraceability reads ATM_IDENTITY/ATM_TEAM env vars inside daemon-client (wrong layer)" ;
  triage:description "BootstrapTraceability::new() at crates/atm-daemon-client/src/lib.rs:419 reads ATM_IDENTITY and ATM_TEAM environment variables. Identity resolution is a composition-layer concern — it must be removed from atm-daemon-client and passed as parameters instead." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "important" ;
