<urn:atm:triage:finding/RBP-W6-F003>
  a triage:Finding ;
  triage:findingId "RBP-W6-F003" ;
  triage:title "RetainedJsonlFileSink three Mutex fields missing rationale and lock-order comment" ;
  triage:description "crates/atm-daemon/bin_support/daemon_observability.rs lines 523-526: RetainedJsonlFileSink has three independent Mutex fields (health, last_written_file, last_prune_request_at) with no rationale comment. LogSink::write (line 700-707) acquires last_written_file then health — lock ordering is implicit and undocumented. No comment explains why three separate locks rather than one, or documents the acquisition order. Fix: add a comment on the struct or fields documenting (1) what each mutex guards, (2) why three locks rather than one, (3) lock-acquisition order (last_written_file before health in write path)." ;
  triage:phaseId "phase-W" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:pattern "RBP-006" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
