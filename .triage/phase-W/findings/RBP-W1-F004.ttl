<urn:atm:triage:finding/RBP-W1-F004>
  a triage:Finding ;
  triage:findingId "RBP-W1-F004" ;
  triage:title "No operator recovery hints in spawn_shutdown_step / complete_shutdown_step" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs:114 — spawn_shutdown_step / complete_shutdown_step swallow step errors and panics with only tracing::warn! and no recovery hints. Add operator-facing recovery hint to the warn! message." ;
