triage:R17-CI-WIN-002 a triage:Finding ;
  triage:findingId "R17-CI-WIN-002" ;
  triage:title "UnixListener/UnixStream usage sites without cfg(unix) gating" ;
  triage:description "Companion to R17-CI-WIN-001. After gating the import, usage sites of UnixListener and UnixStream in tests.rs must also be gated with #[cfg(unix)] or the entire test module must be gated. Sweep identifies all usage sites that require conditional compilation to fix the Windows CI blocker." ;
  triage:triageMode "initial_pass" ;
  triage:category "CI-WIN" ;
  triage:category triage:CI-WIN ;
  triage:phaseId "phase-R" ;
  triage:severity "blocking" ;
  triage:severity triage:blocking ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:highestOpenBranch "R.17" ;
  triage:promoteToBranch "R.17" ;
  triage:triagedAt "2026-05-07T00:00:00Z"^^xsd:dateTime ;
  triage:branchSummary """R.15: open, R.16: open, R.17: open""" .

