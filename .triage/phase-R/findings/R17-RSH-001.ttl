triage:R17-RSH-001 a triage:Finding ;
  triage:findingId "R17-RSH-001" ;
  triage:title "Condvar::wait called without timeout in watch_runtime.rs" ;
  triage:description "In crates/atm-daemon/src/watch_runtime.rs line 330, Condvar::wait() is called with no timeout: 'state = match inner.wake.wait(state)'. An unbounded wait is a liveness hazard. Should use wait_timeout or wait_timeout_while with a bounded duration." ;
  triage:category triage:RSH ;
  triage:severity triage:important ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-R" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status triage:open ;
  triage:dispatchReady true ;
