# Finding: R15-RBP-F004
# AtmError::identity_conflict missing .with_recovery()

triage:R15-RBP-F004
  a triage:Finding ;
  triage:findingId "R15-RBP-F004" ;
  triage:title "AtmError::identity_conflict missing .with_recovery()" ;
  triage:description "In crates/atm-daemon/src/runtime_health.rs, AtmError::identity_conflict returns an error without chaining .with_recovery(). The error constructor pattern in this codebase requires a recovery hint. All occurrences across R.15, R.16, and R.17 branches lack the .with_recovery() call." ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:phaseId "phase-R" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-07T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch triage:R17-occurrence ;
  triage:promoteToBranch "R.17" ;
  triage:occurrences triage:R15-occurrence, triage:R16-occurrence, triage:R17-occurrence .

