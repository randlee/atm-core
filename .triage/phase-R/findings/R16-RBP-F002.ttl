triage:R16-RBP-F002
  a triage:Finding ;
  triage:findingId "R16-RBP-F002" ;
  triage:title "peer_addr stored as raw String instead of typed SocketAddr" ;
  triage:description "In crates/atm-daemon/src/peer_transport.rs line 253, peer_addr is set as endpoint.to_string() storing a raw String field. Downstream code at line 174 must parse back with record.peer_addr.parse::<SocketAddr>() on each use. Should validate at construction time and store as SocketAddr or newtype." ;
  triage:triageMode "initial_pass" ;
  triage:category triage:RBP ;
  triage:severity triage:minor ;
  triage:phaseId "phase-R" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:pattern "peer_addr.*to_string|peer_addr.*parse.*SocketAddr" ;
  triage:fileFilter "peer_transport\\.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:highestOpenBranch triage:R16-peer-replay ;
  triage:promoteToVersion "R.16" ;
  triage:triagedAt "2026-05-07T00:00:00Z"^^xsd:dateTime ;
