triage:RULE-008 a triage:Finding ;
  triage:findingId "RULE-008" ;
  triage:title "Raw 'team-lead' role name literals in test code" ;
  triage:description "Test code uses raw string literal \"team-lead\" where it should use ROLE_TEAM_LEAD constant from atm_core::roles. Found 19 instances in crates/atm-daemon/src/tests.rs on R.15. Production role names must use the constant to avoid silent mismatches if the role string changes." ;
  triage:category "RULE" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-R" ;
  triage:status "fixed" ;
  triage:closedAt "2026-05-07T12:00:00Z"^^xsd:dateTime ;
  triage:closureEvidence "roles.rs:3 only -- canonical constant definition, no raw literals anywhere else" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-07T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence triage:RULE-008-OCC-1 ;
