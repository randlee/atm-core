# Phase: phase-R
# Finding ID: R16-RBP-F001

<urn:atm:triage:finding/R16-RBP-F001>
  a triage:Finding ;
  triage:findingId "R16-RBP-F001" ;
  triage:title "cfg_attr(not(unix), allow(dead_code)) dead-code suppressor instead of proper cfg(unix) gating" ;
  triage:description "In crates/atm-daemon/src/composition.rs and crates/atm/src/composition.rs, multiple lines use #[cfg_attr(not(unix), allow(dead_code))] to silence dead-code warnings on non-unix platforms instead of using #[cfg(unix)] to properly gate the item. The suppressor masks real portability gaps." ;
