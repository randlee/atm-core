<urn:atm:triage:finding/ATM-QA-004-AN13>
  a triage:Finding ;
  triage:findingId "ATM-QA-004-AN13" ;
  triage:title "compose exit-code parity regression (sc-composer 1.3.0->1.4.1 bump)" ;
  triage:description "sc-compose version bump from 1.3.0 to 1.4.1 changed validation-failure exit code from 1 to 2, but atm compose hardcodes exit code 1 for all errors via anyhow's generic error path, breaking exit-code parity test (crates/atm/tests/compose_passthrough.rs:82). The defect is in crates/atm/src/commands/compose.rs where composer.compose_file() errors are not mapped to AtmError::template_render_verification_failed() to propagate the correct exit code 2." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "build-break" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-13T21:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AN.13 ;
  triage:foundAt "2026-08-14T03:57:51Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-004-AN13/AN13-1> ;
  triage:closedAt "2026-08-14T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "1" .

