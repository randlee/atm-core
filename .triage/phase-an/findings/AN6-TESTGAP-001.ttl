  a triage:Finding ;
  triage:findingId "AN6-TESTGAP-001" ;
  triage:title "Production SQLite search backend has zero tests; sprint checklist test-suite claims do not match diff" ;
  triage:description "search_store.rs (761 lines) and search_reader.rs in atm-storage-rusqlite have zero tests; all aggregation/cursor/dedup correctness including the NULL message_id + --per-mailbox case is only proven against the AN.5 in-memory fake, never the shipped SQLite backend. The sprint worktree checklist claims corpus/parity, parser/key/injection, aggregate/cursor, local/peer, and Python security acceptance tests were added, but the actual diff adds zero new test files -- claim does not match diff." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
