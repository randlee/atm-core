<urn:atm:triage:finding/RBQA-F001-AN1>
  a triage:Finding ;
  triage:findingId "RBQA-F001-AN1" ;
  triage:title "Decorative per-seam dependency allowlist not synchronized with enforced manifest policy" ;
  triage:description "The per-seam `[dependencies].allowed_dependencies` field in `boundaries/*/*.toml` (e.g. `boundaries/atm-template-sc-compose/sc-composer.toml`) is documented in code as decorative-only, while the actually-enforced dependency allowlist lives in a structurally separate table, `.just/lint-config.toml`'s `[[boundaries.manifest_dependency_allowlists]]`. Nothing cross-checks that the two stay in sync. This exact divergence caused PR #883's original CI-red state (already fixed for this one instance, but the underlying duplicated-list pattern remains and will reproduce on the next boundary-owner dependency change anywhere in the workspace). Recommendation: delete the decorative per-seam field and point seam docs at `.just/lint-config.toml`, OR add a mechanical parity check between the two lists." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "lint_gap" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
