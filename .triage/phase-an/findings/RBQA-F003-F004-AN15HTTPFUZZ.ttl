<urn:atm:triage:finding/RBQA-F003-F004-AN15HTTPFUZZ>
  a triage:Finding ;
  triage:findingId "RBQA-F003-F004-AN15HTTPFUZZ" ;
  triage:title "boundary-probe and differential-probe vary a label never read by production code (RBQA-F002 defect class recurrence)" ;
  triage:description "quality-mgr's AN15HTTPFUZZ-QA-1 verdict found that 2 of 4 HTTP fuzz probes (boundary-probe, differential-probe) vary labels attached to request elements that production code never reads -- so all 100 cases in each of those 2 probes hit identical code branches, producing false appearance of coverage diversity. Same defect class as RBQA-F002, now recurring in the HTTP test suite. Boundary-probe varies retired provenance header; differential-probe varies Accept header. Shape-probe and template-probe confirmed genuinely diverse." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-quality" ;
  triage:severity "important" ;
  triage:repeatable true ;
