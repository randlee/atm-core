# This is an intentional follow-up record, not a claim that AN.1's fixture
# adapter is production-ready. It prevents the temporary test seam from being
# forgotten while avoiding a false QA finding before the upstream public APIs
# exist.

<urn:atm:triage:finding/AN1-FIXTURE-STUB-REPLACEMENT-001>
  a triage:Finding ;
  triage:findingId "AN1-FIXTURE-STUB-REPLACEMENT-001" ;
  triage:title "Replace remaining AN.1 fixture-only classified directive inspection with a published upstream API" ;
  triage:description "The 1.4.0 exact-pinned adapter now delegates strict UTF-8/line-ending-normalized per-file identity to sc-sha and frontmatter parsing, rendering, and containment to sc-composer. The remaining fixture registration contains only classified include/import/from-import directive references and spans because the published upstream API does not expose those parser results. ATM retains raw source bytes and owns the template graph manifest, storage, and resolver policy; it must not locally parse directives to close this finding." ;
  triage:phaseId "phase-AN" ;
  triage:triageMode "planned_followup" ;
  triage:category "upstream-dependency" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "deferred" ;
  triage:dispatchReady false ;
  triage:foundIn triage:AN.1 ;
  triage:foundAt "2026-08-11T02:53:58-07:00"^^xsd:dateTime ;
  triage:triagedAt "2026-08-11T02:53:58-07:00"^^xsd:dateTime ;
  triage:reasonForDeferral "public_classified_directive_inspection_api_prerequisite" ;
  triage:futureValidationMethod "exact_pinned_upstream_directive_inspection_adapter_swap" ;
  triage:resolutionNotes "The identity/frontmatter fixture replacement landed against exact-pinned sc-composer/sc-sha 1.4.0. Upstream public API request randlee/sc-compose#445 tracks the remaining classified directive inspection. When that API is available, create a dedicated integration/phase-an PR that replaces only the fixture reference map. Preserve the TemplateComposer port and the sole atm-daemon-bootstrap composition site; do not add a local parser or loader implementation. Validate classified include/import/from-import inspection, directive-looking literals, containment, Windows/macOS/Linux CI, and boundary lint in that same PR." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AN1-FIXTURE-STUB-REPLACEMENT-001/1> ;
  triage:triageRecordVersion "1" .

