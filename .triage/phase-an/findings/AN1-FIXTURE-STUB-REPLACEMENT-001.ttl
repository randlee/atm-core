@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# This is an intentional follow-up record, not a claim that AN.1's fixture
# adapter is production-ready. It prevents the temporary test seam from being
# forgotten while avoiding a false QA finding before the upstream public APIs
# exist.

<urn:atm:triage:finding/AN1-FIXTURE-STUB-REPLACEMENT-001>
  a triage:Finding ;
  triage:findingId "AN1-FIXTURE-STUB-REPLACEMENT-001" ;
  triage:title "Replace AN.1 fixture-only template adapter with published sc-compose/sc-sha integration" ;
  triage:description "crates/atm-template-sc-compose currently reserves ATM's production adapter boundary with fixture-registered parser/hash/render results. It intentionally does not implement hashing, UTF-8/line-ending normalization, frontmatter parsing, directive inspection, path resolution, or rendering. Replace it only after the public exact-pinnable sc-compose APIs provide strict UTF-8 plus CRLF/lone-CR-to-LF normalized per-file identity, classified directive inspection, and contained rendering, and sc-sha provides the required generic per-file/recursive hash support. ATM retains raw source bytes and owns the template graph manifest, storage, and resolver policy." ;
  triage:phaseId "phase-AN" ;
  triage:triageMode "planned_followup" ;
  triage:category "upstream-dependency" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "deferred" ;
  triage:dispatchReady false ;
  triage:foundIn triage:AN-S1 ;
  triage:foundAt "2026-08-11T02:53:58-07:00"^^xsd:dateTime ;
  triage:triagedAt "2026-08-11T02:53:58-07:00"^^xsd:dateTime ;
  triage:reasonForDeferral "public_upstream_api_prerequisite" ;
  triage:futureValidationMethod "exact_pinned_upstream_adapter_swap" ;
  triage:resolutionNotes "When the public upstream API is available, create a dedicated integration/phase-an PR that replaces the fixture map with the exact-pinned sc-compose/sc-sha adapter. Preserve the TemplateComposer port and the sole atm-daemon-bootstrap composition site; do not add a local hash/parser/loader implementation. Validate the shared LF/CRLF identity vector, explicit BOM/final-newline vectors, classified include/import/from-import inspection, containment, Windows/macOS/Linux CI, and boundary lint in that same PR." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AN1-FIXTURE-STUB-REPLACEMENT-001/1> ;
  triage:triageRecordVersion "1" .

