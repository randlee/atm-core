<urn:atm:triage:finding/RBP-F003-AN14>
  a triage:Finding ;
  triage:findingId "RBP-F003-AN14" ;
  triage:title "Redundant repeated .expect() on same Option in render_without_includes instead of binding once" ;
  triage:description "In crates/atm-template-sc-compose/src/lib.rs, render_without_includes checks source.output_format.is_none() at lines 234-238, then calls .expect(\"checked above\") twice on the same Option at lines 252 and 256 instead of binding it once. Recommended fix: bind `let output_format = source.output_format.expect(...)` once after the is_none check, and reuse the bound value at both use sites." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
