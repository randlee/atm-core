<urn:atm:triage:finding/RSH-001-AN11>
  a triage:Finding ;
  triage:findingId "RSH-001-AN11" ;
  triage:title "assemble_runtime is sync but unconditionally tokio::spawns when telemetry configured" ;
  triage:description "crates/atm-runtime/src/composition.rs's pub fn assemble_runtime is a synchronous function that unconditionally calls tokio::spawn when telemetry is configured, with no guard verifying a Tokio runtime context is active. It's inert today because atm-daemon-bootstrap always passes None, but there's no guard protecting future callers from panicking outside a runtime." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "hardening" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
