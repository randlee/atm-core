<urn:atm:triage:finding/RBP-F004-AN14>
  a triage:Finding ;
  triage:findingId "RBP-F004-AN14" ;
  triage:title "checked_body takes owned String but only ever borrows it; return value is separately re-allocated" ;
  triage:description "In crates/atm-template-sc-compose/src/lib.rs, checked_body(text: String, ...) takes ownership of text but only ever borrows &text (line 109) before it is dropped; the return value is independently re-allocated via checked.body().to_owned() (line 116). All 3 call sites already hold values that could be passed by reference. Recommended fix: change the signature to take text: &str instead of String." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-best-practices" ;
  triage:severity "minor" ;
