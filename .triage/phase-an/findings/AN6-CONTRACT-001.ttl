<urn:atm:triage:finding/AN6-CONTRACT-001>
  a triage:Finding ;
  triage:findingId "AN6-CONTRACT-001" ;
  triage:title "HTTP query endpoint contract diverges from sprint doc's literal types; no UDS/loopback integration test" ;
  triage:description "SearchRequest.query is SearchInput not the documented MessageSearchQuery; SearchHit.from_agent/to_agent is StoredSearchAddress, missing optional team/host fields the sprint doc specifies. Local-only peer rejection is real and correctly ordered in core but uses a generic validation error code, not a distinct typed authorization error. No UDS/loopback integration test exists for search in atm-http-runtime. Contract snapshot test only covers request-side SimpleAggregate variants, never response-side SearchAggregate variants." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "contract-drift" ;
  triage:severity "important" ;
  triage:repeatable false ;
