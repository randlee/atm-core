<urn:atm:triage:finding/AN6-BOUNDARY-001>
  a triage:Finding ;
  triage:findingId "AN6-BOUNDARY-001" ;
  triage:title "atm-query-python directly depends on and imports rusqlite" ;
  triage:description "AN6QA1-FIX-1 (80b5fb8a) removed the direct rusqlite import from lib.rs:12, but relabeled rather than fixed this finding: crates/atm-query-python/Cargo.toml now directly depends on both atm-storage and atm-storage-rusqlite, and neither crate's dependents-allowlist permits atm-query-python as a dependent. just lint fails with 'atm-storage allows dependents [...]; found unexpected dependent atm-query-python' and the equivalent for atm-storage-rusqlite. Independently reproduced by quality-mgr against 80b5fb8a after a clean rebuild." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "followup_pass" ;
  triage:category "boundary-violation" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "branch" ;
  triage:status "closed" ;
  triage:resolution "fixed" ;
  triage:closedAt "2026-08-12T11:06:54Z"^^xsd:dateTime ;
  triage:closedNote "INDEPENDENT VERIFICATION (quality-mgr, AN6QA2-FIX-1 @ 59ee84654): just lint boundaries check passes. boundaries/atm-storage/analyst-query-store.toml allowed_dependents explicitly lists atm-query-python and atm-storage-rusqlite. atm-query-python/Cargo.toml moved the atm-storage-rusqlite test-support feature into [dev-dependencies]. Genuinely fixed, not relabeled." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-12T10:09:50Z"^^xsd:dateTime ;
  triage:foundIn triage:AN.6 ;
  triage:foundAt "2026-08-12T10:09:50Z"^^xsd:dateTime ;
