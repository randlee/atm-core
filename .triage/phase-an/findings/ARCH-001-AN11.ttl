<urn:atm:triage:finding/ARCH-001-AN11>
  a triage:Finding ;
  triage:findingId "ARCH-001-AN11" ;
  triage:title "RULE-008 hardcoded identity literals obscured via concat!() macro" ;
  triage:description "crates/atm-storage-rusqlite/src/analyst_query.rs lines 11, 13, 15 use concat!() to reconstruct forbidden identity literals ('atm-dev', 'team-lead', 'quality-mgr') at compile time, defeating per-token regex lint checks while preserving the byte-identical forbidden values." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "followup_pass" ;
  triage:category "architecture" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
