<urn:atm:triage:finding/AN9-QA2-BLOCK-001>
  a triage:Finding ;
  triage:findingId "AN9-QA2-BLOCK-001" ;
  triage:title "clippy::large_enum_variant on WriteOp::AdmitDecomposedMessage" ;
  triage:description "AN9-QA-2 (quality-mgr) reported a blocking CI failure: clippy::large_enum_variant fires on WriteOp::AdmitDecomposedMessage(DecomposedMessageAdmission) in crates/atm-storage-rusqlite/src/writer/ops.rs (around line 37), caused by AN.9's TemplateFrontmatter.template_tags/workflow field additions growing DecomposedMessageAdmission past clippy's size threshold under -D warnings. This condition already existed at AN9-QA-1's bd561591 head but was not caught then. Confirmed root cause of live CI failure (Clippy + Just lint x3 OS all red) on PR #871 @ 10c023fc5. Recommended fix: box the AdmitDecomposedMessage payload, matching the existing AdmitTemplateMessage(Box<TemplateMessageAdmission>) pattern in the same enum." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-best-practices" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
