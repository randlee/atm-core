<urn:atm:triage:finding/ARCH-002-AN11>
  a triage:Finding ;
  triage:findingId "ARCH-002-AN11" ;
  triage:title "RULE-010 hardcoded 'team-lead'/'quality-mgr' literals, no constant" ;
  triage:description "concat!() fragmentation defeats linter but still reconstructs forbidden literals at runtime. Lines 13-15 use concat!() to fragment 'team-lead' and 'quality-mgr' which passes linting but produces byte-identical forbidden strings. Proper fix requires using shared role constants from crates/atm-core/src/roles.rs (e.g., ROLE_TEAM_LEAD)." ;
