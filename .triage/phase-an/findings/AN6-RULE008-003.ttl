<urn:atm:triage:finding/AN6-RULE008-003>
  a triage:Finding ;
  triage:findingId "AN6-RULE008-003" ;
  triage:title "Raw production identity literal 'atm-dev' in atm-query-python lib.rs test" ;
  triage:description "AN6-QA-4 (quality-mgr) independent re-verification of AN6-RULE008-002 confirmed that fix genuinely closed, but surfaced a separate, pre-existing RULE-008/009 violation not caught during AN6-QA-3: crates/atm-query-python/src/lib.rs:179, in test parameterized_query_returns_column_labelled_rows, uses PyTuple::new(py, [raw literal atm-dev]) as a query parameter. This literal predates AN6QA2-FIX-1 (present unchanged at 59ee84654 and still at 77acf6a0a); confirmed via git diff 59ee84654..77acf6a0a --stat showing only templates.rs changed. Recommend replacing the raw literal with the same TEST_* fixture pattern used for templates.rs (e.g. a shared test-identity constant). This finding blocks just lint identities check / PR #862 mergeability." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "lint-rule008-009" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "branch" ;
  triage:status "closed" ;
  triage:resolution "fixed" ;
  triage:closedAt "2026-08-12T11:36:44Z"^^xsd:dateTime ;
  triage:closedNote "INDEPENDENT VERIFICATION (quality-mgr, AN6-QA-6 @ 3c62c2bb3890): fresh pull, HEAD confirmed. python3 .just/check_test_identity_literals.py --root . -> 0 violations. Full workspace grep for 'atm-dev' in *.rs -> zero hits. just lint -> only pre-existing deny --config mismatch (unrelated, non-blocking). Clean-rebuild clippy -> 0 warnings. cargo test -p atm-query-python -> 5/5 pass. Genuinely fixed; TEST_NONEXISTENT_TEAM/'test-team' replaces the raw identity literal entirely. (Test-quality regression from the != rewrite tracked separately, non-blocking: see AN6-TESTQUALITY-001.)" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-12T11:25:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AN.6 ;
  triage:foundAt "2026-08-12T11:25:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AN6-RULE008-003/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AN6-RULE008-003/2> ;
  triage:triageRecordVersion "3" .

