<urn:atm:triage:finding/AN15-DIFFPROBE-PACKAGE-MISMATCH>
  a triage:Finding ;
  triage:findingId "AN15-DIFFPROBE-PACKAGE-MISMATCH" ;
  triage:title "Differential-probe worker cannot exercise its claimed atm-core seam" ;
  triage:description ".just/run_fuzz.py's differential-probe command is `cargo test -p atm-storage-rusqlite an15_differential_probe_`, which cannot match `an15_differential_probe_render_on_read_uses_only_captured_variables` at crates/atm-core/src/read/render.rs:206 (package agent-team-mail-core, not atm-storage-rusqlite). The retained report site/reports/fuzz/an15-checked-emission-20260814.json nonetheless records the seam 'atm-core render-on-read and rusqlite persisted template catalog' as success/100 cases, overstating actual coverage. Independently confirmed by rust-qa-agent, req-qa (both runs), arch-qa (both runs), and quality-mgr directly." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
