    triage:line "640" ;
    triage:snippet "pub(crate) fn error_response(error: AtmError) -> Response" ;
    triage:status "fixed" ;
    triage:headSha "9681de8a5" ;
    triage:branch "feature/an15-http-fuzz-campaign" ;
    triage:closed true ;
