<urn:atm:triage:ATM-QA-005-AN15HTTPFUZZ> a triage:Finding ;
    triage:findingId "ATM-QA-005-AN15HTTPFUZZ" ;
    triage:title "AtmError.cause serialized into HTTP bodies with no redaction boundary" ;
    triage:description "req-qa found that AtmError.cause is serialized directly into HTTP response bodies in crates/atm-http-runtime/src/message_handler.rs with no redaction boundary. No current leak was found (no secrets flow through .cause today), but there is no structural guard preventing a future caller from putting sensitive data into .cause and having it surface in an HTTP body. Add a redaction boundary or explicit doc/test guard." ;
    triage:triageMode "initial_pass" ;
    triage:category "security-hardening" ;
    triage:phaseId "phase-an" ;
    triage:severity "minor" ;
    triage:repeatable false ;
    triage:sweepScope "file_only" ;
    triage:status "open" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-08-15T04:16:42Z"^^xsd:dateTime ;
    triage:foundIn triage:AN.15 ;
