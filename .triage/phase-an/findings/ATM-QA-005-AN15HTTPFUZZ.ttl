@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:ATM-QA-005-AN15HTTPFUZZ> a triage:Finding ;
    triage:findingId "ATM-QA-005-AN15HTTPFUZZ" ;
    triage:title "AtmError.cause serialized into HTTP bodies with no redaction boundary" ;
    triage:description "req-qa found that AtmError.cause is serialized directly into HTTP response bodies in crates/atm-http-runtime/src/message_handler.rs with no redaction boundary. No current leak was found (no secrets flow through .cause today), but there is no structural guard preventing a future caller from putting sensitive data into .cause and having it surface in an HTTP body. Add a redaction boundary or explicit doc/test guard." ;
    triage:triageMode "initial_pass" ;
    triage:category "security-hardening" ;
    triage:phaseId "phase-an" ;
    triage:severity "minor" ;
    triage:repeatable false ;
    triage:sweepScope "file_only" ;
    triage:status "fixed" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-08-15T04:16:42Z"^^xsd:dateTime ;
    triage:foundIn triage:AN.15 ;
    triage:foundAt "2026-08-15T04:16:42Z"^^xsd:dateTime ;
    triage:openOn <urn:atm:triage:worktree:feature-an15-http-fuzz-campaign> ;
    triage:resolutionNotes "Update 2026-08-15 by quality-mgr, AN15HTTPFUZZ-QA-2: fix commit 9681de8a5 independently verified via ruthless-boundary-qa. New HttpErrorBody<'error> struct (message_handler.rs:640-655) is a 2-field {code, message} type with no `cause` field at all -- structurally absent, not merely skip_serializing_if -- so cause cannot leak without touching this type. error_response() (message_handler.rs:657-672) routes every error path through HttpErrorBody; grepped the whole atm-http-runtime crate for other direct AtmError serialization into a response body outside error_response/json_response -- none found. New test error_response_redacts_diagnostic_causes_at_the_http_boundary (message_handler.rs:994-1015) asserts both that the cause key is absent AND that the full serialized JSON string does not contain the raw diagnostic secret (rules out leakage via message concatenation too). Closing." ;
    triage:hasOccurrence <urn:atm:triage:ATM-QA-005-AN15HTTPFUZZ:occurrence:1> ;
    triage:hasOccurrence <urn:atm:triage:ATM-QA-005-AN15HTTPFUZZ:occurrence:2> ;
    triage:hasOccurrence <urn:atm:triage:ATM-QA-005-AN15HTTPFUZZ:occurrence:3> .

