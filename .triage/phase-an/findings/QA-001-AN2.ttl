<urn:atm:triage:finding/QA-001-AN2>
  a triage:Finding ;
  triage:findingId "QA-001-AN2" ;
  triage:title "boundary manifest forbidden_edges not mirrored in EXPECTED_FORBIDDEN_EDGES, fails cargo test --workspace" ;
  triage:description "boundaries/atm-storage-rusqlite/template-catalog-sqlite.toml:25 declares a forbidden_edges entry for atm-storage-rusqlite->atm-core. This edge is not mirrored in crates/atm-architecture/tests/boundary_enforcement.rs's EXPECTED_FORBIDDEN_EDGES constant/table, causing cargo test --workspace to fail (the boundary-enforcement test asserts the TOML and the Rust guard catalog stay in sync). Fix is either to add the missing entry to EXPECTED_FORBIDDEN_EDGES so it matches the TOML, or narrow/remove the TOML edge if it was declared in error — whichever is architecturally correct needs a quick check of atm-storage-rusqlite's actual dependency graph." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary-enforcement" ;
