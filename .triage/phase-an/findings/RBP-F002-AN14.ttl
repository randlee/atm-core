<urn:atm:triage:finding/RBP-F002-AN14>
  a triage:Finding ;
  triage:findingId "RBP-F002-AN14" ;
  triage:title "Duplicated template-staleness verification logic in render_within_root and compose_file" ;
  triage:description "The \"template source changed after it was loaded\" staleness check is duplicated verbatim in crates/atm-template-sc-compose/src/lib.rs render_within_root (lines 157-163) and compose_file (lines 187-193) -- identical fs::read + byte-compare + AtmError::template_render_verification_failed construction in both places. Recommended fix: extract a shared helper fn verify_unchanged(source_path, expected) -> Result<(), AtmError> and call it from both sites." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-best-practices" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-13T22:55:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AN.14 ;
  triage:foundAt "2026-08-13T22:50:00Z"^^xsd:dateTime ;
