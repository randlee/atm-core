<urn:atm:triage:finding/AN6-COMPILEREG-001>
  a triage:Finding ;
  triage:findingId "AN6-COMPILEREG-001" ;
  triage:title "New compile-breaking regression introduced by AN6QA1-FIX-1 test code" ;
  triage:description "AN6QA1-FIX-1 (80b5fb8a) added test code in crates/atm-http-runtime/src/message_handler.rs that fails to compile. Line 1043 uses SearchGroupBy::Category, but Category belongs to SearchGroupField, not SearchGroupBy (which only has Field(SearchGroupField)/Var(SearchKey) variants), producing E0599. Line 1039 has a related timestamp type-inference failure (E0282) once the enum-path error is fixed. Confirmed via cargo clippy --workspace --all-targets after a clean rebuild by quality-mgr; ruled out as a stale-cache artifact." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "compile-error" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "branch" ;
  triage:status "open" ;
  triage:dispatchReady true ;
