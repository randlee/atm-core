  a triage:Finding ;
  triage:findingId "CI-LINT-001-AN1" ;
  triage:title "Just lint CI job fails on ubuntu/macos/windows for PR #838 — missing IO_FORBIDDEN_SOURCE_PATTERNS entries" ;
  triage:description "Live CI on PR #838 (run 31459833077) shows the 'Just lint' job failing on all three platforms (ubuntu, macos, windows). Root cause: test_every_declared_io_forbidden_tag_has_source_pattern_mapping fails because new forbidden-edge tags introduced by this sprint's boundary manifest/lint extension — local_path_heuristics, storage_schema, http_runtime, cli_surface, catalog_persistence, transport — have no corresponding entry in IO_FORBIDDEN_SOURCE_PATTERNS." ;
