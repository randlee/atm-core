<urn:atm:triage:finding/BOUNDARY-001-AN2>
  a triage:Finding ;
  triage:findingId "BOUNDARY-001-AN2" ;
  triage:title "Just-lint boundaries check fails — 38 forbidden-reference/dependency violations, pre-existing on AN.2 feature commit" ;
  triage:description "quality-mgr independently reproduced `just lint` boundaries-check FAIL on PR #850 (feature/an2-sprint @ 6aed4d7d). 38 findings across 11 files and 2 boundary manifests. Violations include: forbidden TemplateComposer references in atm-core/boundary modules and downstream consumers (atm-daemon-bootstrap, atm-runtime, atm-template-sc-compose); stale allowed-dependent entry in async-message-store-sqlite.toml; unallowlisted Cargo dep in atm-daemon-bootstrap; private-implementation and public-constructor violations in template_catalog_store; test-double not listed in allowlist; and missing manifest dependency allowlist in atm-template-sc-compose. Pre-existing from commit 7dd8c71c3 (feat(storage): add template catalog schema)." ;
  triage:phaseId "phase-an" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary-enforcement" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-11T20:10:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AN.2 ;
