<urn:atm:triage:finding/RRG-BENCH-V4ABORT-001>
  a triage:Finding ;
  triage:findingId "RRG-BENCH-V4ABORT-001" ;
  triage:title "Official benchmark aborts the whole suite when one lane violates the durable <= admitted <= requested invariant, hiding the counts and skipping the remaining lanes" ;
  triage:description "Candidate 1.4.10 campaign 20260903T185218Z-m5-atmbench (PR #1147): after the sqlite lane passed, the UDS lane produced evidence with accepted_count=1 and observed_mailbox_count=95. scripts/smoke/run_admission_capacity.py write_v4_evidence (line 346) calls v4_result_from_evidence, whose BenchmarkRunResult model validator at scripts/smoke/benchmark_schema.py:275 raises ValueError with the text message counts must satisfy durable <= admitted <= requested; write_v4_evidence rewraps it as SmokeError could not emit direct v4 benchmark evidence and the runner exits, so tcp and tcp-tls never ran, no v4 artifact was published for the uds lane, and the operator had to open the raw trace by hand to learn the three counts. Classification: benchmark-harness, important. Required behaviour per Rand (surface every blocker in one run): a lane whose counts violate the invariant must be published as status FAIL (or INCOMPLETE with an incomplete_reason carrying the three counts) so the campaign continues to the remaining lanes and the report shows the numbers; the validator text itself should include the offending values. Product-side accounting is tracked separately as RRG-INGRESS-ADMIT-001; this record is only about the harness aborting and hiding evidence." ;
  triage:phaseId "readiness-1.4" ;
  triage:triageMode "initial_pass" ;
  triage:category "benchmark-harness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-09-03T19:05:00Z"^^xsd:dateTime ;
  triage:foundIn triage:RRG-S1 ;
  triage:foundAt "2026-09-03T18:52:52Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RRG-BENCH-V4ABORT-001/CAND-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RRG-BENCH-V4ABORT-001/CAND-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RRG-BENCH-V4ABORT-001/QMGR-CLOSE-1> ;
  triage:closedAt "2026-09-03T22:15:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "2" .

