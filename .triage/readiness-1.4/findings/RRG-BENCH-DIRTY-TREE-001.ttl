<urn:atm:triage:finding/RRG-BENCH-DIRTY-TREE-001>
  a triage:Finding ;
  triage:findingId "RRG-BENCH-DIRTY-TREE-001" ;
  triage:title "benchmark-official refuses to run when the shared benchmark worktree holds untracked reports from an earlier campaign, and its error does not name the offending paths or the evidence-safe remedy" ;
  triage:description "Release-readiness step 1 on prerelease/v1.4.12 (4f1202bf2), atmbench account on rand-m5, 2026-09-04T05:4xZ (arch-ctm under fenix@rand-m5 step-1 GO): just benchmark-official refused before execution with working tree is dirty before sync because scripts/smoke/benchmark_official.py require_clean_tree (line 258) treats any git status porcelain output, including untracked historical report files under site/reports/ left by earlier campaigns on the same shared worktree (their automatic push had failed, RRG-BENCH-FQDN-001 era, so they were never cleared), as a reason to refuse. The refusal is right in spirit (ambient state must not leak into official evidence) but the harness neither names the dirty paths nor distinguishes untracked prior evidence under site/reports/ from real source modifications, and the only remedy it suggests is commit or remove local changes, which invites deleting evidence. Classification: harness, minor. Fix: report the dirty paths in the error; treat untracked files under site/reports/ as retained evidence and either commit them on the evidence branch automatically before sync or instruct the operator to do exactly that; never suggest removal for report paths. Interim workaround used for the campaign: commit the untracked reports on the evidence branch as their own evidence commit, then rerun. No product code involved." ;
  triage:phaseId "readiness-1.4" ;
  triage:triageMode "initial_pass" ;
  triage:category "benchmark-harness" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-04T05:52:00Z"^^xsd:dateTime ;
  triage:foundIn triage:RRG-S1 ;
  triage:foundAt "2026-09-04T05:47:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RRG-BENCH-DIRTY-TREE-001/CAND-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/RRG-BENCH-DIRTY-TREE-001/CAND-1>
  a triage:Occurrence ;
  triage:file "scripts/smoke/benchmark_official.py" ;
  triage:line 258 ;
  triage:snippet "def require_clean_tree(self, stage: str) -> None: dirty = self.command([git, status, --porcelain]).stdout.strip(); if dirty: raise OfficialBenchmarkError(...)" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "chore/readiness-candidate-1.4.7" ;
  triage:headSha "4f1202bf2" ;
  triage:occursIn <urn:atm:triage:worktree/CAND/4f1202bf2> .

