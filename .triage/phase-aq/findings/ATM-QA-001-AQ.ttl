  triage:closedAt "2026-08-17T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closedNote "Fixed on plan/search-indexing-admission-performance (commit b7004f67e, PR #891): the search-projection ADR renumbered ADR-047 -> docs/adr/ADR-049-durable-idle-search-projection.md, resolving the collision with Phase AK's forward-referenced (un-executed, not-yet-authored) ADR-047 slot. All AQ-owned cross-references now point to ADR-049. Phase AK's own ADR-047 forward references (docs/adr/INDEX.md:45,46,50; docs/requirements.md:3781; docs/atm/*.md) are pre-existing Phase-AK planning debt, confirmed untouched by this branch (no docs/plans/phase-ak/* modified). Confirmed independently by req-qa, arch-qa, and ruthless-boundary-qa." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-001-AQ/AQ-1> ;
