<urn:atm:triage:finding/RSH-004-AQ>
  a triage:Finding ;
  triage:findingId "RSH-004-AQ" ;
  triage:title "No transaction deadline specified for idle drain-batch SQLite transactions" ;
  triage:description "sprint-AQ1-durable-idle-search-projection.md specifies that the existing SQLite writer drains bounded work only while idle and yields to every foreground submission, but does not define a maximum transaction-hold deadline for an in-progress drain batch, risking an unbounded transaction hold if a batch is large or a drain step stalls, which could block foreground admission it is meant to yield to." ;
  triage:phaseId "phase-aq" ;
  triage:triageMode "initial_pass" ;
  triage:category "robustness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-15T19:29:30Z"^^xsd:dateTime ;
  triage:foundIn triage:AQ.0 ;
  triage:foundAt "2026-08-15T19:28:11Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-17T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closedNote "Fixed on plan/search-indexing-admission-performance (commit b7004f67e, PR #891): sprint-AQ1-durable-idle-search-projection.md:66-76 defines max_drain_transaction_hold as a hard deadline enforced via SQLite progress_handler, with rollback-on-expiry semantics. Confirmed independently by req-qa and arch-qa." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-004-AQ/AQ-spec-1> ;
  triage:triageRecordVersion "1" .

