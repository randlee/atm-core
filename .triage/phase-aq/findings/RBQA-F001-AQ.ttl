  a triage:Finding ;
  triage:findingId "RBQA-F001-AQ" ;
  triage:title "atm admin reindex-search command misattribution propagated into AQ docs" ;
  triage:description "Docs reference an 'atm admin reindex-search' CLI command as an existing/planned surface, but this misattributes command ownership/naming that was already flagged in a prior QA pass (SEARCHIDX-PLAN-QA-1) as incorrect. The AQ conversion carried this misattribution forward into the new AQ-numbered docs without correcting it." ;
  triage:phaseId "phase-aq" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
