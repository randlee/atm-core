<urn:atm:triage:finding/RSH-001-AQ>
  a triage:Finding ;
  triage:findingId "RSH-001-AQ" ;
  triage:title "No startup validation planned for idle-drain tunables" ;
  triage:description "The AQ.1 plan (sprint-AQ1-durable-idle-search-projection.md) introduces idle-drain scheduling tunables (batch size, idle-detection interval, etc.) for the durable search-projection catch-up writer, but does not specify any startup-time validation of these tunables (e.g., rejecting zero/negative batch sizes or nonsensical interval values) before the writer begins operating." ;
  triage:phaseId "phase-aq" ;
  triage:triageMode "initial_pass" ;
  triage:category "robustness" ;
  triage:severity "important" ;
