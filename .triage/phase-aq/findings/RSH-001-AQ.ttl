  triage:closedAt "2026-08-17T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closedNote "Fixed on plan/search-indexing-admission-performance (commit b7004f67e, PR #891): sprint-AQ1-durable-idle-search-projection.md:58-65 now defines SearchProjectionScheduleConfig validated synchronously at SharedDb startup, with explicit bounds and a typed error preventing writer startup on invalid values. Confirmed independently by req-qa and arch-qa." ;
