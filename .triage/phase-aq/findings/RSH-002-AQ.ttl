<urn:atm:triage:finding/RSH-002-AQ>
  a triage:Finding ;
  triage:findingId "RSH-002-AQ" ;
  triage:title "No bounded retry/backoff specified for the drain writer's catch-up work" ;
  triage:description "The AQ.1 plan does not specify bounded retry or backoff behavior for the drain writer when catch-up work items fail (e.g., a transient SQLite busy/locked error during idle drain). Without a documented bounded-retry policy, a failing drain item could retry unboundedly or fail silently with no defined recovery path." ;
  triage:phaseId "phase-aq" ;
  triage:triageMode "initial_pass" ;
  triage:category "robustness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-15T19:35:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AQ.0 ;
  triage:foundAt "2026-08-15T19:28:11Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-17T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closedNote "Fixed on plan/search-indexing-admission-performance (commit b7004f67e, PR #891): sprint-AQ1-durable-idle-search-projection.md:77-87 specifies an 8-attempt exponential backoff schedule (50ms-5s capped) with a durable-blocked terminal state and explicit reset conditions. Confirmed independently by req-qa and arch-qa." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AQ/AQ1-PLAN-001> ;
  triage:triageRecordVersion "1" .

