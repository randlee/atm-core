<urn:atm:triage:finding/S21-ATM-QA-002>
  a triage:Finding ;
  triage:findingId "S21-ATM-QA-002" ;
  triage:title "ReconcileWorkerState.notification_fingerprints not worker-owned — still Arc<Mutex<...>> on inner" ;
  triage:description "reconcile_runtime.rs — ReconcileWorkerState is missing notification_fingerprints: NotificationFingerprintRegistry. The registry remains on ReconcileRuntimeInner as Arc<Mutex<NotificationFingerprintRegistry>> (shared, not worker-owned). Sprint Y.21 Proposed Design requires it be worker-owned in ReconcileWorkerState." ;
  triage:phaseId "phase-Ye" ;
  triage:triageMode "initial_pass" ;
  triage:category "design-violation" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
