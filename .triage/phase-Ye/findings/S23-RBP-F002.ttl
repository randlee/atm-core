@prefix atm:  <https://atm-core.dev/triage/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

atm:finding_S23-RBP-F002
    atm:finding_id              "S23-RBP-F002" ;
    atm:title                   "snapshot()/snapshot_for_members() use infallible Result in runtime_status_cache.rs" ;
    atm:phase_id                "phase-Ye" ;
    atm:severity                "important" ;
    atm:status                  "open" ;
    atm:triage_mode             "initial_pass" ;
    atm:triage_verdict          "CONFIRMED_PARTIAL" ;
    atm:triage_rationale        "Confirmed on feature/pYe-s19 and feature/pYe-s23: snapshot() body is 'let cache = self.state.load(); Ok(build_runtime_snapshot_all(&cache))' and snapshot_for_members() body is 'let cache = self.state.load(); Ok(build_runtime_snapshot_scoped(&cache, members))' — both use ArcSwap load which is infallible; neither can return Err. Result<RuntimeStatusSnapshot, AtmError> wrapping violates RBP-007. On feature/pYe-s20 through integrate/phase-Y the implementation acquires a Mutex lock with 'map_err(|_| runtime_status_cache_lock_poisoned())' — lock poison is a real Err arm, so Result is NOT infallible there. Fix belongs on feature/pYe-s23-phase-end-architecture-proof: change both return types to RuntimeStatusSnapshot (removing Result wrapper) and update all call sites." ;
    atm:highest_open_branch     "feature/pYe-s23-phase-end-architecture-proof" ;
    atm:promote_to_branch       "feature/pYe-s23-phase-end-architecture-proof" ;
    atm:dispatch_ready          "true"^^xsd:boolean ;
    atm:dispatch_blocked_pending_triage_commit "false"^^xsd:boolean ;
    atm:sweep_scope             "crates/atm-daemon/src/runtime_status_cache.rs" ;
    atm:repeatable              "false"^^xsd:boolean ;
    atm:triage_date             "2026-05-20"^^xsd:date ;

    atm:occurrence [
        atm:branch  "feature/pYe-s19-runtime-status-snapshot-publication" ;
        atm:commit  "d2694d8b" ;
        atm:file    "crates/atm-daemon/src/runtime_status_cache.rs" ;
        atm:lines   "198-211" ;
        atm:note    "snapshot() at line 198 and snapshot_for_members() at line 203: both use ArcSwap load — no Err path possible; Result wrapper is infallible; RBP-007 violated" ;
        atm:verdict "CONFIRMED"
    ] ;
    atm:occurrence [
        atm:branch  "feature/pYe-s23-phase-end-architecture-proof" ;
        atm:commit  "197272e1" ;
        atm:file    "crates/atm-daemon/src/runtime_status_cache.rs" ;
        atm:lines   "198-211" ;
        atm:note    "Same ArcSwap implementation as s19; snapshot() and snapshot_for_members() infallible Result — RBP-007 violated" ;
        atm:verdict "CONFIRMED"
    ] ;

