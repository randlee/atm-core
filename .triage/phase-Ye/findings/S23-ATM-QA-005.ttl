        atm:lines   "120-121" ;
        atm:note    "Y.23 label on line 120, 'phase-end proof' text on line 121 — split across 2 lines; rg 'Y.23.*phase-end proof' does not match" ;
        atm:verdict "CONFIRMED"
    ] ;

