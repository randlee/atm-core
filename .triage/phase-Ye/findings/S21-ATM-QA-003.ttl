<urn:atm:triage:finding/S21-ATM-QA-003>
  a triage:Finding ;
  triage:findingId "S21-ATM-QA-003" ;
  triage:title "ReconcileCommand NOT wired to bounded mpsc channel — command routing still inside Mutex lock" ;
  triage:description "reconcile_runtime.rs:402-438 — enqueue_reconcile_command() matches the command inline inside a Mutex lock. No SyncSender<ReconcileCommand>/Receiver<ReconcileCommand> channel exists. The actor boundary is a documentation artifact only. The core sprint Y.21 closure invariant (bounded channel owns command queue) is unmet." ;
  triage:phaseId "phase-Ye" ;
  triage:triageMode "initial_pass" ;
