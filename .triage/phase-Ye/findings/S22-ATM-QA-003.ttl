<urn:atm:triage:finding/S22-ATM-QA-003>
  a triage:Finding ;
  triage:findingId "S22-ATM-QA-003" ;
  triage:title "Struct shape doc drift — sprint doc Proposed Design does not match landed struct shape" ;
  triage:description "sprint-Y22.md Proposed Design table diverges from the implementation in reconcile_runtime.rs on feature/pYe-s22-reconcile-runtime-cutover in two ways. (1) ReconcileRuntimeStatus: doc shows three fields (started, shutdown_requested, degraded_message); landed code has four fields (adds shutdown_started_at: Option<Instant> at line 36). (2) ReconcileRuntime: doc shows a flat struct with fields tx, status, worker, observability; landed code uses a newtype wrapper pattern with a single field inner: Arc<ReconcileRuntimeInner>, where the actual fields live in the private ReconcileRuntimeInner struct (command_tx, command_rx, status, worker, debounce, executor, notification_sink, shutdown_deadline, observability, start_claimed). sprint-Y22.md Proposed Design must be updated to reflect the actual landed struct shapes." ;
  triage:phaseId "phase-Ye" ;
  triage:triageMode "initial_pass" ;
  triage:category "doc-drift" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_and_doc" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:dispatchBlockedPendingTriageCommit true ;
  triage:triagedAt "2026-05-20T00:00:00Z"^^xsd:dateTime ;
