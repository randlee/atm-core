  a triage:Finding ;
  triage:findingId "S20-RSH-001" ;
  triage:title "persist_notification() blocking file I/O cannot be interrupted mid-write by shutdown deadline" ;
  triage:description "crates/atm-daemon/src/notification_runtime.rs — persist_notification() blocking file I/O cannot be interrupted mid-write by shutdown deadline. Guards at :575/:577/:599 check only before each I/O op, not during write_all/flush. TODO(Y.14) at :611 acknowledges this. Service hardening finding." ;
