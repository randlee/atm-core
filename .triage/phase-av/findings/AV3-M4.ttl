<urn:atm:triage:finding/AV3-M4>
  a triage:Finding ;
  triage:findingId "AV3-M4" ;
  triage:title "code_mask raw-string closing-delimiter find lacks exact-length boundary check for hash-count-ambiguous content" ;
  triage:description "req-qa N2 (QA-r3): in .just/rust_source.py code_mask (raw-string masking added by fix-r2 5c9ed27b6, ~lines 22-56), the closing-delimiter find for raw strings lacks an exact-length boundary check, so hash-count-ambiguous content can be mis-terminated. Fix: add an exact-length boundary check on the closing delimiter and a pytest fixture in .just/tests/test_check_read_concurrency_gates.py (or the rust_source tests) pinning the ambiguous case." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
