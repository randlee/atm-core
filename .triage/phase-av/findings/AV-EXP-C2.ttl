<urn:atm:triage:finding/AV-EXP-C2>
  a triage:Finding ;
  triage:findingId "AV-EXP-C2" ;
  triage:title "Fail-open after supervisor death, contra ADR-059 D2 fail-closed" ;
  triage:description "After handoff supervisor death, reads keep returning Ok accepted=false indefinitely; RuntimeHealth has no handoff field; only surface is a doctor Warning; rejected_buffer_full never surfaced while Ready. ADR-059 D2 requires fail-closed on restart exhaustion or permanent writer failure; implementation is fail-open with inadequate observability." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "AV-EXP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-09-01T01:03:10Z"^^xsd:dateTime ;
  triage:foundIn triage:AV4 ;
  triage:foundAt "2026-09-01T01:03:10Z"^^xsd:dateTime ;
