<urn:atm:triage:finding/RBQA-AV1A-R5-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AV1A-R5-F001" ;
  triage:title "sqlite_owner_roots carve-out exempts direct_sqlite_io by directory membership without a declared concrete boundary record" ;
  triage:description "Fix-r4's concrete-owner delegation carve-out in .just/lint_boundaries.py (concrete_trait_implementation_delegates :2040-2068 and concrete_owner_delegates_trait_implementation :2071-2087 at f31a35484) exempts the direct_sqlite_io tag for ANY file under an io_owns=[sqlite] owner's src/ by directory membership alone. Three production implementers have NO declared concrete boundary record yet are silently exempted: crates/atm-storage-rusqlite/src/nudge_template_override_store.rs (rusqlite use :9, impl :20), crates/atm-storage-rusqlite/src/pending_nudge_store.rs (:8, :19), crates/atm-storage-rusqlite/src/graft_receiver_endpoint_store.rs (:10, :37). Their trait records boundaries/atm-storage/{nudge-template-override-store,pending-nudge-store,graft-receiver-endpoint-store}.toml are trait_only and forbid direct_sqlite_io; boundaries/atm-storage-rusqlite/ holds no sibling concrete record for any of the three. Scope is narrow: only direct_sqlite_io is exempted; process_spawn/socket_io/message_delivery/template_rendering are still scanned on those files. Functionally safe today; governance gap in the new carve-out code." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "tooling" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "Enumerate every io_owns=[sqlite] (and other io_owns values) owner root the carve-out honors, and every production file under those roots that is exempted for the owned tag while lacking a declared concrete boundary record in boundaries/" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-31T17:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AV1A ;
  triage:foundAt "2026-08-31T16:02:24Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AV1A-R5-F001/R1-carveout-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AV1A-R5-F001/R1-carveout-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AV1A-R5-F001/R1-nudge-impl> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AV1A-R5-F001/R1-pending-impl> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AV1A-R5-F001/R1-graft-impl> ;
  triage:triageRecordVersion "1" .

