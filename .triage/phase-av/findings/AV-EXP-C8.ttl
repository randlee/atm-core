<urn:atm:triage:finding/AV-EXP-C8>
  a triage:Finding ;
  triage:findingId "AV-EXP-C8" ;
  triage:title "mail_seen_watermarks: no migration/backfill + divergent file-backed store still live; rollout re-presentation risk, rollback strands watermarks" ;
  triage:description "mail_seen_watermarks feature lacks migration/backfill logic for existing deployments; divergent file-backed watermark store implementation still active in codebase. Introduces rollout re-presentation risk (readers see messages they previously marked as seen) and rollback stranding conditions (watermarks committed to DB but not synced on rollback). Multiple schema definitions and access paths without coordinated migration strategy." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
