<urn:atm:triage:finding/AV1A-M10>
  a triage:Finding ;
  triage:findingId "AV1A-M10" ;
  triage:title "storage-notifier boundary record relies on derived trait-declaration scan while its only implementer is cfg(test)-scoped — should declare no_in_repo_implementation = true (or an explicit mapping)" ;
  triage:description "QA-r4 for AV.1a (req-qa ATM-QA-005; quality-mgr msg 01M1BKTNPEPP28VYKGFSQPGE9N, PR #1112 comment 5476685496) @ 1e81aade8: boundaries/atm-storage/storage-notifier.toml is trait_only with non-empty io_forbidden and neither an io_forbidden_source_modules mapping nor enforcement.no_in_repo_implementation = true; it passes the fail-closed lint only via the derived trait-contract-region default (trait_contract_source_regions in .just/lint_boundaries.py). Its only in-repo implementer is #[cfg(test)]-scoped, so the weak default is benign today but silence is accidental rather than declared." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "tooling" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "all boundaries/**/*.toml trait_only records with io_forbidden that have neither io_forbidden_source_modules nor enforcement.no_in_repo_implementation" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-31T10:00:00Z"^^xsd:dateTime ;
