<urn:atm:triage:finding/AV-PROD-001R>
  a triage:Finding ;
  triage:findingId "AV-PROD-001R" ;
  triage:title "Evidence schema incomplete: JSON artifacts and reporting structure lack execution_account/uid/home fields for audit provenance" ;
  triage:description "Residual finding extracted from AV-PROD-001 counter-evidence: arch-ctm prod review confirmed account-level execution (atmbench@rand-m5.local) for all official AV.4 campaigns; however, the reporting JSON schema in site/reports/read-query-benchmark/ and scripts/smoke/read_benchmark.py schema-emit code do not include execution_account, uid, home, or equivalent audit provenance fields. As-committed artifacts can PASS AV.4 because account identity was verified separately, but future audits cannot reconstruct that proof from the JSON alone. Requires post-merge schema enhancement per Rand's directive: add execution-account metadata capture to both campaign artifact JSON generation and smoke report envelope schema." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "evidence-schema" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-31T14:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AV4 ;
