<urn:atm:triage:finding/AV-EXP-C5B>
  a triage:Finding ;
  triage:findingId "AV-EXP-C5B" ;
  triage:title "Per-worker queue head-of-line blocking + quarantine wedge" ;
  triage:description "Reader pool per-worker reservation binds a request to one worker for its whole deadline with no re-reservation, allowing up to queue_per_worker (4) requests to wait behind one slow query while other workers idle. Quarantine wedge: when all workers are quarantined, every reservation rejects Saturated until a stuck job returns. Tempered per adjudication." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "AV-EXP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
