<urn:atm:triage:finding/AV1A-I6>
  a triage:Finding ;
  triage:findingId "AV1A-I6" ;
  triage:title "Boundary-lint io_forbidden enforcement blind spot: only implementation.module scanned; reader-lane files unowned; trait_only records skipped" ;
  triage:description "collect_io_forbidden_source_violations() in .just/lint_boundaries.py scans only each boundary record's declared implementation.module. crates/atm-storage-rusqlite/src/shared_db_reader_lanes.rs (holds Connection::open_with_flags + SqliteWriter reference) and crates/atm-storage-rusqlite/src/reader_pool.rs are owned by no boundary record, and trait_only records (boundaries/atm-storage/async-mailbox-reader.toml) are skipped entirely — so the AV1A-M4 write_capable_connection/writer_lane io_forbidden tags cannot fire where the guarded constructs actually live. Functionally safe today (readers never touch SqliteWriter; TestOnlyWriterLane is cfg(test)-gated) — mechanical-gate gap only." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "followup_pass" ;
  triage:category "tooling" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "all boundaries/**/*.toml records with io_forbidden entries vs the source files that actually contain the guarded constructs; .just/lint_boundaries.py collect_io_forbidden_source_violations" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:closedAt "2026-08-31T16:05:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:resolutionNote "QA-r5 @ f31a35484 (fix-r4: eb9744b4b implementer scan + f68257608 M10 waiver + f31a35484 M11 recount). All occurrences verified fixed firsthand + req-qa/rust-qa/boundary-guard/ruthless. Battery: lint_boundaries PASS, pytest .just/tests 528/10, just lint 32/32, just test PASS, atm-architecture 81, workspace 1528." ;
  triage:triagedAt "2026-08-31T10:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AV1A ;
  triage:foundAt "2026-08-31T08:49:00Z"^^xsd:dateTime ;
