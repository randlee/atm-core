<urn:atm:triage:finding/AV1A-I1>
  a triage:Finding ;
  triage:findingId "AV1A-I1" ;
  triage:title "Selection semantics duplicated between metadata_selection.rs and read/selection.rs; list.rs consumes the old copies in production" ;
  triage:description "crates/atm-core/src/read/metadata_selection.rs:286-397 (logical_current_messages, bucket_counts_for, select_messages, hidden_from_normal_views, hidden_for_selection, effective_display_envelope) near-byte-duplicates crates/atm-core/src/read/selection.rs:208-281, and list.rs:12-16,171,178 consumes the old copies in the production `atm list` path. D6's extraction is delivered (production read/peek delegates via metadata_selection::selection_state_for_mailbox_metadata_rows into selection.rs) so not blocking, but D6's invariant 'business semantics exist exactly once' is not achieved. Fix: make the metadata_selection copies delegate to / be replaced by selection.rs and route list.rs through the canonical entry point. Consolidated arch-qa ARCH-002 + req-qa 002 (downgraded) + ruthless F001." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-08-31T09:20:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-30T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AV1A ;
  triage:foundAt "2026-08-31T06:33:00Z"^^xsd:dateTime ;
