<urn:atm:triage:finding/AV-PROD-003>
  a triage:Finding ;
  triage:findingId "AV-PROD-003" ;
  triage:title "Floor-breach official campaign aborts in engage_ratchet() before payload emission — evidence trail lost, contradicting D7 every-attempt-committed contract" ;
  triage:description "quality-mgr delta review of 16704d9ac (msg 01M1D8J805J3312J077WMRSX6V): engage_ratchet() raises ReadBenchmarkError on any non-PASS result and execute() calls it before build_payload, so a floor-breach official campaign emits no campaign/family JSON, report, or envelope. Regresses prior behavior (failed campaign still emitted evidence, exit 1). Fail direction closed (no wrong evidence), hence important not blocking. Fix dispatched to Cipher-311d (msg 01M1D8RGQXK7CCS5NTTWHHP6RK): ratchet engages only on clean campaigns; dirty campaign records ratchet={engaged:false, reason} and still emits, exiting nonzero." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable false ;
