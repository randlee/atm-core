<urn:atm:triage:finding/AV1A-I2>
  a triage:Finding ;
  triage:findingId "AV1A-I2" ;
  triage:title "ReadLaneError -> AtmError conversion collapses all variants into daemon_unavailable" ;
  triage:description "Both conversion sites (crates/atm-runtime/src/mailbox_runtime.rs and crates/atm-storage-rusqlite/src/search_reader.rs) flatten every ReadLaneError variant (UnauthorizedScope/Saturated/DeadlineExpired/Unavailable) into AtmError::daemon_unavailable(to_string()), bypassing the AtmErrorCode catalog and with_cause. Fix: one shared conversion mapping variants to distinct codes." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-30T06:33:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AV1A ;
