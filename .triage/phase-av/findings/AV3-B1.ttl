<urn:atm:triage:finding/AV3-B1>
  a triage:Finding ;
  triage:findingId "AV3-B1" ;
  triage:title "D2 mandated primary positive-obligation allowlist gate absent; only deny-list scaffolds built" ;
  triage:description "boundary_enforcement.rs:3467-3501 (handler region) and :3503-3531 (composition-layer sibling) are pure `!region.contains(banned)` loops over 9 and 6 literal strings. Sprint doc §D2 mandates positive-obligation-first: read handlers restricted to the AsyncMailboxRuntime port, doctor to DoctorProjection, composition layer to {AsyncMailboxReader, lane handles, read::selection, StateHandoffSupervisor}; anything unlisted fails. As built, a freshly named 1-permit gate (FreshSemaphoreGate) called from list_messages passes both tests. AV.1b A1 cites 'the AV.3 D2 allowlist' as its assertion mechanism, so the gap propagates forward. Reviewer ids ARCH-AV3-1/2, REQ-AV3-001, RBQA-AV3-001." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-gap" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
