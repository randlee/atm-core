<urn:atm:triage:finding/AV3-M1>
  a triage:Finding ;
  triage:findingId "AV3-M1" ;
  triage:title "Three independent brace-depth scanners with no shared primitive or parity check" ;
  triage:description "lint_boundaries.py, check_read_concurrency_gates.py, and boundary_enforcement.rs now each carry their own brace-depth scanner with no shared primitive or parity test — the mechanism by which AV3-B2 went undetected. Reviewer id RBQA-AV3-005. Expected to be remediated together with AV3-B3 by the syn-AST vs hardened-string decision." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "duplication" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope ".just/*.py and crates/atm-architecture/tests/*.rs for brace/region scanners" ;
  triage:status "open" ;
  triage:dispatchReady true ;
