<urn:atm:triage:finding/AV3-M8>
  a triage:Finding ;
  triage:findingId "AV3-M8" ;
  triage:title "atm_storage contract sealed::Sealed is pub in a pub module — the seal is advisory, not type-enforced (pre-existing)" ;
  triage:description "The sealed-trait marker used by the atm-storage contract traits (sealed::Sealed) is declared pub inside a pub mod sealed, so any downstream crate can impl Sealed for its own type and the trait seal does not actually prevent foreign implementations." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "deferred" ;
  triage:dispatchReady false ;
  triage:deferredNote "quality-mgr ruling 2026-08-31 (QA-AV3 early-signal adjudication, fenix msg 01M1BMCBYZ30H3PB24XT5PHHZS): deferred, by-design. atm_storage::contract::sealed::Sealed is deliberately implementable workspace-wide (impl sites in atm-core, atm-graft, atm-runtime, atm-template-sc-compose, atm-daemon-bootstrap); a type-enforced seal cannot be introduced without breaking the build. Closure path is documentation only: a one-line clarification in the atm-storage boundary record / docs/architecture.md that the seal is advisory and cross-crate by design, ridable in any future doc round. Not a phase-AV dev item." ;
  triage:deferredBy "quality-mgr" ;
  triage:deferredAt "2026-08-31T10:08:00Z"^^xsd:dateTime ;
  triage:triagedAt "2026-08-31T10:05:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AV3 ;
  triage:foundAt "2026-08-31T10:05:00Z"^^xsd:dateTime ;
