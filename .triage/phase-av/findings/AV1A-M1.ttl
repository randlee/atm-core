<urn:atm:triage:finding/AV1A-M1>
  a triage:Finding ;
  triage:findingId "AV1A-M1" ;
  triage:title "Instant::now() + deadline unguarded in reader_pool.rs; pathological Duration panics instead of failing closed" ;
  triage:description "crates/atm-storage-rusqlite/src/reader_pool.rs:363 and :431 compute Instant::now() + deadline without a guard; a pathological Duration panics. Clamp at ReadDeadline::new or use checked_add and fail closed. rust-qa." ;
  triage:phaseId "phase-av" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "minor" ;
