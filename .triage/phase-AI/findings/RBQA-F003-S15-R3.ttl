<urn:atm:triage:finding/RBQA-F003-S15-R3>
  a triage:Finding ;
  triage:findingId "RBQA-F003-S15-R3" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T19:54:00Z"^^xsd:dateTime ;
  triage:title "daemon-log delta slice has no startswith check -- log rotation/truncation silently produces an always-passing empty delta" ;
  triage:description "In scripts/smoke/run_peer_pair.py's semantic-verification mechanism (added on feature/pAI-s15-windows-peer-smoke, commit 12f4b96e), the daemon-log delta slice used for untrusted/allowlist rejection has no startswith check against the pre-case log snapshot. If the daemon log rotates or truncates between the pre-case snapshot and the post-case read, the delta slice silently computes empty, and the forbidden-entries check trivially passes with no real verification having occurred. This is a genuine code bug found by ruthless-boundary-qa during QA-2 verification of the BLOCKING-02/04 fix on PR #611." ;
  triage:category "RBQA" ;
  triage:phaseId "phase-AI" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-26T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-07-26T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "AICH-S7-QA-FIX-2: verified fixed on commit bb34e71a (PR #642, feature/pAI-s27-peer-delivery-observability) -- scripts/smoke/run_peer_pair.py:295 now has 'if not after.startswith(daemon_log_before)' guard, refusing an unverified delta and surfacing daemon_log_delta in the outcome instead of silently passing on rotation/truncation. Confirmed via direct git show of current branch head, not self-report." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003-S15-R3/s15/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003-S15-R3/s16/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003-S15-R3/s17/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003-S15-R3/s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003-S15-R3/s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F003-S15-R3/s27/1> ;
  triage:openOn <urn:atm:triage:worktree/s27> ;
  triage:promoteTo <urn:atm:triage:worktree/s27> .

