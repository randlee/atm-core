<urn:atm:triage:finding/AI23-IMPORTANT-004>
  a triage:Finding ;
  triage:findingId "AI23-IMPORTANT-004" ;
  triage:title "ADR-033 HTTP endpoint route table disagrees with requirements.md/http-api.md/actual encode_response code" ;
  triage:description "docs/adr/ADR-033-http-endpoint-contract.md (lines ~23-29, status Accepted) describes a route family with no per-message path parameter at all (/messages, /messages/inspect, /messages DELETE, /messages/read, /doctor). This disagrees with docs/requirements.md (lines ~3641-3643: /v1/atm/messages, /v1/atm/message/{message-id}, /v1/atm/message/{message-id}/read), docs/plans/phase-ai/README.md (same singular/{message-id} shape), docs/atm-daemon/http-api.md, and the actual Location header construction in crates/atm-core/src/api.rs (lines 361/367: format!(\"/v1/atm/message/{}\", value.message_id)) which uses a real per-message id path segment. These cannot both be the accepted contract -- one has drifted. AI.23's sprint doc 'Required Document Updates' section lists ADR-034/ADR-035 but not ADR-033, so this drift is currently unowned by any sprint." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-24T23:23:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-004/AI23/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-004/AI23/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-004/AI23/3> ;
  triage:openOn <urn:atm:triage:worktree/AI23/b88ca016> ;
  triage:promoteTo <urn:atm:triage:worktree/AI23/b88ca016> .

