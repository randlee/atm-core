<urn:atm:triage:finding/AI3152-HTTPS-SHUTDOWN-002>
  a triage:Finding ;
  triage:findingId "AI3152-HTTPS-SHUTDOWN-002" ;
  triage:title "HTTPS keeps accepting new requests after daemon shutdown enters Draining" ;
  triage:description "Reported by arch-ctm's phase-end critical web/transport review against integrate/phase-ai-31-33@577067ae. composition.rs:272-280 only changes lifecycle state; local serve drains in :406-417, and finish_runtime calls stop_https_listeners only afterward at :509. https_transport.rs:420-477 has no composition-lifecycle gate and keeps accepting/routing until its separate stop flag changes. Thus peer writes can be admitted during local shutdown, contrary to requirements.md:3940-3942 and boundaries.md:46-49. required_correction: Stop HTTPS accepts/coordinator in the initial shutdown phase, then drain/cancel all listener work under the one shutdown budget." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "Blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-02T01:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI-PHASE-END-REVIEW ;
  triage:foundAt "2026-08-02T01:23:08Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-02T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:progressNote "AI3152-PHASEEND-QA-1 (commit d2891ab5): req-qa, arch-qa, and ruthless-boundary-qa independently confirmed fixed. composition.rs begin_shutdown (lines 272-291) now transitions to Draining and immediately calls the new stop_https_accepting(), which HttpsListenerSet::stop_accepting (https_transport.rs ~402-423) implements by flipping a shared AtomicBool gate and self-connecting to unblock accept(); accept_loop (~426-484) re-checks the flag after accept() returns so no new peer write is admitted once Draining begins. finish_runtime still calls stop_https_listeners() later for the join/drain step. Covered by test stop_accepting_flips_the_shared_listener_gate_before_shutdown_join (https_transport.rs:1100-1120)." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3152-HTTPS-SHUTDOWN-002/W0-OCC-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3152-HTTPS-SHUTDOWN-002/W0-OCC-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3152-HTTPS-SHUTDOWN-002/W0-OCC-3> ;
  triage:triageRecordVersion "2" .

