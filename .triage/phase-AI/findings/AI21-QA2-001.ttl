<urn:atm:triage:occurrence/AI21-QA2-001/pAI-s21pre/1>
  a triage:Occurrence ;
  triage:file "scripts/smoke/inbound-peer-smoke.example.json" ;
  triage:line 14 ;
  triage:snippet "\"local_checks\": { \"localhost/local loopback\": [...], \"own-IP\": [...] }" ;
  triage:description "Shipped example config declares only 2 of 3 required host.local_checks keys. Missing nudge entry causes nudge check to be silently not-run under the documented two-peer workflow, contradicting the sprint's own acceptance criterion that no result row shall be an inferred/silent success." ;
  triage:status "open" ;
