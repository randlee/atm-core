<urn:atm:triage:finding/AI11-BLOCKING-01-WINDOWS-NAMED-PIPE>
  a triage:Finding ;
  triage:findingId "AI11-BLOCKING-01-WINDOWS-NAMED-PIPE" ;
  triage:title "Windows named-pipe IPC endpoint mapping contradicts AI phase mandate (delete, not retain)" ;
  triage:description "Post-merge audit of integrate/phase-AI (quality-mgr + qa-triage independent confirmation). Sprint-ai-6.md Deliverable 4 explicitly required 'Delete Windows named-pipe mapping/fallback... retain none'. Phase-AI plan mandates 'no named pipes, AF_UNIX only'. Live production code at crates/atm-core/src/protocol.rs:185-222 contains platform_local_ipc_endpoint_path (cfg(windows) block at 197-222) which builds named pipe paths (\\\\\\\\.\\\\pipe\\\\atm-{leaf}-{hash} pattern). This is called from daemon_local_ipc_name_from_path (line 186) with 13+ call sites across atm-daemon, atm-daemon-client, atm-graft, and atm CLI. Docs/atm-daemon/architecture.md:200-205 has a stale self-contradictory passage permitting it, 3 lines below its own 'Phase AI supersession notice.' The deliverable was not met." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "deliverable-violation" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI11-BLOCKING-01/pAI-11/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-11/8d0ccf01> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-11-remediation/0> ;
  triage:highestOpenBranch "feature/pAI-s11-post-merge-remediation" ;
  triage:highestFixedBranch "none" ;
  triage:triagedAt "2026-07-21T00:00:00Z"^^xsd:dateTime ;
  triage:reviewedBy "qa-triage", "quality-mgr" ;
  triage:notes "Post-merge audit finding. Scope: atm-core/protocol.rs + all call sites (13+ references across daemon/client/graft/cli). Deliverable evidence: docs/phase-ai/sprint-ai-6.md line 4, docs/project-plan.md phase-AI mandate. Architecture doc needs update: docs/atm-daemon/architecture.md:200-205 must remove stale named-pipe permission or add Phase-AI supersession clarification." .

