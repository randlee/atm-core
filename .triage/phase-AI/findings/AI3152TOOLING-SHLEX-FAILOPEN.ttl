<urn:atm:triage:finding/AI3152TOOLING-SHLEX-FAILOPEN>
  a triage:Finding ;
  triage:findingId "AI3152TOOLING-SHLEX-FAILOPEN" ;
  triage:title "is_daemon_build() fails open (treats as non-daemon-build) on shlex tokenization ValueError" ;
  triage:description "is_daemon_build() catches shlex.split()'s ValueError and fails OPEN (returns False / not-a-daemon-build) on Justfile recipe lines containing an inline comment with an apostrophe, or a trailing backslash line-continuation. Reproduced directly by arch-qa during QA-3 review of commit 4c867d69: both patterns raise ValueError (\"No closing quotation\", \"No escaped character\"). Not currently triggered by the live Justfile content, but unguarded and untested -- a future \"cargo build ... atm-daemon\" recipe line written either way would silently bypass the signing-hook lint meant to enforce devcert signing on daemon builds. This is a security-relevant fail-open gap in a build-gate/lint tool." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-03T21:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI3152-TOOLING-QA3 ;
  triage:foundAt "2026-08-03T21:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3152TOOLING-SHLEX-FAILOPEN/DAEMON-2> ;
  triage:triageRecordVersion "1" .

