<urn:atm:triage:finding/RBQA-F002>
  a triage:Finding ;
  triage:findingId "RBQA-F002" ;
  triage:title "site/index.html ownership conflict across AI.46/AI.47/architecture.md" ;
  triage:description "Three conflicting claims about site/index.html ownership: (1) AI.46 sprint doc claims it creates only site/reports/index.html; (2) AI.47 sprint doc claims it generates site/index.html with a link to AI.46's file; (3) docs/architecture.md states both site/index.html and site/reports/index.html are generated by just reports-index (an AI.46 deliverable), contradicting AI.47's ownership claim." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "docs-consistency" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "docs" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T20:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI46 ;
  triage:foundAt "2026-07-31T20:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-07-31T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "AI-REPLAN-AI52-QA-2: docs/architecture.md now states 'AI.47 owns generation of site/index.html'; sprint-ai-46-pages-report-index.md states 'AI.47 owns site/index.html' and scopes itself to site/reports/index.html only; sprint-ai-47-pages-site-home.md generates site/index.html linking to AI.46's reports index. All three sources now agree, at 332c2f7c; confirmed by quality-mgr plus req-qa, arch-qa, ruthless-boundary-qa." ;
