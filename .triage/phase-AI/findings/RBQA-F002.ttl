<urn:atm:triage:finding/RBQA-F002>
  a triage:Finding ;
  triage:findingId "RBQA-F002" ;
  triage:title "Command allowlist enforcement checks basename only, not binary identity — bypassable" ;
  triage:description "scripts/smoke/run_peer_pair.py defines `ALLOWED_CLIENT_BINARIES = {\"atm\", \"atm.exe\", \"atm-graft\", \"atm-graft.exe\"}` and `require_client_command()` checks membership via `Path(command[0]).name.lower()` — a basename-only check (confirmed at line 71-73). A PATH-shadowed or absolute-path attacker binary named \"atm\" (not the real atm binary) bypasses this allowlist entirely. This is exactly the attack shape BLOCKING-03's own original description named, so the fix is incomplete against its own stated threat model." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T20:00:00Z"^^xsd:dateTime ;
