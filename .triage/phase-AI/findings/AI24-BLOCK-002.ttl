<urn:atm:triage:finding/AI24-BLOCK-002>
  a triage:Finding ;
  triage:findingId "AI24-BLOCK-002" ;
  triage:foundAt "2026-07-25T08:09:06Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S4 ;
  triage:title "AICH-S4-FIX-1 batch breaks AI.23 single-write-resource-ingress invariant" ;
  triage:description "Test ai23_write_ingress_has_one_http_resource_and_no_adapter_side_effects passes at c528137c (s23) but fails at 7bb63e01 (s24). The test performs a literal string match for RequestEnvelope::Write(_) => (\"POST\", \"/v1/atm/messages\".to_string()). In s24, this was refactored to use a MESSAGES_PATH constant, breaking the assertion. The new PeerSync route was added in the same batch, suggesting routing infrastructure changes triggered the refactor." ;
  triage:category "architecture" ;
  triage:phaseId "phase-AI" ;
  triage:severity "Blocking" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:reassignReason "Fixed on the same branch (s24) by commit 6d8ee8c3 ('fix: align AI24 boundary guards with canonical routing'), confirmed by direct diff inspection -- the test assertion now checks for the MESSAGES_PATH constant instead of the removed literal string. Matches qa-evidence-master's AICH-S4-FIX2 result (blockers=0, result_time_utc 2026-07-25T08:22:21Z, just after the fix commit). TTL was never updated to closed after the fix landed; no re-fix needed." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI24-BLOCK-002/s24/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI24-BLOCK-002/s24/2> ;
