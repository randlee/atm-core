<urn:atm:triage:finding/AI25-ATMQA-005>
  a triage:Finding ;
  triage:findingId "AI25-ATMQA-005" ;
  triage:title "New live-trust-refresh integration test bypasses the real CLI-mutation-to-signal-to-reload entry point" ;
  triage:description "FIX-1 (commit a9e61fb0) added live_trust_refresh_keeps_one_listener_reachable — a genuine new test that binds a listener, calls refresh_trusted_peers, asserts the bound address is unchanged, and performs a real TLS handshake + HTTP round-trip through the same listener post-refresh. This test does close the base AI25-ATMQA-001 Blocking finding. However, req-qa flags (ATM-QA-103) that the test exercises HttpsListenerSet::refresh_trusted_peers directly, not the full CLI-mutation → operator-signal → reload_runtime_view → refresh_https_trust path through the real signal-handling entry point in lifecycle_control.rs. This means the rewritten Deliverable 4's own acceptance criterion is still not end-to-end proven. This residual gap should be fixed alongside (or resolved by the outcome of) AI25-ATMQA-002's governance/rescoping issue, since if a real CLI-to-daemon trigger is implemented for ATMQA-002, this test gap should be closed as part of the same work." ;
  triage:phaseId "phase-AI" ;
  triage:category "test-coverage" ;
  triage:severity "Important" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T03:58:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI25-ATMQA-005/s25/1> ;
