<urn:atm:triage:finding/AI3138-HERMES-RESTART-REBIND-GAP>
  a triage:Finding ;
  triage:findingId "AI3138-HERMES-RESTART-REBIND-GAP" ;
  triage:title "AI.37 restart-summary recovery is not viable through Hermes' actual reset model" ;
  triage:description "arch-ctm's read-only AI3138-HERMES-HARNESS-REVIEW-1 (finding 4/4, CRITICAL) reports the ATM bridge schedules a one-shot count callback after a hypothetical start() (bridge.py:56-66,88-107), then the adapter calls session.steer. After a Hermes gateway reset, session.steer looks only in in-memory _sessions and rejects missing/agentless sessions (hermes tui_gateway/server.py:2064-66,10998-11003); there is no ATM/Hermes resume or rebind code. So the AI.37-specified 10-second recovery nudge cannot reach a restarted gateway/session. This was independently corroborated the same day by a second reviewer, skillrx, in an unsolicited review of integrate/phase-ai-31-33 (message 2026-07-30T00:10:46Z): 'AI.37 recovery vs real reset DESIGN GAP: 10s callback assumes session survives gateway restart -- doesn\'t. ADR-043 defers.' Recommendation from arch-ctm: lifecycle integration must wait for/rebind to a live session, then run exactly one 10s durable-count check; retain no mail queue/retry loop." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "integration-architecture" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-30T00:49:00Z"^^xsd:dateTime ;
