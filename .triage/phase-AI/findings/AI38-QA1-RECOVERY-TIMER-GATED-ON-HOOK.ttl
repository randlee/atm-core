<urn:atm:triage:finding/AI38-QA1-RECOVERY-TIMER-GATED-ON-HOOK>
  a triage:Finding ;
  triage:findingId "AI38-QA1-RECOVERY-TIMER-GATED-ON-HOOK" ;
  triage:title "AI.37 mandatory 10-second recovery count check only schedules when recovery_hook is non-null" ;
  triage:description "crates/atm-graft-python/python/atm_graft_hermes_bridge.py: the bridge constructor accepts recovery_hook: Callable[[MailboxRecoveryNotice], None] | None = None (around line 42) and the recovery-timer scheduling logic (around lines 60-67, guarded by `if self._recovery_hook is not None:`) only calls loop.call_later(RECOVERY_DELAY_SECONDS, self._emit_recovery_summary) inside that conditional block. RECOVERY_DELAY_SECONDS = 10.0 (line 18) is documented as AI.37's mandatory delayed recovery-summary check, but if no recovery_hook is supplied at construction, the 10-second timer is never scheduled at all, silently disabling the mandatory recovery-summary mechanism rather than running it unconditionally and only gating the hook invocation itself." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
