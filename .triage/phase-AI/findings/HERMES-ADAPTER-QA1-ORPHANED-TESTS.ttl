<urn:atm:triage:finding/HERMES-ADAPTER-QA1-ORPHANED-TESTS>
  a triage:Finding ;
  triage:findingId "HERMES-ADAPTER-QA1-ORPHANED-TESTS" ;
  triage:title "Orphaned test file with external hard dependency, not run by CI" ;
  triage:description "crates/atm-graft-python/tests/test_hermes_adapter.py exists with 3 test methods (test_adapter_inherits_hermes_base_contract, test_lifecycle_and_send_signatures_match_gateway, test_chat_id_parser_preserves_agent_chat_and_team) that verify the AtmGraftAdapter fix for the Hermes gateway crash. However: (1) Tests hard-import gateway.platforms.base, a module NOT in atm-core repo and only exists in external Hermes checkout. (2) Justfile recipe test-hermes-graft-bridge discovers test_hermes_bridge.py only (line 42: -p 'test_hermes_bridge.py'). (3) Zero references to test_hermes_adapter.py in Justfile, scripts/, .github/workflows/. (4) Tests only pass if developer has separate Hermes checkout with manual PYTHONPATH setup. (5) No CI job automates this test discovery, leaving fix regression safety unverified. Net effect: 3 tests are dead/orphaned coverage despite verifying a real regression fix." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
