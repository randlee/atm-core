<urn:atm:triage:finding/ATM-QA-I3-AI3>
  a triage:Finding ;
  triage:findingId "ATM-QA-I3-AI3" ;
  triage:title "MessageStore/RosterStore/StorageNotifier remain unsealed while NudgeTemplateOverrideStore is sealed (inconsistent trait-boundary discipline)" ;
  triage:description "AI3-QA-1 (ruthless-boundary-qa, important). crates/atm-storage/src/contract.rs defines a sealed module (contract.rs:12) and NudgeTemplateOverrideStore at line 474 bounds itself with `sealed::Sealed + Send + Sync`, preventing external implementations. MessageStore (line 456), RosterStore (line 463), and StorageNotifier (line 469) have no such bound -- any downstream crate can implement them directly, bypassing the storage boundary AI.3/AI.2 are trying to establish. Confirmed on feature/pAI-s3-error-contract-foundation." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-I3-AI3/pAI-3/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-4/3679a9b3> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-4/3679a9b3> ;
  triage:highestOpenBranch "feature/pAI-s4-error-consumer-migration" ;
  triage:resolution "OPEN: dispatch-ready. Fix on feature/pAI-s4-error-consumer-migration: add `sealed::Sealed + Send + Sync` bound to MessageStore, RosterStore, and StorageNotifier at crates/atm-storage/src/contract.rs:456,463,469, matching NudgeTemplateOverrideStore's pattern at line 474; update in-crate sealed impls for the concrete store types accordingly and confirm the workspace still compiles with only in-crate implementors." ;
  triage:triagedAt "2026-07-20T22:28:00Z"^^xsd:dateTime .

<urn:atm:triage:occurrence/ATM-QA-I3-AI3/pAI-3/1>
  a triage:Occurrence ;
  triage:file "crates/atm-storage/src/contract.rs" ;
  triage:line 456 ;
  triage:snippet "pub trait MessageStore { ... } (line 456), pub trait RosterStore { ... } (line 463), pub trait StorageNotifier { ... } (line 469) -- all unsealed; contrast pub trait NudgeTemplateOverrideStore: sealed::Sealed + Send + Sync (line 474)" ;
  triage:status "open" ;
  triage:closed false ;
