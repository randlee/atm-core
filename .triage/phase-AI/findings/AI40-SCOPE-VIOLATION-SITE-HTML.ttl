<urn:atm:triage:finding/AI40-SCOPE-VIOLATION-SITE-HTML>
  a triage:Finding ;
  triage:findingId "AI40-SCOPE-VIOLATION-SITE-HTML" ;
  triage:title "AI.40 ships AI.49's out-of-scope HTML/site output" ;
  triage:description "scripts/smoke/run_admission_capacity.py's DEFAULT_EVIDENCE_DIR points at site/reports/send-message-benchmark; `just benchmark` writes there by default; benchmark_report.py (an HTML/XHTML renderer) is wired into this branch's justfile with output already committed. This directly contradicts AI.40's own sprint doc (docs/plans/phase-ai/sprint-ai-40-local-transport-benchmark.md), which states AI.40 'neither writes site/ artifacts nor renders HTML' and lists this as an explicit AI.49 non-goal exclusion for AI.40. AI.49 (which owns that surface) is still status: planned and must_follow AI.40 per the sprint plan. The recurring 28-timestamp-group/84-file evidence bloat previously tracked as AI40CLEANUP-ARCH-002 is a symptom of this scope violation (out-of-scope code writing to the wrong location on every run), not a missing-rotation bug. Required fix: remove benchmark_report.py and its justfile target from this branch entirely; point DEFAULT_EVIDENCE_DIR at a non-site path such as artifacts/; defer HTML rendering to AI.49 after AI.40 merges." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture/scope" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T17:47:37Z"^^xsd:dateTime ;
  triage:foundIn triage:AI40-QA-8 ;
  triage:foundAt "2026-08-01T17:45:16Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI40-SCOPE-VIOLATION-SITE-HTML/s40-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI40-SCOPE-VIOLATION-SITE-HTML/s40-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI40-SCOPE-VIOLATION-SITE-HTML/s40-3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI40-SCOPE-VIOLATION-SITE-HTML/fix-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI40-SCOPE-VIOLATION-SITE-HTML/fix-2> ;
  triage:triageRecordVersion "1" .

