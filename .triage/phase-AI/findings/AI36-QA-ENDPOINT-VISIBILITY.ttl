triage:AI36-QA-ENDPOINT-VISIBILITY
    a triage:Finding ;
    triage:findingId "AI36-QA-ENDPOINT-VISIBILITY" ;
    triage:title "GraftReceiverEndpointRecord is pub but sprint doc specifies it as a private record format" ;
    triage:description "GraftReceiverEndpointRecord (and all its fields) is declared pub, giving it crate-external visibility as atm_core::graft::GraftReceiverEndpointRecord, even though the sprint doc explicitly specifies it as a \"private endpoint-record format\" (docs/plans/phase-ai/sprint-ai-36-graft-receiver-ownership.md line 78-79) with a non-pub struct in its required-shape code block. No crate outside atm-core actually constructs or inspects this type." ;
    triage:triageMode "initial_pass" ;
    triage:category "boundary_tightening" ;
    triage:phaseId "phase-AI" ;
    triage:severity "minor" ;
