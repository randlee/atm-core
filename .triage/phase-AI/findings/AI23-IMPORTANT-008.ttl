  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-008/pAI-s24/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-008/integrate-8750587b> ;
