  triage:pattern "missing-drop-guard-on-panic-unwind" ;
  triage:vulnerability "panic in wait_for_published_daemon() (lines 748-754) or traceability.emit() calls (lines 742-747, 804-809) unwind past reap_failed_auto_start() (line 756), leaking child; no Drop guard protects Child across critical window" ;
  triage:occursIn <urn:atm:triage:worktree/s27/35cb19f8> .

