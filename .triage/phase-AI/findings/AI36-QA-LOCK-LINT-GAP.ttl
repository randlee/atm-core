triage:AI36-QA-LOCK-LINT-GAP
    a triage:Finding ;
    triage:findingId "AI36-QA-LOCK-LINT-GAP" ;
    triage:title "No mechanical lint detects repeated re-implementation of lock-contention classifier across crates" ;
    triage:description "No mechanical lint or boundary TOML detects repeated re-implementation of the same low-level fs2 advisory-lock contention classifier across crates (see AI36-QA-LOCK-CONTENTION-DUP). lint_same_host_portability.py only checks cfg-gating shape on a fixed file allowlist and does not scan for duplicate decision-logic function bodies across crates." ;
    triage:triageMode "initial_pass" ;
    triage:category "lint_gap" ;
    triage:phaseId "phase-AI" ;
    triage:severity "minor" ;
    triage:repeatable false ;
    triage:sweepScope "file_only" ;
    triage:status "closed" ;
    triage:dispatchReady false ;
    triage:triagedAt "2026-07-29T00:00:00Z"^^xsd:dateTime ;
    triage:foundIn "AI.36" ;
    triage:foundAt "2026-07-29T00:00:00Z"^^xsd:dateTime ;
    triage:closedAt "2026-08-17T00:00:00Z"^^xsd:dateTime ;
    triage:closedBy "quality-mgr" ;
    triage:closedNote "Closed won't-fix per arch-ctm fix-worthiness assessment (ATM message 01M0776HCD3RXXKGAJCD5YTMGP), endorsed by team-lead. The underlying duplication this lint gap was motivated by (AI36-QA-LOCK-CONTENTION-DUP) is already resolved to a single remaining classifier site (atm-daemon-client::is_launch_gate_contention_error) following the graft.rs fs2->fs4 migration. Generic duplicate-function-body detection in lint_boundaries.py/lint_same_host_portability.py would be brittle and falls outside those lints' bounded policy purpose (boundary-record validation and cfg-gating shape respectively, not cross-crate decision-logic diffing). Refile only if a concrete live duplicate recurs." ;
    triage:hasOccurrence triage:AI36-QA-LOCK-LINT-GAP-1 ;
    triage:openOn triage:FIX-AI36-QA-REPAIR-ee8f670f .

