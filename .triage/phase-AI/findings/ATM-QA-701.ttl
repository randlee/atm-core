<urn:atm:triage:finding/ATM-QA-701>
  a triage:Finding ;
  triage:findingId "ATM-QA-701" ;
  triage:title "AI.52 confirmation doc still omits frame value 4, now stale vs. corrected AI.40 doc/code" ;
  triage:description "req-qa on AI40-FRAME4-QA-1 (PR #715): docs/plans/phase-ai/sprint-ai-52-windows-transport-benchmark-confirmation.md:58 states the frame set as '1, 2, 8, 16, and 64' (missing 4). AI.40's sprint doc and code (SPARSE_FRAMES_PER_CONNECTION, SUPPORTED_FRAMES) were corrected to include 4 in this round (AI40-FRAME4-UNDOCUMENTED, PR #715). AI.52's confirmation deliverable invokes the same `just benchmark` command whose default profile set now includes 4, so the AI.52 doc is now out of sync with the code it's meant to confirm. Non-blocking for PR #715 (out of its scope); needs a doc fix on AI.52's own branch/scope." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation/consistency" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
