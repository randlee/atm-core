  triage:snippet "pub fn read_request(&mut self, reader: &mut impl Read) -> Result<Option<HttpRequest>, AtmError> { ... self.read_more(reader)? using chunk-based reading with 8KB buffers and memchr::memmem for delimiter search" ;
  triage:pattern "buffered chunk-based reading with efficient delimiter search" ;
