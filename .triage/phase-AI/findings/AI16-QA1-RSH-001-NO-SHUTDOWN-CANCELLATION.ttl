<urn:atm:triage:finding/AI16-QA1-RSH-001-NO-SHUTDOWN-CANCELLATION>
  a triage:Finding ;
  triage:findingId "AI16-QA1-RSH-001-NO-SHUTDOWN-CANCELLATION" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "reconcile_after_success has no shutdown/cancellation token, risking daemon hang" ;
  triage:description "reconcile_after_success in crates/atm-daemon/src/runtime_health.rs (line 607+) contains a for-loop with no cancellation token or shutdown signal; risk of daemon hang on shutdown if transport.deliver() blocks. Introduced in sprint s16, present in s17." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "service-hardening" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI16-QA1-RSH-001-NO-SHUTDOWN-CANCELLATION/s16/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI16-QA1-RSH-001-NO-SHUTDOWN-CANCELLATION/s17/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s16/853abcfc> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s17/2a5a57c8> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s16/853abcfc> ;
  triage:correctionNote "2026-07-22: promote_to_branch corrected from feature/pAI-s17-hermes-chat-identity to feature/pAI-s16-offline-reconciliation. arch-ctm caught scope-boundary conflict: AI.17 (docs/plans/phase-ai/sprint-ai-17-hermes-chat-identity.md) is scoped strictly to the ambient chat-context resolver and forbids daemon/canonical-router/storage changes. Finding description itself states 'Introduced in sprint s16, present in s17' — reconcile_after_success is AI.16's reconciliation-coordinator deliverable (docs/plans/phase-ai/sprint-ai-16-offline-reconciliation.md). Original mis-target was applied via unverified highest-open-branch heuristic." ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime .

<urn:atm:triage:occurrence/AI16-QA1-RSH-001-NO-SHUTDOWN-CANCELLATION/s16/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/runtime_health.rs" ;
  triage:line 650 ;
  triage:snippet "for stored in self.outbound_message_query.recent_outbound_for_peer(...) { ... transport.deliver(...)?; }" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closureNote "quality-mgr: verified against integrate/phase-AI head — reconcile_after_success refactored to reconcile_peer function (peer_sync.rs line 14). Now receives deadline parameter; cancellation implemented via deadline.remaining() check at line 39. Shutdown/cancellation token properly handled. (2026-07-26)" ;
  triage:branch "feature/pAI-s16-offline-reconciliation" ;
  triage:headSha "853abcfccad834ae36e441a995c3851333eb7a8e" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-s16/853abcfc> .

