<urn:atm:triage:finding/AI23-QA1-RBP-BOUNDARY-001>
  a triage:Finding ;
  triage:findingId "AI23-QA1-RBP-BOUNDARY-001" ;
  triage:title "QA1 rust-best-practices and boundary violations in s30 ingress hardening" ;
  triage:description "Four related code-quality issues identified during QA-1 pass on AI23-BLOCK-002 ingress hardening fix on feature/pAI-s30-semver-http-compatibility: (1) Match guard condition collapse in ApiRouter::route (runtime_health.rs:895-931): Multiple distinct failure conditions collapse into generic error codes with no per-condition stable identification. (2) Lock poisoning silent discard in PinnedClientVerifier::host_for_certificate (https_transport.rs:928-936): Uses peers.read().ok()? converting poisoned lock into indistinguishable error. (3) Missing architecture test for ingress trust-boundary enforcement. (4) Lint override style mismatch on production items (https_transport.rs:42, 181, 197, 329, 359)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "code-quality" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
