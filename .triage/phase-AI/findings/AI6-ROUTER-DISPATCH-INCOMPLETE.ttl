<urn:atm:triage:finding/AI6-ROUTER-DISPATCH-INCOMPLETE>
  a triage:Finding ;
  triage:findingId "AI6-ROUTER-DISPATCH-INCOMPLETE" ;
  triage:title "Router doesn't do real REST dispatch; only JSON-RPC envelope passthrough" ;
  triage:description "read_http_request captures HTTP method/path into HttpRequest, but decode_request only deserializes body into legacy RequestEnvelope — method/path are parsed and discarded. ApiRouter::route on DaemonRequestDispatcher is a one-line passthrough to pre-existing dispatch(RequestEnvelope), not new per-resource handler logic. This is JSON-RPC-style envelope riding HTTP/1.1 transport, not the REST router the sprint contract and checked-in OpenAPI paths describe." ;
  triage:triageMode "initial_pass" ;
  triage:category "REQ" ;
  triage:phaseId "phase-AI" ;
  triage:severity "critical" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-20T16:58:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI6-ROUTER-DISPATCH-INCOMPLETE/pAI-s6/1> ;
