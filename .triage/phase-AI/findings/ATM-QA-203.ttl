<urn:atm:triage:finding/ATM-QA-203>
  a triage:Finding ;
  triage:findingId "ATM-QA-203" ;
  triage:title "ADR-043 AI.36 evidence note overstates verified coverage vs sprint doc's own required-tests list" ;
  triage:description "docs/adr/ADR-043-hermes-graft-wake-up-ownership.md lines 80-83 state 'AI.36: complete' with coverage including 'typed live-owner conflict, stale-record replacement, and concurrent distinct identities.' This overstates verified coverage relative to sprint doc's required-tests lists (docs/plans/phase-ai/sprint-ai-36-graft-receiver-ownership.md sub-tasks 1-3, lines 101-104, 121-129, 143-147), which additionally require: record decoding rejecting old schema/malformed generation; short-lived child-process acquire-then-exit reclaim test (macOS/Linux/Windows); source-scan gate rejecting second record publisher or direct record unlink; and Python typed-conflict reporting. The ADR note omits disclosure of gaps identified as ATM-QA-201 and ATM-QA-202 (companion findings, not in this batch) covering missing/incomplete coverage for a subset of required tests. This finding concerns the ADR's unqualified 'complete' claim without disclosing known gaps." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation_accuracy" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "none" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-28T02:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S16 ;
  triage:foundAt "2026-07-28T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-203/integrate-ai36-adr-043-80-83> ;
  triage:triageRecordVersion "1" .

