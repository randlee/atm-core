  triage:foundAt "2026-07-25T06:25:35Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S3 ;
  triage:title "Release identity 1.3.2-beta-23 deviates from documented prerelease grammar (dot vs hyphen separator)" ;
  triage:description "The workspace release identity actually used (Cargo.toml: version = \"1.3.2-beta-23\", hyphen before the sprint number) is valid SemVer but does not follow the project's own documented prerelease convention (<version>-<label>.<n>, e.g. 1.3.2-beta.1) stated in docs/requirements.md REQ-P-RELEASE-007 and docs/adr/ADR-042-semver-release-and-http-compatibility.md:14 (both cite '1.3.2-beta.1' as the example form). Not a functional bug -- semver::Version::parse accepts the hyphen form fine -- but a real documented-convention deviation an operator reading REQ-P-RELEASE-007 would not expect." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
