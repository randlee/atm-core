<urn:atm:triage:finding/RBQA-AI3152TOOLING-F002>
  a triage:Finding ;
  triage:findingId "RBQA-AI3152TOOLING-F002" ;
  triage:title "just benchmark builds atm-daemon without invoking the signing hook" ;
  triage:description "cargo build --release invocation in the `just benchmark` recipe (Justfile:193) does not call the signing hook. The sprint goal requires that local macOS daemon builds use the signing identity when installed. The benchmark path does not use the build recipe or invoke sign_daemon_dev.py, so developers running `just benchmark` get an unsigned release atm-daemon — silently reproducing the exact problem this sprint exists to fix." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary_tightening" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-03T18:36:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-03T19:20:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:foundIn triage:AI3152-CROSSHOST ;
  triage:foundAt "2026-08-03T18:35:45Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AI3152TOOLING-F002/feature-daemon-devcert-signing-1> ;
  triage:triageRecordVersion "2" ;
  triage:progressNote "QA-2 (865b3308): benchmark: recipe now invokes .just/sign_daemon_dev.py after its own cargo build --release step (Justfile:192-195), matching build:'s pattern. Confirmed independently by req-qa, arch-qa, and ruthless-boundary-qa on commit 865b3308." .

