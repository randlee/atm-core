<urn:atm:triage:finding/AI38-HERMES-ADAPTER-DUPLICATE-001>
  a triage:Finding ;
  triage:findingId "AI38-HERMES-ADAPTER-DUPLICATE-001" ;
  triage:title "Hermes adapter MessageEvent(internal=False) normal-ingress pattern still present on merge target, conflicts with AI.38 HermesSteerPort replacement" ;
  triage:description "integrate/phase-ai-31-33 (confirmed at origin HEAD 49126e3f) contains a production atm_graft_hermes_adapter.py + atm_graft_hermes_bridge.py pair implementing the forbidden MessageEvent(internal=False) dispatch into Hermes's normal Telegram inbound-message pipeline (gateway.platforms.base.MessageEvent, gateway.session.SessionSource, Platform.TELEGRAM), forbidden by docs/atm-graft/boundaries.md and by AI.38's own Scope Summary. AI.38 branch (feature/pAI-s38-hermes-steer-nudge-delivery @ ce666b2a) has a structurally incompatible HermesSteerPort-based replacement under the identical file path. Independently re-verified real (not stale worktree) by fetching origin/integrate/phase-ai-31-33 and confirming MessageEvent/internal=False pattern present at origin HEAD 49126e3f." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary_violation" ;
  triage:severity "critical" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-29T16:45:00Z"^^xsd:dateTime ;
