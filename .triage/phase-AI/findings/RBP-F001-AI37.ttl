<urn:atm:triage:finding/RBP-F001-AI37>
  a triage:Finding ;
  triage:findingId "RBP-F001-AI37" ;
  triage:title "PyGraftSession Mutex<Option<...>> fields lack rationale comment (RBP-006)" ;
  triage:description "crates/atm-graft-python/src/lib.rs lines 317-318 declare `client: Mutex<Option<GraftClient>>` and `receiver: Mutex<Option<GraftSession>>` on PyGraftSession with no comment explaining why a Mutex is required (GIL-crossing concurrency: PyO3 methods can be invoked from Python threads without holding the GIL for the call duration, so interior mutability needs a real lock rather than RefCell). RBP-006 requires synchronization-primitive choices to carry a rationale comment. Recommend adding a short comment above the field block." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "best-practices" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:closed false ;
  triage:dispatchReady true ;
  triage:blockingCurrentMerge false ;
  triage:note "RBP-006: add a rationale comment above the client/receiver Mutex<Option<...>> fields explaining the GIL-crossing concurrency requirement for Mutex over RefCell." ;
  triage:foundIn triage:AI37-QA-1 ;
  triage:foundAt "2026-07-29T06:10:00Z"^^xsd:dateTime ;
  triage:triagedAt "2026-07-29T07:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AI37/pygraftsession-fields> ;
