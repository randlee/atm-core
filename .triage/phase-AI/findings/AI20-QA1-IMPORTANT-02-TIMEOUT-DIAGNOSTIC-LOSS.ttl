<urn:atm:triage:finding/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS>
  a triage:Finding ;
  triage:findingId "AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T16:45:00Z"^^xsd:dateTime ;
  triage:title "wait_for_published_daemon's terminal timeout error discards the underlying connection-failure cause" ;
  triage:description "The daemon-client's wait_for_published_daemon function extends the auto-start readiness polling timeout to 30s (via commit 34392e5c), but its timeout error path creates a generic error that discards underlying connection-failure diagnostic information. A caller now waits up to 30s with zero diagnostic info on why each connection attempt failed." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T16:45:00Z"^^xsd:dateTime ;
  triage:closureNote "arch-ctm reported (message re: 89d8589d) that wait_for_published_daemon now retains the last local-IPC connection error and includes it in the terminal timeout error. Independently re-verified against feature/pAI-s27-peer-delivery-observability @ 89d8589d: crates/atm-daemon-client/src/lib.rs ~773-816 -- the retry loop now captures each connect attempt's Err into last_connect_error, and the timeout error message appends '; last local IPC failure: {error}' when one was recorded. New test publish_wait_retains_the_last_local_ipc_failure_in_its_timeout_error asserts the fixture connection-refused message text survives into the timeout error. Ran cargo test -p atm-daemon-client --lib publish_wait_retains -- 1 passed. This closes only the s27/1 primary occurrence (line ~800, the wait_for_published_daemon path); the s20/2 LaunchGateGuard::rejected_error occurrence at a distinct call site (line ~701) was NOT addressed by this commit and remains genuinely open -- top-level status stays open until that residual is fixed." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS/s17/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS/s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS/s19/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS/s20/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS/s20/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS/s27/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI20-QA1-IMPORTANT-02-TIMEOUT-DIAGNOSTIC-LOSS/s27-fixed-89d8589d> ;
  triage:openOn <urn:atm:triage:worktree/s20/a1d186a60f615336f2ddb82d468d74042e008ca4> ;
  triage:openOn <urn:atm:triage:worktree/s27/35cb19f8> ;
