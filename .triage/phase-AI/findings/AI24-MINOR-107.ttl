<urn:atm:triage:finding/AI24-MINOR-107>
  a triage:Finding ;
  triage:findingId "AI24-MINOR-107" ;
  triage:title "Hardcoded /tmp/ literal in protocol.rs test violates cross-platform-guidelines" ;
  triage:description "crates/atm-core/src/protocol.rs:509 test daemon_socket_path_rejects_override hardcodes the Unix literal \"/tmp/alternate.sock\" in ATM_DAEMON_SOCKET env var, violating the cross-platform-guidelines rule against hardcoded /tmp/ paths in test code. Not functionally broken (test only asserts is_err()), pre-existing from commit e5051fba (not introduced by this sprint), but in-scope under zero-tolerance policy. Every other test in the same file correctly uses std::env::temp_dir()." ;
  triage:phaseId "phase-AI" ;
