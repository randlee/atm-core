<urn:atm:triage:finding/AI13-QA1-BLOCKING-01-UNOWNED-MARKER-DELETE>
  a triage:Finding ;
  triage:findingId "AI13-QA1-BLOCKING-01-UNOWNED-MARKER-DELETE" ;
  triage:title "Teardown can delete an unowned .peer-smoke-owned marker file" ;
  triage:description "In scripts/smoke/run_peer_pair.py's stop_owned(), when config sets launch_command without owned_runtime_paths, the ownership-verification gate at line 166 is skipped, and the unconditional unlink() at line 177 can delete a marker file this invocation did not create (falls back to CWD, no ownership check)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
