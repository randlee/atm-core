<urn:atm:triage:finding/AI39-QA-004>
  a triage:Finding ;
  triage:findingId "AI39-QA-004" ;
  triage:title "mem::take on frames not restored on timeout/disconnect" ;
  triage:description "frames is emptied via std::mem::take before handing ownership to the background read thread. If recv_timeout returns Timeout or Disconnected, *frames is never restored (stays at HttpFrameReader::default()), silently discarding any bytes the background thread may have already buffered. Currently benign only because both timeout and disconnect paths bubble up an Err that tears down the whole connection in handle_connection, so the stale reader is never reused for a subsequent keep-alive iteration. Required correction: Document (or assert) the invariant that the timeout/disconnect branches must always terminate the connection, so a future refactor that tries to retry/reuse frames after one of these branches doesn't silently drop buffered surplus bytes." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T16:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI39 ;
  triage:foundAt "2026-07-31T16:30:00Z"^^xsd:dateTime ;
