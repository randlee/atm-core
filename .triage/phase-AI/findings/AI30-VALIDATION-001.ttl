<urn:atm:triage:finding/AI30-VALIDATION-001>
  a triage:Finding ;
  triage:findingId "AI30-VALIDATION-001" ;
  triage:title "CLI peer commands allow loopback/localhost binding and advertisement without semantic rejection" ;
  triage:description "crates/atm/src/commands/peer.rs — InterfaceCommand::run_with_store (InterfaceSubcommand::Set/Remove, ~lines 251-290) and TrustCommand::run_with_store (TrustSubcommand::List/Add/Replace/Revoke, ~lines 318-370) pass --bind, --advertise-host, and --host (for atm peer trust add/replace) flags through unrestricted HostName/socket-addr parsing with no loopback/localhost rejection at the command layer. Operator can register a trusted peer or advertise-host of 127.0.0.1/localhost, silently satisfying transport checks that should require a real routable interface per REQ-CORE-TRANSPORT-002C / ADR-035." ;
  triage:phaseId "phase-AI" ;
  triage:category "Validation" ;
  triage:severity "Blocking" ;
