<urn:atm:triage:finding/AI6-RSH-003>
  a triage:Finding ;
  triage:findingId "AI6-RSH-003" ;
  triage:title "Windows build-breaking: remove_stale_endpoint imported only under #[cfg(unix)]" ;
  triage:description "SocketEndpointGuard::unpublish() unconditionally calls remove_stale_endpoint, but that symbol is only imported under #[cfg(unix)] at line 31-32. Causes compilation failure on Windows (Both 'Just lint (windows-latest)' and 'Test (windows-latest)' CI jobs fail). Distinct from prior 9f15e27c boxing fix." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-AI" ;
  triage:severity "critical" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-20T16:58:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI6-RSH-003/pAI-s6/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s6/764bdd32> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s6/764bdd32> ;
  triage:highestFixedBranch "feature/pAI-s6-http-uds-router" ;
  triage:reviewedBy "rust-service-hardening-agent" ;
  triage:reviewedBy "team-lead" ;
  triage:resolution "FIXED: SocketEndpointGuard::unpublish() (local_ipc_transport.rs:124-134) now gates the remove_stale_endpoint call behind #[cfg(unix)], falling through to Ok(()) on non-unix. Fixed on feature/pAI-s6-http-uds-router @ 3dd7e6e2, merge-forwarded through AI7 6fc4009a, AI8 1a99ee2c, AI9 87c5a1f7, AI10 b43c0b1b. quality-mgr independently re-verified against source (AI-FIXROUND-3 recheck): PASS." .

