<urn:atm:triage:finding/ATM-QA-40-SITE-WRITE>
  a triage:Finding ;
  triage:findingId "ATM-QA-40-SITE-WRITE" ;
  triage:title "AI.40 benchmark runner defaults to writing directly into the public site/ report tree" ;
  triage:description "Sprint doc docs/plans/phase-ai/sprint-ai-40-local-transport-benchmark.md deliverable #4 states 'AI.40 neither writes site/ artifacts nor renders HTML' and the Non-goals section explicitly excludes 'site/report rendering.' scripts/smoke/run_admission_capacity.py:866 sets --evidence-dir's default to ROOT/site/reports/send-message-benchmark, and the reviewed M5 evidence batch is physically present in that exact public site/ report directory, written directly by this AI.40 runner rather than returned to AI.49 for persistence. AI.49 (not AI.40) owns persistence and HTML rendering per the sprint doc. Independently re-verified by quality-mgr against the worktree during AI40-QA-3." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
