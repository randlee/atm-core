<urn:atm:triage:finding/AI50-REDACTION-LOGIC-DUPLICATED>
  a triage:Finding ;
  triage:findingId "AI50-REDACTION-LOGIC-DUPLICATED" ;
  triage:title "Redaction logic independently re-implemented and diverged in two scripts" ;
  triage:description "Redaction logic is independently re-implemented in scripts/fuzz/render_report.py and scripts/smoke/benchmark_report.py and has already diverged: different SENSITIVE_KEYS sets, and one drops the sensitive key while the other stubs it. Root cause shared with AI50-REDACTION-REGEX-GAP (no single hardened redaction module). Verified independently by quality-mgr via direct source read; found by ruthless-boundary-qa as RBQA-F001 during AI50-QA-1 (PR #709, feature/pAI-s50-fuzz-report @ 507748ac). Can be folded into the same fix as AI50-REDACTION-REGEX-GAP (extract shared redaction module) or tracked separately, at team-lead's discretion." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "code-duplication-drift" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-08-01T04:20:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "2026-08-01 (quality-mgr, AI50-QA-2): independently re-verified at feature/pAI-s50-fuzz-report@ccfb3c99 plus unanimous PASS from req-qa, arch-qa, and ruthless-boundary-qa. New shared module scripts/public_redaction.py extracts a single SENSITIVE_KEYS/ABSOLUTE_PATH/public_string/public_value implementation; scripts/fuzz/render_report.py and scripts/smoke/benchmark_report.py both now import from it instead of independently re-implementing redaction logic, eliminating the divergence. ruthless-boundary-qa's workspace-wide duplicate sweep for these symbols found no other divergent copy. Confirmed via direct file read, not self-report." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T20:00:00Z"^^xsd:dateTime ;
