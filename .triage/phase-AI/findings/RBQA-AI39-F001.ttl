<urn:atm:triage:finding/RBQA-AI39-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AI39-F001" ;
  triage:title "Duplicate MAX_KEEP_ALIVE_REQUESTS constant across UDS and TCP local transports" ;
  triage:description "MAX_KEEP_ALIVE_REQUESTS = 64 is declared as two independent private constants instead of one owned value, violating the sprint deliverable requiring the same bounded maximum request count shared across UDS and loopback TCP. Consolidation into local_ipc_transport.rs (#[cfg(not(windows))]) broke Windows compilation. REGRESSION at afbea292: lib.rs:68 unconditionally re-exports LocalIpcServerTransportAdapter from gated local_ipc_transport module, causing E0432 on Windows: unresolved import crate::local_ipc_transport." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "boundary_violation" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-08-01T02:10:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "2026-08-01 (quality-mgr, AI39-QA-3): independently re-verified at feature/pAI-s39-buffered-local-http-framing@966617ff -- crates/atm-daemon/src/lib.rs:75 declares `pub(crate) const MAX_KEEP_ALIVE_REQUESTS: usize = 64;` once, with no #[cfg] gate. crates/atm-daemon/src/local_tcp_transport.rs:34 and crates/atm-daemon/src/local_ipc_transport/request_worker.rs:28 both import it unconditionally via `use crate::MAX_KEEP_ALIVE_REQUESTS;`, with real usage (loop bound + keep-alive comparisons) and test coverage in both files. All 8 CI legs green on PR #703 run 30678738761, including both previously-red windows-latest legs. Confirmed via direct file read, not self-report; corroborated by ruthless-boundary-qa scoped re-verification. Original occurrence snippet (lib.rs:68, afbea292) is superseded -- the fix relocated the constant rather than editing that line." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T02:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI39 ;
  triage:foundAt "2026-07-31T16:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AI39-F001/S39-LIB-68-REGRESSED> ;
  triage:triageRecordVersion "4" .

