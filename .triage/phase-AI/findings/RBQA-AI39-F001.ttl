<urn:atm:triage:finding/RBQA-AI39-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AI39-F001" ;
  triage:title "Duplicate MAX_KEEP_ALIVE_REQUESTS constant across UDS and TCP local transports" ;
  triage:description "MAX_KEEP_ALIVE_REQUESTS = 64 is declared as two independent private constants instead of one owned value, violating the sprint deliverable requiring the same bounded maximum request count shared across UDS and loopback TCP." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary_violation" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T16:35:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI39 ;
  triage:foundAt "2026-07-31T16:30:00Z"^^xsd:dateTime ;
