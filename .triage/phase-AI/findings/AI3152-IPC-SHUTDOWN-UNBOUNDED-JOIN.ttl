<urn:atm:triage:finding/AI3152-IPC-SHUTDOWN-UNBOUNDED-JOIN>
  a triage:Finding ;
  triage:findingId "AI3152-IPC-SHUTDOWN-UNBOUNDED-JOIN" ;
  triage:title "Unbounded worker.join() in daemon worker pool shutdown paths risks indefinite shutdown hang" ;
  triage:description "ConnectionWorkerPool::shutdown (crates/atm-daemon/src/local_ipc_transport.rs:373) and DispatchWorkerPool::shutdown (crates/atm-daemon/src/local_ipc_transport/request_worker.rs:182) both call worker.join() with no deadline/timeout. A genuinely wedged worker can block daemon shutdown indefinitely." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "daemon-shutdown" ;
  triage:severity "Blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-02T00:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S13 ;
  triage:foundAt "2026-08-02T00:00:00Z"^^xsd:dateTime ;
