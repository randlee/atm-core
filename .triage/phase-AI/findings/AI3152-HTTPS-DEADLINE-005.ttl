<urn:atm:triage:finding/AI3152-HTTPS-DEADLINE-005>
  a triage:Finding ;
  triage:findingId "AI3152-HTTPS-DEADLINE-005" ;
  triage:title "Inbound HTTPS request deadline is not propagated all the way through dispatch" ;
  triage:description "The crates/atm-daemon/src/runtime_health.rs dispatch_with_deadline function receives a caller-supplied deadline from HTTPS inbound requests but does not use it (parameter is prefixed with underscore). This means inbound HTTPS request deadlines are not propagated through to the actual dispatch operations, violating the requirements for bounded admission and preventing slow or stalled downstream work from being properly canceled based on the peer's deadline." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T18:32:45Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S13 ;
  triage:foundAt "2026-07-28T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-02T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:progressNote "AI3152-PHASEEND-QA-1 (commit d2891ab5): req-qa, arch-qa, and ruthless-boundary-qa independently confirmed fixed. dispatch_with_deadline (runtime_health.rs:475-488) no longer underscore-prefixes its deadline parameter; it calls require_dispatch_budget(deadline, ...) both before and after dispatch (~556-575), returning daemon_may_have_executed vs daemon_unavailable depending on whether side-effecting work may have started, so the inbound HTTPS deadline now genuinely bounds dispatch instead of being discarded. Covered by test expired_router_deadline_prevents_downstream_dispatch (runtime_health.rs:1038-1056)." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3152-HTTPS-DEADLINE-005/R31-1> ;
  triage:triageRecordVersion "2" .

<urn:atm:triage:occurrence/AI3152-HTTPS-DEADLINE-005/R31-1>
