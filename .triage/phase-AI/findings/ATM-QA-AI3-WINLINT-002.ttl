  triage:snippet ".map_err(|source| { AtmError::daemon_unavailable(\"failed to spawn graft request-read helper\") })  -- source unused, must be _source (Windows cfg-gated site)" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closureNote "quality-mgr: verified against integrate/phase-AI head -- grep confirms crates/atm-graft/src/runtime.rs:823 and surrounding `.map_err(|source|` patterns no longer exist; code has been refactored. Stale occurrence from superseded branch feature/pAI-s3-error-contract-foundation; closing to match reality. (2026-07-26)" ;
