<urn:atm:triage:finding/AI16-QA1-ATM-QA-002-RECONCILE-COVERAGE>
  a triage:Finding ;
  triage:findingId "AI16-QA1-ATM-QA-002-RECONCILE-COVERAGE" ;
  triage:title "Zero test coverage for reconcile_after_success / cooldown / batch-cap / age-filter" ;
  triage:description "Zero test coverage for reconcile_after_success and its cooldown (60s rate limiter, MAX_PEER_SYNC_COOLDOWN_ENTRIES=256), batch-cap (max_batch_messages), and age-filter (max_message_age) behavior in crates/atm-daemon/src/runtime_health.rs around line 608 (line numbers may have shifted). Introduced in sprint s16, present through s17. Sweep the runtime_health.rs implementation and any adjacent test module in the same crate to confirm whether dedicated unit/integration tests for these specific behaviors (cooldown expiry, MAX_PEER_SYNC_COOLDOWN_ENTRIES eviction, max_batch_messages capping, max_message_age filtering) exist on each branch." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "missing-test-coverage" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
