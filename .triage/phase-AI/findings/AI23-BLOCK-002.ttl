# Secondary occurrence: is_peer_receipt() vulnerability in send/mod.rs (repeatable sweep finding)
<urn:atm:triage:occurrence/AI23-BLOCK-002/s30-secondary-is-peer-receipt>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/send/mod.rs" ;
  triage:line 323 ;
  triage:snippet "pub fn is_peer_receipt(&self) -> bool { self.outbound_request.authenticated_source_host.is_some() || self.outbound_request.origin_message_id.is_some() } // Vulnerable: checks is_some() without validation" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAI-s30-semver-http-compatibility" ;
  triage:headSha "9fd44444" ;
  triage:occursIn <urn:atm:triage:worktree/s30/9fd44444> .

