<urn:atm:triage:finding/AI38-QA1-RBP-EXPECT-VALIDATED-CALLER-TEAM>
  a triage:Finding ;
  triage:findingId "AI38-QA1-RBP-EXPECT-VALIDATED-CALLER-TEAM" ;
  triage:title "Repeated runtime assertion instead of type-level invariant encoding" ;
  triage:description "crates/atm-graft-python/src/lib.rs enforces the invariant 'self.caller has a team' three separate times via .expect('validated caller team') (lines 347, 382, 415 in s38) instead of being encoded once at the type level: read (347), send (382), acknowledge (415) each independently call self.caller.team().cloned().expect('validated caller team') against the same AgentAddress. A future AgentAddress construction path that legitimately omits team would silently panic at three different call sites rather than being rejected once at PyGraftSession::new. Recommendation: store the caller's TeamName as its own validated field on PyGraftSession at construction time, eliminating repeated runtime assertions at every call site." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-29T12:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-29T12:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI38-QA1-RBP-EXPECT-VALIDATED-CALLER-TEAM/S38-OCC-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI38-QA1-RBP-EXPECT-VALIDATED-CALLER-TEAM/S38-OCC-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI38-QA1-RBP-EXPECT-VALIDATED-CALLER-TEAM/S38-OCC-3> ;
  triage:triageRecordVersion "1" ;
  triage:closedAt "2026-07-29T18:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" .

