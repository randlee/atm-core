<urn:atm:triage:finding/AI16-QA1-RSH-002-003-HARDENING>
  a triage:Finding ;
  triage:findingId "AI16-QA1-RSH-002-003-HARDENING" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "Service hardening gaps in runtime_health.rs and peer.rs" ;
  triage:description "Service hardening gaps in crates/atm-daemon/src/runtime_health.rs and crates/atm/src/commands/peer.rs related to peer sync policy and certificate management (e.g. missing retry/backoff policy validation, missing structured error handling around cert rotation/expiry checks for peer sync). Sweep both files for the peer-sync/reconciliation and certificate-handling code paths to confirm current occurrences and locations on each branch." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "service-hardening" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
