<urn:atm:triage:finding/AI38-QA1-FIXTURE-BYPASSES-BRIDGE>
  a triage:Finding ;
  triage:findingId "AI38-QA1-FIXTURE-BYPASSES-BRIDGE" ;
  triage:title "HermesSteerFixture bypasses HermesGraftBridge, calling adapter methods directly" ;
  triage:description "crates/atm-graft-python/tests/hermes_steer_fixture.py (HermesSteerFixture class, around lines 66-79) calls self.adapter.connect(), self.adapter.deliver_live_nudge(...), and self.adapter.deliver_recovery_summary(...) directly on the AtmGraftAdapter instance instead of routing through HermesGraftBridge's live_nudge_callback/recovery_summary_callback entry points. This means the fixture's evidence run (scripts/phase-ai/run-hermes-steer-smoke.py --fixture) never actually exercises the bridge's dedup, attribution, or AI.37 10-second recovery-timer scheduling path -- it only proves the adapter itself works when invoked directly, not that HermesGraftBridge's timer/count callback correctly reaches steer. This gap was identified by arch-ctm's own plan/code audit (ATM message 2026-07-29T16:39:20Z), separate from the AI38-QA-1 reviewer set." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-29T17:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S18 ;
  triage:foundAt "2026-07-29T16:39:20Z"^^xsd:dateTime ;
