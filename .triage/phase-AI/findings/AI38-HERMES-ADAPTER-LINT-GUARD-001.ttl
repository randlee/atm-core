<urn:atm:triage:finding/AI38-HERMES-ADAPTER-LINT-GUARD-001>
  a triage:Finding ;
  triage:findingId "AI38-HERMES-ADAPTER-LINT-GUARD-001" ;
  triage:title "No mechanical guard for Hermes-adapter normal-ingress anti-pattern (MessageEvent/internal=False reintroduction)" ;
  triage:description ".just/lint_boundaries.py only inspects Rust boundary records/impl sites; it has no rule scanning crates/atm-graft-python/python/*.py for reintroduction of MessageEvent/internal=False/normal-message dispatch into the Hermes gateway pipeline. This gap allowed a forbidden pattern to persist uncaught in a committed integration branch (see related finding AI38-HERMES-ADAPTER-DUPLICATE-001). Recommend a sc-lint/just check (Python AST or grep) against crates/atm-graft-python/python/atm_graft_hermes_adapter.py that fails the build if MessageEvent(, SessionSource(, or internal=False appear, registered in `just lint`." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "lint_gap" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-29T17:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S18 ;
  triage:foundAt "2026-07-29T16:40:00Z"^^xsd:dateTime ;
