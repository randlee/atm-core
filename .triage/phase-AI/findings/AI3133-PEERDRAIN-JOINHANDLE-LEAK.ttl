# arch-ctm critical-review finding after merging develop into integrate/phase-ai-31-33
# BLOCKING: PeerDrainCoordinator::run() pushes a JoinHandle into job_workers for every
# delivered peer job and never reaps completed handles until daemon stop() -- unbounded
# memory growth for a long-running daemon process.
# PR #683, branch integrate/phase-ai-31-33 @ 7a02e7dd

<urn:atm:triage:finding/AI3133-PEERDRAIN-JOINHANDLE-LEAK>
  a triage:Finding ;
  triage:findingId "AI3133-PEERDRAIN-JOINHANDLE-LEAK" ;
  triage:title "PeerDrainCoordinator::run accumulates JoinHandles in job_workers with no bound until daemon stop" ;
  triage:description "Blocking: crates/atm-daemon/src/peer_drain_coordinator.rs. job_workers is declared as job_workers: Arc<Mutex<Vec<JoinHandle<()>>>> (struct field, line 126) and initialized empty (line 145). PeerDrainCoordinator::run (fn at line 277) spawns a std::thread per delivered PeerWork::Job (lines 281-299) and, at lines 300-302, unconditionally pushes the returned JoinHandle into job_workers: `if let Ok(mut workers) = self.job_workers.lock() { workers.push(handle); }`. Nothing in run(), deliver_one(), or elsewhere removes, joins, or otherwise reaps a handle once its thread completes -- the only place job_workers is drained is PeerDeliveryCoordinator::stop() (lines 436-444), which does `std::mem::take(&mut *self.job_workers.lock()...)` and joins every accumulated handle, but stop() only runs at daemon shutdown. For a long-running daemon processing peer delivery jobs continuously, every completed job's JoinHandle (a fixed-size handle plus its associated thread metadata) remains resident in the Vec for the entire daemon uptime, giving unbounded memory growth proportional to total peer jobs ever processed rather than jobs in flight. This is a production memory leak in a long-running service, not a transient/test-only issue." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "QA-CODE-REGRESSION" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedBy "quality-mgr" ;
  triage:closedAt "2026-07-28T08:45:00Z"^^xsd:dateTime ;
  triage:fixCommit "46d88bfe" ;
  triage:fixPr 686 ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-28T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI-S3133 ;
  triage:foundAt "2026-07-28T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3133-PEERDRAIN-JOINHANDLE-LEAK/peer-drain-coordinator-run> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/AI3133-PEERDRAIN-JOINHANDLE-LEAK/peer-drain-coordinator-run>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/peer_drain_coordinator.rs" ;
  triage:line 300 ;
  triage:snippet "let handle = std::thread::spawn(move || { match Self::run_job(&coordinator.state, &job, || coordinator.deliver_one(&job)) { ... } }); if let Ok(mut workers) = self.job_workers.lock() { workers.push(handle); }" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedBy "quality-mgr" ;
  triage:closedAt "2026-07-28T08:45:00Z"^^xsd:dateTime ;
