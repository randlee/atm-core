<urn:atm:triage:finding/ATM-QA-40-BASELINE-CHRONOLOGY>
  a triage:Finding ;
  triage:findingId "ATM-QA-40-BASELINE-CHRONOLOGY" ;
  triage:title "AI.40 M5 UDS one-frame baseline was recorded after AI.39 merged, not before, as required" ;
  triage:description "Sprint doc docs/plans/phase-ai/sprint-ai-40-local-transport-benchmark.md deliverable #6 requires 'Before AI.39 merges, record the M5 one-frame UDS median as the comparison baseline using the same command, duration, and sample count,' and the acceptance criteria state 'Missing M5 evidence, a missing baseline, or any threshold miss fails this sprint.' The baseline artifact actually used (source_revision f93a582eea96c8951f2dab882bb6fb96294b6bb0, per site/reports/send-message-benchmark/20260801-063318.232385-mac-arm64-01-uds-f1.json) is a commit on this branch that was independently verified via git log --oneline --first-parent to be chronologically AFTER three separate merges of feature/pAI-s39-buffered-local-http-framing into this branch and after roughly 50 intervening performance-tuning commits made on this branch. This means the 'pre-AI.39' baseline is actually a post-AI.39, post-tuning measurement of AI.40's own code, which trivially makes the comparison_passed/baseline_passed fields report true. A genuine pre-AI.39 baseline has not been recorded." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "acceptance-gap" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:foundIn triage:AI40 ;
  triage:foundAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-40-BASELINE-CHRONOLOGY/s40-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/ATM-QA-40-BASELINE-CHRONOLOGY/s40-1>
  a triage:Occurrence ;
  triage:file "site/reports/send-message-benchmark/20260801-063318.232385-mac-arm64-01-uds-f1.json" ;
  triage:line 1 ;
  triage:snippet "Fixed at 1f6b2cbb: baseline re-recorded from source_revision fb6b26363c5bb0bbb11a6cf167d090385dc53d35, independently confirmed via `git merge-base --is-ancestor fb6b263 2664824b` (2664824b = first AI.39 merge commit) to genuinely predate AI.39. Chronology defect is resolved. NOTE: the re-recorded baseline artifact is itself a failed/degenerate run (sample_count=1 of required 10, run_duration_s=0.138 of required ~20s, passed=false, HTTP 503 sqlite reader-budget exhaustion, 180.94 admissions/s) and the runner performs no validation of baseline conformance before consuming its median as the comparison floor. Superseded by new blocking finding ATM-QA-40-BASELINE-INTEGRITY (opened by quality-mgr, AI40-QA-4) rather than left open under this chronology-only framing." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s40-local-transport-benchmark" ;
  triage:headSha "1f6b2cbb" ;
  triage:occursIn <urn:atm:triage:worktree/s40/0b3ff84c> .

