<urn:atm:triage:finding/AI26-ATMQA-002>
  a triage:Finding ;
  triage:findingId "AI26-ATMQA-002" ;
  triage:foundAt "2026-07-25T07:54:44Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S6 ;
  triage:title "Required deterministic delayed-peer/cancellation/retry/tracked-work tests from sprint-ai-26 were not added" ;
  triage:description "Quality-mgr independently reviewed feature/pAI-s26-peer-write-deadline @ dc079fff8a96a5441e1eda3c790383670589f2f9 (AICH-S6, sprint-ai-26 peer-write-deadline). docs/plans/phase-ai/sprint-ai-26-peer-write-deadline.md's Required validation section calls for: Deterministic delayed-peer tests for budget propagation, disconnect, cancellation, and retry with the original ULID; runtime tracked-work test. Follow-up pass (AICH-S6-FIX-1, 2026-07-25T15:12Z) on feature/pAI-s27-peer-delivery-observability @ f7b779ab50ea8ff6f35ab02388b7dab23df9c3db shows: 4 of 5 named properties are now covered by genuine tests (budget propagation, disconnect, retry-with-original-ULID, runtime tracked-work). The 5th property — local-side cancellation race test — is STILL MISSING. This gap is a specific missing test: no deterministic test simulates local-side cancellation (connection close / caller-side deadline expiry) while a delayed peer delivery is in-flight, asserting that the tracked dispatch worker is cancelled/joined rather than silently detached or falsely reporting success. This test implements sprint AI.26's acceptance criterion 3 ('a cancellation race cannot claim remote success') and ADR-041's cancellation-safety claim at the delayed-peer level." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "Important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-25T15:12:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-07-25T15:42:36Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "AICH-S6-FIX-2 recheck PASS (all 3 reviewers): new test local_client_close_during_delayed_peer_delivery_never_reports_success_or_leaks_work at peer_reconciliation.rs:157-273 confirmed as a real local-IPC client/server interaction proving worker join/no-leak on local-side cancellation. See /Users/randlee/.config/atm/share/atm-dev/aich-s6-fix2-verdict.md." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI26-ATMQA-002/pAI-s27/budget-propagation> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI26-ATMQA-002/pAI-s27/disconnect> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI26-ATMQA-002/pAI-s27/retry-original-ulid> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI26-ATMQA-002/pAI-s27/tracked-work> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI26-ATMQA-002/pAI-s27/cancellation> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s27/f7b779ab> ;
  triage:fixedOn <urn:atm:triage:worktree/pAI-s27/f7b779ab> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s27/f7b779ab> .

