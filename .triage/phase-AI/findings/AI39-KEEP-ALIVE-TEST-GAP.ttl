<urn:atm:triage:finding/AI39-KEEP-ALIVE-TEST-GAP>
  a triage:Finding ;
  triage:findingId "AI39-KEEP-ALIVE-TEST-GAP" ;
  triage:title "Keep-alive test coverage gap (UDS + boundary verification)" ;
  triage:description "The sprint doc requires proving 'an explicit keep-alive serves 1, 2, 8, 16, and 64 writes and closes at the bound.' No test exercises UDS keep-alive at all. The only local-transport keep-alive test (TCP, loopback_tcp_keep_alive_serves_multiple_requests_before_client_close) covers just 2 sequential requests, not the required counts {1,2,8,16,64}, and does not prove closure at MAX_KEEP_ALIVE_REQUESTS=64 bound. Required: Add UDS keep-alive test parallel to existing TCP test, parametrize both over {1,2,8,16,64} requests, prove 65th keep-alive request is refused/closes per MAX_KEEP_ALIVE_REQUESTS." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T16:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI39 ;
