<urn:atm:triage:finding/AI3152-DISPATCH-DEADLINE-001>
  a triage:Finding ;
  triage:findingId "AI3152-DISPATCH-DEADLINE-001" ;
  triage:title "Local IPC dispatch worker uses an unbounded rendezvous channel that can defeat the caller's deadline." ;
  triage:description "crates/atm-daemon/src/local_ipc_transport/request_worker.rs:54 creates std::sync::mpsc::sync_channel::<DispatchWork>(0) — a zero-capacity rendezvous channel. Line 116 does sender.send(DispatchWork { request, deadline, result_tx }). Because the channel has zero capacity, sender.send() blocks the calling thread until the single worker is ready to receive, with no deadline/timeout applied to that blocking send itself — only the work item's deadline field is deadline-aware once it's inside the worker. If the worker pool is saturated/stalled, sender.send() can block indefinitely, silently defeating the per-request deadline the caller thinks it's getting. This is an architectural sequencing/timeout-propagation gap, not a functional bug in the deadline check itself." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "Blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-02T01:32:11Z"^^xsd:dateTime ;
  triage:foundIn triage:AI-PHASE-END-REVIEW ;
  triage:foundAt "2026-07-31T18:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3152-DISPATCH-DEADLINE-001/AI3152-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3152-DISPATCH-DEADLINE-001/AI3152-2> ;
  triage:triageRecordVersion "1" .

