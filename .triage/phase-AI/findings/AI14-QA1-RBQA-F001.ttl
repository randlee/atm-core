<urn:atm:triage:finding/AI14-QA1-RBQA-F001>
  a triage:Finding ;
  triage:findingId "AI14-QA1-RBQA-F001" ;
  triage:title "Dual concurrent local-ingress listeners on Unix (UDS + HTTP loopback)" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs is compiled #[cfg(not(windows))] (lib.rs:21) -- primary Unix/Mac local-IPC server. Its PreparedRuntimeServer struct carries a #[cfg(unix)] tcp_loopback: LocalTcpLoopbackServer field (local_ipc_transport.rs:162-163), and bind_after_install binds it (local_ipc_transport.rs:291-298) alongside the UDS LocalSocketListener -- both run as live threads (serve_runtime_scope, lines 458 and 752). crates/atm-daemon/src/local_tcp_transport.rs:55-57 self-documents this as 'Secondary Unix local ingress used for UDS/TCP parity.' Meanwhile crates/atm-daemon-client/src/lib.rs:148-151 (resolve_daemon_local_ipc_endpoint) resolves exclusively through atm_core::local_http::local_http_record_path -- client fully migrated off UDS (commits dbd112e2, c5665204), but server still binds/serves both UDS accept loop and HTTP loopback listener concurrently on every Mac daemon start -- dead/unreferenced-by-any-client production infrastructure kept alive, not removed. Single-receive-path boundary violation." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "critical" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI14-QA1-RBQA-F001/s11/1> ;
