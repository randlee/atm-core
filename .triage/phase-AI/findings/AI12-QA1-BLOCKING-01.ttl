<urn:atm:triage:finding/AI12-QA1-BLOCKING-01>
  a triage:Finding ;
  triage:findingId "AI12-QA1-BLOCKING-01" ;
  triage:title "A second destination.host inspection exists outside PostWriteRouter::dispatch" ;
  triage:description "Global host inspection in resolve_write_recipient_snapshot (delivery_policy.rs:358) that gates remote vs. local delivery. This decision should be exclusive to PostWriteRouter::dispatch per AI.12 sprint requirements. Currently: if address.host.is_some() && !authenticated_source_host { return remote delivery } else { resolve local }." ;
  triage:category "QA" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
