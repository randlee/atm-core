<urn:atm:triage:finding/AI29-RSH-005>
  a triage:Finding ;
  triage:findingId "AI29-RSH-005" ;
  triage:title "push_dispatch_handle fatal branch remains dead code by call-site invariant only" ;
  triage:description "push_dispatch_handle (crates/atm-daemon/src/active_connection_registry.rs:123-143) still contains a fatal Err branch (handles.len() >= max_handles) that propagates to both Unix (local_tcp_transport.rs:126-132) and Windows (local_tcp_transport.rs:314-320) accept-loop call sites via ?. This branch is currently unreachable only because upstream try_register (lines 70-93) already caps admission at MAX_CONCURRENT_CONNECTIONS=64 before push_dispatch_handle runs. If MAX_CONCURRENT_CONNECTIONS or the reap cadence ever diverge between the two checks, the original listener-killing behavior can return." ;
  triage:phaseId "phase-AI" ;
