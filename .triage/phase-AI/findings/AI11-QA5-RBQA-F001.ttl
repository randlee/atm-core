<urn:atm:triage:finding/AI11-QA5-RBQA-F001>
  a triage:Finding ;
  triage:findingId "AI11-QA5-RBQA-F001" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T12:00:00Z"^^xsd:dateTime ;
  triage:title "Dual concurrent local-ingress listeners on Unix (UDS + TCP loopback)" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs: on #[cfg(not(windows))], this binds BOTH the UDS LocalSocketListener AND a #[cfg(unix)] tcp_loopback: LocalTcpLoopbackServer field (bind_after_install, ~lines 291-298; both run as live accept-loop threads ~457-496). atm-daemon-client resolves the local endpoint exclusively via HTTP record on s14+ (c5665204 onward) but UDS on s11-s13 (old code path). The UDS listener is dead infra on s14+ (never reached), never initialized listener is unused on s11-s13. Originally found by ruthless-boundary-qa on AI.11 QA-5. Same defect independently reported as AI14-QA1-RBQA-F001 during AI.14 QA-1 (s14-s16). This record documents the AI.11-originated instance (s11-s13 upstream of s14)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI11-QA5-RBQA-F001/s11/1> ;
