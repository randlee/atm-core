<urn:atm:triage:finding/AI25-ATMQA-002>
  a triage:Finding ;
  triage:findingId "AI25-ATMQA-002" ;
  triage:title "CLI trust mutation doesn't actually trigger the daemon refresh" ;
  triage:description "atm peer trust add/replace/revoke writes directly to PeerConfigStore and never signals a running daemon; refresh_https_trust is only reachable via the generic SIGHUP-driven reload_runtime_view hook, not \"after\" the CLI mutation as sprint Deliverable 4 states. Either wire the CLI to trigger reload directly, or correct the sprint doc's deliverable language to describe the actual (external-signal-required) design." ;
  triage:phaseId "phase-AI" ;
  triage:category "ATM-QA" ;
  triage:triageMode "initial_pass" ;
  triage:severity "Important" ;
  triage:repeatable false ;
  triage:sweepScope "crates" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T02:30:00Z"^^xsd:dateTime ;
