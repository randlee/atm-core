<urn:atm:triage:occurrence/AI25-ATMQA-002/s25/2>
  a triage:Occurrence ;
  triage:file "crates/atm/src/commands/peer.rs" ;
  triage:snippet "FIX-2 (d6f7993a) wired PeerCommand::run's Trust arm to call Self::reload_runtime_view(observability) whenever TrustCommand::run_with_store returns changed=true (Add/Replace/Revoke), which bootstraps CliComposition and calls composition.reload_runtime_view() -- a genuine CLI-mutation-to-daemon-reload trigger, not a doc rescope. Verified via git diff a9e61fb0..b520061e on crates/atm/src/commands/peer.rs." ;
  triage:status "closed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s25-peer-authority-resolution" ;
  triage:headSha "d6f7993a" ;
  triage:occursIn <urn:atm:triage:worktree/s25/0265c94f> .

