<urn:atm:triage:finding/AI7-BLOCKING-04-RSH-003-WINDOWS>
  a triage:Finding ;
  triage:findingId "AI7-BLOCKING-04-RSH-003-WINDOWS" ;
  triage:title "Windows CI red on both lint and test — RSH-003 defect inherited from AI6, unfixed" ;
  triage:description "AI7-QA-1 (team-lead independent CI check). Windows CI is red on both lint and test. Root cause is identical to AI6-QA-1: local_ipc_transport.rs:31-32,129 calls remove_stale_endpoint() unconditionally but this function is only defined under cfg(unix). The defect was flagged in AI6-FIX-1 but that fix has not yet landed or been merged forward into AI7. This is an inherited blocker that prevents Windows CI from passing. Not caught by the 6 dispatched reviewers because they cannot reproduce on macOS worktree. Team-lead's independent CI verification identified this." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "ci" ;
  triage:severity "critical" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI7-BLOCKING-04/pAI-10/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI7-BLOCKING-04/pAI-10/2> ;
  triage:openOn <urn:atm:triage:worktree/pAI-10/7a7e6341> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-10/7a7e6341> ;
  triage:highestOpenBranch "feature/pAI-s10-crosshost-proof-closeout" ;
  triage:highestFixedBranch "none" ;
  triage:triagedAt "2026-07-21T00:00:00Z"^^xsd:dateTime ;
  triage:reviewedBy "qa-triage" ;
  triage:notes "Inheritance chain: AI6 -> AI7-10. Root cause: remove_stale_endpoint() called at runtime but guarded by cfg(unix) only at definition. Fix: add cfg(unix) guard to call sites in local_ipc_transport.rs or move function outside cfg guard. Scope: atm-daemon/src/local_ipc_transport.rs. This must be fixed in AI7 or merged from AI6-FIX-1 before Windows CI can pass." .

