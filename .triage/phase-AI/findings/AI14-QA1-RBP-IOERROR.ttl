<urn:atm:triage:finding/AI14-QA1-RBP-IOERROR>
  a triage:Finding ;
  triage:findingId "AI14-QA1-RBP-IOERROR" ;
  triage:title "read_owner_record discards underlying io::Error context instead of interpolating it" ;
  triage:description "rust-best-practices-agent (RBP): crates/atm-core/src/local_http.rs's read_owner_record discards the underlying io::Error context instead of interpolating it into the returned error, diverging from this crate's own established convention in persistence.rs (which interpolates io::Error detail). Important, non-blocking." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
