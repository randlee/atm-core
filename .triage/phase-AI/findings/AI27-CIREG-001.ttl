<urn:atm:triage:finding/AI27-CIREG-001>
  a triage:Finding ;
  triage:findingId "AI27-CIREG-001" ;
  triage:title "Python 3.10+ syntax in test_run_peer_pair.py breaks pytest collection on Python 3.9" ;
  triage:description "Commit bb34e71a introduces parenthesized context manager syntax (PEP 617, Python 3.10+) in scripts/smoke/test_run_peer_pair.py at lines 55 and 120, breaking pytest collection on Python 3.9 environments across all OS legs (ubuntu/macos/windows). The syntax 'with (patch.object(...), patch.object(...)):' requires Python 3.10+. On Python 3.9 and earlier, pytest collection fails immediately with SyntaxError, causing the entire lint job to fail on all CI runners." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "CIREG" ;
  triage:severity "Blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-07-26T20:15:00Z"^^xsd:dateTime ;
  triage:closedBy "team-lead" ;
  triage:closureNotes "Independently verified: no parenthesized (PEP 617) with-statement remains in scripts/smoke/test_run_peer_pair.py on any of s27 (f93dd3c8), s28 (1db85ef0), s29 (e0294748), or s30 (e03d9c58) HEADs. Test uses nested with statements throughout. Record was stale -- fix landed via arch-ctm's earlier CI-red remediation on s27 and was already present on s28/s29/s30 before this record was even created; only the TTL was never closed." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-26T19:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S7 ;
  triage:foundAt "2026-07-26T19:15:00Z"^^xsd:dateTime ;
