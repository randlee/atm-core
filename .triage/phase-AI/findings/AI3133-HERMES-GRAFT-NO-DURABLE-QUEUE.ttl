<urn:atm:triage:occurrence/AI3133-HERMES-GRAFT-NO-DURABLE-QUEUE/in-memory-dedupe>
  a triage:Occurrence ;
  triage:file "crates/atm-graft-python/python/atm_graft_hermes_bridge.py" ;
  triage:line 25 ;
  triage:snippet "recent_message_limit: int = 1_024 ... self._recent_message_ids: OrderedDict[str, None] = OrderedDict() ... while len(self._recent_message_ids) > self._recent_message_limit: self._recent_message_ids.popitem(last=False) — in-process-only dedupe LRU, lost on restart, no durable/replayable queue behind it." ;
  triage:status "closed" ;
  triage:closed true ;
  triage:branch "integrate/phase-ai-31-33" ;
