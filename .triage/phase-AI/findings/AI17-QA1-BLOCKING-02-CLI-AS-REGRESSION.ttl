  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "resolve_cli_inspection_caller_context unconditionally resolves ambient ATM_IDENTITY before --as check" ;
  triage:description "resolve_cli_inspection_caller_context calls resolve_identity_component(None) to resolve ambient_identity unconditionally before checking overrides.identity_override, so `atm list --as <agent>` / `atm peek --as <agent>` fails with IdentityUnavailable when ATM_IDENTITY is unset. Breaks documented '--as, else ATM_IDENTITY' OR semantics (requirements.md 4.1). Untested by existing suite." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
