@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AI22-IMPORTANT-003>
  a triage:Finding ;
  triage:findingId "AI22-IMPORTANT-003" ;
  triage:title "is_peer_receipt and is_same_host_peer_receipt are two overlapping, unlinked boolean predicates with no single source of truth" ;
  triage:description "crates/atm-core/src/send/mod.rs defines both PreparedWrite::is_peer_receipt (~305-314: authenticated_source_host.is_some() || origin_message_id.is_some()) and the free function is_same_host_peer_receipt (~569-575: authenticated_source_host == to.host). Both classify overlapping aspects of the same underlying concept (is this write a peer receipt, and is it a same-host one) via independently-written boolean expressions instead of one being derived from the other or both being derived from a single shared classification type, risking future drift between them. Independently found by rust-best-practices-agent (RBP-F001, Important) and ruthless-boundary-qa (RBQA-F005, Minor) -- merged here as one finding at the higher of the two reported severities." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "structure" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-24T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-003/s22/1> ;
