# Fixed occurrence on integrate/phase-AI: the overlapping-predicate duplication is
# eliminated -- is_same_host_peer_receipt no longer exists; is_peer_receipt() delegates
# to the single has_authenticated_peer_provenance() classifier used everywhere.
<urn:atm:triage:occurrence/AI22-IMPORTANT-003/integrate-8750587b>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/send/mod.rs" ;
  triage:line 311 ;
  triage:snippet "pub fn is_peer_receipt(&self) -> bool { has_authenticated_peer_provenance(&self.outbound_request) } // FIXED: single classifier, is_same_host_peer_receipt removed" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "integrate/phase-AI" ;
  triage:headSha "8750587b" ;
  triage:note "AI.23 (PR #629) merged into integrate/phase-AI at 8750587b3e24c6e5a18e14315c363b6ea0f2d8e0. is_same_host_peer_receipt no longer exists workspace-wide; is_peer_receipt() and the call site at send/mod.rs:541 both use has_authenticated_peer_provenance() as the sole classifier." ;
  triage:occursIn <urn:atm:triage:worktree/integrate/8750587b> .

