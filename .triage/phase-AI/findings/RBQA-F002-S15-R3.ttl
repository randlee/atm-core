<urn:atm:triage:finding/RBQA-F002-S15-R3>
  a triage:Finding ;
  triage:findingId "RBQA-F002-S15-R3" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "no cardinality/absence-of-mutation vocabulary for duplicate_ulid/failed_remote_ack" ;
  triage:description "In scripts/smoke/run_peer_pair.py's semantic-verification mechanism (introduced on feature/pAI-s15-windows-peer-smoke), the verification schema lacks cardinality and absence-of-mutation vocabulary. Cannot express: 'this mutation must NOT have happened', 'this must have happened exactly N times', or 'this count must be 0'. The schema supports only positive value assertions (expected_json) and log entry blacklists (forbidden_daemon_log_entries). Found during QA-2 verification of BLOCKING-02/04 fix. Mechanism introduced on s15 (commit 12f4b96e), propagated to s16-s19, not yet on s20." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "repo-wide" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:fixedOn <urn:atm:triage:worktree/s15/12f4b96e> ;
  triage:fixedOn <urn:atm:triage:worktree/s16/34e055b> ;
  triage:fixedOn <urn:atm:triage:worktree/s17/2825b1c> ;
  triage:fixedOn <urn:atm:triage:worktree/s18/a3cfdaa> ;
