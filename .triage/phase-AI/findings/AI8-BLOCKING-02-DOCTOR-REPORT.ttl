<urn:atm:triage:finding/AI8-BLOCKING-02-DOCTOR-REPORT>
  a triage:Finding ;
  triage:findingId "AI8-BLOCKING-02-DOCTOR-REPORT" ;
  triage:title "Doctor cannot report typed configuration/bind failure — aborts instead of returning structured DoctorReport" ;
  triage:description "AI8-QA-1 (req-qa ATM-QA-002, rust-service-hardening RSH-002 — 2 independent confirmations). PeerConfigDoctorReport (crates/atm-core/src/doctor/report.rs:108-118) has no field for a validation/bind failure — it only carries healthy-state counters. The CLI's direct-local doctor path (crates/atm/src/commands/doctor.rs:91-107) propagates the validation error via ? and aborts the whole 'atm doctor' invocation with a raw error instead of a DoctorReport describing the failure, directly contradicting deliverable 5's 'doctor reports the typed configuration/bind failure.' This breaks the operator's ability to diagnose peer config state when that config is invalid." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "critical" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI8-BLOCKING-02-DOCTOR-REPORT/pAI-8/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI8-BLOCKING-02-DOCTOR-REPORT/pAI-8/2> ;
  triage:openOn <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:highestOpenBranch "feature/pAI-s8-crosshost-control-plane" ;
  triage:highestFixedBranch "none" ;
  triage:triagedAt "2026-07-20T19:30:00Z"^^xsd:dateTime ;
  triage:notes "Requires two changes: (1) add a failure variant/field to PeerConfigDoctorReport to hold config/bind error details, (2) update the direct-local doctor path in commands/doctor.rs to catch the validation error and construct a DoctorReport with that failure information instead of propagating via ?." .

