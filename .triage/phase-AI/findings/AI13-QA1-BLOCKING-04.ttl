@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AI13-QA1-BLOCKING-04>
  a triage:Finding ;
  triage:findingId "AI13-QA1-BLOCKING-04" ;
  triage:title "Negative cases in scripts/smoke/run_peer_pair.py don't prove rejection occurs before routing" ;
  triage:description "untrusted_or_allowlist_rejection's pass condition is only \"typed_error_code substring appears in stdout+stderr\" — no assertion establishes the daemon never attempted routing before rejecting (e.g. no routing-attempt counter/log check). This directly fails the AI.13 sprint doc's explicit scrutiny item: \"negative cases must prove mTLS/allowlist rejection occurs before routing.\" File scripts/smoke/run_peer_pair.py is new to AI.13." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "AI13-QA1" ;
  triage:severity "BLOCKING" ;
  triage:repeatable true ;
  triage:sweepScope "repo" ;
  triage:status "scope-mismatch" ;
  triage:dispatchReady false ;
  triage:notes "team-lead re-triage 2026-07-22, following arch-ctm pushback on ATM message 01KY5PKBKV5HNYMQFFYRHJTC4D. The gap named here is real and traces directly to AI.13's acceptance criteria: 'Its negative cases prove mTLS and allowlist rejection occur before routing.' But the fix committed toward this finding (219897c0: assertions['untrusted_or_allowlist_rejection'] = {'routing_attempts': 0} plus protocol_assertions() requiring the case command to print a trailing JSON line with a routing_attempts field) has no real producer -- no atm/atm-graft command, daemon code path, or crate emits a routing_attempts counter anywhere in the workspace (verified by grep across crates/**/*.rs: zero hits). This is the same invented producer-side metrics contract flagged in AI13-QA1-BLOCKING-02/-03, applied here to the rejection-before-routing case specifically. AI.16's authoritative sprint doc calls for real peer smoke (extend the AI.13 runner against already-proven Mac<->Mac/Mac<->Windows pairs, record evidence), not a new JSON metrics-emission protocol, so implementing this as specified would add a second synthetic CLI path. Disposition: closed as scope-mismatch, not dispatch-ready as specified. Re-triage should require proof of rejection-before-routing through an existing observable instead -- e.g. asserting the sanitized daemon log window (already captured in the evidence record) shows no routing/delivery-attempt log line before the typed rejection error, or a black-box check that no delivery side effect exists on the peer side for that case -- rather than requiring the case's own command to self-report a routing_attempts counter that does not exist in the CLI surface." ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI13-QA1-BLOCKING-04/pAI-s13/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI13-QA1-BLOCKING-04/pAI-s14/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI13-QA1-BLOCKING-04/pAI-s15/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI13-QA1-BLOCKING-04/pAI-s16/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s13/2adc5fa1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s14/ef0e5e2b> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s15/5a7a762f> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s16/1c23ac04> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s16/1c23ac04> .

