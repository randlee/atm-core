@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/RBQA-AI51-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AI51-F001" ;
  triage:title "AI.51 campaign never probed the parallel remote-peer HTTP reader" ;
  triage:description "ruthless-boundary-qa on AI51-QA-1 (PR #716 @ c2ecc8fa): the AI.51 adversarial campaign exercises only HttpFrameReader (crates/atm-core/src/api/http_frame_reader.rs), the buffered reader used by local transports. A second, functionally parallel production HTTP request-frame reader (read_http_headers/read_http_body, invoked via read_http_request in crates/atm-core/src/api.rs:251,608,650) still runs in production for remote, untrusted-peer HTTPS ingress via route_peer_http_request in crates/atm-daemon/src/https_transport.rs:609. This byte-at-a-time reader implements the same decision logic (header-delimiter search, Content-Length parsing, header/body size-cap enforcement) the campaign is meant to harden, but received zero adversarial coverage this sprint despite being the more security-sensitive path (untrusted remote peer input). Also independently tracked as pre-existing open finding RBQA-AI39-F002, which explicitly notes AI.43's scope excludes read_http_request/route_peer_http_request. Recommendation: either extend the AI.51 probe set to also target read_http_request/route_peer_http_request, or retire that byte-at-a-time reader and route route_peer_http_request through the shared HttpFrameReader so one canonical request-frame reader exists." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:foundIn triage:AI51 ;
  triage:foundAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:triagedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AI51-F001/pAI-s51/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s51-local-http-framing-adversarial-campaign/c2ecc8fa> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s51-local-http-framing-adversarial-campaign/c2ecc8fa> .

<urn:atm:triage:occurrence/RBQA-AI51-F001/pAI-s51/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/https_transport.rs" ;
  triage:line 610 ;
  triage:snippet "Not reproducible on feature/pAI-s51-local-http-framing-adversarial-campaign @ 35a2fe43 (fix content verified at a8c513ca, carried forward unchanged): route_peer_http_request now calls read_http_request(stream) at https_transport.rs:610, which delegates directly to HttpFrameReader::new().read_request(reader) (crates/atm-core/src/api.rs:254-255). No read_http_headers/read_http_body symbols remain anywhere in api.rs (zero grep hits) -- the byte-at-a-time parallel reader this finding cited no longer exists; only the shared, AI.51-campaign-covered HttpFrameReader path remains." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s51-local-http-framing-adversarial-campaign" ;
  triage:headSha "35a2fe43" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-s51-local-http-framing-adversarial-campaign/c2ecc8fa> .

