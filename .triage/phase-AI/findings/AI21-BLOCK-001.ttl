<urn:atm:triage:finding/AI21-BLOCK-001>
  a triage:Finding ;
  triage:findingId "AI21-BLOCK-001" ;
  triage:foundIn triage:AICH-S1 ;
  triage:foundAt "2026-07-25T04:58:56Z"^^xsd:dateTime ;
  triage:title "Anonymous plaintext-test reads mislabeled as authenticated peer ingress" ;
  triage:description "crates/atm-daemon/src/https_transport.rs:462-491 (route_peer_http_request) — when a connection on the plaintext-test listener carries no X-ATM-Peer-Source-Host header and isn't a Write request, the (None, None) match arm falls through to AuthenticatedIngress::Peer, the identical value a real mTLS-verified peer receives. Currently inert (ApiRouter::route only branches on ingress for Write requests today), but this is exactly the anti-pattern ADR-035 forbids. Fix: route the no-header, non-write case through a distinct unauthenticated/anonymous ingress variant instead of reusing Peer." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
  triage:sweepScope "this-branch-only" ;
  triage:category "authorization-context-mislabeling" ;
  triage:severity "Blocking" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-24T22:35:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI21-BLOCK-001/s21pre/1> ;
  triage:fixedOn <urn:atm:triage:worktree/s21pre/42fbd9fa> .

