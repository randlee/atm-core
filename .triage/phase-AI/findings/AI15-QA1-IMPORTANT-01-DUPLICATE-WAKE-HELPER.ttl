<urn:atm:triage:finding/AI15-QA1-IMPORTANT-01-DUPLICATE-WAKE-HELPER>
  a triage:Finding ;
  triage:findingId "AI15-QA1-IMPORTANT-01-DUPLICATE-WAKE-HELPER" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "Duplicate wake-helper listener logic across atm-daemon and atm-graft" ;
  triage:description "wake_listener/spawn_listener_wake_helper logic (same 250ms deadline constant, same thread-spawn/recv_timeout pattern) is implemented twice — once in atm-daemon/src/local_ipc_wake.rs (apply_listener_wake_deadline), once in atm-graft/src/runtime.rs (spawn_listener_wake_helper) — independently evolving duplicates (RBQA-F003 in the original report). Both define LISTENER_WAKE_CONNECT_DEADLINE = 250ms and implement similar thread spawn patterns." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "AI15" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI15-QA1-IMPORTANT-01-DUPLICATE-WAKE-HELPER/11/1> ;
