  triage:fixedOn <urn:atm:triage:worktree/pAI-s20/82fb2441> ;
  triage:closureReason "Superseded: atm-graft refactored to non-blocking accept model (commit 6ea4774c); spawn_listener_wake_helper and LISTENER_WAKE_CONNECT_DEADLINE removed as side effect. Only atm-daemon/src/local_ipc_wake.rs implementation remains, eliminating the duplicate." ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s20/82fb2441> .

