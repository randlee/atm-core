<urn:atm:triage:finding/ARCH-001>
  a triage:Finding ;
  triage:findingId "ARCH-001" ;
  triage:title "RULE-008 raw 'atm-dev' team literal in test_hermes_adapter.py" ;
  triage:description "crates/atm-graft-python/tests/test_hermes_adapter.py lines 58, 62, and 80 hardcode the production team literal 'atm-dev' inline instead of a TEST_TEAM-style constant, violating RULE-008 (no raw production team-name literals in tests). Required correction: define TEST_TEAM = \"test-team\" and reuse it at all call sites." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture_violation" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:dispatchReady false ;
  triage:blockingCurrentMerge false ;
  triage:closedAt "2026-07-31T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "team-lead" ;
  triage:closureNote "Fixed by commit 82b1fafb (\"fix(graft): close AI.37 QA findings\"), which introduced TEST_TEAM = \"test-team\" and replaced all three raw 'atm-dev' literals at lines 58, 62, 80. Verified during develop merge-conflict resolution on integrate/phase-ai-31-33: grep of current test_hermes_adapter.py for 'atm-dev'/'TEST_TEAM' confirms zero raw literals remain; 82b1fafb is an ancestor of this branch." ;
  triage:note "RULE-008 violation: raw 'atm-dev' literal at lines 58, 62, 80. Remediation: define TEST_TEAM = \"test-team\" module-level constant and replace all three call sites." ;
  triage:foundIn triage:AI37-QA-1 ;
