<urn:atm:triage:finding/AI22-IMPORTANT-001>
  a triage:Finding ;
  triage:findingId "AI22-IMPORTANT-001" ;
  triage:title "Self-send guard exemption trusts unauthenticated host field, inconsistent with the module's own stricter established pattern" ;
  triage:description "crates/atm-core/src/send/mod.rs validate_non_self_recipient exempts same-identity rejection whenever target.host.is_some(), without cross-checking that the host claim is actually authenticated. crates/atm-core/src/delivery_policy.rs resolve_write_recipient_snapshot already establishes a stricter pattern: 'if address.host.is_some() && !authenticated_source_host { ... }'. validate_non_self_recipient's exemption is inconsistent with this established stricter check." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "consistency" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-24T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-001/s22/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-001/s23/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s22/a5aa6813> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s23/b88ca016> ;
  triage:fixedOn <urn:atm:triage:worktree/pAI-s24/fc9832b3> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s24/fc9832b3> .

