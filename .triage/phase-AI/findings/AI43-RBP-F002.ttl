<urn:atm:triage:finding/AI43-RBP-F002>
  a triage:Finding ;
  triage:findingId "AI43-RBP-F002" ;
  triage:title "Response-decode error sites in api.rs still lack recovery text, unlike the sibling http_frame_reader.rs sites fixed for AI43-RBP-F001" ;
  triage:description "arch-qa (AI43-QA-2) found that while AI43-RBP-F001's original 5 sites in crates/atm-core/src/api/http_frame_reader.rs were correctly migrated to AtmError::validation_with_recovery(...), a distinct, previously-unflagged set of response-decode error sites in crates/atm-core/src/api.rs (read_http_response's status-parse errors at lines 362 and 364, and decode_no_content_response's 4 body/header errors at lines 413, 418, 423, 427) still call plain AtmError::validation(...) with no recovery guidance. Independently re-verified by quality-mgr via direct read/grep of both files on commit 12f1260a: crates/atm-core/src/api/http_frame_reader.rs consistently uses validation_with_recovery; crates/atm-core/src/api.rs's response-decode functions do not. Same category/pattern as AI43-RBP-F001 (inconsistent error ergonomics for callers debugging response-framing/decoding failures) but a separate file/scope, so tracked as its own record rather than reopening AI43-RBP-F001." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "code-quality" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T07:40:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:foundIn triage:AI43 ;
  triage:foundAt "2026-08-01T07:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI43-RBP-F002/S43-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/AI43-RBP-F002/S43-1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/api.rs" ;
  triage:line 362 ;
  triage:snippet "Fixed at 362801f6: all 6 originally-named response-decode error sites (status-parse errors, now lines 363/370, and decode_no_content_response's body/route/header/base64 errors, now lines 423/429/435/443) call AtmError::validation_with_recovery(...) with concrete recovery guidance, matching the sibling http_frame_reader.rs pattern. Confirmed independently by quality-mgr direct grep and corroborated in full by both arch-qa and ruthless-boundary-qa during AI43-QA-3. NOTE: req-qa's AI43-QA-3 pass separately flagged that a DIFFERENT, previously out-of-scope set of sites -- JSON-body decode paths in decode_success_response/decode_request_body/error-body-decode (lines 379-381, 448-450, 474-508, 518-561) -- still route through the bare serde_json::Error->AtmError conversion with no recovery text. That is not part of this finding's original 6 named occurrences and is tracked separately as AI43-RBP-F003." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s43-remote-https-response-framing" ;
  triage:headSha "362801f6" ;
  triage:occursIn <urn:atm:triage:worktree/S43/362801f6> .

