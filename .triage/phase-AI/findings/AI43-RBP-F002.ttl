<urn:atm:triage:finding/AI43-RBP-F002>
  a triage:Finding ;
  triage:findingId "AI43-RBP-F002" ;
  triage:title "Response-decode error sites in api.rs still lack recovery text, unlike the sibling http_frame_reader.rs sites fixed for AI43-RBP-F001" ;
  triage:description "arch-qa (AI43-QA-2) found that while AI43-RBP-F001's original 5 sites in crates/atm-core/src/api/http_frame_reader.rs were correctly migrated to AtmError::validation_with_recovery(...), a distinct, previously-unflagged set of response-decode error sites in crates/atm-core/src/api.rs (read_http_response's status-parse errors at lines 362 and 364, and decode_no_content_response's 4 body/header errors at lines 413, 418, 423, 427) still call plain AtmError::validation(...) with no recovery guidance. Independently re-verified by quality-mgr via direct read/grep of both files on commit 12f1260a: crates/atm-core/src/api/http_frame_reader.rs consistently uses validation_with_recovery; crates/atm-core/src/api.rs's response-decode functions do not. Same category/pattern as AI43-RBP-F001 (inconsistent error ergonomics for callers debugging response-framing/decoding failures) but a separate file/scope, so tracked as its own record rather than reopening AI43-RBP-F001." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "code-quality" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T07:40:00Z"^^xsd:dateTime ;
