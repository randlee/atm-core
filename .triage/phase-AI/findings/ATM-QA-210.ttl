<urn:atm:triage:finding/ATM-QA-210>
  a triage:Finding ;
  triage:findingId "ATM-QA-210" ;
  triage:title "sc-compose fuzz-report vendored-source pointer dropped from AI.48/AI.50 split" ;
  triage:description "AI.46's plan-doc restructure split the fuzz-report work into AI.48 (fuzz tooling port) and AI.50 (fuzz report), and the previously-baked-in sc-compose vendored-template pointer (exact file paths: .claude/skills/html-report/templates/fuzz-run-report.html.j2, fuzz-run-agent.xhtml.j2, .claude/skills/html-report/fuzz-run-agent-contract.md, .claude/skills/adversarial-fuzzing/SKILL.md, copied verbatim from randlee/sc-compose develop) is missing from both new docs. Both AI.48 and AI.50 lack explicit 'from randlee/sc-compose' source attribution; additionally, AI.48 omits the HTML report template file paths entirely. This re-breaks the previously-resolved AI46-SCC directive that these exact paths must be named in sprint-doc text, not just tracked in memory/ATM messages." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "docs-consistency" ;
  triage:severity "blocking" ;
