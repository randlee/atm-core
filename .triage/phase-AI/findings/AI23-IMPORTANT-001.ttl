<urn:atm:triage:finding/AI23-IMPORTANT-001>
  a triage:Finding ;
  triage:findingId "AI23-IMPORTANT-001" ;
  triage:foundAt "2026-07-25T06:25:35Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S3 ;
  triage:title "semver crate dependency and ReleaseVersion::parse rewrite pre-empt AI.30's exclusively chartered deliverable" ;
  triage:description "Commit 80da43238523398d4a5eede54c41b5bdcef1df96 adds a new semver workspace dependency (Cargo.toml, crates/atm-core/Cargo.toml) and rewrites ReleaseVersion::parse (crates/atm-core/src/protocol.rs:79-100) from a hand-rolled numeric-triplet check to semver::Version::parse. Sprint AI.30 explicitly and exclusively owns strict SemVer product release values as its own deliverable. AI.23 introduces a less-optimal implementation that duplicates/pre-empts AI.30's chartered work. AI.30 already has a superior implementation using semver::Version directly as the ReleaseVersion struct member." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
