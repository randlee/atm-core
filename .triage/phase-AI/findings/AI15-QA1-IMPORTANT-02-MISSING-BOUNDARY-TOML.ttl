<urn:atm:triage:finding/AI15-QA1-IMPORTANT-02-MISSING-BOUNDARY-TOML>
  a triage:Finding ;
  triage:findingId "AI15-QA1-IMPORTANT-02-MISSING-BOUNDARY-TOML" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "Missing explicit boundary TOML for atm-graft post-send transport" ;
  triage:description "boundaries/atm-daemon/socket-server-transport.toml marks interprocess::local_socket::Listener as retired/forbidden outside its owner crate with comprehensive lint and review gates. No equivalent boundaries/atm-graft/*.toml exists for graft's post-send notification channel, so the same leak (unconditional interprocess::local_socket usage in atm-graft/src/runtime.rs) is invisible to CI boundary enforcement. The existing shared-client-consumer.toml forbids atm-graft -> interprocess edge but does not provide the detailed forbidden_references and enforcement gates needed to catch unconditional imports/uses within atm-graft itself. (RBQA-F002 in original report)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "AI15" ;
  triage:severity "important" ;
