<urn:atm:triage:finding/AI12-QA1-BLOCKING-02>
  a triage:Finding ;
  triage:findingId "AI12-QA1-BLOCKING-02" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T16:00:00Z"^^xsd:dateTime ;
  triage:title "PostWriteRouter::dispatch never emits the local nudge; nudge fires earlier inside the canonical writer" ;
  triage:description "Confirmed independently by req-qa, arch-qa, and ruthless-boundary-qa. For an empty destination host, PostWriteRouter::dispatch (crates/atm-daemon/src/runtime_health.rs:574-589) does emit the nudge when host is None. However, the canonical write path in MessageWriter (crates/atm-core/src/send/mod.rs:422) unconditionally calls emit_local_post_write_with_runtime for any non-dry-run message, BEFORE route_write ever invokes the router. This means the nudge is still emitted early in the writer, not exclusively in PostWriteRouter::dispatch. Directly contradicts deliverable 4 (router emits exactly one local post-write nudge) and boundary-enforcement item 4 (nudge calls occur only in the post-write router)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "QA1" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/send/mod.rs and crates/atm-daemon/src/runtime_health.rs for any nudge/hook::emit_post_send_effects call sites outside PostWriteRouter::dispatch" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-26T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI12-QA1-BLOCKING-02/s20/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI12-QA1-BLOCKING-02/s20/2> ;
  triage:highestFixedBranch "integrate/phase-AI" .

