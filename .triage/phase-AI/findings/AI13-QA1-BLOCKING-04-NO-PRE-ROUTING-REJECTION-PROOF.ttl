  a triage:Occurrence ;
  triage:file "scripts/smoke/run_peer_pair.py" ;
  triage:line 210 ;
  triage:snippet "for case in config[\"cases\"]:\n            result = run_command(case[\"command\"], timeout)\n            if case[\"expect\"] == \"success\":\n                passed = result[\"exit_code\"] == 0\n            else:\n                passed = result[\"exit_code\"] != 0 and case[\"typed_error_code\"] in (result[\"stdout\"] + result[\"stderr\"])" ;
  triage:status "fixed" ;
  triage:closed true ;
