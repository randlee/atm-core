  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "Negative cases don't prove rejection happens before routing" ;
  triage:description "In scripts/smoke/run_peer_pair.py, negative/rejection test cases never assert a routing-attempt was NOT made (no routing-attempt assertion) — they only check the final outcome, not that rejection happened at the correct point in the pipeline (before persistence/routing)." ;
