<urn:atm:triage:finding/AI38-QA1-SCHEDULED-FAILURE-NO-CALLBACK>
  a triage:Finding ;
  triage:findingId "AI38-QA1-SCHEDULED-FAILURE-NO-CALLBACK" ;
  triage:title "Scheduled steer failures are only logged, never reported to a structured host callback" ;
  triage:description "crates/atm-graft-python/python/atm_graft_hermes_adapter.py: AtmGraftAdapter._schedule (around line 181) wraps live_nudge_callback/recovery_summary_callback delivery in an asyncio task and attaches _report_scheduled_failure (around line 197) as its done-callback. _report_scheduled_failure only calls LOGGER.error/LOGGER.exception on HermesSteerFailure or any other exception; it never invokes any host-provided structured failure callback/hook, so a caller relying on AtmGraftAdapter has no programmatic way to observe or react to a steer failure that occurred on the scheduled (fire-and-forget) delivery path -- only the synchronous await self.deliver_live_nudge(...) path surfaces the exception directly. This gap was identified by arch-ctm's own plan/code audit (ATM message 2026-07-29T16:39:20Z), separate from the AI38-QA-1 reviewer set." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-29T17:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S18 ;
  triage:foundAt "2026-07-29T16:39:20Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI38-QA1-SCHEDULED-FAILURE-NO-CALLBACK/S38-1> ;
  triage:triageRecordVersion "1" .

