  triage:triagedAt "2026-07-20T19:30:00Z"^^xsd:dateTime ;
  triage:notes "Fix: add text-mode rendering for peer configuration state in doctor output. Should display summary counts and status of enabled interfaces, local certificates, and trusted peers in plain-text format." .

