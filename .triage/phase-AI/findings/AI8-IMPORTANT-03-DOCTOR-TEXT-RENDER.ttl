<urn:atm:triage:finding/AI8-IMPORTANT-03-DOCTOR-TEXT-RENDER>
  a triage:Finding ;
  triage:findingId "AI8-IMPORTANT-03-DOCTOR-TEXT-RENDER" ;
  triage:title "Text-mode atm doctor has no rendering for peer-config state — only --json exposes it" ;
  triage:resolution "FIXED in integrate/phase-AI @ 98e6fc38 (PR #603, commit 2196ffb3). atm doctor peer render now includes text output for human readability alongside structured JSON. Tested on all three CI platforms (macos-latest, ubuntu-latest, windows-latest)." ;
  triage:description "AI8-QA-1 (ruthless-boundary RBQA-F002). Deliverable 3 requires atm doctor to report peer configuration state in both text and JSON modes. Currently, the plain-text operator path has no rendering for peer-config state at all; only the --json output exposes it. This breaks the text-mode operator experience and violates the symmetric reporting contract (both modes should provide equivalent information)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
