<urn:atm:triage:finding/AI19-ARCH-002-TAINT-PROPAGATION-NOT-MERGED-FORWARD>
  a triage:Finding ;
  triage:findingId "AI19-ARCH-002-TAINT-PROPAGATION-NOT-MERGED-FORWARD" ;
  triage:title "Non-transitive taint propagation / silent-permissive-on-unrecognized-initializer in function_binding_provenance" ;
  triage:description "function_binding_provenance in the post-write router's AST boundary check resolves use-alias fixed points but historically failed to (a) mirror that fixed-point loop onto local let-binding chains beyond one hop, and (b) fail closed on unrecognized initializer expression shapes (e.g. Expr::Call like Box::new(fn)), silently treating them as Safe instead of flagging them. Fixed on feature/pAI-s12-post-write-router via commits: round-3 fix (use-alias fixed-point, single-hop local, ARCH-003 twin removal), then commit c56ae0be (round-5: fail-closed provenance tracking for two-hop local bindings and Box::new-delivery bindings, with regression fixtures). arch-ctm has manually merge-forwarded this fix: AI.12->AI.13 via commit 62b67831, and AI.13->AI.14 via commit e148ea7a. He stopped there." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T18:57:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI19-ARCH-002-TAINT-PROPAGATION-NOT-MERGED-FORWARD/s15/1> ;
