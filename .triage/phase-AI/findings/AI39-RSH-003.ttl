<urn:atm:triage:finding/AI39-RSH-003>
  a triage:Finding ;
  triage:findingId "AI39-RSH-003" ;
  triage:title "O(n^2) header-delimiter rescan in HttpFrameReader" ;
  triage:description "On every iteration where the delimiter is not found, self.delimiter.find(&self.unread) re-scans the entire accumulated buffer from the start instead of resuming from the previously scanned offset. For a peer trickling bytes in small increments up to the 16 KiB header cap, this results in up to O(n^2) scan work per connection before the size cap trips." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "input_limits" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T16:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI39 ;
  triage:foundAt "2026-07-31T16:30:00Z"^^xsd:dateTime ;
