<urn:atm:triage:finding/AI28-QA1-F002>
  a triage:Finding ;
  triage:findingId "AI28-QA1-F002" ;
  triage:aliasIds "AI28-RBQA-F001,AI28-ARCH-002,RBQA-AI28-2" ;
  triage:title "Sprint-doc-mandated concurrency/race tests entirely absent" ;
  triage:description "crates/atm-daemon/src/peer_drain_coordinator.rs (515 new lines, the component owning the worker thread, slot leasing, generation-based missed-write detection, and exponential backoff) has zero #[cfg(test)] coverage of its own. The sprint acceptance criteria explicitly require: fake-clock tests for backoff min/cap/reset/revoke/empty-window/restart; a single-flight same-host contention test; and tests forcing both generation-change race windows. None of these exist. The component's only coverage is indirect through integration tests exercising the happy path. Additionally, AI.27's prior cooldown-map test (automatic_peer_sync_cooldown_is_bounded_and_expires) was deleted with no bounded-capacity replacement for the new per-host slot map, violating the no-test-deletion-during-coupling-moves policy. This is classified as Blocking because it is an explicitly-named, sprint-scoped acceptance criterion, not an optional follow-up. Independently corroborated by 4 of 6 reviewers (req-qa, rust-best-practices-agent, arch-qa, ruthless-boundary-qa) as the same underlying gap, though severity classifications differ." ;
  triage:category "QA" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
