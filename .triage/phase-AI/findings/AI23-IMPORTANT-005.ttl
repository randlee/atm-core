  a triage:Occurrence ;
  triage:file "artifacts/phase-ai/ai22/advertised-ip-tls-self-send.md" ;
  triage:line 1 ;
  triage:snippet "## Canonical-path component evidence names ApiRouter::route, DaemonRequestDispatcher, MessageWriter::write, and PostWriteRouter::dispatch" ;
