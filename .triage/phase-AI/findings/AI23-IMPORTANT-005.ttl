<urn:atm:triage:finding/AI23-IMPORTANT-005>
  a triage:Finding ;
  triage:findingId "AI23-IMPORTANT-005" ;
  triage:title "Advertised-IP self-send evidence artifact omits required router/dispatcher/persistence component naming" ;
  triage:description "docs/plans/phase-ai/sprint-ai-22-loopback-self-send-exemption.md requires (line 142) that evidence show \"the receiver enters the same HTTP write resource, ApiRouter::route, dispatcher, persistence method, and PostWriteRouter\" and (lines 161-162) that \"evidence names the router, dispatcher, persistence, and post-write log events observed.\" The committed artifact at artifacts/phase-ai/ai22/advertised-ip-tls-self-send.md reports atm doctor --json output, atm send/read commands, a message ID, a live recipient nudge, and a peer-delivery log line (write_persisted -> peer_delivery_confirmed), but does not name ApiRouter::route, the DaemonRequestDispatcher, or the specific persistence method by name anywhere in the document -- only the post-write log events are actually named, not the router/dispatcher/persistence components the sprint doc explicitly requires. Confirmed by an independent req-qa review pass reading the artifact directly against the sprint doc's exact required language." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "EVIDENCE-GAP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-07-26T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "AICH-S11-QA-BATCH-2: verified Crimson's 'no edit needed' claim on fix/close-out-round2-easy (673a6fff, PR #652). Commit 673a6fff does not touch artifacts/phase-ai/ai22/advertised-ip-tls-self-send.md at all (confirmed via git show --stat). Read the artifact's '## Canonical-path component evidence' section directly: it already names all required components -- ApiRouter::route, DaemonRequestDispatcher (route_write), MessageWriter::write, and PostWriteRouter::dispatch -- satisfying the sprint doc's exact required language. No-op close is genuinely correct, not an incorrect dismissal." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T20:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S3 ;
  triage:foundAt "2026-07-25T20:37:38Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-005/fix-close-out-round2-easy/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-005/S22-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-005/S23-1> ;
