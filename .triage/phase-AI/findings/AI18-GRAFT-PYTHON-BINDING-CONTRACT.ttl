# PyO3 binding contract defect: test_malformed_source_fails_closed expects
# RuntimeError but the actual binding raises AtmGraftError instead.
# Root-cause class matches AI18-GRAFT-PYTHON-NOT-BUILDABLE: CI/QA never
# exercised the real Python build/test path (maturin + pytest), only
# cargo test against the Rust-side python_api.rs mock.

<urn:atm:triage:finding/AI18-GRAFT-PYTHON-BINDING-CONTRACT>
  a triage:Finding ;
  triage:findingId "AI18-GRAFT-PYTHON-BINDING-CONTRACT" ;
  triage:title "PyO3 binding contract defect: test_malformed_source_fails_closed expects RuntimeError but gets AtmGraftError" ;
  triage:description "Test test_malformed_source_fails_closed in crates/atm-graft-python/tests/test_hermes_bridge.py:101 expects PyAgentAddress constructor to raise RuntimeError on malformed input (hendrix:bad), but the actual PyO3 binding raises AtmGraftError instead. Genuine binding contract defect discovered when just test-hermes-graft-bridge ran for the first time after cherry-picking the AI18-GRAFT-PYTHON-NOT-BUILDABLE fix (commit b97ab1f3 enabled the maturin build step to complete). Root cause: same class as AI18-GRAFT-PYTHON-NOT-BUILDABLE: CI/QA coverage never exercised the actual Python build and pytest execution path. Only cargo test against crates/atm-graft-python/src/python_api.rs (Rust-side mock) was running. The real maturin build and pytest test execution were blocked until the PEP 440 version defect was fixed. Either the PyO3 binding's atm_error() function (lib.rs:31) should raise RuntimeError as originally specified, or the test/documentation must be updated to reflect the intentional AtmGraftError contract. Requires decision on graft error handling contract from crates/atm-graft-python source and any related ADR/requirements documentation." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA-COVERAGE-GAP" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-27T16:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S18 ;
  triage:foundAt "2026-07-27T16:40:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI18-GRAFT-PYTHON-BINDING-CONTRACT/1> ;
  triage:openOn <urn:atm:triage:worktree/testing_hermes_atm_graft_b97ab1f3> ;
  triage:relatedFinding "AI18-GRAFT-PYTHON-NOT-BUILDABLE" ;
  triage:triageRecordVersion "1" .

