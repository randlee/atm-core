<urn:atm:triage:finding/AI33-M5-STALE-LAUNCHAGENT>
  a triage:Finding ;
  triage:findingId "AI33-M5-STALE-LAUNCHAGENT" ;
  triage:title "M5 host had a stale LaunchAgent outside daemon-switch's selected label; discovery should fail visibly" ;
  triage:description "During the real M5 run, arch-ctm found a stale second macOS LaunchAgent (com.randlee.atm-ag15-release) present on the test host, outside the label daemon-switch actually selected. This did not corrupt the M5 result but the discovery/selection logic silently tolerated the stray LaunchAgent rather than failing visibly, which risks a future host having ambiguous/competing daemon instances go undetected." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-infra" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
