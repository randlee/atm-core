<urn:atm:triage:finding/AI33-M5-STALE-LAUNCHAGENT>
  a triage:Finding ;
  triage:findingId "AI33-M5-STALE-LAUNCHAGENT" ;
  triage:title "M5 host had a stale LaunchAgent outside daemon-switch's selected label; discovery should fail visibly" ;
  triage:description "During the real M5 run, arch-ctm found a stale second macOS LaunchAgent (com.randlee.atm-ag15-release) present on the test host, outside the label daemon-switch actually selected. This did not corrupt the M5 result but the discovery/selection logic silently tolerated the stray LaunchAgent rather than failing visibly, which risks a future host having ambiguous/competing daemon instances go undetected." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-infra" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-29T18:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S13 ;
  triage:foundAt "2026-07-26T16:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI33-M5-STALE-LAUNCHAGENT/pAI-s33-1> ;
  triage:closedAt "2026-07-30T03:20:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:progressNote "AI33-M5-NINEFIX-QA-1: waived as not-applicable at a8d1e237. arch-qa independently verified run_admission_capacity.py and daemon_lifecycle.py never reference launchd/LaunchAgent/daemon-switch in any form. The runner's only pre-start gate is require_clean_host_daemon_state() (daemon_lifecycle.py:108-125), a blunt ps/tasklist process-name scan for atm-daemon that fails closed on ANY ambient daemon process regardless of what spawned it -- it does not silently tolerate ambiguity as the original finding's premise described. There is no launchd-selection concept to be 'outside' of. Closed as not-reproducible/not-applicable, not as a functional fix." ;
  triage:triageRecordVersion "2" .

