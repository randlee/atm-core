<urn:atm:triage:finding/AI6-APIREQUEST-SHAPE>
  a triage:Finding ;
  triage:findingId "AI6-APIREQUEST-SHAPE" ;
  triage:title "ApiRequest delivered as struct wrapper instead of contract enum shape" ;
  triage:description "Sprint contract specifies enum ApiRequest { Messages, Write, Message, Clear, Doctor, Teams }. Delivered type is struct ApiRequest { request: RequestEnvelope }, a thin wrapper with no distinguishable Write variant. This undermines deliverable #8 (architecture test): an AST/type-level graph check cannot statically identify the write path without a real enum discriminant. Blocks AI.7 type-level write-handler design and forces string/value-matching that the sprint explicitly disallows." ;
  triage:triageMode "initial_pass" ;
  triage:category "REQ" ;
  triage:phaseId "phase-AI" ;
  triage:severity "critical" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-20T16:58:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI6-APIREQUEST-SHAPE/pAI-s6/1> ;
