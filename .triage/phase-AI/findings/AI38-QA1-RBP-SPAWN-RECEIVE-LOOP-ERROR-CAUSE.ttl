<urn:atm:triage:finding/AI38-QA1-RBP-SPAWN-RECEIVE-LOOP-ERROR-CAUSE>
  a triage:Finding ;
  triage:findingId "AI38-QA1-RBP-SPAWN-RECEIVE-LOOP-ERROR-CAUSE" ;
  triage:title "Error cause lost in spawn_receive_loop_error" ;
  triage:description "spawn_receive_loop_error in crates/atm-graft/src/lib.rs discards the underlying std::io::Error from thread::Builder::spawn and returns a bare daemon_unavailable AtmError with no cause attached. The _source parameter is bound but never read, so causal detail is silently dropped as this error crosses the std::thread abstraction boundary into AtmError. Recommendation: attach source error via .with_cause(source.to_string()) following pattern already used in python_callback_error at crates/atm-graft-python/src/lib.rs:55-61." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:highestOpenBranch "feature/pAI-s38-hermes-steer-nudge-delivery" ;
  triage:triagedAt "2026-07-29T00:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S18 ;
  triage:foundAt "2026-07-28T23:30:00Z"^^xsd:dateTime ;
