<urn:atm:triage:finding/AI50-REDACTION-REGEX-GAP>
  a triage:Finding ;
  triage:findingId "AI50-REDACTION-REGEX-GAP" ;
  triage:title "ABSOLUTE_PATH redaction regex misses /home/ and /private/var/ real CI path roots" ;
  triage:description "scripts/fuzz/render_report.py:34 ABSOLUTE_PATH regex only matches /Users/, /private/tmp/, /tmp/, and Windows drive letters. It does NOT match /home/... (the actual home root on ubuntu-latest CI runners) or /private/var/... (macOS's real per-process tmpdir root, distinct from /private/tmp/). This is a direct gap against AI.50's own acceptance criterion (complete, public-safe, browsable report package) -- any free-text field not routed through SENSITIVE_KEYS can leak an unredacted real CI path on ubuntu/macos legs. No fixture exercises /home/ or /private/var/. Verified independently by quality-mgr via direct source read; found by ruthless-boundary-qa as RBQA-F002 during AI50-QA-1 (PR #709, feature/pAI-s50-fuzz-report @ 507748ac)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "security-redaction-gap" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-08-01T04:20:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "2026-08-01 (quality-mgr, AI50-QA-2): independently re-verified at feature/pAI-s50-fuzz-report@ccfb3c99 plus unanimous PASS from req-qa, arch-qa, and ruthless-boundary-qa. New shared module scripts/public_redaction.py:11-13 broadens ABSOLUTE_PATH to cover /Users/, /home/, /private/tmp/, /private/var/, /tmp/, and Windows drive-letter paths. .just/fixtures/fuzz/redaction-paths.json now exercises all six real CI path roots and .just/tests/test_public_redaction.py asserts full redaction for each. Confirmed via direct file read, not self-report." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T20:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI50 ;
  triage:foundAt "2026-08-01T03:40:27Z"^^xsd:dateTime ;
