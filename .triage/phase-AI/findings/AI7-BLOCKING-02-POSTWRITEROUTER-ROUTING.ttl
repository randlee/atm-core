<urn:atm:triage:finding/AI7-BLOCKING-02-POSTWRITEROUTER-ROUTING>
  a triage:Finding ;
  triage:findingId "AI7-BLOCKING-02-POSTWRITEROUTER-ROUTING" ;
  triage:title "PostWriteRouter host-based local-nudge vs HTTPS routing per ADR-035 is not implemented" ;
  triage:description "AI7-QA-1 (arch-qa + ruthless-boundary-qa + req-qa independent confirmations). The sprint's Contract section specifies that PostWriteRouter.dispatch() is the only host-routing decision point and must emit a local nudge only for an empty host; every present host uses HTTPS. This behavior does not exist. Two independent post-write dispatch paths remain instead of one canonical router. ADR-035 remains status:proposed (not ratified), and the host-based routing logic is not implemented anywhere. Deliverable 2 requires routing CLI send/ack, graft, and REST to one write handler and one sealed storage method via PostWriteRouter." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture" ;
  triage:severity "critical" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI7-BLOCKING-02/pAI-10/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-10/7a7e6341> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-10/7a7e6341> ;
  triage:highestOpenBranch "feature/pAI-s10-crosshost-proof-closeout" ;
  triage:highestFixedBranch "none" ;
  triage:triagedAt "2026-07-21T00:00:00Z"^^xsd:dateTime ;
  triage:reviewedBy "qa-triage" ;
  triage:notes "Related findings: B1 (trait missing), B5 (ADR-035 status:proposed). This blocks AI.8-10 crosshost dispatch. Scope: atm-daemon post-write routing paths. The single-dispatch-point invariant is structural in DaemonRequestDispatcher but the downstream handling is not unified via PostWriteRouter." .

