<urn:atm:triage:finding/AI6-RSH-001>
  a triage:Finding ;
  triage:findingId "AI6-RSH-001" ;
  triage:title "RSH-001 (critical): No socket-level timeout on primary request path" ;
  triage:description "handle_connection never applies set_recv_timeout/set_send_timeout before blocking reads. Only connection-cap-rejection and shutdown-probe paths apply the 3s deadline to socket. A stalled same-host peer can wedge a connection-worker thread forever, consuming one of 64 connection slots indefinitely. Causally linked with RSH-002 (shutdown not bounded) — together they allow daemon shutdown hang via single wedged peer." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-AI" ;
  triage:severity "critical" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-20T16:58:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI6-RSH-001/pAI-s6/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s6/764bdd32> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s6/764bdd32> ;
  triage:relatedFinding "AI6-RSH-002" ;
  triage:reviewedBy "rust-service-hardening-agent" .

