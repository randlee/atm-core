  a triage:Finding ;
  triage:findingId "ATM-QA-M2-AI3" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-20T22:42:00Z"^^xsd:dateTime ;
  triage:title "Public AtmError fields allow constructing an error that bypasses error_catalog::render() -- explicitly deferred to AI.4 by the verdict itself" ;
  triage:description "AI3-QA-1 (rust-best-practices-agent, minor). AtmError's {code, message} fields are public, so a caller can hand-construct an AtmError without going through error_catalog::render(), skipping the canonical guidance-composition path. The AI3-QA-1 verdict itself notes this is an accepted gap for AI.3 -- AI.4 migrates every consumer to the catalog-backed constructors, at which point this can be closed by tightening field visibility or adding a constructor-only invariant. Not an AI.3 completion gap." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-M2-AI3/pAI-3/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-4/3679a9b3> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-4/3679a9b3> ;
  triage:highestOpenBranch "feature/pAI-s4-error-consumer-migration" ;
  triage:resolution "DEFERRED TO AI.4: explicitly out of scope for AI.3 per the QA verdict's own text -- AI.4's consumer migration is the natural place to tighten AtmError construction. Do not dispatch as an AI.3 fix; re-raise during AI.4 triage if not naturally closed by its consumer-migration work." ;
  triage:triagedAt "2026-07-20T22:42:00Z"^^xsd:dateTime .

