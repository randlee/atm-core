<urn:atm:triage:finding/AI33-M5-WINDOWS-DAEMON-NOT-READY>
  a triage:Finding ;
  triage:findingId "AI33-M5-WINDOWS-DAEMON-NOT-READY" ;
  triage:title "atm-daemon on Windows never emits ATM_DAEMON_READY during isolated M5 capacity benchmark run" ;
  triage:description "During an isolated admission-capacity benchmark attempt on Windows host fastpc4 (dedicated 'atm' OS account, ATM_CAPACITY_ISOLATED_OS_USER=1, existing .atm state preserved, zero ambient daemon confirmed before start, release build), the daemon process started and stayed alive >30 seconds but never emitted the ATM_DAEMON_READY readiness signal. stderr/stdout were both empty (no error surfaced). The benchmark runner correctly detected the non-ready state, detected/cleaned up the leaked daemon PID (29872), and restored state with zero production DB writes -- runner's own safety guards worked correctly. This occurred before any admission requests were sent, so it is a Windows daemon-startup/runner-readiness gap, NOT a capacity/timing measurement result. Evidence persisted at artifacts/smoke/admission-capacity-fastpc4/admission-capacity-20260730T030156Z.json on feature/pAI-s33-admission-capacity-smoke." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "platform-compatibility" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-29T20:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S13 ;
  triage:foundAt "2026-07-30T03:01:56Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI33-M5-WINDOWS-DAEMON-NOT-READY/fastpc4-windows-daemon-startup> ;
  triage:triageRecordVersion "1" .

