<urn:atm:triage:finding/AI33-WINDOWS-LOCAL-IPC-CONNRESET>
  a triage:Finding ;
  triage:findingId "AI33-WINDOWS-LOCAL-IPC-CONNRESET" ;
  triage:title "Windows local-HTTP loopback transport intermittently resets the connection (WSAECONNRESET) during request write or response read" ;
  triage:description "During AI.33 Windows capacity validation on fastpc4, transient WSAECONNRESET (10054) appeared twice in separate smoke batches, once while reading and once while writing local daemon HTTP headers, during ordinary send operations. The daemon and listeners remained healthy; required-ack and reply sends passed in the same attempts, and attempts 2-10 passed cleanly. Confirmed Windows local-HTTP transport defect; do NOT add automatic client retry as reset during write may follow partial delivery and duplicate non-idempotent sends. Investigate connection ownership and request-worker close paths with deterministic regression test." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "platform-compatibility" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
