  triage:line 40 ;
  triage:snippet "PostSendBuiltInTarget::Graft(target) => { self.graft_port.deliver_post_send(&dispatch.event, target)?; Ok(PostSendEmissionPath::GraftPort) }" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "testing/hermes-smoke-testing" ;
  triage:headSha "9baa734b" ;
  triage:occursIn <urn:atm:triage:worktree/hermes-smoke-testing-graft-observability> ;
  triage:evidence "DaemonPostSendHookEmitter::emit_post_send's Graft match arm forwards to the port and returns Ok(PostSendEmissionPath::GraftPort) with no tracing call on the success path, matching the LocalTmux arm's lack of success logging." .

