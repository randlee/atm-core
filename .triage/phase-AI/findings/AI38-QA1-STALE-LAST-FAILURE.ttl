  a triage:Finding ;
  triage:findingId "AI38-QA1-STALE-LAST-FAILURE" ;
  triage:title "adapter.last_failure is never cleared after a later successful steer" ;
  triage:description "crates/atm-graft-python/python/atm_graft_hermes_adapter.py: AtmGraftAdapter._inject_steer (lines 155-172) sets self.last_failure = failure in both except branches but never resets it to None on the successful (try) path, causing stale failure state to persist indefinitely." ;
