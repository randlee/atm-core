<urn:atm:triage:finding/AI13-QA1-BLOCKING-01>
  a triage:Finding ;
  triage:findingId "AI13-QA1-BLOCKING-01" ;
  triage:title "Teardown can delete a `.peer-smoke-owned` marker file this invocation did not create, when launch_command is set without owned_runtime_paths" ;
  triage:description "In scripts/smoke/run_peer_pair.py, validate() only requires daemon.runtime_dir when owned_runtime_paths is non-empty, allowing launch_command to be set without owned_runtime_paths. In that configuration, execute() never creates the ownership marker because the marker-touch block is gated on owned_runtime_paths. Then in stop_owned(), the ownership-marker gate at line 166 is skipped when owned_runtime_paths is falsy, and the unconditional marker.unlink() at line 177 deletes ANY `.peer-smoke-owned` file in CWD, regardless of whether this invocation created it. Violates sprint AI.13 deliverable 5 (teardown must never touch unrelated live singleton resources)." ;
  triage:triageMode "initial_pass" ;
  triage:category "AI13-QA1" ;
  triage:phaseId "phase-AI" ;
  triage:severity "BLOCKING" ;
  triage:repeatable true ;
  triage:sweepScope "repo" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
