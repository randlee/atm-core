<urn:atm:triage:finding/AI43-RBP-F001>
  a triage:Finding ;
  triage:findingId "AI43-RBP-F001" ;
  triage:title "Response-side HTTP framing errors lack recovery text" ;
  triage:description "rust-best-practices-agent (AI43-QA-1) found 5 sites in crates/atm-core/src/api/http_frame_reader.rs where response-side HTTP framing errors are raised without recovery/remediation text, unlike the equivalent request-side error paths which include it. Inconsistent error ergonomics for callers debugging framing failures." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
