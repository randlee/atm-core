<urn:atm:triage:occurrence/AI43-RBP-F001/S43-1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/api/http_frame_reader.rs" ;
  triage:line 1 ;
  triage:snippet "Fixed at 12f1260a: all 5 FrameKind::Response error sites (header_limit_error, body_limit_error, duplicate/invalid Content-Length, UTF-8 header decode in parse_header_lines) now call AtmError::validation_with_recovery matching FrameKind::Request. See AI43-RBP-F002 for a distinct, separate finding in api.rs's response-decode functions." ;
  triage:status "fixed" ;
  triage:closed true ;
