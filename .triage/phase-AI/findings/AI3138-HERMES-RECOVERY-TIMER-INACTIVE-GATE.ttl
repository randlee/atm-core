<urn:atm:triage:finding/AI3138-HERMES-RECOVERY-TIMER-INACTIVE-GATE>
  a triage:Finding ;
  triage:findingId "AI3138-HERMES-RECOVERY-TIMER-INACTIVE-GATE" ;
  triage:title "Recovery timer runs even when the graft receiver is inactive" ;
  triage:description "crates/atm-graft-python/python/atm_graft_hermes_bridge/__init__.py:56-66 schedules the 10-second mailbox count immediately after activate_receiver, without checking PyGraftSession.snapshot(). Graft activation legitimately returns Inactive when no .atm.toml exists or [atm.graft] is disabled (crates/atm-graft/src/lib.rs:350-375). At 10s this can read mailbox counts and invoke recovery_hook/steer for a profile that is not listening, violating AI.37/REQ-GRAFT-HERMES-003 (recovery only after receiver becomes Listening). Existing tests only use a fake session that always appears active, so this gap is untested." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-01T19:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI-PHASE-END-REVIEW ;
  triage:foundAt "2026-07-31T14:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3138-HERMES-RECOVERY-TIMER-INACTIVE-GATE/AICH-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI3138-HERMES-RECOVERY-TIMER-INACTIVE-GATE/AICH-2> ;
  triage:triageRecordVersion "1" .

