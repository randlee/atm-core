<urn:atm:triage:finding/AI39-RBP-F002>
  a triage:Finding ;
  triage:findingId "AI39-RBP-F002" ;
  triage:title "HTTP framing error codes lack specificity and recovery guidance" ;
  triage:description "Five structurally distinct HTTP framing failures (header section too large, non-UTF-8 headers, malformed method/path/version, invalid Content-Length, body too large) all resolve to the single generic AtmErrorCode::MessageValidationFailed via AtmError::validation(...), with no recovery guidance attached despite AtmError::validation_with_recovery being available in the same crate. Dedicated LocalHttp* error codes exist for other HTTP concerns but none apply to frame-reader failures." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP-001" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI39 ;
  triage:foundAt "2026-07-31T00:00:00Z"^^xsd:dateTime ;
