<urn:atm:triage:finding/AI28-ARCH-004>
  a triage:Finding ;
  triage:findingId "AI28-ARCH-004" ;
  triage:title "Misleading 'worker_clone' variable name obscures intent" ;
  triage:description "A variable named 'worker_clone' is used in the peer recovery initialization logic, but its name is misleading about what it actually represents. The variable does not hold a clone of a worker thread but rather holds a handle, reference, or partial state related to worker coordination. The misleading name makes the code harder to understand on first read and invites questions during review about whether it's a full clone or something else. Fix recommended: rename to a clearer name that accurately describes the value's purpose and content (e.g., 'worker_handle', 'worker_state', 'worker_coordinator', or similar, depending on its actual role). This improves readability and reduces future confusion." ;
  triage:category "Architecture" ;
  triage:severity "Minor" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady false ;
