<urn:atm:triage:finding/RBQA-AI51-F002-F003>
  a triage:Finding ;
  triage:findingId "RBQA-AI51-F002-F003" ;
  triage:title "AI.51 campaign harness: unused command_for params + report findings/payload desync" ;
  triage:description "Fresh ruthless-boundary-qa pass on feature/pAI-s51-local-http-framing-adversarial-campaign @ fb911179 (re-verified current at 82dd73bd), scoped to campaign harness/report-gen code, F001 excluded. F002: scripts/fuzz/run_local_http_framing_campaign.py command_for(test_name, seed, cases) accepts seed/cases but never uses them -- actual propagation is via ATM_AI51_SEED/CASES/CASE_START env vars set later in run_test; signature misrepresents its own contract. F003: scripts/fuzz/render_report.py -- when classification != pass and raw findings is empty, findings is synthesized via _default_finding() and used in the rendered panel, but payload (built from raw before synthesis) is never updated with it, so json_payload/copy_json show empty findings while the panel shows the synthesized one; same gap applies to test_inputs/_default_input. Both minor, test-only scope, no production-path impact." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBQA" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T20:05:00Z"^^xsd:dateTime ;
