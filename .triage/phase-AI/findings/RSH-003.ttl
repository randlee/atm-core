<urn:atm:triage:finding/RSH-003>
  a triage:Finding ;
  triage:findingId "RSH-003" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:title "sync_peer holds global peer_sync_progress lock across entire reconcile_peer network I/O, serializing cross-peer reconciliation" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs: sync_peer acquires the single peer_sync_progress Mutex<HashMap<HostName, PeerSyncProgress>> guard and holds it across the ENTIRE reconcile_peer call, which performs blocking network I/O (up to 5s per peer, per existing per-call deadline). Even though cooldown STATE is keyed per-peer, the lock SCOPE is global -- an explicit sync request for peer B can be stalled behind peer A's in-flight reconciliation, defeating the purpose of per-peer cooldown tracking. Surfaced independently by rust-service-hardening-agent at commit c326cbe7 on feature/pAI-s24-host-qualified-ack-receipt, corroborated by req-qa (confirms no test exercises genuine multi-peer concurrent independence). Related to AI24-IMPORTANT-002 (shares the same peer_sync_progress lock/PeerSyncOutcome code path) -- a fix likely narrows the lock scope to only guard the cooldown-state read/write, releasing it before the network I/O begins." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "service-hardening" ;
  triage:severity "Important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-07-27T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "2026-07-27 (quality-mgr): top-level status was stale relative to the occurrence record. Independently re-verified against integrate/phase-AI@f1ef7cfb: the old global peer_sync_progress Mutex<HashMap<HostName,PeerSyncProgress>> is gone; crates/atm-daemon/src/peer_drain_coordinator.rs::PeerDrainCoordinator now uses per-host slots (Mutex<BTreeMap<HostName, PeerDrainSlot>>). sync_peer() (line 562) calls acquire()/release() (each independently locking/unlocking the slots mutex) with self.drain(peer, deadline) -- the actual network I/O -- running in between, outside the mutex. Regression test crates/atm-daemon/src/tests/runtime_root/peer_reconciliation.rs:259 peer_sync_for_one_peer_does_not_hold_the_progress_map_during_another_delivery confirms cross-peer independence. Confirmed via direct code read, not self-report." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-003/pAI-s24/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s24/c326cbe7> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s24/c326cbe7> .

<urn:atm:triage:occurrence/RSH-003/pAI-s24/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/peer_drain_coordinator.rs" ;
  triage:line 162 ;
  triage:snippet "PeerDrainCoordinator acquires/releases per-host slot state before and after drain network I/O" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closureNote "quality-mgr: verified against integrate/phase-AI head — PeerDrainCoordinator slot acquisition/release is confined to peer_drain_coordinator.rs:162-197 and :277-345; drain network I/O runs outside the slots mutex. Regression coverage: crates/atm-daemon/src/tests/runtime_root/peer_reconciliation.rs:426-535. (2026-07-27)" ;
  triage:branch "feature/pAI-s24-host-qualified-ack-receipt" ;
  triage:headSha "c326cbe7" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-s24/c326cbe7> .

