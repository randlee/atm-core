<urn:atm:triage:occurrence/AI25-RSH-001/pAI-s25/5>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/https_transport.rs" ;
  triage:line 534 ;
  triage:snippet "resolve_peer_address now builds a resolver-only TrustedPeer and delegates to resolve_peer_addresses(&peer, HTTPS_TIMEOUT), inheriting the bounded thread+mpsc::sync_channel+recv_timeout pattern" ;
  triage:description "FIX-2 (0265c94f) closed the actual root cause: resolve_peer_address (singular, the deliver()/reconciliation hot-path resolver at line 171/runtime_health.rs:681) delegates entirely to the already-bounded resolve_peer_addresses instead of calling to_socket_addrs() unbounded. Verified via git diff a9e61fb0..b520061e on crates/atm-daemon/src/https_transport.rs; same commit also converted 4 adjacent map_err(|_source| ...) discard sites (PEM load, TcpStream::connect_timeout, ServerName::try_from, ClientConnection::new) to daemon_unavailable_with_cause, closing AI25-RBP-F001 on this branch too." ;
  triage:status "closed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s25-peer-authority-resolution" ;
  triage:headSha "0265c94f" ;
  triage:occursIn <urn:atm:triage:worktree/s25/0265c94f> .

