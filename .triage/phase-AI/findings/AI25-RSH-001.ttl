  triage:line 171 ;
  triage:snippet "let address = resolve_peer_address(&host, peer.https_port.get())?" ;
  triage:description "HttpsTransport::deliver() hot-path call site to the unbounded resolve_peer_address; also reached via reconciliation replay at runtime_health.rs:681." ;
  triage:status "closed" ;
  triage:closed true ;
