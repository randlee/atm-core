@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AI25-RSH-001>
  a triage:Finding ;
  triage:findingId "AI25-RSH-001" ;
  triage:title "Unbounded DNS resolution can stall the connection-worker pool" ;
  triage:description "crates/atm-daemon/src/https_transport.rs:495 (resolve_peer_address) calls to_socket_addrs() with no timeout, while every other stage on the same outbound path (connect/handshake/request) is explicitly bounded via HttpsRequestDeadline. A slow/unresponsive DNS server can block the calling thread indefinitely." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "AI25-RSH" ;
  triage:severity "Blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI25-RSH-001/pAI-s25/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI25-RSH-001/pAI-s25/2> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s25/b49f08407b8f5b150ae9210f64f4f34aa6beb152> ;
  triage:fixedOn <urn:atm:triage:worktree/pAI-s26/b5eec1bf> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s25/b49f08407b8f5b150ae9210f64f4f34aa6beb152> .

<urn:atm:triage:occurrence/AI25-RSH-001/pAI-s25/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/https_transport.rs" ;
  triage:line 488 ;
  triage:snippet "format!(\"{}:{}\", peer.host, peer.https_port)\n        .to_socket_addrs()" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAI-s25-peer-authority-resolution" ;
  triage:headSha "b49f08407b8f5b150ae9210f64f4f34aa6beb152" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-s25/b49f08407b8f5b150ae9210f64f4f34aa6beb152> .

