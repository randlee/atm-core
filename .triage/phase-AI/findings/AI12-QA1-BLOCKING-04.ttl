  triage:foundAt "2026-07-22T16:00:00Z"^^xsd:dateTime ;
  triage:title "No idempotency-conflict detection on duplicate ULID writes; replay with mismatched payload silently overwrites" ;
  triage:description "mirror_message_to_store (crates/atm-core/src/send/persistence.rs) calls persist_message_record unconditionally with no prior lookup/comparison against existing record for same ULID. Contradicts sprint invariant: mismatched payload for existing ULID is typed conflict -- retain original row, emit structured error log, return error, no nudge/ack/peer-delivery; never panic or overwrite. S12 added idempotency-conflict check with immutable-payload comparison and test coverage. Currently present in s20 (lines 156-170): if existing record found, verifies immutable_envelopes_match, and returns error if mismatch." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
