<urn:atm:triage:finding/AI12-QA1-BLOCKING-04>
  a triage:Finding ;
  triage:findingId "AI12-QA1-BLOCKING-04" ;
  triage:title "No idempotency-conflict detection on duplicate ULID writes; replay with mismatched payload silently overwrites" ;
  triage:description "mirror_message_to_store (crates/atm-core/src/send/persistence.rs) calls persist_message_record unconditionally with no prior lookup/comparison against existing record for same ULID. Contradicts sprint invariant: mismatched payload for existing ULID is typed conflict -- retain original row, emit structured error log, return error, no nudge/ack/peer-delivery; never panic or overwrite. S12 added idempotency-conflict check with immutable-payload comparison and test coverage." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI12-QA1-BLOCKING-04/s11/1> ;
  triage:openOn <urn:atm:triage:worktree/s11/3642430d> ;
