  a triage:Occurrence ;
  triage:file "crates/atm-daemon-client/src/lib.rs" ;
  triage:line 843 ;
  triage:snippet "command.spawn().map_err(...)?; // discards Child handle" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closureNote "quality-mgr: verified against integrate/phase-AI head (line 735-758) — Child handle is retained and reap_failed_auto_start() is called on error; defect was introduced pre-s16 and fixed in s20 by commit a8567ca4. Stale occurrence from superseded branch s16; closing to match reality. (2026-07-26)" ;
