<urn:atm:triage:finding/AI16-CI-001-DAEMON-READINESS-RACE>
  a triage:Finding ;
  triage:findingId "AI16-CI-001-DAEMON-READINESS-RACE" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T20:00:00Z"^^xsd:dateTime ;
  triage:title "Ubuntu/macOS daemon auto-start readiness race causes CI leak-check failure on s16" ;
  triage:description "PR #612 (feature/pAI-s16-offline-reconciliation), commit cd8a3638 ('AUTO_START_PUBLISH_TIMEOUT vs Python smoke-harness timeout collision' fix), did NOT clear CI. Test (ubuntu-latest) and Test (macos-latest) both fail identically with assert_no_process_leak; Test (windows-latest) passes. Root cause: spawn_daemon() discards Child handle on success; if wait_for_published_daemon() timeout is hit, client gives up but daemon keeps running -- Python harness flags as 'leaked pid'. Fix exists on s20 commit a8567ca4 which returns Child handle and reaps on timeout." ;
  triage:category "CI" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "repo" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-22T20:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI16-CI-001-DAEMON-READINESS-RACE/s16/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI16-CI-001-DAEMON-READINESS-RACE/s17/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI16-CI-001-DAEMON-READINESS-RACE/s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI16-CI-001-DAEMON-READINESS-RACE/s19/1> ;
