<urn:atm:triage:finding/AI11-QA4-COMPOSITION-RS-WINDOWS-TYPE-MISMATCH>
  a triage:Finding ;
  triage:findingId "AI11-QA4-COMPOSITION-RS-WINDOWS-TYPE-MISMATCH" ;
  triage:title "crates/atm/src/composition.rs:144 return-type mismatch on Windows: interprocess::local_socket::Stream vs std::net::TcpStream" ;
  triage:description "Discovered at AI.11 QA-4 (PR #607): probe_connection hardcodes return type as interprocess::local_socket::Stream but atm_daemon_client::try_connect resolves to std::net::TcpStream on Windows via cfg-gated type alias LocalSocketStream, creating a type mismatch. This is pre-AI.11 code that was previously unreached until AI.11 allowed compilation to progress. The same issue appears identically on all sprints AI.11 through AI.16 and must be fixed once on the earliest open branch and merge-forwarded." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
