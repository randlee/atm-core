<urn:atm:triage:finding/AI22-BLOCK-002>
  a triage:Finding ;
  triage:findingId "AI22-BLOCK-002" ;
  triage:foundAt "2026-07-25T06:42:14Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S2 ;
  triage:title "AI.22 implements AI.24's chartered same-store duplicate-receipt logic ahead of ADR-035's gate, outside its own Exact Targets" ;
  triage:description "AI.22's sprint doc explicitly disclaims implementing peer authority, TLS, DNS resolution, or the post-write router. Commit a5aa6813 nonetheless adds PreparedWrite::is_peer_receipt (send/mod.rs:305-314), is_same_host_peer_receipt forcing post_write_needed override (send/mod.rs:540,569-575), and new peer-outbound schema metadata (schema/inbox_message.rs clear_transport_delivery_metadata / set_peer_outbound_write) consumed by PostWriteRouter::dispatch (atm-daemon/src/runtime_health.rs:577-620). This is precisely the narrow same-store host-qualified duplicate-receipt mechanism that docs/plans/phase-ai/sprint-ai-24-host-qualified-ack-receipt.md Sub-task 3 explicitly charters as ITS OWN deliverable. AI.22 ships a materially weaker bare-boolean version instead, ahead of ADR-035's gate." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "scope" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:closedAt "2026-07-26T05:35:00Z"^^xsd:dateTime ;
  triage:closedBy "team-lead" ;
  triage:closureNote "Occurrence reconciliation per user-confirmed ruling 2026-07-26: canonical finding status is authoritative; stale open occurrence records on non-fix branches reflect forward-merge-pending TTL, not an independently open blocker requiring dev dispatch. No code change performed; record-accuracy correction only." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:propagated false ;
  triage:mergeForwardNeeded false ;
  triage:regressed false ;
  triage:reassignReason "Fix confirmed present on later sprint branch s24 (af2fbb83); s22/s23 occurrences remain open only because forward-merge from s24 has not landed there -- no independent re-fix dispatched, s24's fix supersedes on forward merge." ;
