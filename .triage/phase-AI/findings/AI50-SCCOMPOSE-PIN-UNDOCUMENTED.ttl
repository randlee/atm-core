<urn:atm:triage:finding/AI50-SCCOMPOSE-PIN-UNDOCUMENTED>
  a triage:Finding ;
  triage:findingId "AI50-SCCOMPOSE-PIN-UNDOCUMENTED" ;
  triage:title "CI sc-compose pin to unreleased commit contradicts documented dependency contract" ;
  triage:description "CI pins sc-compose to unreleased commit 113729e via cargo install --git --rev, with a comment claiming it is the established 1.3.0 report renderer. .claude/lib/sc_compose_dependency.py (the actual dependency-contract source of truth) still declares MIN_SC_COMPOSE=(1,2,0), and installation-and-troubleshooting.md still documents sc-compose>=1.2.0 as sufficient -- a dev following the documented install path gets a CLI that cannot render these templates. req-qa independently confirmed via sc-compose CHANGELOG that the required feature is under Unreleased, not a tagged 1.3.0 release, contradicting the CI comment characterization. Not code-breaking today, but the dependency contract and CI reality have diverged undocumented -- needs the contract doc/constant updated or the pin corrected, not just left implicit. Combines ruthless-boundary-qa RBQA-F003 and req-qa ATM-QA-201, both from AI50-QA-1 (PR #709, feature/pAI-s50-fuzz-report @ 507748ac), independently confirmed by quality-mgr." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "dependency-contract-drift" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-08-01T04:20:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "2026-08-01 (quality-mgr, AI50-QA-2): independently re-verified at feature/pAI-s50-fuzz-report@ccfb3c99 plus unanimous PASS from req-qa, arch-qa, and ruthless-boundary-qa. .claude/lib/sc_compose_dependency.py and .just/tests/test_check_dependencies.py / .claude/skills/graph-orchestration/scripts/preflight.py / .claude/skills/triaging-findings/scripts/check_dependencies.py now import MIN_SC_COMPOSE, MIN_SC_COMPOSE_BINDING, MIN_SC_COMPOSE_BINDING_TEXT, MIN_SC_COMPOSE_TEXT from the single lib.sc_compose_dependency module rather than declaring independent literals; installation-and-troubleshooting.md and CI pin reconciled to the same contract. Confirmed via direct file read, not self-report." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T03:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI50 ;
  triage:foundAt "2026-08-01T03:40:27Z"^^xsd:dateTime ;
