<urn:atm:triage:occurrence/AI32-QA1-INCOMPLETE/panic-isolation-job-slot-leak>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/peer_drain_coordinator.rs" ;
  triage:line 211 ;
  triage:snippet "Bare std::thread::spawn per job with no catch_unwind; if deliver_one panics, release_job never runs, permanently leaking (peer, message_id) slot from state.in_flight/state.active_by_host, eroding MAX_ACTIVE_PEER_JOBS until daemon restart" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedBy "quality-mgr" ;
  triage:closedAt "2026-07-28T07:20:00Z"^^xsd:dateTime ;
