<urn:atm:triage:occurrence/AI31-QA-INCOMPLETE/load-ack-source-precommit-ack-1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/ack/mod.rs" ;
  triage:line 228 ;
  triage:snippet "let source = load_ack_source(...) in resolve_acknowledgement_write - violates d5 (pre-transaction source read)" ;
  # Verified-stale closure (AI31-LAST3-STALE-VERIFY): resolve_acknowledgement_write no
  # longer exists in the codebase; execute_acknowledgement/load_pending_ack_source now
  # runs inside the writer savepoint opened by process_queued_write before ops::execute,
  # so the ACK source read is inside the atomic writer transaction and d5 is satisfied.
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedBy "quality-mgr" ;
  triage:closedAt "2026-07-28T07:45:00Z"^^xsd:dateTime ;
  triage:fixCommit "e4d5efb8" ;
  triage:branch "feature/ai31-async-local-admission" ;
  triage:headSha "d014ed6c35c8febba50aa9729528c080697df856" ;
  triage:occursIn <urn:atm:triage:worktree/feature-ai31-async-local-admission> .

