  triage:snippet "pub struct HttpsInterface { pub advertise_host: String, pub bind_port: u16 }\npub struct LocalCertificate { pub fingerprint: String, pub certificate_pem: String }\npub struct TrustedPeer { pub advertise_host: String, pub fingerprint: String, pub private_key_ref: String }" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s8-crosshost-control-plane" ;
  triage:headSha "d9991a90" ;
