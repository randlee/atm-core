<urn:atm:triage:finding/AI18-GRAFT-PYTHON-NOT-BUILDABLE>
  a triage:Finding ;
  triage:findingId "AI18-GRAFT-PYTHON-NOT-BUILDABLE" ;
  triage:title "atm-graft-python cannot be built by maturin: workspace version 1.4.0-beta-ai violates PEP 440" ;
  triage:description "atm-graft-python/Cargo.toml uses version.workspace = true, inheriting root workspace version 1.4.0-beta-ai. While valid Cargo semver, this string is invalid PEP 440, and maturin rejects it during the Python build step. pyproject.toml was fixed in commit 25bc960d, but the deeper root cause remains: Cargo and PEP 440 version grammars are incompatible. maturin reads Cargo metadata during build and fails before any Python tests run. Root cause: atm-graft-python's package version is coupled to the Rust workspace version, but the two ecosystems have incompatible version-string syntax. Discovered 2026-07-28 during exploratory Hermes harness coordination (Cipher-311d + skillrx@hermes on develop@e432a159), NOT by formal QA. AI.18's original QA-1 PASS only exercised PyO3 via cargo test (python_api.rs), never the actual maturin/pyproject build path Hermes requires. Additionally, .github/workflows/ contains zero CI legs that build atm-graft-python (no maturin build test in CI), explaining why this defect escaped unnoticed post-merge." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA-COVERAGE-GAP" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-28T02:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S18 ;
  triage:foundAt "2026-07-28T02:20:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI18-GRAFT-PYTHON-NOT-BUILDABLE/develop-e432a159-root> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI18-GRAFT-PYTHON-NOT-BUILDABLE/develop-e432a159-cargo> ;
  triage:openOn <urn:atm:triage:worktree/develop/e432a159> ;
  triage:triageRecordVersion "1" .

