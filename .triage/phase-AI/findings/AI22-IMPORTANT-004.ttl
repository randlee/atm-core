  triage:openOn <urn:atm:triage:worktree/pAI-s24/af2fbb83> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-s24/af2fbb83> .

<urn:atm:triage:occurrence/AI22-IMPORTANT-004/fix-findings-closeout/1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/address.rs" ;
  triage:line 142 ;
  triage:snippet "(None, Some(host)) => write!(f, \"<invalid-agent-address: {identity} has host {host} without team>\")," ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "fix/findings-closeout" ;
  triage:headSha "82226b4c" ;
  triage:notes "AICH-S11-QA-BATCH-1: fixed -- Display::fmt is now total, no panic path; regression test added and passing in CI." ;
  triage:occursIn <urn:atm:triage:worktree/fix-findings-closeout/82226b4c> .

