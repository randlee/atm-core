<urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s22/2>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/address.rs" ;
  triage:line 86 ;
  triage:snippet "(None, Some(_)) => Err(fmt::Error)," ;
  triage:description "Display::fmt returns Err(fmt::Error) for invalid state instead of typed error; any .to_string() or format!() call panics via .expect() in stdlib machinery" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAI-s22-loopback-self-send-exemption" ;
  triage:headSha "a5aa6813" ;
