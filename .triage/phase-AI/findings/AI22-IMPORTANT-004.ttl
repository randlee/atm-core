@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AI22-IMPORTANT-004>
  a triage:Finding ;
  triage:findingId "AI22-IMPORTANT-004" ;
  triage:foundIn triage:AICH-S2 ;
  triage:foundAt "2026-07-25T06:42:14Z"^^xsd:dateTime ;
  triage:title "AgentAddress permits invalid host-without-team state, panics via Display::fmt Err rather than surfacing typed error" ;
  triage:description "AgentAddress (crates/atm-core/src/address.rs) has all-public fields and represents an invalid combination (host present, team absent) that the type does not prevent at construction. Any caller can build AgentAddress { team: None, host: Some(_), .. } directly, bypassing FromStr's validation. Display::fmt only guards this case by returning Err(fmt::Error); blanket ToString/format! machinery calls .expect(...) on the Display::fmt result, so any code calling .to_string() or format!(\"{}\", addr) on such a value panics rather than surfacing a typed error. Verified across all open branches." ;
  triage:category "architecture" ;
  triage:severity "Important" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closedAt "2026-07-26T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "AICH-S11-QA-BATCH-1: verified fixed on commit 82226b4c (PR #651, fix/findings-closeout). Display::fmt's (None, Some(host)) arm (crates/atm-core/src/address.rs) no longer calls unreachable!()/returns Err(fmt::Error) -- it now writes a total '<invalid-agent-address: ... without team>' string. Regression test display_reports_invalid_internal_state_without_panicking added, using std::panic::catch_unwind to assert no panic and the exact rendered string. CI fully green (8/8 legs) on PR #651. Confirmed by direct code read, not self-report." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/fix-findings-closeout/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s21pre/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s21pre/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s22/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s22/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s23/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s23/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s24/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s24/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/integrate-8750587b> ;
