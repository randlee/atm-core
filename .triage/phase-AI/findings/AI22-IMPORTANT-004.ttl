<urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s21pre/1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/address.rs" ;
  triage:line 11 ;
  triage:snippet "pub struct AgentAddress { pub agent: AgentName, pub chat_id: Option<ChatId>, pub team: Option<TeamName>, pub host: Option<HostName>, }" ;
  triage:description "Struct with all-public fields permits construction of invalid state (host:Some, team:None) bypassing FromStr validation" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAI-s21pre-crosshost-evidence-harness" ;
  triage:headSha "42fbd9fa" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-s21pre/42fbd9fa> .

