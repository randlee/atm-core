  triage:hasOccurrence <urn:atm:triage:occurrence/AI22-IMPORTANT-004/pAI-s24/2> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s21pre/42fbd9fa> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s22/a5aa6813> ;
