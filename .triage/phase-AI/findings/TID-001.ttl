@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Transport Identity Defect: HostName parsing accepts loopback literals
# when they should be semantically rejected per REQ-CORE-TRANSPORT-002C / ADR-035

<urn:atm:triage:finding/TID-001>
  a triage:Finding ;
  triage:findingId "TID-001" ;
  triage:title "HostName struct and FromStr impl accept localhost/127.0.0.1/::1 without semantic rejection" ;
  triage:description "crates/atm-storage/src/types.rs — HostName struct and impl FromStr for HostName (lines 174-186) perform only syntactic validation via validate_path_segment() on DNS-name labels, accepting any valid DNS syntax including localhost literals, 127.0.0.1 (IPv4 loopback), and ::1 (IPv6 loopback). There is no semantic rejection of loopback addresses. This means atm peer interface set --advertise-host localhost or --bind 127.0.0.1 will succeed, violating REQ-CORE-TRANSPORT-002C and ADR-035's requirement that same-host proof must use the daemon's real advertised/bound TCP interface, not a loopback literal. This is a transport-identity correctness gap at the parse boundary." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "TID" ;
  triage:severity "Blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-27T14:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-PHASE-AI ;
  triage:foundAt "2026-07-27T14:25:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/TID-001/1> ;
  triage:openOn <urn:atm:triage:worktree/integrate_phase_ai_1d82ad9f> ;
  triage:promoteTo <urn:atm:triage:worktree/integrate_phase_ai_1d82ad9f> ;
  triage:highestOpenBranch "integrate/phase-AI" .

<urn:atm:triage:occurrence/TID-001/1>
  a triage:Occurrence ;
  triage:file "crates/atm-storage/src/types.rs" ;
  triage:line 174 ;
  triage:snippet "impl FromStr for HostName { fn from_str(value: &str) -> Result<Self, Self::Err> { ... for label in trimmed.split('.') { validate_path_segment(label, \"host label\")?; } Ok(Self(trimmed.to_string())) } } -- accepts localhost, 127.0.0.1, ::1 without semantic rejection" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "integrate/phase-AI" ;
  triage:headSha "1d82ad9f" ;
  triage:occursIn <urn:atm:triage:worktree/integrate_phase_ai_1d82ad9f> .

<urn:atm:triage:worktree/integrate_phase_ai_1d82ad9f>
  a triage:WorktreeSnapshot ;
  triage:path "integrate/phase-AI" ;
  triage:branch "integrate/phase-AI" ;
  triage:headSha "1d82ad9f" ;
  triage:orderIndex 999 .

# ============================================================================
# CORRECTION APPLIED 2026-07-27 (team-lead requirement verification)
# ============================================================================
# The initial finding was factually incorrect. The recommendation to reject
# localhost/127.0.0.1 at parse time contradicts the explicit acceptance
# criterion in sprint-ai-22 (line 143-144).
#
# WHAT WAS WRONG:
# - Original claim: "HostName struct performs only syntactic validation ...
#   accepting any valid DNS syntax including localhost literals, 127.0.0.1
#   (IPv4 loopback), and ::1 (IPv6 loopback). There is no semantic rejection
#   of loopback addresses." — this is treated as a defect.
# - ROOT CAUSE: Misreading of REQ-CORE-TRANSPORT-002C and AI.22 requirements.
#   The finding assumed loopback must be rejected at parse time.
#
# CORRECTED REQUIREMENT (sprint-ai-22, lines 143-144):
# "`localhost` and `127.0.0.1` are parsing/host-preservation regressions only;
# they may not be used to satisfy the virtual-Ethernet same-host proof."
#
# INTERPRETATION:
# - "parsing/host-preservation regressions" = must parse successfully
# - Required test coverage: self-send exemption tests, host-preservation
#   regression tests per AI.22 (see sprint doc at line 20-22)
# - "may not be used to satisfy" = downstream enforcement concern
#   (evidence validation does not accept loopback-sourced proof), not a
#   parse-time rejection concern
# - Parsing localhost/127.0.0.1 is REQUIRED behavior, not a defect
#
# ACTUAL STATUS:
# - HostName::from_str correctly accepts syntactically valid loopback
#   literals per AI.22 acceptance criteria
# - The original "semantic rejection" recommendation is INVALID and superseded
# - No parse-time code change needed
# - Downstream evidence-validation enforcement (that loopback cannot satisfy
#   the real same-host proof) is already in scope for AI.22 QA
#
# CONCLUSION:
# - This finding was purely misdirected; no code defect exists at the
#   parse boundary
# - Closing finding as WAIVED per AI.22 requirement clarification
# ============================================================================

<urn:atm:triage:finding/TID-001>
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:correctionNote "Finding superseded by sprint-ai-22 acceptance criterion (line 143-144): 'localhost' and '127.0.0.1' are parsing/host-preservation regressions only; they may not be used to satisfy the virtual-Ethernet same-host proof. Parsing/accepting loopback literals is REQUIRED for test coverage, not a code defect. The original recommendation to reject at parse time contradicts the explicit requirement that parsing must succeed. Downstream enforcement (ensuring loopback-sourced evidence cannot satisfy real proof) is covered by AI.22 QA scope." ;
  triage:waiverReason "Misdirected finding based on misreading of AI.22 requirement. Parse-time acceptance is required behavior." ;
  triage:correctionAppliedAt "2026-07-27T15:00:00Z"^^xsd:dateTime ;
  triage:correctionAppliedBy "team-lead (requirement verification)" ;
  triage:referencedSprintRequirement "sprint-ai-22-loopback-self-send-exemption.md lines 143-144" .
