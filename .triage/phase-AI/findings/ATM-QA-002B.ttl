  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-002B/integrate-8750587b> ;
  triage:triageRecordVersion "1" .

# Acceptance-gap occurrence on s23: test uses localhost/127.0.0.1 instead of non-loopback interface
<urn:atm:triage:occurrence/ATM-QA-002B/s23-1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/https_transport.rs" ;
  triage:line 1089 ;
  triage:snippet "fn advertised_ip_peer_write_uses_real_dispatcher_persists_and_nudges() { ... TrustedPeer { host: \"localhost\", tls_root_cert: ... bind(\"127.0.0.1:0\") ... } // Uses loopback interface, not distinct advertised-IP" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAI-s23-crosshost-shared-write-path" ;
  triage:headSha "985a6d46" ;
  triage:note "Req-qa acceptance-gap: test satisfies real dispatcher/persistence/nudge evidence requirement but does not target a genuinely non-loopback advertised IP as explicitly required by sprint doc lines 215-219. TrustedPeer.host = 'localhost', binds to 127.0.0.1:0 (loopback). Sprint doc requires 'configured virtual-Ethernet / advertised IP not localhost 127.0.0.1'. Correction options: (1) add test variant with distinct non-loopback interface, or (2) amend sprint doc acceptance wording to explicitly accept localhost when verified via real dispatcher path." ;
  triage:occursIn <urn:atm:triage:worktree/s23/985a6d46> .

