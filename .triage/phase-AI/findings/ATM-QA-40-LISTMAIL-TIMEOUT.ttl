<urn:atm:triage:finding/ATM-QA-40-LISTMAIL-TIMEOUT>
  a triage:Finding ;
  triage:findingId "ATM-QA-40-LISTMAIL-TIMEOUT" ;
  triage:title "Public list_mail API times out at scale due to full-mailbox load before bucket counting" ;
  triage:description "Standalone product defect, explicitly OUT OF SCOPE for AI.40's own sprint gate. AI.40's benchmark runner (scripts/smoke/run_admission_capacity.py, verify_durable_admissions() around lines 662-690) documents that the public list_mail API cannot be used for durability verification at benchmark scale because it loads the full mailbox before bucket-counting results, timing out under the daemon's fixed 3-second read deadline at approximately 500k rows. This is a genuine product defect in the list_mail command path, discovered as a side effect of AI.40 QA, not introduced by or in scope for AI.40's sprint deliverables. team-lead approved a narrow workaround (direct read-only SQLite row-count check) for AI.40's own benchmark durability verification specifically because of this defect, but the underlying list_mail defect itself remains unfixed and unowned. Do not close/waive/fix this as part of AI.40; it needs its own dedicated remediation sprint or fix dispatch." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "product-defect" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T07:10:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI40 ;
  triage:foundAt "2026-08-01T07:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-40-LISTMAIL-TIMEOUT/S40-1> ;
  triage:triageRecordVersion "1" .

