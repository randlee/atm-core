<urn:atm:triage:finding/FTQ-001>
  a triage:Finding ;
  triage:findingId "FTQ-001" ;
  triage:title "test_teardown_never_deletes_runtime_without_matching_pid_marker leaks unreaped child process" ;
  triage:description ".just/tests/test_peer_pair_smoke.py::test_teardown_never_deletes_runtime_without_matching_pid_marker spawns a real 30s child process with no try/finally or addCleanup -- leaks an un-reaped process on every run (assertion requires the process to survive, so it's intentional-but-unmanaged). Flaky-CI risk on parallel/repeat runs." ;
