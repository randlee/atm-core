<urn:atm:triage:finding/AI38-QA1-REQ-GRAFT-CONFLICT>
  a triage:Finding ;
  triage:findingId "AI38-QA1-REQ-GRAFT-CONFLICT" ;
  triage:title "Cross-document contradiction: REQ-CORE-GRAFT-001 active vs. retired" ;
  triage:description "docs/requirements.md (lines 4076-4094) lists REQ-CORE-GRAFT-001 as an active Governing Requirement defining 'Graft is a thin embedded daemon client and bounded host-wake transport, not a second mailbox or host conversation subsystem.' However, docs/atm-core/requirements.md (lines 190-196) explicitly states 'historical REQ-CORE-GRAFT-001 is retired by the Phase U graft restack' and superseded by REQ-CORE-TRANSPORT-001 and REQ-CORE-TRANSPORT-002. Sprint docs for AI.36, AI.37, and AI.38 all cite REQ-CORE-GRAFT-001 as a Governing Requirement, treating it as active guidance. These two requirement documents directly contradict each other on whether REQ-CORE-GRAFT-001 is active guidance or a retired historical marker. Resolution required: either update docs/requirements.md to remove 'retired' language if the requirement remains active, or update docs/atm-core/requirements.md and affected sprint docs (AI.36, AI.37, AI.38) to cite REQ-CORE-TRANSPORT-001/002 instead of REQ-CORE-GRAFT-001." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "cross-doc-conflict" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-29T16:32:10Z"^^xsd:dateTime ;
  triage:foundIn triage:AI-S38 ;
  triage:foundAt "2026-07-29T12:00:00Z"^^xsd:dateTime ;
