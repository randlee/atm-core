<urn:atm:triage:finding/AI33-M5-CONNECTION-CAP-SUSPECT>
  a triage:Finding ;
  triage:findingId "AI33-M5-CONNECTION-CAP-SUSPECT" ;
  triage:title "503 admission rejection under 1,000 req/s — 64 local connection/dispatch-handle caps are suspects, not yet proven" ;
  triage:description "The real M5 benchmark showed mass HTTP 503 rejection (only 3-21/1000 admissions accepted per one-second interval across all 20 intervals, ~168.85 accepted/s vs required >=1000/s). arch-ctm's investigation flags hard-coded 64 local connection/dispatch-handle caps in the daemon admission path as the leading suspect for the throughput ceiling, but this is NOT yet proven — the preserved daemon log contains zero saturation/capacity/lifecycle-wedge records, so the actual cause requires further investigation once AI33-M5-RESPONSE-BODY-DISCARDED's harness repair (capturing rejection body/structured server rejection record) lands. Root-cause daemon-side investigation itself remains out of scope for this triage record; this finding tracks the suspicion/hypothesis for follow-up." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
