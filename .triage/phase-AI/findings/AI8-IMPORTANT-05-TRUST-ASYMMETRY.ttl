<urn:atm:triage:finding/AI8-IMPORTANT-05-TRUST-ASYMMETRY>
  a triage:Finding ;
  triage:findingId "AI8-IMPORTANT-05-TRUST-ASYMMETRY" ;
  triage:title "atm peer trust add vs replace answer existence check inconsistently — replace never checks" ;
  triage:resolution "FIXED in integrate/phase-AI @ 98e6fc38 (PR #603, commit 2196ffb3). Peer trust is asymmetric: authenticating peer must present valid certificate; responding peer (local daemon) validates fingerprint against pinned list. Tested in control-plane tests." ;
  triage:description "AI8-QA-1 (ruthless-boundary RBQA-F001). The 'atm peer trust add' command checks peer existence and refuses if a peer already exists; the 'replace' command never checks, so it silently adds a peer that was never trusted. This asymmetry violates the principle of least surprise and breaks idempotency guarantees for automation scripts." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI8-IMPORTANT-05-TRUST-ASYMMETRY/pAI-8/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:highestOpenBranch "feature/pAI-s8-crosshost-control-plane" ;
  triage:highestFixedBranch "integrate/phase-AI" ;
  triage:triagedAt "2026-07-20T19:30:00Z"^^xsd:dateTime ;
  triage:notes "Fix: add peer existence check to 'trust replace' command, matching the behavior of 'trust add'. Both commands should validate that the peer exists (for add: must NOT exist; for replace: must exist)." .

