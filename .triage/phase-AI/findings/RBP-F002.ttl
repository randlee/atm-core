<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "python_callback_error() collapses Python callback failures into InternalError without AtmError::with_cause() (RBP-001)" ;
  triage:description "crates/atm-graft-python/src/lib.rs lines 55-60 define `fn python_callback_error(error: PyErr) -> AtmError` which builds `AtmError::new(AtmErrorCode::InternalError, format!(\"Python graft nudge callback failed: {error}\"))`, folding the original PyErr into the message string only. RBP-001 requires structured error causes to be preserved via AtmError::with_cause() rather than collapsed into the display message, so the original error is queryable/structured rather than only human-readable text. Recommend using `.with_cause(error.to_string())` (or equivalent structured cause) on the constructed AtmError." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "best-practices" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:closed false ;
  triage:dispatchReady true ;
  triage:blockingCurrentMerge false ;
  triage:note "RBP-001: use AtmError::with_cause() in python_callback_error() to preserve the structured PyErr cause instead of only interpolating it into the message string." ;
  triage:foundIn triage:AI37-QA-1 ;
  triage:foundAt "2026-07-29T06:10:00Z"^^xsd:dateTime ;
  triage:triagedAt "2026-07-29T07:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/python-callback-error> ;
  triage:openOn <urn:atm:triage:worktree/phase-AI/feature-pAI-s37-hermes-recovery-summary> ;
  triage:highestOpenBranch "feature/pAI-s37-hermes-recovery-summary" ;
  triage:triageRecordVersion "1" .

