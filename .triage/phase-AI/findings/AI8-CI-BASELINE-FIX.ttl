<urn:atm:triage:finding/AI8-CI-BASELINE-FIX>
  a triage:Finding ;
  triage:findingId "AI8-CI-BASELINE-FIX" ;
  triage:title "OpenAPI surface baseline test: intentional CLI route removals require reviewed-removals allowlist" ;
  triage:description "The openapi_surface_is_additions_only test enforces that the OpenAPI surface is additions-only (no deletions). During phase-AI, three routes were intentionally removed as a cleanup deliverable: /team/{teamName}, /teams, and Team schema. The test was updated to accept a reviewed-removals allowlist at crates/atm/tests/openapi_surface_reviewed_removals.json that lists exactly three approved removal entries. The review notes 'AI-FIXROUND-5 retired Teams-route removal, quality-mgr verified.' This was dispatched as a direct CI-red exception outside normal triage flow because CI was red everywhere on the same root cause (shared surface baseline)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:reviewedBy "qa-triage" ;
  triage:triagedAt "2026-07-20T22:10:37-07:00"^^xsd:dateTime ;
  triage:resolvedAt "2026-07-20T22:10:37-07:00"^^xsd:dateTime ;
  triage:resolutionNotes "Fixed at commit f2e45e08 on feature/pAI-s8-crosshost-control-plane, merged forward through AI9 and AI10, now on integrate/phase-AI @ b2a76894. This fix was dispatched as a direct CI-red exception outside normal triage flow because it was a shared infrastructure blocker affecting all active branches. Evidence: crates/atm/tests/openapi_surface_reviewed_removals.json contains exactly 3 approved removals: 'openapi/paths//team/{teamName}', 'openapi/paths//teams', 'openapi/schemas/Team'. Review field documents: 'AI-FIXROUND-5 retired Teams-route removal, quality-mgr verified.' Test updated to read the allowlist and skip assertion for listed removals. Independently QA-verified." ;
  triage:verificationCommit "f2e45e08277d7fd8ee4e23efb2baa9d5ad58161f" ;
  triage:verificationBranch "integrate/phase-AI" ;
  triage:verificationHeadSha "b2a76894" ;
  triage:dispatchNotes "Dispatched as CI-red exception (direct, parallel fix, not through normal triage flow) due to shared infrastructure blocking all active branches. Committed directly as hotfix, then merge-forwarded to AI9 and AI10. Not a code architecture issue; pure CI infrastructure gating update." .

