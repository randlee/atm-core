<urn:atm:triage:occurrence/AI11-BLOCKING-02/pAI-11/2>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/api.rs" ;
  triage:line 264 ;
  triage:snippet "fn matches_route(&self, method: &str, path: &str) -> bool { ... Self::Messages(_) => method == \"GET\" && path == \"/v1/atm/messages\", ... }" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closureNote "quality-mgr: verified against integrate/phase-AI head -- finding premise was incorrect. /message/{messageId} and /message/{messageId}/read routes are LISTED in crates/atm/tests/openapi_surface_reviewed_removals.json as intentionally reviewed and removed endpoints, not undocumented gaps. The old matches_route function no longer exists (code refactored to route_kind_for_http at line 175). This finding predates the intentional route removal review. Closing as mischaracterized. (2026-07-26)" ;
  triage:branch "integrate/phase-AI" ;
  triage:headSha "8d0ccf01" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-integrate/8d0ccf01> .

