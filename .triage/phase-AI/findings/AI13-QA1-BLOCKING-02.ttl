<urn:atm:triage:finding/AI13-QA1-BLOCKING-02>
  a triage:Finding ;
  triage:findingId "AI13-QA1-BLOCKING-02" ;
  triage:title "No per-case semantic verification in scripts/smoke/run_peer_pair.py — every required case is reduced to a generic exit-code/substring check on an opaque, externally-supplied command" ;
  triage:description "The 9 REQUIRED_CASES (lines ~24-34) are enforced only for presence/ordering by validate(); execute()'s case loop (~lines 210-239) runs every case through the identical path: passed = result[\"exit_code\"] == 0 for expect=\"success\", or exit_code != 0 and typed_error_code in (stdout+stderr) for expect=\"typed_error\". None of the doc's stated semantic obligations are checked in code: duplicate_ulid must prove the receiver retains exactly one record and emits no second nudge/ack-mutation/peer-send; failed_remote_ack must prove no ack-state mutation occurred. Both are asserted only in doc prose, never in the runner. This file is new to AI.13 (scripts/smoke/run_peer_pair.py)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "BLOCKING" ;
  triage:repeatable true ;
  triage:sweepScope "repo" ;
  triage:status "open" ;
  triage:dispatchReady true ;
