<urn:atm:triage:finding/AI14-QA1-RBP-RECOVERYPATH>
  a triage:Finding ;
  triage:findingId "AI14-QA1-RBP-RECOVERYPATH" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "local_http.rs reuses DaemonUnavailable error for capability revocation (wrong recovery path)" ;
  triage:description "rust-best-practices-agent (RBP): crates/atm-core/src/local_http.rs reuses the DaemonUnavailable error variant to signal capability revocation, which is a distinct failure mode from daemon-unreachable and implies the wrong caller recovery path (retry/backoff vs re-authenticate/re-register). Important, non-blocking." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA1" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/local_http.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI14-QA1-RBP-RECOVERYPATH/pAI-s11/1> ;
