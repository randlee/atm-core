  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T20:35:00Z"^^xsd:dateTime ;
  triage:title "failed_remote_ack check is a static attribute check, not a mutation detector" ;
  triage:description "In scripts/smoke/run_peer_pair.py's new semantic-verification mechanism (added on feature/pAI-s15-windows-peer-smoke, commit 12f4b96e), the failed_remote_ack check inspects a static requires_ack attribute rather than detecting an actual ack-state mutation. It cannot detect whether an ack mutation genuinely occurred or failed to occur." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "ATM-QA-001" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
