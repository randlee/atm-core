<urn:atm:triage:finding/AI33-M5-RESPONSE-BODY-DISCARDED>
  a triage:Finding ;
  triage:findingId "AI33-M5-RESPONSE-BODY-DISCARDED" ;
  triage:title "Admission-capacity runner discards non-201 HTTP response body/ATM error code" ;
  triage:description "arch-ctm's real M5 live admission-capacity benchmark run (scripts/smoke/run_admission_capacity.py, evidence file admission-capacity-20260730T005237Z.json under ~/Documents/github/atm-core-worktrees/feature/pAI-s33-admission-capacity-smoke-m5/artifacts/smoke/admission-capacity/) recorded mass HTTP 503 rejections (only 3-21/1000 accepted per interval across all 20 intervals) but the runner only captures HTTP status lines and discards the response body/ATM error code on non-201 responses. This means the root cause of the 503s cannot be established from current evidence — the preserved daemon log shows zero saturation/capacity/lifecycle-wedge records, only expected response-write disconnects. Required repair per arch-ctm: retain bounded response body/error code for the first non-201 response per interval and emit/query a structured server rejection record, before any production root-cause ruling can be made." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
