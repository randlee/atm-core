<urn:atm:triage:finding/LISTMAIL-BUCKETCOUNT-FALLBACK-TRUNCATION>
  a triage:Finding ;
  triage:findingId "LISTMAIL-BUCKETCOUNT-FALLBACK-TRUNCATION" ;
  triage:title "Bucket-count fallback silently truncates when mailbox_bucket_counts is None" ;
  triage:description "list_mail_with_runtime_impl (crates/atm-core/src/list.rs:152-168) computes metadata_limit via metadata_limit_for_list(&query) and bounds metadata_rows to it unconditionally, regardless of whether storage_bucket_counts (runtime.query_mailbox_bucket_counts, line 152) returned Some or None. When None -- the trait default for both MessageStore::mailbox_bucket_counts (atm-storage/src/contract.rs:537-543) and RetainedMailboxRuntime::query_mailbox_bucket_counts (atm-core/src/service_runtime_store.rs:104-110) -- the code falls back to bucket_counts_for(&logical_current) at line 168, where logical_current derives from the already-truncated metadata_rows. This silently produces wrong unread/pending_ack/history counts and a wrong history_collapsed flag (line 191) for any backend that hasn't implemented the SQL aggregate. Confirmed hit today: crates/atm-storage-sqlserver-proof/src/lib.rs:31 implements MessageStore without overriding mailbox_bucket_counts, so it hits the None path. Only atm-storage-rusqlite's SqliteMessageStore (lib.rs:468) implements the aggregate. Not repeated elsewhere -- crates/atm-core/src/read/mod.rs computes bucket_counts_for from the full untruncated set." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/list.rs only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T14:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S11 ;
  triage:foundAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/LISTMAIL-BUCKETCOUNT-FALLBACK-TRUNCATION/fix-list-mail-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/LISTMAIL-BUCKETCOUNT-FALLBACK-TRUNCATION/fix-list-mail-1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/list.rs" ;
  triage:line 162 ;
  triage:snippet ".unwrap_or_else(|| bucket_counts_for(&logical_current))" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "fix/list-mail-bounded-read" ;
  triage:headSha "824414979ba043dfd3a9dfaa241bfa9ee8174b66" ;
  triage:occursIn <urn:atm:triage:worktree/fix-list-mail-1> .

