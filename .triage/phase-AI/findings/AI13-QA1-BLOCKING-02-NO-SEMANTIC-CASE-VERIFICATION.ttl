<urn:atm:triage:finding/AI13-QA1-BLOCKING-02-NO-SEMANTIC-CASE-VERIFICATION>
  a triage:Finding ;
  triage:findingId "AI13-QA1-BLOCKING-02-NO-SEMANTIC-CASE-VERIFICATION" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "No per-case semantic verification beyond exit-code/substring" ;
  triage:description "In scripts/smoke/run_peer_pair.py, duplicate_ulid and failed_remote_ack cases never assert the actual invariants the sprint doc claims (single-record retention, no ack mutation) — only external command exit codes/substrings are checked. Shallow verification also present in run_thorough_shared_host.py and run_graft_same_host.py" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:phaseId "phase-AI" ;
