<urn:atm:triage:finding/RBP-F001-AI36>
  a triage:Finding ;
  triage:findingId "RBP-F001-AI36" ;
  triage:title "crates/atm-core/src/graft.rs discards underlying I/O/serde error source in map_err(|_source| ...) sites" ;
  triage:description "19 map_err(|_source| ...) sites in graft.rs discard error sources instead of threading via .with_cause(), losing root-cause diagnostics (permission denied vs disk full vs corrupt JSON) for socket/file/serde operations." ;
