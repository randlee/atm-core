  triage:snippet "with mock.patch.object(RUNNER.os, \"name\", \"posix\"): self.assertEqual(RUNNER.validate_transport(\"uds\"), \"uds\") -- now platform-guarded, matches AI.49 fix pattern" ;
  triage:status "fixed" ;
