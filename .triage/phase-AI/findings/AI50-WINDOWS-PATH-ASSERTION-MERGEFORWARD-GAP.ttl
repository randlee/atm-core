<urn:atm:triage:finding/AI50-WINDOWS-PATH-ASSERTION-MERGEFORWARD-GAP>
  a triage:Finding ;
  triage:findingId "AI50-WINDOWS-PATH-ASSERTION-MERGEFORWARD-GAP" ;
  triage:title "Windows path assertion regression on feature/pAI-s50-fuzz-report (merge-forward gap from AI.49 fix)" ;
  triage:description "PR #709 (branch feature/pAI-s50-fuzz-report, worktree head ccfb3c99) shows Windows Just lint failing on the same two test cases as the related finding AI49-WINDOWS-PATH-ASSERTION-REGRESSION: test_transport_is_platform_explicit calls RUNNER.validate_transport(\"uds\") at line 46 without mocking RUNNER.os.name to \"posix\", causing it to fail on a real Windows runner. The identical issue was fixed on feature/pAI-s49-benchmark-report@8b78775c by wrapping validate_transport(\"uds\") in mock.patch.object(RUNNER.os, \"name\", \"posix\"). feature/pAI-s50-fuzz-report forked before that AI.49 fix landed and has not merge-forwarded it, resulting in this identical regression appearing independently. This is a merge-forward propagation gap, not a new independent defect." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "windows-portability" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-08-01T04:35:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "AI50-QA-3: Cipher-311d merged origin/integrate/phase-ai-31-33 into feature/pAI-s50-fuzz-report (commit 4bf711cf), bringing in the AI.49 fix (feature/pAI-s49-benchmark-report@8b78775c). Independently re-verified: scripts/smoke/test_run_admission_capacity.py lines 45-53 now wrap RUNNER.validate_transport(\"uds\") in mock.patch.object(RUNNER.os, \"name\", \"posix\") and the Windows-rejection branch in mock.patch.object(RUNNER.os, \"name\", \"nt\"), byte-identical to the accepted AI.49/AI.33 reference fix. Confirmed unanimously by three independent reviewers: req-qa (deliverable_completion 100%, status present/closed), arch-qa (verdict PASS, merge_ready true, gate_artifact_checks status closed), and ruthless-boundary-qa (status pass, disposition fixed). All 8 PR #709 CI legs green (ubuntu/macos/windows Test, Clippy, ubuntu/macos/windows Just lint, Format check) as of the rerun on head 4bf711cf." ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-01T04:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI50 ;
  triage:foundAt "2026-08-01T04:05:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI50-WINDOWS-PATH-ASSERTION-MERGEFORWARD-GAP/1> ;
  triage:relatedFinding "AI49-WINDOWS-PATH-ASSERTION-REGRESSION" ;
  triage:rootCause "merge-forward gap: s50 forked before s49 fix, did not merge-forward; fixed by Cipher-311d's merge-forward of integrate/phase-ai-31-33 (commit 4bf711cf)" ;
  triage:triageRecordVersion "2" .

