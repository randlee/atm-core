<urn:atm:triage:finding/AI28-RSH-004>
  a triage:Finding ;
  triage:findingId "AI28-RSH-004" ;
  triage:title "Only transport call deadline-checked in drain(), not DB read" ;
  triage:description "The drain() function in peer_drain_coordinator.rs enforces a deadline (or timeout) for the network transport call when delivering messages to a peer, but does not enforce the same deadline on the prior database read that fetches the messages to deliver. In a scenario where the database is slow or overloaded, the DB read can consume the entire operation timeout without the coordinator knowing, leaving no time for the actual delivery attempt. This creates an asymmetry in deadline enforcement and reduces the reliability of the paging/delivery loop under database contention. The issue is not critical (most deliveries succeed quickly), but it's a hardening gap that should be closed. Fix recommended: apply deadline checks to the database read operation in the same way as the transport call, ensuring that both components are bounded. This might involve passing a deadline context to the database layer or explicitly checking elapsed time after the DB read completes." ;
  triage:category "Service-Hardening" ;
  triage:severity "Minor" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady false ;
