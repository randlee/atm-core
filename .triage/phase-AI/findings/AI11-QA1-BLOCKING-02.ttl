  a triage:Finding ;
  triage:findingId "AI11-QA1-BLOCKING-02" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-21T00:00:00Z"^^xsd:dateTime ;
  triage:title "No Windows ACL restriction on local-http.json capability file" ;
  triage:description "publish_record (crates/atm-daemon/src/local_tcp_transport.rs:383-388) gates owner-only permission restriction #[cfg(unix)] (0o600) only. No ACL-restriction code exists anywhere in the diff for Windows (grep for ACL/SetNamedSecurityInfo/windows-sys in local_tcp_transport.rs/local_http.rs -- zero hits). The bearer capability secret is left at default inherited ACLs on Windows, contradicting the sprint doc's 'owner-only filesystem/Windows ACL permissions' requirement and the boundary contract's 'local-http.json is owner-readable only.'" ;
  triage:triageMode "initial_pass" ;
  triage:category "AI" ;
  triage:phaseId "phase-AI" ;
