<urn:atm:triage:finding/AI3152TOOLING-BUILDRE-SUBCOMMAND-MATCH>
  a triage:Finding ;
  triage:findingId "AI3152TOOLING-BUILDRE-SUBCOMMAND-MATCH" ;
  triage:title "DAEMON_BUILD_RE trailing \\b boundary also matches build-* subcommands" ;
  triage:description "DAEMON_BUILD_RE's trailing \\b fires at hyphen boundaries as well as whitespace, so it also matches unrelated cargo subcommands like \"cargo build-info\" as if they were a daemon build. Reproduced directly by req-qa via re.search(r\"\\bcargo\\s+build\\b\", \"cargo build-info\") -> match, during QA-3 review of commit 4c867d69. This is a regex false-positive class of bug — the daemon-build classifier used by the signing-hook lint incorrectly flags non-build subcommands." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
