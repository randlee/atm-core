<urn:atm:triage:finding/AI52-HOSTLABEL-001>
  a triage:Finding ;
  triage:findingId "AI52-HOSTLABEL-001" ;
  triage:title "AI.52 host label embeds literal real hostname, violating ADR-044 opaque-host_label requirement" ;
  triage:description "arch-qa (via quality-mgr's AI52-PLAN-QA-1 report) found that Deliverable 3's 'windows-fastpc4' host label in sprint-ai-52-windows-transport-benchmark-confirmation.md (lines 27/44) and project-plan.md:1019 embeds the literal real hostname, violating ADR-044's opaque host_label requirement (docs/architecture.md:96-97) and diverging from AI.40's own precedent label 'mac-arm64-01' (platform/arch-derived, not literal). Fix: rename to an opaque label such as windows-x64-01 or windows-arm64-01, consistently across all occurrences." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "docs-consistency" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "docs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-31T21:35:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI52 ;
  triage:foundAt "2026-07-31T21:31:22Z"^^xsd:dateTime ;
