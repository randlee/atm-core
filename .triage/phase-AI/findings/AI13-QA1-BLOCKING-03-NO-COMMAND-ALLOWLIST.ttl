<urn:atm:triage:finding/AI13-QA1-BLOCKING-03-NO-COMMAND-ALLOWLIST>
  a triage:Finding ;
  triage:findingId "AI13-QA1-BLOCKING-03-NO-COMMAND-ALLOWLIST" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "No mechanical allowlist of approved command entrypoints — raw socket success is never a passing case is a doc-only claim" ;
  triage:description "In scripts/smoke/run_peer_pair.py, nothing enforces an allowlist on case[\"command\"][0], so a raw-socket-probe script could pass as a required case. \"Public CLI/graft-client only, no private storage helpers\" is documented only in docs/peer-pair-smoke.md:51, not mechanically enforced. Source: quality-mgr QA-1 verdict on PR #609, /Users/randlee/.config/atm/share/atm-dev/qa-ai13-qa1-verdict.md." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
