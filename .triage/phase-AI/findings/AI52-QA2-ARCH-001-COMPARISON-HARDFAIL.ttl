<urn:atm:triage:finding/AI52-QA2-ARCH-001-COMPARISON-HARDFAIL>
  a triage:Finding ;
  triage:findingId "AI52-QA2-ARCH-001-COMPARISON-HARDFAIL" ;
  triage:title "matching_profile_reference() called unconditionally, hard-fails before comparison_required is honored" ;
  triage:description "scripts/smoke/run_admission_capacity.py:924 calls matching_profile_reference() unconditionally, pre-empting/duplicating the canonical advisory-comparison logic in evaluate_profile_thresholds() (scripts/smoke/benchmark_policy.py:18-49). This causes Windows TCP profiles to hard-fail before any evidence is generated when no complete ancestor UDS comparison set exists, defeating the sprint's intended comparison_required=False advisory-only semantics for Windows runs." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "arch-qa" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-01T23:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI-52 ;
  triage:foundAt "2026-08-01T23:30:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-02T00:15:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:progressNote "AI52-QA-3 (commit 84b9727e): arch-qa independently confirmed the matching_profile_reference() call (now ~line 930) is wrapped in try/except SmokeError, re-raising only when comparison_required is True. comparison_required = os.name != 'nt' (line 928), so False on Windows. Confirmed evaluate_profile_thresholds() in benchmark_policy.py (lines 46-48) computes passed = admission_passed and baseline_passed and (comparison_passed if comparison_required else True) -- admission_passed is never bypassed by the comparison gate. Direct test coverage verified at scripts/smoke/test_run_admission_capacity.py:323-359 (test_main_allows_windows_tcp_without_a_comparison_reference) and :279-287 (test_windows_comparison_is_reported_without_gating_windows_acceptance). Confirmed fixed." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI52-QA2-ARCH-001-COMPARISON-HARDFAIL/run-admission-capacity> ;
  triage:triageRecordVersion "2" .

