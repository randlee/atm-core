<urn:atm:triage:finding/AI52-QA2-ARCH-001-COMPARISON-HARDFAIL>
  a triage:Finding ;
  triage:findingId "AI52-QA2-ARCH-001-COMPARISON-HARDFAIL" ;
  triage:title "matching_profile_reference() called unconditionally, hard-fails before comparison_required is honored" ;
  triage:description "scripts/smoke/run_admission_capacity.py:924 calls matching_profile_reference() unconditionally, pre-empting/duplicating the canonical advisory-comparison logic in evaluate_profile_thresholds() (scripts/smoke/benchmark_policy.py:18-49). This causes Windows TCP profiles to hard-fail before any evidence is generated when no complete ancestor UDS comparison set exists, defeating the sprint's intended comparison_required=False advisory-only semantics for Windows runs." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "arch-qa" ;
  triage:severity "blocking" ;
