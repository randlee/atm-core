  a triage:Occurrence ;
  triage:file "crates/atm-architecture/tests/boundary_enforcement.rs" ;
  triage:line 83 ;
  triage:snippet "fn canonical_write_router_has_one_host_routing_decision() { ... for path in canonical_write_modules(&root) ... visitor.source_path is checked only via is_runtime_dispatcher_source()" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAI-s12-post-write-router" ;
