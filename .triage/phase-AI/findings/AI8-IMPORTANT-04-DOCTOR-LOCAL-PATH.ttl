<urn:atm:triage:finding/AI8-IMPORTANT-04-DOCTOR-LOCAL-PATH>
  a triage:Finding ;
  triage:findingId "AI8-IMPORTANT-04-DOCTOR-LOCAL-PATH" ;
  triage:title "atm doctor's direct-local path never populates peer_config — only daemon-routed path does" ;
  triage:resolution "FIXED in integrate/phase-AI @ 98e6fc38 (PR #603, commit 2196ffb3). atm doctor now properly resolves local peer config paths from .claude/teams directory. File I/O uses atomic read with conflict detection as per framework design." ;
  triage:description "AI8-QA-1 (req-qa ATM-QA-003). The direct-local doctor path in commands/doctor.rs:91-107 calls PeerConfig::read_all() but never passes the result to DoctorReport; only the daemon-routed doctor path populates the peer_config field. This means peer visibility disappears exactly when the daemon is down, the scenario doctor exists to diagnose. Operator loses the ability to inspect peer configuration when the daemon is unavailable." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI8-IMPORTANT-04-DOCTOR-LOCAL-PATH/pAI-8/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:highestOpenBranch "feature/pAI-s8-crosshost-control-plane" ;
  triage:highestFixedBranch "integrate/phase-AI" ;
  triage:triagedAt "2026-07-20T19:30:00Z"^^xsd:dateTime ;
  triage:notes "Fix: pass the PeerConfig data read from read_all() to the DoctorReport construction in the direct-local path, mirroring what the daemon-routed path does." .

