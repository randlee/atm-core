<urn:atm:triage:finding/AI23-IMPORTANT-006>
  a triage:Finding ;
  triage:findingId "AI23-IMPORTANT-006" ;
  triage:foundAt "2026-07-25T18:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S9 ;
  triage:title "PostWriteRouter::dispatch re-derives peer-receipt status via ad-hoc inline check instead of calling canonical is_peer_receipt() accessor" ;
  triage:description "crates/atm-daemon/src/runtime_health/peer_delivery_router.rs:20 implements an ad-hoc inline check (if message.outbound_request.authenticated_source_host.is_some() { ... }) to determine whether a message is a peer receipt, instead of calling the canonical PreparedWrite::is_peer_receipt() accessor defined at crates/atm-core/src/send/mod.rs:323-326. This pattern mirrors the root cause of AI23-BLOCK-002 (two modules independently answering the same architectural question), with is_peer_receipt() effectively dead code (zero callers workspace-wide). The architectural risk is future drift between the inline check and the canonical definition when either is modified. Cross-reference: related to AI22-IMPORTANT-003 (broader overlapping-predicate pattern in send/mod.rs)." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "structure" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-07-26T20:30:00Z"^^xsd:dateTime ;
  triage:closedBy "team-lead" ;
  triage:closureNotes "Independently verified on integrate/phase-AI HEAD (6348a112): peer_delivery_router.rs was refactored/renamed to crates/atm-daemon/src/runtime_health/post_write_router.rs, which now calls the canonical message.prepared.is_peer_receipt() accessor directly (post_write_router.rs:25,34) instead of the ad-hoc inline authenticated_source_host check. The remaining open occurrences below (s23-s30) are all pre-fix snapshots on branches that either already merged (s23-s26, PRs #629/#630/#640/#641) or are still in flight (s27-s30); the fix is real and current on the integration line. Closing all as superseded -- no further Crimson dispatch needed for this finding." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T18:45:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI23-IMPORTANT-006/s23/1> ;
