  triage:branch "feature/pAI-s23-crosshost-shared-write-path" ;
  triage:headSha "c528137cd07c8c329572cdb8e852faffb3fc9c94" ;
  triage:occursIn <urn:atm:triage:worktree/AI23-BLOCK-001/c528137cd07c8c329572cdb8e852faffb3fc9c94> ;
  triage:notes "Test proves narrower claim (TLS identity verification) but not broader acceptance bar (runtime integration with real advertised IP, persistence, ULID readback, nudge proof). Acceptance criteria require daemon-pair helper with receiver-side readback." .

