  triage:findingId "ATM-QA-AI9-SPRINTDOC-001" ;
  triage:title "AI.9 sprint doc frontmatter still status:proposed" ;
  triage:description "quality-mgr's AI9-QA-1 verdict (PR #604 @ 7cf40edd, feature/pAI-s9-https-peer-transport) reports docs/plans/phase-ai/sprint-ai-9.md frontmatter is still `status: proposed`, not flipped to `complete`, despite the sprint being an executed/closing sprint. This is a recurring acceptance-gate blocker pattern seen on AI.6/AI.7/AI.8 as well. The pattern appears on both AI.9 and AI.10 worktrees, indicating the frontmatter must be updated when marking sprints as complete after their work is done." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
