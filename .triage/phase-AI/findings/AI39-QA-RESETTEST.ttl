<urn:atm:triage:finding/AI39-QA-RESETTEST>
  a triage:Finding ;
  triage:findingId "AI39-QA-RESETTEST" ;
  triage:title "Missing reset/broken-pipe TCP client listener survival test" ;
  triage:description "Sprint doc AI.39 Required Validation section explicitly requires 'Prove a reset/broken-pipe client does not terminate the Unix TCP listener.' No test in the worktree exercises a reset/broken-pipe/mid-request-disconnect scenario against the loopback TCP listener and asserts subsequent independent connections still succeed. Confirmed by repo-wide search finding no reset/broken_pipe/disconnect-style listener-survival test. Required correction: Add a test that forcibly resets or drops a TCP client connection mid-request (e.g. via SO_LINGER abort or half-written request followed by socket drop) against the loopback TCP listener, then proves a second independent client connection is served successfully afterward." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
