<urn:atm:triage:finding/AI39-RSH-002>
  a triage:Finding ;
  triage:findingId "AI39-RSH-002" ;
  triage:title "Duplicate Content-Length headers not rejected" ;
  triage:description "content_length uses find_map to take the first header matching content-length case-insensitively and ignores any subsequent occurrences. Duplicate or conflicting Content-Length headers are not rejected as malformed, a classic HTTP request-smuggling/framing-ambiguity primitive." ;
