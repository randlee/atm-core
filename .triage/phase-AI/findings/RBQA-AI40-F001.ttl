<urn:atm:triage:finding/RBQA-AI40-F001>
  a triage:Finding ;
  triage:findingId "RBQA-AI40-F001" ;
  triage:title "AI.40 read-only SQLite durability check hardcodes atm-storage-rusqlite's schema with no mechanical drift guard" ;
  triage:description "verify_durable_admissions() (scripts/smoke/run_admission_capacity.py:662) hardcodes the atm-storage-rusqlite physical schema (table mail_messages, columns team/agent) in a Python benchmark script outside the Rust workspace. This duplicates schema interpretation that atm-storage-rusqlite is the sole owner of; sc-lint-boundary is scoped to Rust-only cargo_metadata/syn traversal, so it cannot see this script, meaning a column/table rename in the owning crate would silently desync with zero mechanical warning. Not a blocker: sprint doc deliverable #5 explicitly mandates a read-only query of the isolated test database, and the design choice is justified (list_mail's unbounded projection times out at scale, see ATM-QA-40-LISTMAIL-TIMEOUT). Recommend a mechanical guard (e.g. a pinning test in atm-storage-rusqlite, or a cross-reference comment) so schema drift fails fast in the owning crate rather than only failing late in an infrequently-run benchmark. Reported by ruthless-boundary-qa during AI40-QA-3." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "lint_gap" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-01T07:10:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI40 ;
  triage:foundAt "2026-08-01T07:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AI40-F001/S40-1> ;
  triage:triageRecordVersion "1" .

