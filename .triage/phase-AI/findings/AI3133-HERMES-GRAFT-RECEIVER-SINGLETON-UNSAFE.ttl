  triage:occursIn <urn:atm:triage:worktree/phase-AI/integrate-phase-ai-31-33> .

<urn:atm:triage:occurrence/AI3133-HERMES-GRAFT-RECEIVER-SINGLETON-UNSAFE/drop-unconditional-delete>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/graft.rs" ;
  triage:line 287 ;
  triage:snippet "impl Drop for GraftReceiverListener { fn drop(&mut self) { let _ = fs::remove_file(&self.record_path); } } — deletes the record path unconditionally on close, with no check that the on-disk record still belongs to this listener instance; can delete a newer, still-live receiver's record." ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "integrate/phase-ai-31-33" ;
  triage:headSha "21957012" ;
  triage:occursIn <urn:atm:triage:worktree/phase-AI/integrate-phase-ai-31-33> .

