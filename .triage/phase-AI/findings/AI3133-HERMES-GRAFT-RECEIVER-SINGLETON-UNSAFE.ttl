<urn:atm:triage:occurrence/AI3133-HERMES-GRAFT-RECEIVER-SINGLETON-UNSAFE/record-truncate-write>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/graft.rs" ;
  triage:line 393 ;
  triage:snippet "fn write_receiver_record(record_path: &Path, record: &GraftReceiverEndpointRecord) -> Result<(), AtmError> { ... options.write(true).create(true).truncate(true); ... } — plain truncating write, no exclusive-create/lock, so a second bind() for the same path silently replaces the first receiver's advertised endpoint." ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "integrate/phase-ai-31-33" ;
