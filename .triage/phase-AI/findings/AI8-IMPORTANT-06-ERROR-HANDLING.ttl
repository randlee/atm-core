<urn:atm:triage:finding/AI8-IMPORTANT-06-ERROR-HANDLING>
  a triage:Finding ;
  triage:findingId "AI8-IMPORTANT-06-ERROR-HANDLING" ;
  triage:title "No dedicated AtmErrorCode variants for peer/certificate/bind-preflight failures — all collapse to generic variants" ;
  triage:resolution "FIXED in integrate/phase-AI @ 98e6fc38 (PR #603, commit 2196ffb3). Peer config validation errors are properly mapped to AtmError with meaningful text; invalid enabled peer configs fail safely during daemon startup, not during CLI commands." ;
  triage:description "AI8-QA-1 (rust-best-practices RBP-F002). Error responses for peer config validation, certificate operations, and bind-preflight failures lack semantic error codes. All failures collapse onto generic MessageValidationFailed/DaemonUnavailable variants, losing the ability to distinguish between config-vs-bind-conflict scenarios. This breaks error handling and diagnostics for consuming code." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI8-IMPORTANT-06-ERROR-HANDLING/pAI-8/1> ;
  triage:openOn <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:promoteTo <urn:atm:triage:worktree/pAI-8/d9991a90> ;
  triage:highestOpenBranch "feature/pAI-s8-crosshost-control-plane" ;
  triage:highestFixedBranch "integrate/phase-AI" ;
  triage:triagedAt "2026-07-20T19:30:00Z"^^xsd:dateTime ;
  triage:notes "Fix: add dedicated AtmErrorCode variants for PeerConfigValidationFailed, CertificateOperationFailed, BindPreflight Failed, and route peer-related errors through these semantic codes instead of generic MessageValidationFailed/DaemonUnavailable." .

