<urn:atm:triage:finding/AI29-RBQA-001>
  a triage:Finding ;
  triage:findingId "AI29-RBQA-001" ;
  triage:title "RuntimeConfigDoctor::inspect_config reads .atm.toml unguarded by WorkspaceConfigAccess" ;
  triage:description "RuntimeConfigDoctor::inspect_config (composition.rs:73-82) independently calls load_atm_config, completely unguarded by the new WorkspaceConfigAccess/for_daemon() toggle from commit 40ed45e2. Wired into daemon via doctor_ports (composition.rs:101) and runtime_health.rs:791. Daemon DOES still read caller-supplied .atm.toml on doctor path, defeating the fix claim and issue #636." ;
  triage:phaseId "phase-AI" ;
  triage:category "RBQA" ;
  triage:severity "Blocking" ;
  triage:status "fixed" ;
  triage:repeatable false ;
  triage:foundIn triage:AICH-S10 ;
  triage:foundAt "2026-07-25T19:04:04Z"^^xsd:dateTime ;
  triage:closedAt "2026-07-25T19:48:57Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "RuntimeConfigDoctor::inspect_config (crates/atm-runtime/src/composition.rs:78-87) now only calls load_atm_config when config_current_dir is Some. RuntimeAssembly::for_daemon() (composition.rs:183-187) unconditionally installs RuntimeConfigDoctor::default() with config_current_dir: None. Wired at single production entry crates/atm-daemon/src/composition.rs:186 inside new_with_runtime_assembly before any dispatcher use. Verified by regression test daemon_config_doctor_does_not_read_a_caller_workspace (crates/atm-runtime/src/composition.rs:237-260)." ;
  triage:hasOccurrence <urn:atm:triage:occurrence_AI29-RBQA-001_d36709b1> ;
  triage:fixedOn <urn:atm:triage:worktree_feature_pAI_s29_crosshost_smoke_rerun_d36709b1> .

