<urn:atm:triage:finding/AI21-IMPORTANT-006>
  a triage:Finding ;
  triage:findingId "AI21-IMPORTANT-006" ;
  triage:foundAt "2026-07-25T04:58:56Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S1 ;
  triage:title "Three required initial-table rows are silently not-run by default" ;
  triage:description "scripts/smoke/run_inbound_peer_smoke.py code-path fix is correct: run() now properly populates host.local_checks rows when present in config. However, the shipped scripts/smoke/inbound-peer-smoke.example.json (the sprint's documented 'sole supported smoke surface') only declares 2 of 3 required keys: localhost/local loopback and own-IP are present, but 'nudge' is absent. Therefore, under the actual documented two-peer workflow with the actual shipped example config, the nudge row remains silently NOT-RUN. validate_host_config only validates that present keys are in the allowed set; it does not require all three keys, so the gap does not fail loudly." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "AI21" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "this-branch-only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-24T12:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI21-IMPORTANT-006/pAI-s21pre/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI21-IMPORTANT-006/pAI-s21pre/2> ;
  triage:openOn <urn:atm:triage:worktree/pAI-s21pre/42fbd9fa> ;
  triage:fixedOn <urn:atm:triage:worktree/pAI-s21pre/5678337c> ;
  triage:fixedOn <urn:atm:triage:worktree/pAI-s21pre/7cf131fa> ;
  triage:relatedFinding "AI21-QA2-001" .

<urn:atm:triage:occurrence/AI21-IMPORTANT-006/pAI-s21pre/1>
  a triage:Occurrence ;
  triage:file "scripts/smoke/run_inbound_peer_smoke.py" ;
  triage:line 469 ;
  triage:snippet "def run(config: dict[str, Any], output_root: Path, timeout: float, receive_timeout: float) -> int:" ;
  triage:description "run() function (default two-peer workflow) has correct code-path: lines 485-491 now call validate_host_config(config).get('local_checks', {}).items() and execute all declared checks. But because the shipped example.json is incomplete, the nudge check is silently absent." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s21pre-crosshost-evidence-harness" ;
  triage:headSha "5678337c" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-s21pre/5678337c> .

<urn:atm:triage:occurrence/AI21-IMPORTANT-006/pAI-s21pre/2>
  a triage:Occurrence ;
  triage:file "scripts/smoke/inbound-peer-smoke.example.json" ;
  triage:line 14 ;
  triage:snippet "\"local_checks\": { \"localhost/local loopback\": [...], \"own-IP\": [...], \"nudge\": [...] }" ;
  triage:description "Shipped example config at host.local_checks declared only 2 of 3 required keys, silently omitting 'nudge'. Fixed at 7cf131fa: example.json now includes the 'nudge' entry, and validate_host_config raises SmokeError listing any missing required key instead of silently accepting a partial set. Verified directly: grep of the example JSON confirms the 'nudge' key is present, and test_run_inbound_peer_smoke.py::test_host_mode_rejects_missing_required_local_check passes." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s21pre-crosshost-evidence-harness" ;
  triage:headSha "7cf131fa" ;
  triage:occursIn <urn:atm:triage:worktree/pAI-s21pre/7cf131fa> .

