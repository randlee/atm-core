<urn:atm:triage:finding/AI33-M5-LATENCY-MEASURE-MISSING>
  a triage:Finding ;
  triage:findingId "AI33-M5-LATENCY-MEASURE-MISSING" ;
  triage:title "No separate measure of successful SQLite transaction/response latency distinct from overall gate result" ;
  triage:description "arch-ctm's M5 investigation notes that the admission-capacity evidence records an overall p50 latency (~5ms) that is dominated by the mass-rejection (503) responses, not by the small number of genuinely successful (201) admissions. There is no separate measurement isolating successful SQLite transaction/response latency from the rejection-path latency, making it hard to reason about whether the accepted-path itself is healthy or whether it too degrades under load." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "observability" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
