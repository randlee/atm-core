<urn:atm:triage:finding/AI15-QA1-BLOCKING-01-GRAFT-WINDOWS-LOCAL-SOCKET>
  a triage:Finding ;
  triage:findingId "AI15-QA1-BLOCKING-01-GRAFT-WINDOWS-LOCAL-SOCKET" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "Unconditional interprocess::local_socket usage in atm-graft (Windows incompatible)" ;
  triage:description "crates/atm-graft/src/runtime.rs imports and uses interprocess::local_socket unconditionally (no #[cfg(not(windows))] gate) at bind_graft_receiver_listener (~line 643) and wake_graft_receiver_listener (~line 509), lines 20-23 for the import. This directly contradicts AI.11's stated closure criterion ('no Windows named-pipe or AF_UNIX local transport support') and is the same defect family as AI.11 QA-5's RBQA-F001 and AI.14's RBQA-F001 — confirmed independently by req-qa, arch-qa, and ruthless-boundary-qa (critical) on AI.15. Recommended fix shape: migrate to the same loopback-TCP local transport atm-daemon already uses on Windows (local_tcp_transport.rs) instead of a graft-private socket implementation." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "AI15" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-26T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI15-QA1-BLOCKING-01-GRAFT-WINDOWS-LOCAL-SOCKET/11/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI15-QA1-BLOCKING-01-GRAFT-WINDOWS-LOCAL-SOCKET/11/2> ;
