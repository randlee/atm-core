<urn:atm:triage:finding/AI27-CIREG-002>
  a triage:Finding ;
  triage:findingId "AI27-CIREG-002" ;
  triage:title "windows-latest Just-lint red on s28/s30: PeerDeliveryEvent field-shape drift (clippy E0063) + atm-error version-pin mismatch" ;
  triage:description "Discovered incidentally during AICH-S7-QA-FIX-2 (AI27-CIWIN-001 verification), not self-reported by arch-ctm. gh pr checks on PR #634 (feature/pAI-s28-bounded-peer-recovery @ ab9e409f) and PR #623 (feature/pAI-s30-semver-http-compatibility @ 9a4eda4e) both show windows-latest 'Just lint' FAILING with two independent causes in the same run: (1) clippy error[E0063]: missing fields `candidate_count` and `next_attempt_at` in initializer of `peer_delivery_observability::PeerDeliveryEvent` (lib test build) -- a test/construction site on this branch was not updated when PeerDeliveryEvent gained these fields upstream (on s27/integrate), i.e. merge-forward field-shape drift, not a Windows-specific issue (would fail on any OS, but only windows-latest was captured red at review time -- ubuntu/macos legs for these two PRs were not independently checked in this pass). (2) `just lint version`/`manifests` checks fail: crates/atm-storage/Cargo.toml's atm-error path dependency version does not match the target crate version (1.3.2-beta.28 on s28, 1.3.2-beta-30 on s30) -- a stale Cargo.toml version pin, also a forward-merge drift symptom, distinct from AI27-CIWIN-001 which this branch's occurrence already closes. PR #638 (s29) windows-latest checks were still pending/running at review time and were not evaluated for this same pattern." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "CIREG" ;
  triage:severity "Blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-07-27T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "arch-ctm" ;
  triage:dispatchReady false ;
  triage:closureNote "Not reproducible on integrate/phase-AI@b0510a3e. PR #623 (merge a6342ba9) forward-merged AI.30; commits 003d7e04 and 737ac7ea update every PeerDeliveryEvent construction site with candidate_count/next_attempt_at, while b422978b and the current crates/atm-storage/Cargo.toml retain the matching atm-error 1.3.2-beta-30 pin. gh pr checks 623 reports all 8 checks green, including windows-latest Just lint. Local just lint also passes 22/22. Finding-level status is now consistent with all fixed occurrences; no code change was required on this reconciliation branch." ;
  triage:triagedAt "2026-07-26T21:35:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S7 ;
  triage:foundAt "2026-07-26T21:25:00Z"^^xsd:dateTime ;
