<urn:atm:triage:finding/AI11-QA1-BLOCKING-01>
  a triage:Finding ;
  triage:findingId "AI11-QA1-BLOCKING-01" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-21T00:00:00Z"^^xsd:dateTime ;
  triage:title "Drain/force-cancel-deadline not ported to Windows loopback-TCP listener" ;
  triage:description "crates/atm-daemon/src/local_tcp_transport.rs:249-251 (serve_with_runtime_hooks, #[cfg(windows)]): graceful_drain_deadline and force_cancel_deadline are received and discarded; connections spawned via bare thread::spawn (line 268) never joined/tracked for shutdown drain. The UDS path's real drain logic (local_ipc_connection.rs:drain_active_connections_for_shutdown) properly uses these deadlines and is #[cfg(not(windows))] and never runs on Windows. local_tcp_transport.rs has only 3 tests, none exercising drain/cancel. Functional regression: in-flight connections aren't drained on Windows shutdown." ;
  triage:category "QA" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-daemon/src/local_tcp_transport.rs and any other #[cfg(windows)] transport/listener code introduced by AI.11" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedAt "2026-07-27T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "2026-07-27 (quality-mgr): independently re-verified at integrate/phase-AI@f3b6a77a — crates/atm-daemon/src/local_tcp_transport.rs serve_with_runtime_hooks now uses an ActiveConnectionRegistry/TrackedDispatchHandle (lines 251,276,290-294) to track every spawned connection thread, and calls drain_active_connections_for_shutdown(..., hooks.graceful_drain_deadline, hooks.force_cancel_deadline, ...) on shutdown (lines 256-263) -- the deadlines are now honored, not discarded. Test tcp_listener_drain_honors_the_force_cancel_deadline (line 672) exercises this directly. Confirmed via direct code read, not self-report." ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-21T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI11-QA1-BLOCKING-01/s11/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI11-QA1-BLOCKING-01/s12/1> ;
  triage:openOn <urn:atm:triage:worktree/s11/568723c5> ;
  triage:openOn <urn:atm:triage:worktree/s12/568723c5> ;
  triage:promoteTo <urn:atm:triage:worktree/s12/568723c5> .

