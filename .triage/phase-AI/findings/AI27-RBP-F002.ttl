  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/runtime_health.rs" ;
  triage:line 231 ;
  triage:snippet ".map_err(|_source| { ... }) in spawn_shutdown_step, thread-spawn failure detail discarded" ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pAI-s27-peer-delivery-observability" ;
