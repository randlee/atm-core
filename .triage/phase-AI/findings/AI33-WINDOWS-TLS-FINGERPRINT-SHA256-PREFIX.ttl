<urn:atm:triage:finding/AI33-WINDOWS-TLS-FINGERPRINT-SHA256-PREFIX>
  a triage:Finding ;
  triage:findingId "AI33-WINDOWS-TLS-FINGERPRINT-SHA256-PREFIX" ;
  triage:title "TLS certificate fingerprint normalizer does not strip a sha256: presentation prefix before matching against the PEM digest" ;
  triage:description "During AI.33 Windows capacity validation on fastpc4, arch-ctm's teammate cwin configured a stored certificate-fingerprint record using the operator-supplied sha256: prefixed presentation form. Daemon startup then rejected it with: configured TLS certificate fingerprint does not match the PEM bundle - even though the underlying fingerprint was correct. The fingerprint normalizer incorrectly retains the hexadecimal 'a' from the sha256: prefix instead of stripping the whole case-insensitive prefix before separator normalization, so a validly prefixed 64-hex SHA-256 fingerprint can never match the PEM digest. This is a real cross-platform source defect (not Windows-only), is startup-only (must not affect the admission-path hot path), and must NOT be worked around by removing the sha256: prefix operationally -- it is a legitimate, already-documented presentation format that the normalizer must handle correctly." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-30T17:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AICH-S13 ;
  triage:foundAt "2026-07-30T17:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI33-WINDOWS-TLS-FINGERPRINT-SHA256-PREFIX/bc8d8a2-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/AI33-WINDOWS-TLS-FINGERPRINT-SHA256-PREFIX/bc8d8a2-1>
