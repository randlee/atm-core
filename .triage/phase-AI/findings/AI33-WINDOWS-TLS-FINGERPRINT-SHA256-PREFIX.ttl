  triage:line 949 ;
  triage:snippet "fn normalize_fingerprint(value: &str) -> String { value.chars().filter(char::is_ascii_hexdigit).collect::<String>().to_ascii_lowercase() }" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAI-s33-admission-capacity-smoke" ;
