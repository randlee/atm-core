<urn:atm:triage:finding/AI39-QA-WRITEPARITY>
  a triage:Finding ;
  triage:findingId "AI39-QA-WRITEPARITY" ;
  triage:title "Missing real POST /v1/atm/messages write test over loopback TCP on Unix" ;
  triage:description "Sprint doc requires exercising route-specific POST /v1/atm/messages writes over UDS and TCP on Unix and TCP on Windows. REQ-CORE-TRANSPORT-001 requires equivalent local HTTP request/response tests over UDS plus loopback TCP on Unix and loopback TCP on Windows. The only real message-write test runs through platform-conditional LocalIpcServerTransportAdapter (UDS on Unix, TCP on Windows) and never exercises a real message write over loopback TCP on a Unix host. All local_tcp_transport.rs tests use DoctorOnlyDispatcher/RequestEnvelope::Doctor and never issue a POST /v1/atm/messages write." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
