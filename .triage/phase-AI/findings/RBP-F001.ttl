<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:title "HttpRouteKind to HTTP_ROUTE_SPECS lookup is runtime .expect(), not compile/test-time exhaustiveness-checked" ;
  triage:description "crates/atm-core/src/api.rs: as part of the AI24-IMPORTANT-001 fix, a single HTTP_ROUTE_SPECS const table (lines 63-127) now backs endpoint_for, decode_route_request/route_kind_for_http, and http_route_surface(). However the link from HttpRouteKind to its HTTP_ROUTE_SPECS entry is only a runtime .expect() lookup in route_spec(), not compile-time or test-time exhaustiveness-checked -- a new HttpRouteKind variant added without a corresponding HTTP_ROUTE_SPECS entry would panic at runtime rather than fail to compile or fail a test." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "best-practices" ;
  triage:severity "Minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-25T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001/s24/1> ;
  triage:openOn <urn:atm:triage:worktree/s24/c326cbe7> ;
  triage:promoteTo <urn:atm:triage:worktree/s24/c326cbe7> .

<urn:atm:triage:occurrence/RBP-F001/s24/1>
  a triage:Occurrence ;
