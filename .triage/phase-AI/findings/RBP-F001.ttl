<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "HttpRouteKind to HTTP_ROUTE_SPECS lookup is runtime .expect(), not compile/test-time exhaustiveness-checked" ;
  triage:description "crates/atm-core/src/api.rs:143-148 route_spec(kind) resolved via linear .find().expect() scan of HTTP_ROUTE_SPECS instead of an exhaustive match; a new HttpRouteKind variant wired into route_kind_for_request but missing an HTTP_ROUTE_SPECS entry compiles cleanly and only panics at runtime. Fixed: converted to exhaustive match over HttpRouteKind with no wildcard arm, returning &'static HttpRouteSpec. rust-best-practices-agent independently cross-checked all 10 index/kind pairs against HTTP_ROUTE_SPECS array declaration order; no mismatch found." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "followup_pass" ;
  triage:category "best-practices" ;
