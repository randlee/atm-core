  triage:foundIn triage:AICH-Legacy ;
  triage:foundAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:title "pub mod nudge_template publicly exports internal post-send hook, bypassing canonical send_mail path" ;
  triage:description "pub mod nudge_template; in crates/atm-core/src/send/mod.rs publicly exports internal post-send hook functions, allowing callers to bypass the canonical send_mail path boundary. Present on all 7 branches at the same location. Recommended fix: change to pub(crate) mod nudge_template;" ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:category "boundary-violation" ;
