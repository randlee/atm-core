<urn:atm:triage:finding/ATM-QA-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-006" ;
  triage:title "TCP/UDS comparison ratio silently relaxed below sprint doc's 90% floor for f1/f2 profiles" ;
  triage:description "scripts/smoke/run_admission_capacity.py:901 sets comparison_ratio = 0.9 if frames_per_connection >= 8 else 0.75, i.e. f1 and f2 profiles are only required to hit 75% of UDS throughput, not 90%. Sprint doc (docs/plans/phase-ai/sprint-ai-40-local-transport-benchmark.md:140-141) states unconditionally that TCP throughput for each corresponding M5 profile must be at least 90% of UDS, and that any threshold miss fails the sprint -- no frame-size carve-out is documented. Verified against the freshest M5 evidence at commit 795ebf83 (site/reports/send-message-benchmark/20260801-0615xx-mac-arm64-01-*): f1 TCP/UDS = 79.2% (12439/15708 admissions_per_second), f2 TCP/UDS = 85.9% (19915/23182 admissions_per_second) -- both genuinely below 90% and both reported passed=true only because of the relaxed 75% floor. f8/f16/f64 are fine (97-100%). This is a real, currently-live doc-vs-implementation mismatch, not a stale/pre-existing item to wave through: either the comparison_ratio must be raised to 0.9 uniformly and the underlying TCP short-frame throughput improved to actually clear it, or the sprint doc's acceptance criterion must be explicitly amended to document an accepted short-frame floor -- silent code-level relaxation is not an accepted resolution path." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "acceptance-criteria-gap" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T06:35:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI40 ;
  triage:foundAt "2026-08-01T06:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-006/S40-1> ;
  triage:triageRecordVersion "1" .

