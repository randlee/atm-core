<urn:atm:triage:finding/AI40CLEANUP-ARCH-002>
  a triage:Finding ;
  triage:findingId "AI40CLEANUP-ARCH-002" ;
  triage:title "Stale/superseded duplicate M5 evidence left in tracked site/ history after the \"clean\" rebuild" ;
  triage:description "This branch (fix/ai40-benchmark-artifact-cleanup) exists specifically to rebuild AI.40's benchmark artifact git history so it stops committing enormous volumes of raw-trace/report data on every run. Despite that goal, arch-qa confirmed directly during AI40-CLEANUP-QA-1 (PR #712 @ bff39d95) that 7 distinct M5-timestamp groups (21 tracked files) exist under site/reports/send-message-benchmark/, not the claimed \"4/4 new M5 raw->public pairs.\" An incomplete/superseded triplet (uds-f1/uds-f4/tcp-f4 at 16:07-16:07:58, source_revision 894818864a...) sits alongside the complete new quad (16:49-16:51, source_revision 18873a639f...), missing a tcp-f1 counterpart. latest_profile_results() dedupes at report-render time so the rendered report itself isn't corrupted, but the \"clean\" history rebuild reintroduced superseded evidence into tracked git history instead of landing a clean 4-file set -- directly undermining this branch's own stated purpose of not bloating git with repeated/stale report artifacts." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "site/reports/send-message-benchmark/ on this branch only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AI40 ;
  triage:foundAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI40CLEANUP-ARCH-002/1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/AI40CLEANUP-ARCH-002/1>
  a triage:Occurrence ;
  triage:file "site/reports/send-message-benchmark/" ;
  triage:line 1 ;
  triage:snippet "Independently re-verified fixed on fix/ai40-benchmark-artifact-cleanup @ e9147bac: grep for superseded source_revision 894818864a returns zero hits; exactly 4 m5-arm64-hostname result groups (12 files: uds-f1, uds-f4, tcp-f1, tcp-f4) remain, all source_revision 18873a639f. Pre-existing unrelated mac-arm64-hostname evidence groups from other runs untouched (not part of this finding's scope)." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "fix/ai40-benchmark-artifact-cleanup" ;
  triage:headSha "bff39d95" ;
  triage:occursIn <urn:atm:triage:worktree/1> .

