<urn:atm:triage:finding/AI3152-LOCALIPCWAKE-ERROR-DISCARD>
  a triage:Finding ;
  triage:findingId "AI3152-LOCALIPCWAKE-ERROR-DISCARD" ;
  triage:title "Underlying io::Error discarded on unexpected accept/bind/dir failures, collapsing distinct OS errors into one generic message" ;
  triage:description "Rust-best-practices-agent on QA-1 found this discard pattern (Err(_source) =>, etc., dropping the underlying io::Error) at 4 sites: local_ipc_transport.rs:972 (unexpected accept() failure, important), local_ipc_transport.rs:487 (bind failure, minor), shutdown.rs:110 (dir creation, minor), shutdown.rs:130 (stale-endpoint removal, minor). Fix: preserve/log the underlying io::Error instead of discarding it, at all 4 sites." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
