<urn:atm:triage:finding/AI40-WINDOWS-TRANSPORT-MOCK-GUARD>
  a triage:Finding ;
  triage:findingId "AI40-WINDOWS-TRANSPORT-MOCK-GUARD" ;
  triage:title "Windows CI failure: test_transport_is_platform_explicit missing mock.patch guard for uds validation" ;
  triage:description "scripts/smoke/test_run_admission_capacity.py::test_transport_is_platform_explicit (line 70 on s40, line 48 on s49+) calls RUNNER.validate_transport('uds') without wrapping in 'with mock.patch.object(RUNNER.os, name, posix):' guard. On Windows CI, validate_transport correctly rejects 'uds' and raises SmokeError 'Windows capacity benchmarking supports only tcp' instead of returning 'uds'. This causes pytest failure on windows-latest runner. Same pattern was correctly fixed in AI.49 and AI.50 branches." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "TEST-WINDOWS" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
