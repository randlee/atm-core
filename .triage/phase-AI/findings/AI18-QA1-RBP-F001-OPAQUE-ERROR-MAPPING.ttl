<urn:atm:triage:finding/AI18-QA1-RBP-F001-OPAQUE-ERROR-MAPPING>
  a triage:Finding ;
  triage:findingId "AI18-QA1-RBP-F001-OPAQUE-ERROR-MAPPING" ;
  triage:title "Opaque error mapping across the PyO3 FFI boundary loses error code and cause" ;
  triage:description "crates/atm-graft-python (PyO3 bindings) collapses every AtmError into a generic PyRuntimeError across the FFI boundary, discarding the original error code and cause chain. Flagged critical/blocking by rust-best-practices-agent in both AI.18 QA-1 rounds." ;
  triage:phaseId "phase-AI" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "critical" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-22T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI18-QA1-RBP-F001-OPAQUE-ERROR-MAPPING/s18/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AI18-QA1-RBP-F001-OPAQUE-ERROR-MAPPING/s19/1> ;
  triage:openOn <urn:atm:triage:worktree/s18/b8f46a1a> ;
  triage:openOn <urn:atm:triage:worktree/s19/2e22b6b4> ;
  triage:promoteTo <urn:atm:triage:worktree/s19/2e22b6b4> .

