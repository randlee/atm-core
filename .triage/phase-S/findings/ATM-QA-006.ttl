<urn:atm:triage:finding/ATM-QA-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-006" ;
  triage:title "Windows lifecycle worker uses fixed 25ms sleep — no triage exemption record" ;
  triage:description "lifecycle_control.rs — Windows lifecycle worker uses a hardcoded 25ms sleep in production code. docs/plan-phase-S.md §4.1 Accepted production exceptions explicitly documents this as an accepted exception for the Windows signal-hook cross-platform boundary. A canonical triage exemption record does not yet exist. The code comment on s13/s15 correctly cites plan-phase-S.md §4.1; s14 cites daemon architecture docs (weaker but same substance). Fix: add exemption record pointing to plan-phase-S.md §4.1." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
