<urn:atm:triage:finding/FTQ-009>
  a triage:Finding ;
  triage:findingId "FTQ-009" ;
  triage:title "Fragile drop ordering for test teardown guard at tests.rs:82" ;
  triage:description "crates/atm-daemon/src/tests.rs:82 — test teardown depends on implicit drop ordering of local variables. Rust drops in reverse declaration order, but this is fragile when guard-like objects are interleaved with non-guard values. Should use an explicit Drop guard struct or named variable to make ordering deterministic. (quality-mgr reported as FTQ-006; remapped FTQ-009 to avoid ID collision with existing phase-S FTQ-006.)" ;
  triage:category "FTQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
