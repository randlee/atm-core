<urn:atm:triage:finding/INTG-FTQ-005>
  a triage:Finding ;
  triage:findingId "INTG-FTQ-005" ;
  triage:title "Shared static SHUTDOWN_FINALIZER_THREADS accumulates across parallel tests" ;
  triage:description "runtime_health.rs:44 — SHUTDOWN_FINALIZER_THREADS is module-level static Mutex<Vec<JoinHandle>> shared by all tests in the atm-daemon binary. Concurrent tests accumulate handles in the same Vec; drain_shutdown_finalizer_threads_for_test drains handles belonging to other tests. Fix: replace shared static with per-test registry passed explicitly, or use #[serial_test::serial] on all tests that touch this state." ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "integration_gate" ;
  triage:phaseId "phase-S" ;
