<urn:atm:triage:finding/CI-BLOCK-QA3-001>
  a triage:Finding ;
  triage:findingId "CI-BLOCK-QA3-001" ;
  triage:title "Ungated unix-only import — AtmObservabilityHealthState in tests.rs" ;
  triage:description "use atm_core::observability::AtmObservabilityHealthState at tests.rs:18 is ungated. The symbol is consumed only at tests.rs:240 inside the #[cfg(unix)] test fn compose_runtime_start_writes_retained_log_and_reports_healthy_observability. On Windows, -D warnings (-D unused-imports) produces: error: unused import: atm_core::observability::AtmObservabilityHealthState. Fix: add #[cfg(unix)] gate above line 18. Root cause: same pattern as CI-BLOCK-001 and CI-BLOCK-NEW-001 — every edit to tests.rs that adds unix-gated test functions must also gate their exclusive imports. Sweep confirmed: DoctorStatus (lines 170/933/974), RequestDispatcher (lines 127/282), assemble_boundary (line 474) all have cross-platform usage and do NOT need gating." ;
  triage:category "CI" ;
  triage:severity "blocking" ;
