<urn:atm:triage:finding/FTQ-007>
  a triage:Finding ;
  triage:findingId "FTQ-007" ;
  triage:title "recv_timeout(10s) scheduling sensitivity in test at tests.rs:197" ;
  triage:description "crates/atm-daemon/src/tests.rs:197 — test uses recv_timeout with a 10-second deadline that assumes thread scheduling will deliver the message within that wall-clock window. Under CI load or slow VMs this can produce nondeterministic TIMEOUT failures. (quality-mgr reported as FTQ-004; remapped FTQ-007 to avoid ID collision with existing phase-S FTQ-004.)" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
