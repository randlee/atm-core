<urn:atm:triage:finding/RSH-001>
  a triage:Finding ;
  triage:findingId "RSH-001" ;
  triage:title "shutdown_background_lanes partial shutdown on coordinator timeout" ;
  triage:description "composition.rs — shutdown_background_lanes uses ? chaining three lane shutdowns. If reconcile coordinator times out, watch and notification lanes never get shutdown() called." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;
