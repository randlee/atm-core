<urn:atm:triage:finding/RSH-001>
  a triage:Finding ;
  triage:findingId "RSH-001" ;
  triage:title "wake_listener() spawns untracked detached thread — no join handle" ;
  triage:description "local_ipc_transport.rs — wake_listener() calls std::thread::spawn() but drops the JoinHandle immediately, creating a detached thread with no lifecycle tracking. Fix: store the join handle or use a tracked thread pool." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
