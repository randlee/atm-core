<urn:atm:triage:finding/RSH-004>
  a triage:Finding ;
  triage:findingId "RSH-004" ;
  triage:title "Timeout-set failure on cap-exceeded connection silently discarded" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs:353 — When a connection capacity cap is exceeded, set_recv_timeout/set_send_timeout failures are silently discarded via let _ = ... rather than dropping the stream. The stream continues to write_frame/flush/continue even if timeout setup failed. Fix: drop the stream explicitly on timeout-set failure." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-004/pS-s13/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-004/pS-s14/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-004/pS-s15/1> ;

  triage:openOn <urn:atm:triage:worktree/pS-s13/4c03c2c> ;
