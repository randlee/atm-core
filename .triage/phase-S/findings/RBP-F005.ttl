# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RBP-F005>
  a triage:Finding ;
  triage:findingId "RBP-F005" ;
  triage:title "terminate_flag() returns infallible Option<Arc<AtomicBool>> — misleads callers" ;
  triage:description "lifecycle_control.rs:60 — terminate_flag() always returns Some(Arc<AtomicBool>). The Option wrapper is never None. Callers must unwrap() or pattern-match needlessly. This misleads readers into thinking None is a reachable state. The function should return Arc<AtomicBool> directly. Note: existing RBP-F001 (reconcile_runtime.rs) and RBP-F002 (watch_runtime.rs) cover AtmErrorCode discard — this is a distinct pattern about infallible Option return types." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F005/pS-s1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F005/pS-s1/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F005/pS-s2/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F005/pS-s2/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F005/pS-s3/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F005/pS-s3/2> ;

  triage:openOn <urn:atm:triage:worktree/pS-s1/ab12ea1> ;
