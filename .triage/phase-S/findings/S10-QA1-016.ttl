<urn:atm:triage:finding/S10-QA1-016>
  a triage:Finding ;
  triage:findingId "S10-QA1-016" ;
  triage:title "Tracing-subscriber initialization failure silently swallowed — no operator visibility (RBP-001)" ;
  triage:description "main.rs:21: try_init() result discarded with `let _ = ...`. If the tracing subscriber fails to initialize (duplicate subscriber registration, global init conflict), the failure is lost with no error message, no recovery guidance, and no propagation. The operator has no signal that observability is degraded from daemon start. Per RBP-001: if failure is non-fatal, log via tracing::warn! or eprintln! before discarding, with a comment documenting the intent. If fatal, propagate as AtmError::observability_bootstrap(...).with_recovery(...). Root-cause shared with S10-QA1-003 and S10-QA1-015." ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s10-daemon-retained-logger" ;
  triage:promoteToBranch "feature/pS-s10-daemon-retained-logger" ;
