<urn:atm:triage:finding/INTG-RBP-003>
  a triage:Finding ;
  triage:findingId "INTG-RBP-003" ;
  triage:title "SHUTDOWN_FINALIZER_THREADS.lock().expect() in production shutdown — panics if mutex poisoned" ;
  triage:description "Static mutex .expect() in run_bounded_shutdown_step. If poisoned by prior panic, daemon panics instead of propagating structured error. Fix: replace with .map_err(|_| log + silently skip retention)." ;
