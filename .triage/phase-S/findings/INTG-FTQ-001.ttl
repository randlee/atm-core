<urn:atm:triage:finding/INTG-FTQ-001>
  a triage:Finding ;
  triage:findingId "INTG-FTQ-001" ;
  triage:title "Fixed shared test path temp_dir/atm-watch-test — parallel test collision risk" ;
  triage:description "watch_runtime.rs:447 — request_for() hard-codes temp_dir().join(\"atm-watch-test\") as home_dir for every test. When Cargo runs tests in parallel, all tests calling request() share the same on-disk path. watch_runtime_ignores_host_scoped_log_directory creates real files there; concurrent tests see contaminated filesystem state. Fix: use TempDir::new() per invocation, mirroring unique_home_dir() pattern in reconcile_runtime.rs tests." ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:triageMode "integration_gate" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T07:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-05-10T15:50:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "integrate/phase-S" ;
  triage:promoteToBranch "integrate/phase-S" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/INTG-FTQ-001/intg/1> ;
  triage:openOn <urn:atm:triage:worktree/integrate-phase-S/ade96f2> .

