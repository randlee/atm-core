<urn:atm:triage:finding/S7-RBP-F003>
  a triage:Finding ;
  triage:findingId "S7-RBP-F003" ;
  triage:title "action: String in *Outcome structs should be typed CommandAction enum" ;
  triage:description "AckOutcome, SendOutcome, ClearOutcome, ReadOutcome, and ListOutcome all carry `pub action: String` instead of a typed enum. Fix: introduce a CommandAction enum (or per-command variant) and replace the String field to prevent stringly-typed dispatch." ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "sprint" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;

