<urn:atm:triage:finding/ATM-QA-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-002" ;
  triage:title "Exit-code taxonomy mismatch — DaemonLifecycleWedge/DaemonUnavailable routing" ;
  triage:description "crates/atm-daemon/src/lib.rs:54-73 — Exit-code taxonomy mismatch: plan assigns exit 71 to OS/bind/endpoint failures but implementation routes all DaemonUnavailable (including bind failures) to TransportFatal=70; exit 71 is reached only by DaemonLifecycleWedge. Fix: introduce DaemonEnvironmentFatal error code or amend plan §4 taxonomy table to match implementation." ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
