<urn:atm:triage:finding/ATM-QA-014>
  a triage:Finding ;
  triage:findingId "ATM-QA-014" ;
  triage:title "Production-path test spawns real atm-daemon child process (ARCH-SINGLETON violation)" ;
  triage:description "crates/atm-daemon/tests/run_daemon_production_path.rs spawns a real atm-daemon child process via Command::new(CARGO_BIN_EXE_atm-daemon). ARCH-SINGLETON violation: tests must use in-process transport doubles, not real daemon spawns. pS-s2 and pS-s3 additionally lack the #![cfg(unix)] gate. pS-s1 and pS-s4 have read_line with no timeout (FTQ-004 co-occurrence)." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T06:38:48Z"^^xsd:dateTime ;
