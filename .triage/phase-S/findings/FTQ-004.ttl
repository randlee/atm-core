<urn:atm:triage:finding/FTQ-004>
  a triage:Finding ;
  triage:findingId "FTQ-004" ;
  triage:title "Bare read_line with no timeout in production-path test; hangs runner if daemon fails to emit ready signal" ;
  triage:description "crates/atm-daemon/tests/run_daemon_production_path.rs uses bare BufReader::read_line with no timeout. If the daemon fails to emit its ready signal the test runner hangs indefinitely." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-S" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
