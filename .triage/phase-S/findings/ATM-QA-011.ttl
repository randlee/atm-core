<urn:atm:triage:finding/ATM-QA-011>
  a triage:Finding ;
  triage:findingId "ATM-QA-011" ;
  triage:title "cfg_attr(windows/unix, allow(dead_code)) matches PORT-005 suppressor pattern" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs:111-115 — cfg_attr(windows/unix, allow(dead_code)) on enum variants matches the PORT-005 suppressor pattern. The sc-lint-boundary PORT-005 detector only recognises #[cfg_attr(not(unix), allow(dead_code))]; the forms #[cfg_attr(windows, allow(dead_code))] and #[cfg_attr(unix, allow(dead_code))] are NOT caught. Verify sc-portability lint catches these forms; if not, document the exemption." ;
  triage:category "ATM-QA" ;
  triage:severity "minor" ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
