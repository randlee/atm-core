<urn:atm:triage:finding/S10-QA1-015>
  a triage:Finding ;
  triage:findingId "S10-QA1-015" ;
  triage:title "init_tracing() declares Result<(), AtmError> return type but is structurally infallible (RBP-007)" ;
  triage:description "main.rs:20-28: init_tracing() returns Result<(), AtmError> but the try_init() result is discarded with `let _ = ...` and the function unconditionally returns Ok(()). The error path is dead — the Result wrapper is meaningless plumbing. Per RBP-007: either change the return type to () (preferred if tracing failure is non-fatal), or propagate the try_init() error as AtmError::observability_bootstrap(...) so failure is visible via the existing ? at main.rs:16. Root-cause shared with S10-QA1-003 and S10-QA1-016." ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
