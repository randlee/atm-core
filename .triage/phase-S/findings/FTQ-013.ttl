<urn:atm:triage:finding/FTQ-013>
  a triage:Finding ;
  triage:findingId "FTQ-013" ;
  triage:title "Dispatch handle orphaned when track_dispatch_handle errors on lock poison (local_ipc_transport.rs:511)" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs:511 — if track_dispatch_handle returns Err (lock poison), the JoinHandle for the newly spawned dispatch thread is dropped and the thread runs untracked. Thread cannot be joined on shutdown. (quality-mgr reported as FTQ-007; remapped FTQ-013 to avoid conflict with existing phase-S FTQ-007 = recv_timeout scheduling on S.1.)" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
