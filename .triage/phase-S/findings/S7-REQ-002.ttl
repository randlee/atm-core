<urn:atm:triage:finding/S7-REQ-002>
  a triage:Finding ;
  triage:findingId "S7-REQ-002" ;
  triage:title "Sprint S.7 §6.2 incomplete — mailbox_timeout_policy still delegates to module-level helper" ;
  triage:description "crates/atm-core/src/service_runtime.rs:168-171 — mailbox_timeout_policy() returns RetainedMailboxTimeoutPolicy { workflow_lock_timeout: crate::mailbox::lock::default_lock_timeout() }. The struct exists and the trait method is correctly named, but the canonical timeout value is still sourced from the module-level free function crate::mailbox::lock::default_lock_timeout(). Sprint S.7 §6.2 requires the boundary-owned policy to define the canonical timeout internally without delegating to that helper. Fix: inline the Duration value (or a named const) directly in mailbox_timeout_policy() and retire the delegation to crate::mailbox::lock::default_lock_timeout() from this call site." ;
  triage:category "REQ" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
