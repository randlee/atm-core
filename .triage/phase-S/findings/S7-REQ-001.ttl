<urn:atm:triage:finding/S7-REQ-001>
  a triage:Finding ;
  triage:findingId "S7-REQ-001" ;
  triage:title "ADR-009 Bounded Query Rule violated — list.rs materializes full message bodies" ;
  triage:description "list_mail_with_runtime in crates/atm-core/src/list.rs:164-172 calls selection_state_for_source_files, which internally calls classify_all(merged_surface(source_files), ...). merged_surface iterates all SourceFile entries; each SourceFile holds Vec<MessageEnvelope> with a pub text: String field populated by file deserialization. The full message body is therefore loaded into memory for every message in the mailbox before list_row_from_message strips it to ListRow. The SQLite path in mailbox_metadata.rs correctly projects only summary columns; the file-backed path does not. Sprint S.7 core requirement — summary queries must not load full mailbox history — is unmet. Fix: introduce a summary-only deserialization path (e.g. a ListEnvelope projection struct) used by observe_source_files or a new observe_source_file_summaries call, so that the text field is never allocated during list operations." ;
  triage:category "REQ" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-REQ-001/s7/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s7-queue-query/9c01bca> .

