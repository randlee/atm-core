<urn:atm:triage:finding/ATM-QA-S14-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-S14-002" ;
  triage:title "panicked-worker paths missing .with_recovery() in reconcile_runtime and watch_runtime" ;
  triage:description "reconcile_runtime.rs:288 and watch_runtime.rs:235 return AtmError::daemon_unavailable on panicked-worker (Ok(Err(_))) paths without .with_recovery(). The timeout path at reconcile_runtime.rs:301 and watch_runtime.rs:248 correctly uses .with_recovery() — creating an inconsistency within the same match expression. All lock-poison and panicked-worker error sites should chain .with_recovery()." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-S" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-S14-002/pS-s14-impl/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-S14-002/pS-s14-impl/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-S14-002/pS-s15-rusqlite-hardening/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-S14-002/pS-s15-rusqlite-hardening/2> ;
  triage:openOn <urn:atm:triage:worktree/pS-s14-impl/571fa1c> ;
