<urn:atm:triage:finding/RSH-NEW-003>
  a triage:Finding ;
  triage:findingId "RSH-NEW-003" ;
  triage:title "SHUTDOWN_FINALIZER_THREADS — unbounded Vec grows under repeated timeout" ;
  triage:description "static SHUTDOWN_FINALIZER_THREADS: Mutex<Vec<JoinHandle<()>>> at runtime_health.rs:43 has no capacity cap. Every timed-out shutdown worker is pushed without limit. In a long-running daemon with repeated checkpoint timeouts the vec grows unbounded. Fix: add a MAX_SHUTDOWN_FINALIZER_THREADS const and warn+skip-push (or join-inline with short timeout) when the limit is reached, preventing unbounded memory growth." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:rule "RSH" ;
  triage:triageMode "followup_pass" ;
  triage:phaseId "phase-S" ;
