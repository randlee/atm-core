# ATM-QA-018: SIGBREAK handler may not fire in non-console Windows processes
# Phase: phase-S | Mode: initial_pass | Triaged: 2026-05-08

<urn:atm:triage:finding/ATM-QA-018>
    a triage:Finding ;
    triage:findingId "ATM-QA-018" ;
    triage:title "SIGBREAK handler may not fire in non-console Windows processes" ;
    triage:description "lifecycle_control.rs:91 — SIGBREAK (CTRL_BREAK_EVENT) is registered via signal_hook on Windows. However SIGBREAK is only delivered to console-attached processes. When the daemon runs as a Windows service or detached process, SetConsoleCtrlHandler does not receive CTRL_BREAK_EVENT. The graceful shutdown path may be silently absent in service deployments." ;
    triage:triageMode "initial_pass" ;
    triage:category "ATM-QA" ;
    triage:phaseId "phase-S" ;
    triage:severity "important" ;
    triage:repeatable false ;
    triage:sweepScope "file" ;
    triage:status "fixed_partial" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;

    triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-018/pS-s3-runtime-control/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-018/pS-s3-runtime-control/2> ;

    triage:openOn <urn:atm:triage:worktree/pS-s1-boundary-extraction/ab12ea1> ;
    triage:openOn <urn:atm:triage:worktree/pS-s2-windows-ipc/a7f8039> ;
    triage:openOn <urn:atm:triage:worktree/pS-s3-runtime-control/98c151c> ;
