<urn:atm:triage:finding/S10-QA1-007>
  a triage:Finding ;
  triage:findingId "S10-QA1-007" ;
  triage:title "Missing tests for OS-level fail-closed failure modes (non-writable dir, file not appendable)" ;
  triage:description "ADR-011 requires fail-closed behavior 'reported to stderr with the full path and the underlying OS error'. The existing test bootstrap_fails_closed_when_atm_log_dir_is_invalid only covers the invalid ATM_LOG_DIR (relative path) case. No tests cover: (1) directory exists but is not writable, (2) log file not openable for append. Add tests for these OS-error paths verifying both fail-closed return and error message containing the full path." ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
