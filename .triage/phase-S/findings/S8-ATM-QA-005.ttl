<urn:atm:triage:finding/S8-ATM-QA-005>
  a triage:Finding ;
  triage:findingId "S8-ATM-QA-005" ;
  triage:title "REQ-DAEMON-RUNTIME-008 and no-churn rule block missing ADR-010 citation" ;
  triage:description "docs/atm-daemon/requirements.md REQ-DAEMON-RUNTIME-008 (lines 205-211) defines the no-churn invariant for watcher/reconcile handling of ATM-authored compatibility projection updates. Its Satisfies list cites REQ-CORE-COMPAT-001 and REQ-P-RELIABILITY-001 but does not cite ADR-010-claude-jsonl-compatibility-envelope.md, which is the design record that introduces the retrieval-stub projection and the no-churn rule. Similarly, docs/atm-daemon/architecture.md lines 191-197 reproduce the no-churn rule in prose but contain no reference to ADR-010. Sprint S.8 is the phase where ADR-010 was implemented; the traceability link from the governing requirement and its architecture prose back to the originating design record is absent from both documents, breaking the sprint-level citation chain." ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:promoteTo "feature/pS-s8-jsonl-compat" ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
