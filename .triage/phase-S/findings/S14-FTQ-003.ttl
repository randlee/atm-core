<urn:atm:triage:finding/S14-FTQ-003>
  a triage:Finding ;
  triage:findingId "S14-FTQ-003" ;
  triage:title "SHARED_LIFECYCLE static worker not drained in LifecycleFlagResetGuard::drop" ;
  triage:description "lifecycle_control.rs:10 has SHARED_LIFECYCLE static. LifecycleFlagResetGuard::drop resets lifecycle flags (set_terminate_for_test/set_reload_for_test) but does not call shutdown_worker_with_timeout() or otherwise drain the SHARED_LIFECYCLE worker. The worker thread registered in SharedLifecycleControlState.worker remains running across test boundaries, causing inter-test interference." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S14-FTQ-003/pS-s14-impl/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S14-FTQ-003/pS-s14-impl/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S14-FTQ-003/pS-s15-rusqlite-hardening/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S14-FTQ-003/pS-s15-rusqlite-hardening/2> ;
  triage:openOn <urn:atm:triage:worktree/pS-s14-impl/571fa1c> ;
  triage:openOn <urn:atm:triage:worktree/pS-s15-rusqlite-hardening/493f2b1> ;
  triage:promoteTo <urn:atm:triage:worktree/pS-s14-impl/571fa1c> .

