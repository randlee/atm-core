<urn:atm:triage:finding/S8-QA2-002>
  a triage:Finding ;
  triage:findingId "S8-QA2-002" ;
  triage:title "Missing boundary test for export cap: text.len() == export_cap case unverified" ;
  triage:description "ADR-010 §Export Limit states 'export the full ATM-authored body only when it is less than or equal to that limit'. The implementation at inbox_message.rs:464 uses message.text.len() > export_cap (stub when strictly greater) which correctly implements ≤ semantics. However there is no test that exercises the exact boundary text.len() == export_cap, leaving the boundary semantics unverified. Sprint-S8.md task 2.2 requires full-body durability; a boundary test is needed to confirm body-at-cap → full export (not stub)." ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s8-jsonl-compat" ;
