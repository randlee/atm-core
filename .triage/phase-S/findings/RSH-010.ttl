<urn:atm:triage:finding/RSH-010>
  a triage:Finding ;
  triage:findingId "RSH-010" ;
  triage:title "shutdown_lane_with_deadline spawns thread with no stored JoinHandle — timeout branch unobserved (composition.rs)" ;
  triage:description "crates/atm/src/composition.rs — shutdown_lane_with_deadline spawns a thread but discards the JoinHandle. On RecvTimeoutError::Timeout the spawned thread continues unobserved with no log or join. Fix: store and unconditionally join the JoinHandle after recv_timeout. Identical pattern to FTQ-014 (same function in S.2 composition.rs) fixed in TASK-1161 on S.2 at 8421917. The S.2 merge-forward at 8b17139 did NOT propagate this fix — S.3's copy of shutdown_lane_with_deadline at :379 still discards the handle. Must be fixed directly on S.3. (quality-mgr reported as RSH-006 in S.3 QA-2 report; remapped to RSH-010; confirmed STILL_OPEN in S.3 QA-4 at 8b17139 line 379.)" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "followup_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-09T13:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-05-09T14:00:00Z"^^xsd:dateTime ;
  triage:closedBy "TASK-1164" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-010/s3/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-010/s3/2> ;
