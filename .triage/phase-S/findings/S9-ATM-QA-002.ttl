<urn:atm:triage:finding/S9-ATM-QA-002>
  a triage:Finding ;
  triage:findingId "S9-ATM-QA-002" ;
  triage:title "DaemonObservability composition path resolves log root from atm_home()" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs:82 and crates/atm-daemon/src/composition.rs:500 — DaemonObservability gets home_dir from atm_home() via compose_runtime(). Same ATM_HOME-independence violation as ATM-QA-001: when ATM_HOME is set the daemon log root becomes {ATM_HOME}/.atm/logs/ instead of the OS user home. Violates sprint-S9 §1.3, ADR-011, REQ-P-OBS-002. Fix: resolve daemon log root from home::host_log_dir() or home::resolve_user_home() directly, not from atm_home()." ;
  triage:category "REQ" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T02:30:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s9-logging-defaults" ;
  triage:promoteToBranch "feature/pS-s9-logging-defaults" ;
