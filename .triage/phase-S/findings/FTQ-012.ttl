<urn:atm:triage:finding/FTQ-012>
  a triage:Finding ;
  triage:findingId "FTQ-012" ;
  triage:title "IsoTimestamp::now() tight-loop nondeterministic eviction on low-resolution clocks (S.2 tests.rs:502)" ;
  triage:description "crates/atm-daemon/src/tests.rs:502 — test uses IsoTimestamp::now() in a tight loop to generate timestamps for eviction. On low-resolution clocks (Windows, some CI environments), successive now() calls may return identical timestamps, making the eviction candidate nondeterministic among equal-timestamp entries. Use synthetic timestamps with distinct values instead. (quality-mgr reported as FTQ-005-S2; remapped FTQ-012 to avoid conflict with existing phase-S FTQ-005 = fixed temp_dir path.)" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T08:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-012/s2/1> ;
