  a triage:Finding ;
  triage:findingId "ATM-QA-012" ;
  triage:title "_host_ownership field name implies held singleton lock but acquisition happens in bind()" ;
  triage:description "crates/atm-daemon/src/composition.rs:115-118 — _host_ownership field name implies the struct holds a singleton lock, but the actual acquisition happens in bind(). Fix: rename to _host_ownership_adapter to clarify the binding-time semantics." ;
