  a triage:Finding ;
  triage:findingId "S14-FTQ-004" ;
  triage:title "SHUTDOWN_FINALIZER_THREADS not drained after compose_runtime_start tests" ;
  triage:description "runtime_health.rs:44 SHUTDOWN_FINALIZER_THREADS static Vec is populated during compose_runtime_start tests but not drained when those tests complete. Stale JoinHandles accumulate across test runs causing inter-test interference. QA report ID: FTQ-006 (sprint-scoped to S14-FTQ-004 to avoid collision with prior FTQ-006 triage record)." ;
