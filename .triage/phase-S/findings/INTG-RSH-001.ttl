<urn:atm:triage:finding/INTG-RSH-001>
  a triage:Finding ;
  triage:findingId "INTG-RSH-001" ;
  triage:title "ReconcileRuntime::shutdown() unconditional join — same class as fixed S9-RSH-001/007" ;
  triage:description "reconcile_runtime.rs:235 — ReconcileRuntime::shutdown() calls handle.join() unconditionally with no deadline. Same class as S9-RSH-001 (run_bounded_shutdown_step) and S9-RSH-007 (WatchRuntime). Outer composition.rs deadline masks the symptom but leaves inner join thread leaked on timeout. Fix: apply bounded-shutdown pattern — mpsc::sync_channel join-helper + recv_timeout(RECONCILE_SHUTDOWN_DEADLINE) + drop(join_helper) on timeout." ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:triageMode "integration_gate" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
