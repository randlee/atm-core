<urn:atm:triage:finding/S11-QA1-004>
  a triage:Finding ;
  triage:findingId "S11-QA1-004" ;
  triage:title "sprint-S11.md silent on ADR-011 overlap-exclusion rule scope decision" ;
  triage:description "Two tests added in this sprint document that ADR-011 overlap checks (daemon-overlap, claude-directory) are deliberately skipped. sprint-S11.md (lines 31-34) references ADR-011 but is silent on whether these overlap rules are deferred, retracted, or out of scope. Fix: update sprint-S11.md to explicitly state the ADR-011 overlap-exclusion rules are out of scope for S.11 because overlap checks require HOME resolution (which defeats the headless scenario), and reference the ADR amendment that documents this." ;
  triage:category "DOC" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
