<urn:atm:triage:finding/ATM-QA-015>
  a triage:Finding ;
  triage:findingId "ATM-QA-015" ;
  triage:title "Accept-loop uses 25ms sleep back-off; no deterministic readiness signal for test harnesses" ;
  triage:description "local_ipc_transport.rs accept-loop uses thread::sleep(SHUTDOWN_POLL_INTERVAL) with SHUTDOWN_POLL_INTERVAL = Duration::from_millis(25). No deterministic readiness signal is exposed to test harnesses. Sprint acceptance criteria requires explicit synchronization for same-host test coverage." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-S" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;
