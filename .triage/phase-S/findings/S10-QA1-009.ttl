<urn:atm:triage:finding/S10-QA1-009>
  a triage:Finding ;
  triage:findingId "S10-QA1-009" ;
  triage:title "ADR-011 non-blocking write constraint for JsonlFileSink not documented or verified" ;
  triage:description "ADR-011 §Implementation Constraints requires retained-log writes to not block async executor threads (must use dedicated sync writer thread or explicit blocking task boundary). The implementation uses JsonlFileSink from sc-observability 1.0.0 (external dependency). Whether JsonlFileSink uses a dedicated sync writer thread is opaque from this codebase. Document in daemon_observability.rs or docs/atm-daemon/logging.md that JsonlFileSink satisfies the ADR-011 non-blocking write constraint, citing the sc-observability version and the specific mechanism." ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
