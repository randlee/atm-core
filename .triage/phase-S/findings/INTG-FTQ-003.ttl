<urn:atm:triage:finding/INTG-FTQ-003>
  a triage:Finding ;
  triage:findingId "INTG-FTQ-003" ;
  triage:title "Timing assertion in watch_runtime_times_out_when_worker_stops_making_progress" ;
  triage:description "watch_runtime.rs:600 — health timeout is 10ms x 5 = 50ms condvar wait. Spurious condvar wakes on loaded kernels can return timed_out()=false before 50ms, causing loop re-entry or poll() returning Ok when Err expected. Fix: increase poll_interval to 500ms (2.5s health window) or use channel-based blocking poller that cannot be spuriously woken." ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "integration_gate" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
