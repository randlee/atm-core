<urn:atm:triage:finding/S8-ATM-QA-001>
  a triage:Finding ;
  triage:findingId "S8-ATM-QA-001" ;
  triage:title "Missing REQ-CORE-COMPAT-001 citation in config module docs" ;
  triage:description "docs/atm-core/modules/config.md added in S.8 does not cite REQ-CORE-COMPAT-001, which is the governing requirement for the JSONL body export limit. The file describes parsing and validation of [atm].claude_jsonl_body_export_max_bytes and its 128 KiB default, and lists several related REQ citations, but REQ-CORE-COMPAT-001 is absent. Sprint-S8.md lists this requirement as a primary deliverable driver. Traceability gap: the implementation doc does not link back to the governing requirement, breaking the sprint-level traceability chain." ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
