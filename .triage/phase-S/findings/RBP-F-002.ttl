@prefix triage: <https://atm-core.dev/triage/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

triage:RBP-F-002 a triage:Finding ;
    triage:finding_id "RBP-F-002" ;
    triage:title "Missing Mutex lock-rationale comment in lifecycle_control.rs" ;
    triage:description "Mutex usage in crates/atm-daemon/src/lifecycle_control.rs lacks a rationale comment explaining the invariant it protects. Required by Rust best practices for non-trivial lock usage." ;
    triage:severity "minor" ;
    triage:category "RBP" ;
    triage:phase_id "phase-S" ;
    triage:triage_mode "initial_pass" ;
    triage:file_filter "lifecycle_control" ;
    triage:sweep_scope "file_only" ;
    triage:pattern "Mutex::new|Arc<Mutex" ;

    triage:worktree_result [
        triage:branch "feature/pS-s6-runtime-remediation" ;
        triage:head_sha "b80f16a" ;
        triage:order_index "1"^^xsd:integer ;
        triage:occurrence "absent" ;
        triage:note "LifecycleStateChange.generation field at lines 23-26 has a rationale comment: 'The generation counter is guarded so waiters and signal hooks can observe an ordered wake sequence without relying on lossy edge-triggered polling alone.' Finding is resolved in this worktree."
    ] ;
    triage:worktree_result [
        triage:branch "integrate/phase-S" ;
        triage:head_sha "3f67133" ;
        triage:order_index "2"^^xsd:integer ;
        triage:occurrence "present" ;
        triage:note "LifecycleStateChange.generation field at line 24 has no rationale comment. The integrate/phase-S version of lifecycle_control.rs lacks the explaining comment present in feature/pS-s6."
    ] ;

    triage:highest_open_branch "integrate/phase-S" ;
    triage:promote_to_branch "integrate/phase-S" ;
    triage:dispatch_ready "true"^^xsd:boolean ;
    triage:resolution "open" ;
    triage:triage_date "2026-05-09"^^xsd:date .
