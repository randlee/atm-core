<urn:atm:triage:finding/S12-QA1-008>
  a triage:Finding ;
  triage:findingId "S12-QA1-008" ;
  triage:title "Triage records not updated to closed status; acceptance criteria missing closure requirement" ;
  triage:description "docs/phase-S/sprint-S12.md:59-65 (acceptance criteria): The sprint acceptance criteria do not include a requirement to update triage record status fields to triage:status 'closed' and triage:closed true for each resolved INTG finding. The triage records (.triage/phase-S/findings/INTG-FTQ-001.ttl through INTG-RSH-004.ttl) all have status 'open' and closed false at bd9e0e8. The project's triage methodology requires triage records to be maintained as machine-readable truth. Fix: update the acceptance criteria in sprint-S12.md to include triage record closure. Then update each resolved INTG finding TTL file to triage:status 'closed' / triage:closed true / triage:headSha 'bd9e0e8' / triage:closedAt before merging to integrate/phase-S." ;
  triage:category "DOC" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
