# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RBP-F004>
  a triage:Finding ;
  triage:findingId "RBP-F004" ;
  triage:title "RBP-001: Lock-poison errors missing with_recovery() call in watch_runtime" ;
  triage:description "crates/atm-daemon/src/watch_runtime.rs — Lock-poison errors handled via map_err or manual match but not chained with .with_recovery(). Affected lock sites: start() line 179 (.state.lock()), start() line 196 (.worker.lock()), shutdown() line 212 (.state.lock()), shutdown() line 221 (.worker.lock()), poll() line 265 (.state.lock()). Fix: chain .with_recovery() on lock acquisition to provide actionable recovery hints consistent with project convention." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-S" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F004/pS-s13/1> ;
