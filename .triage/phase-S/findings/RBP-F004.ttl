# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RBP-F004>
  a triage:Finding ;
  triage:findingId "RBP-F004" ;
  triage:title "signal-hook listed as unconditional dependency; should be platform-gated to cfg(unix)" ;
  triage:description "crates/atm-daemon/Cargo.toml lists signal-hook as an unconditional dependency. It is a Unix-only crate and must be gated under [target.'cfg(unix)'.dependencies] to avoid pulling Unix-only code into Windows builds." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-S" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
