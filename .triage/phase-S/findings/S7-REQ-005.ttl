<urn:atm:triage:finding/S7-REQ-005>
  a triage:Finding ;
  triage:findingId "S7-REQ-005" ;
  triage:title "wait.rs and workflow.rs missing from QA review targets" ;
  triage:description "Sprint S.7 Required Code Targets (sprint-S7.md) lists crates/atm-core/src/read/wait.rs and crates/atm-core/src/workflow.rs as required targets. Neither file appears in the sprint commit diff (git show 9c01bca --stat). The files were not changed in this sprint so they were absent from QA review targets as a consequence of the scope-narrowing that occurs when files are unchanged. However, the sprint plan listed them as required targets, implying they should have been touched (e.g. to align workflow.rs with REQ-CORE-WORKFLOW-001 or to update wait.rs for the new single-message read path). The absence requires investigation: either the sprint spec over-specified required targets and these files were correctly left untouched, or the work items touching those files were inadvertently skipped. This should be resolved before merge." ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
