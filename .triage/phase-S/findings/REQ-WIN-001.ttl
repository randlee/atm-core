    triage:hasOccurrence <urn:atm:triage:occurrence/REQ-WIN-001/integrate-phase-S/3> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/REQ-WIN-001/integrate-phase-S/4> ;

    # Branch-level topology
