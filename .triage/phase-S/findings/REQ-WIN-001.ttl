# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/REQ-WIN-001>
    a triage:Finding ;
    triage:findingId "REQ-WIN-001" ;
    triage:title "Windows IPC transport is a stub — WIN-001 not closed" ;
    triage:description "Every entry point in crates/atm-daemon/src/local_ipc_transport_windows.rs returns unsupported_local_ipc_error() unconditionally. Error string says 'not available on Windows in Phase S.1'. Windows graceful-shutdown never executes. Violates REQ-P-PLATFORM-002, ADR-007, sprint-S6 acceptance criteria §3. The file is absent from feature/pS-s6-runtime-remediation (fixed — replaced by full local_ipc_transport.rs implementation) but present on integrate/phase-S with 4 stub occurrences." ;
    triage:category "REQ" ;
    triage:phaseId "phase-S" ;
    triage:triageMode "initial_pass" ;
    triage:severity "blocking" ;
    triage:repeatable true ;
    triage:sweepScope "crate" ;
    triage:status "open" ;
    triage:highestOpenBranch "integrate/phase-S" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;

    # Occurrences on open branches
