<urn:atm:triage:finding/RSH-NEW-001>
  a triage:Finding ;
  triage:findingId "RSH-NEW-001" ;
  triage:title "Detached thread handle not tracked — schedule_delayed_listener_wake" ;
  triage:description "fn schedule_delayed_listener_wake at local_ipc_transport.rs:665 spawns a thread via thread::spawn but discards the JoinHandle. Combined with RSH-001-OPEN (missing thread::Builder name), the thread is fully untracked: no name in panic backtraces, no join path. Fix: use thread::Builder::new().name(\"delayed-listener-wake\") and store handle in a per-call slot or log-on-drop wrapper. If join is impractical, at minimum name the thread for diagnostics. RSH-001-OPEN covers the Builder requirement; this finding covers the handle-tracking gap." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:rule "RSH" ;
  triage:triageMode "followup_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
