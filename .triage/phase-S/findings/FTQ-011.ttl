<urn:atm:triage:finding/FTQ-011>
  a triage:Finding ;
  triage:findingId "FTQ-011" ;
  triage:title "signal-hook flag leak on panic path at lifecycle_control.rs:80 (S.2)" ;
  triage:description "crates/atm-daemon/src/lifecycle_control.rs:80 — signal-hook AtomicBool flag is not reset if the test panics before teardown. Flag remains set, affecting subsequent tests in the same process. Use RAII Drop guard to ensure reset on both normal exit and panic. (quality-mgr reported as FTQ-003-S2; remapped FTQ-011 to avoid conflict with existing phase-S FTQ-003 = lifecycle flags on integrate/phase-S.)" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
