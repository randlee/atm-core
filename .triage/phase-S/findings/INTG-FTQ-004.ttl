<urn:atm:triage:finding/INTG-FTQ-004>
  a triage:Finding ;
  triage:findingId "INTG-FTQ-004" ;
  triage:title "TOCTOU race in reconcile_runtime_coalesces_duplicate_requests" ;
  triage:description "reconcile_runtime.rs:532 — test spawns first thread, waits for pending_count=1, spawns second. If debounce (250ms) fires before second arrives, executor runs twice and assert_eq!(*calls, 1) fails. Fix: use blocking executor gate; hold worker inside first execution until both first and second are pending (wait_for_pending_count=2) before releasing." ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "integration_gate" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
