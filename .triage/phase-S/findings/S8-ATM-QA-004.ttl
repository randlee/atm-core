<urn:atm:triage:finding/S8-ATM-QA-004>
  a triage:Finding ;
  triage:findingId "S8-ATM-QA-004" ;
  triage:title "reconcile_runtime tests use fake ingress — no no-churn proof at reconcile-runtime level" ;
  triage:description "All reconcile_runtime tests (reconcile_runtime.rs lines 482-688+) wire a FakeInboxIngress whose import_inbox_source always returns source_files: Vec::new(). This fully decouples the reconcile-runtime test harness from any real ingress behaviour. ADR-010-claude-jsonl-compatibility-envelope.md establishes the no-churn rule: re-observing a retrieval-stub projection for the same message must not create a new-mail churn loop. The existing tests prove coalescing, shutdown, executor-failure propagation, trigger ordering, and notification routing — all at the runtime dispatch layer — but none construct a scenario in which the ingress returns a retrieval-stub projection for a previously-seen message ID and then verify that no churn notification is emitted. The no-churn invariant is therefore proven only at the store layer (store.rs identity fingerprint / idempotent commit tests). It is unproven at the reconcile-runtime integration boundary where the watcher, ingress, and runtime interact end-to-end." ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:promoteTo "feature/pS-s8-jsonl-compat" ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S8-ATM-QA-004/s8/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s8-jsonl-compat/48109b8> .

