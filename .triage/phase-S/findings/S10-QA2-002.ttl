<urn:atm:triage:finding/S10-QA2-002>
  a triage:Finding ;
  triage:findingId "S10-QA2-002" ;
  triage:title "tracing::warn! at daemon_observability.rs:494 is a permanent silent no-op — not documented" ;
  triage:description "After init_tracing() removal, no global tracing subscriber is installed in atm-daemon. The tracing::warn! call at daemon_observability.rs:494 (in level_for_outcome for unknown outcomes) is a permanent silent no-op in production with no code comment acknowledging this. Fix: either add an inline comment stating that no global tracing subscriber is installed and warn! is intentionally a no-op (lifecycle events route exclusively through emit_runtime_event()), or replace the tracing::warn! with an explicit emit path or eprintln! for unknown outcomes." ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
