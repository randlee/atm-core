<urn:atm:triage:finding/RSH-S15-002>
  a triage:Finding ;
  triage:findingId "RSH-S15-002" ;
  triage:title "lifecycle_control.rs:245 shutdown_worker_with_timeout join_helper not stored on timeout — leaks until process exit" ;
  triage:description "lifecycle_control.rs:245 — shutdown_worker_with_timeout drops the join_helper on timeout without storing it anywhere. The Timeout arm of the match on result_rx.recv_timeout returns an Err without calling join_helper.join() or storing the handle, so the helper thread leaks until process exit. The Ok(Ok(())), Ok(Err(_)), and Disconnected arms all join, but the Timeout arm does not." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-S15-002/pS-s14-impl/1> ;
