<urn:atm:triage:finding/S10-QA1-013>
  a triage:Finding ;
  triage:findingId "S10-QA1-013" ;
  triage:title "TOCTOU exists() check before open() in best_effort_flush_blocking" ;
  triage:description "daemon_observability.rs:115 performs an exists() check on the log file before open()/flush(). Between the check and the open(), the file can be deleted or rotated — a TOCTOU race. Eliminate the exists() guard; instead attempt open() directly and handle the NotFound error case explicitly. This makes the pattern atomic with respect to filesystem state." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s10-daemon-retained-logger" ;
  triage:promoteToBranch "feature/pS-s10-daemon-retained-logger" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S10-QA1-013/s10/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s10-daemon-retained-logger/320b658> .

