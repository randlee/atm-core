@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/S15-FTQ-007>
  a triage:Finding ;
  triage:findingId "S15-FTQ-007" ;
  triage:title "ATM_HOME env race window between compose_runtime and daemon_socket_path" ;
  triage:description "tests.rs compose_runtime_start_writes_retained_log_and_reports_healthy_observability calls daemon_socket_path() twice: once inside compose_runtime() -> LocalIpcServerTransportAdapter::prepare_runtime() (local_ipc_transport.rs:598) and again explicitly on line 210. EnvGuard clears ATM_DAEMON_SOCKET (line 196) so the override path is not taken, but both calls re-read ATM_HOME independently from the environment. A concurrent mutation of ATM_HOME between the two reads (e.g. via another serial test's EnvGuard Drop interleaving on a thread scheduler context-switch) can cause the socket path captured by compose_runtime to differ from the socket_path used by connect_daemon_local_ipc_until_ready. The #[serial] attribute serializes test entry but does not eliminate intra-test ATM_HOME mutation by background threads. The correct fix is to call daemon_socket_path() once before compose_runtime, capture the result, pass it to prepare_runtime_at_socket_path(), and use the same PathBuf on line 210 — matching the local_ipc_runtime_round_trips_doctor_requests_on_shared_transport pattern (lines 117-121)." ;
  triage:triageMode "followup_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-S" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:followupAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:followupHeadSha "a7ecacc" ;
  triage:followupVerdict "STILL OPEN — ATM_DAEMON_SOCKET guard added (line 196) prevents override-path contamination but does not eliminate the two-call pattern; daemon_socket_path() is called inside compose_runtime (local_ipc_transport.rs:598) and again on line 210, each re-reading ATM_HOME independently; race window survives" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S15-FTQ-007/pS-s14-impl/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S15-FTQ-007/pS-s15-rusqlite-hardening/2> ;
  triage:openOn <urn:atm:triage:worktree/pS-s14-impl/571fa1c> ;
  triage:openOn <urn:atm:triage:worktree/pS-s15-rusqlite-hardening/a7ecacc> ;
  triage:promoteTo <urn:atm:triage:worktree/pS-s15-rusqlite-hardening/a7ecacc> .

