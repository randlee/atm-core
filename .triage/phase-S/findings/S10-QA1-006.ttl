<urn:atm:triage:finding/S10-QA1-006>
  a triage:Finding ;
  triage:findingId "S10-QA1-006" ;
  triage:title "Dual-path event routing — tracing macros to stderr, emit_runtime_event to retained log" ;
  triage:description "DaemonObservability does not bridge tracing::info!/warn!/error! to the sc-observability Logger. Lifecycle events emitted via tracing macros route to the legacy stderr subscriber (from init_tracing()); only events emitted explicitly via emit_runtime_event() reach ~/.atm/logs/atm.log.jsonl. Sprint S.10 requires lifecycle events to 'reach ~/.atm/logs/atm.log.jsonl'. Fixing S10-QA1-003 (remove init_tracing()) is necessary but not sufficient unless sc-observability provides a tracing subscriber bridge layer. Root-cause shared with S10-QA1-003." ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s10-daemon-retained-logger" ;
  triage:promoteToBranch "feature/pS-s10-daemon-retained-logger" ;
