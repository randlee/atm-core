# ============================================================
# FTQ-005 — Fixed temp_dir().join("atm-reconcile-test") path
#            in test helpers causes parallel-test collision
# Phase: phase-S  |  Mode: initial_pass  |  Severity: minor
# ============================================================

<urn:atm:triage:finding/FTQ-005>
  a triage:Finding ;
  triage:findingId "FTQ-005" ;
  triage:title "Fixed temp_dir().join(\"atm-reconcile-test\") path in test helpers causes parallel-test collision" ;
  triage:description "reconcile_runtime.rs test helpers use temp_dir().join(\"atm-reconcile-test\") — a fixed path shared across parallel test instances, causing test collision under cargo test --jobs > 1." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-S" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
  triage:pattern "atm-reconcile-test|temp_dir.*atm-" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-005/pS-s1/1> ;
