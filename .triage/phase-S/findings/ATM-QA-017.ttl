@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ATM-QA-017: Two-lock handoff (launch.lock → owner.lock) undocumented on daemon side
#
# Relation to ATM-QA-009:
#   ATM-QA-009 tracks the broader cross-component split: that the two-lock
#   protocol is not explained at either the client (composition.rs) or daemon
#   (host_ownership.rs) constant-declaration sites.
#
#   ATM-QA-017 is a distinct, more targeted concern: the ADR-002 acquisition
#   sequence comment is absent at the *actual acquire_at call site* in the daemon
#   (HostOwnershipAdapter::acquire_at / SingletonGuard::acquire_at), where the
#   ordering guarantee (launch.lock held by caller before owner.lock is requested
#   here) must be stated to prevent future ordering violations.
#
#   ATM-QA-009 occurrence /pS-s1/3 and /pS-s2/3 record the constant-declaration
#   line (host_ownership.rs:11). This record tracks the acquire_at function body,
#   a different location with a different documentation requirement.
#
# Structural note on pS-s4 / integrate/phase-S:
#   host_ownership.rs was refactored away in pS-s4; ownership logic now lives in
#   lib.rs as SingletonGuard::acquire_at (line ~274). The ADR-002 protocol comment
#   is absent there too, so pS-s4 and integrate/phase-S carry the same gap at a
#   different file/line.

<urn:atm:triage:finding/ATM-QA-017>
  a triage:Finding ;
  triage:findingId "ATM-QA-017" ;
  triage:title "Two-lock handoff (launch.lock → owner.lock) undocumented on daemon side" ;
  triage:description "The two-lock acquisition sequence required by ADR-002 (launch.lock held by caller before owner.lock is acquired by the daemon) has no explanatory comment at the daemon-side acquire_at call site. On pS-s1/pS-s2/pS-s3 this is HostOwnershipAdapter::acquire_at in host_ownership.rs; on pS-s4/integrate-phase-S the same gap exists at SingletonGuard::acquire_at in lib.rs (following the host_ownership.rs → lib.rs refactor). Distinct from ATM-QA-009, which tracks the constant-declaration and cross-component split documentation gap." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;
  triage:relatedFinding "ATM-QA-009" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-017/pS-s1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-017/pS-s2/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-017/pS-s3/1> ;
