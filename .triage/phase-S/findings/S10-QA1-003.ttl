<urn:atm:triage:finding/S10-QA1-003>
  a triage:Finding ;
  triage:findingId "S10-QA1-003" ;
  triage:title "init_tracing() legacy stderr subscriber retained alongside new sc-observability adapter" ;
  triage:description "Sprint S.10 §1 requires 'replacing' the stderr-only tracing_subscriber setup. The implementation at main.rs:20-28 retains init_tracing() called AFTER bootstrap_observability(), creating two active event-routing paths simultaneously: the sc-observability retained-file sink and the legacy tracing_subscriber stderr sink. This contradicts the sprint requirement. Remove init_tracing() from main.rs; DaemonObservability already handles log-level configuration via ATM_LOG. Closes S10-QA1-006, S10-QA1-015, S10-QA1-016." ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
