<urn:atm:triage:finding/RSH-005>
  a triage:Finding ;
  triage:findingId "RSH-005" ;
  triage:title "SIGTERM registered on Windows but never delivered by SCM or taskkill — dead code" ;
  triage:description "lifecycle_control.rs:94 — SIGTERM is registered via signal_hook on Windows. Windows does not deliver SIGTERM via the Service Control Manager or taskkill. Only CTRL_C_EVENT and CTRL_BREAK_EVENT are delivered to console processes. The SIGTERM handler on Windows is dead code and may create false confidence in graceful shutdown coverage." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-S" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-005/pS-s3-runtime-control/1> ;
