<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "WatchFailureSnapshot::to_error() discards original AtmErrorCode" ;
  triage:description "watch_runtime.rs:62 — WatchFailureSnapshot struct omits AtmErrorCode field; to_error() reconstructs AtmError via AtmError::daemon_unavailable() hardcoding the error code, discarding the original code from the captured AtmError." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
