<urn:atm:triage:finding/S8-QA2-003>
  a triage:Finding ;
  triage:findingId "S8-QA2-003" ;
  triage:title "Undocumented 1 MiB upper cap for claude_jsonl_body_export_max_bytes not in ADR-010" ;
  triage:description "config/types.rs defines MAX_CLAUDE_JSONL_BODY_EXPORT_MAX_BYTES = 1_048_576 (1 MiB) as an upper cap on claude_jsonl_body_export_max_bytes. This constraint does not appear in ADR-010 (which defines only the 128 KiB default and 0=stub-only semantics) nor in sprint-S8.md acceptance criteria. The error recovery message in mod.rs:296 references '1048576 bytes'. This is undocumented behavior — any consumer who sets a value above 1 MiB will receive a silent clamp or error with no documented justification. Fix: document the 1 MiB ceiling in ADR-010 §Validation with rationale, or remove the cap if unintentional." ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
