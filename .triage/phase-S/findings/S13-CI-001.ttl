# --- s13 occurrences (46069a9) ---

<urn:atm:triage:occurrence/S13-CI-001/s13/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/tests.rs" ;
  triage:line 28 ;
  triage:snippet "use interprocess::local_socket::traits::Stream as _; — ungated; on Windows this import is unused (warnings-as-errors) because all consuming test functions are #[cfg(unix)]-gated; fix: add #[cfg(unix)] gate" ;
  triage:status "open" ;
  triage:closed false ;
  triage:headSha "46069a9" ;
  triage:branch "feature/pS-s13-ipc-hardening" ;
  triage:occursIn <urn:atm:triage:worktree/feature-pS-s13-ipc-hardening/46069a9> .

<urn:atm:triage:occurrence/S13-CI-001/s13/2>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/tests.rs" ;
  triage:line 114 ;
  triage:snippet "fn connect_daemon_local_ipc_until_ready(endpoint_path: &std::path::Path) -> LocalSocketStream { — ungated helper function; LocalSocketStream (line 27) is #[cfg(unix)]-gated so its type is not in scope on Windows causing E0412; fix: add #[cfg(unix)] gate to the function" ;
  triage:status "open" ;
  triage:closed false ;
  triage:headSha "46069a9" ;
  triage:branch "feature/pS-s13-ipc-hardening" ;
  triage:occursIn <urn:atm:triage:worktree/feature-pS-s13-ipc-hardening/46069a9> .

