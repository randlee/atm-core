@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/S13-CI-001>
  a triage:Finding ;
  triage:findingId "S13-CI-001" ;
  triage:title "Ungated Unix-only test imports — cfg(unix) gate pattern" ;
  triage:description "Windows clippy reports unused imports and not-in-scope errors for Unix-only test items in crates/atm-daemon/src/tests.rs and crates/atm-daemon/src/local_ipc_transport.rs. FIX-R7 gated 4 locations in the local_ipc_transport.rs test module; two locations in tests.rs remain ungated at 46069a9. (1) tests.rs:28 — 'use interprocess::local_socket::traits::Stream as _' is not gated by #[cfg(unix)]; on Windows this is an unused import (warnings-as-errors). (2) tests.rs:114 — fn connect_daemon_local_ipc_until_ready returns LocalSocketStream (the type at line 27 is #[cfg(unix)]-gated); on Windows, LocalSocketStream is not in scope, causing E0412. Both items must be gated with #[cfg(unix)]. Pattern is repeatable across all open branches because s14 and s15 both merged s13's state." ;
  triage:category "CI" ;
  triage:severity "blocking" ;
  triage:triageMode "followup_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T12:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s15-rusqlite-hardening" ;
  triage:promoteToBranch "feature/pS-s15-rusqlite-hardening" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S13-CI-001/s13/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S13-CI-001/s13/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S13-CI-001/s14/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S13-CI-001/s14/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S13-CI-001/s15/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S13-CI-001/s15/2> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s13-ipc-hardening/46069a9> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s14-impl/3da95f8> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s15-rusqlite-hardening/803d446> ;
