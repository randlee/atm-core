<urn:atm:triage:finding/RSH-F-001>
  a triage:Finding ;
  triage:findingId "RSH-F-001" ;
  triage:title "Bare Condvar::wait() at lifecycle_control.rs:62 — unbounded block violates SCB-RUNTIME-001" ;
  triage:description "crates/atm-daemon/src/lifecycle_control.rs:62 uses bare Condvar::wait() with no timeout. This blocks the thread indefinitely if the notify never fires. Must be replaced with wait_timeout_while(30s) per SCB-RUNTIME-001. The fix is already present on feature/pS-s6-runtime-remediation (wait_timeout_while with LIFECYCLE_WAIT_TIMEOUT = 30s); the violation persists on integrate/phase-S pending merge. The occurrence in crates/sc-lint-boundary/src/tests.rs:714 is an intentional test-fixture string literal verifying lint detection — not a real production violation." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "integrate/phase-S" ;
  triage:promoteToBranch "feature/pS-s6-runtime-remediation" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-F-001/integrate-phase-S/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-F-001/integrate-phase-S/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-F-001/s6/1> ;
  triage:openOn <urn:atm:triage:worktree/integrate-phase-S/3f67133> .

