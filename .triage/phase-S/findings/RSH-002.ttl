<urn:atm:triage:finding/RSH-002>
  a triage:Finding ;
  triage:findingId "RSH-002" ;
  triage:title "run_bounded_shutdown_step() drops thread handle on deadline — SQLite WAL checkpoint orphan risk" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs — run_bounded_shutdown_step() intentionally drops the thread join handle when the deadline is exceeded, orphaning the thread. For the SQLite WAL checkpoint case this is higher-risk. Existing comment documents intentional detach but does not call out WAL-specific risk. Fix: extend comment to explicitly acknowledge WAL checkpoint orphan risk and why it is accepted, or add a best-effort join before drop." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
