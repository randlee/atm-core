# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/WIN-001>
    a triage:Finding ;
    triage:findingId "WIN-001" ;
    triage:title "Windows daemon has no graceful shutdown path" ;
    triage:description "install_platform_hooks at crates/atm-daemon/src/lifecycle_control.rs:86-92 is a silent no-op on Windows. The terminate_requested() AtomicBool is never set via OS signals or Ctrl+C on Windows. The accept loop at crates/atm-daemon/src/local_ipc_transport.rs:222 polls this flag as its only exit trigger. Windows daemon runs until forcibly killed. SetConsoleCtrlHandler (or equivalent) must be implemented to set the flag on CTRL_C/CTRL_BREAK/CTRL_CLOSE events." ;
    triage:category "WIN" ;
    triage:phaseId "phase-S" ;
    triage:triageMode "initial_pass" ;
    triage:severity "critical" ;
    triage:repeatable true ;
    triage:sweepScope "file" ;
    triage:status "regressed" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;

    # Occurrences on open branches
    triage:hasOccurrence <urn:atm:triage:occurrence/WIN-001/pS-s1/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/WIN-001/pS-s1/2> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/WIN-001/pS-s2/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/WIN-001/pS-s2/2> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/WIN-001/pS-s4/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/WIN-001/integrate-phase-S/1> ;

    # Branch-level topology
    triage:openOn <urn:atm:triage:worktree/pS-s1/ab12ea1> ;
    triage:openOn <urn:atm:triage:worktree/pS-s2/a7f8039> ;
