<urn:atm:triage:finding/S9-ATM-QA-010>
  a triage:Finding ;
  triage:findingId "S9-ATM-QA-010" ;
  triage:title "new_adapter_port() duplicates ATM_LOG_DIR env-var check inline — partial bypass of host_log_dir() validation path" ;
  triage:description "crates/atm/src/main.rs:680 — new_adapter_port() re-checks std::env::var_os(\"ATM_LOG_DIR\") inline to decide whether to call host_log_dir() or host_log_dir_from_home(home_dir) directly. When ATM_LOG_DIR is unset this bypasses resolve_user_home() and uses a caller-supplied home_dir instead. In production this is called correctly, but the inline branch duplicates the env-check already inside host_log_dir() and diverges from the canonical path. Test helpers that call new_adapter_port() with a temp home_dir while ATM_LOG_DIR is unset use the raw fallback path, not the fully-validated host_log_dir() path. Minor architectural inconsistency; no current security impact. Fix: consider delegating entirely to host_log_dir() or host_log_dir_from_home() without the inline env-var branch, or document the intentional deviation." ;
  triage:category "ATM-QA" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
