<urn:atm:triage:finding/S10-QA1-011>
  a triage:Finding ;
  triage:findingId "S10-QA1-011" ;
  triage:title "query() and follow() unavailability not documented in daemon requirements" ;
  triage:description "DaemonObservability.query() and .follow() at daemon_observability.rs:152-171 return typed Err (observability_query / observability_follow) indicating those surfaces are unavailable in the daemon. Neither sprint-S10.md nor docs/atm-daemon/requirements.md explicitly lists query/follow unavailability as an accepted limitation for S.10. Add a note to docs/atm-daemon/requirements.md REQ-DAEMON-OBS-001/002 section stating that query() and follow() are deferred to a later sprint, with log querying delegated to the CLI-owned log query surface." ;
  triage:category "DOC" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
