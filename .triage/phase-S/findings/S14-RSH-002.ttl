<urn:atm:triage:finding/S14-RSH-002>
  a triage:Finding ;
  triage:findingId "S14-RSH-002" ;
  triage:title "watch_runtime.rs:240 drop(join_helper) detaches panicked-worker join silently" ;
  triage:description "watch_runtime.rs:240 uses drop(join_helper) on RecvTimeoutError::Timeout — detaches the panicked-worker join handle, same as fire-and-forget. A tracing::warn! follows documenting the detach, but no inline comment on the drop() line itself marks this as a deliberate design decision." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-S" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
