  triage:hasOccurrence <urn:atm:triage:occurrence/S14-RSH-003/pS-s15-rusqlite-hardening/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S14-RSH-003/pS-s15-rusqlite-hardening/2> ;
