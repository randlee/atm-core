<urn:atm:triage:finding/S14-RSH-003>
  a triage:Finding ;
  triage:findingId "S14-RSH-003" ;
  triage:title "daemon_observability.rs:445 open-per-write pattern — OpenOptions::new().open() on every write" ;
  triage:description "daemon_observability.rs line 445 calls OpenOptions::new().open() inside the hot write path on every event write. A separate OpenOptions::new() call also appears at line 268 (initialization, not a write-path concern). Keeping the file handle open across writes would reduce syscall overhead on slow filesystems. QA report ID: RSH-004 (sprint-scoped to S14-RSH-003 to avoid collision with prior RSH-004 triage record)." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-S" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S14-RSH-003/pS-s14-impl/1> ;
