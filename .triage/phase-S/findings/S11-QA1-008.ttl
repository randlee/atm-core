<urn:atm:triage:finding/S11-QA1-008>
  a triage:Finding ;
  triage:findingId "S11-QA1-008" ;
  triage:title "env_lock() / LOCK static Mutex lacks doc comment explaining why interior mutability is required (RBP-006)" ;
  triage:description "home.rs:245-248: static LOCK: OnceLock<Mutex<()>> and fn env_lock() carry no doc comment justifying the Mutex. The SAFETY note on the unsafe set_var block references the mutex implicitly but not at the declaration point. A future maintainer cannot determine why a process-wide Mutex is required. Add a doc comment: 'Process-wide mutex that serializes std::env::set_var/remove_var calls in tests. Required because these functions are unsafe in multi-threaded processes; concurrent env mutation produces undefined behavior.'" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
