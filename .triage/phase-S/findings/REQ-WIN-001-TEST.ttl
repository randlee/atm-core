# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/REQ-WIN-001-TEST>
    a triage:Finding ;
    triage:findingId "REQ-WIN-001-TEST" ;
    triage:title "Windows lifecycle-control tests cover flag-sharing only — no transport shutdown integration test" ;
    triage:description "Tests at crates/atm-daemon/src/lifecycle_control.rs:313-373 (integrate/phase-S) verify flag-sharing only (windows_reload_flag_is_shared_across_install_calls, windows_terminate_flag_is_shared_across_install_calls). No test exercises the transport serve-loop shutdown contract on integrate/phase-S. Sprint S.6 §3.2 requires shutdown regression tests covering the Windows transport + LifecycleControlSourceAdapter shutdown path with deadline assertions. Fixed on feature/pS-s6-runtime-remediation: crates/atm-daemon/src/tests.rs:223-265 adds #[cfg(windows)] windows_local_ipc_runtime_terminate_finishes_within_deadline which exercises serve_with_runtime_hooks, triggers terminate via LifecycleControlSourceAdapter, and asserts completion within a 3-second deadline. Also adds windows_terminate_request_wakes_waiters in lifecycle_control.rs:375-401 validating the state-change wake path." ;
    triage:category "REQ" ;
    triage:phaseId "phase-S" ;
    triage:triageMode "initial_pass" ;
    triage:severity "blocking" ;
    triage:repeatable false ;
    triage:sweepScope "file_only" ;
    triage:status "fixed" ;
    triage:dispatchReady false ;
    triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;

    # Occurrences
    triage:hasOccurrence <urn:atm:triage:occurrence/REQ-WIN-001-TEST/pS-s6/1> ;
