<urn:atm:triage:finding/S7-RSH-F003>
  a triage:Finding ;
  triage:findingId "S7-RSH-F003" ;
  triage:title "contains_filter unbounded at IPC boundary" ;
  triage:description "crates/atm-core/src/list.rs:32 and crates/atm-core/src/read/mod.rs:46 declare contains_filter: Option<String> with no length constraint. The ListQuery and ReadQuery structs are serialized into RequestEnvelope and transmitted over the Unix socket IPC channel (see composition.rs send_request). On the server side, apply_contains_filter at read/filters.rs:43 calls to_ascii_lowercase() followed by contains() on each message body; an arbitrarily long needle causes O(n*m) substring matching work across all messages. A caller can send a multi-MB string as the filter, forcing the daemon into CPU-intensive work with no bound. A client-side cap (e.g. MAX_CONTAINS_FILTER_LEN = 1024) validated in ListQuery::new and ReadQuery::new before the request is dispatched would close this. The finding is present on the feature branch; integrate/phase-S ReadQuery has no contains_filter field, so the finding does not apply there." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s7-queue-query" ;
  triage:promoteToBranch "feature/pS-s7-queue-query" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-RSH-F003/s7/list/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-RSH-F003/s7/read/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s7-queue-query/9c01bca> .

