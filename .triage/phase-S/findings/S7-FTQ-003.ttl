<urn:atm:triage:finding/S7-FTQ-003>
  a triage:Finding ;
  triage:findingId "S7-FTQ-003" ;
  triage:title "Fixed 100ms sleep in wait.rs polling loop" ;
  triage:description "crates/atm-core/src/read/wait.rs — wait_for_eligible_message() uses a hardcoded poll_interval = Duration::from_millis(100) with thread::sleep(poll_interval) inside the polling loop. This makes test timing latent and environment-dependent: on slow CI runners the minimum observable wait time for any message is 100ms regardless of how quickly the message becomes available, and the total wait is non-deterministically padded by up to 100ms per poll iteration. The sleep is also a production-code concern: callers cannot tune the poll interval for low-latency or battery-sensitive contexts. Fix: make poll_interval configurable via a parameter or const, or replace the sleep-based poll with a filesystem-watch or channel-based notification so tests that need fast response are not bounded by the fixed interval." ;
  triage:category "FTQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-FTQ-003/s7/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s7-queue-query/9c01bca> .

