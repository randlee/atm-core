<urn:atm:triage:finding/S7-RBP-F005>
  a triage:Finding ;
  triage:findingId "S7-RBP-F005" ;
  triage:title "canonical_sender_identity in ack/mod.rs returns Option<AgentName> but always Some" ;
  triage:description "crates/atm-core/src/ack/mod.rs:397 — private canonical_sender_identity wraps crate::threading::canonical_sender_identity (which returns AgentName) in Some(…), making the Option return type misleading. Fix: change the return type to AgentName and update the call site at line 368 accordingly, or remove the wrapper and call threading::canonical_sender_identity directly." ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
