<urn:atm:triage:finding/S11-QA1-001>
  a triage:Finding ;
  triage:findingId "S11-QA1-001" ;
  triage:title "ADR-011 overlap-exclusion rules deliberately skipped — deviation not documented in ADR or sprint" ;
  triage:description "ADR-011:44-47 requires ATM_LOG_DIR must not overlap with ~/.atm/daemon/ and must not resolve under ~/.claude/. Two tests (host_log_dir_override_does_not_require_home_relative_claude_validation, host_log_dir_override_does_not_require_home_relative_daemon_overlap_validation) explicitly document these checks are skipped. Neither ADR-011 nor sprint-S11.md records this as an accepted deviation or retraction. Resolution: amend ADR-011 to acknowledge that overlap checks against home-relative paths cannot be performed in headless mode (HOME unknown) and are therefore skipped when ATM_LOG_DIR short-circuits before home_dir() resolution." ;
  triage:category "REQ" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s11-log-dir-override-order" ;
  triage:promoteToBranch "feature/pS-s11-log-dir-override-order" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S11-QA1-001/s11/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s11-log-dir-override-order/34bf2eb> .

