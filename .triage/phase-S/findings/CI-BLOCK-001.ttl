<urn:atm:triage:finding/CI-BLOCK-001>
  a triage:Finding ;
  triage:findingId "CI-BLOCK-001" ;
  triage:title "Ungated Unix-only test imports — DoctorQuery and EnvGuard" ;
  triage:description "crates/atm-daemon/src/tests.rs:13 imports DoctorQuery and line 22 imports atm_core::test_support::EnvGuard at module level but both are only used inside #[cfg(unix)] test blocks. Windows clippy reports unused import error. Same cfg(unix) gate pattern as existing finding S13-CI-001 (which covered tests.rs:28 and :114). These are new locations. (1) tests.rs:12-14 — the multi-line use atm_core::doctor::{..., DoctorQuery, ...} import is ungated; DoctorQuery is only used at lines 201, 269 which are inside #[cfg(unix)] test functions; on Windows this produces an unused import warning-as-error. (2) tests.rs:22 — use atm_core::test_support::EnvGuard is ungated; EnvGuard is only used at line 239 inside a #[cfg(unix)] test function; on Windows this produces an unused import warning-as-error. Fix: add #[cfg(unix)] gates to both import sites or restructure them into #[cfg(unix)] submodule." ;
  triage:category "CI" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s15-rusqlite-hardening" ;
  triage:promoteToBranch "feature/pS-s15-rusqlite-hardening" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-BLOCK-001/s13/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-BLOCK-001/s13/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-BLOCK-001/s14/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-BLOCK-001/s14/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-BLOCK-001/s15/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-BLOCK-001/s15/2> ;
