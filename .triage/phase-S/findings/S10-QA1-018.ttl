<urn:atm:triage:finding/S10-QA1-018>
  a triage:Finding ;
  triage:findingId "S10-QA1-018" ;
  triage:title "home_dir: PathBuf crosses pub(crate) API boundary as raw unvalidated path (RBP-004)" ;
  triage:description "runtime_health.rs:399: DaemonRequestDispatcher::new(home_dir: PathBuf, ...) accepts a raw PathBuf at the pub(crate) API boundary. Nothing in the type prevents callers from passing an arbitrary or unresolved path where only a validated ATM home directory is semantically valid. Consider a ValidatedHomePath or AtmHomeDir newtype that enforces the invariant (must be existing dir, resolved absolute path) at construction time. Given pub(crate) scope this is a low-urgency improvement aligned with the project's stated RBP-004 policy for paths at API boundaries." ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
