<urn:atm:triage:finding/S11-QA1-002>
  a triage:Finding ;
  triage:findingId "S11-QA1-002" ;
  triage:title "Headless ATM_LOG_DIR test is #[cfg(unix)] only — no cross-platform coverage" ;
  triage:description "Sprint S.11 acceptance criterion: 'headless environments with ATM_LOG_DIR set but no HOME work correctly'. The test host_log_dir_override_succeeds_without_home_env (home.rs:515-528) is gated #[cfg(unix)] because it unsets HOME and USERPROFILE. No cross-platform test exists. Fix: add a non-cfg-gated test that sets only ATM_LOG_DIR to a valid absolute TempDir path (without touching HOME at all) and asserts the override is returned. This proves the override path on all platforms including Windows CI. The unix-gated test that also unsets HOME may remain as a Unix complement. This fix also closes S11-QA1-005." ;
  triage:category "REQ" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s11-log-dir-override-order" ;
  triage:promoteToBranch "feature/pS-s11-log-dir-override-order" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S11-QA1-002/s11/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s11-log-dir-override-order/34bf2eb> .

