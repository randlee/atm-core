<urn:atm:triage:finding/S9-ATM-QA-003>
  a triage:Finding ;
  triage:findingId "S9-ATM-QA-003" ;
  triage:title "host_log_dir() missing ADR-011 validation: absolute path, no daemon-dir overlap, no ~/.claude/ resolution, UTF-8 check" ;
  triage:description "crates/atm-core/src/home.rs:87 — host_log_dir() accepts any non-empty ATM_LOG_DIR without enforcing three ADR-011 validations: (1) absolute path required, (2) no overlap with ~/.atm/daemon/ (runtime lock dir), (3) must not resolve under ~/.claude/. Also missing typed error for non-UTF-8 ATM_LOG_DIR (sprint-S9 §1.5). Fix: add all three ADR-011 checks plus UTF-8 check in host_log_dir(); return typed AtmError on each failure. Compound finding with ARCH-001 (same location)." ;
  triage:category "REQ" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
