<urn:atm:triage:finding/S7-RSH-F004>
  a triage:Finding ;
  triage:findingId "S7-RSH-F004" ;
  triage:title "timeout_secs has no upper bound" ;
  triage:description "crates/atm-core/src/read/mod.rs:47 and wait.rs:7 accept timeout_secs: u64 / Option<u64> with no upper-bound validation. On the wait path (wait::wait_for_eligible_message at read/wait.rs:6-31), Duration::from_secs(timeout_secs) is computed and the function polls in a 100ms loop until elapsed >= timeout; a u64::MAX value produces a timeout of ~584 million years. The daemon thread servicing the request remains blocked for the full duration, consuming a dispatch handle and denying a socket slot. The CLI accepts --timeout as Option<u64> (atm read.rs:68) and passes it directly to ReadQuery::new with no cap. A validation guard (e.g. const MAX_TIMEOUT_SECS: u64 = 3600) in ReadQuery::new and ListQuery::as_read_query would bound the exposure. Both worktrees have ReadQuery::timeout_secs; the feature branch also exposes the field via the new atm read --timeout flag. The finding is open on both branches." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s7-queue-query" ;
  triage:promoteToBranch "feature/pS-s7-queue-query" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-RSH-F004/s7/readquery/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-RSH-F004/s7/wait/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-RSH-F004/integrate-pS/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s7-queue-query/9c01bca> .

