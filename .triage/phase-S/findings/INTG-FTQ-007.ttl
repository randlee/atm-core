<urn:atm:triage:finding/INTG-FTQ-007>
  a triage:Finding ;
  triage:findingId "INTG-FTQ-007" ;
  triage:title "Nondeterministic coalescing in reconcile_runtime_suppresses_duplicate_notifications test" ;
  triage:description "reconcile_runtime.rs:784 — two sequential runtime.reconcile(request.clone()) calls may be coalesced (debounce=25ms) or not depending on scheduler timing. Test passes in both cases but proves different behavior (debounce vs dedup) each time. Fix: use blocking executor gate to ensure two separate non-coalesced executions, assert executor ran twice and 1 notification delivered." ;
  triage:category "FTQ" ;
  triage:severity "minor" ;
  triage:triageMode "integration_gate" ;
