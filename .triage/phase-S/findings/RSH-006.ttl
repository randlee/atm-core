<urn:atm:triage:finding/RSH-006>
  a triage:Finding ;
  triage:findingId "RSH-006" ;
  triage:title "Unbounded fs::read_to_string without size guard in runtime_health.rs:822" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs:822 — fs::read_to_string used without first checking file size. On a malicious or corrupt filesystem this can allocate arbitrarily large buffers. Should check metadata size before reading, or use a capped read. (quality-mgr reported as RSH-005 in S.1 QA-2 report; remapped RSH-006 to avoid ID collision with existing phase-S RSH-005 which covers SIGTERM dead code on feature/pS-s3-runtime-control.)" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
