<urn:atm:triage:finding/RSH-006>
  a triage:Finding ;
  triage:findingId "RSH-006" ;
  triage:title "MAX_RELOAD_TEAMS counter includes non-config entries — off-by-many under high load" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs — entries.enumerate() iterates over all read_dir entries (including non-config entries like dotfiles and metadata) before filtering. The index counter advances for every DirEntry regardless of whether it represents a valid team config, so the MAX_RELOAD_TEAMS guard fires prematurely under high non-config entry loads. Fix: filter the iterator to config-only entries before enumerate(), or count only entries that pass the TeamName parse check." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T17:00:00Z"^^xsd:dateTime ;
  triage:references "PR #230, QA-1 TASK-1230" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-006/s13/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-006/s14/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-006/s15/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s13-ipc-hardening/4c03c2c> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s14-impl/cf57c48> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s15-rusqlite-hardening/93c63a9> ;
