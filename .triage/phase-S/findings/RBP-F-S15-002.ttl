<urn:atm:triage:finding/RBP-F-S15-002>
  a triage:Finding ;
  triage:findingId "RBP-F-S15-002" ;
  triage:title "lifecycle_control.rs:10 SHARED_LIFECYCLE double-checked locking pattern missing rationale comment" ;
  triage:description "lifecycle_control.rs:10 SHARED_LIFECYCLE + INSTALL_LOCK two-lock scheme has no inline rationale comment. Add comment explaining the double-checked locking pattern is required to prevent signal-hook deadlock." ;
