<urn:atm:triage:finding/ATM-QA-S1-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-S1-001" ;
  triage:title "NotificationRuntime::start/shutdown and serve_with_runtime_hooks gated #[cfg(unix)] but called from ungated composition code — Windows CI E0599 (notification_runtime.rs:58,83; local_ipc_transport.rs:196)" ;
  triage:description "crates/atm-daemon/src/notification_runtime.rs:58,83 — NotificationRuntime::start() and shutdown() are implemented only under #[cfg(unix)]. crates/atm-daemon/src/local_ipc_transport.rs:196 — PreparedRuntimeServer::serve_with_runtime_hooks() is implemented only under #[cfg(unix)]. Both are called from composition.rs paths that are not gated, producing Windows CI errors: 'no method named start found for struct NotificationRuntime' and 'no method named serve_with_runtime_hooks found for struct PreparedRuntimeServer'. Fix: add #[cfg(not(unix))] no-op stubs for start/shutdown/serve_with_runtime_hooks, OR gate the call sites in composition.rs under #[cfg(unix)]. (quality-mgr reported as CI-BLOCK-001-S1 in S.1 QA-3 report.)" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
