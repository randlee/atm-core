<urn:atm:triage:finding/S10-QA1-004>
  a triage:Finding ;
  triage:findingId "S10-QA1-004" ;
  triage:title "Required daemon-level integration test absent — unit test does not satisfy sprint §3" ;
  triage:description "Sprint S.10 §3 requires an integration test that: (a) spins up daemon with temp home_dir, (b) verifies ~/.atm/logs/atm.log.jsonl exists with at least one event after startup, (c) verifies atm doctor reports healthy observability when file is writable. The existing test bootstrap_writes_lifecycle_events_to_host_scoped_retained_log in daemon_observability.rs tests DaemonObservability in unit isolation — it does NOT spin up the daemon runtime (no LocalIpcServerTransportAdapter, no compose_runtime, no serve_with_runtime_hooks). No test in tests.rs or integration test directory exercises the full daemon entrypoint with temp home_dir and reads back atm.log.jsonl." ;
  triage:category "REQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
