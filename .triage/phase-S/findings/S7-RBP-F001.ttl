<urn:atm:triage:finding/S7-RBP-F001>
  a triage:Finding ;
  triage:findingId "S7-RBP-F001" ;
  triage:title "Missing .with_recovery() on AtmError::validation() calls in mailbox_metadata.rs" ;
  triage:description "mailbox_metadata.rs lines 99-130 — 4 new S.7 AtmError::validation() calls on DB row parse failures are missing .with_recovery() chaining: (1) line 99: message_key parse failure; (2) line 106: legacy_message_id parse failure; (3) line 115: parent_message_id parse failure; (4) line 127: timestamp parse failure. All four are in query_bounded_mailbox_metadata(). Required by rust-best-practices merge gate: every AtmError::validation() must chain .with_recovery(). File is new in S.7 and not yet present on integrate/phase-S (not merged)." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
