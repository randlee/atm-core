<urn:atm:triage:finding/S7-RSH-F001>
  a triage:Finding ;
  triage:findingId "S7-RSH-F001" ;
  triage:title "Orphaned JoinHandle on shutdown timeout in run_bounded_shutdown_step" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs:484-494 — run_bounded_shutdown_step spawns a thread whose JoinHandle is stored in shutdown_handle. On the Timeout arm, the #[cfg(not(test))] path calls drop(shutdown_handle), which releases the JoinHandle without joining the thread. The spawned thread continues running after the deadline and is never reaped at shutdown: the daemon process exits with a live background thread that may hold file handles, locks, or other resources. The test path (#[cfg(test)]) pushes the handle into SHUTDOWN_FINALIZER_THREADS for deferred join verification, but production code has no equivalent reap. The fix is to call shutdown_handle.join() (ignoring the result) on the Timeout arm in non-test builds, or retain the handle in a registry joined on daemon exit. The code is identical on both worktrees; the issue originates in integrate/phase-S and was carried forward to feature/pS-s7-queue-query without modification." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s7-queue-query" ;
  triage:promoteToBranch "feature/pS-s7-queue-query" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-RSH-F001/s7/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/S7-RSH-F001/integrate-pS/1> ;
  triage:openOn <urn:atm:triage:worktree/feature-pS-s7-queue-query/9c01bca> .

