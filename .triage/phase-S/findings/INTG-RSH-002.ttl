<urn:atm:triage:finding/INTG-RSH-002>
  a triage:Finding ;
  triage:findingId "INTG-RSH-002" ;
  triage:title "Reconcile waiter loop checks completed map before shutdown flag — S8-RSH-003 re-raised" ;
  triage:description "reconcile_runtime.rs:285 — waiter loop evaluates state.completed.remove(&waiter_id) before if state.shutdown check. A racing shutdown is not detected until the next iteration, causing up to DEFAULT_RECONCILE_COMPLETION_TIMEOUT (5s) extra wait. Fix: reorder — check state.shutdown first, then state.completed." ;
