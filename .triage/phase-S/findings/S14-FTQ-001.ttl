# Finding: S14-FTQ-001
# Title: yield_now spin-loop in connect_daemon_local_ipc_until_ready (test_support.rs:77-89)
# Triage mode: initial_pass
# Triaged at: 2026-05-10T00:00:00Z

<urn:atm:triage:finding/S14-FTQ-001>
  a triage:Finding ;
  triage:findingId "S14-FTQ-001" ;
  triage:title "yield_now spin-loop in connect_daemon_local_ipc_until_ready (test_support.rs:77-89)" ;
  triage:description "connect_daemon_local_ipc_until_ready in test_support.rs:77-89 uses thread::yield_now() in a busy spin-loop waiting for daemon readiness. This violates the anti-flake contract (plan-phase-S.md §4.1). Replace with sleep(5ms) backoff or an explicit readiness signal." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
