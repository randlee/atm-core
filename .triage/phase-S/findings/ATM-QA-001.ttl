<urn:atm:triage:finding/ATM-QA-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-001" ;
  triage:title "ShutdownBeacon.wake Condvar never waited on — dead concurrency primitive" ;
  triage:description "crates/atm-daemon/src/shutdown_beacon.rs:9 — ShutdownBeacon has a wake: Condvar field. trip() calls notify_all() but no code anywhere calls wait() or wait_timeout() on it. Violates sprint-S13-ipc-plan.md §2 'wakeable wait primitive' contract. Fix: remove dead Condvar or add paired wait_until_tripped() method." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
