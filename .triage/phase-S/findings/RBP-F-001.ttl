@prefix triage: <https://atm-core.dev/triage/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

triage:RBP-F-001 a triage:Finding ;
    triage:finding_id "RBP-F-001" ;
    triage:title "Missing Mutex lock-rationale comment in composition.rs" ;
    triage:description "Mutex usage in crates/atm-daemon/src/composition.rs lacks a rationale comment explaining the invariant it protects. Required by Rust best practices for non-trivial lock usage." ;
    triage:severity "minor" ;
    triage:category "RBP" ;
    triage:phase_id "phase-S" ;
    triage:triage_mode "initial_pass" ;
    triage:file_filter "composition" ;
    triage:sweep_scope "file_only" ;
    triage:pattern "Mutex::new|Arc<Mutex" ;

    triage:worktree_result [
        triage:branch "feature/pS-s6-runtime-remediation" ;
        triage:head_sha "b80f16a" ;
        triage:order_index "1"^^xsd:integer ;
        triage:occurrence "absent" ;
        triage:note "RuntimeLifecycle.state field at lines 29-32 has a rationale comment: 'A single mutex is sufficient here because lifecycle transitions are serialized control-plane events, not a high-frequency data path.' Finding is resolved in this worktree."
    ] ;
    triage:worktree_result [
        triage:branch "integrate/phase-S" ;
        triage:head_sha "3f67133" ;
        triage:order_index "2"^^xsd:integer ;
        triage:occurrence "absent" ;
        triage:note "RuntimeLifecycle.state field at lines 29-32 also has the same rationale comment. Finding is resolved in this worktree as well."
    ] ;

    triage:highest_open_branch "none" ;
    triage:promote_to_branch "none" ;
    triage:dispatch_ready "false"^^xsd:boolean ;
    triage:resolution "resolved_in_all_branches" ;
    triage:triage_date "2026-05-09"^^xsd:date .
