<urn:atm:triage:finding/FTQ-006>
  a triage:Finding ;
  triage:findingId "FTQ-006" ;
  triage:title "Static SHARED state not reset between tests — test isolation violation" ;
  triage:description "crates/atm-daemon/src/tests.rs:57-58 — static SHARED (and related lifecycle signal flag at line 20 in lifecycle_control.rs) is not reset between test runs. Tests that mutate shared static state can contaminate sibling tests when run in the same process. Requires OnceLock/atomic reset or Drop guard pattern to ensure isolation. (quality-mgr reported as FTQ-001; remapped FTQ-006 to avoid ID collision with existing phase-S FTQ-001.)" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
