<urn:atm:triage:finding/ATM-QA-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-004" ;
  triage:title "owner record writes only raw PID — ADR-002 pid:token format not implemented" ;
  triage:description "host_ownership.rs:27-65 write_owner_record writes only raw PID. Token never generated or validated. PID recycling bypasses stale-owner detection. ADR-002 requires {pid}:{token} format where token is a daemon-generated opaque identifier unique per start attempt." ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
