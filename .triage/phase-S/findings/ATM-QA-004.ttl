<urn:atm:triage:finding/ATM-QA-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-004" ;
  triage:title "Lifecycle waiter uses ServeEvents channel — plan requires beacon-only shutdown signaling" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs lifecycle waiter still sends ServeEvent::Terminate via event_tx channel; plan §2 requires beacon-only shutdown signaling (ShutdownBeacon). Fix: replace ServeEvent::Terminate dispatch with ShutdownBeacon.trip() call." ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
