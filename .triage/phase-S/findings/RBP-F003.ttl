<urn:atm:triage:finding/RBP-F003>
  a triage:Finding ;
  triage:findingId "RBP-F003" ;
  triage:title "RBP-001: Lock-poison errors missing with_recovery() call in reconcile_runtime" ;
  triage:description "crates/atm-daemon/src/reconcile_runtime.rs — Lock-poison errors are not handled via with_recovery(). Production lock() acquisitions in start(), shutdown(), and reconcile() use map_err(|_| ...) or match arms that return a plain AtmError without chaining .with_recovery(). Fix: chain .with_recovery() on each lock-poison error path to provide operator guidance consistent with project convention." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

