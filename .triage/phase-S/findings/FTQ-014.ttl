<urn:atm:triage:finding/FTQ-014>
  a triage:Finding ;
  triage:findingId "FTQ-014" ;
  triage:title "shutdown_lane_with_deadline discards JoinHandle — background lane threads outlive TempDir on timeout (composition.rs)" ;
  triage:description "crates/atm/src/composition.rs — shutdown_lane_with_deadline discards the JoinHandle when the deadline fires. Three background lane threads can outlive the TempDir created for test fixtures, causing use-after-free or resource leaks in test contexts. JoinHandles should be stored and joined or detached explicitly. File unchanged from bcb5aab through 4176880 — fix deferred, still open. (quality-mgr reported as FTQ-008; remapped FTQ-014 to avoid conflict; confirmed STILL_OPEN in S.2 QA-4 at 4176880 line 390.)" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:triageMode "followup_pass" ;
