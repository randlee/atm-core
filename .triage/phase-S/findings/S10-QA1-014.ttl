<urn:atm:triage:finding/S10-QA1-014>
  a triage:Finding ;
  triage:findingId "S10-QA1-014" ;
  triage:title "drop(shutdown_handle) on timeout with no comment documenting orphaned thread behavior" ;
  triage:description "runtime_health.rs:379 calls drop(shutdown_handle) after a bounded-shutdown timeout, silently orphaning the background thread. The bounded-shutdown pattern requires an inline comment explaining that drop() here intentionally leaks the handle on timeout because the thread is detached and will exit on its own schedule. Without the comment, a future maintainer might reintroduce an unconditional join() or be confused about the drop semantics." ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s10-daemon-retained-logger" ;
  triage:promoteToBranch "feature/pS-s10-daemon-retained-logger" ;
