<urn:atm:triage:finding/ATM-QA-007>
  a triage:Finding ;
  triage:findingId "ATM-QA-007" ;
  triage:title "rollback_partially_started_lanes() swallows rollback errors" ;
  triage:description "crates/atm-daemon/src/composition.rs:457-488 — rollback_partially_started_lanes() ignores/swallows errors returned during rollback; partial rollback failures are invisible to caller. Fix: propagate or log rollback errors so failures surface to the caller." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:notes "Defect described in finding does not exist on any supplied branch. The function body at lines 457-487 uses tracing::warn! to surface rollback errors on both watch_event_source and notification_sink shutdown paths. Errors are not swallowed. Finding is absent across all three branches (s13, s14, s15). No dispatch required." .

