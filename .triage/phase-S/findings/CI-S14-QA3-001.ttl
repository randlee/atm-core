<urn:atm:triage:finding/CI-S14-QA3-001>
  a triage:Finding ;
  triage:findingId "CI-S14-QA3-001" ;
  triage:title "local_ipc_transport.rs:321-329 moved value E0382 on Windows — dead code after TASK-1244 fix" ;
  triage:description "TASK-1244 fixed record_accept_error to return Result, but introduced a dead code block at lines 321-329: error is moved into .with_source(error) at line 319, then used again at line 321 in a second block that is unreachable after the return at line 320. Causes E0382 (use of moved value) on cargo xwin check --tests. Fix: delete lines 321-329 (the unreachable dead code block)." ;
  triage:triageMode "initial_pass" ;
  triage:category "CI" ;
  triage:phaseId "phase-S" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-10T23:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/CI-S14-QA3-001/pS-s14-impl/dcb5df9/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-S14-QA3-001/pS-s15-rusqlite-hardening/0282982/1> ;

  triage:fixedOn <urn:atm:triage:worktree/pS-s14-impl/a17efcc> ;
  triage:fixedOn <urn:atm:triage:worktree/pS-s15-rusqlite-hardening/1c8e288> .

