<urn:atm:triage:finding/ATM-QA-S4-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-001" ;
  triage:title "prepare_local_ipc_endpoint returns Ok(()) silently on non-Unix — unresolved TODO stub (local_ipc_transport.rs:454)" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs:454-459 — #[cfg(not(unix))] block for prepare_local_ipc_endpoint returns Ok(()) with a TODO(S.2/ADR-007) comment and no implementation. Sprint S.4 Required Work item 1 requires resolving non-Unix same-host stubs. The same-host-portability lint detects only daemon_unavailable() stubs, not silent Ok(()) pass-throughs — this stub survived the lint coverage gap. Violates REQ-P-PLATFORM-002 and REQ-DAEMON-PLATFORM-001. Fix: either (a) implement proper Windows endpoint preparation (directory creation for lock-file collateral if needed), OR (b) document why Ok(()) is correct and intentional for Windows named-pipe semantics and remove the TODO marker." ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:triageMode "followup_pass" ;
  triage:phaseId "phase-S" ;
