<urn:atm:triage:finding/RSH-009>
  a triage:Finding ;
  triage:findingId "RSH-009" ;
  triage:title "Abandoned dispatch thread emits no log on completion after recv_timeout (local_ipc_transport.rs:519)" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs:519 — when a dispatch thread times out on recv_timeout and exits without being joined, no log is emitted. Silent thread exits make debugging production issues difficult; add a tracing::warn! or tracing::debug! on the recv_timeout timeout path. (quality-mgr reported as RSH-006; remapped RSH-009 to avoid conflict with existing RSH-006 = unbounded fs::read on S.1.)" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
