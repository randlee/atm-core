<urn:atm:triage:finding/S10-QA1-010>
  a triage:Finding ;
  triage:findingId "S10-QA1-010" ;
  triage:title "RetainedSinkHealthOverride wrapping at build_logger() not cfg-gated despite only reachable from cfg(test)" ;
  triage:description "Sprint S.10 §2 states ATM_OBSERVABILITY_RETAINED_SINK_FAULT may remain for test-only fault injection but must not be the primary health source in production builds. retained_sink_fault_mode() is correctly #[cfg(test)]-gated (returns Ok(None) in production). However, the RetainedSinkHealthOverride struct and its SinkRegistration path at build_logger():205-209 are production code paths that accept Option<RetainedSinkFaultMode>. The Some(_) branch is dead in production builds. Either gate the override wrapping behind #[cfg(test)] or add a comment at lines 200-210 documenting that Some(_) is only reachable under #[cfg(test)]." ;
  triage:category "REQ" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
