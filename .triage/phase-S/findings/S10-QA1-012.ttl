<urn:atm:triage:finding/S10-QA1-012>
  a triage:Finding ;
  triage:findingId "S10-QA1-012" ;
  triage:title "JsonlFileSink uses default rotation/retention — log file can grow without bound" ;
  triage:description "daemon_observability.rs:200 constructs JsonlFileSink::new(active_log_path, RotationPolicy::default(), RetentionPolicy::default()) with no explicit rotation size, rotation interval, or retention file count. With default policies, the retained log file can grow without bound on a long-lived daemon process. Specify explicit rotation and retention parameters (e.g., size-based rotation at 10 MiB, retain last 5 files) and document the rationale in ADR-011 §Implementation Constraints." ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-09T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s10-daemon-retained-logger" ;
  triage:promoteToBranch "feature/pS-s10-daemon-retained-logger" ;
