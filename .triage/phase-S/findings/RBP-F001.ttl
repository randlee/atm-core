@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "RBP-004: request_id flows as plain u64 — needs NonZeroRequestId(NonZeroU64) newtype" ;
  triage:description "crates/atm-core/src/protocol.rs:275 — request_id flows as plain u64 across multiple public codec boundaries; the non-zero invariant is re-validated at each callsite via nonzero_request_id(). Fix: introduce NonZeroRequestId(NonZeroU64) newtype to encode the invariant at the type level, eliminating repeated validation. Occurrences span protocol.rs (struct fields, function params, next_request_id return type, nonzero_request_id helper), boundary/mod.rs (two fn params), and peer_transport.rs (one fn param)." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence
