@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "Infallible Result in AtmError-returning methods — two occurrences" ;
  triage:description "Two occurrences of the same pattern: (1) reconcile_runtime.rs:103 — ReconcileFailureSnapshot::to_error() discards original AtmErrorCode; the struct captures only message and recovery, discarding the error code variant from AtmError::from(); to_error() hardcodes AtmError::daemon_unavailable regardless of original code. (2) local_ipc_transport.rs:60-63 — ActiveConnectionRegistry::interrupt_all returns Result<(), AtmError> but only calls notify_all() and returns Ok(()); the error variant is never reachable, making any caller error-handling dead code." ;
  triage:phaseId "phase-S" ;
  triage:triageMode "followup_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T12:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence
    <urn:atm:triage:occurrence/RBP-F001/pS-s1-boundary-extraction/1> ,
    <urn:atm:triage:occurrence/RBP-F001/pS-s2-windows-ipc/1> ,
    <urn:atm:triage:occurrence/RBP-F001/pS-s2-windows-ipc/2> ,
    <urn:atm:triage:occurrence/RBP-F001/pS-s3-runtime-control/1> ,
    <urn:atm:triage:occurrence/RBP-F001/pS-s3-runtime-control/2> ,
    <urn:atm:triage:occurrence/RBP-F001/pS-s4-hardening/1> ,
    <urn:atm:triage:occurrence/RBP-F001/integrate-phase-S/1> ;
