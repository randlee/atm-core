<urn:atm:triage:finding/S12-QA1-002>
  a triage:Finding ;
  triage:findingId "S12-QA1-002" ;
  triage:title "WatchRuntimeInner Mutex fields lack RBP-006 justification comments (watch_runtime.rs:28,30)" ;
  triage:description "watch_runtime.rs:28-30: WatchRuntimeInner.state (Mutex<WatchState>) and .worker (Mutex<Option<JoinHandle<()>>>) have no doc comment explaining why Mutex is required. The parallel Condvar field (wake) implies a deliberate Mutex+Condvar concurrency design but the rationale is unstated. Compare: runtime_health.rs:62 carries an explicit justification ('Request handlers and doctor/status readers update and snapshot the cache concurrently...'). Fix: add struct-level or field-level comment: 'Worker thread, poll callers, and shutdown path all access state concurrently; Mutex+Condvar guards the lifecycle and subscription registry.'" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pS-s12-intg-gate-findings" ;
  triage:promoteToBranch "feature/pS-s12-intg-gate-findings" ;
