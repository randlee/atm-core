# ── Occurrences on feature/pS-s1-boundary-extraction ─────────────────────────

<urn:atm:triage:occurrence/ATM-QA-016/pS-s1/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/host_ownership.rs" ;
  triage:line 129 ;
  triage:snippet "fn recorded_owner_pid(lock_file: &File) -> Result<Option<u32>, AtmError>" ;
  triage:note "Returns Option<u32>; discards token half of pid:token record. split_once(':').map(|(pid, _)| pid) silently drops token." ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pS-s1-boundary-extraction" ;
  triage:headSha "ab12ea1" ;
  triage:occursIn <urn:atm:triage:worktree/pS-s1/ab12ea1> .

<urn:atm:triage:occurrence/ATM-QA-016/pS-s1/2>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/host_ownership.rs" ;
  triage:line 41 ;
  triage:snippet "if let Some(pid) = recorded_owner_pid(&lock_file)? && !atm_core::process::process_is_alive(pid)" ;
  triage:note "acquire_at() stale-owner recovery uses PID only; write_owner_record writes pid:token (correct on s1) but token is never checked on read." ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pS-s1-boundary-extraction" ;
  triage:headSha "ab12ea1" ;
  triage:occursIn <urn:atm:triage:worktree/pS-s1/ab12ea1> .

