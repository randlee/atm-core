# Finding: ATM-QA-016
# recorded_owner_pid() discards token — stale-owner recovery checks PID only
# Triaged: 2026-05-08T00:00:00Z
# Mode: initial_pass | Scope: file | Phase: phase-S

<urn:atm:triage:finding/ATM-QA-016>
  a triage:Finding ;
  triage:findingId "ATM-QA-016" ;
  triage:title "recorded_owner_pid() discards token — stale-owner recovery checks PID only" ;
  triage:description "host_ownership.rs recorded_owner_pid() returns Option<u32>, silently discarding the token half of the pid:token ownership record. Stale-owner recovery in acquire_at() checks PID liveness only; token continuity is never validated. ADR-002 requires both PID and token to be validated during stale-owner recovery. Additionally, on pS-s2, pS-s4, and integrate/phase-S write_owner_record() was regressed to write only PID (no token), making both the write and read sides non-compliant." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-S" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-08T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/pS-s1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/pS-s1/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/pS-s2/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/pS-s2/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/pS-s3/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/pS-s4/1> ;
