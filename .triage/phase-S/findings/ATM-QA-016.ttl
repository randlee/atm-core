  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/integrate-phase-S/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-016/integrate-phase-S/2> ;

  triage:openOn <urn:atm:triage:worktree/pS-s1/ab12ea1> ;
  triage:openOn <urn:atm:triage:worktree/pS-s2/a7f8039> ;
  triage:openOn <urn:atm:triage:worktree/pS-s3/98c151c> ;
