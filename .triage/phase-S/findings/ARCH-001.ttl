<urn:atm:triage:finding/ARCH-001>
  a triage:Finding ;
  triage:findingId "ARCH-001" ;
  triage:title "RULE-005: DoctorOnlyDispatcher defined identically in two cfg(test) modules" ;
  triage:description "crates/atm-daemon/src/tests.rs and crates/atm-daemon/src/local_ipc_transport.rs both define DoctorOnlyDispatcher struct in separate #[cfg(test)] modules with identical implementations. Violates RULE-005 (no duplicate test helpers). Fix: consolidate into shared test_support.rs module." ;
