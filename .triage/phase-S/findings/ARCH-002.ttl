<urn:atm:triage:finding/ARCH-002>
  a triage:Finding ;
  triage:findingId "ARCH-002" ;
  triage:title "sc-observability in library [dependencies] but only used from main.rs binary path" ;
  triage:description "crates/atm-daemon/Cargo.toml:18 — sc-observability is declared in library [dependencies] but is only used from main.rs (binary path) via daemon_observability.rs, which is not in lib.rs. The source boundary is clean but the Cargo manifest adds unnecessary coupling to the library. Fix: move sc-observability to [[bin]] dependencies or a separate binary-only section." ;
  triage:category "ARCH" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:phaseId "phase-S" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
