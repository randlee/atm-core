<urn:atm:triage:finding/CI-S14-QA3-002>
  a triage:Finding ;
  triage:findingId "CI-S14-QA3-002" ;
  triage:title "tests.rs:296 missing `use std::time::Instant` inside #[cfg(windows)] test block" ;
  triage:description "A #[cfg(windows)] test block at tests.rs:262 uses Instant::now() at line 297 but only `use std::time::Duration` is present at module-level (line 37), not `use std::time::Instant`. Causes E0433 on cargo xwin check --tests. Fix: add `use std::time::Instant;` to the module-level imports." ;
  triage:triageMode "initial_pass" ;
  triage:category "CI" ;
  triage:phaseId "phase-S" ;
  triage:severity "important" ;
  triage:repeatable false ;
