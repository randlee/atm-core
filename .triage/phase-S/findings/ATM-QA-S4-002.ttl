<urn:atm:triage:finding/ATM-QA-S4-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-002" ;
  triage:title "Windows lifecycle install_platform_hooks uses thread::sleep(25ms) polling loop — production fixed-sleep (lifecycle_control.rs:260)" ;
  triage:description "crates/atm-daemon/src/lifecycle_control.rs:260-280 — Windows install_platform_hooks implementation contains thread::sleep(Duration::from_millis(25)) inside a lifecycle state-change polling loop. plan-phase-S.md §4.1 Anti-Flake Contract prohibits fixed sleeps without documented justification. Unix path uses signal pipe with blocking read() (event-driven); Windows polls every 25ms with no observable state predicate. Fix: replace with event-driven approach using ctrlc crate set_handler callback, OR document explicitly in plan-phase-S.md §4.1 and inline code as an accepted production exception with rationale (if no OS alternative exists for this specific lifecycle signal surface on Windows)." ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:triageMode "followup_pass" ;
  triage:phaseId "phase-S" ;
