<urn:atm:triage:finding/RSH-001>
  a triage:Finding ;
  triage:findingId "RSH-001" ;
  triage:title "run_blocking() has no internal timeout on the blocking closure" ;
  triage:description "quality-mgr QA-1 (rust-service-hardening-agent), PR #1408 @ 5ab184d75, https://github.com/randlee/atm-core/pull/1408#issuecomment-5642703785. run_blocking() (herdr_queue_wake.rs:898), the spawn_blocking wrapper used pervasively by the new MemberObservation-based reminder/escalation pipeline, has no internal timeout on the blocking closure itself. Non-blocking (pre-existing helper design, local SQLite calls not network I/O) but worth bounding consistent with HERDR_REQUEST_DEADLINE-scale timeouts if contention is ever observed. fenix's ruling: pre-existing helper; BA.6 fold-in note." ;
  triage:phaseId "phase-ba" ;
  triage:triageMode "initial_pass" ;
  triage:category "hardening" ;
  triage:severity "minor" ;
  triage:source "qa" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_queue_wake.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T01:58:00Z"^^xsd:dateTime ;
  triage:deferredNote "fenix's BA.4 QA-1 ruling (https://github.com/randlee/atm-core/pull/1408#issuecomment-5642738654) folds this into BA.6, not BA.4. Further promoted by fenix's cleanup ruling (ATM 2026-09-12T04:44:29Z): worktree layer 5, fix/phase-ba-cleanup (new gh-stack layer above docs/ba6, cipher single writer) -- arch-ctm's BA6-CLEANUP task is cancelled; fix lands once on the cleanup layer, not on docs/ba6." ;
  triage:promoteTo "fix/phase-ba-cleanup" ;
  triage:foundIn triage:BA6 ;
  triage:foundAt "2026-09-12T01:58:00Z"^^xsd:dateTime ;
