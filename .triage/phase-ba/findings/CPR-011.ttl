<urn:atm:triage:finding/CPR-011>
  a triage:Finding ;
  triage:findingId "CPR-011" ;
  triage:title "BA.5 interval tests compare an injected pump clock against the storage wall clock, so none of them measure the interval" ;
  triage:description "Hostile closure review (general-purpose opus, task af4edaf6699568f49) @ 9f5aef2fe. BA.5 interval tests compare an injected pump clock against the storage wall clock, so none of them measure the interval. Doc says: sprint-BA.5 acceptance turns on TASK_REMINDER_INTERVAL_MS behaviour: claim writes a one-interval lease, restart re-exposes an unread item, an item becomes due again after one interval. Code does: The pump is driven by an injected fake clock (fixtures at 2020 and 2030) while the storage layer stamps nudge_pending_at from the real wall clock (2026). The two time authorities are never reconciled. Recommendation: Inject the same clock into the storage write path used by these fixtures, or assert on the stored due-time delta rather than on a now-vs-due comparison. Re-run the BA.5 interval suite after unifying the clock and treat any newly failing test as a real finding. solar review-3 item B3, with negation proof per test." ;
  triage:phaseId "phase-ba" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:source "qa" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/tests/herdr_nudge_invariant.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-09-12T07:08:18Z"^^xsd:dateTime ;
  triage:deferredNote "fenix (ATM 01M2A821M48VWSZ0JGXMA4WWZ7, 2026-09-12T07:24:38Z): fixed by solar review-3 at 867b0ef5b. Sha remap (fenix ATM 01M2A9NY2AEAKS6EAHY0V4ZDYB, 2026-09-12T07:52:59Z): review-3 rebased onto review-2 33754d69d (force-with-lease); 867b0ef5b -> 596d26fda." ;
  triage:foundIn triage:BA6 ;
  triage:foundAt "2026-09-12T07:08:18Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CPR-011/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CPR-011/2> ;
  triage:triageRecordVersion "2" .

