  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T02:14:00Z"^^xsd:dateTime ;
  triage:deferredNote "fenix's BA.5 QA-1 ruling (https://github.com/randlee/atm-core/pull/1407#issuecomment-5642806916) folds this into BA.6, not BA.5 -- recorded as open against BA.6, though the occurrence below is where it was actually observed during BA.5's QA-1 pass." ;
