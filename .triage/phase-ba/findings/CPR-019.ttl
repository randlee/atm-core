<urn:atm:triage:finding/CPR-019>
  a triage:Finding ;
  triage:findingId "CPR-019" ;
  triage:title "atm task close and atm task assign carry an undocumented trailing positional that silently swallows arguments" ;
  triage:description "Hostile closure review (general-purpose opus, task af4edaf6699568f49) @ 9f5aef2fe. `atm task close` and `atm task assign` carry an undocumented trailing positional that silently swallows arguments. Doc says: nudge-task-design.md §5 / sprint-BA.4 contract: `atm task close <task-id> <outcome> [reason]`; assign takes --template/--vars. BA.4 AC1: 'lists exactly five subcommands with the design §5 syntax.' Code does: The flattened MessageSourceArgs.text (value_name = 'MESSAGE') adds a free positional. Actual usage from the built binary: `atm task close [OPTIONS] <TASK_ID> <OUTCOME> [REASON] [MESSAGE]` and `atm task assign [OPTIONS] <ASSIGNEE> [MESSAGE]`. Recommendation: Either document the MESSAGE positional in §5 and BA.4, or suppress it on these two subcommands. fenix's ruling: keep section-5 syntax exact; suppress the MESSAGE positional specifically on close and assign." ;
  triage:phaseId "phase-ba" ;
  triage:triageMode "initial_pass" ;
  triage:category "best-practices" ;
  triage:severity "important" ;
  triage:source "qa" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm/src/commands/task.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-09-12T07:08:18Z"^^xsd:dateTime ;
  triage:deferredNote "fenix (ATM 01M2A821M48VWSZ0JGXMA4WWZ7, 2026-09-12T07:24:38Z): fixed by cipher at 33894ac10 (bundled with CPR-020/RBP-F102), with a correction landed in follow-up commit 000849597." ;
  triage:foundIn triage:BA6 ;
  triage:foundAt "2026-09-12T07:08:18Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CPR-019/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CPR-019/2> ;
  triage:triageRecordVersion "2" .

