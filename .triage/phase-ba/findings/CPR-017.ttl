<urn:atm:triage:finding/CPR-017>
  a triage:Finding ;
  triage:findingId "CPR-017" ;
  triage:title "The assign alias (atm send --task-id / atm queue --task-id) skips require_daemon_api" ;
  triage:description "Hostile closure review (general-purpose opus, task af4edaf6699568f49) @ 9f5aef2fe. The assign alias (`atm send --task-id` / `atm queue --task-id`) skips require_daemon_api. Doc says: sprint-BA.4 task 3: 'Add the local-team guard and require_daemon_api to every verb and alias.' Code does: The alias path's only preflight is `if request.task_op.is_some() { preflight_task_op_compatibility(&composition).await?; }`. task_op is set only for --task-complete (send.rs:371-377), so an assignment carrying task_id with task_op == None does no version preflight at all. Recommendation: Gate on `request.task_id.is_some() || request.task_op.is_some()` and add the missing alias test." ;
  triage:phaseId "phase-ba" ;
  triage:triageMode "initial_pass" ;
  triage:category "best-practices" ;
  triage:severity "important" ;
  triage:source "qa" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm/src/commands/send.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-09-12T07:08:18Z"^^xsd:dateTime ;
  triage:foundIn triage:BA6 ;
  triage:foundAt "2026-09-12T07:08:18Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CPR-017/1> ;
  triage:triageRecordVersion "1" .

