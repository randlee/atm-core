<urn:atm:triage:finding/SCH-002>
  a triage:Finding ;
  triage:findingId "SCH-002" ;
  triage:title "AtmErrorCode Deserialize hard-fails on an unrecognized wire string, no forward-compat fallback" ;
  triage:description "quality-mgr consolidated QA (BA-REVIEW-QA-1789194730, PR #1425 comment 5645308114, 2026-09-12T10:24:25Z), via schema-reviewer, found during the review-findings stack pass at landed head 9774e113c. AtmErrorCode's Deserialize hard-fails on an unrecognized wire string (no Unknown fallback variant). HTTP_API_VERSION bumped 1.6.0 -> 1.7.0 this phase (confirmed additive/correct by schema-reviewer) and this is the first such minor bump whose entire content is new error-code variants (the five new ATM_TASK_* codes); a pre-1.7.0 CLI will fail to deserialize a response carrying one of them rather than degrading gracefully. Recommend an Unknown(String) fallback variant, or an explicit documented waiver. Not blocking; routed to post-landing backlog as Important." ;
  triage:phaseId "phase-ba" ;
  triage:triageMode "initial_pass" ;
  triage:category "schema" ;
  triage:severity "important" ;
  triage:source "qa" ;
