@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/FTQ-003>
  a triage:Finding ;
  triage:findingId "FTQ-003" ;
  triage:title "Cross-group serial token interference between mailbox and daemon tests" ;
  triage:description "crates/atm-core/tests/mailbox_locking.rs uses #[serial_test::serial(env)] to serialise env-var-sensitive tests under the 'env' token. crates/atm-daemon/ tests use bare #[serial] (no token, default group). Both test suites mutate shared global state (INSTALL_RETAINED_RUNTIME_FACTORY, env vars) but are not serialised relative to each other because they use different serial tokens. This creates a potential race when both suites run in the same cargo test invocation." ;
  triage:category "FTQ" ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:severity "Important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/tests/, crates/atm-daemon/src/, crates/atm-daemon/tests/" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-003/s4/mailbox-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-003/s4/mailbox-2> ;
