<urn:atm:triage:finding/FTQ-003>
  a triage:Finding ;
  triage:findingId "FTQ-003" ;
  triage:title "Cross-group serial token interference — partial fix residual" ;
  triage:description "FIX-R1 at e195d86 (s4) converted 20 bare #[serial] → #[serial_test::serial(env)] in crates/atm-daemon/src/. However, lifecycle_control.rs:753 contains #[serial_test::serial] without the (env) token. This qualified-but-tokenless form was missed because the acceptance check was 'rg ^#\\[serial\\] = 0', which does not match the qualified namespace form. The token group must be (env) to ensure cross-suite serialization with mailbox_locking tests." ;
  triage:category "FTQ" ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "followup_pass" ;
  triage:severity "Blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-daemon/src/" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T02:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-003/followup/s4-qualified-tokenless-1> ;
