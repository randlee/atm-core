<urn:atm:triage:finding/ATM-QA-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-002" ;
  triage:title "project-plan.md missing Sprint X.4 entry in Phase Xb section" ;
  triage:description "docs/project-plan.md Phase Xb section (sections 28-29) mentions Sprint X.4 (feature/pXb-s4-replay-and-ipc-consolidation) in the execution shape but lacks a dedicated sprint entry section (like '## 30. Sprint X.4' or similar). The sprint is referenced within section 28 (lines 3202-3204) and section 29 (lines 3291-3293) but has no standalone detailed plan section. All other sprints (X.1, X.2, X.3, X.5) have equivalent mentions in the execution shape without requiring dedicated sections, but X.4 work includes explicit deliverables (replay-persistence startup contract, peer-transport decomposition, same-host helper deduplication) that should be documented as a named section matching the pattern of prior phases." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T20:35:00Z"^^xsd:dateTime ;
