<urn:atm:triage:finding/ATM-QA-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-003" ;
  triage:title "Boundary doc coverage gap — daemon-client ownership not explicitly documented in sprint-X4 review scope" ;
  triage:description "docs/atm-daemon-client/boundaries.md and boundaries/atm-daemon-client/daemon-bootstrap.toml were listed in docs/phase-X/sprint-X4.md Exact Targets (:61-66) but absent from review_targets and changed_files in XB-S4-QA-1. These docs must explicitly allow daemon-client ownership of try_connect, exchange, and unexpected_response. Sprint doc must include evidence (Delivered section entry) that boundary ownership is verified. Prior triage wrote wrong content (rustdoc on pub(crate) functions) — corrected here per quality-mgr ruling 2026-05-15." ;
  triage:category "ATM-QA" ;
  triage:severity "Important" ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
