@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/FTQ-004>
  a triage:Finding ;
  triage:findingId "FTQ-004" ;
  triage:title "INSTALL_RETAINED_RUNTIME_FACTORY Once race + mismatched serial tokens in daemon tests" ;
  triage:description "FTQ-004: daemon composition uses a Once cell for INSTALL_RETAINED_RUNTIME_FACTORY without a test synchronization guard, allowing parallel tests to race on initialization. FTQ-005: #[serial] test tokens are mismatched across test modules, allowing tests that should be sequential to run in parallel. Fix: add a Mutex guard around INSTALL_RETAINED_RUNTIME_FACTORY in test harness; fix #[serial(token)] groupings so all daemon-factory tests use the same token." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-daemon/" ;
  triage:status "open_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T18:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-004/s5/1> ;
