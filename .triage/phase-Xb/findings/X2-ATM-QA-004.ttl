<urn:atm:triage:finding/X2-ATM-QA-004>
  a triage:Finding ;
  triage:findingId "X2-ATM-QA-004" ;
  triage:title "reconcile() in boundary_support.rs retains file-backed mailbox remnants via source_files calls" ;
  triage:description "crates/atm-core/src/boundary_support.rs reconcile() function calls source_files operations (file-backed mailbox remnants). Sprint X.2 targeted command-path simplification to remove file-backed paths, but reconcile() still reaches back into filesystem-backed source_files logic. This is a design regression — the unification work should have removed or replaced these calls with store-backed alternatives." ;
  triage:category "X2-ATM-QA" ;
  triage:severity "Important" ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/" ;
  triage:status "open" ;
  triage:dispatchReady true ;
