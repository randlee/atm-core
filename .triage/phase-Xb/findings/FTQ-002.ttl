<urn:atm:triage:finding/FTQ-002>
  a triage:Finding ;
  triage:findingId "FTQ-002" ;
  triage:title "Busy-spin yield_now in mailbox locking + partial-write panic instead of retry" ;
  triage:description "crates/atm-core/tests/mailbox_locking.rs — uses yield_now() in tight loops with no backoff. Partial-write scenario causes panic instead of retry. Fix: replace yield_now loop with thread::sleep(Duration::from_millis(5)) + bounded retry count; convert partial-write panic to recoverable error." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/tests/" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-15T00:00:00Z"^^xsd:dateTime ;
  triage:resolvedAt "2026-05-16T00:00:00Z"^^xsd:dateTime ;
  triage:resolutionNote "S3-QA-2 (quality-mgr) confirmed CLOSED: bounded 5ms retry in place, rg 'yield_now' = 0. s1/s2 were carry-forward non-blocking; s3 was highest open branch and fix propagated to s4/s5 via merge-forward." ;
  triage:highestFixedBranch "feature/pXb-s3-runtime-truth-unification" ;
  triage:promoteTo <urn:atm:triage:worktree/s3/adc7c4b> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/s1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/s1/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/s2/1> ;
