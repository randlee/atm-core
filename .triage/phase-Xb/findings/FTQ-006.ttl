<urn:atm:triage:finding/FTQ-006>
  a triage:Finding ;
  triage:findingId "FTQ-006" ;
  triage:title "set_current_dir called in tests without Drop-scoped CwdGuard" ;
  triage:description "composition.rs test functions call set_current_dir() without a Drop-scoped restore guard or env_lock(). A panic between the set_current_dir call and manual restore leaves the process working directory permanently mutated, causing subsequent tests to see wrong paths." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-006/pXb-s4/1> ;
