<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "daemon_terminate_flag() calls install() per invocation — per-call initialization" ;
  triage:description "crates/atm-daemon/src/peer_transport.rs approx line 662 — daemon_terminate_flag() calls .install() on every invocation rather than once at startup. This is a per-call signal/flag handler initialization pattern. install() should be called once (e.g., at daemon startup) and the flag/Arc shared, not re-initialized on every call to daemon_terminate_flag()." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-daemon/src/peer_transport.rs" ;
  triage:category "RBP" ;
  triage:severity "Important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T20:31:00Z"^^xsd:dateTime ;
