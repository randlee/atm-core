<urn:atm:triage:finding/ATM-QA-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-004" ;
  triage:title "Legacy boundary violation: strip_prefix(\"legacy:\") in production WorkflowMessageKey::from_str" ;
  triage:description "crates/atm-core/src/workflow.rs:61 — WorkflowMessageKey::from_str calls strip_prefix(\"legacy:\") in production code, importing the legacy message-key boundary into core message routing. This violates the boundary contract established in Phase Xb. Additional legacy: references found in list.rs and read/mod.rs for validation checks." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-004/s1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-004/s1/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-004/s1/3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-004/s1/4> ;
  triage:openOn <urn:atm:triage:worktree/s1/ae0e20b> ;
  triage:openOn <urn:atm:triage:worktree/s2/5dd2380> ;
  triage:openOn <urn:atm:triage:worktree/s3/adc7c4b> ;
  triage:openOn <urn:atm:triage:worktree/s4/f10c9ec> ;
  triage:openOn <urn:atm:triage:worktree/integrate/b1e70b6> ;
  triage:promoteTo <urn:atm:triage:worktree/s1/ae0e20b> ;
  triage:highestOpenBranch "feature/pXb-s1-mailbox-runtime-cutover" ;
  triage:recommendedFix "Remove the legacy: prefix handling from WorkflowMessageKey::from_str (line 61). Legacy message keys should be migrated/deprecated or handled through a separate backward-compatibility adapter outside the core boundary. The strip_prefix call violates the boundary contract that atm-core accepts only atm: prefixed keys." .

