<urn:atm:triage:finding/X2-RBP-001>
  a triage:Finding ;
  triage:findingId "X2-RBP-001" ;
  triage:title "Rust best-practices violations in atm-daemon composition.rs and reconcile_runtime.rs (RULE-002: 80-line function limit)" ;
  triage:description "XB-S2-QA-1 rust-best-practices-agent sweep identified multiple functions exceeding RULE-002 80-line maximum across crates/atm-daemon/src/composition.rs and crates/atm-daemon/src/reconcile_runtime.rs. Key violations: compose_runtime() 162-229 lines, shutdown_background_lanes() 236-245 lines, reconcile_worker_loop() 613 lines, start() 84 lines, start_with_socket_path_for_test() 101 lines, shutdown() 94 lines, wait_for_pending_agent_for_test() 201 lines, deliver() 216 lines." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "X2" ;
  triage:severity "Important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-daemon/src/" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T00:00:00Z"^^xsd:dateTime ;
