<urn:atm:triage:finding/ATM-QA-S4-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-S4-001" ;
  triage:title "Silent .unwrap_or(DEFAULT_REMOTE_RETRY_BUDGET) on config=None in peer_transport.rs" ;
  triage:description "peer_transport.rs:47 calls .unwrap_or(DEFAULT_REMOTE_RETRY_BUDGET) when config is None — no log, no trace, no error emitted. Sprint X.4 acceptance criterion explicitly requires: \"must fail closed or emit a typed degraded contract when config absent.\" Neither condition is met. The silent fallback violates the sprint deliverable contract." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "ACCEPTANCE_CRITERION" ;
  triage:severity "Blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T00:00:00Z"^^xsd:dateTime ;
