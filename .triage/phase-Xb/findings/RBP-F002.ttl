<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "boundary_support.rs error propagation lacks anyhow::Context caller-level context" ;
  triage:description "crates/atm-core/src/boundary_support.rs uses bare ? propagation for errors without adding caller-level context via anyhow::Context (.context() or .with_context()). This reduces error message quality — errors from I/O operations and serialization are propagated raw without identifying which operation failed. Per Rust best practices, ? propagation at module boundaries should attach context." ;
  triage:phaseId "phase-Xb" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "Minor" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/boundary_support.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-15T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/S1/1> ;
