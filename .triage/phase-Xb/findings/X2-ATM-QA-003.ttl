<urn:atm:triage:finding/X2-ATM-QA-003>
  a triage:Finding ;
  triage:findingId "X2-ATM-QA-003" ;
  triage:title "boundary_support.rs exports 10 pub fn that should be pub(crate)" ;
  triage:description "crates/atm-core/src/boundary_support.rs declares 10 functions as `pub fn` that are only used within the crate and should be `pub(crate)`. Over-broad pub visibility leaks crate-internal helpers into the public API surface." ;
