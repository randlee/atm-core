  a triage:Finding ;
  triage:findingId "ARCH-001-X3" ;
  triage:title "sc-observability in atm-daemon library dependencies" ;
  triage:description "crates/atm-daemon/Cargo.toml has sc-observability in [dependencies] of the daemon library surface. Backend observability crate must be binary-only — either in a [[bin]] target or moved out of lib deps. Library crates must route through ObservabilityPort trait." ;
