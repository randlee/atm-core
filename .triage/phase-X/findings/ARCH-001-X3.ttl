<urn:atm:triage:finding/ARCH-001-X3>
  a triage:Finding ;
  triage:findingId "ARCH-001-X3" ;
  triage:title "sc-observability in atm-daemon [dependencies] — should be dev-only" ;
  triage:description "crates/atm-daemon/Cargo.toml:18 — sc-observability under [dependencies] (production). atm-daemon is a library crate (lib.rs only, no main.rs). Only binary entry points may declare sc-observability as a production dependency. Fix: remove from [dependencies]; keep only in [dev-dependencies] with fault-injection feature for tests. Production code must use sc-observability-types or DaemonRuntimeObservability trait. Still open after fix-R1 (4cfeb8c)." ;
  triage:phaseId "phase-X" ;
  triage:triageMode "followup_pass" ;
