# ── Finding ─────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/FTQ-TEST-X1-001>
  a triage:Finding ;
  triage:findingId "FTQ-TEST-X1-001" ;
  triage:title "send_times_out_under_bounded_lock_contention uses flock — fails on Linux" ;
  triage:description "crates/atm-core/tests/mailbox_locking.rs test send_times_out_under_bounded_lock_contention uses flock (lock_exclusive) to simulate lock contention. On Linux, SQLite WAL uses fcntl byte-range locks (orthogonal to flock), so flock does not block SQLite writes — test panics because send_mail returns Ok instead of Err. Introduced or exposed by X.1 fix-R2 commit e36e8cf. Fix: replace flock with a rusqlite writer-connection held open in a second thread to trigger SQLite single-writer busy-timeout." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-X" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
  triage:references "PR #281" ;
  triage:references "X.1 QA-2 verdict TASK-1549" ;

  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-TEST-X1-001/pX-s1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-TEST-X1-001/pX-s2/1> ;
