  a triage:Finding ;
  triage:findingId "CI-BOUND-001-X1" ;
  triage:title "boundaries lint fails — docs/atm-core/boundaries.md has 0 records" ;
  triage:description "The boundaries lint fails on pX-s1 through pX-s4. docs/atm-core/boundaries.md correctly shows 0 records (no embedded YAML blocks; all boundary records are in TOML files). The actual failures on s1 are 9 violations: atm-runtime-test-support listed as [dependencies] dependent on atm-core and atm-rusqlite without being in their allowed_dependents lists, plus pre-existing atm->atm-rusqlite forbidden-edge violations. On s2/s3/s4, the atm-runtime-test-support crate is absent (not yet merged forward) but 21 new forbidden-edge violations appear in atm-core/Cargo.toml [dev-dependencies] and atm/Cargo.toml [dependencies]. s5 and integrate/phase-X pass cleanly." ;
  triage:triageMode "initial_pass" ;
  triage:category "CI" ;
