# ─────────────────────────────────────────────────────────────────────────────
# Finding: RSH-001-X2
# wait_for_eligible_message has no cancellation path — spins up to 3600s
# Phase: phase-X  |  Mode: initial_pass  |  Triaged: 2026-05-14
# ─────────────────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RSH-001-X2>
  a triage:Finding ;
  triage:findingId "RSH-001-X2" ;
  triage:title "wait_for_eligible_message has no cancellation path — spins up to 3600s" ;
  triage:description "crates/atm-core/src/read/wait.rs:8 wait_for_eligible_message has no shutdown-flag parameter and spins up to 3600s with no cancellation path. Add a shutdown-flag parameter so the caller can interrupt the wait loop." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-X" ;
  triage:severity "important" ;
