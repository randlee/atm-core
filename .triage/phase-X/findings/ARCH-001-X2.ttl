<urn:atm:triage:finding/ARCH-001-X2>
  a triage:Finding ;
  triage:findingId "ARCH-001-X2" ;
  triage:title "pub mod boundary_support should be pub(crate)" ;
  triage:description "crates/atm-core/src/lib.rs declares `pub mod boundary_support`. #[doc(hidden)] does NOT restrict Rust visibility — the module is fully importable by downstream crates. Sprint X.2 requires daemon-private scope. Change to `pub(crate) mod boundary_support`." ;
