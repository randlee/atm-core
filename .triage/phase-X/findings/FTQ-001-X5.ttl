# FTQ-001-X5: SqliteRuntimeGuard::install mutates env without env_lock()
#
# Sweep notes:
#   - atm-runtime-test-support crate is present only on pX-s1 and pX-s5.
#   - pX-s2, pX-s3, pX-s4, and integrate/phase-X: CRATE_ABSENT.
#   - pX-s1: crate uses OnceLock<Mutex<Option<PathBuf>>> path (no env mutation at all) — absent.
#   - pX-s5: crate migrated to env-var approach; SqliteRuntimeGuard::install calls
#     set_env_var(SQLITE_RUNTIME_PATH_ENV, ...) at line 31 WITHOUT first acquiring
#     env_lock(). The set_env_var wrapper itself is safe but requires callers to hold
#     the lock — this call site is the violation.
#   - Repeatable sweep (scope=crate) on pX-s5 found two additional set_env_var calls
#     in Drop (lines 39-40) also missing the env_lock() guard.

<urn:atm:triage:finding/FTQ-001-X5>
  a triage:Finding ;
  triage:findingId "FTQ-001-X5" ;
  triage:title "SqliteRuntimeGuard::install mutates env without env_lock()" ;
  triage:description "crates/atm-runtime-test-support/src/lib.rs:31 — SqliteRuntimeGuard::install sets environment variables via set_env_var without holding env_lock(). Drop impl (lines 39-40) has the same omission. Concurrent test processes can observe torn env state. Must acquire env_lock() before any set_env_var/remove_env_var call in this crate." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-X" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-001-X5/pX-s5/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-001-X5/pX-s5/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-001-X5/pX-s5/3> ;
  triage:openOn <urn:atm:triage:worktree/pX-s5/78d1e2c> ;
