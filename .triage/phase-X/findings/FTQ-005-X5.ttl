<urn:atm:triage:finding/FTQ-005-X5>
  a triage:Finding ;
  triage:findingId "FTQ-005-X5" ;
  triage:title "Non-#[serial] tests call install_retained_runtime_factory" ;
  triage:description "crates/atm-daemon/src/tests.rs contains test functions that call install_retained_runtime_factory() without the #[serial] attribute. Since this function mutates global singleton state, all callers must be serialized. Missing #[serial] allows concurrent test execution to trigger the factory race from FTQ-004." ;
  triage:phaseId "phase-X" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
