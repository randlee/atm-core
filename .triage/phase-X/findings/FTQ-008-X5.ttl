<urn:atm:triage:finding/FTQ-008-X5>
  a triage:Finding ;
  triage:findingId "FTQ-008-X5" ;
  triage:title "Socket path read from HOME env var outside serialized section" ;
  triage:description "crates/atm-daemon/src/tests.rs:203 — daemon_socket_path() resolved from HOME env var before the critical section. Non-serialized tests may mutate HOME concurrently. Fix: use a TempDir-scoped socket path." ;
