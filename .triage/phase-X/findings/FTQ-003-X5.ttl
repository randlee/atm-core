<urn:atm:triage:finding/FTQ-003-X5>
  a triage:Finding ;
  triage:findingId "FTQ-003-X5" ;
  triage:title "yield_now() spin-without-sleep loop starves writers under CI load" ;
  triage:description "Tight spin loops using yield_now() without any sleep interval in tests/mailbox_locking.rs. Under CI load this can starve writer threads waiting for the lock. Should use a backoff strategy (e.g., exponential backoff with thread::sleep or a condvar) instead of a pure yield loop." ;
  triage:phaseId "phase-X" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
