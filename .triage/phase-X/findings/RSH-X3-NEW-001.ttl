<urn:atm:triage:finding/RSH-X3-NEW-001>
  a triage:Finding ;
  triage:findingId "RSH-X3-NEW-001" ;
  triage:title "startup replay has no total-sweep deadline" ;
  triage:description "crates/atm-daemon/src/composition.rs — resume_pending_replay() runs before socket bind with no total-sweep deadline. N stale records = N × 30s blocking before daemon is reachable. Fix: introduce bounded startup-replay budget (default ~60s) with warn + proceed on expiry. Introduced by X.3." ;
  triage:phaseId "phase-X" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
