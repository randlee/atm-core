<urn:atm:triage:finding/PORT-003-X4>
  a triage:Finding ;
  triage:findingId "PORT-003-X4" ;
  triage:title "unsafe std::env::set_var in test at mailbox_locking.rs:976" ;
  triage:description "crates/atm-core/tests/mailbox_locking.rs — std::env::set_var() mutates global process state. #[serial(env)] guard present but raw set_var not via helper; helper at line 948 is #[cfg(unix)] only. Fix: use temp_env::with_var or pass SQLite path as constructor arg to Fixture. Introduced on X.4." ;
  triage:triageMode "initial_pass" ;
  triage:category "PORT" ;
  triage:phaseId "phase-X" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
