# ─────────────────────────────────────────────────────────────────────────────
# Finding: RBP-F001-X2
# Title:   Structurally infallible Result return types in boundary_support.rs
# Triaged: 2026-05-14T00:00:00Z
# Mode:    initial_pass
# ─────────────────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RBP-F001-X2>
    a triage:Finding ;
    triage:findingId "RBP-F001-X2" ;
    triage:title "Structurally infallible Result return types in boundary_support.rs" ;
    triage:description "crates/atm-core/src/boundary_support.rs: deliver_notification returns Result<(), AtmError> but is structurally infallible (only returns Ok(())). compute_identity_fingerprint returns Result<InboxIngressIdentityFingerprintResponse, AtmError> but is also structurally infallible. Both should return Result<..., Infallible> or unwrap to the Ok type. Delegation wrappers in direct_boundaries.rs and boundary_adapters.rs propagate the same nominal error type. Trait definition in boundary/store.rs dictates the signature. Workspace-wide sweep found 6 occurrences across 5 files on all branches." ;
    triage:phaseId "phase-X" ;
    triage:triageMode "initial_pass" ;
    triage:category "RBP" ;
    triage:severity "important" ;
    triage:repeatable true ;
    triage:sweepScope "workspace" ;
    triage:status "open" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;

    # Primary occurrences (core infallible implementations)
    triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-X2/pX-s5/deliver-notification> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-X2/pX-s5/compute-identity-fingerprint-boundary-support> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-X2/pX-s5/compute-identity-fingerprint-reconcile-runtime> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-X2/pX-s5/compute-identity-fingerprint-direct-boundaries> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-X2/pX-s5/compute-identity-fingerprint-boundary-adapters> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-X2/pX-s5/compute-identity-fingerprint-store-trait> ;

    # All branches are open
    triage:openOn <urn:atm:triage:worktree/pX-s1/70460f9b> ;
