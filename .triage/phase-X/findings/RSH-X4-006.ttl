<urn:atm:triage:finding/RSH-X4-006>
  a triage:Finding ;
  triage:findingId "RSH-X4-006" ;
  triage:title "Frame-size cap not locally visible in transport" ;
  triage:description "crates/atm-daemon/src/peer_transport.rs — frame-size limit is applied implicitly inside atm_core::protocol::read_frame (MAX_DAEMON_FRAME_BYTES check at protocol.rs:496); the cap is not visible or referenced at any call site in peer_transport.rs. All six branches contain call sites with only the opaque error string 'remote peer response frame exceeded the maximum supported size' with no constant or comment linking back to the cap value." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-X" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
