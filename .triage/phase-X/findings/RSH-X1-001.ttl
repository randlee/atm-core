<urn:atm:triage:finding/RSH-X1-001>
  a triage:Finding ;
  triage:findingId "RSH-X1-001" ;
  triage:title "install_default_runtime_factory silently discards duplicate registration" ;
  triage:description "crates/atm-core/src/service_runtime_store.rs:13-15 — install_default_runtime_factory silently returns if a factory is already registered, with no warning or error. This can mask misconfiguration where the wrong factory wins. Add a tracing::warn! on duplicate registration." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-X" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
