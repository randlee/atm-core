<urn:atm:triage:finding/RSH-002-X2>
  a triage:Finding ;
  triage:findingId "RSH-002-X2" ;
  triage:title "No eager config validation at daemon start" ;
  triage:description "Daemon configuration is validated lazily on first use rather than eagerly at startup. Add composition-time validation so misconfiguration surfaces at startup, not at first operation." ;
