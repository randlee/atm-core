<urn:atm:triage:finding/RSH-X2-001>
  a triage:Finding ;
  triage:findingId "RSH-X2-001" ;
  triage:title "CLI bootstrap 13s wall-clock budget undocumented — blocks with no progress or cancellation" ;
  triage:description "crates/atm/src/composition.rs — bootstrap polling (AUTO_START_PUBLISH_TIMEOUT=10s) + IPC deadline (SAME_HOST_REQUEST_DEADLINE=3s), no outer combined deadline enforced, no user-visible progress notification, no cancellation path. Introduced by X.2 bootstrap consolidation. Fix: document or enforce timeout bounds, add cancellation or progress notification." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-X" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
