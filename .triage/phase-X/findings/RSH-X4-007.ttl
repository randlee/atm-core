<urn:atm:triage:finding/RSH-X4-007>
  a triage:Finding ;
  triage:findingId "RSH-X4-007" ;
  triage:title "Retry budget not validated at configuration load" ;
  triage:description "crates/atm-daemon/src/peer_transport.rs:46 — remote_retry_budget value accepted from config with no lower-bound check. Zero or negative Duration values produce undefined retry behavior. The config load site at PeerTransportConfig::from_config does not validate the supplied Duration against a minimum acceptable value before use." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-X" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
