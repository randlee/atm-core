# ────────────────────────────────────────────────────────────────────────────
# Finding: ARCH-001-X5
# Title:   #[cfg(all(test, unix))] module-level gate violates boundary policy
# Phase:   phase-X
# Triage:  initial_pass  2026-05-14T00:00:00Z
# Status:  open  (all 6 branches carry live occurrences)
# ────────────────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/ARCH-001-X5>
  a triage:Finding ;
  triage:findingId "ARCH-001-X5" ;
  triage:title "#[cfg(all(test, unix))] module-level gate violates boundary policy" ;
  triage:description "crates/atm-daemon uses #[cfg(all(test, unix))] as a module-level gate in composition.rs, lifecycle_control.rs, and local_ipc_transport.rs. Phase S boundary policy requires #[cfg(test)] at module level and per-function #[cfg(unix)] on individual unix-only test functions. The combined module-level gate hides entire test modules from non-unix CI runs and violates the cross-platform guidelines." ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:phaseId "phase-X" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;

  # open-on: all six branches carry live occurrences
