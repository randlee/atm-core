<urn:atm:triage:finding/RSH-X4-001>
  a triage:Finding ;
  triage:findingId "RSH-X4-001" ;
  triage:title "Blocking IPC I/O advisory only — no type enforcement in atm/composition.rs" ;
  triage:description "crates/atm/src/composition.rs:110 — LocalIpcClientTransportAdapter::round_trip() performs blocking I/O. Doc comment advises spawn_blocking but there is no type-level enforcement. This is advisory-only." ;
  triage:phaseId "phase-X" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
  triage:notes "round_trip() is absent from s1/s2/s3 composition.rs and from integrate/phase-X. It appears on s4 (line 110) and s5 (line 110) only — introduced by feature/pX-s4-replay-and-ipc-consolidation. Not present on develop baseline. LocalIpcClientTransportAdapter struct exists on all branches but the round_trip method is only on s4+. The integrate/phase-X branch does NOT carry round_trip — the advisory-only pattern was not merged forward. Highest open branch is feature/pX-s5-guardrails-and-closeout (order_index 5). Fix promoted to s5." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-X4-001/pX-s4/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-X4-001/pX-s5/1> ;
