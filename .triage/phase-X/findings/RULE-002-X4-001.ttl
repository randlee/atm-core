# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RULE-002-X4-001>
    a triage:Finding ;
    triage:findingId "RULE-002-X4-001" ;
    triage:title "create_task 87L exceeds 80L gate" ;
    triage:description "crates/atm-core/src/boundary/store.rs — fn create_task (trait declaration, no body) is measured as 87 lines by the unfixed check-function-length.py scanner on branches sharing SHA 4cfeb8c. The scanner's forward-brace search crosses into the subsequent RosterStore trait body. Branch pX-s5-guardrails-and-closeout (c8bd38a) ships a corrected scanner that skips trait method declarations ending in ';', eliminating the false-positive. Introduced in fix-R1 diff on X.4; present identically on X.2/X.3/X.4 (SHA 4cfeb8c). Fix: propagate the scanner correction (the ';'-guard added in s5) to the unfixed branches via merge-forward." ;
    triage:category "RULE-002" ;
    triage:phaseId "phase-X" ;
    triage:severity "blocking" ;
    triage:triageMode "initial_pass" ;
    triage:repeatable true ;
    triage:sweepScope "crates/atm-core/src/boundary/store.rs" ;
    triage:status "open" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;

    # Occurrences on open branches
    triage:hasOccurrence <urn:atm:triage:occurrence/RULE-002-X4-001/pX-s2/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/RULE-002-X4-001/pX-s3/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/RULE-002-X4-001/pX-s4/1> ;

    # Branch correlation
    triage:openOn <urn:atm:triage:worktree/pX-s2/4cfeb8c> ;
    triage:openOn <urn:atm:triage:worktree/pX-s3/4cfeb8c> ;
    triage:openOn <urn:atm:triage:worktree/pX-s4/4cfeb8c> ;

    triage:promoteTo <urn:atm:triage:worktree/pX-s4/4cfeb8c> .

