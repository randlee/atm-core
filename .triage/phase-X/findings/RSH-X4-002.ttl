<urn:atm:triage:finding/RSH-X4-002>
  a triage:Finding ;
  triage:findingId "RSH-X4-002" ;
  triage:title "Blocking IPC I/O pattern in atm-daemon-client" ;
  triage:description "crates/atm-daemon-client/src/lib.rs:266 — exchange() and try_connect() perform blocking I/O; advisory only, no type-level enforcement for async callers." ;
  triage:phaseId "phase-X" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-14T00:00:00Z"^^xsd:dateTime ;
  triage:notes "Both fn try_connect (line 253) and fn exchange (line 268) are present on all six worktrees including develop baseline. These functions are grandfathered from develop — not introduced by phase-X sprints. All branches carry the same 862-line atm-daemon-client/src/lib.rs. The advisory pattern exists uniformly across all branches. Promote to integrate/phase-X as the highest branch. Exception documentation required on integrate/phase-X per RSH advisory tracking policy." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-X4-002/pX-s1/1> ;
