<urn:atm:triage:finding/FTQ-004-X5>
  a triage:Finding ;
  triage:findingId "FTQ-004-X5" ;
  triage:title "Dual Once/factory pairs race for same global singleton" ;
  triage:description "crates/atm-daemon/src/tests.rs and crates/atm-runtime-test-support/src/lib.rs contain two separate Once/OnceLock/factory registration pairs both targeting the same global singleton. Depending on test execution order, one registration clobbers the other or causes a panic. Consolidate to a single factory registration path." ;
  triage:phaseId "phase-X" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
