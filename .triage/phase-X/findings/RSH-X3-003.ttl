<urn:atm:triage:finding/RSH-X3-003>
  a triage:Finding ;
  triage:findingId "RSH-X3-003" ;
  triage:title "No timeout on SQLite calls in runtime-status hydration" ;
  triage:description "crates/atm-daemon/src/runtime_status_cache.rs — list_teams() and load_roster() calls have no timeout. A slow or locked DB blocks the daemon runtime thread indefinitely." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-X" ;
  triage:severity "important" ;
  triage:repeatable false ;
