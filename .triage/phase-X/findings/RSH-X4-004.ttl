# --- Occurrences ---
# The uninterruptible window arises from PEER_CONNECT_DEADLINE (5s) + PEER_IO_DEADLINE (5s)
# in send_once -> connect_peer_stream + apply_peer_io_deadlines. No shutdown check exists
# inside a single send_once call. Both constants are defined at the top of the file.
# On s1/s2/s3/integrate the retry backoff loop also lacks wait_for_retry_backoff;
# on s4/s5 the retry backoff is interruptible, but send_once itself remains blocking.

<urn:atm:triage:occurrence/RSH-X4-004/pX-s1/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/peer_transport.rs" ;
  triage:line 23 ;
  triage:snippet "const PEER_CONNECT_DEADLINE: Duration = Duration::from_secs(5); const PEER_IO_DEADLINE: Duration = Duration::from_secs(5);" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pX-s1-mailbox-runtime-cutover" ;
  triage:headSha "0d337c7" ;
  triage:occursIn <urn:atm:triage:worktree/pX-s1/0d337c7> .

