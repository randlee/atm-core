# RBP-F002-AL5: Inconsistent .with_cause() usage in AL.5 UDS adapter error paths
# Status: CLOSED (fixed at fe74bd89, re-verified at e13863f0)
# Persisted file/path values are repository-relative. Runtime checkout paths
# belong in the agent input only and must not be copied into this record.

<urn:atm:triage:finding/RBP-F002-AL5>
  a triage:Finding ;
  triage:findingId "RBP-F002-AL5" ;
  triage:title "Inconsistent .with_cause() usage in AL.5 UDS adapter error paths" ;
  triage:description "rust-best-practices-agent AL5-QA-1 Important finding: error construction in the AL.5 Unix UDS adapter uses .with_cause() inconsistently across call sites -- some error paths attach an underlying cause, others construct a bare error losing the original std::io::Error context." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "followup_pass" ;
  triage:category "rust-best-practices" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-05T12:00:00Z"^^xsd:dateTime ;
  triage:closureNote "FIXED on feature/pal-s5-unix-uds @ fe74bd89: All error paths in crates/atm-http-runtime/src/lib.rs now use .with_cause() to properly attach underlying std::io::Error context. Error descriptions are now clear message strings without inline error interpolation, with all source errors propagated via .with_cause(source). Confirmed FIXED by rust-best-practices-agent in AL5-QA-2 with strong code evidence; re-verified stable in AL5-QA-3 @ e13863f0. Execution gates all green (fmt/clippy -D warnings/43+2 tests/45 boundary tests)." ;
  triage:closedOn <urn:atm:triage:worktree/AL5/8165c799> ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
