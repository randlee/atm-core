<urn:atm:triage:finding/AL5-QA3-002>
  a triage:Finding ;
  triage:findingId "AL5-QA3-002" ;
  triage:title "No crash-safe janitor for orphaned PrivateStagingDirectory instances" ;
  triage:description "crates/atm-http-runtime/src/lib.rs: PrivateStagingDirectory relies on inode-verified Drop cleanup, but there is no crash-safe janitor process to reclaim staging directories left behind if the owning process is killed before Drop runs (e.g. SIGKILL, power loss). Raised as a non-blocking hardening note at AL5-QA-3 by quality-mgr; not filed as a formal finding at the time." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-service-hardening" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-08-10T07:15:00Z"^^xsd:dateTime ;
  triage:closedBy "arch-ctm" ;
  triage:closureEvidence "7d2a69f3 reclaims only owner-owned .atm-uds-* directories older than five minutes during serialized UDS startup; private_staging_creation_reclaims_old_crash_leftovers passes." ;
  triage:triagedAt "2026-08-06T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-QA3-002/AL5-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-QA3-002/AL6-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-QA3-002/AL7-1> ;
