<urn:atm:triage:finding/RBP-F003-AL5>
  a triage:Finding ;
  triage:findingId "RBP-F003-AL5" ;
  triage:title "Duplicated validation logic in AL.5 UDS adapter" ;
  triage:description "rust-best-practices-agent AL5-QA-1 Minor finding: validation logic (e.g. path/permission checks) introduced for the AL.5 Unix UDS adapter is duplicated rather than factored into a shared helper, risking drift between call sites." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "followup_pass" ;
  triage:category "rust-best-practices" ;
  triage:severity "minor" ;
  triage:repeatable false ;
