<urn:atm:triage:finding/RSH-001-AL5>
  a triage:Finding ;
  triage:findingId "RSH-001-AL5" ;
  triage:title "Bind-before-chmod TOCTOU window on the UDS socket" ;
  triage:description "crates/atm-http-runtime/src/lib.rs:473-487: the UDS listener socket is bound before its permissions are tightened via chmod, leaving a TOCTOU window during which the socket exists at default (world-accessible) permissions. Flagged CRITICAL/blocking at AL5-QA-1 by rust-service-hardening-agent, independently re-verified real by quality-mgr." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "followup_pass" ;
  triage:category "rust-service-hardening" ;
  triage:severity "critical" ;
  triage:repeatable false ;
