<urn:atm:triage:finding/AL5-BQ-001>
  a triage:Finding ;
  triage:findingId "AL5-BQ-001" ;
  triage:title "allowed_dependencies manifest is not mechanically checked against external Cargo.toml dependencies" ;
  triage:description "The boundary lint (.just/lint_boundaries.py / boundaries/*/*.toml allowed_dependencies) is not mechanically cross-checked against each crate's actual Cargo.toml dependency list, so an undeclared external dependency (as happened with tempfile in ARCH-001-AL5) can be introduced without the boundary lint catching it -- only manual QA review caught it this time. Raised by ruthless-boundary-qa at AL5-QA-3 as an unsolicited out-of-scope observation; quality-mgr explicitly recommended filing this as a dedicated finding in a future open sweep." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "ruthless-boundary-qa" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-06T19:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/INTEGRATE-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S1-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S3-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S4-1> ;
