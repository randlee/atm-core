  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S6-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S7-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S8-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-BQ-001/PAL-S9-1> ;
  triage:closureEvidence "5b78b1f941150cb05d9e6223d4252b2555a3a0e7: .just/lint_boundaries.py collects each configured active-owner manifest's normal/dev/build/target dependencies and fails closed on missing or stale dependency allowlist entries; .just/lint-config.toml carries the active-owner allowlists; .just/tests/test_lint_boundaries.py proves a newly-added test dependency and a stale configured dependency are rejected. quality-mgr independently verified 42/42 tests and the manifest coverage." ;
  triage:closedAt "2026-08-10T10:55:01Z"^^xsd:dateTime ;
  triage:closedBy "arch-ctm" ;
  triage:triageRecordVersion "2" .

