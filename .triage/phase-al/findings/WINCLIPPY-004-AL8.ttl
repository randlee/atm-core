<urn:atm:triage:finding/WINCLIPPY-004-AL8>
  a triage:Finding ;
  triage:findingId "WINCLIPPY-004-AL8" ;
  triage:title "atm-http-runtime lib-test unit Windows-only clippy unused-import failures" ;
  triage:description "Windows CI clippy (lib test) reports 7 unused imports: SendResponseEnvelope (storage_and_nudge_router.rs:549), and 6 symbols from lib.rs:823-827 imports. Static analysis confirms SendResponseEnvelope is used only in #[cfg(unix)] gated test, making it dead code on Windows. The 6 lib.rs imports require detailed cfg-path analysis to confirm which are conditionally reached only via #[cfg(unix)] helper functions or test paths unreachable on Windows." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "portability-lint" ;
