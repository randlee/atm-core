<urn:atm:triage:finding/RSH-001-AL4>
  a triage:Finding ;
  triage:findingId "RSH-001-AL4" ;
  triage:title "GraftLocalIpcClientTransport::round_trip blocks async executor without spawn_blocking" ;
  triage:description "crates/atm-graft/src/transport.rs:31 (GraftLocalIpcClientTransport::round_trip): calls exchange_request/try_connect synchronously inline inside an async fn with no spawn_blocking wrapper, so Tokio-level cancellation cannot interrupt it; bounded only by the ~3.25s OS socket timeout. Same defect class as AL.3's RSH-001, now on the async DaemonApiClient write path." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-service-hardening" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T18:40:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-06T23:55:00Z"^^xsd:dateTime ;
  triage:closureNote "FIXED on feature/pal-s4-shared-client-retrigger @ 9c6c280b6fb9fd9432eeeb2cdf50e1364f90d298: execute() at crates/atm-graft/src/transport.rs:56-71 now wraps the round_trip call in tokio::task::spawn_blocking; round_trip itself remains a plain sync fn by design since isolation now happens at the execute() call boundary. Test cancelling_async_execute_does_not_block_the_tokio_worker passes (1 passed, 0 failed), live cargo test run confirmed. AL5-AL9 occurrences are stale/out-of-scope per team-lead ruling. Verified by quality-mgr, 2026-08-06." ;
  triage:closedOn <urn:atm:triage:worktree/PAL4-VERIFY/9c6c280b> ;
  triage:foundIn triage:AL4 ;
  triage:foundAt "2026-08-06T18:26:20Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/PAL4-VERIFY-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/AL0-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/PAS1-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/PAS2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/PAS3-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/PAS4-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/PAS5-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001-AL4/PAS6-1> ;
