<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "dev/ino filesystem-identity comparison duplicated 3x (plus uid-check duplicated 4x)" ;
  triage:description "The same (device, inode) identity-comparison invariant is hand-rolled independently in reclaim_stale_unix_socket, PrivateStagingDirectory's Drop impl, and UnixSocketPathGuard's Drop impl. The uid-ownership check is separately duplicated 4x. Recommend introducing a small FileIdentity{dev,ino} newtype with of()/matches() helpers and using it at all sites." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "duplication" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-08T17:21:02Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-08T18:11:00Z"^^xsd:dateTime ;
  triage:closureNote "FIXED on fix/daemon-switch-uds-minor-cleanup @ 7da4986f300906849cfe83f108505ecb4b23cbdb: introduced FileIdentity{dev,ino} with of()/matches() (unix_socket.rs:16-35) and is_owned_by() (unix_socket.rs:37-42, parameterized by an explicit configured uid, not hardcoded). git diff HEAD~1 HEAD confirms the prior ad-hoc dev/ino field comparisons in PrivateStagingDirectory::drop and UnixSocketPathGuard::drop, and the inline uid comparisons in validate_unix_socket_parent/verify_prepared_unix_socket, were all replaced by calls into FileIdentity/is_owned_by -- a real refactor, not additive/cosmetic code. Crate-wide grep confirms no leftover inline .ino()/.dev() comparisons remain outside unix_socket.rs. cargo test -p atm-http-runtime: 70 passed unit tests + 2 passed doctests (fresh CARGO_TARGET_DIR). cargo clippy -p atm-http-runtime --all-targets -- -D warnings: clean. cargo fmt --all --check: clean. Verified independently by two agents (rust-qa-agent + rust-code-reviewer) dispatched by quality-mgr, 2026-08-08, against a clean worktree at the exact commit. QAREQ-001 and QA-001 (also referenced against this file's stale-reclaim code) are status blocked-pending-merge-forward, not open: PR #793 merged to integrate/phase-al @ 4c67122d, and this branch has not yet merged that forward, so their targeted code path is not currently present here; they will become reproducible once arch-ctm merges integrate/phase-al into this branch." ;
  triage:closedOn <urn:atm:triage:worktree/RBPF002-VERIFY/7da4986f> ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-08T17:21:02Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/RBPF002-VERIFY-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-4> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-5> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-6> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-7> ;
  triage:triageRecordVersion "1" .

