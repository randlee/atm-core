<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "dev/ino filesystem-identity comparison duplicated 3x (plus uid-check duplicated 4x)" ;
  triage:description "The same (device, inode) identity-comparison invariant is hand-rolled independently in reclaim_stale_unix_socket, PrivateStagingDirectory's Drop impl, and UnixSocketPathGuard's Drop impl. The uid-ownership check is separately duplicated 4x. Recommend introducing a small FileIdentity{dev,ino} newtype with of()/matches() helpers and using it at all sites." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "duplication" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-08T17:21:02Z"^^xsd:dateTime ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-08T17:21:02Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/AL-RBP-F002-2> ;
