  a triage:Finding ;
  triage:findingId "ARCH-001-AL5" ;
  triage:title "Undeclared tempfile prod dependency introduced by RSH-001 fix, not reflected in atm-http-runtime boundary manifest" ;
  triage:description "The fix for RSH-001-AL5 added a `tempfile = 3` production dependency to atm-http-runtime, but boundaries/atm-http-runtime/http-runtime.toml's allowed_dependencies manifest was not updated to declare it. Caught by arch-qa at AL5-QA-2, corroborated by ruthless-boundary-qa. Blocking." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "followup_pass" ;
  triage:category "ruthless-boundary-qa" ;
  triage:severity "important" ;
  triage:repeatable false ;
