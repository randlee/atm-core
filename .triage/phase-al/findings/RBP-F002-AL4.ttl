<urn:atm:triage:finding/RBP-F002-AL4>
  a triage:Finding ;
  triage:findingId "RBP-F002-AL4" ;
  triage:title "Undocumented RwLock rationale" ;
  triage:description "crates/atm-graft/src/lib.rs:296: undocumented RwLock rationale -- no comment explaining why RwLock (vs Mutex or other synchronization) was chosen." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-best-practices" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T18:30:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-06T23:55:00Z"^^xsd:dateTime ;
  triage:closureNote "FIXED on feature/pal-s4-shared-client-retrigger @ 9c6c280b6fb9fd9432eeeb2cdf50e1364f90d298: rationale comment added at crates/atm-graft/src/lib.rs:325-328 explaining RwLock choice (reads dominate; updates only replace a complete snapshot, so RwLock permits concurrent readers). Cosmetic wording caveat noted (comment says 'replace a complete snapshot' but runtime.rs's write_snapshot does in-place single-field mutation) -- team-lead ruled not worth a dev fix round, closed as substantively fixed. Verified by quality-mgr, 2026-08-06." ;
  triage:closedOn <urn:atm:triage:worktree/PAL4-VERIFY/9c6c280b> ;
