<urn:atm:triage:finding/RBQA-F004-AL6>
  a triage:Finding ;
  triage:findingId "RBQA-F004-AL6" ;
  triage:title "Group/other-writable parent-directory check duplicated in loopback_tcp.rs and lib.rs" ;
  triage:description "The 'parent directory must not be group/other writable' check (bitmask `metadata.mode() & 0o022 != 0`) is implemented twice: crates/atm-http-runtime/src/loopback_tcp.rs::validate_record_parent (line 299) for the endpoint-record directory, and crates/atm-http-runtime/src/lib.rs::validate_unix_socket_parent (line 592) for the Unix-socket parent directory. Same safety decision, same bitmask, two independent owners that can silently diverge if one is tightened without the other." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-08-10T07:15:00Z"^^xsd:dateTime ;
  triage:closedBy "arch-ctm" ;
  triage:closureEvidence "7d2a69f3 centralizes the Unix group/other-writable parent decision in unix_socket::parent_is_writable_by_others; UDS and loopback retain their own contextual errors." ;
  triage:triagedAt "2026-08-07T04:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL6 ;
  triage:foundAt "2026-08-07T04:35:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F004-AL6/AL6-QA2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-F004-AL6/AL6-QA2-2> ;
  triage:triageRecordVersion "2" .

