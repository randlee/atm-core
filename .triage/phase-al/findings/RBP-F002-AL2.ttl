<urn:atm:triage:finding/RBP-F002-AL2>
  a triage:Finding ;
  triage:findingId "RBP-F002-AL2" ;
  triage:title "Router-mismatch fallback arm also misuses daemon_unavailable for an internal contract violation" ;
  triage:description "rust-best-practices-agent (RBP-F002) reports a second, distinct occurrence of the same misuse pattern as RBP-F001-AL2: a router-mismatch fallback arm in the new AL.2 handler also uses AtmError::daemon_unavailable, but this is really an internal contract violation (different code path than the overload/load-shed rejection). Source: quality-mgr AL2-QA-1 verdict, ATM message-id 01KZAYN25F8XMBDDFTSBEEJSM4, PR #768 comment. Repeatable sweep on handler code identified additional misuses at serialization boundaries." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-semantics" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
