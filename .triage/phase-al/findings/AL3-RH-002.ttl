<urn:atm:triage:finding/AL3-RH-002>
  a triage:Finding ;
  triage:findingId "AL3-RH-002" ;
  triage:title "Tokio isolation and absolute-deadline contract not proven across the outcome matrix" ;
  triage:description "docs/plans/phase-al/AL3-durable-write-received-hook-remediation-task-list.md lines 48-56 (AL3-RH-002): synchronous storage and the current synchronous, sealed hook operation must run only in narrowly scoped spawn_blocking work with no Tokio worker blocked; the HTTP task must await the result and never detach a write or hook. One absolute deadline must pass through unchanged: reject before admitting expired work, retain a started transaction's real durable outcome, and no second full-duration timeout. Tests must cover zero budget, storage error, successful commit, hook failure, exhausted post-commit budget, and duplicate/no-hook -- i.e. the full 'Required outcome matrix' table in the same document. Unchecked closure task as of the 2026-08-06 audit. Related to but distinct from AL3-CR-002 (missing post-commit hook deadline enforcement) and AL3-CR-003 (missing bounded write admission)." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "replacement-runtime-checklist" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T23:55:35Z"^^xsd:dateTime ;
  triage:foundIn triage:AL3 ;
  triage:foundAt "2026-08-06T00:00:00Z"^^xsd:dateTime ;
