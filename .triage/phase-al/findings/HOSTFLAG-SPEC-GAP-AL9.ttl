<urn:atm:triage:finding/HOSTFLAG-SPEC-GAP-AL9>
  a triage:Finding ;
  triage:findingId "HOSTFLAG-SPEC-GAP-AL9" ;
  triage:title "New --host send flag has no requirements/ADR coverage" ;
  triage:description "Commit 4bade7c9273f9d83d4e19c3c7ffa86059ba4c7ec (feat(AL9): add explicit send host selection) adds a new `--host` flag to `atm send` (crates/atm/src/commands/send.rs) that normalizes to the same canonical AgentAddress as a host-qualified destination (`agent@team.host`), and rejects the two forms when they disagree. This is real, tested (target_with_explicit_host + explicit_host_is_wire_equivalent_to_a_host_qualified_destination and sibling tests), but has zero documentation trace in docs/requirements.md or any docs/adr/*.md. docs/requirements.md's REQ-CORE-IDENTITY-CHAT-001 section (line ~546-553) already documents the equivalent pattern for --team/--chat-id ('CLI address composition is equivalent to canonical text ... before a single normalization to the structured address') and should gain a parallel bullet for --host; the self-send-suppression requirement at line ~1127-1130 (host-qualified destinations bypass same-team self-send blocking) should note --host as a second way to produce that qualification. Per user direction (team-lead, 2026-08-07), --host is meant to apply only to destination-address resolution on `atm send` and `atm ack` -- it does not make sense on any other command (read/peek/list have no destination address to qualify; peer.rs already has an unrelated, pre-existing --host used for atm trust/atm trust revoke peer-allowlist identity, a different context entirely). `atm ack` (crates/atm/src/commands/ack.rs) currently has no --host flag at all, so the AL9 push only implemented half of the intended CLI surface (send only). No ADR is required -- ADR-035 (canonical write ingress and host routing) already governs the write-router's use of a resolved destination host and is unaffected; this is purely a client-side address-composition spec gap, not an architecture decision." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-doc-coverage" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-07T22:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL9 ;
  triage:foundAt "2026-08-07T22:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/HOSTFLAG-SPEC-GAP-AL9/requirements-md> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/HOSTFLAG-SPEC-GAP-AL9/ack-rs-missing-flag> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/HOSTFLAG-SPEC-GAP-AL9/requirements-md>
  a triage:Occurrence ;
  triage:file "docs/requirements.md" ;
  triage:line 553 ;
  triage:snippet "REQ-CORE-IDENTITY-CHAT-001 CLI address composition bullets document --team/--chat-id equivalence but omit the new --host flag entirely; §6.3 self-send-suppression requirement (~line 1127-1130) also does not mention --host as a qualification path." ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pal-s9-physical-proof-ledger-freeze" ;
  triage:headSha "4bade7c9" ;
  triage:occursIn <urn:atm:triage:worktree/pal-s9-physical-proof-ledger-freeze/4bade7c9> .

<urn:atm:triage:occurrence/HOSTFLAG-SPEC-GAP-AL9/ack-rs-missing-flag>
