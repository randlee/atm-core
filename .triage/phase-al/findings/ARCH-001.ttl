<urn:atm:triage:finding/ARCH-001>
  a triage:Finding ;
  triage:findingId "ARCH-001" ;
  triage:title "remove_file is a plain path-based unlink with no inode re-verification at the point of removal" ;
  triage:description "The dev/ino re-check at 112-127 guards the window between initial stat and recheck, but std::fs::remove_file(path) at line 128 does not re-verify inode identity at the instant of removal. Two same-uid concurrent daemon starts racing through this function can result in the later process deleting the pathname of a socket the earlier process just legitimately bound and published (publish_prepared_unix_socket, line 207), orphaning the earlier process's listener from its pathname. Not attacker-exploitable (parent-dir ownership/mode checks block cross-uid interference) but a real same-uid concurrent-restart race. Recommend wrapping reclaim-check-bind-publish with an advisory flock on a sibling lock file in the parent directory, or explicitly documenting as an accepted narrow limitation." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-08T17:21:02Z"^^xsd:dateTime ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-08T17:21:02Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-001/W0> ;
  triage:triageRecordVersion "1" .

