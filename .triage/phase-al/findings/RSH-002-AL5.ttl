<urn:atm:triage:finding/RSH-002-AL5>
  a triage:Finding ;
  triage:findingId "RSH-002-AL5" ;
  triage:title "AL.5 UDS adapter blocking fs syscalls on async task" ;
  triage:description "bind_unix_listener performed blocking std::fs syscalls on the async runtime task without spawn_blocking. Fixed by wrapping bind_unix_listener call in tokio::task::spawn_blocking, moving blocking operations to a dedicated worker thread." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "followup_pass" ;
  triage:category "rust-service-hardening" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-07T01:25:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-06T18:00:05Z"^^xsd:dateTime ;
  triage:closureNote "FIXED on feature/pal-s5-unix-uds @ fe74bd89c8f18563b4b73c8bfd31798a835a0337: bind_unix_listener call (crates/atm-http-runtime/src/lib.rs:313-326) now wrapped in tokio::task::spawn_blocking(move || bind_unix_listener(...)), preventing blocking fs operations (bind, chmod, stat) from executing on async runtime thread. Re-verified stable through AL5-QA-3 @ e13863f0d444053d9f85de3cfb1e8c3e99171c0e; rust-service-hardening-agent confirmed the fix mechanism and validated no regression." ;
  triage:closedOn <urn:atm:triage:worktree/AL5/8165c799> ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AL5/AL0-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AL5/AL1-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AL5/AL2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AL5/AL3-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AL5/AL5-FIXED> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AL5/AL6-FIXED> ;
