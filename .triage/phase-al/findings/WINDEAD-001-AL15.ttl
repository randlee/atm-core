<urn:atm:triage:finding/WINDEAD-001-AL15>
  a triage:Finding ;
  triage:findingId "WINDEAD-001-AL15" ;
  triage:title "ShutdownSignal::Terminate is dead code on non-Unix, fails Just-lint-windows -D dead-code" ;
  triage:description "PR #806 adds termination-cause logging for the atm-http-runtime (Tokio) replacement runtime host in crates/atm-daemon-bootstrap/src/lib.rs. The ShutdownSignal::Terminate variant is only constructed inside a #[cfg(unix)] branch, so on non-Unix targets (Windows) it is never constructed, tripping -D dead-code in the Windows just-lint gate. quality-mgr independently resolved the eprintln-vs-tracing question as no-finding (the crate has zero tracing dependency/usage, so eprintln is consistent with existing crate conventions). The Ubuntu Test job failure observed in this QA run is the pre-existing flaky test changed_socket_is_never_classified_as_dead_after_a_refusal (tracked separately, unrelated to this PR's diff)." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-09T19:02:38Z"^^xsd:dateTime ;
  triage:foundIn triage:AL15-RUNTIME-TERMINATION-OBS ;
  triage:foundAt "2026-08-09T19:02:38Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/WINDEAD-001-AL15/SHUTDOWNSIGNAL-CFG-1> ;
  triage:triageRecordVersion "1" .

