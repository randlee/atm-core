<urn:atm:triage:finding/ATM-QA-001-NHD>
  a triage:Finding ;
  triage:findingId "ATM-QA-001-NHD" ;
  triage:title "TrustSubcommand::Revoke rejects legacy IP/.local-hosted peers, blocking CLI-based revocation" ;
  triage:description "quality-mgr's QA-1 on PR #795 (NUDGE-HOST-DURABLE-001 fix, branch fix/nudge-host-durable-001 @ 29f1d5bf) found that TrustSubcommand::Revoke (crates/atm/src/commands/peer.rs:360-362) now routes its host argument through parse_peer_host, which calls the new HostName::parse_durable and rejects IP-shaped or .local-suffixed strings before the store lookup ever runs. Any peer that was trusted before this fix landed, or trusted via direct config edit, with an IP or .local host can no longer be revoked via the CLI — parse fails outright and store.remove_trusted_peer is never reached. There is no alternate CLI path to remove such an entry. This traps operators unable to distrust a legacy peer, which is a worse operational outcome than the original cosmetic nudge-provenance issue (e.g. blocks urgent revocation during a security incident). Recommended fix: TrustSubcommand::Revoke should resolve/parse the host with the existing lax HostName::from_str (identity lookup only, not creation) — only Add/Replace should enforce the new parse_durable validation." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "error-handling" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-08T19:55:05Z"^^xsd:dateTime ;
  triage:foundIn triage:NUDGE-HOST-DURABLE-001-QA1 ;
  triage:foundAt "2026-08-08T19:53:27Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-001-NHD/NHD-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/ATM-QA-001-NHD/NHD-1>
  a triage:Occurrence ;
