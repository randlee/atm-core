  triage:snippet "TrustSubcommand::Revoke { host, .. } => { let host = parse_peer_host(host)?; ... } -- routes through the new durable-only parser, rejecting IP/.local hosts before store lookup, with no alternate removal path" ;
  triage:status "open" ;
