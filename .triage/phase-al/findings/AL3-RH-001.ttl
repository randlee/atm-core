<urn:atm:triage:finding/AL3-RH-001>
  a triage:Finding ;
  triage:findingId "AL3-RH-001" ;
  triage:title "Replacement-owned storage-and-hook write service (CanonicalWriteHandler) not proven end-to-end" ;
  triage:description "docs/plans/phase-al/AL3-durable-write-received-hook-remediation-task-list.md lines 36-46 (AL3-RH-001): the one replacement CanonicalWriteHandler implementation in atm-http-runtime must call only existing core/runtime composition types (injected storage-backed LocalServiceRuntime, injected observability, injected MessageReceivedHookEmitter), commit the canonical WriteRequest through the existing core writer, and invoke the received hook only for a newly persisted message, never a legacy daemon router or worker. Tests must prove storage is called before the hook; database failure runs no hook; duplicate delivery runs no second hook; hook failure becomes an existing-schema warning on success. Unchecked closure task as of the 2026-08-06 audit. Related to but distinct from AL3-CR-001 (test-coverage gap for StorageAndNudgeRouter production wiring)." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "replacement-runtime-checklist" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "fixed" ;
  triage:closedAt "2026-08-10T06:26:28Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureEvidence "AL3-durable-write-received-hook-remediation-task-list.md line 36 marked [x]; CanonicalWriteHandler for StorageAndNudgeRouter implemented with full outcome-matrix tests (storage_and_nudge_router.rs); commit 6d4cf954 documents AL.4 disposition, commit 1d72aa93 adds the real Axum-route storage-to-hook outcome matrix." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T16:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL3 ;
  triage:foundAt "2026-08-06T00:00:00Z"^^xsd:dateTime ;
