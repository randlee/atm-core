  a triage:Finding ;
  triage:findingId "RBQA-F101-AL" ;
  triage:title "selected_write_transport local-vs-cross-host routing decision duplicated near-verbatim in atm and atm-graft" ;
  triage:description "The local-vs-cross-host write-routing decision method selected_write_transport is duplicated near-verbatim in crates/atm/src/composition.rs (~line 311) and crates/atm-graft/src/lib.rs (~line 367), including an independently-redefined SAME_HOST_REQUEST_DEADLINE constant in both. Violates the general-guidelines.md single-owner-decision rule." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary" ;
  triage:severity "important" ;
  triage:repeatable true ;
