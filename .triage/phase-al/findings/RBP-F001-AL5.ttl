<urn:atm:triage:finding/RBP-F001-AL5>
  a triage:Finding ;
  triage:findingId "RBP-F001-AL5" ;
  triage:title "Type-confusable constructor parameters in AL.5 UDS adapter" ;
  triage:description "UnixSocketConfig::new(path, owner_uid: NonZeroU32, mode: NonZeroU32) constructor takes two same-typed parameters that are swap-confusable at call sites, risking silent argument-order bugs. Fixed by introducing UnixSocketOwnerUid and UnixSocketMode newtypes to make parameters distinct types." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "followup_pass" ;
  triage:category "rust-best-practices" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-07T01:10:35Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-05T12:00:00Z"^^xsd:dateTime ;
  triage:closureNote "Confirmed FIXED at AL5-QA-2 (quality-mgr message 01KZCWB8H3D4EF2NYEY3TB7RNC) by rust-best-practices-agent along with other QA-1 carry-forward findings, on feature/pal-s5-unix-uds @ fe74bd89. Constructor refactored from two same-typed NonZeroU32 params (owner_uid, mode) to distinct newtypes UnixSocketOwnerUid and UnixSocketMode, eliminating positional confusion risk. Re-verified stable through AL5-QA-3 (quality-mgr message 01KZCWXX1Q38P1HH79JFKT93H0) @ e13863f0. No regression observed." ;
  triage:closedOn <urn:atm:triage:worktree/AL5-FIX/fe74bd89> ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AL5/AL5-FIX-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AL5/AL5-VERIFY-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AL5/AL0-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AL5/AL1-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AL5/AL2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AL5/AL3-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001-AL5/AL4-1> ;
  triage:triageRecordVersion "1" .

# Fixed occurrence: fe74bd89 (AL5-QA-2 fix verification)
<urn:atm:triage:occurrence/RBP-F001-AL5/AL5-FIX-1>
  a triage:Occurrence ;
  triage:file "crates/atm-http-runtime/src/lib.rs" ;
  triage:line 146 ;
  triage:snippet "pub struct UnixSocketOwnerUid(NonZeroU32); pub struct UnixSocketMode(NonZeroU32);" ;
  triage:status "closed" ;
  triage:closed true ;
  triage:branch "feature/pal-s5-unix-uds" ;
  triage:headSha "fe74bd89c8f18563b4b73c8bfd31798a835a0337" ;
  triage:closureNote "Type-confusable params replaced with distinct newtypes. UnixSocketConfig::new signature changed from (path, owner_uid: NonZeroU32, mode: NonZeroU32) to (path, owner_uid: UnixSocketOwnerUid, mode: UnixSocketMode). Fixes positional confusion at call sites." ;
  triage:occursIn <urn:atm:triage:worktree/AL5-FIX/fe74bd89> .

