<urn:atm:triage:finding/RBQA-F103-AL>
  a triage:Finding ;
  triage:findingId "RBQA-F103-AL" ;
  triage:title "TokioTmuxReceivedHook re-derives legacy tmux send-keys sequence/delay as an independent constant" ;
  triage:description "New replacement code TokioTmuxReceivedHook (crates/atm-daemon-bootstrap/src/received_hook_selector.rs around line 120) re-derives the legacy TmuxMessageReceivedHookEmitter's exact tmux send-keys sequence and 275ms double-Enter delay as an independent constant instead of sharing one atm-core-owned definition. Should own the send-keys sequence and delay constant once in atm-core and have both the legacy and Tokio-path hook implementations reference it." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary" ;
  triage:severity "minor" ;
  triage:repeatable true ;
