<urn:atm:triage:finding/WINCLIPPY-002-AL8>
  a triage:Finding ;
  triage:findingId "WINCLIPPY-002-AL8" ;
  triage:title "ServerTaskInputs Windows dead-code (canonical_router/shutdown_tx) in atm-http-runtime" ;
  triage:description "Windows-only clippy dead-code failures in atm-http-runtime: struct fields canonical_router and shutdown_tx are never read on non-Unix targets. Both fields are included in the ServerTaskInputs struct (lines 503, 508) for compositional clarity and alignment with the Unix listener path, but the #[cfg(not(unix))] implementation of start_server_task (lines 618-643) explicitly discards both fields via pattern destructuring (lines 621, 624), leaving them structurally dead on Windows. This is a latent defect surfaced after WINCLIPPY-001-AL8 and WINTEST-001-AL8 fixes landed, preventing the Windows CI build from completing." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "portability-lint" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:closedAt "2026-08-07T09:00:00Z"^^xsd:dateTime ;
