<urn:atm:triage:finding/AL3-CR-006>
  a triage:Finding ;
  triage:findingId "AL3-CR-006" ;
  triage:title "Client-supplied home_dir passed into post-commit lookup/hook-plan violates LocalServiceRuntime no-caller-workspace-read rule" ;
  triage:description "PR #769 QA-2 (reviewed commit e2100f038949486fd3fb66c7ba4d13412e681bfa): crates/atm-http-runtime/src/storage_and_nudge_router.rs (around lines 93-98) passes a client-supplied home_dir value into post-commit lookup and hook-plan construction, which violates LocalServiceRuntime's boundary rule that callers must not read/inject workspace paths directly." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary" ;
  triage:severity "blocking" ;
