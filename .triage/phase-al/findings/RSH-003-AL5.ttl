<urn:atm:triage:finding/RSH-003-AL5>
  a triage:Finding ;
  triage:findingId "RSH-003-AL5" ;
  triage:title "tokio::try_join! on TCP/UDS serve pair drops healthy sibling on peer failure, skipping graceful drain" ;
  triage:description "In crates/atm-http-runtime/src/lib.rs (baseline AL5-QA-1), tokio::try_join! over TCP/UDS axum::serve futures drops the still-healthy sibling immediately if the other errors, skipping graceful shutdown/drain in that edge case. The correct pattern requires signaling the sibling to shut down, awaiting it for graceful completion, and preserving the first error. This was remedied in AL5-QA-2 (fe74bd89) by replacing try_join! with a tokio::select!-based coordinator (drain_server_pair, lib.rs:386-408) that signals shutdown to the sibling, awaits it, and preserves the first failure. Verified stable through AL5-QA-3 (e13863f0)." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "followup_pass" ;
  triage:category "rust-service-hardening" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T18:45:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-06T23:58:00Z"^^xsd:dateTime ;
  triage:closureNote "VERIFIED_FIXED on feature/pal-s5-unix-uds @ fe74bd89 (drain_server_pair replaces try_join! with select!-based coordinator); re-verified stable through AL5-QA-3 @ e13863f0 by rust-service-hardening-agent. No regression. Graceful shutdown pattern now correctly signals sibling, awaits completion, and preserves first error." ;
  triage:closedOn <urn:atm:triage:worktree/PAL5-FIX/fe74bd89> ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-003-AL5/PAL5-VERIFY-1> ;
