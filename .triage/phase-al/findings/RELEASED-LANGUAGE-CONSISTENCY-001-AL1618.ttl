<urn:atm:triage:finding/RELEASED-LANGUAGE-CONSISTENCY-001-AL1618>
  a triage:Finding ;
  triage:findingId "RELEASED-LANGUAGE-CONSISTENCY-001-AL1618" ;
  triage:title "Stale 'released' Hermes-contract language survives adjacent to this PR's own 'reviewed, immutable, deployed' correction" ;
  triage:description "PR #815 (plan/al16-18-plan-docs-to-develop, base develop @ c50c4232) redefines AL16-19's Hermes-contract acceptance bar from 'released, versioned' to 'reviewed, immutable, deployed' (Hermes Agent has no formal release process) and updates most AL16/17/18/19 references consistently. quality-mgr (AL1618-PLAN-QA-4) found two sibling occurrences the commit missed: docs/project-plan.md:1164 still reads 'released, documented Hermes runner lifecycle/injection contract' one line below the AL.16 line this same commit changed from 'released' to 'reviewed, immutable, deployed' -- directly contradicting AL.17's own sprint doc; and sprint-AL16-hermes-graft-live-proof.md:318 (Follow-on sprints section) still reads 'AL.17 ... consumes the released/tested package'. Doc-consistency defects reintroducing the exact 'released' ambiguity this PR exists to remove, not a functional/contract regression." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation-completeness" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
