<urn:atm:triage:finding/AL3-CR-002>
  a triage:Finding ;
  triage:findingId "AL3-CR-002" ;
  triage:title "storage_and_nudge_router.rs:140 hook spawn_blocking await has no timeout" ;
  triage:description "PR #769 QA-2 (reviewed commit e2100f038949486fd3fb66c7ba4d13412e681bfa): the spawn_blocking hook-emit await in emit_received_hook (crates/atm-http-runtime/src/storage_and_nudge_router.rs around line 140) has no tokio::time::timeout wrapper, so a stuck blocking task can hang the async caller indefinitely." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "runtime-hardening" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
  triage:status "fixed" ;
  triage:closedAt "2026-08-10T06:26:28Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureEvidence "spawn_blocking-backed hook emission now wrapped in tokio::time::timeout against the remaining request deadline (storage_and_nudge_router.rs emit_received_hook, ~line 250); BlockingCoreBridge.run() further bounds core operations via deadline-based semaphore acquire (~line 58); commit 566f996f." ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T21:47:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL3 ;
  triage:foundAt "2026-08-06T21:46:11Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL3-CR-002/AL3-3-69> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL3-CR-002/AL4-4-129> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL3-CR-002/AL4-4-142> ;
  triage:triageRecordVersion "2" .

