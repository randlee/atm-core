<urn:atm:triage:finding/DIRECTPEER-LOOPBACK-GAP-AL9>
  a triage:Finding ;
  triage:findingId "DIRECTPEER-LOOPBACK-GAP-AL9" ;
  triage:title "bind_configured_direct_peer_listener has no loopback-only gate" ;
  triage:description "bind_configured_direct_peer_listener (crates/atm-http-runtime/src/lib.rs:468) binds config.direct_peer_tcp.bind_address directly with no address-class validation, unlike its sibling bind_loopback_listener which rejects non-loopback addresses before lifecycle start (see test non_loopback_tcp_configuration_fails_before_lifecycle_start, lib.rs:1332). atm-daemon-bootstrap/src/lib.rs wires this connector's config from environment variables (ATM_HTTP_DIRECT_PEER_BIND, ATM_HTTP_DIRECT_PEER_SOURCE_HOST) into the real daemon composition path. No TLS/mTLS exists anywhere in atm-http-runtime or atm-daemon-bootstrap today (grep-confirmed workspace-wide), so this is not a TLS-vs-plaintext question -- the actual current-reality regression is dropping the loopback-only restriction that bind_loopback_listener already enforces on this path." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "service-hardening" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-07T20:45:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL9 ;
  triage:foundAt "2026-08-07T19:47:44Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/DIRECTPEER-LOOPBACK-GAP-AL9/AL9-1> ;
  triage:triageRecordVersion "1" .

