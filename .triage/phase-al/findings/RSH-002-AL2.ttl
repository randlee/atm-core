<urn:atm:triage:finding/RSH-002-AL2>
  a triage:Finding ;
  triage:findingId "RSH-002-AL2" ;
  triage:title "Synchronous ApiRouter::route dispatch not isolated via spawn_blocking" ;
  triage:description "rust-service-hardening-agent (RSH-002) reports that the new AL.2 handler calls the synchronous ApiRouter::route dispatch directly on the async request path without isolating it via tokio::task::spawn_blocking, risking Tokio worker-thread starvation under load if the dispatch does meaningful blocking work." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "runtime-hardening" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "feature/pal-s2-canonical-handler" ;
  triage:status "closed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-08-06T23:16:46Z"^^xsd:dateTime ;
  triage:closureNote "Verified fixed in 7e2fec06 (fix(http-runtime): isolate synchronous router dispatch). Current dispatch_on_blocking_pool uses tokio::task::spawn_blocking before router.route at message_handler.rs:162-181. just test and just lint pass on the merged branch." ;
  triage:foundIn triage:AL2 ;
  triage:foundAt "2026-08-05T23:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002-AL2/AL2-1> ;
  triage:triageRecordVersion "1" .

