<urn:atm:triage:finding/AL5-QA3-001>
  a triage:Finding ;
  triage:findingId "AL5-QA3-001" ;
  triage:title "Predictable PrivateStagingDirectory naming is a DoS surface" ;
  triage:description "crates/atm-http-runtime/src/lib.rs: the std-only PrivateStagingDirectory introduced by the RSH-001/ARCH-001 fix (e13863f0) names staging directories using PID+counter, which is predictable and could allow a local attacker to pre-create/occupy a staging path (denial of service) before the legitimate process claims it. Raised as a non-blocking hardening note at AL5-QA-3 by quality-mgr; not filed as a formal finding at the time." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-service-hardening" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-06T19:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL5 ;
  triage:foundAt "2026-08-05T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AL5-QA3-001/AL5-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/AL5-QA3-001/AL5-1>
  a triage:Occurrence ;
  triage:file "crates/atm-http-runtime/src/lib.rs" ;
  triage:line 604 ;
  triage:snippet "let sequence = UDS_STAGING_DIRECTORY_COUNTER.fetch_add(1, Ordering::Relaxed); let path = parent.join(format!(\".atm-http-runtime-uds-{}-{sequence}\", std::process::id()))" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pal-s5-unix-uds" ;
  triage:headSha "8165c7998e18fc0373ce9747d46f226d5c58a056" ;
  triage:occursIn <urn:atm:triage:worktree/AL5/8165c79> .

