<urn:atm:triage:finding/AL3-CR-003>
  a triage:Finding ;
  triage:findingId "AL3-CR-003" ;
  triage:title "Bare spawn_blocking is the sole write-admission mechanism, no dedicated bounded component" ;
  triage:description "PR #769 QA-2 (reviewed commit e2100f038949486fd3fb66c7ba4d13412e681bfa): commit_write in crates/atm-http-runtime/src/storage_and_nudge_router.rs (around line 127) relies on a bare spawn_blocking call as the sole write-admission mechanism; there is no dedicated bounded-concurrency component (e.g. a semaphore-backed admission gate) governing SQLite write access, despite the struct exposing a `write_admission: WriteAdmission` field." ;
  triage:phaseId "phase-al" ;
  triage:triageMode "initial_pass" ;
  triage:category "service-hardening" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-06T22:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AL3 ;
