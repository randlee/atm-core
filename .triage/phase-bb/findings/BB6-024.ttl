  a triage:Finding ;
  triage:findingId "BB6-024" ;
  triage:title "atm-storage-rusqlite reader_pool test flakes under full-suite load: interrupted worker not reclaimed within its wait-queue deadline" ;
  triage:description "fenix (2026-09-13T01:37:27Z), observed during solar's full `just test` on fix/bb6-docs-qa1 (205 passed, 1 failed; isolated rerun passed). atm-storage-rusqlite::reader_pool::tests::active_sqlite_statement_is_interrupted_and_worker_capacity_is_reclaimed panicked at crates/atm-storage-rusqlite/src/reader_pool.rs:1621 with 'interrupted worker remains reusable: DeadlineExpired { stage: \"waiting in queue\" }'. Pre-existing at the frozen heads (not introduced by this phase's changes), surfaced incidentally by full-suite timing/load during BB6 docs QA layer work. Per no-flaky-test-tolerance convention: root-caused and fixed, not rerun-to-green. Solar producing --test-threads=1 and under-load reproduction data." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "reliability" ;
  triage:severity "blocking" ;
