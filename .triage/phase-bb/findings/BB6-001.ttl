<urn:atm:triage:finding/BB6-001>
  a triage:Finding ;
  triage:findingId "BB6-001" ;
  triage:title "prompt_handoffs INSERT/SELECT column lists bypass task_sql.rs's one-owner anti-duplication convention" ;
  triage:description "ruthless-boundary-qa via BB6-QA-L1-1789263000 (PR #1458, feature/bb6-storage-prompt-handoffs @ a7d4664d1), verdict PASS 0/3/0, 2026-09-12T23:33:40Z. The 8-column literal in task_store.rs::record_prompt_handoff (lines 313-314) and task_ledger_reader.rs::list_prompt_handoffs (lines 188-189) duplicate the same column list independently instead of routing through task_sql.rs's existing one-owner self-test convention used by sibling read/write pairs. Independently verified by quality-mgr; ruled genuine by fenix. Non-blocking." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "maintainability" ;
  triage:severity "important" ;
  triage:source "ruthless-boundary-qa via BB6-QA-L1-1789263000, ruled genuine by fenix" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/writer/task_store.rs:313-314; crates/atm-storage-rusqlite/src/task_ledger_reader.rs:188-189" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T23:34:12Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: route both column lists through task_sql.rs's existing one-owner convention instead of independent literals. Routed to solar on BB6-FIX-STORAGE-QA1-1789265000, branch fix/bb6-storage-qa1 cut from a7d4664d1, fence crates/atm-storage (+ rusqlite sibling)." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-12T23:33:40Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-001/1> ;
  triage:triageRecordVersion "2" .

