  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T08:23:12Z"^^xsd:dateTime ;
  triage:deferredNote "Lead ruling (2026-09-13, team-lead): minor, companion fix to BB7-TEMPLATE-CONTRADICTION-001 occurrence 30 -- widening the STALE_SEQUENCE regex alongside the AGENTS.md text fix closes both the symptom and the detection gap in one fix round." ;
  triage:foundIn triage:BB7 ;
