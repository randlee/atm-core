<urn:atm:triage:finding/RBQA-BB-GATE2-002>
  a triage:Finding ;
  triage:findingId "RBQA-BB-GATE2-002" ;
  triage:title "test_dispatch_template_parity.py's STALE_SEQUENCE lint has a gap that let AGENTS.md's stale ack/work/task-close text slip through" ;
  triage:description "ruthless-boundary-qa, BB-GATE-RERUN-1789285688 (phase-ending gate re-run, PR #1477, report 2026-09-13T10:40:00Z), fenix-verified at integrate/phase-bb @ 4cb8be1ce. .just/tests/test_dispatch_template_parity.py:28-33's STALE_SEQUENCE regex does not match the 'ack, work, task close' wording, so the guard missed AGENTS.md even though SEQUENCE_DOC_ROOTS already lists it -- the automated guard meant to catch exactly this pattern (see BB7-TEMPLATE-CONTRADICTION-001 occurrence 30) has a gap in its own regex, not its file scope." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "phase_end" ;
  triage:category "tooling" ;
  triage:severity "minor" ;
  triage:source "ruthless-boundary-qa, verified by quality-mgr, BB-GATE-RERUN-1789285688 phase-ending gate re-run" ;
