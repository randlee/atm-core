  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T02:00:00Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: implement the two named colima scenarios (task_events_shows_ready_reminders_and_started_for_prompted_task_only, disabled_task_reminder_override_yields_no_handoff_and_doctor_finding) against the hermes testbed and commit their evidence, matching the BB4-001 precedent. Dispatched to solar as BB6-FIX-DOCS-QA1-1789280000, branch fix/bb6-docs-qa1 cut from adda7e3f9 (layer 16 above cipher's R6, PR #1468)." ;
  triage:relatedFinding "BB4-001" ;
