<urn:atm:triage:finding/BB6-002>
  a triage:Finding ;
  triage:findingId "BB6-002" ;
  triage:title "InMemoryTaskLedgerReader::list_prompt_handoffs is a silent no-op stub, unlike its siblings" ;
  triage:description "rust-qa-agent via BB6-QA-L1-1789263000 (PR #1458, feature/bb6-storage-prompt-handoffs @ a7d4664d1), verdict PASS 0/3/0, 2026-09-12T23:33:40Z. InMemoryTaskLedgerReader::list_prompt_handoffs (testing.rs:463-472) returns Ok(vec![]) unconditionally, with no backing field and no filtering of in-memory rows, unlike its sibling list methods which delegate to an actual in-memory store. A caller using the in-memory test double will silently observe zero handoffs regardless of what was recorded. Independently verified by quality-mgr; ruled genuine by fenix." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:source "rust-qa-agent via BB6-QA-L1-1789263000, ruled genuine by fenix" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/testing.rs:463-472" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T23:34:12Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: give InMemoryTaskLedgerReader a backing field for recorded prompt handoffs and have list_prompt_handoffs filter/return real in-memory rows like its sibling methods, instead of an unconditional Ok(vec![]) stub. Routed to one storage-only fix layer above the stack top (branch fix/bb6-storage-qa1), dev to be picked by fenix." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-12T23:33:40Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-002/1> ;
  triage:triageRecordVersion "1" .

