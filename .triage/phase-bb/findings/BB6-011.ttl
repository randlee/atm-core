<urn:atm:triage:finding/BB6-011>
  a triage:Finding ;
  triage:findingId "BB6-011" ;
  triage:title "D3 failure-reason tests don't exercise record_prompt_handoff's actual storage/timeout branches" ;
  triage:description "ATM-QA-001 via BB6-QA-L2-1789268000 (PR #1461, feature/bb6-runtime-prompt-handoffs @ 0d2cc1142), verdict FAIL 0/3/2 (req-qa deliverable gate only, 0 blocking), 2026-09-13T00:42:20Z. record_failure_logs_prompt_handoff_record_failed_and_emission_succeeds and record_bridge_timeout_logs_and_emission_succeeds don't exercise what they claim: DummyTaskStore::record_prompt_handoff has no failure-injection knob (the storage test hits the None early-return instead), and the timeout test hand-calls log_failure directly instead of going through record_prompt_handoff itself. Independently verified by quality-mgr; ruled genuine by fenix (PR #1461 comment, 2026-09-13T00:42:20Z)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
  triage:source "ATM-QA-001 via BB6-QA-L2-1789268000, ruled genuine by fenix" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_queue_wake/tests/mod.rs (record_failure_logs_prompt_handoff_record_failed_and_emission_succeeds, record_bridge_timeout_logs_and_emission_succeeds); DummyTaskStore::record_prompt_handoff" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: add a failure-injection knob to DummyTaskStore::record_prompt_handoff and rewrite the storage-failure test to exercise it; rewrite the timeout test to go through record_prompt_handoff itself instead of hand-calling log_failure. Routed to arch-ctm on BB6-FIX-RUNTIME-QA1-1789271000, branch fix/bb6-runtime-qa1 cut from 4b0f6661c. PR #1461, base feature/bb6-runtime-prompt-handoffs. Fixed by arch-ctm's first push to fix/bb6-runtime-qa1 @ 08584a4aa (2026-09-13T00:52:35Z, self-reported focused tests + just test/fmt/clippy green). Fixed-pending-QA. BB6-FIX-RUNTIME-QA1-1789271000 complete and self-validated by arch-ctm (2026-09-13T01:29:03Z); implementation commits 08584a4aa+b3e01cd7d (followup). Final layer FROZEN at fix/bb6-runtime-qa1 @ b3e01cd7d (merge of adda7e3f9 via 1862712dc + fixed-sleep fix). QA dispatched BB6-QA-RUNTIME-FIX-1789283000 on PR #1466 (diff vs adda7e3f9). Fixed-pending-QA at b3e01cd7d." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-011/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-011/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-011/3> ;
  triage:hasResolution <urn:atm:triage:resolution/BB6-011/1> ;
  triage:closedAt "2026-09-13T03:08:55Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "4" .

