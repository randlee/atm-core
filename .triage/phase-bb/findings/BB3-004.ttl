<urn:atm:triage:finding/BB3-004>
  a triage:Finding ;
  triage:findingId "BB3-004" ;
  triage:title "procedure.html.j2 missing leading '---': YAML frontmatter leaks into every rendered page" ;
  triage:description "fenix critical review B4, reviewed at 27e21224c. templates/procedure-report/procedure.html.j2:1 lacks the leading '---', so sc-compose treats the frontmatter header as page body: all 37 site/reports/procedures/*/<rev8>.html begin with leaked YAML ('metadata:\n  name: procedure-report...---\n<!doctype html>'). required_variables is never enforced; note (template L17) is undeclared. The D6 minidom-parse assertion would fail against this output, which is why the shipped test uses assertIn(\"<svg\" instead of actually parsing the document. Prepending '---' fixes it (verified by hand render)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "blocking" ;
  triage:source "qa" ;
