  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T19:14:53Z"^^xsd:dateTime ;
  triage:deferredNote "Routed to cipher's BB3-FIX-R1. Also declare `note` in required_variables/optional_variables per D2/D6." ;
  triage:foundIn triage:BB3 ;
  triage:foundAt "2026-09-12T19:14:53Z"^^xsd:dateTime ;
