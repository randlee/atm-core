<urn:atm:triage:finding/BB6-022>
  a triage:Finding ;
  triage:findingId "BB6-022" ;
  triage:title "task_close.rs/task_start.rs/task_list_events.rs use raw test-lead literals instead of the TEST_LEAD/TEST_LEAD_ADDRESS constants" ;
  triage:description "quality-mgr BB6-QA-CLI-FIX round 2 (PR #1465 comment, 2026-09-13T01:28:29Z, ARCH-RULE-010, independently confirmed), verdict FAIL, blocking. 3 test files (task_close.rs, task_start.rs, task_list_events.rs) use raw \"test-lead\"/\"test-lead@test-team\" string literals instead of the pre-existing TEST_LEAD/TEST_LEAD_ADDRESS constants in atm_core::test_support. task_assign.rs's pre-existing instance of the same pattern folded into this finding by fenix's ruling rather than filed separately. Ruled genuine by fenix." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "maintainability" ;
  triage:severity "blocking" ;
  triage:source "quality-mgr BB6-QA-CLI-FIX round 2 (ARCH-RULE-010), ruled genuine by fenix" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm/src/commands/task_close.rs; crates/atm/src/commands/task_start.rs; crates/atm/src/commands/task_list_events.rs; crates/atm/src/commands/task_assign.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T01:28:29Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: replace the raw \"test-lead\"/\"test-lead@test-team\" literals in task_close.rs, task_start.rs, task_list_events.rs, and the pre-existing instance in task_assign.rs with atm_core::test_support::TEST_LEAD/TEST_LEAD_ADDRESS. Dispatched to arch-ctm as BB6-FIX-CLI-QA2-1789281000, branch fix/bb6-cli-qa2 cut from his final runtime head (fix/bb6-runtime-qa1 @ b3e01cd7d), queued behind his runtime close (test-only, CLI crate). fix/bb6-cli-qa2 frozen at 7bb8f4a49 (merge of frozen R6 f23d87928); arch-ctm's close reported gates green. No per-layer QA -- the landing-head QA verifies this. Fixed-pending-QA at 7bb8f4a49." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-13T01:28:29Z"^^xsd:dateTime ;
