  a triage:Finding ;
  triage:findingId "BB6-014" ;
  triage:title "Failure reason categories are raw string literals, not enum-backed" ;
  triage:description "rust-best-practices-agent (RBP-F003) via BB6-QA-L2-1789268000 (PR #1461, feature/bb6-runtime-prompt-handoffs @ 0d2cc1142), verdict FAIL 0/3/2 (req-qa deliverable gate only, 0 blocking), 2026-09-13T00:42:20Z. The failure-reason categories used across the prompt-handoff record/log path are raw string literals rather than an enum, risking silent typos/drift between producer and consumer sites. Ruled genuine by fenix (PR #1461 comment, 2026-09-13T00:42:20Z)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
