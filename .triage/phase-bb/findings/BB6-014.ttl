<urn:atm:triage:finding/BB6-014>
  a triage:Finding ;
  triage:findingId "BB6-014" ;
  triage:title "Failure reason categories are raw string literals, not enum-backed" ;
  triage:description "rust-best-practices-agent (RBP-F003) via BB6-QA-L2-1789268000 (PR #1461, feature/bb6-runtime-prompt-handoffs @ 0d2cc1142), verdict FAIL 0/3/2 (req-qa deliverable gate only, 0 blocking), 2026-09-13T00:42:20Z. The failure-reason categories used across the prompt-handoff record/log path are raw string literals rather than an enum, risking silent typos/drift between producer and consumer sites. Ruled genuine by fenix (PR #1461 comment, 2026-09-13T00:42:20Z)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "maintainability" ;
  triage:severity "minor" ;
  triage:source "rust-best-practices-agent via BB6-QA-L2-1789268000, ruled genuine by fenix" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_queue_wake/ (prompt-handoff failure-reason categories)" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: introduce an enum for failure-reason categories and replace the raw string literals at producer/consumer sites. Routed to arch-ctm on BB6-FIX-RUNTIME-QA1-1789271000, branch fix/bb6-runtime-qa1 cut from 4b0f6661c. PR #1461, base feature/bb6-runtime-prompt-handoffs. BB.7 debt (RBQA-F002, quality-mgr BB6-QA-L4-1789275000, ruthless-boundary-qa, PR #1464 comment, 2026-09-13T02:00:00Z, for team-lead's ledger, not dispatched this phase): the substring-classifying-AtmError-message pattern this finding's fix replaces (RBQA-F001, already fixed via BB6-013/014 on fix/bb6-runtime-qa1) has no mechanical lint guard preventing it from being reintroduced elsewhere in the codebase. Same already-fixed disposition as RBQA-F001 for the current occurrence; consider adding a lint rule as a follow-up hardening item once the runtime fix layer merges forward -- deferred to Phase BB.7, not pulled forward. BB6-FIX-RUNTIME-QA1-1789271000 complete and self-validated by arch-ctm (2026-09-13T01:29:03Z); implementation commit bc522def8. Final layer FROZEN at fix/bb6-runtime-qa1 @ b3e01cd7d (merge of adda7e3f9 via 1862712dc + fixed-sleep fix). QA dispatched BB6-QA-RUNTIME-FIX-1789283000 on PR #1466 (diff vs adda7e3f9). Fixed-pending-QA at b3e01cd7d." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-014/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-014/2> ;
  triage:hasResolution <urn:atm:triage:resolution/BB6-014/1> ;
  triage:closedAt "2026-09-13T03:09:11Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "4" .

