<urn:atm:triage:finding/BB6-013>
  a triage:Finding ;
  triage:findingId "BB6-013" ;
  triage:title "storage_and_nudge_router.rs's Steer path duplicates record_prompt_handoff's failure classification and discards the real AtmError" ;
  triage:description "rust-best-practices-agent (RBP-F002) and ruthless-boundary-qa (RBQA-F001) via BB6-QA-L2-1789268000 (PR #1461, feature/bb6-runtime-prompt-handoffs @ 0d2cc1142), verdict FAIL 0/3/2 (req-qa deliverable gate only, 0 blocking), 2026-09-13T00:42:20Z; same code region, one record. storage_and_nudge_router.rs's Steer path (lines ~493-519) has a second, call-site-owned failure-classification branch that discards the real task_store() error and duplicates record_prompt_handoff's own logic instead of routing through it. Independently verified by quality-mgr (own read confirms). Ruled genuine by fenix (PR #1461 comment, 2026-09-13T00:42:20Z)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "maintainability" ;
  triage:severity "important" ;
  triage:source "rust-best-practices-agent + ruthless-boundary-qa via BB6-QA-L2-1789268000, ruled genuine by fenix" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_queue_wake/storage_and_nudge_router.rs:493-519" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: remove the call-site-owned failure-classification branch at storage_and_nudge_router.rs:493-519 and route the Steer path through record_prompt_handoff itself, preserving the real task_store() AtmError instead of discarding it. Routed to arch-ctm on BB6-FIX-RUNTIME-QA1-1789271000, branch fix/bb6-runtime-qa1 cut from 4b0f6661c. PR #1461, base feature/bb6-runtime-prompt-handoffs. BB6-FIX-RUNTIME-QA1-1789271000 complete and self-validated by arch-ctm (2026-09-13T01:29:03Z); implementation commit 6f7579d32. Final layer FROZEN at fix/bb6-runtime-qa1 @ b3e01cd7d (merge of adda7e3f9 via 1862712dc + fixed-sleep fix). QA dispatched BB6-QA-RUNTIME-FIX-1789283000 on PR #1466 (diff vs adda7e3f9). Fixed-pending-QA at b3e01cd7d." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
