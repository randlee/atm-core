  triage:triagedAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: remove the call-site-owned failure-classification branch at storage_and_nudge_router.rs:493-519 and route the Steer path through record_prompt_handoff itself, preserving the real task_store() AtmError instead of discarding it. Routed to arch-ctm on BB6-FIX-RUNTIME-QA1-1789271000, branch fix/bb6-runtime-qa1 cut from 4b0f6661c. PR #1461, base feature/bb6-runtime-prompt-handoffs." ;
