<urn:atm:triage:finding/BB6-010>
  a triage:Finding ;
  triage:findingId "BB6-010" ;
  triage:title "handoffs field lacks skip_serializing_if = Vec::is_empty unlike its siblings" ;
  triage:description "rust-best-practices-agent via BB6-QA-L3-1789269000 (PR #1462, feature/bb6-cli-prompt-handoffs @ 40ccd403e), verdict PASS 0/4/2, 2026-09-13T00:38:04Z. list.rs's new `handoffs` field (lines 196-201) lacks #[serde(skip_serializing_if = \"Vec::is_empty\")], unlike its sibling collection fields, so empty handoffs are always serialized. Ruled genuine by fenix (PR #1462 comment, 2026-09-13T00:38:04Z)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "minor" ;
  triage:source "rust-best-practices-agent via BB6-QA-L3-1789269000, ruled genuine by fenix" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm/src/commands/list.rs:196-201" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T00:38:04Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: add #[serde(skip_serializing_if = \"Vec::is_empty\")] to the handoffs field at list.rs:196-201, matching its sibling collection fields. Routed to solar on BB6-FIX-CLI-QA1-1789270000, branch fix/bb6-cli-qa1 cut from 4b0f6661c. BB6-FIX-CLI-QA1-1789270000 complete and self-validated by solar (2026-09-13T01:10:38Z); implementation commit 78647d54. Final layer head fix/bb6-cli-qa1 @ adda7e3f9, parent 3aa1954e8 (BB6 L4 final). Fixed-pending-QA at adda7e3f9." ;
