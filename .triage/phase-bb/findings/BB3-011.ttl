<urn:atm:triage:finding/BB3-011>
  a triage:Finding ;
  triage:findingId "BB3-011" ;
  triage:title "Sprint doc prose drift (an15-sc-compose) and D3 tests asserting literal source text instead of runtime output" ;
  triage:description "quality-mgr QA1-M1/QA1-M2, reviewed at 27e21224c. Sprint doc section 1.1 names \"an15-sc-compose\" as one of \"the four site/reports/2026*-fuzz-report directories\"; 5 such directories actually exist and none targets sc-compose -- the only sc-compose-named files (an15-sc-compose-1.4.1-crates-io.json, an15-sc-compose-448-github.json) are unrelated crates.io publish-verification metadata, correctly excluded by inventory_reports.py. Doc prose drift, not a code defect. Separately, D3 tests (test_report_and_envelope_carry_source_revision, test_payload_and_envelope_carry_source_revision_and_testbed_ref_case) assert on literal source-code text rather than actual runtime output; companion null-path tests do exercise real behavior." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "hardening" ;
  triage:severity "minor" ;
  triage:source "qa" ;
  triage:repeatable true ;
  triage:sweepScope "docs/plans/phase-bb/sprint-BB.3-test-procedure-pages.md" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T19:19:46Z"^^xsd:dateTime ;
  triage:deferredNote "Low priority: correct the sprint doc's directory-count prose, and convert the two literal-text D3 tests to assert on actual runtime output for consistency with their null-path companions." ;
  triage:foundIn triage:BB3 ;
  triage:foundAt "2026-09-12T19:19:46Z"^^xsd:dateTime ;
