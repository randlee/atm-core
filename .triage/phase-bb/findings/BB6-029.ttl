  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T05:06:06Z"^^xsd:dateTime ;
  triage:deferredNote "Lead ruling (2026-09-13, team-lead): important, confirmed. Dispatched by fenix to arch-ctm together with BB6-026 (BB-GATE-FIX-R3-1789327000, fix/bb6-taskstart-counterparty-authz) -- BB6-026 and BB6-029 close together after re-verification, since both are the same fail-path test." ;
