  a triage:Finding ;
  triage:findingId "BB6-029" ;
  triage:title "test_missing_observed_interval_is_rejected re-implements the guard inline instead of invoking RUNNER.run(), giving BB6-026's fail path zero regression protection" ;
  triage:description "quality-mgr (2026-09-13T05:06:06Z, PR #1477, task BB6-GATE-FIX-QA-1789320000): re-verifying BB6-026's fixed-sleep -> bounded-poll change found the production logic correct, but scripts/smoke/test_run_bb6_prompt_handoffs.py:139-142's fail-path unit test test_missing_observed_interval_is_rejected re-implements the rejection guard inline rather than invoking RUNNER.run(), so it exercises none of the actual runner code path and provides zero regression protection for the guard it claims to test. The colima runner evidence (51db96c0a) is real and good but is a separate concern from this missing regression test." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-quality" ;
  triage:severity "important" ;
  triage:source "quality-mgr, BB6-GATE-FIX-QA-1789320000 fix-verification, PR #1477" ;
