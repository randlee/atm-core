<urn:atm:triage:finding/EQ-006>
  a triage:Finding ;
  triage:findingId "EQ-006" ;
  triage:title "Direct sqlite3 access in benchmark/admission-capacity scripts violates Rand's 'never touch sqlite' ruling" ;
  triage:description "Rand ruling, 2026-09-14 (relayed by fenix during BB.8.2): 'we should never touch sqlite', covering test, fixture, benchmark and driver code -- storage access belongs behind the daemon/HTTP-runtime boundary, not direct sqlite3 opens from scripts. fenix identified BB.8.2's own direct-sqlite sites (run_colima.py reset SQL, run_bb6_prompt_handoffs.py sqlite_count/prompt_handoff_rows) and is fixing those inside PR #1501 directly (SQL deleted / replaced with `atm task events --json`). This finding is scoped to the remaining atm-core sites fenix identified as outside BB.8.2: scripts/smoke/benchmark_snapshot.py (sqlite3.connect at lines 160, 306-307, 398, 431-432 -- reads, copies and writes mail.db snapshots); scripts/smoke/admission_capacity_support.py (lines 26, 759-766 -- read-only sqlite3 open of the benchmark mail.db); scripts/smoke/run_admission_capacity.py (line 502 -- checkpoint_closed_database on mail.db). Testbed-repo sites (seam_harness.py roster read, atm-troubleshoot skill sqlite3 select) are out of scope here -- routed to a randlee/atm-hermes-testbed issue separately." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "architectural_ruling" ;
  triage:category "architecture" ;
  triage:severity "important" ;
  triage:source "Rand ruling 2026-09-14, relayed by fenix (ATM message 01M2EXF67W0A744S2YDW2NT3ZX)" ;
  triage:repeatable true ;
  triage:sweepScope "scripts/smoke/benchmark_snapshot.py:160,306-307,398,431-432; scripts/smoke/admission_capacity_support.py:26,759-766; scripts/smoke/run_admission_capacity.py:502" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-14T00:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:BB8 ;
  triage:foundAt "2026-09-14T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/EQ-006/1>, <urn:atm:triage:occurrence/EQ-006/2>, <urn:atm:triage:occurrence/EQ-006/3> ;
  triage:triageRecordVersion "1" .

