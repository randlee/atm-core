  a triage:Finding ;
  triage:findingId "BB3-015" ;
  triage:title "report_runtime.py's shared compose()/source_revision() module has no direct unit test" ;
  triage:description "quality-mgr BB3-QA3-1789250000 (Final verdict FAIL, https://github.com/randlee/atm-core/pull/1445#issuecomment-5648698551, 2026-09-12T21:08:20Z; BB3-QA3-I1, confirmed independently by arch-qa and ruthless-boundary-qa), reviewed at 66be1d012. This round's new shared compose()/source_revision() module (scripts/smoke/report_runtime.py) has no direct test file. All 7 consumers (colima_skill_report.py, run_feature_smoke.py, benchmark_report.py, read_benchmark.py, run_admission_capacity.py, run_inbound_peer_smoke.py, scripts/fuzz/render_report.py) mock the wrapper in their own tests, so the module's real behavior (GIT_REVISION full-match validation, subprocess failure path, tempfile cleanup in finally, per-caller error_type substitution) is never exercised end-to-end." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-coverage" ;
  triage:severity "important" ;
