  a triage:Finding ;
  triage:findingId "BB6-005" ;
  triage:title "TaskStart/TaskClose CLI commands raise anyhow errors instead of structured AtmErrorCode::TaskNotFound" ;
  triage:description "rust-best-practices-agent (RBP-F001) via BB6-QA-L3-1789269000 (PR #1462, feature/bb6-cli-prompt-handoffs @ 40ccd403e), verdict PASS 0/4/2, 2026-09-13T00:38:04Z. task.rs's TaskStart/TaskClose command handlers (lines 289-301, 404-410) raise anyhow 'task not found' / 'not assigned' string errors instead of the structured AtmErrorCode::TaskNotFound used elsewhere in the crate. Ruled genuine by fenix (PR #1462 comment, 2026-09-13T00:38:04Z)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:source "rust-best-practices-agent via BB6-QA-L3-1789269000, ruled genuine by fenix" ;
