<urn:atm:triage:finding/BB3-002>
  a triage:Finding ;
  triage:findingId "BB3-002" ;
  triage:title "D4 historical-revision backfill severely under-counts" ;
  triage:description "fenix critical review B2 + quality-mgr QA1-B3, reviewed at 27e21224c. inventory_reports.py:143-158 computes revisions as source_revision values present in committed evidence, union HEAD-at-generation, union the first commit touching the runner -- no history walk comparing add_case/family/worker sets between commits. Every smoke-* doc has exactly 2 revisions entries against the sprint doc's own stated expectation of five to six for smoke-*. 22 runner commits (5 touching add_case) between c355f382 and 1595424d are absent for run_feature_smoke.py; run_fuzz.py is missing 14 after 2f40a3a7; benchmark_report.py is missing 27 after bedcb4b8. D4 requires inspecting intermediate step-changing commits, not just endpoints." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "blocking" ;
  triage:source "qa" ;
  triage:repeatable true ;
  triage:sweepScope "scripts/procedures/inventory_reports.py" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T19:14:53Z"^^xsd:dateTime ;
  triage:deferredNote "Routed to cipher's BB3-FIX-R1. Fix must include a real multi-commit D4 backfill sweep over step-changing commits, not just HEAD + oldest commit." ;
  triage:relatedFinding "BB3-001" ;
  triage:foundIn triage:BB3 ;
  triage:foundAt "2026-09-12T19:14:53Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB3-002/1> ;
