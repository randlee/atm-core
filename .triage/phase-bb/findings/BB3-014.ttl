  triage:triagedAt "2026-09-12T21:08:20Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: add a testbed ref row to both Steps tables in the doc, then regenerate via just procedures and re-run scripts/tests/test_render_procedure_pages.py to confirm. Routed to solar's BB3-FIX-R3-1789253000 (fenix, promote_to_branch fix/bb3-qa3-r3, queued behind BB1-FIX-R1)." ;
