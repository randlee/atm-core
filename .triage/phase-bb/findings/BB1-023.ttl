  a triage:Finding ;
  triage:findingId "BB1-023" ;
  triage:title "Nudge-template-override placeholder validation deferred to live dispatch, fails silently" ;
  triage:description "quality-mgr BB1-QA1-1789242600 (Final Quality Report, FAIL, https://github.com/randlee/atm-core/pull/1438#issuecomment-5648365789, 2026-09-12T20:06:37Z), reviewed at b06b3e262. QA1-I2: crates/atm-core/src/team_admin.rs:466 / crates/atm-core/src/send/nudge_template.rs:149-180: custom override bodies are validated only for non-emptiness at write time (atm teams set-nudge-template succeeds immediately even with malformed placeholder syntax). Placeholder errors surface only later, at actual message dispatch, as a bare warning (crates/atm-http-runtime/src/storage_and_nudge_router.rs:472-497) with no distinct error code or remediation hint -- the sender sees success, the message persists, and the recipient silently receives no nudge for every message of that kind until someone finds the warning log." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
