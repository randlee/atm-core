  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T20:06:37Z"^^xsd:dateTime ;
  triage:deferredNote "Recommend validating placeholders against the known render-key set at write time, before the row is persisted. Fix round R1 goes to solar on a top-of-stack worktree above feature/bb1-transition-templates." ;
