  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T23:34:12Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: replace the ad hoc AtmError -> ReadLaneError::Unavailable mapping at read_lane_error with a call to the crate's existing read_lane_storage_error helper, preserving AtmErrorCode/cause like sibling methods. Routed to one storage-only fix layer above the stack top (branch fix/bb6-storage-qa1), dev to be picked by fenix." ;
  triage:foundIn triage:BB6 ;
