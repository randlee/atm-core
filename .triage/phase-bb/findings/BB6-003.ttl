<urn:atm:triage:finding/BB6-003>
  a triage:Finding ;
  triage:findingId "BB6-003" ;
  triage:title "task_ledger_reader.rs's read_lane_error discards AtmErrorCode/cause instead of using the crate's existing read_lane_storage_error helper" ;
  triage:description "rust-best-practices-agent via BB6-QA-L1-1789263000 (PR #1458, feature/bb6-storage-prompt-handoffs @ a7d4664d1), verdict PASS 0/3/0, 2026-09-12T23:33:40Z. task_ledger_reader.rs's read_lane_error (line 207) maps every AtmError to ReadLaneError::Unavailable, discarding the underlying AtmErrorCode and cause, instead of using the crate's pre-existing read_lane_storage_error helper already used by sibling methods for exactly this mapping. The new prompt-handoff read path inherits the same helper's contract but doesn't call it. Independently verified by quality-mgr; ruled genuine by fenix." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:source "rust-best-practices-agent via BB6-QA-L1-1789263000, ruled genuine by fenix" ;
  triage:repeatable true ;
