  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T21:17:10Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: replace the section with a reference to docs/team-protocol.md's Required Flow (matching the pattern the other four sequence docs now use), and add this file to SEQUENCE_DOCS. Routed to fenix on fix/bb2-qa3-r3 (fenix, new top layer, cut from BB.5 @ f232a104c)." ;
  triage:relatedFinding "BB2-002" ;
  triage:foundIn triage:BB2 ;
  triage:foundAt "2026-09-12T21:17:10Z"^^xsd:dateTime ;
