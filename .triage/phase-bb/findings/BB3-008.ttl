  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T19:14:53Z"^^xsd:dateTime ;
  triage:deferredNote "Routed to cipher's BB3-FIX-R1: write procedure into graft-hermes.json itself, add the two graft tests to run_pytests.py discovery, and repoint the diff-gate test at the develop merge base." ;
  triage:foundIn triage:BB3 ;
  triage:foundAt "2026-09-12T19:14:53Z"^^xsd:dateTime ;
