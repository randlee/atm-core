<urn:atm:triage:finding/BB3-021>
  a triage:Finding ;
  triage:findingId "BB3-021" ;
  triage:title "Puppeteer Chromium CI cache key is a static string, not scoped to a resolved puppeteer/chromium version" ;
  triage:description "quality-mgr BB3-QA3-1789250000 (Final verdict FAIL, https://github.com/randlee/atm-core/pull/1445#issuecomment-5648698551, 2026-09-12T21:08:20Z; BB3-QA3-M5), reviewed at 66be1d012. .github/workflows/pages.yml:38-42's new Puppeteer Chromium cache key is a static string (v1), not scoped to a resolved puppeteer/chromium version, so it won't self-invalidate on a puppeteer version bump; relatedly, the ad-hoc npx puppeteer browsers install chrome may resolve a Chrome build-id that doesn't exactly match mermaid-cli's own bundled puppeteer's expected cache lookup -- a CI/functional risk, not structural." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "hardening" ;
  triage:severity "minor" ;
  triage:source "qa" ;
