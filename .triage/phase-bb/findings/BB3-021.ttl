  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T21:08:20Z"^^xsd:dateTime ;
  triage:deferredNote "Scope the Chromium cache key to a resolved puppeteer/chromium version rather than a static v1 string. Routed to solar's BB3-FIX-R3-1789253000 (fenix, promote_to_branch fix/bb3-qa3-r3, queued behind BB1-FIX-R1). cipher's BB3-FIX-R4-1789255000 (task event 2026-09-12T23:08:15Z) reported this not-reproducible at the current, already-satisfied path on fix/bb3-qa3-r4 @ f94125cf5 (PR #1455, includes merges of #1456 d1969185f and #1453 1c7e76da5); just lint 36/36, just test exit 0, just smoke fast 8/8. Fixed-pending-QA (verify-not-reproducible); QA dispatched as BB3-QA4-1789262000 on PR #1455 (queued behind BB5-QA-R1) to confirm against the record." ;
  triage:relatedFinding "BB3-009" ;
