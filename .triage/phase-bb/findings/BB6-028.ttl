  a triage:Finding ;
  triage:findingId "BB6-028" ;
  triage:title "prompt_handoff_record.rs log_failure() omits the outcome= field that every other herdr_queue_wake/escalation log call sets" ;
  triage:description "rust-service-hardening-agent, verified by quality-mgr (2026-09-13T04:41:10Z), during BB-POST-MORTEM-1789304000 phase-ending gate against integrate/phase-bb. crates/atm-http-runtime/src/prompt_handoff_record.rs:78-95 log_failure()'s tracing::error! omits the `outcome=` field that every other herdr_queue_wake/escalation log call sets (the subsystem/action/outcome convention), breaking retained-log/doctor filtering consistency for this one new call site." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "observability" ;
  triage:severity "minor" ;
  triage:source "rust-service-hardening-agent, verified by quality-mgr, BB-POST-MORTEM-1789304000 phase-ending gate" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/src/prompt_handoff_record.rs (log_failure, lines 78-95)" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T04:41:10Z"^^xsd:dateTime ;
  triage:deferredNote "Lead ruling (2026-09-13, team-lead): minor, not blocking. Filed as its own finding (not folded into BB6-026's record) so the two distinct root causes stay individually accountable, but scoped to land in the SAME fast-follow branch as BB6-026 -- both are in the same colima/prompt-handoff observability surface (prompt_handoff_record.rs and the BB6.7 smoke script that exercises it). Add `outcome=\"...\"` to the log_failure() tracing::error! call matching the subsystem/action/outcome convention used elsewhere in herdr_queue_wake/escalation logging." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-13T04:41:10Z"^^xsd:dateTime ;
