<urn:atm:triage:finding/BB3-027>
  a triage:Finding ;
  triage:findingId "BB3-027" ;
  triage:title "generate_report_index.py's resolve_procedures lacks the is_file existence check report_runtime.py's resolver enforces" ;
  triage:description "quality-mgr BB3-QA-R5-1789273000 (ATM-QA-003, req-qa, independently confirmed), PR #1463 comment (fix/bb3-qa4-r5 @ 5da523f81), verdict FAIL, 2026-09-13T01:11:21Z. resolve_procedures() in .just/generate_report_index.py:224-239 writes the manifest-selected HTML path directly into the published index link with no is_file() existence check, unlike report_runtime.py::resolve_procedure_page() which raises on a missing file. A stale/hand-edited manifest entry can silently publish a dead link -- the same defect class BB3-013 targeted, now reachable from the index-generation path. Ruled genuine by fenix." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:source "quality-mgr BB3-QA-R5-1789273000 (ATM-QA-003), ruled genuine by fenix" ;
  triage:repeatable true ;
  triage:sweepScope ".just/generate_report_index.py:224-239" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T01:11:21Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: add the same is_file() existence check used by report_runtime.py::resolve_procedure_page() to generate_report_index.py::resolve_procedures() (lines 224-239), plus a unit test for a manifest entry pointing at a missing HTML file. Dispatched to cipher as BB3-FIX-R6-1789277000, branch fix/bb3-qa5-r6 cut from cipher's BB7 head 35e135673 (stack layer 15 above PR #1467). R6 complete and self-validated by cipher (2026-09-13T02:12:58Z) at final merge head f23d87928 (BB7 b56b35ba7 an ancestor); smoke fast 8/8, evidence archived outside the tree. Fixed-pending-QA at f23d87928." ;
  triage:relatedFinding "BB3-013" ;
  triage:foundIn triage:BB3 ;
  triage:foundAt "2026-09-13T01:11:21Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB3-027/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB3-027/2> ;
  triage:triageRecordVersion "2" .

