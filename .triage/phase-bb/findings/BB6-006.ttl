<urn:atm:triage:finding/BB6-006>
  a triage:Finding ;
  triage:findingId "BB6-006" ;
  triage:title "OpenAPI doc-drift: handoffs field documented against MessageList, which does not model the task-events response" ;
  triage:description "rust-best-practices-agent via BB6-QA-L3-1789269000 (PR #1462, feature/bb6-cli-prompt-handoffs @ 40ccd403e), verdict PASS 0/4/2, 2026-09-13T00:38:04Z. openapi.yaml (lines 446-452, both copies) documents the new `handoffs` field on the MessageList schema, but MessageList does not model the task-events response that actually carries handoffs. Ruled genuine by fenix (PR #1462 comment, 2026-09-13T00:38:04Z)." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:source "rust-best-practices-agent via BB6-QA-L3-1789269000, ruled genuine by fenix" ;
  triage:repeatable true ;
  triage:sweepScope "openapi.yaml:446-452 (both copies)" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T00:38:04Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: move the handoffs field documentation to the correct task-events response schema in both openapi.yaml copies at lines 446-452. Routed to solar on BB6-FIX-CLI-QA1-1789270000, branch fix/bb6-cli-qa1 cut from 4b0f6661c. Solar's ruling on this fix (fenix, 2026-09-13T00:52:35Z): GET /messages ref unchanged; ListOutcome schema added additively; handoffs removed from MessageList and from the never-shipped L3 baseline entry. BB.7 debt surfaced by this fix, initially mischaracterized as an externally-tagged ResponseEnvelope; CORRECTED by fenix (2026-09-13T01:00:25Z): decode_http_response actually reads bare ListOutcome (GET /messages) and bare ReadOutcome (POST /messages/inspect, /messages/read) -- MessageList {messages, cursor} models none of the three. Pulled forward by Rand as a new stack layer rather than deferred; filed separately as BB7-OPENAPI-001, dispatched to cipher on fix/bb7-openapi-message-bodies. BB6-FIX-CLI-QA1-1789270000 complete and self-validated by solar (2026-09-13T01:10:38Z); implementation commit 35c759ef4. Final layer head fix/bb6-cli-qa1 @ adda7e3f9, parent 3aa1954e8 (BB6 L4 final). Fixed-pending-QA at adda7e3f9." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-13T00:38:04Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-006/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-006/2> ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:closedBy "quality-mgr" ;
  triage:closedAt "2026-09-13T01:28:29Z"^^xsd:dateTime ;
  triage:triageRecordVersion "3" .

