<urn:atm:triage:finding/BB1-024>
  a triage:Finding ;
  triage:findingId "BB1-024" ;
  triage:title "Acceptance criterion 1's grep doesn't account for a legitimate pre-existing retired-kind occurrence" ;
  triage:description "quality-mgr BB1-QA1-1789242600 (Final Quality Report, FAIL, https://github.com/randlee/atm-core/pull/1438#issuecomment-5648365789, 2026-09-12T20:06:37Z), reviewed at b06b3e262. QA1-I3, related to BB1-001's concat!()-evasion finding but a distinct, independently actionable defect: crates/atm-storage-rusqlite/src/template_override_migration.rs:131 has a legacy seven-kind schema-migration CHECK-constraint literal that also matches BB.1's own acceptance-criterion-1 grep pattern (grep -rn \"AcknowledgeTask|K::Task\\\\b|'acknowledge_task'\" crates/). This occurrence is legitimate historical-compatibility code, not a new AC1 violation, but the acceptance criterion's wording (\"only the retired-kind from_str arm and its test\") doesn't account for it, so a correct re-run of the grep against plain (unobfuscated) literals will still show an extra hit that AC1's wording doesn't explain." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "process" ;
  triage:severity "important" ;
  triage:source "qa" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-storage-rusqlite/src/template_override_migration.rs:131; docs/plans/phase-bb/sprint-BB.1-transition-templates.md (acceptance criterion 1 wording)" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-12T20:06:37Z"^^xsd:dateTime ;
  triage:deferredNote "Recommend updating the acceptance-criterion text to name this exception explicitly, once BB1-001's concat!() evasion is separately fixed and the grep is re-run for real. Fix round R1 goes to solar on a top-of-stack worktree above feature/bb1-transition-templates." ;
  triage:relatedFinding "BB1-001" ;
  triage:foundIn triage:BB1 ;
  triage:foundAt "2026-09-12T20:06:37Z"^^xsd:dateTime ;
