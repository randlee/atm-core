<urn:atm:triage:finding/BB6-012>
  a triage:Finding ;
  triage:findingId "BB6-012" ;
  triage:title "DeadlineBeforeStart/DeadlineAfterStart share one AtmErrorCode, classified only by message substring" ;
  triage:description "rust-best-practices-agent (RBP-F001) via BB6-QA-L2-1789268000 (PR #1461, feature/bb6-runtime-prompt-handoffs @ 0d2cc1142), verdict FAIL 0/3/2 (req-qa deliverable gate only, 0 blocking), 2026-09-13T00:42:20Z. BlockingBridgeError::DeadlineBeforeStart and DeadlineAfterStart both map to the same AtmErrorCode::InternalError (router_support.rs:201), so prompt_handoff_record.rs:49-55 recovers 'saturated' vs 'timeout' only by substring-matching the rendered message text instead of a distinct error code. Independently verified by quality-mgr; ruled genuine by fenix (PR #1461 comment, 2026-09-13T00:42:20Z); distinct additive error codes approved as a design ruling." ;
  triage:phaseId "phase-bb" ;
  triage:triageMode "initial_pass" ;
  triage:category "correctness" ;
  triage:severity "important" ;
  triage:source "rust-best-practices-agent via BB6-QA-L2-1789268000, ruled genuine by fenix, design ruling: distinct additive error codes approved" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-http-runtime/src/herdr_queue_wake/router_support.rs:201; crates/atm-http-runtime/src/herdr_queue_wake/prompt_handoff_record.rs:49-55" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:deferredNote "Fix: add a distinct AtmErrorCode for DeadlineBeforeStart vs DeadlineAfterStart (additive, per fenix's design ruling) and have prompt_handoff_record.rs:49-55 classify on the error code instead of substring-matching the rendered message. Routed to arch-ctm on BB6-FIX-RUNTIME-QA1-1789271000, branch fix/bb6-runtime-qa1 cut from 4b0f6661c. PR #1461, base feature/bb6-runtime-prompt-handoffs." ;
  triage:foundIn triage:BB6 ;
  triage:foundAt "2026-09-13T00:42:20Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BB6-012/1> ;
