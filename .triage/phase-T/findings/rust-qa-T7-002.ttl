<urn:atm:triage:finding/rust-qa-T7-002>
  a triage:Finding ;
  triage:findingId "rust-qa-T7-002" ;
  triage:title "hydrate_member_for_test declared pub(crate) but never called; #[allow(dead_code)] masks it" ;
  triage:description "runtime_health_test_support.rs line 24 declares pub(crate) fn hydrate_member_for_test() annotated with #[allow(dead_code)]. A workspace-wide grep confirms this function is never called anywhere in the codebase — not in test modules, not in integration tests. The #[allow(dead_code)] was added to silence the compiler warning rather than removing the function. The sibling functions member_state_for_test (line 5) and insert_member_for_test (line 43) are used in tests; hydrate_member_for_test was likely superseded by insert_member_for_test. Confirmed open on T.4, T.5, T.6, T.7, and T.8; the dead function predates graft additions." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-qa" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
