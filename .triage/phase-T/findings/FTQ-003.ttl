# FTQ-003 — recv_timeout(5s) too tight relative to drain(500ms) + force_cancel(2s)
# Triaged: 2026-05-10T00:00:00Z
# Mode: initial_pass | Phase: phase-T

<urn:atm:triage:finding/FTQ-003>
  a triage:Finding ;
  triage:findingId "FTQ-003" ;
  triage:title "tests.rs recv_timeout(5s) too tight relative to drain(500ms) + force_cancel(2s)" ;
  triage:description "crates/atm-daemon/src/tests.rs: recv_timeout(Duration::from_secs(5)) leaves only ~2.5s of slack over drain(500ms) + force_cancel(2s). Widen to 15s to match the Windows test timeout pattern and prevent flaky CI failures on slow runners." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

