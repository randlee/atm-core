# RBP-F003 — followup_pass
# Scope expanded from shared_db.rs (initial_pass) to also cover
# notification_runtime.rs and watch_runtime.rs, following T.1 QA-3 report
# at 7a0a928. Prior record incorrectly marked T.1 as fixed for this finding.
# T.1 shared_db.rs fix (bdc8ce1) is confirmed still present; new occurrences
# in notification_runtime.rs:63,138 and watch_runtime.rs:179,275,339 are open
# on T.1 (7a0a928) and have not propagated down via merge-forward to T.2–T.5
# or integrate/phase-T.

<urn:atm:triage:finding/RBP-F003>
  a triage:Finding ;
  triage:findingId "RBP-F003" ;
  triage:title "lock-poison recovery (.with_recovery()) missing — expanded scope to notification_runtime.rs and watch_runtime.rs" ;
  triage:description "Prior triage (initial_pass) covered shared_db.rs only. T.1 QA-3 (7a0a928) found .with_recovery() also missing in crates/atm-daemon/src/notification_runtime.rs at lines 63 and 138, and crates/atm-daemon/src/watch_runtime.rs at lines 179, 275, and 339. These lock-poison paths return bare daemon_unavailable errors without the mandatory .with_recovery() chain. The shared_db.rs fix from bdc8ce1 is confirmed present on T.1. All branches T.1 through integrate/phase-T carry the expanded occurrences; merge-forward has not distributed the existing partial fix set." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:category "RBP" ;
  triage:severity "blocking" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T12:00:00Z"^^xsd:dateTime ;

