<urn:atm:triage:finding/RSH-005>
  a triage:Finding ;
  triage:findingId "RSH-005" ;
  triage:title "SharedDb::open() missing startup diagnostic for connection budget" ;
  triage:description "crates/atm-rusqlite/src/shared_db.rs SharedDb::open() does not emit any tracing diagnostic for the connection budget. MAX_SQLITE_READER_CONNECTIONS = 3 is enforced but unobservable at startup. Fix: add tracing::debug!(writer_handles = 1, reader_budget = MAX_SQLITE_READER_CONNECTIONS, path = %target.display(), \"sqlite boundary assembly opened\") in SharedDb::open() after writer start (around line 208-230). T.3 partially fixed the issue by adding a doc-comment rationale on the const (lines 12-14 on T3, T4, T5) but the tracing::debug! in SharedDb::open() is still absent on all branches." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "followup_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-005/pT-t2/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-005/pT-t2/2> ;
