  a triage:Finding ;
  triage:findingId "FTQ-T7-006" ;
  triage:title "windows_terminate_request_wakes_waiters recv_timeout(1s) too tight for Windows CI" ;
  triage:description "crates/atm-daemon/src/lifecycle_control.rs:601 — recv_timeout(Duration::from_secs(1)) in windows_terminate_request_wakes_waiters test is too short for loaded Windows CI runners. Fix: increase to 5s to match the pattern used for other test assertion timeouts in the same file." ;
