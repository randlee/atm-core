<urn:atm:triage:finding/FTQ-T7-005>
  a triage:Finding ;
  triage:findingId "FTQ-T7-005" ;
  triage:title "shutdown_beacon wait_until_tripped busy-polls without entry confirmation in tests" ;
  triage:description "crates/atm-daemon/src/shutdown_beacon.rs:47 — wait_until_tripped busy-polls with 5ms sleep. In tests, thread::yield_now() is called before trip with no confirmation the waiter is inside the polling loop. Fix: add a channel or condvar to confirm waiter entry before testing the trip condition." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
