<urn:atm:triage:finding/FTQ-T5-005>
  a triage:Finding ;
  triage:findingId "FTQ-T5-005" ;
  triage:title "notification_runtime.rs test calls shutdown().expect() which races with worker self-exit" ;
  triage:description "Tests at lines 291 and 314 of notification_runtime.rs call runtime.shutdown().expect(\"shutdown\"). If the worker exits on its own before shutdown() is called, the shutdown channel may be disconnected causing shutdown() to return Err and the test to panic. The .expect() masks an inherent race." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-T5-005/pT-t5-hardening/1> ;
