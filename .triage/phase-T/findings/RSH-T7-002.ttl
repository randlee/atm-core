<urn:atm:triage:finding/RSH-T7-002>
  a triage:Finding ;
  triage:findingId "RSH-T7-002" ;
  triage:title "fetch_nudges takes exclusive Mutex lock for read-only operation" ;
  triage:description "GraftRuntime.fetch_nudges() calls lock_state() which acquires an exclusive std::sync::Mutex lock. fetch_nudges only reads session state and does not mutate it; a shared RwLock read-guard would allow concurrent readers without blocking. The Mutex<GraftRuntimeState> field should be replaced with RwLock<GraftRuntimeState> and fetch_nudges updated to use read()." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-T7-002/T7/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-T7-002/T8/1> ;
  triage:openOn <urn:atm:triage:worktree/T7/6986027> ;
  triage:openOn <urn:atm:triage:worktree/T8/afbd906> ;
  triage:promoteTo <urn:atm:triage:worktree/T8/afbd906> .

