# ─────────────────────────────────────────────────────────────────────────────
# Finding: ATM-QA-T3-001
# Missing duplicate-key payload preservation test in writer/mod.rs
# Triage mode: initial_pass  Phase: phase-T
# ─────────────────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/ATM-QA-T3-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-T3-001" ;
  triage:title "Missing duplicate-key payload preservation test" ;
  triage:description "REQ-RUSQLITE-IMMUT-001 acceptance criterion requires a test that duplicate writes preserve the first payload. crates/atm-rusqlite/src/writer/stmt_cache.rs:16 has ON CONFLICT DO NOTHING (correct) but no test in writer/mod.rs verifies that after a second insert of the same key with a different payload, the stored payload is unchanged and WriteOpResult::UpsertMessage { inserted: false } is returned." ;
  triage:triageMode "initial_pass" ;
  triage:category "missing_test" ;
  triage:phaseId "phase-T" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-001/pT-t2-sqlite-writer/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-001/pT-t3-immutable-rows/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-001/pT-t4-windows-runtime/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-001/pT-t5-hardening/1> ;

  triage:openOn <urn:atm:triage:worktree/pT-t2-sqlite-writer/8fde385> ;
  triage:openOn <urn:atm:triage:worktree/pT-t3-immutable-rows/06b28a4> ;
  triage:openOn <urn:atm:triage:worktree/pT-t4-windows-runtime/8baee53> ;
  triage:openOn <urn:atm:triage:worktree/pT-t5-hardening/6450bb5> ;

  triage:promoteTo <urn:atm:triage:worktree/pT-t5-hardening/6450bb5> .

