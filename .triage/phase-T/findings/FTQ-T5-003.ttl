<urn:atm:triage:finding/FTQ-T5-003>
  a triage:Finding ;
  triage:findingId "FTQ-T5-003" ;
  triage:title "peer_transport.rs response_rx.recv() has no timeout — indefinite hang on server-thread panic" ;
  triage:description "crates/atm-daemon/src/peer_transport.rs: response_rx.recv().expect(\"response delivered\") hangs indefinitely on server-thread panic. Fix: replace with recv_timeout(Duration::from_secs(5))." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
