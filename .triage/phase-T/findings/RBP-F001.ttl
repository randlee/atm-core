@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/RBP-F001>
  a triage:Finding ;
  triage:findingId "RBP-F001" ;
  triage:title "Unnecessary Mutex on JoinHandle — Drop takes &mut self so lock is redundant" ;
  triage:description "SqliteWriter.worker is Mutex<Option<JoinHandle<()>>> (mod.rs:36,88), but Drop::drop takes &mut self (exclusive access already guaranteed). The Mutex is unnecessary — self.worker.take() via &mut self would work without locking. Also found same pattern in reconcile_runtime, notification_runtime, and watch_runtime. Fix: replace Mutex<Option<JoinHandle<()>>> with Option<JoinHandle<()>>; use self.worker.take() directly in Drop." ;
  triage:category "RBP" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F001/pT-t1/1> ;
