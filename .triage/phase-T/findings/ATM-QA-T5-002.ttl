<urn:atm:triage:finding/ATM-QA-T5-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-T5-002" ;
  triage:title "GAP-T5-001 shutdown budget annotation present but no explicit ruling recorded in docs" ;
  triage:description "crates/atm-daemon/src/lib.rs defines GRACEFUL_DRAIN_DEADLINE=2s and FORCE_CANCEL_DEADLINE=3s. docs/architecture.md notes GAP-T5-001 as a tracked contract gap without a ruling. Team-lead ruling: accept 2s/3s as production values (5s/10s was aspirational, never implemented). Record explicit ruling in both docs/architecture.md (shutdown budget section) and docs/atm-daemon/requirements.md section 5. Ruling absent in all branches." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-T" ;
  triage:severity "blocking" ;
