<urn:atm:triage:finding/ATM-QA-T7-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-T7-006" ;
  triage:title "BOUNDARY-001 boundary record absent from boundaries.md" ;
  triage:description "docs/atm-core/boundaries.md and docs/atm-rusqlite/boundaries.md have no entry for the rusqlite::Connection / message_count_in_connection RULE-012 path. ADR-ATM-RUSQLITE-002 references BOUNDARY-MailStore-Sqlite etc. but BOUNDARY-001 record is absent. Fix: add BOUNDARY-001 boundary record referencing ADR-ATM-RUSQLITE-002 to docs/atm-rusqlite/boundaries.md." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable false ;
