<urn:atm:triage:finding/ATM-QA-T7-007>
  a triage:Finding ;
  triage:findingId "ATM-QA-T7-007" ;
  triage:title "ICD §3.1 graft additions appear as appendage not first-class in unified surface table" ;
  triage:description "docs/atm-daemon/protocol-icd.md has a §3.1 section titled 'Phase S Supported Packet Surface' and a separate §3.2 section titled 'Phase T Graft Semantic Surface'. The graft packet opcodes (0x0008-0x000b, 0x1008-0x100b) appear in the unified opcode tables in §4+ but the §3 surface declaration splits graft additions into a second subsection rather than merging them into the single §3.1 surface table. The split was introduced at T.6 and carries forward to T.7 and T.8 unchanged. T.4 and T.5 predate graft additions and have only §3.1." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
