# Finding: QA-T1-R3-001
# peer_transport.rs tests not annotated #[serial] — process-global terminate flag race
# Triaged: 2026-05-10T00:00:00Z
# Mode: initial_pass

<urn:atm:triage:finding/QA-T1-R3-001>
  a triage:Finding ;
  triage:findingId "QA-T1-R3-001" ;
  triage:title "peer_transport.rs tests not annotated #[serial] — process-global terminate flag race" ;
  triage:description "bdc8ce1 changed timing in accept_after_terminate_returns_typed_shutdown_error (now waits for publish_ready hook before storing terminate=true), widening the window during which the process-global SHARED_LIFECYCLE terminate flag is true. Concurrent non-serial peer_transport tests call daemon_terminate_flag() inside that window -> terminate_before_first_attempt=true -> DaemonUnavailable instead of OutcomeUnknown -> assert_eq panics. Fix: add #[serial] to 7 tests at peer_transport.rs." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/QA-T1-R3-001/pT-t1-integration-gate/1> ;
