<urn:atm:triage:finding/RSH-T5-006>
  a triage:Finding ;
  triage:findingId "RSH-T5-006" ;
  triage:title "Anonymous std::thread::spawn without Builder+name in local_ipc_transport, notification_runtime, runtime_health" ;
  triage:description "Multiple std::thread::spawn calls in local_ipc_transport.rs (lines 763, 927), notification_runtime.rs (line 112), and runtime_health.rs (lines 370, 391) use std::thread::spawn directly instead of std::thread::Builder::new().name(...).spawn() making threads anonymous in diagnostics and panic traces." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

