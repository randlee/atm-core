<urn:atm:triage:finding/RBP-T5-F001>
  a triage:Finding ;
  triage:findingId "RBP-T5-F001" ;
  triage:title "RuntimeStatusCache Mutex lock-scope rationale missing in runtime_health.rs" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs: single Arc<Mutex<RuntimeStatusCacheState>> with no comment explaining why full-state lock is correct vs narrower per-field primitives, and why eviction runs under the lock. record_heartbeat holds lock across linear eviction scan; snapshot holds across full member iteration. Add rationale comment." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
