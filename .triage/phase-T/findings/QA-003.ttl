@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/QA-003>
  a triage:Finding ;
  triage:findingId "QA-003" ;
  triage:title "Shutdown as first message breaks pending callers — no DaemonUnavailable reply sent" ;
  triage:description "When receive_first_message sees Shutdown as the first message (with shutting_down=false), it returns None and breaks the loop immediately without draining remaining Submit messages (mod.rs:127-129). Callers whose ops were enqueued before Shutdown will block forever on reply_rx.recv() since their reply is never sent. Fix: when breaking on Shutdown in receive_first_message, drain remaining Submit messages from the channel and send each a DaemonUnavailable error reply before returning." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "QA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/QA-003/pT-t2/1> ;
  triage:openOn <urn:atm:triage:worktree/pT-t2/5275b3c> ;
  triage:promoteTo <urn:atm:triage:worktree/pT-t2/5275b3c> .

