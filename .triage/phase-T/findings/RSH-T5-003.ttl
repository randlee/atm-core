<urn:atm:triage:finding/RSH-T5-003>
  a triage:Finding ;
  triage:findingId "RSH-T5-003" ;
  triage:title "wait_until_tripped spin-poll only used in tests but not gated #[cfg(test)]" ;
  triage:description "shutdown_beacon.rs:21 wait_until_tripped uses a 5ms spin-poll loop and is only called from tests. It is currently annotated with #[cfg_attr(any(windows, not(test)), allow(dead_code))] which suppresses the warning rather than conditionally compiling the function out, leaving it accessible in production builds." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

