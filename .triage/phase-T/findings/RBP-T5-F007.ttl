<urn:atm:triage:finding/RBP-T5-F007>
  a triage:Finding ;
  triage:findingId "RBP-T5-F007" ;
  triage:title "Disconnected path returns Err in notification_runtime but Ok in reconcile_runtime — misaligned behavior" ;
  triage:description "notification_runtime.rs Disconnected arm returns Err (join helper disconnected); reconcile_runtime.rs Disconnected arm logs a warn! and falls through to Ok(()). The two runtimes treat the same RecvTimeoutError::Disconnected condition differently with no documented justification. Additionally neither the notification Disconnected Err nor the reconcile Disconnected path has .with_recovery()." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-T5-F007/pT-t5-hardening/1> ;
