<urn:atm:triage:finding/FTQ-T7-NEW-001>
  a triage:Finding ;
  triage:findingId "FTQ-T7-NEW-001" ;
  triage:title "LIFECYCLE_WORKER_JOIN_DEADLINE = 1s too short for loaded Windows CI" ;
  triage:description "crates/atm-daemon/src/lifecycle_control.rs:8 — LIFECYCLE_WORKER_JOIN_DEADLINE = Duration::from_secs(1) used as recv_timeout for joining lifecycle worker thread (line 253). Same Windows CI timing concern as FTQ-T7-006/006B: worker polls at 100ms (Unix) / 25ms (Windows); on loaded runner the join may not complete within 1s. Affects unix_install_reuses_one_lifecycle_worker_until_shutdown and windows_install_reuses_one_lifecycle_worker_until_shutdown. Fix: raise constant to Duration::from_secs(5)." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
