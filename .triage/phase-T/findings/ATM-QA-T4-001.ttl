<urn:atm:triage:finding/ATM-QA-T4-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-T4-001" ;
  triage:title "REQ-RUSQLITE-IMMUT-003 exception clause — Section 5 still missing after FIX-R4" ;
  triage:description "FIX-R4 (41e00e2, now superseded by b5d3186 on T4) restored Section 3 by merging T3. Section 5 on T4 (b5d3186) still reads 'immutable-row enforcement must remove the pre-write probe from the hot mailbox write path' with no exception clause. T5 (30082e8) inherited both the Section 3 short form (also missing exception clause) and the Section 5 gap. T3 (e5a8d09) is fixed in Section 3 only; Section 5 on T3 also lacks the exception clause. Required addition: This ban applies to hot-path probe queries only; crate-owned invariant validation queries that reject known schema or logical violations before SQL submission are permitted." ;
  triage:triageMode "followup_pass" ;
  triage:category "missing_exception_clause" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

