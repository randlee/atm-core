# Finding: ATM-QA-T4-001
# REQ-RUSQLITE-IMMUT-003 exception clause for invariant validation queries
# dropped in T.4 merge conflict resolution.
# Triage mode: initial_pass | Phase: phase-T | Date: 2026-05-10

<urn:atm:triage:finding/ATM-QA-T4-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-T4-001" ;
  triage:title "REQ-RUSQLITE-IMMUT-003 exception clause for invariant validation queries dropped in T.4 merge conflict resolution" ;
  triage:description "docs/atm-rusqlite/requirements.md Section 3 (around line 70) and Section 5 (around line 130) on T.4 (475de31) are missing the exception clause: This ban applies to hot-path probe queries only; crate-owned invariant validation queries that reject known schema/logical violations before SQL submission are permitted. This text existed on T.3 (1113b99) but was dropped during T.4's merge conflict resolution with integrate/phase-T. T.5 (6450bb5) inherited the defect." ;
  triage:triageMode "initial_pass" ;
  triage:category "missing_exception_clause" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T4-001/T4/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T4-001/T4/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T4-001/T5/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T4-001/T5/2> ;
  triage:openOn <urn:atm:triage:worktree/T4/475de31> ;
  triage:openOn <urn:atm:triage:worktree/T5/6450bb5> ;
  triage:promoteTo <urn:atm:triage:worktree/T5/6450bb5> .

# Occurrence 1: T4 Section 3 (lines 70-73) — exception clause absent
<urn:atm:triage:occurrence/ATM-QA-T4-001/T4/1>
  a triage:Occurrence ;
  triage:file "docs/atm-rusqlite/requirements.md" ;
  triage:line 70 ;
  triage:snippet "- `REQ-RUSQLITE-IMMUT-003` the hot mailbox write path must not issue a pre-write probe before submitting message inserts to the writer lane; queue semantics and row-count detection own duplicate handling. Satisfies: `REQ-RUNTIME-002`." ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pT-t4-windows-runtime" ;
  triage:headSha "475de31" ;
  triage:section "Section 3" ;
  triage:note "Exception clause missing: This ban applies to hot-path probe queries only; crate-owned invariant validation queries that reject known schema/logical violations before SQL submission are permitted." ;
  triage:occursIn <urn:atm:triage:worktree/T4/475de31> .

