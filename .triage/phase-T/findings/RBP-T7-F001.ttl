<urn:atm:triage:finding/RBP-T7-F001>
  a triage:Finding ;
  triage:findingId "RBP-T7-F001" ;
  triage:title "GraftQueueCommand::session_id() returns anyhow::Result losing AtmError.recovery" ;
  triage:description "crates/atm/src/commands/graft.rs — bridging to anyhow at CLI layer drops the structured recovery hint from AtmError. Fix: return Result<_, AtmError> and map to anyhow only at the clap command entry point. Internal methods session_id(), limit(), fetch(), drain() all use anyhow::Result instead of AtmError." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
