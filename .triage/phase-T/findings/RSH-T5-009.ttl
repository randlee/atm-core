<urn:atm:triage:finding/RSH-T5-009>
  a triage:Finding ;
  triage:findingId "RSH-T5-009" ;
  triage:title "MAX_DAEMON_FRAME_BYTES enforced in atm_core::protocol but not referenced by constant name in daemon crate docs" ;
  triage:description "local_ipc_transport.rs references atm_core::protocol::MAX_DAEMON_FRAME_BYTES in tracing fields (lines 208, 919). The daemon docs (docs/atm-daemon/protocol-icd.md) document the 1_048_576 byte limit by prose/value as 'n' but do not cite the constant name MAX_DAEMON_FRAME_BYTES, making the docs and code link non-obvious." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

