<urn:atm:triage:finding/RSH-006>
  a triage:Finding ;
  triage:findingId "RSH-006" ;
  triage:title "acquire_connection_guard() budget exhaustion has no tracing::warn!" ;
  triage:description "In crates/atm-rusqlite/src/shared_db.rs, function acquire_connection_guard(): when *connection_count >= MAX_SQLITE_READER_CONNECTIONS the function returns Err with no structured log event. Budget saturation is operationally significant and must be observable without tracing every caller. Fix: add tracing::warn!(limit = MAX_SQLITE_READER_CONNECTIONS, current = %connection_count, \"sqlite reader connection budget exhausted\") before the return Err at the budget-exhaustion branch." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:pattern "missing-observability" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-006/pT-t1-integration-gate/1> ;
