# ─────────────────────────────────────────────────────────────────────────────
# Finding: ATM-QA-T3-005
# copy_error() maps all outer-batch commit errors to DaemonUnavailable
# Triage mode : initial_pass
# Phase        : phase-T
# Triaged at   : 2026-05-10T00:00:00Z
# ─────────────────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/ATM-QA-T3-005>
    a triage:Finding ;
    triage:findingId "ATM-QA-T3-005" ;
    triage:title "copy_error() maps all outer-batch commit errors to DaemonUnavailable" ;
    triage:description "crates/atm-rusqlite/src/writer/mod.rs copy_error() (line 419): the outer transaction commit failure always returns AtmError::DaemonUnavailable regardless of the SQLite error code. Per architecture.md:170-180, SQLITE_BUSY on the outer commit should map to a retry-able error type, not DaemonUnavailable. Fix: in copy_error(), inspect the underlying error code and map SQLITE_BUSY to a retry-able error variant; only map non-transient failures to DaemonUnavailable." ;
    triage:category "wrong_error_mapping" ;
    triage:phaseId "phase-T" ;
    triage:triageMode "initial_pass" ;
    triage:severity "important" ;
    triage:repeatable false ;
    triage:sweepScope "file_only" ;
    triage:status "open" ;
    triage:dispatchReady true ;
    triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
    triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-005/pT-t2/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-005/pT-t3/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-005/pT-t4/1> ;
    triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-005/pT-t5/1> ;
    triage:openOn <urn:atm:triage:worktree/pT-t2/8fde385> ;
    triage:openOn <urn:atm:triage:worktree/pT-t3/06b28a4> ;
    triage:openOn <urn:atm:triage:worktree/pT-t4/8baee53> ;
    triage:openOn <urn:atm:triage:worktree/pT-t5/6450bb5> ;
    triage:promoteTo <urn:atm:triage:worktree/pT-t5/6450bb5> .

