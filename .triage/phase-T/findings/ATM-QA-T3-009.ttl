<urn:atm:triage:finding/ATM-QA-T3-009>
  a triage:Finding ;
  triage:findingId "ATM-QA-T3-009" ;
  triage:title "temp_disk_target() and PathBuf import dead code on T.3 — clippy -D dead-code CI fail" ;
  triage:description "In crates/atm-rusqlite/src/writer/mod.rs on feature/pT-t3-immutable-rows at e5a8d09: (1) fn temp_disk_target() at line 475 is defined but never called — all callers were removed when the stale deadline-flush test body was deleted in FIX-R5. Clippy -D warnings / -D dead-code fails with 'function temp_disk_target is never used'. (2) use std::path::PathBuf at line 458 is unused after temp_disk_target is removed (PathBuf was only used in temp_disk_target's signature). Fix: delete fn temp_disk_target() at lines 475-479 AND delete use std::path::PathBuf at line 458. Note: ATM-QA-T4-002 already identified the same dead-code pattern on T.4 (open) and T.3 (open). This finding covers the T.3-specific fix path, since T.3 cannot receive the T.4 fix via merge-forward." ;
  triage:triageMode "initial_pass" ;
  triage:category "dead-code" ;
  triage:phaseId "phase-T" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-009/pT-t3-immutable-rows/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-009/pT-t3-immutable-rows/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-009/pT-t4-windows-runtime/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-009/pT-t4-windows-runtime/2> ;
  triage:openOn <urn:atm:triage:worktree/pT-t3-immutable-rows/e5a8d09> ;
  triage:openOn <urn:atm:triage:worktree/pT-t4-windows-runtime/b5d3186> ;
