<urn:atm:triage:finding/RSH-T5-008>
  a triage:Finding ;
  triage:findingId "RSH-T5-008" ;
  triage:title "peer_transport.rs silently falls back to PeerTransportConfig::default() on config load failure" ;
  triage:description "PeerClientTransport::new() at line 107-115 of peer_transport.rs uses .unwrap_or_default() after load_workspace_config fails, silently applying default config with no tracing::warn! when ATM_DAEMON_PEER_ADDR is set. Missing warn log makes misconfiguration invisible in production." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-T5-008/pT-t5-hardening/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-T5-008/pT-t6-graft-client-surface/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-T5-008/pT-t7-graft-runtime/1> ;
