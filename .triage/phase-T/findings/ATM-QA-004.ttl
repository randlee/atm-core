<urn:atm:triage:finding/ATM-QA-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-004" ;
  triage:title "thread::sleep sole readiness primitive in connect_daemon_local_ipc_until_ready" ;
  triage:description "crates/atm-daemon/src/test_support.rs — std::thread::sleep(5ms) is the sole readiness primitive in connect_daemon_local_ipc_until_ready. T.1 (7a0a928) replaced it with mpsc::Receiver<()>.recv_timeout channel-based signalling. Branches T.2 through T.5 and integrate/phase-T have not received the merge-forward and remain open. T.4 QA-2 confirmed still open at 8baee53." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "followup_pass" ;
  triage:category "ATM-QA" ;
