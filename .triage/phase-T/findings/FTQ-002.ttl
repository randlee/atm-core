# ── Finding ────────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/FTQ-002>
  a triage:Finding ;
  triage:findingId "FTQ-002" ;
  triage:title "windows_local_ipc_runtime_terminate_finishes_within_deadline has no readiness gate before terminate signal" ;
  triage:description "cfg(windows) test windows_local_ipc_runtime_terminate_finishes_within_deadline spawns serve_with_runtime_hooks on a thread then immediately calls set_terminate_for_test(true) with no readiness gate. publish_ready is a no-op closure (|| Ok(())), so there is no handshake ensuring the accept-loop has entered before terminate fires. The runtime may miss shutdown entirely. Companion tests use a ready_tx/ready_rx sync_channel and wait on ready_rx.recv() before signalling terminate; this test must adopt the same pattern." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:pattern "race_condition_test" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  # occurrences — one per open branch
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/pT-t1-integration-gate/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/pT-t2-sqlite-writer/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/pT-t3-immutable-rows/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/pT-t4-windows-runtime/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/pT-t5-hardening/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-002/integrate-phase-T/1> ;

  # branch state edges
  triage:openOn <urn:atm:triage:worktree/pT-t1-integration-gate/0e6b024> ;
  triage:openOn <urn:atm:triage:worktree/pT-t2-sqlite-writer/d6f89e3> ;
  triage:openOn <urn:atm:triage:worktree/pT-t3-immutable-rows/06b28a4> ;
  triage:openOn <urn:atm:triage:worktree/pT-t4-windows-runtime/d180818> ;
