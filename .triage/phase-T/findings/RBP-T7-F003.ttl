<urn:atm:triage:finding/RBP-T7-F003>
  a triage:Finding ;
  triage:findingId "RBP-T7-F003" ;
  triage:title "lock_state() at graft_runtime.rs:221 uses .map_err(|_| ...) without .n() recovery hint" ;
  triage:description "lock_state() at line 221-224 in graft_runtime.rs uses .map_err(|_| AtmError::daemon_unavailable(...)) to discard the poison error. Other error sites in the same file and codebase chain .n(\"...\") (the AtmError recovery-hint builder) to provide structured recovery guidance. The lock_state map_err is the only site in graft_runtime.rs missing the .n() recovery annotation. Confirmed open on T.7 (6986027) and T.8 (afbd906)." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
