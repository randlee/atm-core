<urn:atm:triage:finding/ATM-QA-T7-008>
  a triage:Finding ;
  triage:findingId "ATM-QA-T7-008" ;
  triage:title "enqueue_nudge_for_recipient emits tracing::warn! bypassing DaemonRuntimeObservability boundary" ;
  triage:description "GraftRuntime.enqueue_nudge_for_recipient() emits tracing::warn! directly at graft_runtime.rs:198 when the nudge queue overflows. GraftRuntime holds no reference to Arc<dyn DaemonRuntimeObservability>; it is composed into RuntimeHealth which does hold the observability arc. The warn! therefore bypasses the structured observability boundary, making overflow events invisible to the health/observability subsystem. The fix requires either passing the observability reference to GraftRuntime or moving the overflow-warn emission up to RuntimeHealth's call site. Confirmed open on both T.7 (6986027) and T.8 (afbd906)." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T7-008/T7/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T7-008/T8/1> ;
  triage:openOn <urn:atm:triage:worktree/T7/6986027> ;
  triage:openOn <urn:atm:triage:worktree/T8/afbd906> ;
  triage:promoteTo <urn:atm:triage:worktree/T8/afbd906> .

