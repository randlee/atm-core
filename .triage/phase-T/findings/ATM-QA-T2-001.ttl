<urn:atm:triage:finding/ATM-QA-T2-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-T2-001" ;
  triage:title "Writer tests absent — shutdown drain, batch drain, queue-full paths unverified" ;
  triage:description "Sprint acceptance criterion requires bounded and test-covered worker queue, batch drain, and shutdown path. Three test scenarios missing: (a) shutdown drain: no test submits N ops, drops SqliteWriter, reopens DB, verifies all N rows present; (b) batch drain boundary: no test submits >=64 ops (BATCH_SIZE_MAX) and asserts all committed; (c) queue-full backpressure: no test saturates 256-slot SyncSender and verifies blocking or error behavior. send-failure branch at mod.rs:70 is untested." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T17:51:37Z"^^xsd:dateTime ;
  triage:openOn <urn:atm:triage:worktree/pT-t2-sqlite-writer/5275b3c> ;
  triage:promoteTo <urn:atm:triage:worktree/pT-t2-sqlite-writer/5275b3c> ;
