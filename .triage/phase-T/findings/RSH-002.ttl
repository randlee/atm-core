<urn:atm:triage:finding/RSH-002>
  a triage:Finding ;
  triage:findingId "RSH-002" ;
  triage:title "Blocking send(Shutdown) in Drop — can block indefinitely under high write load" ;
  triage:description "self.sender.send(WriterMessage::Shutdown) in Drop (mod.rs:87) blocks if the 256-slot channel is full. Drop caller can block indefinitely under high write load before Shutdown is even enqueued. Fix: use try_send; on Full, log a warning and rely on channel disconnect to wake the writer loop instead." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-002/pT-t3/1> ;
  triage:openOn <urn:atm:triage:worktree/pT-t3/f9f1e3f> ;
  triage:fixedOn <urn:atm:triage:worktree/pT-t2/8fde385> ;
  triage:promoteTo <urn:atm:triage:worktree/pT-t3/f9f1e3f> .

