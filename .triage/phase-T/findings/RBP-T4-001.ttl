  triage:title "notify_all() called while Mutex guard still held — unnecessary contention" ;
  triage:description "crates/atm-daemon/src/test_observability.rs:76 — notify_all() called while Mutex guard still held; causes unnecessary contention. Drop guard before notify_all." ;
