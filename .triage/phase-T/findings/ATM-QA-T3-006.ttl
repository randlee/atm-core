<urn:atm:triage:finding/ATM-QA-T3-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-T3-006" ;
  triage:title "rows-changed detection deliverable not in sprint-T3 acceptance criteria" ;
  triage:description "WriteOpResult::UpsertMessage { inserted: bool } is implemented in crates/atm-rusqlite/src/writer/ops.rs:16-18 but the sprint-T3-immutable-rows.md Acceptance Criteria section does not include rows-changed detection as a verifiable criterion. The Deliverables section (line 28) names 'insert-first / rows-changed detection' but the Acceptance Criteria section omits this requirement entirely. Fix: add rows-changed detection deliverable to the Acceptance Criteria in docs/phase-T/sprint-T3-immutable-rows.md." ;
  triage:triageMode "initial_pass" ;
  triage:category "missing_deliverable_in_doc" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
