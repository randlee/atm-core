<urn:atm:triage:finding/ATM-QA-T3-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-T3-006" ;
  triage:title "sprint-T3-immutable-rows.md Acceptance Criteria missing rows-changed detection criterion" ;
  triage:description "docs/phase-T/sprint-T3-immutable-rows.md Acceptance Criteria section (lines 46-56 on T.3) has 6 items but omits the rows-changed detection criterion. The Deliverables section names it. Fix: add AC item 'rows-changed detection is used to determine inserted=true/false rather than a pre-write probe or conflict-driven mutation.' Feature branch pT-t3 added WriteOpResult::UpsertMessage { inserted: bool } at AC line 52; all other branches and integrate/phase-T still omit this criterion." ;
  triage:triageMode "followup_pass" ;
  triage:category "missing_acceptance_criterion" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
