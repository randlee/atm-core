<urn:atm:triage:finding/RBP-T5-F002>
  a triage:Finding ;
  triage:findingId "RBP-T5-F002" ;
  triage:title "ReconcileRuntimeInner locking-order contract undocumented" ;
  triage:description "crates/atm-daemon/src/reconcile_runtime.rs: state: Mutex<ReconcileState> and notification_fingerprints: Arc<Mutex<NotificationFingerprintRegistry>> with no comment confirming they are never held simultaneously. Add explicit locking-order invariant comment: reconcile_worker_loop drops state lock before calling executor which acquires fingerprints lock." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
