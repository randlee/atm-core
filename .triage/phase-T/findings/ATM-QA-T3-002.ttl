<urn:atm:triage:finding/ATM-QA-T3-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-T3-002" ;
  triage:title "REQ-RUSQLITE-IMMUT-003 text ambiguous between banned probe and required invariant queries" ;
  triage:description "docs/atm-rusqlite/requirements.md REQ-RUSQLITE-IMMUT-003 states 'no pre-write probe' but the mandated single-successor and legacy-identity invariant validation queries (SELECT statements that run before INSERT) also qualify as pre-write reads. The text needs to clarify: banned = existence probe (SELECT 1 / COUNT to decide whether to write); allowed = crate-owned invariant validation queries per architecture.md:133-137." ;
  triage:triageMode "initial_pass" ;
  triage:category "doc_ambiguity" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-002/pT-t3/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-002/pT-t4/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-T3-002/pT-t5/1> ;
  triage:openOn <urn:atm:triage:worktree/pT-t3/06b28a4> ;
  triage:openOn <urn:atm:triage:worktree/pT-t4/8baee53> ;
  triage:openOn <urn:atm:triage:worktree/pT-t5/6450bb5> ;
  triage:promoteTo <urn:atm:triage:worktree/pT-t3/06b28a4> .

