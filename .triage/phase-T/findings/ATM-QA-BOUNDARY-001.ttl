<urn:atm:triage:finding/ATM-QA-BOUNDARY-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-BOUNDARY-001" ;
  triage:title "rusqlite::Connection in test helper signature violates boundary rules" ;
  triage:description "fn message_count_in_connection(connection: &rusqlite::Connection) introduced in T.3 writer/mod.rs:542 violates BOUNDARY-ServerTransport and BOUNDARY-ClientTransport-CLI rules. Fix: refactor to accept &SharedDbTarget or &Arc<SharedDbTarget> and open connection internally — eliminating rusqlite::Connection from the function signature." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-T" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
