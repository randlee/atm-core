<urn:atm:triage:finding/ATM-QA-T5-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-T5-001" ;
  triage:title "Three-way conflict on notification queue depth: requirements.md=256, architecture.md=64, code=64" ;
  triage:description "docs/atm-daemon/requirements.md states 'notification work queue depth: 256', but docs/architecture.md and notification_runtime.rs:12 both record DEFAULT_NOTIFICATION_QUEUE_CAPACITY = 64. Team-lead ruling: 64 is authoritative (code+arch agree). Fix: update requirements.md to say 64." ;
