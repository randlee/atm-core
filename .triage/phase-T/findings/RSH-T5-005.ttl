<urn:atm:triage:finding/RSH-T5-005>
  a triage:Finding ;
  triage:findingId "RSH-T5-005" ;
  triage:title "BACKGROUND_LANE_SHUTDOWN_DEADLINE defined twice as local const in composition.rs" ;
  triage:description "composition.rs defines BACKGROUND_LANE_SHUTDOWN_DEADLINE = Duration::from_secs(3) twice: once at line 484 inside rollback_partially_started_lanes and once at line 516 inside shutdown_background_lanes. Should be hoisted to a module-level constant to eliminate duplication." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

