<urn:atm:triage:finding/FTQ-T5-002>
  a triage:Finding ;
  triage:findingId "FTQ-T5-002" ;
  triage:title "drain_shutdown_finalizer_threads_for_test inner thread detaches after recv_timeout" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs: inner std::thread::spawn inside drain_shutdown_finalizer_threads_for_test is detached after recv_timeout. If 5s budget fires and panics mid-join, mutex may poison for next serial test. Fix: recover with into_inner() on poison in drain helper; assert registry length = 0 after drain." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
