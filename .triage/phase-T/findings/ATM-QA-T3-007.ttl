# ──────────────────────────────────────────────────────────
#  Finding: ATM-QA-T3-007
#  Behavioral batch-isolation tests use temp_disk_target() instead of in_memory_target()
#  Phase: phase-T  |  Triage mode: followup_pass
#
#  Followup context (QA-3 FAIL at 6668842):
#    T.3 partially migrated writer tests to in_memory_target() but the two
#    batch-isolation tests remain on temp_disk_target():
#      - invalid_message_row_does_not_poison_other_rows_in_same_batch (line 685)
#      - single_successor_violation_does_not_poison_other_rows_in_same_batch (line 755)
#    Both include persistence-irrelevant db_path.exists() assertions (lines 748, 844).
#    T.4 and T.5 inherited these open occurrences unchanged.
# ──────────────────────────────────────────────────────────

<urn:atm:triage:finding/ATM-QA-T3-007>
  a triage:Finding ;
  triage:findingId "ATM-QA-T3-007" ;
  triage:title "Behavioral batch-isolation tests use temp_disk_target() instead of in_memory_target()" ;
  triage:description "crates/atm-rusqlite/src/writer/mod.rs: invalid_message_row_does_not_poison_other_rows_in_same_batch and single_successor_violation_does_not_poison_other_rows_in_same_batch use temp_disk_target() but test no filesystem behavior. requirements.md:163-165 restricts on-disk temp databases to reopen/migration/filesystem tests. Fix: convert both to in_memory_target() and remove db_path.exists() assertions at lines 748 and 844 on T.3." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "followup_pass" ;
  triage:category "wrong_db_target_in_test" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:followupAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

  # T.3 occurrences (two specific batch-isolation tests still open)
