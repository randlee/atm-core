#  Finding: ATM-QA-T3-007
#  Writer behavioral tests use disk; requirements prefer in-memory
#  Phase: phase-T  |  Triage mode: initial_pass
# ──────────────────────────────────────────────────────────

<urn:atm:triage:finding/ATM-QA-T3-007>
  a triage:Finding ;
  triage:findingId "ATM-QA-T3-007" ;
  triage:title "Writer behavioral tests use disk; requirements prefer in-memory" ;
  triage:description "crates/atm-rusqlite/src/writer/mod.rs test module: all behavioral tests (drain, batch, shutdown, queue-full) use temp_disk_target(). REQ-RUSQLITE-TEST-001 prefers SharedDbTarget::InMemory for behavioral tests; disk should only be used for persistence-verification tests. Fix: migrate non-persistence writer tests to SharedDbTarget::InMemory." ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:category "wrong_test_target" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
