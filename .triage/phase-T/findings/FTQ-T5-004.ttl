<urn:atm:triage:finding/FTQ-T5-004>
  a triage:Finding ;
  triage:findingId "FTQ-T5-004" ;
  triage:title "peer_transport.rs test uses port 9 (TCP discard) — OS/container-dependent" ;
  triage:description "peer_transport_aborts_before_connect_when_terminate_is_requested test at line 812 uses SocketAddr::from((Ipv4Addr::LOCALHOST, 9)) hardcoded to port 9 (TCP discard service). This is OS and container policy dependent. Should use TcpListener::bind(\"127.0.0.1:0\") and drop to get a guaranteed refused connection on an OS-assigned port." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

