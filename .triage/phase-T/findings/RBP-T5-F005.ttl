<urn:atm:triage:finding/RBP-T5-F005>
  a triage:Finding ;
  triage:findingId "RBP-T5-F005" ;
  triage:title "reconcile_runtime.rs fingerprint storage as HashSet<String> without newtype or comment" ;
  triage:description "NotificationFingerprintRegistry uses HashSet<String> for fingerprint storage without a newtype wrapper or explanatory comment clarifying what the String represents (e.g. SHA256 hex, message key). A newtype or doc comment would make the invariants explicit." ;
