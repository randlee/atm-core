@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/FTQ-T3-001>
  a triage:Finding ;
  triage:findingId "FTQ-T3-001" ;
  triage:title "Windows-only race in concurrent_normal_send_and_missing_config_notice_complete_without_data_loss" ;
  triage:description "crates/atm-core/tests/mailbox_locking.rs:502 — test panics on Windows (.expect('missing-config notice') on notices.first() returning None). macOS and Ubuntu pass. Outside T.3 change scope. integrate/phase-T base CI is clean. Appears to be a pre-existing flaky race condition that was previously masked by Clippy failures causing test stage to be skipped. The test carries #[serial_test::serial(env)] which serializes against other serial(env) tests only, not all concurrent tests; on Windows the notice inbox write may not be visible to the reading thread within the test's implicit wait budget. Likely needs a Windows-specific wait budget increase or a global #[serial] guard." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-T" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/tests/" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;
  triage:closedAt "2026-05-11T00:00:00Z"^^xsd:dateTime ;
  triage:closureReason "FTQ expert reviewer traced full call chain: send_mail → send_mail_with_runtime → notify_team_lead_missing_config → append_mailbox_message_and_seed_workflow → commit_workflow_state. No thread spawn, no deferred task anywhere in the chain. Notice inbox write completes inside commit_workflow_state before send_mail_with_runtime returns. Barrier+mpsc synchronization is sufficient. Race definitively resolved by synchronous implementation." ;

  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-T3-001/pT-t3-immutable-rows/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-T3-001/pT-t3-immutable-rows/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-T3-001/pT-t3-immutable-rows/3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-T3-001/pT-t4-windows-runtime/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-T3-001/pT-t4-windows-runtime/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-T3-001/pT-t4-windows-runtime/3> ;
