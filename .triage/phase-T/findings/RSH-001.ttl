<urn:atm:triage:finding/RSH-001>
  a triage:Finding ;
  triage:findingId "RSH-001" ;
  triage:title "Unbounded join in Drop — writer thread can block caller indefinitely" ;
  triage:description "let _ = handle.join() in Drop (mod.rs:91) has no deadline. If the writer thread is blocked on a slow SQLite write or WAL fsync at drop time, the calling thread blocks indefinitely. Fix: bound the join with a deadline (e.g., 5s via sync_channel observer thread + recv_timeout); log + abandon on timeout." ;
  triage:category "RSH" ;
  triage:phaseId "phase-T" ;
  triage:triageMode "initial_pass" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-11T02:42:43.480531Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-001/pT-t2-sqlite-writer/1> ;
  triage:openOn <urn:atm:triage:worktree/pT-t2-sqlite-writer/5275b3c> ;
  triage:promoteTo <urn:atm:triage:worktree/pT-t2-sqlite-writer/5275b3c> .

