<urn:atm:triage:finding/ATM-QA-T4-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-T4-002" ;
  triage:title "temp_disk_target() helper dead code after merge-forward removed the only caller" ;
  triage:description "In crates/atm-rusqlite/src/writer/mod.rs, function temp_disk_target() is defined but never called on branches t3 and t4. After the T.3 merge-forward removed the stale duplicate deadline-flush test, no test in the module calls temp_disk_target(). Clippy under -D warnings raises dead_code error. Fix: delete temp_disk_target() entirely since no test needs a disk target in this sprint." ;
  triage:triageMode "initial_pass" ;
  triage:category "dead-code" ;
  triage:phaseId "phase-T" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
