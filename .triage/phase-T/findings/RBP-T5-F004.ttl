<urn:atm:triage:finding/RBP-T5-F004>
  a triage:Finding ;
  triage:findingId "RBP-T5-F004" ;
  triage:title "SeqCst ordering on reload_requested AtomicBool without rationale comment" ;
  triage:description "local_ipc_transport.rs lines 37-50 use Ordering::SeqCst on the reload_requested AtomicBool in ServeLoopSignals without any comment explaining why SeqCst is required rather than Acquire/Release or Relaxed. SeqCst has a memory-fence cost; rationale should be documented." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-T" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-10T00:00:00Z"^^xsd:dateTime ;

