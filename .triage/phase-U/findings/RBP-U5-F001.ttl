# ── Finding ────────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RBP-U5-F001>
  a triage:Finding ;
  triage:findingId   "RBP-U5-F001" ;
  triage:title       "from_agent deserialization uses bare ? with no row-identity context in error" ;
  triage:description "crates/atm-rusqlite/src/mailbox_metadata.rs: from_agent deserialization uses bare ? with no row-identity context in error. All sibling field parsers in the same block use map_err with AtmError::validation and an explicit message; from_agent.parse()? is the sole exception. Add map_err with row identity (e.g., message_id or row index) to improve debuggability." ;
  triage:triageMode  "initial_pass" ;
  triage:category    "RBP" ;
  triage:phaseId     "phase-U" ;
  triage:severity    "important" ;
  triage:repeatable  true ;
  triage:sweepScope  "file" ;
  triage:status      "open" ;
