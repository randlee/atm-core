<urn:atm:triage:finding/RBP-F004>
  a triage:Finding ;
  triage:findingId "RBP-F004" ;
  triage:title "summarize_mailbox_record return type has unreachable Err and Ok(None) arms" ;
  triage:description "crates/atm-core/src/mailbox/mod.rs — summarize_mailbox_record returns Result<Option<SummaryMessage>, AtmError> but every code path returns Ok(Some(...)). The Err and Ok(None) arms at call sites are structurally unreachable dead code (RBP-007). Fix: change return type to SummaryMessage. Update call sites." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
