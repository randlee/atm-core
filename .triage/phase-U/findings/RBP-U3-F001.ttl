<urn:atm:triage:finding/RBP-U3-F001>
  a triage:Finding ;
  triage:findingId "RBP-U3-F001" ;
  triage:title "parse_mailbox_record leaks raw serde_json::Error instead of AtmError" ;
  triage:description "crates/atm-core/src/mailbox/mod.rs: parse_mailbox_record and parse_mailbox_value return Result<Option<MessageEnvelope>, serde_json::Error>, leaking the raw library error type. The counterpart parse_mailbox_summary_jsonl wraps in AtmError with MailboxRead kind plus path/line context. Required fix: change both functions to return Result<Option<MessageEnvelope>, AtmError> using the same map_err pattern as parse_mailbox_summary_jsonl." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/mailbox/" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T07:53:21Z"^^xsd:dateTime ;
