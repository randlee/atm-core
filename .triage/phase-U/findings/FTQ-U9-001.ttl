# ── Finding ──────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/FTQ-U9-001>
  a triage:Finding ;
  triage:findingId "FTQ-U9-001" ;
  triage:title "INJECTED_ACCEPT_ERROR_FOR_TEST is process-wide static Mutex — shared across tests" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs: INJECTED_ACCEPT_ERROR_FOR_TEST is a process-wide static Mutex. Shared across all tests; creates stale-sender leak risk and nondeterministic test behavior. Fix: convert to per-test injection channel passed at bind time." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:pattern "INJECTED_ACCEPT_ERROR_FOR_TEST|static.*Mutex.*new.*None" ;
  triage:fileFilter "local_ipc_transport.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;

