<urn:atm:triage:finding/RSH-U4-002>
  a triage:Finding ;
  triage:findingId "RSH-U4-002" ;
  triage:title "execute_upsert_message_state accepts past expires_at with no validation or accepted-risk doc" ;
  triage:description "crates/atm-rusqlite/src/writer/ops.rs:258: execute_upsert_message_state accepts any expires_at timestamp including past values with no semantic validation or accepted-risk comment. A caller can persist an already-expired expiry, creating invisible ghost rows with no error feedback since the query layer filters by expiry." ;
