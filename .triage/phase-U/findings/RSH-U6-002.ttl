<urn:atm:triage:finding/RSH-U6-002>
  a triage:Finding ;
  triage:findingId "RSH-U6-002" ;
  triage:title "query_task_metadata full-table scan, no SQL LIMIT (carry-forward RSH-U5-003)" ;
  triage:description "crates/atm-rusqlite/src/lib.rs — query_task_metadata issues SELECT record_json FROM tasks WHERE team = ?1 ORDER BY task_id with no LIMIT clause or per-filter pushdown; entire task table for the team is materialized on every call. Carry-forward of RSH-U5-003 which was in TASK-1388 scope for U.5 but was not fixed." ;
  triage:triageMode "followup_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
