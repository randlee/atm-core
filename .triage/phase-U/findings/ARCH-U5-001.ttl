<urn:atm:triage:finding/ARCH-U5-001>
  a triage:Finding ;
  triage:findingId "ARCH-U5-001" ;
  triage:title "read/mod.rs exceeds 1000-line RULE-003 limit" ;
  triage:description "crates/atm-core/src/read/mod.rs has 1305 non-test lines on feature/pU-u5-sqlite-query-cutover (test module starts at line 1306, total 1915 lines), exceeding the RULE-003 1000-line architectural limit by 305 lines. The u5 sprint added ~415 non-test lines (functions: logical_current_messages, bucket_counts_for, select_messages, selected_after_filters, message_key_for_classified, output_messages_from_metadata_selection, load_logical_current_record, apply_display_mutations_to_store, output_messages_from_selection, effective_display_envelope, hidden_from_normal_views, hidden_for_selection, DisplayMutationResult, displayed_messages_require_mutation, apply_display_mutations, transition_displayed_message). Must be split at a logical seam, e.g. extract metadata-row selection helpers into read/metadata_selection.rs." ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
