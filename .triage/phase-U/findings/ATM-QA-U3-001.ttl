<urn:atm:triage:finding/ATM-QA-U3-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-U3-001" ;
  triage:title "REQ-P-THREAD-005 prematurely renamed stale_at to expires_at with zero code backing" ;
  triage:description "docs/requirements.md in both U2 and U3 branches: REQ-P-THREAD-005 was changed from stale_at to expires_at, but the entire implementation still uses stale_at (threading.rs:11 is_ephemeral(), threading.rs:15 is_expired_ephemeral(), MessageEnvelope struct field, send validation, and a test literally named ephemeral_helpers_use_stale_at). The stale_at->expires_at rename is scoped to sprint U.4 per docs/phase-U/sprint-U3.md and docs/plan-phase-U.md. Both branches also dropped the compatibility/export payloads carry ephemeral expiry with staleAt bullet present in the develop baseline." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
