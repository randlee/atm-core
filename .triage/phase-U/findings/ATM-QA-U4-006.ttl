<urn:atm:triage:finding/ATM-QA-U4-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-U4-006" ;
  triage:title "Missing admin-only visibility test: deleted rows accessible via load_visibility_state" ;
  triage:description "Sprint U.4 contract requires 'admin-only visibility tests for deleted rows.' load_visibility_state surfaces deleted_at to boundary callers, but no test proves deleted rows ARE accessible via that path. Only the exclusion from normal queries is proven. Fix: add positive assertion that a deleted row is visible via load_visibility_state after being hidden from query_mailbox_metadata_rows." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
