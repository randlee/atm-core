<urn:atm:triage:finding/RSH-U9-002>
  a triage:Finding ;
  triage:findingId "RSH-U9-002" ;
  triage:title "advisory stream recv_timeout=None — stalled daemon blocks thread forever" ;
  triage:description "In GraftLocalIpcClientTransport::open_advisory_stream (crates/atm-graft/src/lib.rs:1084), after publishing the advisory stream request, the read timeout is cleared with set_recv_timeout(None). This means a daemon that stops responding without closing the socket will stall the live receive thread indefinitely with no timeout recovery path." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-U9-002/pU-u9/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u9/4ba0e00> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u9/4ba0e00> .

<urn:atm:triage:occurrence/RSH-U9-002/pU-u9/1>
  a triage:Occurrence ;
  triage:file "crates/atm-graft/src/lib.rs" ;
  triage:line 1084 ;
  triage:snippet "stream.set_recv_timeout(None).map_err(|source| { AtmError::daemon_unavailable(\"failed to clear graft advisory-stream read timeout after request publish\") ...})" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pU-u9-client-owned-graft-runtime" ;
  triage:headSha "4ba0e00" ;
  triage:occursIn <urn:atm:triage:worktree/pU-u9/4ba0e00> .

