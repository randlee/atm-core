<urn:atm:triage:finding/ATM-QA-U5-009>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-009" ;
  triage:title "Mixed-mailbox legacy: key causes silent full-downgrade in read_mail_with_runtime_impl" ;
  triage:description "crates/atm-core/src/read/mod.rs:248-263: If any single row has a legacy: key, read_mail_with_runtime_impl downgrades the entire operation to the file-backed path, discarding all SQLite-backed rows. Silent full-downgrade for partially-migrated mailboxes is undocumented and behaviorally incorrect. Decide and document: either reject mixed-key mailboxes at ingress or handle per-row." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U5-009/pU-u5/1> ;
