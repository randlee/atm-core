<urn:atm:triage:finding/FTQ-U9-004>
  a triage:Finding ;
  triage:findingId "FTQ-U9-004" ;
  triage:title "run_live_receive_loop fixed reconnect sleep with no readiness probe" ;
  triage:description "On advisory stream error the reconnect path in run_live_receive_loop (crates/atm-graft/src/lib.rs:887) calls thread::sleep(ctx.reconnect_backoff) with a fixed duration (defaulting to options.poll_interval, e.g. 10ms in tests) then immediately calls open_advisory_stream without probing daemon readiness. There is no readiness check before reconnect, no exponential back-off strategy keyed on error type, and no integration with the host supervisor ready gate." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U9-004/pU-u9/1> ;
