<urn:atm:triage:finding/RSH-U3-005>
  a triage:Finding ;
  triage:findingId "RSH-U3-005" ;
  triage:title "notify_team_lead_missing_config holds no shutdown token" ;
  triage:description "crates/atm-core/src/send/mod.rs:395: notify_team_lead_missing_config holds no shutdown token and fires a best-effort inbox append without checking whether the daemon is shutting down. This can race with process exit on fast shutdown. Required fix: pass a shutdown-awareness signal into the best-effort notification path and skip the append when shutting down." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
