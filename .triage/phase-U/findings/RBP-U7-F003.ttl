<urn:atm:triage:finding/RBP-U7-F003>
  a triage:Finding ;
  triage:findingId "RBP-U7-F003" ;
  triage:title "source: Option<String> non-empty invariant is comment-only; needs RosterIngestSource newtype" ;
  triage:description "crates/atm-core/src/boundary/store.rs — source: Option<String> has a comment stating the string must be non-empty when Some, but this invariant is not enforced by a newtype. A RosterIngestSource(String) newtype with a validated constructor would enforce this at the type level." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
