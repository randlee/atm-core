<urn:atm:triage:finding/ATM-QA-U7-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-U7-002" ;
  triage:title "docs/architecture.md Section 21.1/21.1.1 still lists pid as durable roster field; required U.7 doc update not applied" ;
  triage:description "docs/architecture.md:2127-2130 lists pid in \"Authoritative State\" as \"durable SQLite truth\". docs/architecture.md:2183-2187 lists pid INTEGER NULL in \"Minimum canonical roster-member durable fields\". U.7 removed pid from durable SQLite truth entirely — both entries must be removed and a note added that pid is transient cache-only state." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
