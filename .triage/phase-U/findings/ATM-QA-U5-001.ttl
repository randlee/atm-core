<urn:atm:triage:finding/ATM-QA-U5-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-001" ;
  triage:title "legacy: prefix branch retained in read_mail_with_runtime_impl — live JSON source read path" ;
  triage:description "crates/atm-core/src/read/mod.rs:248-263: legacy: prefix branch retained in read_mail_with_runtime_impl. Any metadata row with a legacy: key triggers read_mail_legacy_path which calls runtime.observe_source_files(...) / runtime.load_workflow_state(...) / runtime.commit_source_files(...). This is a live production-read path to JSON source files. Sprint sub-task 3 requires these reads be removed from normal runtime or moved exclusively behind BOUNDARY-InboxIngress." ;
