<urn:atm:triage:finding/FTQ-U9-005>
  a triage:Finding ;
  triage:findingId "FTQ-U9-005" ;
  triage:title "test helper creates advisory stream listener with hard-coded socket name" ;
  triage:description "The live_receive_loop_injects_streamed_nudge_and_exits_on_eof test (crates/atm-graft/src/lib.rs:1639) hard-codes the advisory stream socket as endpoint_path = tempdir.path().join(\"graft-live.sock\"). While the tempdir prefix is random, the fixed suffix 'graft-live.sock' can conflict if the test is run concurrently (e.g. on multi-thread test harnesses sharing a temp namespace). The file_filter pattern specifies port offset but the actual pattern is a hard-coded socket name, which is the analogous Unix-socket risk." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U9-005/pU-u9/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u9/4ba0e00> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u9/4ba0e00> .

