# ─── Finding ────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/ARCH-U5-003>
  a triage:Finding ;
  triage:findingId "ARCH-U5-003" ;
  triage:title "LocalServiceRuntime::default() installs LegacyMailStoreAdapter — SQLite path unreachable" ;
  triage:description "crates/atm-core/src/service_runtime_store.rs: default_mail_store() returns Arc::new(LegacyMailStoreAdapter) and LocalServiceRuntime::default() calls default_mail_store(). RetainedMailboxRuntime::query_mailbox_metadata_rows silently falls back to legacy_query_mailbox_metadata_rows (full JSON file scan) whenever MailStore::query_mailbox_metadata returns unsupported error. Since LegacyMailStoreAdapter::query_mailbox_metadata unconditionally returns Err(unsupported(...)), the SQLite path is unreachable in default CLI execution. atm list and atm read always use the file-backed path in production. Fix: wire the real atm-rusqlite SQLite adapter into LocalServiceRuntime::default()." ;
  triage:category "ARCH" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;

  triage:hasOccurrence <urn:atm:triage:occurrence/ARCH-U5-003/pU-u1/1> ;
