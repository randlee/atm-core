<urn:atm:triage:finding/RSH-U7-006>
  a triage:Finding ;
  triage:findingId "RSH-U7-006" ;
  triage:title "non-UTF-8 team directory names abort entire roster reload instead of skipping with tracing::warn" ;
  triage:description "crates/atm-daemon/src/runtime_status_cache.rs — when iterating team directories, to_string_lossy().into_owned() silently replaces non-UTF-8 bytes, but the subsequent team_name.parse().map_err(...)?  propagates the error and aborts the entire roster reload. The entry should instead be skipped via continue with a tracing::warn! log." ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T12:09:39Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-U7-006/pU-u4/1> ;
