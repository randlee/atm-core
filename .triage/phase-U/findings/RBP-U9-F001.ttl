<urn:atm:triage:finding/RBP-U9-F001>
  a triage:Finding ;
  triage:findingId "RBP-U9-F001" ;
  triage:title "stream_nudges() matches raw error message text instead of AtmErrorCode" ;
  triage:description "GraftRuntime::stream_nudges (crates/atm-daemon/src/graft_runtime.rs:206) exits the drain loop when it detects session unregistration by matching error.message.contains(\"is not registered\") and comparing error.recovery as a string literal. This bypasses the typed AtmErrorCode classification system. is_duplicate_registration() in atm-graft/src/lib.rs:964 correctly uses error.code == AtmErrorCode::DaemonGraftSessionAlreadyRegistered, showing the correct pattern exists. The stream_nudges exit condition must use the analogous error code check." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-U9-F001/pU-u9/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u9/4ba0e00> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u9/4ba0e00> .

<urn:atm:triage:occurrence/RBP-U9-F001/pU-u9/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/graft_runtime.rs" ;
  triage:line 206 ;
  triage:snippet "Err(error) if error.message.contains(\"is not registered\") && error.recovery.as_deref() == Some(\"Register the graft session before draining daemon-owned nudge state.\")" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pU-u9-client-owned-graft-runtime" ;
  triage:headSha "4ba0e00" ;
  triage:occursIn <urn:atm:triage:worktree/pU-u9/4ba0e00> .

