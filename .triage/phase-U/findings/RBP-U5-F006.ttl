# ─── Finding ───────────────────────────────────────────────────────────────────

<urn:atm:triage:finding/RBP-U5-F006>
  a triage:Finding ;
  triage:findingId "RBP-U5-F006" ;
  triage:title "summary Option<String> uses .clone().unwrap_or_default() at 3 confirmed sites — use .as_deref().unwrap_or_default()" ;
  triage:description "MailStoreMailboxMetadataRow::summary (Option<String>, declared at crates/atm-core/src/boundary/mail.rs:119) is consumed with .clone().unwrap_or_default() at 3 call sites in crates/atm-core/src/list.rs (lines 220, 378) and crates/atm-core/src/read/mod.rs (line 680). Replace with .as_deref().unwrap_or_default() to avoid unnecessary heap allocation." ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
