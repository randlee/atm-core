@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/RBP-U8-F003>
  a triage:Finding ;
  triage:findingId "RBP-U8-F003" ;
  triage:title "boundary/store.rs uses Option<String> for source field instead of Option<ReplaySource>" ;
  triage:description "crates/atm-core/src/boundary/store.rs:241,303 — RosterStoreReplaceRosterRequest.source and RosterStoreRequest.source are typed as Option<String> where Option<ReplaySource> (already defined in boundary/mail.rs) should be used for domain safety. ReplaySource enforces non-empty/non-whitespace invariant via TryFrom<String>; the raw Option<String> bypasses that guard and allows empty or whitespace-only source strings to be stored. Note: the finding initially cited atm-rusqlite/src/boundary/store.rs, but that file does not exist on U.8; the actual location is atm-core/src/boundary/store.rs." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "Option<String> fields in atm-rusqlite and atm-core domain types" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-U8-F003/pU-u8/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-U8-F003/pU-u8/2> ;
  triage:openOn <urn:atm:triage:worktree/pU-u8/633c34c> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u8/633c34c> .

