<urn:atm:triage:occurrence/ATM-QA-U2-005/pU-u2/1>
  a triage:Occurrence ;
  triage:file "crates/atm-core/src/ack/mod.rs" ;
  triage:line 583 ;
  triage:snippet "test module has 3 tests (lines 583-628) but none cover UUID wire form ack lookup path; AtmMessageId::FromStr accepts both ULID and UUID text (inbox_message.rs:92-96) but ack test coverage is absent for the UUID->ULID resolution path" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pU-u2-one-message-identity" ;
  triage:headSha "1fb49d022e02597accfab9d49de284b8627e9310" ;
