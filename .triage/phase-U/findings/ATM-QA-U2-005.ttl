<urn:atm:triage:finding/ATM-QA-U2-005>
  a triage:Finding ;
  triage:findingId "ATM-QA-U2-005" ;
  triage:title "No test validates ack using UUID wire form text locates message stored via ULID value" ;
  triage:description "crates/atm-core/src/ack/mod.rs — ADR-012 requires CLI/service addressing accept both ULID text and UUID wire text, resolving to same AtmMessageId. No targeted test validates that an ack using UUID wire form text locates a message whose stored id was set from ULID value." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
