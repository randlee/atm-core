<urn:atm:triage:finding/RSH-U7-005>
  a triage:Finding ;
  triage:findingId "RSH-U7-005" ;
  triage:title "agent_type/model have no length validation on decode from storage" ;
  triage:description "crates/atm-rusqlite/src/roster_store.rs:312-313 — agent_type and model are decoded from SQLite storage and assigned directly to boundary::RosterMemberRecord with no maximum length check. A corrupt or adversarially written database row could produce arbitrarily long strings. The fields were introduced in U.7 commit 8e37dd1 (roster simplification); U.4/U.5/U.6 do not contain these fields in roster_store.rs." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-U7-005/U7/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u7-roster-simplification/8e37dd1> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u7-roster-simplification/8e37dd1> .

