<urn:atm:triage:finding/RSH-U7-007>
  a triage:Finding ;
  triage:findingId "RSH-U7-007" ;
  triage:title "retain_shutdown_step retains watcher JoinHandle but logs \"worker retained\"; misleading in production logs" ;
  triage:description "crates/atm-daemon/src/runtime_health.rs line 140 — retain_shutdown_step stores the watcher JoinHandle (not the worker JoinHandle directly), but the log message says \"worker retained for later join\". The watcher thread holds the worker JoinHandle internally (per comment at lines 197-198), so the logged term \"worker\" is ambiguous: it sounds like the worker thread is intentionally still running, but actually both the watcher and the worker are being retained together via the watcher handle. This is misleading in production observability." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
