<urn:atm:triage:finding/ATM-QA-U3-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-U3-002" ;
  triage:title "docs/architecture.md missing U.3 mode-aware body projection rule" ;
  triage:description "docs/architecture.md is listed as a Required Doc Update for U.3 and appears in changed_files, but no U.3-specific content was added to section 5.2. Section 5.2 lists threadMode as a compatibility field but says nothing about how it governs body projection at query time. The mode-aware projection contract (terminal add-details composes predecessor context; terminal supersede exposes only replacement body) is in docs/atm-core/architecture.md (ADR-ATM-CORE-002) but not in the separately-required top-level product architecture doc. Required fix: Add a U.3 note in/after section 5.2 stating the mode-aware body projection rule and referencing docs/atm-core/architecture.md as crate-local detail owner." ;
  triage:triageMode "initial_pass" ;
  triage:category "doc" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
