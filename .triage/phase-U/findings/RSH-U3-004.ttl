<urn:atm:triage:finding/RSH-U3-004>
  a triage:Finding ;
  triage:findingId "RSH-U3-004" ;
  triage:title "runtime.read_messages called inside with_locked_source_files in ack/mod.rs with no I/O timeout" ;
  triage:description "crates/atm-core/src/ack/mod.rs:516: Same unbounded-I/O-inside-lock pattern as RSH-U3-003. runtime.read_messages(reply_inbox_path) is called inside the with_locked_source_files body when the reply inbox is not already loaded. A stalled filesystem can block indefinitely inside the critical section. Required fix: document the accepted risk explicitly, or add a per-operation I/O deadline." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/ack/" ;
