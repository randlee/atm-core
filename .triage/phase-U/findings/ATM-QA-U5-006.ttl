# Finding: ATM-QA-U5-006
# classify_mailbox_metadata_rows hard-codes stale_at: None — ephemeral filtering broken in SQLite metadata path
# Triaged: 2026-05-12T00:00:00Z
# Mode: initial_pass

<urn:atm:triage:finding/ATM-QA-U5-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-006" ;
  triage:title "classify_mailbox_metadata_rows hard-codes stale_at: None — ephemeral filtering broken in SQLite metadata path" ;
  triage:description "crates/atm-core/src/list.rs and read/mod.rs: classify_mailbox_metadata_rows hard-codes stale_at: None when projecting MessageEnvelope from metadata rows. MailStoreMailboxMetadataRow has no expires_at field. In-process ephemeral visibility logic (is_ephemeral, is_expired_ephemeral) always sees None — ephemeral message filtering is broken in the SQLite metadata path. Fix: add expires_at: Option<DateTime<Utc>> to MailStoreMailboxMetadataRow, populate from mail_message_states.expires_at in the SQL query, propagate into stale_at in classify_mailbox_metadata_rows." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;

