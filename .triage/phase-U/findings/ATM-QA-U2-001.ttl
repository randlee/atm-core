<urn:atm:triage:finding/ATM-QA-U2-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-U2-001" ;
  triage:title "Test function uses prohibited legacy_* naming without justified compatibility role" ;
  triage:description "crates/atm-rusqlite/src/lib.rs:1355 — Local variable `duplicate_legacy_identity` inside test `mail_store_enforces_message_key_prefix_and_single_successor` uses the prohibited `legacy_*` naming with no justified compatibility role. Sprint U.2 AC-4 and ADR-012 both require `legacy_*` naming removed or narrowed to one justified role. This test verifies message identity uniqueness enforcement — not a legacy compatibility concern. Fix: rename to `duplicate_message_identity` or `message_id_uniqueness_rejection`." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
