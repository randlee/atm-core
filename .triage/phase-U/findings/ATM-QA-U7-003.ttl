<urn:atm:triage:finding/ATM-QA-U7-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-U7-003" ;
  triage:title "No round-trip tests for CodexCli/GeminiCli/Opencode harness values or Ephemeral member_kind through SqliteRosterStore" ;
  triage:description "crates/atm-rusqlite/src/lib.rs:1824 (roster_store_round_trips_roster_membership_and_health) only uses from_claude_code_member() in the round-trip test. CodexCli, GeminiCli, Opencode harness variants and Ephemeral member_kind have serialization/deserialization code in roster_store.rs (lines 260-292) but no round-trip coverage through SqliteRosterStore. This is an explicit sprint U.7 deliverable: round-trip tests for member_kind/harness/agent_type/model/metadata_json." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
