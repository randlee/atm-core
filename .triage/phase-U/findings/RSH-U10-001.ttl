  triage:snippet "pub(crate) fn stream_nudges(&self, request: AdvisoryStreamRequest, sink: &mut dyn boundary::AdvisoryStreamSink) -> Result<(), AtmError> { ... loop { match self.drain_nudges(drain_request.clone()) { ... thread::sleep(STREAM_IDLE_WAIT); ... } } }" ;
  triage:status "open" ;
