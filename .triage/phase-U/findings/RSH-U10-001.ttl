<urn:atm:triage:finding/RSH-U10-001>
  a triage:Finding ;
  triage:findingId "RSH-U10-001" ;
  triage:title "stream_nudges loop has no cooperative shutdown path" ;
  triage:description "crates/atm-daemon/src/advisory_runtime.rs stream_nudges loop has no stop channel or force_shutdown flag. Daemon cannot cleanly stop an active advisory stream. Must add graceful shutdown signal." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
