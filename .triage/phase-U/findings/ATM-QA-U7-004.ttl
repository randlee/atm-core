<urn:atm:triage:finding/ATM-QA-U7-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-U7-004" ;
  triage:title "No ephemeral member lifecycle behavioral test through SqliteRosterStore" ;
  triage:description "RosterMemberKind::Ephemeral has no test verifying it round-trips correctly and that its lifecycle behavior is distinguishable from Persistent member kinds. roster_store.rs on U.7 has no test module at all. The roster_member_kind_value and build_roster_member functions encode and decode Ephemeral at lines 260 and 280, but no test exercises this path. This is a U.7 sprint deliverable requirement: tests must cover all member_kind variants." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
