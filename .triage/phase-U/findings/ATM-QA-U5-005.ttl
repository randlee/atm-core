<urn:atm:triage:finding/ATM-QA-U5-005>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-005" ;
  triage:title "output_messages_from_metadata_selection calls legacy_load_message_record for content-fetch" ;
  triage:description "crates/atm-core/src/read/mod.rs: output_messages_from_metadata_selection calls runtime.load_message_record(...) per selected key for full-body render. This falls back to legacy_load_message_record (JSON source read) in the default runtime. Even if ARCH-U5-003 is fixed so that metadata selection uses SQLite, the content-fetch render step re-reads JSON files. Both selection and content-fetch must be backed by the real SQLite adapter." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U5-005/pU-u5/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U5-005/pU-u5/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U5-005/pU-u5/3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U5-005/pU-u5/4> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U5-005/pU-u5/5> ;
  triage:openOn <urn:atm:triage:worktree/pU-u5/ae75f1a> ;
