<urn:atm:triage:finding/RBP-F001-U2>
  a triage:Finding ;
  triage:findingId "RBP-F001-U2" ;
  triage:title "WorkflowStateFile::messages keyed on raw String instead of typed newtype" ;
  triage:description "crates/atm-core/src/workflow.rs — WorkflowStateFile::messages is BTreeMap<String, WorkflowMessageState> keyed on format!(\"legacy:{message_id}\"). AtmMessageId newtype exists and this sprint unifies identity, but the sidecar key downgrades to raw String. Fix: introduce WorkflowMessageKey(AtmMessageId) newtype with single constructor owning the prefix encoding; move format!() logic there." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
