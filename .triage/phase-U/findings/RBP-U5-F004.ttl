<urn:atm:triage:finding/RBP-U5-F004>
  a triage:Finding ;
  triage:findingId "RBP-U5-F004" ;
  triage:title "Unnecessary .clone() in selection_state_for_mailbox_metadata_rows" ;
  triage:description "crates/atm-core/src/read/mod.rs:647: classified_all.clone() passed to logical_current_messages (which consumes Vec<ClassifiedMessage> by value) while classified_all is also used in the if-let branch via into_iter(). Fix: restructure to avoid the clone — e.g. call bucket_counts_for before consuming classified_all, or accept &[ClassifiedMessage] in logical_current_messages." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
