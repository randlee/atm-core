<urn:atm:triage:finding/RBP-U9-F003>
  a triage:Finding ;
  triage:findingId "RBP-U9-F003" ;
  triage:title "NudgeEvent Debug impl prints message content — potential log-injection risk" ;
  triage:description "NudgeEvent (crates/atm-core/src/graft.rs:267) has #[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]. The derived Debug impl will print the full message field (pub message: String), which can contain up to MAX_GRAFT_NUDGE_MESSAGE_BYTES (4096) bytes of arbitrary UTF-8 from an external agent. When NudgeEvent is logged via {:?} the message content is included verbatim, creating a log-injection vector. Note: the QA finding references GraftNudgePayload, but sweep confirms this type does not exist — the actual type is NudgeEvent." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-U9-F003/pU-u9/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u9/4ba0e00> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u9/4ba0e00> .

