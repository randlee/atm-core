@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/RBP-F002>
  a triage:Finding ;
  triage:findingId "RBP-F002" ;
  triage:title "SummaryMailboxRecord uses Option<String> instead of Option<LegacyMessageId> for id fields" ;
  triage:description "crates/atm-core/src/mailbox/mod.rs — SummaryMailboxRecord and SummaryAtmMetadata store message_id, acknowledges_message_id, parent_message_id as Option<String>, requiring parse_legacy_id re-parse at every use. LegacyMessageId newtype exists and is used elsewhere (RBP-004). Fix: change fields to Option<LegacyMessageId> with serde deserializer using sanitize_legacy_message_id logic." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-11T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-F002/integrate-phase-U/1> ;
