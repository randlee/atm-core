<urn:atm:triage:finding/RSH-U6-008>
  a triage:Finding ;
  triage:findingId "RSH-U6-008" ;
  triage:title "writer/mod.rs:162 full-channel shutdown detaches writer thread; warn! at line 188 lacks queue depth field" ;
  triage:description "crates/atm-rusqlite/src/writer/mod.rs — when the writer channel is full at shutdown, the writer thread is detached without joining. warn! logs timeout_ms but does not include queue depth or pending-item count, making it hard to diagnose whether shutdown stall is caused by a full queue or a slow consumer. RSH-U6-005 was resolved (warn! now has structured timeout_ms). RSH-U6-008 is the missing queue depth field." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
