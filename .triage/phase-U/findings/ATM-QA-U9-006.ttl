<urn:atm:triage:finding/ATM-QA-U9-006>
  a triage:Finding ;
  triage:findingId "ATM-QA-U9-006" ;
  triage:title "GraftSessionState ownership scope ambiguous in removal-inventory.md — does it belong to U.9 or U.10 removal scope?" ;
  triage:description "removal-inventory.md line 183 assigns GraftSessionState cutover to U.9 in the ownership matrix, and line 210 lists it as a U.9 primary target. Sprint-U9.md acceptance criteria also states U.9 owns GraftSessionState client-runtime replacement. The ownership is consistently U.9 per spec, but the inventory does not explicitly state whether the type is to be removed from atm-core in U.9 or only moved/renamed. The ambiguity is whether 'client-runtime replacement' means GraftSessionState is deleted from the shared protocol contract (U.9) or merely demoted from daemon advisory use (U.10 scope)." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
