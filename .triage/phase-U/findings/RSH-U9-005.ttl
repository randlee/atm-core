<urn:atm:triage:finding/RSH-U9-005>
  a triage:Finding ;
  triage:findingId "RSH-U9-005" ;
  triage:title "advisory stream connection has no max-retry count" ;
  triage:description "The reconnect loop in run_live_receive_loop (crates/atm-graft/src/lib.rs:887-910) has no maximum retry count or circuit-breaker. It loops indefinitely on advisory stream errors, re-registering and re-connecting without bound. A permanently unavailable daemon will keep the host agent thread alive and spinning rather than surfacing a terminal error to the caller." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-U9-005/pU-u9/1> ;
