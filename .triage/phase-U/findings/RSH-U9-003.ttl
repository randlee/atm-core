<urn:atm:triage:finding/RSH-U9-003>
  a triage:Finding ;
  triage:findingId "RSH-U9-003" ;
  triage:title "stream_nudges() missing force_shutdown flag check" ;
  triage:description "GraftRuntime::stream_nudges() in crates/atm-daemon/src/graft_runtime.rs:180-220 loops indefinitely on drain_nudges() with a thread::sleep(STREAM_IDLE_WAIT) on empty batches. The daemon's force_shutdown AtomicBool (managed in local_ipc_transport.rs) is not checked inside the stream_nudges loop, so a forced daemon shutdown cannot interrupt an active advisory stream handler." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-U9-003/pU-u9/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u9/4ba0e00> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u9/4ba0e00> .

<urn:atm:triage:occurrence/RSH-U9-003/pU-u9/1>
  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/graft_runtime.rs" ;
  triage:line 180 ;
  triage:snippet "pub(crate) fn stream_nudges(...) -> Result<(), AtmError> { ... loop { match self.drain_nudges(...) { Ok(batch) if batch.nudges.is_empty() => { thread::sleep(STREAM_IDLE_WAIT); continue; } ... } } }" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pU-u9-client-owned-graft-runtime" ;
  triage:headSha "4ba0e00" ;
  triage:occursIn <urn:atm:triage:worktree/pU-u9/4ba0e00> .

