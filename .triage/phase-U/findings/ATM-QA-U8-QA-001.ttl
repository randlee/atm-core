  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U8-QA-001/pU-u8/extra-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U8-QA-001/pU-u8/extra-2> ;
