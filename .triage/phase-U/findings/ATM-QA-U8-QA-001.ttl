<urn:atm:triage:finding/ATM-QA-U8-QA-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-U8-QA-001" ;
  triage:title "atm-graft/src/lib.rs uses hardcoded /tmp/ paths" ;
  triage:description "crates/atm-graft/src/lib.rs:257,258,309,310,363,364,380,381 — hardcoded \"/tmp/\" string literals used in test PathBuf constructions for home_dir and current_dir arguments. Must use std::env::temp_dir() for cross-platform compatibility (Windows has no /tmp/). All 8 occurrences are in the #[cfg(test)] module (send_uses_shared_send_envelope, read_uses_shared_receive_envelope, ack_uses_shared_ack_envelope, protocol_round_trip_uses_shared_request_family). Sweep also found additional /tmp/ hardcoding in crates/sc-lint-boundary/src/tests.rs (lines 387, 458, 680) and one JSON value literal in crates/atm-rusqlite/src/lib.rs:2231 — those are recorded as additional occurrences but the primary fix target is atm-graft." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "all /tmp/ string literals in workspace Rust source" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U8-QA-001/pU-u8/1> ;
