<urn:atm:triage:finding/RBP-U7-F001>
  a triage:Finding ;
  triage:findingId "RBP-U7-F001" ;
  triage:title "member_kind decode error missing .with_recovery()" ;
  triage:description "crates/atm-rusqlite/src/roster_store.rs:282 — the member_kind field decode uses bare return Err(AtmError::validation(...)) without .with_recovery() chained. The member_kind match/decode arm is new in U.7 (absent from U.4/U.5/U.6 roster_store.rs which used JSON-blob schema). Pattern is repeatable: harness decode at line 294 has the same gap (tracked as RBP-U7-F002)." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-U7-F001/U7/1> ;
