<urn:atm:triage:finding/ATM-QA-U4-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-U4-004" ;
  triage:title "mail_store_round_trips_message_visibility_and_health test never exercises expiry round-trip" ;
  triage:description "mail_store_round_trips_message_visibility_and_health constructs MailStoreVisibilityState.expires_at from record.envelope.stale_at (None), so expiry round-trip is never exercised. Fix: set expires_at explicitly to a non-None timestamp and assert round-trip correctness. Independent of ATM-QA-U4-001 root fix." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
