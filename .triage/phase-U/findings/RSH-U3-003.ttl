<urn:atm:triage:finding/RSH-U3-003>
  a triage:Finding ;
  triage:findingId "RSH-U3-003" ;
  triage:title "runtime.read_messages called inside commit_workflow_state lock body with no I/O timeout" ;
  triage:description "crates/atm-core/src/send/mod.rs:485 and crates/atm-core/src/ack/mod.rs:516: runtime.read_messages(inbox_path) and runtime.read_messages(reply_inbox_path) are called inside the commit_workflow_state / with_locked_source_files lock bodies with no I/O timeout. Lock-acquisition is time-bounded; the subsequent blocking read is not. A stalled or network-backed filesystem can block indefinitely inside the critical section. Required fix: document the accepted risk explicitly, or add a per-operation I/O deadline." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/send/ crates/atm-core/src/ack/" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
