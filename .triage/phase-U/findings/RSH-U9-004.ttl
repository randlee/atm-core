<urn:atm:triage:finding/RSH-U9-004>
  a triage:Finding ;
  triage:findingId "RSH-U9-004" ;
  triage:title "reconnect loop in run_live_receive_loop lacks exponential backoff" ;
  triage:description "run_live_receive_loop (crates/atm-graft/src/lib.rs:887) calls thread::sleep(ctx.reconnect_backoff) with a fixed Duration. ctx.reconnect_backoff is initialized from options.poll_interval (line 482) and never mutated. On repeated advisory stream failures the loop hammers reconnect at a constant rate with no exponential backoff or jitter, which can overload a recovering daemon." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RSH-U9-004/pU-u9/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u9/4ba0e00> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u9/4ba0e00> .

