<urn:atm:triage:finding/ATM-QA-U7-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-U7-001" ;
  triage:title "docs/requirements.md REQ-CORE-RUNTIME-002 retains pre-U.7 pid-as-durable-SQLite-roster-truth language" ;
  triage:description "docs/requirements.md:2797-2798 states 'SQLite stores the current durable pid for each member as roster truth'; docs/requirements.md:2806-2808 states 'pid is the durable roster-owned process identity'. Both contradict U.7 implementation where pid is transient daemon-owned cache-only state, not stored in SQLite team_roster. Required U.7 doc update was not applied." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
