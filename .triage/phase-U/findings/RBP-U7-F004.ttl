<urn:atm:triage:finding/RBP-U7-F004>
  a triage:Finding ;
  triage:findingId "RBP-U7-F004" ;
  triage:title "agent_name parse error missing .with_recovery()" ;
  triage:description "crates/atm-rusqlite/src/roster_store.rs:304 — the agent_name field parse uses .map_err(|error| AtmError::validation(...).with_source(error))? which provides error context but is missing .with_recovery() to supply operator guidance. The agent_name.parse() callsite is new in U.7 (U.4/U.5/U.6 roster_store.rs use a flat String column and do not parse agent_name)." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-U7-F004/U7/1> ;
  triage:openOn <urn:atm:triage:worktree/pU-u7-roster-simplification/8e37dd1> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u7-roster-simplification/8e37dd1> .

<urn:atm:triage:occurrence/RBP-U7-F004/U7/1>
  a triage:Occurrence ;
  triage:file "crates/atm-rusqlite/src/roster_store.rs" ;
  triage:line 304 ;
  triage:snippet "agent_name: agent_name.parse().map_err(|error| { AtmError::validation(format!(\"failed to decode roster agent_name {agent_name} for {team}: {error}\")).with_source(error) })?," ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pU-u7-roster-simplification" ;
  triage:headSha "8e37dd1" ;
  triage:occursIn <urn:atm:triage:worktree/pU-u7-roster-simplification/8e37dd1> .

