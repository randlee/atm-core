<urn:atm:triage:finding/RSH-U3-002>
  a triage:Finding ;
  triage:findingId "RSH-U3-002" ;
  triage:title "validate_message_text not applied to File source variant after file_policy::process_file_reference" ;
  triage:description "crates/atm-core/src/send/mod.rs resolve_message_body (line 381): validate_message_text is enforced on Inline and Stdin variants but not on File source after file_policy::process_file_reference. The composite message body (render_reference_message output or in-repo path string) is returned directly without passing through validate_message_text, so the 256 KiB size invariant is bypassed for File source. Required fix: call validate_message_text (or equivalent size check) on the return value of process_file_reference before returning from resolve_message_body." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
