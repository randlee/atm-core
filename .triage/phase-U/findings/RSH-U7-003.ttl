<urn:atm:triage:finding/RSH-U7-003>
  a triage:Finding ;
  triage:findingId "RSH-U7-003" ;
  triage:title "replace_roster no input bound on members Vec length before N-INSERT transaction" ;
  triage:description "crates/atm-rusqlite/src/roster_store.rs:39 — replace_roster takes a Vec of members and runs N INSERT statements inside a transaction with no cap on the input Vec length. An arbitrarily large roster could exhaust memory or database write capacity." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
