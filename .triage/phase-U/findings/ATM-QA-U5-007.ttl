<urn:atm:triage:finding/ATM-QA-U5-007>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-007" ;
  triage:title "docs/atm/atm-list.mmd diagram does not match implementation" ;
  triage:description "docs/atm/atm-list.mmd describes a two-query design (SQL 1: scan message_status then SQL 2: project headers only) and references a message_status table. Actual implementation in query_mailbox_metadata_rows is one LEFT JOIN query on mail_messages/mail_message_states. Diagram must match implementation." ;
