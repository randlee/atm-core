<urn:atm:triage:finding/FTQ-U10-005>
  a triage:Finding ;
  triage:findingId "FTQ-U10-005" ;
  triage:title "session_retries test timing race — fixed sleep on retry sequence assertion" ;
  triage:description "session_retries_after_one_drain_failure in crates/atm-graft/src/lib.rs exercises a retry path containing thread::sleep(ctx.reconnect_backoff). reconnect_backoff is set to 10ms via with_poll_interval(Duration::from_millis(10)) in the test. Under load the fixed sleep causes the recv_timeout chain on the retry sequence assertion to be non-deterministic. File crates/atm-daemon/src/tests_advisory.rs cited in the original finding does not contain this test; the actual location is crates/atm-graft/src/lib.rs." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U10-005/u9/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U10-005/u9/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U10-005/u10/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U10-005/u10/2> ;
