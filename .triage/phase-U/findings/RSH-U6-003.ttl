<urn:atm:triage:finding/RSH-U6-003>
  a triage:Finding ;
  triage:findingId "RSH-U6-003" ;
  triage:title "record_ack_transition has no cap on ACK transitions per (team, task_id); unbounded table growth" ;
  triage:description "crates/atm-rusqlite/src/lib.rs — record_ack_transition inserts into task_ack_transitions without any row-count cap per (team, task_id). No DELETE or row-count guard exists anywhere in the crate. Unbounded table growth under repeated ack/re-ack cycles." ;
