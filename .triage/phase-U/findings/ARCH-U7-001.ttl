<urn:atm:triage:finding/ARCH-U7-001>
  a triage:Finding ;
  triage:findingId "ARCH-U7-001" ;
  triage:title "load_roster returns AtmError on empty roster instead of Ok(empty Vec); valid storage state treated as failure" ;
  triage:description "crates/atm-rusqlite/src/roster_store.rs:136 — load_roster returns an error when the team_roster table is empty, but an empty roster is a valid state (a new team has zero persisted members). This causes daemon startup to incorrectly mark SQLite as unavailable for new teams." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
