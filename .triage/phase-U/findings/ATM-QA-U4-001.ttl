# ============================================================
# Finding: ATM-QA-U4-001
# MessageEnvelope.stale_at field not removed
# Triage mode: initial_pass
# Phase: phase-U
# ============================================================

<urn:atm:triage:finding/ATM-QA-U4-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-U4-001" ;
  triage:title "MessageEnvelope.stale_at field not removed — root cause of 7 downstream findings" ;
  triage:description "MessageEnvelope still contains stale_at field with serde alias 'staleAt' at crates/atm-core/src/schema/inbox_message.rs:272. Sprint U.4 required removing this field entirely and routing all expiry through MailStoreVisibilityState.expires_at. This is the root cause that also causes ATM-QA-U4-002, ATM-QA-U4-003, ARCH-U4-002, ARCH-U4-003, ATM-QA-U4-007, and ATM-QA-U4-011 findings." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
