<urn:atm:triage:finding/ARCH-001-U2>
  a triage:Finding ;
  triage:findingId "ARCH-001-U2" ;
  triage:title "workflow_key() produces legacy:{message_id} sidecar prefix not documented in ADR-012" ;
  triage:description "crates/atm-core/src/workflow.rs — workflow_key() produces 'legacy:{message_id}' keys for the workflow sidecar map. The 'legacy:' prefix is a surviving legacy_* symbol. Sprint U.2 AC requires any surviving legacy_* symbol documented in ADR-012 as the one justified role. ADR-012 does not mention this sidecar key namespace. Fix options: (a) rename prefix to 'atm:' or 'msg:' + update test literals, OR (b) add ADR-012 paragraph explicitly naming the 'legacy:' workflow sidecar key as the one justified compatibility role with rationale." ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;

