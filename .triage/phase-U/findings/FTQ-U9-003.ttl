<urn:atm:triage:finding/FTQ-U9-003>
  a triage:Finding ;
  triage:findingId "FTQ-U9-003" ;
  triage:title "connect_daemon_local_ipc_until_ready 2s deadline too tight for loaded CI" ;
  triage:description "connect_daemon_local_ipc_until_ready in crates/atm-daemon/src/test_support.rs:94 uses a 2-second absolute deadline for the IPC connection retry loop. Tests in atm-daemon/src/tests.rs and local_ipc_transport.rs use this helper extensively. On loaded CI runners, 2 seconds is insufficient to guarantee the daemon socket is ready, causing spurious test failures." ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U9-003/pU-u9/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-U9-003/pU-u9/2> ;
  triage:openOn <urn:atm:triage:worktree/pU-u9/4ba0e00> ;
  triage:promoteTo <urn:atm:triage:worktree/pU-u9/4ba0e00> .

