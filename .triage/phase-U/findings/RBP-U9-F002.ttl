<urn:atm:triage:finding/RBP-U9-F002>
  a triage:Finding ;
  triage:findingId "RBP-U9-F002" ;
  triage:title "NudgeEvent.message is raw String with no newtype byte-bound enforcement" ;
  triage:description "NudgeEvent.message (crates/atm-core/src/graft.rs:275) is typed as pub message: String with only a documentation comment bounding it to MAX_GRAFT_NUDGE_MESSAGE_BYTES (4096 bytes). There is no newtype wrapper enforcing the byte bound at construction. The comment states 'Implementations producing NudgeEvent values must bound this field to at most MAX_GRAFT_NUDGE_MESSAGE_BYTES UTF-8 bytes before crossing the public ATM graft boundary' — but this is purely advisory. A newtype (e.g. GraftNudgeMessage) with a validated constructor would enforce the invariant structurally." ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:phaseId "phase-U" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBP-U9-F002/pU-u9/1> ;
