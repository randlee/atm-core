<urn:atm:triage:finding/ATM-QA-U9-009>
  a triage:Finding ;
  triage:findingId "ATM-QA-U9-009" ;
  triage:title "docs/atm-daemon/protocol-icd.md not updated for advisory stream message kind" ;
  triage:description "docs/atm-daemon/protocol-icd.md line 71 only mentions advisory-notification traffic in passing ('if long-lived registration or advisory-notification traffic is added'). The U.9 implementation adds GraftAdvisoryStream as a live streaming message kind, but the ICD does not document the new advisory stream message kind, its frame format, or its semantics. The removal-inventory.md U.10 section lists protocol-icd.md:247-264 as a target but U.9 also introduced advisory stream traffic that needs ICD coverage." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
