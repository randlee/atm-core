<urn:atm:triage:finding/ATM-QA-U5-008>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-008" ;
  triage:title "docs/atm/atm-read.mmd diagram references non-existent types and tables" ;
  triage:description "docs/atm/atm-read.mmd: Diagram references non-existent error types HiddenDeletedMessage and MessageNotFound, a non-existent table message_status, and SQL 3: mutate message_status only. Actual implementation: single metadata query with optional id filter, no typed MessageNotFound/HiddenDeletedMessage exits, mutation via persist_visibility_state -> MailStore::upsert_visibility_state." ;
