  a triage:Finding ;
  triage:findingId "ATM-QA-U2-002" ;
  triage:title "requirements.md schema ownership table references legacy files as active enforcement surfaces" ;
  triage:description "docs/requirements.md:46-54 — Schema ownership table still references legacy-atm-message-schema.md and tools/schema_models/legacy_atm_message_schema.py as active enforcement surfaces. ADR-012 declares legacy_* naming removed from the active path; atm-message-schema.md confirms no active metadata.atm namespace. Fix: update §schema-ownership table to mark these as historical/read-compatibility records only; add note that active enforcement model is atm_message_schema.py." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
