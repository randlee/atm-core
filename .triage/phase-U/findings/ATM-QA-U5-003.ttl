<urn:atm:triage:finding/ATM-QA-U5-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-003" ;
  triage:title "All existing read/list tests exercise only the legacy file-backed path — no SQLite-path integration tests" ;
  triage:description "crates/atm-core/src/read/mod.rs:1307-1915 and list.rs:388-471: All existing tests exercise only the legacy file-backed path. Tests in read/mod.rs exclusively use selection_state_for_source_files / SourceFile fixtures. Tests in list.rs build ClassifiedMessage directly, never via classify_mailbox_metadata_rows. No test wires read_mail_with_runtime_impl or list_mail_with_runtime_impl through a LocalServiceRuntime backed by a SqliteBoundaryAssembly. No SQLite-path integration test exists for ephemeral, deleted, or thread cases. Sprint deliverable 'targeted tests proving normal runtime behavior does not depend on source files' is absent." ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
