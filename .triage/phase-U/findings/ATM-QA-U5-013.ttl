<urn:atm:triage:finding/ATM-QA-U5-013>
  a triage:Finding ;
  triage:findingId "ATM-QA-U5-013" ;
  triage:title "load_logical_current_record loops over load_message_record per chain member — downstream of ATM-QA-U5-005" ;
  triage:description "crates/atm-core/src/read/mod.rs:1056-1106: load_logical_current_record builds chain_ids from row_by_id (metadata only) but then calls runtime.load_message_record(...) for every chain member in the loop at line 1084. This is a downstream file-read loop that must be verified after ATM-QA-U5-005 is fixed — once load_message_record is backed by SQLite, this loop also reads SQLite per chain member instead of JSON files. The loop itself is structural and remains after ATM-QA-U5-005 is resolved; verification is required." ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:dependsOn <urn:atm:triage:finding/ATM-QA-U5-005> ;
