<urn:atm:triage:finding/FTQ-U10-002>
  a triage:Finding ;
  triage:findingId "FTQ-U10-002" ;
  triage:title "SHARED_LIFECYCLE and INSTALL_LOCK are process-wide statics in lifecycle_control.rs" ;
  triage:description "crates/atm-daemon/src/lifecycle_control.rs:12,15 — SHARED_LIFECYCLE and INSTALL_LOCK are process-wide statics. Tests that register/deregister advisory sessions share this state, creating cross-test contamination. Requires isolation or reset path under #[cfg(test)]." ;
