<urn:atm:triage:finding/ATM-QA-U2-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-U2-003" ;
  triage:title "No test asserts lossless ULID-UUID wire cast round-trip for AtmMessageId" ;
  triage:description "crates/atm-core/src/schema/inbox_message.rs — ADR-012 states ATM may cast UUID wire values into AtmMessageId on ingest and cast AtmMessageId back into UUID wire form on export. No test asserts the byte-identity of this round-trip (from_uuid_wire(id.into_uuid_wire()) == id). Existing parse tests cover parsing; none cover lossless ULID-UUID cast. Fix: add atm_message_id_uuid_wire_round_trip_preserves_identity test asserting lossless cast for a known value." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-U" ;
  triage:triageMode "initial_pass" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-12T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-U2-003/pU-u2/1> ;
