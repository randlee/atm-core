<urn:atm:triage:finding/AO22-RSH-002>
  a triage:Finding ;
  triage:findingId "AO22-RSH-002" ;
  triage:title "private-key PEM bytes not zeroized after use" ;
  triage:description "Private-key PEM bytes (atm-storage/src/tls.rs:46, TlsIdentity::load) are read into a plain Vec<u8> and dropped without zeroization; combined with the TLS-config-caching finding (AO22-RSH-001), this multiplies transient unscrubbed copies of key material in process memory. Remediation: wrap the PEM buffer (or key slice) in a zeroizing container (e.g. zeroize::Zeroizing<Vec<u8>>)." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "security-hardening" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-storage/src/tls.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-20T16:50:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.2 ;
