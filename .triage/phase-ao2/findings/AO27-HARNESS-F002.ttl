<urn:atm:triage:finding/AO27-HARNESS-F002>
  a triage:Finding ;
  triage:findingId "AO27-HARNESS-F002" ;
  triage:title "No test asserts suite runner fails when target fails" ;
  triage:description "Current test suite for the benchmark harness mocks every target as successful. There is no test case that verifies the suite runner fails closed when one of the four required targets (sqlite, uds, tcp, tcp-tls) fails. This is a critical safety gap for acceptance—the harness must reject incomplete or partial results, not silently pass." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "HARNESS" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-22T21:10:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.7 ;
  triage:foundAt "2026-08-22T21:09:45Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO27-HARNESS-F002/ao2-7-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO27-HARNESS-F002/QMGR-CLOSE-1> ;
  triage:closedAt "2026-08-25T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "test_ordinary_benchmark_fails_when_one_required_target_fails (scripts/smoke/test_run_admission_capacity.py) mocks tcp as FAIL and the other three targets as PASS, asserts RUNNER.main() returns 1, and asserts 'FAIL required f8 target tcp' appears in stdout -- directly covers the suite-fails-closed-on-partial-target-failure gap. Fixed in commit 652711fe3." ;
  triage:triageRecordVersion "2" .

