<urn:atm:triage:finding/AO210-CONTRACT-F002>
  a triage:Finding ;
  triage:findingId "AO210-CONTRACT-F002" ;
  triage:title "Second live independent decision gate: minimum_admissions_per_second bypasses classify_status as sole owner" ;
  triage:description "Interval-level pass/fail in run_admission_capacity.py (lines ~1520-1523, 2049, 2132, 2251) is gated by a hardcoded minimum_admissions_per_second (default 1000/s), unrelated to baselines.json. This feeds evidence['passed'] -> CapacityRunResult.code -> is ANDed with campaign.status=='PASS' for the final process exit code. A target can pass its reviewed baseline (classify_status==PASS) yet the run still exit nonzero (or vice versa) depending on this unrelated threshold. No test exercises the divergence. This violates the sprint's core mandate that classify_status() be the single-owner PASS/FAIL/INCOMPLETE decision. Confirmed by ruthless-boundary-qa (RBQA-F002) and quality-mgr's own direct read." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "CONTRACT" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
