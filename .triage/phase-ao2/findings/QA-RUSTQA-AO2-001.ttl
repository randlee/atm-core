<urn:atm:triage:finding/QA-RUSTQA-AO2-001>
  a triage:Finding ;
  triage:findingId "QA-RUSTQA-AO2-001" ;
  triage:title "sc-portability/sc-boundary lint rules excluded from resolve_task_names(all), never run by just validate/lint all" ;
  triage:description "sc-portability and sc-boundary lint rule names from .just/run_lint.py lines 56 and 199-201 exclude from resolve_task_names(all), so just validate / just lint all silently never runs them, hiding real portability/boundary violations from the standard validation gate. Confirmed by independent QA sweep finding 5 real PORT-001 hits. Required fix: include sc-portability and sc-boundary in the all task-name resolution in .just/run_lint.py." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "tooling" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
