<urn:atm:triage:finding/FTQ-004>
  a triage:Finding ;
  triage:findingId "FTQ-004" ;
  triage:title "Flaky real-wall-clock sleep race in message_handler advisory-deadline test (same pattern as fixed FTQ-002, different file)" ;
  triage:description "Test `started_dispatch_returns_its_actual_response_after_the_advisory_deadline` in crates/atm-http-runtime/src/message_handler.rs:1740-1765 is declared `#[tokio::test(flavor = \"current_thread\")]` (not `#[tokio::test(start_paused = true)]`), configures a 10ms advisory deadline, then does a real `tokio::time::sleep(25ms)` before asserting `!response.is_finished()` -- only a 15ms margin, the same real-wall-clock race pattern as the already-fixed FTQ-002 (crates/atm-http-runtime/src/peer_connection_pool.rs), just in a different test/file so FTQ-002's fix didn't cover it. Fix: convert to `#[tokio::test(start_paused = true)]` and use `tokio::time::advance(Duration::from_millis(...))` instead of a real sleep, matching the pattern used to fix FTQ-002." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "flaky-test" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-26T08:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.15 ;
  triage:foundAt "2026-08-26T07:53:16Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/FTQ-004/FTQ-004-occ-1> ;
  triage:triageRecordVersion "1" .

<urn:atm:triage:occurrence/FTQ-004/FTQ-004-occ-1>
  a triage:Occurrence ;
  triage:file "crates/atm-http-runtime/src/message_handler.rs" ;
  triage:line 1740 ;
  triage:snippet "#[tokio::test(flavor = \"current_thread\")] async fn started_dispatch_returns_its_actual_response_after_the_advisory_deadline() { ... tokio::time::sleep(std::time::Duration::from_millis(25)).await; assert!(!response.is_finished()); ..." ;
  triage:status "fixed" ;
  triage:closed true ;
