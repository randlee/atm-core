<urn:atm:triage:finding/RBQA-F002>
  a triage:Finding ;
  triage:findingId "RBQA-F002" ;
  triage:title "No test pins the asymmetric CLI-signed/daemon-unsigned case" ;
  triage:description "The new daemon-switch signing gate (require_macos_development_signatures in .just/daemon-switch.py, verification logic in .just/sign_daemon_dev.py) requires BOTH the atm CLI and atm-daemon binaries to pass codesign --verify --strict with the atm-daemon-dev authority before allowing switch_pair/restart lifecycle mutation. Test coverage confirms the fully-signed pass case and the fully-unsigned disposable-pair block case, but no test specifically pins the asymmetric case -- CLI signed correctly but daemon unsigned (or vice versa) -- to confirm the gate still blocks correctly when only one of the two binaries fails verification." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "rust-qa" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
