<urn:atm:triage:finding/ATM-QA-AO2END-004>
  a triage:Finding ;
  triage:findingId "ATM-QA-AO2END-004" ;
  triage:title "Committed benchmark evidence ambiguity - rand-m5 campaigns alongside canonical m5-atmbench evidence, no accepted-campaign manifest" ;
  triage:description "site/reports/send-message-benchmark/ contains 4 campaign JSON files with host_label rand-m5 committed at commit b207dd097, sitting in the same canonical evidence directory as the 4 correct m5-atmbench campaigns, with no document naming which campaign_id satisfies the AO2.5.4 accepted-line requirement. This directly implicates the standing project rule that official benchmark/gate evidence must come only from the isolated m5-atmbench account, never rand-m5, even as a fallback." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements" ;
  triage:severity "important" ;
  triage:repeatable false ;
