<urn:atm:triage:finding/AO210-CONTRACT-F003>
  a triage:Finding ;
  triage:findingId "AO210-CONTRACT-F003" ;
  triage:title "benchmark_report.py campaign_target_rows recomputes live pass/fail instead of trusting stored result snapshot" ;
  triage:description "benchmark_report.py:385 campaign_target_rows() recomputes 'passed' from live baselines.json + raw metrics instead of trusting the immutable stored result['status']/result['baseline'] snapshot. Because baselines.json only ratchets upward, an old artifact that legitimately PASSED under its recorded floor can render as failed once the floor rises later -- exactly the divergence AO2.10 exists to eliminate. Note: benchmark_report.py:495 campaign_status() (the six-profile v3 function) has ZERO callers anywhere in scripts/smoke/ -- it is dead code, not a live risk; only campaign_target_rows's inline recompute is live and blocking. Confirmed by req-qa, arch-qa, ruthless-boundary-qa, and quality-mgr's own direct verification of the live call chain." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "CONTRACT" ;
  triage:severity "blocking" ;
