  triage:snippet "#[tokio::test] async fn expired_idle_connection_is_evicted_and_redialed() { ... tokio::time::sleep(std::time::Duration::from_millis(15)).await; pool.evict_idle_now(); ..." ;
  triage:status "fixed" ;
