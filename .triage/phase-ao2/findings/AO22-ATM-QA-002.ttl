<urn:atm:triage:finding/AO22-ATM-QA-002>
  a triage:Finding ;
  triage:findingId "AO22-ATM-QA-002" ;
  triage:title "post-handshake failures collapse onto single ATM_PEER_AUTHENTICATION_FAILED, violating sprint's Error Inventory table" ;
  triage:description "The sprint's own Error Inventory table requires handshake-deadline/handshake-protocol failure to map to a distinct code (reuse ATM_TRANSPORT_TIMEOUT or register a new one), kept separate from hostname/pin-mismatch. The implementation instead collapses handshake-deadline expiry, generic handshake/protocol failure, hostname mismatch, and pin mismatch all onto a single ATM_PEER_AUTHENTICATION_FAILED code via blanket .map_err in connect()/accept() (lib.rs:85-95,100-110). That code's registry description is scoped to hostname/pin mismatch only, so its recovery guidance is inaccurate for a deadline/protocol failure. Remediation: route deadline failures through ATM_TRANSPORT_TIMEOUT (or a newly registered code) as the sprint's own Error Inventory instructs." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "requirements-compliance" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/peer-tls/src/lib.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-20T16:45:46+00:00"^^xsd:dateTime ;
  triage:foundIn triage:AO2.2 ;
  triage:foundAt "2026-08-20T16:45:46+00:00"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO22-ATM-QA-002/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO22-ATM-QA-002/QMGR-CLOSE-1> ;
  triage:closedAt "2026-08-20T22:53:43Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "2" .

