<urn:atm:triage:finding/ARCH-001>
  a triage:Finding ;
  triage:findingId "ARCH-001" ;
  triage:title "Deliverable-4 architecture guard does not reject the existing benchmark-only daemon" ;
  triage:description "crates/atm-daemon-bootstrap/tests/boundary_enforcement.rs's deliverable-4 guard does not reject the existing benchmark-only daemon (atm-daemon-bootstrap/src/lib.rs:165-177 run_benchmark_daemon + src/bin/atm-daemon-benchmark.rs). This also contradicts ADR-047's no benchmark-only daemon claim (docs/adr/ADR-047-layered-peer-wire-security.md:19-21). Fix requires extending the guard and correcting the ADR-047 text." ;
  triage:phaseId "phase-ao2" ;
