<urn:atm:triage:finding/AO22-RBQA-F003>
  a triage:Finding ;
  triage:findingId "AO22-RBQA-F003" ;
  triage:title "new AO2.2 boundary guard uses substring matching instead of AST-based check" ;
  triage:description "ao2_mtls_stream_adapter_is_the_only_authorized_production_tls_consumer (boundary_enforcement.rs:1319-1330) uses raw str::contains substring matching to assert peer-tls never references RequestEnvelope/canonical_api_router/MessageStore/PeerWireMode, rather than the AST-based (syn::visit) pattern already used elsewhere in the same file for this exact defect class. Substring guards in this codebase have previously proven to be false-positive/false-negative-prone landmines (see AO.1's RBQA-F001, a previously-fixed finding from the AO2.1 QA round -- this is a distinct new occurrence in AO2.2's own new guard, not a regression of that earlier finding). Remediation: replace with an AST-based import/path check consistent with the file's stronger enforcement style." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture-boundary" ;
  triage:severity "minor" ;
