<urn:atm:triage:finding/AO212-MIGRATE-F002>
  a triage:Finding ;
  triage:findingId "AO212-MIGRATE-F002" ;
  triage:title "Self-referential ratchet floor defeats acceptance gate for record-setting runs" ;
  triage:description "In migrate_benchmark_history.py (lines 234-235), the D8 ratchet floor is computed as floor = max(prior, observed) BEFORE the run is classified via classify_status(..., baseline_p50_floor=floor). For runs setting a new best, this self-referential comparison defeats the acceptance gate (observed >= observed always true). Fix: classify against prior floor first, update best map only after classification." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "MIGRATE" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
