<urn:atm:triage:finding/ATM-QA-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-001" ;
  triage:title "Orphaned dead code and stale comment after snapshot/restore lifecycle rewrite" ;
  triage:description "In run_admission_capacity.py, verify_durable_admissions() (around line 1191) is now orphaned dead code -- never called from run_capacity's actual lifecycle after the AO2.5.4 snapshot/restore rewrite. The adjacent comment at lines 1505-1506 ('Preserve the measured run and durability proof, then fail closed') is now factually stale/misleading: no durability-of-writes proof exists anymore, since the new snapshot/restore flow only proves the pre-roster clean-baseline snapshot's own internal integrity, not that the profiled run's accepted writes persisted. This is NOT a regression against the AO2.5.4 sprint doc's acceptance criteria (which explicitly scopes post-restore proof to baseline-cleanliness, not write durability) -- it is a cleanliness/clarity issue: a future reader could be misled. Fix: delete verify_durable_admissions() and its 3 orphaned unit tests, and correct the stale comment." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "dead-code" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "scripts/smoke/run_admission_capacity.py" ;
  triage:status "open" ;
  triage:dispatchReady true ;
