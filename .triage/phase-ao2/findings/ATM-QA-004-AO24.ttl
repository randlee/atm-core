<urn:atm:triage:finding/ATM-QA-004-AO24>
  a triage:Finding ;
  triage:findingId "ATM-QA-004-AO24" ;
  triage:title "Pre-AO.4 crosshost-send artifacts lack peer_wire_security provenance field" ;
  triage:description "Pre-existing bidirectional M4<->M5 crosshost-send PASS artifacts (dated 2026-08-08/2026-08-11) exist in the repo but predate ADR-047's requirement that smoke/benchmark evidence record the active peer-wire mode, so they carry no peer_wire_security field. Not currently miscited as AO.4 evidence, but risks future misattribution. Remediation: add a note in the AO.4 ledger or peer-pair-smoke docs clarifying that pre-AO.4 crosshost-send artifacts without a peer_wire_security field are not valid AO.4 mode-specific evidence." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "req-qa" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
