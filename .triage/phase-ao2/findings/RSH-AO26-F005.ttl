<urn:atm:triage:finding/RSH-AO26-F005>
  a triage:Finding ;
  triage:findingId "RSH-AO26-F005" ;
  triage:title "Bounded 1ms batch window doc/comment framing is inaccurate under a saturated producer" ;
  triage:description "The 'bounded 1ms batch window' framing is only true for the idle-wait phase -- while try_recv keeps succeeding (already-queued backlog), the deadline is never consulted, so a saturated producer can extend a batch past 1ms (bounded only by channel capacity, 256). Not a safety issue; recommend clarifying the code comment/doc language." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation-accuracy" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "single-occurrence" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-22T05:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.6 ;
