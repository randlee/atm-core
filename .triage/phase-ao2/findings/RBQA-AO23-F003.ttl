<urn:atm:triage:finding/RBQA-AO23-F003>
  a triage:Finding ;
  triage:findingId "RBQA-AO23-F003" ;
  triage:title "atm-daemon-bootstrap boundary manifest missing atm-storage allowed dependency" ;
  triage:description "crates/atm-daemon-bootstrap consumes atm-storage (PEM-scrubbing/TLS identity path) but boundaries/atm-daemon-bootstrap/replacement-bootstrap.toml's allowed_dependencies (line 25) only lists atm-storage-rusqlite, not atm-storage. .just/lint-config.toml's atm-daemon-bootstrap entry (~line 133) has no boundary_record_path set (unlike atm-error's entry), so .just/lint_boundaries.py cannot catch this drift automatically. Remediation: add atm-storage to the boundary TOML's allowed_dependencies and set boundary_record_path for this crate's lint-config entry." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture-boundary" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
