<urn:atm:triage:finding/RBQA-AO23-F003>
  a triage:Finding ;
  triage:findingId "RBQA-AO23-F003" ;
  triage:title "atm-daemon-bootstrap boundary manifest missing atm-storage allowed dependency" ;
  triage:description "crates/atm-daemon-bootstrap declares three dependencies in Cargo.toml that are present in .just/lint-config.toml's enforced allowlist but missing from boundaries/atm-daemon-bootstrap/replacement-bootstrap.toml's allowed_dependencies (line 25): (1) atm-storage for PEM-scrubbing/TLS identity path, (2) serde_json for message serialization, and (3) tempfile for temporary test fixtures. The boundary record incorrectly lists atm-storage-rusqlite, not atm-storage. .just/lint-config.toml's atm-daemon-bootstrap entry (~line 132) has no boundary_record_path set (unlike atm-error's entry), so .just/lint_boundaries.py cannot catch this drift automatically. Remediation: add atm-storage, serde_json, and tempfile to the boundary TOML's allowed_dependencies and set boundary_record_path for this crate's lint-config entry." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture-boundary" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-20T20:36:55Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.3 ;
  triage:foundAt "2026-08-20T20:36:55Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AO23-F003/AO23-W1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AO23-F003/AO23-W2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/RBQA-AO23-F003/AO23-W3> ;
  triage:triageRecordVersion "3" ;
  triage:closedNote "Confirmed fixed by quality-mgr QA-2 for PR #967 (commit b2ce7a267/ae3232d34); code-verified fix on feature/pao-s3-runtime-peer-wire-mode @ae3232d34." .

