<urn:atm:triage:finding/AO212-MIGRATE-F003>
  a triage:Finding ;
  triage:findingId "AO212-MIGRATE-F003" ;
  triage:title "displayed_status structurally guaranteed equal to result.status, contradicting sprint doc contract" ;
  triage:description "quality-mgr QA-1 on PR #1014, arch-qa ARCH-004, consistent with the same root cause as AO212-MIGRATE-F002 (self-referential ratchet floor): displayed_status is structurally guaranteed to equal result.status in every case, because both derive from the same ratchet-floor-based classify_status call. This means no per-run 'as originally judged' status is preserved anywhere in the migrated record, contradicting the sprint doc's contract note (lines 89-93) that the wrapped result's status is untouched and only displayed_status carries the D8 re-derivation. Likely resolves automatically once AO212-MIGRATE-F002 is fixed by classifying against the pre-update floor (prior) rather than the post-update floor, since the original per-run classification would then reflect the floor at the time the run actually occurred -- note this dependency in the triage record." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "MIGRATE" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-23T23:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.12 ;
  triage:foundAt "2026-08-24T05:50:00Z"^^xsd:dateTime ;
