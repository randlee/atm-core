<urn:atm:triage:finding/AO210-CONTRACT-F001>
  a triage:Finding ;
  triage:findingId "AO210-CONTRACT-F001" ;
  triage:title "classify_status roll-up precedence mismatch between run_admission_capacity.py and BenchmarkCampaign validator" ;
  triage:description "run_admission_capacity.py:2230 locally computes campaign_status with precedence [missing->INCOMPLETE, any FAIL->FAIL, any INCOMPLETE->INCOMPLETE, else PASS] -- the OPPOSITE order from BenchmarkCampaign.complete_matrix_has_derived_status in benchmark_schema.py:310-329 [missing->INCOMPLETE, any INCOMPLETE->INCOMPLETE, any FAIL->FAIL, else PASS], which matches the sprint doc's stated rule. Since the 4 targets run as independent subprocesses, a real run with one FAIL target + one INCOMPLETE target is reachable, and the mismatch crashes BenchmarkCampaign(...) construction with an unhandled ValueError before the campaign file is ever written. Masked from CI: test_ordinary_benchmark_fails_when_one_required_target_fails mocks BenchmarkCampaign entirely, so the real validator never runs in that test. Confirmed independently by req-qa (ATM-QA-001), arch-qa (ARCH-002), ruthless-boundary-qa (RBQA-F003), and quality-mgr's own direct read." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "CONTRACT" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-23T18:30:00Z"^^xsd:dateTime ;
