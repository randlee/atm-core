<urn:atm:triage:finding/AO22-RSH-001>
  a triage:Finding ;
  triage:findingId "AO22-RSH-001" ;
  triage:title "TLS ClientConfig/ServerConfig rebuilt from scratch on every connect()/accept() call -- DoS-relevant resource exhaustion" ;
  triage:description "ClientConfig/ServerConfig (including the identity's private key and full trusted-peer list) is rebuilt from scratch on every connect()/accept() call (crates/peer-tls/src/lib.rs:84,99,123-156) instead of being built once and cached/shared via Arc. A flood of connection attempts that never complete the handshake forces repeated private-key clones and trust-list clones -- resource cost proportional to connection attempts, not validated handshakes. Independently flagged convergently by rust-service-hardening (as RSH-001, severity-controlling since security-relevant) and rust-best-practices (as RBP-F001) -- record as one finding, note the dual-reviewer convergence. Remediation: build and cache ClientConfig/ServerConfig once (e.g. in from_peer_config/with_handshake_timeout, behind OnceCell/Arc), rebuilding only on trust-store change." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "security-hardening" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-20T16:46:00+00:00"^^xsd:dateTime ;
  triage:foundIn triage:AO2.2 ;
  triage:foundAt "2026-08-20T16:45:46+00:00"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO22-RSH-001/AO2-pao-s2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO22-RSH-001/QMGR-CLOSE-1> ;
  triage:closedAt "2026-08-20T22:53:43Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "2" .

