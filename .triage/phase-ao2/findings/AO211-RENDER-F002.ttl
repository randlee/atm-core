<urn:atm:triage:finding/AO211-RENDER-F002>
  a triage:Finding ;
  triage:findingId "AO211-RENDER-F002" ;
  triage:title "AC7 UTC-vs-Pacific-date sort proof missing from fixtures" ;
  triage:description "Sprint AO2.11 Acceptance Criterion 7 (docs/plans/phase-ao2/sprint-AO2-11-benchmark-rendering-pipeline.md line 124-133) requires 'a fixture with campaigns whose UTC order differs from their Pacific calendar-date order proves sorting/grouping uses the UTC values.' Found independently by req-qa (ATM-QA-002) and ruthless-boundary-qa (RBQA-F001), confirmed by quality-mgr's own Pacific-time conversion check: all fixture timestamps in .just/tests/test_benchmark_report.py (07:00Z/08:00Z/09:00Z) map to the same Pacific calendar date in August (UTC-7), so no existing test exercises a UTC-vs-Pacific-date disagreement case. quality-mgr confirmed by inspection that the implementation itself (load_campaigns, phase ordering) does sort on the UTC started_at datetime object correctly — this is a verification-coverage gap, not an active defect — but AC7 explicitly requires this exact proof and it is absent, so a future regression to Pacific-date-based sorting/grouping would slip through silently." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "RENDER" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-24T05:20:00Z"^^xsd:dateTime ;
