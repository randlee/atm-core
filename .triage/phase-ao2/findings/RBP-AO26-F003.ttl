<urn:atm:triage:finding/RBP-AO26-F003>
  a triage:Finding ;
  triage:findingId "RBP-AO26-F003" ;
  triage:title "collect_batch always returns Some(()); the is_none() break check in writer_loop is dead code" ;
  triage:description "collect_batch always returns Some(()), no code path returns None. The '.is_none() { break; }' check in writer_loop (writer/mod.rs:470-475) is dead/unreachable. Not a correctness bug -- writer_loop's real exit is driven by receive_first_message returning None on shutdown/disconnect -- but misleading. Recommend simplifying collect_batch's return type to ()." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "code-clarity" ;
  triage:severity "important" ;
  triage:repeatable false ;
