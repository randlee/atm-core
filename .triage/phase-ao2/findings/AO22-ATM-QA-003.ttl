<urn:atm:triage:finding/AO22-ATM-QA-003>
  a triage:Finding ;
  triage:findingId "AO22-ATM-QA-003" ;
  triage:title "required hostname-mismatch negative test is not actually exercised" ;
  triage:description "Deliverable 4 requires a distinct \"hostname mismatch\" negative test, separate from \"missing/disabled interface.\" The only hostname-named test, disabled_or_hostname_mismatched_peer_fails_before_tcp_or_http_work (lib.rs:399-413), only constructs a disabled-peer scenario -- both sides use the literal \"localhost\"; no case configures a trusted peer under one hostname and connects/looks up a different one. The dedicated hostname-mismatch negative is not actually exercised. Remediation: add or extend a test that configures a trusted peer under one hostname and attempts connect/lookup against a different hostname, asserting fail-closed behavior before any bytes flow." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
