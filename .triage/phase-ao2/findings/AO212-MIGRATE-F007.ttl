<urn:atm:triage:finding/AO212-MIGRATE-F007>
  a triage:Finding ;
  triage:findingId "AO212-MIGRATE-F007" ;
  triage:title "Machine gate does not catch rigged-input class of defect (ratchet self-reference)" ;
  triage:description "quality-mgr QA-1 on PR #1014, ruthless-boundary-qa RBQA-F007: the sprint's stated machine gate ('grep gate: no class redefinition outside benchmark_schema.py') would not catch AO212-MIGRATE-F002's class of defect (a rigged input value, not a redefinition/rename). Recommend a durable property test asserting the floor used to classify run N never depends on run N's own contribution. This is a test-hardening recommendation tied to fixing F002, not an independent code defect." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "MIGRATE" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-24T05:47:10Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.12 ;
  triage:foundAt "2026-08-24T05:50:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO212-MIGRATE-F007/AO212-gate-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO212-MIGRATE-F007/AO213-gate-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO212-MIGRATE-F007/QMGR-CLOSE-1> ;
  triage:closedAt "2026-08-25T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "test_record_setting_run_is_classified_against_the_prior_ratchet_floor now exists in test_migrate_benchmark_history.py, a durable property test asserting a run's classification never depends on its own contribution to the ratchet floor -- exactly the recommended machine-gate hardening. Fixed in commit 22a97a027." ;
  triage:triageRecordVersion "2" .

