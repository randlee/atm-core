<urn:atm:triage:finding/AO27-HARNESS-F001>
  a triage:Finding ;
  triage:findingId "AO27-HARNESS-F001" ;
  triage:title "M5AttemptLedger contract implemented but never called" ;
  triage:description "The M5AttemptLedger safety contract (SuiteIntent, CompleteSuiteAttempt, derive_accepted_m5, crash-safe append-before-execute) is fully implemented in scripts/smoke/benchmark_suite.py but is never instantiated or called outside its own unit test. The actual entry points (run_admission_capacity.py and benchmark_report.py) derive PASS/FAIL from each target's latest evidence file independently, bypassing the ledger's restore-verified check, intent/completion pairing, 3-consecutive-attempt requirement, and candidate-lineage check. This means the PR ships the ledger's building blocks but not the actual AO2.7 safety and acceptance deliverable." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "HARNESS" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "deferred" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-22T21:10:00Z"^^xsd:dateTime ;
  triage:deferredNote "Fixing as originally scoped (wiring M5AttemptLedger into current entry points) is throwaway: AO2.10 (docs/plans/phase-ao2/sprint-AO2-10-benchmark-data-contract.md) replaces this PASS/FAIL derivation path with a single-owner classify_status() model. Deferred, not closed as fixed, pending AO2.10 landing; team-lead will re-open or close this finding against the new model once AO2.10 merges." ;
  triage:foundIn triage:AO2.7 ;
  triage:foundAt "2026-08-22T21:09:45Z"^^xsd:dateTime ;
