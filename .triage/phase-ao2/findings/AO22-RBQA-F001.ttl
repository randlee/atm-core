<urn:atm:triage:finding/AO22-RBQA-F001>
  a triage:Finding ;
  triage:findingId "AO22-RBQA-F001" ;
  triage:title "PinnedServerVerifier normalizes fingerprint with bare .to_ascii_lowercase() instead of canonical atm_storage::tls::normalize_fingerprint -- asymmetric pin bug" ;
  triage:description "PinnedServerVerifier (client-side pin check in connect(), crates/peer-tls/src/lib.rs:178) normalizes the configured fingerprint with a bare .to_ascii_lowercase() instead of the canonical atm_storage::tls::normalize_fingerprint helper (which also strips colon/space separators). PinnedClientVerifier (server-side accept() path, atm-storage/src/tls.rs:142) already uses the canonical helper. A colon-separated fingerprint (the common `openssl x509 -fingerprint` presentation format) would verify correctly on accept() but always fail to match on connect() -- a silent, asymmetric pin-comparison bug reachable with valid config input, and a duplicated implementation of logic the sprint doc explicitly requires to be sourced from the canonical helper. Remediation: replace with atm_storage::normalize_fingerprint(...) in PinnedServerVerifier::new." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "architecture-boundary" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/peer-tls/src/lib.rs" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-20T16:46:00+00:00"^^xsd:dateTime ;
  triage:foundIn triage:AO2.2 ;
  triage:foundAt "2026-08-20T16:45:46+00:00"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO22-RBQA-F001/AO2.2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO22-RBQA-F001/QMGR-CLOSE-1> ;
  triage:closedAt "2026-08-20T22:53:43Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "2" .

