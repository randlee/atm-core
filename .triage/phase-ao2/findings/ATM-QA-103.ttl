<urn:atm:triage:finding/ATM-QA-103>
  a triage:Finding ;
  triage:findingId "ATM-QA-103" ;
  triage:title "Structural guard functions retain ao2_ prefix despite AO.3 extension" ;
  triage:description "The structural guard functions relevant to AO.3's wiring (ao2_plaintext_baseline_stays_on_the_existing_direct_peer_pipeline, ao2_peer_wire_policy_keeps_one_error_registry_and_one_http_pipeline, ao2_benchmark_harness_cannot_introduce_a_second_daemon_pipeline, ao2_mtls_stream_adapter_is_the_only_authorized_production_tls_consumer) all retain ao2_ prefixes even though this branch genuinely extended several of them to assert against AO.3-owned symbols directly. Weakens sprint-to-guard traceability for future audits. Remediation: rename or add doc-comments marking which assertions were extended in AO.3." ;
  triage:phaseId "phase-ao2" ;
