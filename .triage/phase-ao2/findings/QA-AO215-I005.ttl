<urn:atm:triage:finding/QA-AO215-I005>
  a triage:Finding ;
  triage:findingId "QA-AO215-I005" ;
  triage:title "Doctor-health check can be bypassed by pre-JSON exit-code gating" ;
  triage:description "daemon-switch.py's command_path() can raise SwitchError before producing any JSON output; in that case the JSON-content health check cannot run, and the failure is instead surfaced via an implicit exit-code gate -- reintroducing exactly the exit-code gating the doc forbids, for a different failure class (early SwitchError vs an unhealthy-but-running daemon)." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "spec-violation" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
