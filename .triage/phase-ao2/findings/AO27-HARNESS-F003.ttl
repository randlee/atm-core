<urn:atm:triage:finding/AO27-HARNESS-F003>
  a triage:Finding ;
  triage:findingId "AO27-HARNESS-F003" ;
  triage:title "mTLS key file permissions gap" ;
  triage:description "The mTLS certificate and key file setup for the benchmark harness does not enforce secure file permissions (e.g., 0600 on private keys). This is a security best-practice gap that should be addressed to prevent accidental exposure of private key material." ;
  triage:phaseId "phase-ao2" ;
  triage:triageMode "initial_pass" ;
  triage:category "HARNESS" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-22T21:10:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AO2.7 ;
  triage:foundAt "2026-08-22T21:09:45Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO27-HARNESS-F003/ao2-7-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AO27-HARNESS-F003/QMGR-CLOSE-1> ;
  triage:closedAt "2026-08-25T00:00:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:closureNote "scripts/smoke/benchmark_mtls.py now calls os.chmod(private_key, 0o600) and os.chmod(published, 0o600) after writing the mTLS key material, with a dedicated permission-assertion test in test_benchmark_mtls.py (lines 52-55). Fixed in commit 6415aa126." ;
  triage:triageRecordVersion "2" .

