@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/YB-027>
  a triage:Finding ;
  triage:findingId "YB-027" ;
  triage:title "RSH-Y9-002: no max message size check on delivery path before write" ;
  triage:description "crates/atm-daemon/src/non_claude_outbound_runtime.rs delivery_payloads() method does not enforce input size limits on the NonClaudeOutboundDeliveryRequest before performing FS write. The serialize-then-write sequence (serde_json::to_vec + file.write_all) has no maximum size validation, creating a potential DoS vector via unbounded message count or size." ;
  triage:category "RSH" ;
  triage:phaseId "phase-Yb" ;
  triage:triageMode "initial_pass" ;
  triage:severity "Important" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-daemon/src/non_claude_outbound_runtime.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/YB-027/s7/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/YB-027/s8/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/YB-027/s9/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/YB-027/s10/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/YB-027/s11/1> ;
  triage:openOn <urn:atm:triage:worktree/s7> ;
  triage:openOn <urn:atm:triage:worktree/s8> ;
  triage:openOn <urn:atm:triage:worktree/s9> ;
  triage:openOn <urn:atm:triage:worktree/s10> ;
  triage:openOn <urn:atm:triage:worktree/s11> ;
  triage:promoteTo <urn:atm:triage:worktree/s11> ;
  triage:scopeExceedsPhaseDeliverables true ;
  triage:notes "Hardening finding flagged by QA on s9 but scope exceeds Y.9 'boundary formalization' goals. Phase Yb hardening audit (3 iterations, 20 findings resolved) did not require input size validation as Y.7-Y.11 acceptance criterion. Input size validation is a separate security hardening task, not a boundary-formalization responsibility. This finding is valid but out-of-phase; dispatch to appropriate hardening sprint or post-phase-Yb hardening cycle." .

