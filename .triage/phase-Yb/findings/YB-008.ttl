<urn:atm:triage:finding/YB-008>
  a triage:Finding ;
  triage:findingId "YB-008" ;
  triage:title "DaemonNonClaudeOutbound dead phantom never wired into delivery path" ;
  triage:description "RuntimeComposition._non_claude_outbound (composition.rs:229) holds DaemonNonClaudeOutbound but never injects it into LocalServiceRuntime used for actual request handling. default_local_runtime() calls LocalServiceRuntime::new with 3-arg constructor installing LocalFileNonClaudeOutbound instead. RULE-004 dual-surface violation." ;
  triage:phaseId "phase-Yb" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T00:00:00Z"^^xsd:dateTime ;
