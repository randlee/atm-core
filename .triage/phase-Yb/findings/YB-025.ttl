<urn:atm:triage:finding/YB-025>
  a triage:Finding ;
  triage:findingId "YB-025" ;
  triage:title "Boundary TOML composition.roots claims DaemonNonClaudeOutbound wired but it is not" ;
  triage:description "The daemon boundary TOML (boundaries/atm-daemon/daemon-non-claude-outbound.toml) composition.roots section claims DaemonNonClaudeOutbound is wired into the delivery path via compose_runtime, but crates/atm-daemon/src/composition.rs holds DaemonNonClaudeOutbound as a phantom field (_non_claude_outbound) for ownership clarity only. The actual delivery path uses LocalFileNonClaudeOutbound from crates/atm-core/src/service_runtime.rs via LocalServiceRuntime. The TOML document must reflect the actual composition wiring." ;
  triage:phaseId "phase-Yb" ;
  triage:triageMode "initial_pass" ;
  triage:category "YB" ;
  triage:severity "Important" ;
  triage:repeatable false ;
  triage:sweepScope "boundaries/atm-daemon/ crates/atm-daemon/src/composition.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-05-17T14:42:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/YB-025/s7/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/YB-025/s8/1> ;
