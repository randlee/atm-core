<urn:atm:triage:finding/YB-005>
  a triage:Finding ;
  triage:findingId "YB-005" ;
  triage:title "maybe_run_post_send_hook remains pub(crate) boundary escape" ;
  triage:description "pub(crate) fn maybe_run_post_send_hook at send/mod.rs:958-964 is a direct-call escape hatch bypassable by any atm-core module without going through PostSendNotificationExecutor. Remediation: reduce to pub(super) or delete." ;
