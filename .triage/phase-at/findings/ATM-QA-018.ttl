<urn:atm:triage:finding/ATM-QA-018>
  a triage:Finding ;
  triage:findingId "ATM-QA-018" ;
  triage:title "CHANGELOG.md 1.4.4 entry still cites the superseded sc-publish pin (42e0fcea, 49 files) after this PR advances the pin to 25668ecc (54 files)" ;
  triage:description "CHANGELOG.md's already-drafted '## 1.4.4' section states the publish surface is cut over to the kit at 'pinned revision 42e0fcea (49 byte-copied files)'. This PR (chore/sc-publish-repin-25668ec) advances release/sc-publish-pin.toml to revision 25668ecc164261be676c9414c4f603b18ab74c91, and the qualification receipt records a byte-parity sweep of 54 byte-identical files (kit grew 49 -> 54 files vs the prior pin). CHANGELOG.md was not touched by this PR despite being listed among the review's phase_or_sprint_docs, so the released changelog would ship stating the wrong revision and file count for what actually installs at v1.4.4 cut time. Independently verified by quality-mgr via direct grep of CHANGELOG.md:6 on commit 70739a990 (confirmed literal string '42e0fcea', '49 byte-copied')." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
