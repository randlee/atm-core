<urn:atm:triage:finding/ATM-QA-011>
  a triage:Finding ;
  triage:findingId "ATM-QA-011" ;
  triage:title "AT.2-receipt.md does not conform to the phase README's Receipt Convention (missing digest/sha256 fields)" ;
  triage:description "docs/plans/phase-at/README.md:183-199 (Receipt Convention) mandates every AT sprint receipt record the pinned sc-publish revision plus a package digest (sha256 over newline-joined, path-sorted sha256(file)/relative-path lines, excluding specified files), the consumer-input sha256, and rendered-manifest sha256s. docs/plans/phase-at/receipts/AT.2-receipt.md's frontmatter contains only kit_revision; none of the mandated digest/sha256 fields are present anywhere in the file. Reported by arch-qa (ARCH-002) in QA pass AT2-QA-R1 on PR #1064." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-27T20:30:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AT2 ;
  triage:foundAt "2026-08-27T20:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-011/PAT-S2-1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-011/QMGR-CLOSE-1> ;
  triage:closedAt "2026-08-27T21:20:00Z"^^xsd:dateTime ;
  triage:closedBy "quality-mgr" ;
  triage:triageRecordVersion "2" .

