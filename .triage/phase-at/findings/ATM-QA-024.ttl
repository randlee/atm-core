  triage:foundAt "2026-08-28T04:45:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-024/POSTMORTEM-1084-1> ;
  triage:triageRecordVersion "1" .

