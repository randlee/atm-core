<urn:atm:triage:finding/ATM-QA-019>
  a triage:Finding ;
  triage:findingId "ATM-QA-019" ;
  triage:title "just validate fails: .just/tests/test_release_homebrew_workflow.py still asserts the extract-published-renderer step this PR removed from homebrew-publish.yml" ;
  triage:description "This PR's diff to .github/workflows/homebrew-publish.yml deletes the 'Extract manifest-declared published renderer' step (uses: ./.github/actions/extract-published-renderer) and replaces it with a 'Bootstrap renderer' step (uses: ./.github/actions/setup-renderer) -- confirmed via git diff origin/develop...HEAD. The repo-local, atm-core-owned test test_homebrew_job_requires_credential_and_published_renderer (.just/tests/test_release_homebrew_workflow.py:32) still asserts self.assertIn(\"./.github/actions/extract-published-renderer\", text), i.e. it was not updated to match the new setup-renderer bootstrap pattern. Running `just validate` on this branch fails at the pytests step (1 failure, 9 skipped) as a direct result. This is a real, reproducible regression in the repo's own required phase-end validation gate caused by this PR's own workflow edit, not a stale-checkout or environment artifact. Found by rust-qa-agent, independently confirmed by quality-mgr via direct git diff and grep on commit 70739a990." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "test-regression" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-28T03:20:00Z"^^xsd:dateTime ;
  triage:foundIn triage:RELPREP-1069 ;
  triage:foundAt "2026-08-28T03:15:00Z"^^xsd:dateTime ;
