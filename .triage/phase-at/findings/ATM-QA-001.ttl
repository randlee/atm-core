<urn:atm:triage:finding/ATM-QA-001>
  a triage:Finding ;
  triage:findingId "ATM-QA-001" ;
  triage:title "Phase README Goal and Upstream Contract sections not amended with forward-only ruling" ;
  triage:description "docs/plans/phase-at/README.md lines 15-19 and 104-106 (Goal + Authoritative Upstream Contract sections) still describe the abandoned 1.4.3 TestPyPI/PyPI retry with no mention of the 2026-08-27 forward-only ruling recorded in receipts/AT.1-receipt.md. Fix: amend both sections to match the receipt's language (v1.4.3 unpublishable via kit; TestPyPI leg retargeted to first kit-era tag 1.4.4; production pending-contemporaneous-authorization). Reported by req-qa in QA pass AT-PHASECLOSE-QA-R1." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "docs/plans/phase-at/ and docs/project-plan.md for any remaining 1.4.3-retry language contradicting the forward-only ruling" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
