<urn:atm:triage:finding/RBQA-F001>
  a triage:Finding ;
  triage:findingId "RBQA-F001" ;
  triage:title "Structurally unreachable installed_docs validation branch in validate_release.py" ;
  triage:description "scripts/validate_release.py:289+ (installed_docs branch gated at line 375) is structurally unreachable against the real kit-rendered release/publish-artifacts.toml, which never emits an [installed_docs] table (doc-shipping is expressed via release_binaries[].bundled_paths instead). Only the hand-written legacy-schema fixture in .just/tests/test_validate_release.py exercises this branch. Fix: delete the dead installed_docs validation path (and its scripts/verify_user_docs.py companion), or replace it with a thin check against the kit's actual bundled_paths field." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "scripts/*.py and .just/tests/" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-27T20:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AT1 ;
  triage:foundAt "2026-08-27T18:40:00Z"^^xsd:dateTime ;
