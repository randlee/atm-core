<urn:atm:triage:finding/ATM-QA-014>
  a triage:Finding ;
  triage:findingId "ATM-QA-014" ;
  triage:title "tools/bootstrap-requirements.txt missing markupsafe pin breaks `just test coverage` on a clean bootstrap venv" ;
  triage:description "jinja2==3.1.6 (pinned in tools/bootstrap-requirements.txt) requires markupsafe at import time, but the closure file omits it and is installed with `pip install --no-deps`, so a from-scratch bootstrap venv fails `python -c 'import jinja2'` with ModuleNotFoundError: No module named 'markupsafe', and scripts/coverage/run.py (which imports jinja2) cannot run `just test coverage` out of the box even though `just bootstrap` reports the pinned contract verified. Reported by rust-qa-agent (QA-001) in QA pass AT-PHASECLOSE-QA-R2 on PR #1065, reproduced from a genuinely clean venv." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "build" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-27T22:00:00Z"^^xsd:dateTime ;
