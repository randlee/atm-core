<urn:atm:triage:finding/AT1-QA-004>
  a triage:Finding ;
  triage:findingId "AT1-QA-004" ;
  triage:title "just validate hard-fails pre-publish: cargo dry-run resolution of unpublished workspace version lacks the README's Expected/Proceed carve-out" ;
  triage:description "scripts/validate_release.py's phase-ad-readiness stage runs cargo package / cargo publish --dry-run, which resolves intra-workspace ^1.4.4 path-dep requirements against the public crates.io index. crates.io only has 1.4.3/1.4.2 (1.4.4 not yet published), so 12/14 publishable crates fail and just validate exits nonzero. Pre-existing at 7df74a28b (same code, same severity=error classification) — previously unreached, unmasked by the AT1-QA-001 rewiring fix. The phase README Non-Blocking Outcomes table already classifies this outcome class (404 / not-yet-published version) as Expected/Proceed, but append_completed_findings in scripts/validate_release.py does not implement that carve-out for this cargo-resolution error shape, so just validate will hard-fail for every future coordinated version bump until the moment of actual publication." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "release-validation-gate" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-26T23:00:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AT1 ;
  triage:foundAt "2026-08-27T01:58:01Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AT1-QA-004/AT1-004-integrate-0> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AT1-QA-004/AT1-004-feature-1> ;
  triage:triageRecordVersion "1" .

