<urn:atm:triage:finding/AT1-QA-003>
  a triage:Finding ;
  triage:findingId "AT1-QA-003" ;
  triage:title ".just/check_version_sync.py hand-duplicates version-lockstep logic already computed generically by kit release_artifacts.py" ;
  triage:description ".just/check_version_sync.py re-implements version-lockstep verification that the kit-installed scripts/release_artifacts.py already computes generically from release/publish-artifacts.toml. Divergent duplicate logic is a boundary violation: the two can drift. Fix: make the .just check delegate to (or invoke) the kit validator's generic computation rather than duplicating it. Constraint: kit-installed files must NOT be edited; the fix lives entirely in consumer-owned .just/ code. Reported by ruthless-boundary-qa, confirmed by quality-mgr in AT1-QA-R1. Full report: PR #1044 comment 5433210488." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary-duplication" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-27T02:15:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AT1 ;
  triage:foundAt "2026-08-27T01:31:34Z"^^xsd:dateTime ;
