  a triage:Finding ;
  triage:findingId "ATM-QA-004" ;
  triage:title "project-plan.md Phase AT entry stale on forward-only ruling" ;
  triage:description "docs/project-plan.md's Phase AT entry (~line 1457) is stale: still says AT.1's scope is 'execute only authorized TestPyPI->PyPI retry of the immutable 1.4.3 Python release,' with no mention of the forward-only ruling. The forward-only ruling was documented in docs/at2-forward-only-gates branch, which correctly separates AT.1 (install and prove parity) from AT.2 (the TestPyPI->PyPI retry with forward-only constraint). Reported by req-qa in QA pass AT-PHASECLOSE-QA-R1." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "docs/project-plan.md Phase AT section" ;
