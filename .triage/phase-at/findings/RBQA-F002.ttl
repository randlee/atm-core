<urn:atm:triage:finding/RBQA-F002>
  a triage:Finding ;
  triage:findingId "RBQA-F002" ;
  triage:title "validate_release.py still imports from legacy release_artifacts.py slated for AT.2 deletion" ;
  triage:description "scripts/validate_release.py still imports installed_doc_members/installed_doc_source_files/installed_docs_source_root/load_manifest from the legacy root scripts/release_artifacts.py — the exact file AT.2's Deletion Candidates table marks for removal because the kit supersedes it. The file that claims full kit-delegation (per the AT1-QA-001 fix) is quietly still dependent on the module marked for deletion. Removing RBQA-F001's dead branch removes this import too. Planned routing: fold into AT.2's validate_release.py decision row alongside RBQA-F001. Reported by ruthless-boundary-qa (important) in QA pass AT-PHASECLOSE-QA-R1." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "boundary" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "all scripts/ and .github/scripts/ files importing from scripts/release_artifacts.py" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-27T17:39:19Z"^^xsd:dateTime ;
