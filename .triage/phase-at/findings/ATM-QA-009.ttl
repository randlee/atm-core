<urn:atm:triage:occurrence/ATM-QA-009/QMGR-CLOSE-1>
  a triage:Occurrence ;
  triage:file "release/publish-surface-scope.md" ;
  triage:line 65 ;
  triage:snippet "quality-mgr AT2-QA-R2 re-verification: release/publish-surface-scope.md no longer describes scripts/verify_user_docs.py as the live user-doc freshness gate; it now states the retained ATM checks validate consumer-contract data only and do not maintain a second user-document staging/freshness-verifier path (post-AT.2 release boundary). Confirmed independently by arch-qa and ruthless-boundary-qa on PR #1064. A whole-repo grep afterward surfaced one further hit at reports/smoke/phase-AE-installed-docs-proof.md:89, a dated pre-AT2 Phase AE smoke-proof record (last touched by 6e48d004c, unrelated to this sprint) describing what was historically run, not current behavior; tracked separately as ATM-QA-012 (receipt exclusion-wording gap) rather than reopening this record, since the live-doc defect this finding targeted is fixed." ;
  triage:status "fixed" ;
  triage:closed true ;
  triage:branch "feature/pat-s2-legacy-publish-deletion" ;
  triage:headSha "a9697994ada4bd00b84b971269ead48d897808ba" ;
