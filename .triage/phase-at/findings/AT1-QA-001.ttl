<urn:atm:triage:finding/AT1-QA-001>
  a triage:Finding ;
  triage:findingId "AT1-QA-001" ;
  triage:title "just validate fails: validate gate still wired to legacy scripts/release_artifacts.py with legacy schema" ;
  triage:description "The justfile validate target (via scripts/validate_release.py) runs the OLD scripts/release_artifacts.py, whose legacy schema requires required/preflight_check/verify_install per crate. The new sc-publish-installed release/publish-artifacts.toml no longer satisfies that schema, so `just validate` genuinely fails end-to-end (exit 1) on feature/pat-s1-install-and-publish. The AT.1 receipt validated only the NEW kit-installed .github/scripts/release_artifacts.py (which passes, exit 0). Fix direction: point scripts/validate_release.py's manifest step at the kit-installed validator." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "release-validation-gate" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-08-27T01:40:00Z"^^xsd:dateTime ;
  triage:foundIn triage:AT1 ;
  triage:foundAt "2026-08-27T01:31:34Z"^^xsd:dateTime ;
