<urn:atm:triage:finding/ATM-QA-013>
  a triage:Finding ;
  triage:findingId "ATM-QA-013" ;
  triage:title "AT.1 sprint-doc frontmatter never flipped to complete; README's status-flip convention has no carve-out for authorization-gated terminal sprints" ;
  triage:description "docs/plans/phase-at/AT.1-install-parity-and-publish.md:9 still reads status: in-progress even though AT.1 merged long ago, has a filed receipt (docs/plans/phase-at/receipts/AT.1-receipt.md, status install-parity-complete), and AT.2 (must_follow AT.1 per README.md:129) is already merged with status: complete -- which could not be true if AT.1 were genuinely still in-progress. The phase README's own Sprint Sequence convention ('frontmatter status: flips to complete in the same PR that merges the sprint's final commit') is unconditional and has no carve-out for a sprint whose deliverables are structurally complete but whose publish legs remain permanently authorization-gated (unlike AT.2, which has an explicit deferred-until-<gate> disposition vocabulary for exactly this situation). Independently reported by three reviewers in QA pass AT-PHASECLOSE-QA-R2 on PR #1065: arch-qa (ARCH-AT-001), ruthless-boundary-qa (RBQA-F005), and req-qa (ATM-QA-EOP-001)." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-08-27T21:45:00Z"^^xsd:dateTime ;
