  triage:foundAt "2026-08-27T21:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ATM-QA-013/INTEGRATE-AT-1> ;
  triage:triageRecordVersion "1" .

