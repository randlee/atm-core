<urn:atm:triage:finding/ATM-QA-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-002" ;
  triage:title "AT.2 doc on integrate/phase-at still defines unsatisfiable v1.4.3-tied gates; PR #1063 fix exists only on develop-targeted branch" ;
  triage:description "docs/plans/phase-at/AT.2-legacy-deletion.md on integrate/phase-at still defines the hermes-row gate as 'AT.1 production receipt' implicitly tied to v1.4.3 — a gate that can never be satisfied by v1.4.3. PR #1063 (docs/at2-forward-only-gates -> develop) fixes exactly this but has not merged forward into integrate/phase-at. Dual-reported as ARCH-001 by arch-qa (gate-sequencing). Resolution path: merge #1063 to develop then merge-forward develop -> integrate/phase-at. Reported in QA pass AT-PHASECLOSE-QA-R1." ;
  triage:phaseId "phase-at" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "blocking" ;
