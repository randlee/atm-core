<urn:atm:triage:finding/AD28-RSH-004-005>
  a triage:Finding ;
  triage:findingId "AD28-RSH-004-005" ;
  triage:title "Per-call bounded-helper-thread pattern (introduced by AD28-FIX-1) leaks unbounded/uncancellable threads and lacks tracing on the timeout/disconnect branch" ;
  triage:description "AD28-FIX-1 replaced the single fixed worker (which caused RSH-001/RSH-002) with a per-call bounded-helper-thread pattern for host-nudge injection. The caller's wait on each call is correctly bounded via HOST_NUDGE_INJECTION_DEADLINE, but the underlying spawned OS thread itself has no bound or cancellation -- if a host callback hangs permanently, the caller times out and returns correctly, but the underlying thread is never reaped, leaking one thread per hung call under sustained/repeated hangs. Additionally, the default no-op observability path emits no structured tracing when this specific timeout/disconnect branch is hit, making the condition invisible in production without a custom observer." ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:phaseId "phase-AD" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-graft/src/runtime.rs, crates/atm-graft/src/nudge_sink.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-08T18:15:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD28-RSH-004-005/pAD-s28/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD28-RSH-004-005/pAD-s28/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD28-RSH-004-005/pAD-s28/3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD28-RSH-004-005/pAD-s28/4> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s28/ef7e9f8b> ;
  triage:promoteTo <urn:atm:triage:worktree/pAD-s28/ef7e9f8b> .

