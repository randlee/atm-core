<urn:atm:triage:finding/AD15-DISPATCHRENAME-001>
  a triage:Finding ;
  triage:findingId "AD15-DISPATCHRENAME-001" ;
  triage:title "graft_dispatch.rs advisory dispatch renamed, not deleted" ;
  triage:description "crates/atm-daemon/src/graft_dispatch.rs:15-19 -- dispatch_advisory_stream was renamed to dispatch_graft_stream but still takes AdvisoryStreamRequest and streams through GraftStreamSink -- same forbidden advisory-streaming concept under a new name, not actually deleted. Live call site confirmed at crates/atm-daemon/src/local_ipc_transport/request_worker.rs:320-336. Originally reported during AD14-QA-3 review of PR #478 (feature/pAD-s14-shared-graft-boundary-surface-reset) as ARCH-002, but sprint-AD14.md's own scope explicitly excludes crates/atm-daemon/* and defers daemon runtime deletion to a later sprint. sprint-AD15.md's own stated Goal is 'delete daemon-owned graft advisory runtime' and its Exact Targets explicitly cover crates/atm-daemon/*. Team-lead has ruled (user-confirmed 2026-07-06) that this finding is properly AD.15-owned undone work, not an AD.14 violation -- reclassify accordingly rather than treating it as newly discovered on AD.14's branch." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "Blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD15-DISPATCHRENAME-001/pAD-s14/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD15-DISPATCHRENAME-001/pAD-s14/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD15-DISPATCHRENAME-001/pAD-s14/3> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD15-DISPATCHRENAME-001/pAD-s14/4> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s14/826b9804> ;
  triage:fixedOn <urn:atm:triage:worktree/pAD-s15/cf3b1e71> ;
  triage:promoteTo <urn:atm:triage:worktree/pAD-s15/cf3b1e71> ;
  triage:dispatchReadyJustification "Finding already fixed on promote_to_branch (s15); AD.17 completion gate (#161) still blocks dispatch of any fixes. Waiting for user approval and AD.17 closure." .

