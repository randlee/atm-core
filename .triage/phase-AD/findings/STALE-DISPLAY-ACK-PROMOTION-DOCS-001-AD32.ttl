<urn:atm:triage:finding/STALE-DISPLAY-ACK-PROMOTION-DOCS-001-AD32>
  a triage:Finding ;
  triage:findingId "STALE-DISPLAY-ACK-PROMOTION-DOCS-001-AD32" ;
  triage:title "Stale display-time ack-promotion wording never deleted, contradicting shipped ADR-022" ;
  triage:description "AD32-QA-2 (PR #504) req-qa ATM-QA-032-001, blocking, new this round. docs/requirements.md section 7.10 (and a duplicate block around lines 2177-2196) plus docs/read-behavior.md section 6 still document the deleted PromoteDisplayedUnread behavior verbatim: 'Ack-axis activation on display happens only when...' and the transition table (Unread, NoAckRequired) -> (Read, PendingAck). This directly contradicts the shipped code (read/mod.rs::transition_displayed_message only ever sets read=true) and ADR-022's own statement that this behavior is deleted and must not return. docs/requirements.md is an explicit sprint Exact Target with a 'Paths To Delete' instruction naming exactly this wording -- it was not deleted. Verified present on all 5 branches via direct grep search." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:category "DOC" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
