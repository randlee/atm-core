<urn:atm:triage:finding/PEEK-MUTATION-001>
  a triage:Finding ;
  triage:findingId "PEEK-MUTATION-001" ;
  triage:title "atm peek mutates read state; AckActivationMode never checked at mutation gate" ;
  triage:description "Prior canonical record (status=open) recorded peek_mail_with_runtime routing through the same read_mail_with_runtime_impl -> resolve_read_display -> apply_display_mutations_to_store path as atm read, with the mutation gate never consulting ack_activation_mode. AD35-QA-1's arch-qa review now reports this is genuinely structurally fixed on AD.35: peek_mail_with_runtime now uses a call path resolve_read_context -> load_read_selection -> build_unmodified_read_display that structurally cannot invoke mutation. Regression test confirmed: build_unmodified_read_display (line 646-673) explicitly sets mutation_applied=false and does not call any mutation gate. Verification on followup_pass: AD.31-34 still have the buggy code (peek_mail_with_runtime calls read_mail_with_runtime_impl at line 344). AD.35 fixed in commit bd3ab37a (peek restructured to avoid mutating code path entirely). Fix must be merged forward from AD.35 to AD.31-34."@en ;
  triage:category "PEEK-MUTATION" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:pattern "displayed_messages_require_mutation|peek_mail_with_runtime|resolve_read_context|load_read_selection|build_unmodified_read_display" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/PEEK-MUTATION-001/AD.31/1> ;
  triage:openOn <urn:atm:triage:worktree/AD.31/cddd20544a3a5bb9d3caa70eca9cf01dc5f05862> ;
  triage:openOn <urn:atm:triage:worktree/AD.32/54ad2c6b8e7038f561b5c84e3f51974a636e3ef1> ;
  triage:openOn <urn:atm:triage:worktree/AD.33/bfafd5de9e3377e4dd51fbb9da7bf4f3cbbaec49> ;
  triage:openOn <urn:atm:triage:worktree/AD.34/b191e22001cbf7594c2ecefe88ece707f1b51fcf> ;
  triage:fixedOn <urn:atm:triage:worktree/AD.35/bd3ab37a63c97a40b11d7da7e90a6b4f0bb5bdf2> ;
  triage:promoteTo <urn:atm:triage:worktree/AD.35/bd3ab37a63c97a40b11d7da7e90a6b4f0bb5bdf2> .

