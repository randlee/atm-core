<urn:atm:triage:finding/PEEK-MUTATION-001>
  a triage:Finding ;
  triage:findingId "PEEK-MUTATION-001" ;
  triage:title "atm peek mutates read state; AckActivationMode never checked at mutation gate" ;
  triage:description "RESOLVED in followup_pass. Fix originated on AD.31 (commits 032ef476 + 5891c114) and properly propagated/merged-forward to all downstream branches AD.32-35. All five branches contain the defensive gate in displayed_messages_require_mutation (line 890-891): if mutation_mode == DisplayMutationMode::NonMutatingPeek { return false; }. Call path verified: peek_mail_with_runtime → resolve_read_context → load_read_selection → resolve_read_display → displayed_messages_require_mutation(DisplayMutationMode::NonMutatingPeek) → returns false, preventing mutation. This gate structurally closes the vulnerability. No regressions detected."@en ;
  triage:category "PEEK-MUTATION" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:pattern "displayed_messages_require_mutation|peek_mail_with_runtime|resolve_read_context|load_read_selection|build_unmodified_read_display" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/PEEK-MUTATION-001/AD.31/1> ;
