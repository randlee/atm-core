<urn:atm:triage:finding/AD8-BOUNDARY-001>
  a triage:Finding ;
  triage:findingId "AD8-BOUNDARY-001" ;
  triage:title "New sealed GraftPostSendPort boundary trait implemented out-of-owner with zero governance record" ;
  triage:description "A new sealed boundary trait GraftPostSendPort is defined in crates/atm-core/src/boundary/mod.rs and implemented by AdvisoryRuntime in crates/atm-daemon/src/advisory_runtime.rs, with no corresponding boundary TOML declaration and no documentation entry in docs/atm-daemon/boundaries.md or docs/atm-core/boundaries.md. This represents a governance/boundary-declaration gap for a newly introduced cross-crate trait implementation." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
