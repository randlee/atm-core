<urn:atm:triage:finding/AD-DOCGAP-001>
  a triage:Finding ;
  triage:findingId "AD-DOCGAP-001" ;
  triage:title "Authoritative sprint doc + project-plan.md AD.12-AD.20 extension absent from feature branches" ;
  triage:description "docs/plans/phase-AD/sprint-ADxx.md for the sprint in question, and the docs/project-plan.md AD.12-AD.20 extension, are absent from each AD.13-AD.16 feature branch even though both exist on integrate/phase-AD and the AD.12 planning branch. QA-1 policy requires the sprint doc present with status: complete and project-plan.md carrying the sprint entry. Reported identically by quality-mgr on AD13-QA-1 (PR #477, as ATM-QA-001/ARCH-001, blocking), AD14-QA-1 (PR #478), AD15-QA-1 (PR #480, as 'known systemic AD-DOCGAP-001', blocking), and AD16-QA-1 (PR #481, same pattern plus branch's own plan-phase-AD.md frontmatter self-contradictorily saying status: complete)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA-001/ARCH-001" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
