<urn:atm:triage:finding/AD28-RSH-003>
  a triage:Finding ;
  triage:findingId "AD28-RSH-003" ;
  triage:title "Deadline/shutdown path under-instrumented with tracing" ;
  triage:description "In crates/atm-graft/src/runtime.rs, only one tracing call (a debug!) exists anywhere in deadline/shutdown paths. Listener-wake timeouts and accept-loop failures surface only as returned AtmError values with no tracing emitted at the failure point, so operators cannot distinguish clean shutdown / wake-failed-thread-detached / accept-broke from logs alone." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:pattern "missing structured tracing at bounded-deadline failure points" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-08T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD28-RSH-003/s28/1> ;
