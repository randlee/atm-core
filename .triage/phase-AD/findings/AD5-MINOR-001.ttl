<urn:atm:triage:finding/AD5-MINOR-001>
  a triage:Finding ;
  triage:findingId "AD5-MINOR-001" ;
  triage:title "WarningEntry drops AtmError's stable code; undocumented magic-number timeouts in service_runtime.rs" ;
  triage:description "rust-best-practices-agent RBP-F002 -- WarningEntry drops AtmError's stable code on notification/append warning paths (should preserve the stable error code for machine-readability). rust-service-hardening-agent RSH-001/RSH-002 -- two undocumented magic-number timeouts in crates/atm-daemon/src/service_runtime.rs (should be named constants with a comment on why that value was chosen). Found during AD.5-QA-1 on PR #453." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
