<urn:atm:triage:finding/ARCH-AD26-001>
  a triage:Finding ;
  triage:findingId "ARCH-AD26-001" ;
  triage:title "post-send-hook-emitter.toml boundary note names wrong implementer" ;
  triage:description "boundaries/atm-core/post-send-hook-emitter.toml:8 boundary note claims the graft-backed PostSendHookEmitter implementation is allowlisted in atm-graft; the actual implementation (DaemonPostSendHookEmitter) lives in crates/atm-daemon/src/post_send_emitter.rs. Workspace-wide grep confirms no type in atm-graft implements PostSendHookEmitter/GraftPostSendPort. Contradicts sprint AD.26's own deliverable that boundary docs and runtime code describe the same mechanism." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-07-09T16:44:14Z"^^xsd:dateTime ;
