<urn:atm:triage:finding/AD4-DOC-002>
  a triage:Finding ;
  triage:findingId "AD4-DOC-002" ;
  triage:title "docs/atm-daemon/boundaries.md left with stale live-subsystem language after AD.4 deletions" ;
  triage:description "Lines 14-16 still claim runtime test doubles exist for watch/reconcile/notifier lanes (false -- deleted by this sprint). Line 64's 'Planned R.20 partition map' still lists watch_runtime/reconcile_runtime as part of current daemon-private ownership without retired/historical qualifier. Both contradict AD.4's acceptance criterion that docs no longer describe watch/reconcile as accepted production subsystem." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "DOC" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-07-04T19:43:08Z"^^xsd:dateTime ;
  triage:resolutionNote "TTL housekeeping closure: quality-mgr's Phase AD phase-ending review confirmed this finding was already resolved on integrate/phase-AD @ 102026285f45ba8685a8b787379c2769753add0d after the accepted Phase AD sprint and postmortem-fix merge wave. This record remained open only as stale triage metadata." ;
  triage:rationale "Closure headSha records the later integrate/phase-AD verification commit used during the phase-ending review. Child occurrences and worktree snapshots intentionally remain as historical first-observed evidence on earlier branch heads and are not retroactively rewritten unless that exact occurrence was re-verified closed on the same branch snapshot." ;
  triage:triagedAt "2026-07-03T17:35:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD4-DOC-002/s4/1> ;
