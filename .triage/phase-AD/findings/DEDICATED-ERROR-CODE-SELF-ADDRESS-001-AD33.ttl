<urn:atm:triage:finding/DEDICATED-ERROR-CODE-SELF-ADDRESS-001-AD33>
  a triage:Finding ;
  triage:findingId "DEDICATED-ERROR-CODE-SELF-ADDRESS-001-AD33" ;
  triage:title "No dedicated typed error code for self-address rejection" ;
  triage:description "validate_non_self_recipient's rejection uses the generic AtmErrorCode::MessageValidationFailed, shared by 130+ other validation call sites across 35 files, departing from the codebase convention of dedicated codes for distinct failures (team_invalid(), caller_context_request_invalid()). Undocumented in docs/atm-error-codes.md. Sprint doc's deliverable calls for 'one stable typed error contract' -- arguably satisfied loosely (consistent across all entry paths) but not uniquely typed to this failure." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ERROR-CONTRACT" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
