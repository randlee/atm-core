<urn:atm:triage:finding/ATM-QA-101>
  a triage:Finding ;
  triage:findingId "ATM-QA-101" ;
  triage:title "Windows panic-depth test waited for the wrong recovery constant" ;
  triage:description "crates/atm-daemon/src/tests/windows_local_ipc_depth.rs asserted on CONNECTION_WORKER_PANIC_RECOVERED_MESSAGE even though PanicDispatcher panics on the dispatch worker path reaped by reap_finished_dispatches, which emits DISPATCH_PANIC_RECOVERED_MESSAGE. AD30-FIX-2 corrects the assertion to the actual observable code path." ;
  triage:phaseId "phase-AD" ;
  triage:category "QA" ;
  triage:severity "blocking" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T18:20:00Z"^^xsd:dateTime ;
