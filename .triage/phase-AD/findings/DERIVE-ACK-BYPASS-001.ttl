<urn:atm:triage:finding/DERIVE-ACK-BYPASS-001>
  a triage:Finding ;
  triage:findingId "DERIVE-ACK-BYPASS-001" ;
  triage:title "classify_mailbox_metadata_rows reconstructs requires_ack ad hoc instead of using derive_ack_requirement" ;
  triage:description "Ad hoc reimplementation of requires_ack classifier instead of calling canonical derive_ack_requirement. Root cause: MailStoreMailboxMetadataRow carries no durable requires_ack field; metadata-query path structurally cannot call canonical classifier. Currently functionally equivalent by coincidence but no compile-time/test-time guarantee. Future write paths could desync silently. Also risks misclassifying legacy ack-reply rows." ;
  triage:category "DERIVE-ACK-BYPASS" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/DERIVE-ACK-BYPASS-001/AD32/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/DERIVE-ACK-BYPASS-001/AD32/2> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/DERIVE-ACK-BYPASS-001/AD33/1> ;
