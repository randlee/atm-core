<urn:atm:triage:finding/AD22-ARCH-001-README-STALE>
  a triage:Finding ;
  triage:findingId "AD22-ARCH-001-README-STALE" ;
  triage:title "README.md still documents old post_send_hooks path as the standard example" ;
  triage:description "arch-qa found README.md:156 (\"## Post-Send Hook\" section) still documents [[atm.post_send_hooks]] -> scripts/atm-nudge.sh as the example/standard post-send configuration, with no mention that `atm internal-nudge` is the shipped default, and no compatibility-only disclaimer. This directly contradicts this sprint's own \"Paths To Delete\" requirement. docs/architecture.md and plan-phase-AD.md were correctly updated; README.md (the most user-visible entry point) was missed. Related non-blocking finding also confirmed: scripts/atm-nudge.py docstring still claims \"Production .atm.toml post-send wiring routes through scripts/atm-nudge.sh\" -- stale/contradictory, include as a secondary occurrence if found." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "documentation" ;
  triage:severity "blocking" ;
