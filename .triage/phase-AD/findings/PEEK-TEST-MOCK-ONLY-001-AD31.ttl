<urn:atm:triage:finding/PEEK-TEST-MOCK-ONLY-001-AD31>
  a triage:Finding ;
  triage:findingId "PEEK-TEST-MOCK-ONLY-001-AD31" ;
  triage:title "AD.31 peek non-mutation regression test is mock-only, not real-store-backed" ;
  triage:description "AD31-QA-2 (PR #503) req-qa ATM-QA-104, minor, new this round. The sprint doc explicitly requires proving peek 'leaves per-message read, pending_ack_at, and acknowledged_at unchanged' -- the only test uses a RetainedMailboxRuntime invocation-counter double, not a real backing store with reload-and-compare on actual field values. Note: AD35-QA-2 rust-qa-agent separately confirmed AD.35's OWN regression matrix test IS real-store-backed with logical-payload-set proof (not just call counts) -- check whether AD.31 has since received the same real-store-backed test via merge-forward, which would close this finding." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
