<urn:atm:triage:finding/AD18-SOCKLIT-001>
  a triage:Finding ;
  triage:findingId "AD18-SOCKLIT-001" ;
  triage:title "Daemon-singleton lint gate fails -- hardcoded atm-daemon.sock literal in new tests" ;
