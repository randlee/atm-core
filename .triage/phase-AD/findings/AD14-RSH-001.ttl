<urn:atm:triage:finding/AD14-RSH-001>
  a triage:Finding ;
  triage:findingId "AD14-RSH-001" ;
  triage:title "Accept-loop error paths bypass graceful shutdown/drain" ;
  triage:description "crates/atm-daemon/src/local_ipc_transport.rs - run_accept_loop(...)? propagates directly on error; two realistic failure paths (spawn_connection_worker failure under connection-count burst, and poisoned accept_error mutex) skip finalize_serve_loop entirely -- no begin_shutdown, no WAL checkpoint, no bounded drain, no lifecycle transition to Draining/Stopped." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
