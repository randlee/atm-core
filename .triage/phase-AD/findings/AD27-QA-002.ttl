<urn:atm:triage:finding/AD27-QA-002>
  a triage:Finding ;
  triage:findingId "AD27-QA-002" ;
  triage:title "No integration-level test exercises override/disabled state through the live dispatch path" ;
  triage:description "No integration-level test exercises override/disabled state reaching the renderer through the actual live dispatch path (crates/atm-core/src/send/hook.rs / crates/atm-daemon/src/post_send_emitter.rs) -- only through the disconnected internal_nudge.rs helper's own unit tests (which per AD27-ARCH-001 is dead code in production). This directly fails one of sprint AD.27's three named Acceptance Criteria: 'targeted tests prove... reaches the renderer without secondary lookup... on the accepted path.'" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "important" ;
