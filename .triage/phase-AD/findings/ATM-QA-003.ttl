<urn:atm:triage:finding/ATM-QA-003>
  a triage:Finding ;
  triage:findingId "ATM-QA-003" ;
  triage:title "collect_scb_observability_rule_violations regression breaks 18 pre-existing boundary lint tests" ;
  triage:description ".just/lint_boundaries.py:592-596 collect_boundary_violations() now unconditionally calls collect_scb_observability_rule_violations, which raises SystemExit if .just/allowlists/scb_observability_allowlist.toml is missing. New SCB-observability tests in .just/tests/test_lint_boundaries.py:447-451 provision that file via a dedicated helper, but 18 pre-existing tests using the shared fixture builder do not. Regression from 30/30 passing at parent commit 2c7b3c1a to 18/30 erroring at 4dbd5ba8. Confirmed independently by req-qa and rust-qa-agent; matches CI's Just lint (pytests gate) failure on all 3 platforms." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "repo_wide" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-08T22:05:00Z"^^xsd:dateTime ;
