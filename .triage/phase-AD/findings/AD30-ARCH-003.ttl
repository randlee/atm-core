<urn:atm:triage:finding/AD30-ARCH-003>
  a triage:Finding ;
  triage:findingId "AD30-ARCH-003" ;
  triage:title "sprint-AD30.md declares WindowsLocalIpcDepthCase enum that doesn't exist (doc/code naming gap, dedup)" ;
  triage:description "docs/plans/phase-AD/sprint-AD30.md:46 declares pub enum WindowsLocalIpcDepthCase with three variants as the accepted interface; this type does not exist anywhere in the workspace. Unlike AD29-ARCH-001 (undelivered interface), the underlying behavior IS genuinely implemented via three real, deterministic, #[cfg(windows)]-gated, CI-wired tests in s30 matching the three variants' semantics. This is a doc/code naming-fidelity gap (dedup issue), not an unimplemented-interface gap. Scored Important per both reviewers' converging assessment." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
