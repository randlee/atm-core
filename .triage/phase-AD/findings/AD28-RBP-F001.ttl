<urn:atm:triage:finding/AD28-RBP-F001>
  a triage:Finding ;
  triage:findingId "AD28-RBP-F001" ;
  triage:title "GraftNudgeSink::deliver silently discards read_snapshot errors" ;
  triage:description "In crates/atm-graft/src/nudge_sink.rs:19,25, GraftNudgeSink::deliver silently discards read_snapshot errors on both the success and failure paths (if let Ok(snapshot) = ... with no else). A poisoned snapshot lock produces zero diagnostic output -- neither the nudge_delivered nor session_error observability calls fire, and nothing is logged." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "important" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-08T19:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD28-RBP-F001/pAD-s28/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD28-RBP-F001/pAD-s28/2> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s28/835a6247> ;
  triage:promoteTo <urn:atm:triage:worktree/pAD-s28/835a6247> .

