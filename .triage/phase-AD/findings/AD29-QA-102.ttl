<urn:atm:triage:finding/AD29-QA-102>
  a triage:Finding ;
  triage:findingId "AD29-QA-102" ;
  triage:title "Orphaned ad-hoc smoke script violates sprint's own deletion requirement" ;
  triage:description "scripts/smoke/run_thorough_graft.py:1-68 tests only the graft dispatcher's success/warning path (3 narrow cases) and was never deleted or folded into the new authoritative 5-case matrix. It is not referenced by run.py, run_thorough.py, justfile, or CI. Sprint-AD29's own \"Paths To Delete\" section names exactly this class of ad-hoc single-path smoke check for removal. Directly contradicts the \"one authoritative smoke matrix\" deliverable claim." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "finding" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
