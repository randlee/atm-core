<urn:atm:triage:finding/ATM-QA-002>
  a triage:Finding ;
  triage:findingId "ATM-QA-002" ;
  triage:title "Test fixture uses raw production identity literals" ;
  triage:description "New test fixture base_event() in crates/atm-core/src/send/nudge_template.rs uses AgentName::from_validated(\"team-lead\"), TeamName::from_validated(\"atm-dev\") (x2), and rendered string \"team-lead@atm-dev\". Trips the identities lint gate (RULE-008/RULE-009). Standing convention: use non-production test identities like \"test-sender\"/\"test-team\" instead." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
