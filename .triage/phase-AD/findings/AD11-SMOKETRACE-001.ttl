<urn:atm:triage:finding/AD11-SMOKETRACE-001>
  a triage:Finding ;
  triage:findingId "AD11-SMOKETRACE-001" ;
  triage:title "smoke report tables lack per-command traceability naming" ;
  triage:description "reports/smoke/smoke.md and reports/smoke/smoke-thorough.md use scenario IDs (AD11-ENV-001, AD11-DOCTOR-001, etc.) rather than literally enumerating all 12 retained ATM commands (send/read/ack/list/clear/log/members/teams/teams add-member/teams update-member/teams backup/teams restore) as individually named rows. Functional coverage appears present; traceability naming is the gap." ;
  triage:category "ATM-QA" ;
  triage:severity "minor" ;
