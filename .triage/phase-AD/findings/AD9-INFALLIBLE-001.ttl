<urn:atm:triage:finding/AD9-INFALLIBLE-001>
  a triage:Finding ;
  triage:findingId "AD9-INFALLIBLE-001" ;
  triage:title "build_member_add_roster_record returns infallible Result<RosterEntry, AtmError>" ;
  triage:description "build_member_add_roster_record returns Result<RosterEntry, AtmError> despite never actually returning an Err variant on any code path -- an infallible-result code smell per Rust best practices (RBP-F002)." ;
