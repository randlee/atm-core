<urn:atm:triage:finding/FTQ-001>
  a triage:Finding ;
  triage:findingId "FTQ-001" ;
  triage:title "caller_context.rs private EnvGuard does not share lock with unguarded ambient-env tests" ;
  triage:description "EnvGuard in caller_context.rs uses a private lock via #[serial(env)] only within that module, but parallel tests in send.rs/ack.rs/list.rs/read.rs that also read ATM_IDENTITY/ATM_TEAM can race. Detected during AD.1-QA-1 flaky test analysis on PR #449." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm/src/commands/" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-03T00:00:00Z"^^xsd:dateTime ;
