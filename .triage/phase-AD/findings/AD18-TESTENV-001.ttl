  a triage:Occurrence ;
  triage:file "crates/atm-daemon/src/tests.rs" ;
  triage:line 528 ;
  triage:snippet "fn local_ipc_runtime_round_trips_send_after_add_member_roster_state()" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "feature/pAD-s18-raw-cli-runtime-root-unification" ;
  triage:headSha "0c8b7d5b" ;
  triage:occursIn <urn:atm:triage:worktree/s18/0c8b7d5b> .

