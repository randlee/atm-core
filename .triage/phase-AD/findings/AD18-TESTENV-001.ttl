@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AD18-TESTENV-001>
  a triage:Finding ;
  triage:findingId "AD18-TESTENV-001" ;
  triage:title "Test failure possibly environmental -- live host daemon lock collision" ;
  triage:description "rust-qa-agent QA-004: local_ipc_runtime_round_trips_send_after_add_member_roster_state panicked locally due to contending for a real, live running atm-daemon's owner.lock instead of a tempdir-scoped isolated one -- flagged as likely environmental but needs a clean-environment re-run to confirm whether this is a genuine test-isolation gap (related in root cause to AD18-RSH-001/AD18-RSH-002's atm_home() isolation issues, and to the FTQ-003 host_ownership.rs isolation defect already diagnosed on AD.17/PR #482)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:severity "Important" ;
  triage:category "AD18" ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
  triage:relatedFinding "FTQ-003" ;
  triage:rootCauseNote "Test calls PreparedRuntimeServer::bind_with_observability() which invokes HostOwnershipAdapter::acquire() using host_runtime_lock_path(). This resolves to real ~/.atm/daemon/owner.lock instead of tempdir-scoped atm_home created at line 530. If a live atm-daemon is running or parallel tests contend for the same lock, acquire() fails. Same root cause as FTQ-003 documented in PR #482 Windows CI diagnosis." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD18-TESTENV-001/s18/1> ;
  triage:openOn <urn:atm:triage:worktree/s18/0c8b7d5b> ;
  triage:promoteTo <urn:atm:triage:worktree/s18/0c8b7d5b> .

