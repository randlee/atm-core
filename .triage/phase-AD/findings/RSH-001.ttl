<urn:atm:triage:finding/RSH-001>
  a triage:Finding ;
  triage:findingId "RSH-001" ;
  triage:title "self-addressed-send rejection uses case-sensitive comparison, could miss collisions on case-insensitive filesystems" ;
  triage:description "The new validate_non_self_recipient check (AD.33) compares team-member identifiers case-sensitively. On case-insensitive filesystems (macOS default, Windows), two identifiers differing only by case could still resolve to the same mailbox on disk, bypassing the self-address rejection." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T20:30:00Z"^^xsd:dateTime ;
