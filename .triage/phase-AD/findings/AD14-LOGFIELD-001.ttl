<urn:atm:triage:finding/AD14-LOGFIELD-001>
  a triage:Finding ;
  triage:findingId "AD14-LOGFIELD-001" ;
  triage:title "Structured-logging gate gaps in tracing::warn! calls (RSH-003/004/005)" ;
  triage:description "Several tracing::warn! calls in advisory_runtime.rs, local_ipc_transport.rs, and runtime_health.rs touched by AD.14 omit the mandated subsystem=/action=/outcome= fields required by the ATM-daemon logging advisory, inconsistent with compliant calls elsewhere in the same files. Reported on AD14-QA-1 (PR #478) as three findings (RSH-003/004/005), consolidated here as one repeatable pattern. Note advisory_runtime.rs was deleted entirely in AD.15 (PR #480), so any occurrence in that file is now moot; check local_ipc_transport.rs and runtime_health.rs for remaining occurrences." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD14-LOGFIELD-001/pAD-s14/advisory_runtime/1> ;
