<urn:atm:triage:finding/AD16-RBP-F001>
  a triage:Finding ;
  triage:findingId "AD16-RBP-F001" ;
  triage:title "Misleading error-code reuse for non-daemon failures" ;
  triage:description "crates/atm-graft/src/runtime.rs and lib.rs construct distinct non-daemon-connectivity failure modes (lock poisoning, thread panic, spawn failure, join timeout, join-channel disconnect, missing-message-id contract violations) via AtmError::daemon_unavailable(...), hard-coding a misleading 'ensure daemon is reachable' recovery hint. Existing AtmErrorCode::InternalError/WaitTimeout codes are unused." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD16-RBP-F001/pAD-s14/1> ;
