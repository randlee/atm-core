<urn:atm:triage:finding/AD-LEGACY-CWD-001>
  a triage:Finding ;
  triage:findingId "AD-LEGACY-CWD-001" ;
  triage:title "Live pre-AD 'cwd' compatibility-read bridge (LEGACY_CWD_METADATA_KEY / compatible_home_dir) scheduled for removal" ;
  triage:description "Discovered during the Phase-AD phase-ending review's follow-up 'legacy message key' investigation. crates/atm-core/src/schema/agent_member.rs defines LEGACY_CWD_METADATA_KEY (const 'cwd', already #[deprecated(note = \"Phase AD obsolete: derived compatibility field only\")]) and compatible_home_dir() (already #[allow(deprecated, reason = \"Phase AD obsolete: bounded fallback remains only to read pre-AD compatibility metadata.\")]). Both are self-labeled as a temporary bridge, but remain live: called from crates/atm-core/src/send/hook.rs:601 and crates/atm-core/src/team_admin/projection.rs:8,126,157 (which also strips the key from projected metadata), plus test usages in send/hook.rs:877,1094,1118. Repo owner explicitly directed that this be removed in the next cleanup pass; recorded here so it is tracked rather than forgotten." ;
  triage:category "cleanup/dead-code-scheduled" ;
  triage:phaseId "phase-AD" ;
  triage:severity "minor" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-04T00:00:00Z"^^xsd:dateTime ;
