<urn:atm:triage:finding/AD29-ARCH-001>
  a triage:Finding ;
  triage:findingId "AD29-ARCH-001" ;
  triage:title "Sprint doc declares undelivered Rust enum interface (dedup of req-qa's AD29-QA-103)" ;
  triage:description "docs/plans/phase-AD/sprint-AD29.md:47-55 declares a Rust enum PhaseAdPostSendSmokeCase with five variants as the authoritative interface. This type does not exist anywhere in crates/ -- only in doc text. The five cases are implemented purely as Python SuiteRowSpec string-id rows in scripts/smoke/run.py:11 and scripts/smoke/run_thorough.py:9, backed by cargo test --exact invocations. Same class of doc/code mismatch as AD27-ARCH-001 (declared interface never implemented). Independently confirmed by both arch-qa (Blocking, RULE-013) and req-qa (Important) -- dedup and scored Blocking per arch-qa's architectural-fitness framing." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
