<urn:atm:triage:finding/AD11-PANIC-001>
  a triage:Finding ;
  triage:findingId "AD11-PANIC-001" ;
  triage:title "agent_member_from_roster_record panics on blank/invalid persisted agentId" ;
  triage:description "AgentId::new(...).expect() on metadata_json values loaded from persisted roster records. Persisted data can be hand-edited, corrupted, or from older schemas, causing panics instead of safe fallback or structured error." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-core/src/team_admin.rs" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-07-04T19:43:08Z"^^xsd:dateTime ;
  triage:resolutionNote "TTL housekeeping closure: quality-mgr's Phase AD phase-ending review confirmed this finding was already resolved on integrate/phase-AD @ 102026285f45ba8685a8b787379c2769753add0d after the accepted Phase AD sprint and postmortem-fix merge wave. This record remained open only as stale triage metadata." ;
  triage:rationale "Closure headSha records the later integrate/phase-AD verification commit used during the phase-ending review. Child occurrences and worktree snapshots intentionally remain as historical first-observed evidence on earlier branch heads and are not retroactively rewritten unless that exact occurrence was re-verified closed on the same branch snapshot." ;
