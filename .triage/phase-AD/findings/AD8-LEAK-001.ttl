@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AD8-LEAK-001>
  a triage:Finding ;
  triage:findingId "AD8-LEAK-001" ;
  triage:title "register_graft_session() leaks an advisory-session slot on batch-limit validation failure (critical, RSH-001)" ;
  triage:description "attempt_receive_loop_reregistration() in crates/atm-graft/src/runtime.rs registers a session slot with the daemon BEFORE validating the batch limit, and performs no cleanup if that validation subsequently fails — meaning every failed validation permanently leaks one advisory-session slot, a resource-exhaustion risk under repeated failure." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm-graft/src/runtime.rs, crates/atm-daemon/src/advisory_runtime.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:category "AD8" ;
  triage:severity "blocking" ;
  triage:triagedAt "2026-07-03T00:00:00Z" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD8-LEAK-001/s1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD8-LEAK-001/s2/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD8-LEAK-001/s3/1> ;
