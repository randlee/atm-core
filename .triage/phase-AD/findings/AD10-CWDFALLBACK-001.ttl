<urn:atm:triage:finding/AD10-CWDFALLBACK-001>
  a triage:Finding ;
  triage:findingId "AD10-CWDFALLBACK-001" ;
  triage:title "Unmarked legacy 'cwd' compatibility fallback still live in sender_config_root(), contradicting sprint's own obsolescence instructions" ;
  triage:description "AD.10-QA-1 verdict (blocking, ARCH-AD10-001, PR #458) reports crates/atm-core/src/send/hook.rs sender_config_root() still contains a legacy 'cwd' compatibility fallback path that AD.10's own obsolescence instructions required removing or marking obsolete. Both arch-qa (blocking) and rust-qa-agent (important) flagged this as a violation of sprint AD.10's own documented requirements. According to sprint-AD10.md (line 73), any compatibility field must be marked 'Phase AD obsolete: derived compatibility field only', but this fallback bears no such marking." ;
  triage:category "AD10" ;
  triage:phaseId "phase-AD" ;
  triage:severity "blocking" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-07-04T19:43:08Z"^^xsd:dateTime ;
  triage:resolutionNote "TTL housekeeping closure: quality-mgr's Phase AD phase-ending review confirmed this finding was already resolved on integrate/phase-AD @ 102026285f45ba8685a8b787379c2769753add0d after the accepted Phase AD sprint and postmortem-fix merge wave. This record remained open only as stale triage metadata." ;
  triage:triagedAt "2026-07-03T00:00:00Z"^^xsd:dateTime ;
