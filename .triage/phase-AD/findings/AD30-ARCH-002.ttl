<urn:atm:triage:finding/AD30-ARCH-002>
  a triage:Finding ;
  triage:findingId "AD30-ARCH-002" ;
  triage:title "PanicDispatcher forked into duplicate Windows/Unix test modules (RULE-005)" ;
  triage:description "PanicDispatcher (and its trait impls) is defined twice -- once under #[cfg(unix)] in crates/atm-daemon/src/local_ipc_transport.rs:1050, again under #[cfg(windows)] in the new crates/atm-daemon/src/tests/windows_local_ipc_depth.rs:24. The three new Windows tests are near-line-for-line forks of the existing Unix-only tests rather than one consolidated cross-platform suite. This directly contradicts the sprint's own \"Paths To Delete\" directive (which called for removing the cfg(unix) gating, not forking a parallel Windows copy) and repeats the phase's known duplicate-logic pattern (cf. AD27-DUPLOGIC-001)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "single_file" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-07-09T19:54:30Z"^^xsd:dateTime ;
  triage:resolutionNote "AD30-FIX-5 closes the duplicate-logic fork by consolidating the three local-IPC depth scenarios into crates/atm-daemon/src/tests/local_ipc_depth.rs, removing the Unix-only copies from crates/atm-daemon/src/local_ipc_transport.rs, and reusing the single shared PanicDispatcher from crates/atm-daemon/src/test_support.rs." ;
  triage:rationale "The worktree snapshot references remain as first-observed evidence on the early AD.30 branch head. Closure is tracked on the finding itself because the duplicated occurrences were eliminated on a later reviewed commit rather than on the original 4d86e024 snapshot." ;
  triage:triagedAt "2026-07-09T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD30-ARCH-002/s30/1> ;
  triage:openOn <urn:atm:triage:worktree/s30/4d86e024> ;
  triage:promoteTo <urn:atm:triage:worktree/s30/4d86e024> .

