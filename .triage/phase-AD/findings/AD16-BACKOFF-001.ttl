<urn:atm:triage:finding/AD16-BACKOFF-001>
  a triage:Finding ;
  triage:findingId "AD16-BACKOFF-001" ;
  triage:title "No backoff on sustained Degraded polling state" ;
  triage:description "rust-service-hardening-agent flagged that the atm-graft polling loop continues at a fixed interval indefinitely while in a sustained Degraded health state, with no backoff/escalation. The run_receive_loop function polls with a fixed interval and immediately re-polls at the same rate after entering Degraded state; no exponential backoff or escalation mechanism exists." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RSH" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD16-BACKOFF-001/pAD-s16/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD16-BACKOFF-001/pAD-s17/1> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s16/c4653158> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s17/0996fd33> ;
  triage:promoteTo <urn:atm:triage:worktree/pAD-s17/0996fd33> ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime .

<urn:atm:triage:occurrence/AD16-BACKOFF-001/pAD-s16/1>
  a triage:Occurrence ;
  triage:file "crates/atm-graft/src/runtime.rs" ;
  triage:line 143 ;
  triage:snippet "loop { match ctx.stop_rx.recv_timeout(ctx.options.poll_interval()) ... Err(error) => set_session_state(...Degraded...) }" ;
  triage:status "open" ;
  triage:closed false ;
