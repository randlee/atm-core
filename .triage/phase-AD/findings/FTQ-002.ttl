<urn:atm:triage:finding/FTQ-002>
  a triage:Finding ;
  triage:findingId "FTQ-002" ;
  triage:title "flaky-test-qa: second angle on env-guard race in caller_context tests" ;
  triage:description "flaky-test-qa's second critical finding on the same env-guard race as FTQ-001, viewed from a different angle during AD.1-QA-1 on PR #449 -- same root cause (private EnvGuard in caller_context.rs not sharing env_lock() with other test modules that read ATM_IDENTITY/ATM_TEAM directly)." ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-03T00:00:00Z"^^xsd:dateTime ;
  triage:correctionNote "prior record incorrectly claimed AD.4 removed the private EnvGuard; direct verification (grep across AD.1/AD.4/AD.11 worktrees, plus git show 729cdeab --stat) confirms it is unchanged and still present on all 11 branches; scope also corrected from 6 files down to 3 (caller_context.rs, members.rs, log.rs)" ;
  triage:highestOpenBranch "feature/pAD-s11-smoke-and-readiness-closeout" ;
  triage:promoteTo <urn:atm:triage:worktree/AD.11/d709cb73> ;
