<urn:atm:triage:finding/AD5-OBS-002>
  a triage:Finding ;
  triage:findingId "AD5-OBS-002" ;
  triage:title "dead no-op error-handling/rollback remnants left after notification-worker lane deletion" ;
  triage:description "crates/atm-daemon/src/composition.rs:478-484 -- start_background_lanes/shutdown_background_lanes are now bare Ok(()) no-ops with zero possible error path, a direct remnant of the notification-worker lane deletion in this sprint. Surrounding call sites (begin_shutdown:266-278, begin_startup:284-293, prepare_runtime_with rollback at 323-341) still carry dead error-handling/rollback logic built around an error that can never occur." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "OBS" ;
  triage:severity "important" ;
  triage:repeatable true ;
