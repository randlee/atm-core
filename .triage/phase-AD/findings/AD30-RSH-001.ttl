<urn:atm:triage:finding/AD30-RSH-001>
  a triage:Finding ;
  triage:findingId "AD30-RSH-001" ;
  triage:title "Windows fallback read-helper thread not tracked in ActiveConnectionRegistry" ;
  triage:description "On the Windows fallback path (when the pipe stream doesn't support set_recv_timeout), read_request_frame_with_helper spawns a detached, untracked \"local-ipc-read-helper\" thread that isn't registered with ActiveConnectionRegistry, doesn't participate in drain_active_connections_for_shutdown, and isn't bounded against MAX_CONCURRENT_CONNECTIONS. A stalled/slow client on this platform path leaks one thread+handle indefinitely per connection." ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T01:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD30-RSH-001/s25/1> ;
