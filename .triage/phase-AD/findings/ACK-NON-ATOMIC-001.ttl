<urn:atm:triage:finding/ACK-NON-ATOMIC-001>
  a triage:Finding ;
  triage:findingId "ACK-NON-ATOMIC-001" ;
  triage:title "ack path's source-message check-then-write is not atomic/lock-protected; concurrent atm ack calls can double-fire" ;
  triage:description "Existing record (RSH-002 on AD.32) reports the ack path's check-then-write on the source message is not atomic/lock-protected. load_ack_source/ensure_ack_is_pending run unlocked, and the source-message persist_message_state write (crates/atm-core/src/ack/mod.rs) is issued outside the commit_workflow_state lock used for reply persistence. Two concurrent atm ack calls on the same message could both pass validation and both create ack-reply messages. Re-sweep AD34-QA-2 (PR #506) and AD35-QA-2 (PR #507) confirms persist_ack_reply (ack/mod.rs) still calls runtime.persist_message_state directly outside any locked commit_workflow_state path, unaddressed by AD.34's extensive ack/mod.rs refactor." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:category "ACK" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-10T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ACK-NON-ATOMIC-001/AD31/1> ;
