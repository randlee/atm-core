@prefix triage: <urn:atm:triage:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:atm:triage:finding/AD5-SEND-001>
  a triage:Finding ;
  triage:findingId "AD5-SEND-001" ;
  triage:title "send::tests assertion-count-mismatch failures on PR #453 (HOME env-var race across test_support.rs and home.rs)" ;
  triage:description "PR #453 (AD.5-QA-1) CI failures exhibit test assertion count mismatches in send module (ubuntu line 666: left=3 right=2; windows line 818: left=2 right=1). Root cause initially attributed (informally by team-lead during AD.5-QA-1) to 'notification-runtime removal changed assertion counts'. AD.8-QA-1 verdict re-analyzed and identified real cause: unsynchronized environment-variable mutation mutexes between test_support.rs (public env_lock at lines 20-23) and home.rs (local env_lock at lines 250-253 in test module). Both provide OnceLock-based static LOCK variables that independently serialize environment mutations. When tests run in parallel (cargo test without --test-threads=1), test_support.rs::EnvGuard sets HOME via one lock while home.rs tests or code paths attempt HOME mutations via a different, uncoordinated lock, creating a TOCTOU race. This causes HOME env var resolution to return inconsistent paths, leading to notifications being written to or read from wrong directories, resulting in unexpected event counts." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:category "FTQ" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:readinessBlocking true ;
  triage:readinessBlockingBranch "feature/pAD-s11-smoke-and-readiness-closeout" ;
  triage:qa1Evidence "AD.11-QA-1: cargo test --workspace fails deterministically with env_lock race (rust-qa-agent verified); blocks phase readiness claim" ;
  triage:triagedAt "2026-07-03T20:15:00Z"^^xsd:dateTime ;
  triage:rootCauseVerified true ;
  triage:rootCauseExplanation "Two independent static OnceLock<Mutex<()>> variables with the same function name (env_lock) in different modules (test_support.rs and home.rs test module) provide NO actual synchronization across modules. When parallel tests execute: (1) test_support.rs::EnvGuard::set_many([('HOME', ...)]) acquires test_support.rs's LOCK and mutates HOME; (2) concurrent code in home.rs or other modules reads HOME but may use home.rs's separate LOCK if calling into home.rs test helpers; (3) no global synchronization means both code paths run concurrently, creating classic TOCTOU race on the HOME env var. Result: HOME path resolution becomes non-deterministic, file I/O operations target wrong directories, notification event counts diverge from test expectations. Pattern parallels FTQ-001/002/003 env-lock races (in caller_context.rs), but distinct root location and failure signature (send module assertion counts vs caller_context direct lock contention)." ;
  triage:distinguishedFromFtq "AD5-SEND-001 is distinct from FTQ-001/002/003. FTQ findings address private EnvGuard in caller_context.rs; AD5-SEND-001 addresses separate env_lock in home.rs test module. Both are env-lock coordination defects but in different code locations. FTQ-001 correctionNote explicitly notes PR #453 failures are 'NOT THE ENVGUARD RACE' and require separate investigation; AD5-SEND-001 is that separate investigation." ;
  triage:affectedTestFiles "send::tests (send/tests.rs lines 666 and 818)" ;
  triage:pr453FailureSignatureUbuntu "send::tests::send_non_claude_sqlite_failure_delivers_original_and_error_via_outbound_boundary line 666: assertion left=3 right=2 (expected 2 notification events, found 3)" ;
  triage:pr453FailureSignatureWindows "send::tests::send_claude_success_appends_original_via_compat_inbox_writer line 818: assertion left=2 right=1 (expected 1 notification event, found 2)" ;
  triage:pr453FailureMechanism "Both failures are notification event count mismatches, consistent with HOME env-var race causing I/O to divergent directories: extra notification events from previous test runs leak into current test's temp home directory, or expected events written to wrong location entirely." ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD5-SEND-001/AD1/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD5-SEND-001/AD2/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD5-SEND-001/AD3/1> ;
