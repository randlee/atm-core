<urn:atm:triage:finding/AD2-RBP-001>
  a triage:Finding ;
  triage:findingId "AD2-RBP-001" ;
  triage:title "doctor health-check builds diagnostic identity values via unvalidated from_validated escape hatch" ;
  triage:description "crates/atm-core/src/doctor/health.rs:30 -- environment_visibility builds diagnostic TeamName/AgentName values via the unvalidated from_validated escape hatch directly on raw ATM_TEAM/ATM_IDENTITY env values instead of the validating FromStr parse path used elsewhere (config/mod.rs). Silently accepts invariant-violating input for diagnostic display." ;
  triage:phaseId "phase-AD" ;
  triage:category "RBP" ;
  triage:severity "important" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
