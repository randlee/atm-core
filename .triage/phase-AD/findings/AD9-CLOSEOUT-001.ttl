<urn:atm:triage:finding/AD9-CLOSEOUT-001>
  a triage:Finding ;
  triage:findingId "AD9-CLOSEOUT-001" ;
  triage:title "No .atm.toml pane-routing-truth helper found to mark obsolete -- ambiguous closeout status" ;
  triage:description "Sprint AD9 requires any helper treating .atm.toml as pane-routing truth to be marked 'Phase AD obsolete: pane truth lives in SQLite roster state'. The atm-nudge.py script is identified as the primary .atm.toml pane-routing helper (reads [[rmux.windows.panes]] from .atm.toml and uses those pane IDs for recipient nudging). AD.11 claimed this was fixed by adding an obsolescence comment, but QA re-verification found it REGRESSED: scripts/atm-nudge.py remains wired live in .atm.toml post_send_hooks for arch-ctm/quality-mgr/team-lead, and main() still calls read_pane_from_toml() as the primary path. The helper was never actually removed from production wiring, contradicting AD.9's acceptance criterion and AD.11's claimed closure." ;
  triage:triageMode "followup_pass" ;
  triage:category "closeout" ;
  triage:phaseId "phase-AD" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "docs/plans/phase-AD/sprint-AD9.md obsolescence-instructions section, scripts/atm-nudge.py, atm-nudge.py across all phase-AD branches, .atm.toml post_send_hooks configuration" ;
  triage:status "regressed" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-03T21:45:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD9-CLOSEOUT-001/s1/1> ;
