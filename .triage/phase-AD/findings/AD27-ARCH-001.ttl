<urn:atm:triage:finding/AD27-ARCH-001>
  a triage:Finding ;
  triage:findingId "AD27-ARCH-001" ;
  triage:title "Sprint AD.27 premise does not describe the live production dispatch path" ;
  triage:description "This sprint's entire premise (moving built-in template resolution upstream of `atm internal-nudge` via a resolved ATM_INTERNAL_NUDGE envelope) does not describe the live production path. crates/atm-core/src/send/hook.rs's build_built_in_dispatch performs override lookup, template resolution, AND full placeholder rendering in-process, handing an already-rendered LocalTmuxNudgeTarget directly to PostSendHookEmitter::emit_post_send. crates/atm-daemon/src/post_send_emitter.rs's DaemonPostSendHookEmitter::emit_post_send delivers via deliver_tmux_nudge directly in-process -- it never constructs an InternalNudgeEnvelope, never sets ATM_INTERNAL_NUDGE, and never subprocess-hands-off to `atm internal-nudge` at all. ATM_INTERNAL_NUDGE appears nowhere else in the workspace outside internal_nudge.rs itself -- the retained helper (crates/atm/src/commands/internal_nudge.rs) is unreachable dead code in production. Despite this, 5+ doc locations edited in this sprint assert the subprocess-handoff-through-resolved-envelope mechanism as the live shipped path." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD27-ARCH-001/s27/1> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s27/33683226> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s28/2e7b5d2e> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s29/f7a4991f> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s30/5c19cba9> ;
  triage:promoteTo <urn:atm:triage:worktree/pAD-s30/5c19cba9> ;
  triage:highestOpenBranch "pAD-s30" ;
  triage:highestOpenBranchPath "/Users/randlee/Documents/github/atm-core-worktrees/feature/pAD-s30-windows-daemon-integration-depth" ;
  triage:highestOpenBranchSha "5c19cba9" .

