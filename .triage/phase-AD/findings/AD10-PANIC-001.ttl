<urn:atm:triage:finding/AD10-PANIC-001>
  a triage:Finding ;
  triage:findingId "AD10-PANIC-001" ;
  triage:title "AgentId::new().expect() panic risk on unvalidated roster metadata" ;
  triage:description "AgentId::new() is called on roster metadata that is not validated beforehand, creating a panic risk if the roster contains malformed agent id data (e.g. from a corrupted or hand-edited SQLite roster row)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
  triage:closedAt "2026-07-04T19:43:08Z"^^xsd:dateTime ;
  triage:resolutionNote "TTL housekeeping closure: quality-mgr's Phase AD phase-ending review confirmed this finding was already resolved on integrate/phase-AD @ 102026285f45ba8685a8b787379c2769753add0d after the accepted Phase AD sprint and postmortem-fix merge wave. This record remained open only as stale triage metadata." ;
  triage:triagedAt "2026-07-03T19:30:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD10-PANIC-001/pAD-s1/1> ;
