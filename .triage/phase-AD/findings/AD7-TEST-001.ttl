<urn:atm:triage:finding/AD7-TEST-001>
  a triage:Finding ;
  triage:findingId "AD7-TEST-001" ;
  triage:title "local_tmux_post_send gate untested end-to-end" ;
  triage:description "AD.7-QA-1 verdict (PR #455) reports the local_tmux_post_send gate (core deliverable of sprint AD.7 per docs/plans/phase-AD/sprint-AD7.md) lacks true end-to-end integration test coverage. Current unit tests exercise the emitter in isolation via a tmux shim, but do not verify the full flow: message send -> persistence -> post-send hook dispatch -> local_tmux_post_send gate emission -> tmux subprocess interaction." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:category "AD7-TEST" ;
  triage:severity "important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-03T17:40:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD7-TEST-001/S10/1> ;
  triage:openOn <urn:atm:triage:worktree/S10/88941b99> ;
  triage:promoteTo <urn:atm:triage:worktree/S10/88941b99> ;
  triage:notes "Sweep found LocalTmuxPostSendEmitter present in S7-S10 with unit-level tests but absent by S11/integrate. Feature removed post-S10, suggesting intentional refactoring. Highest open branch is S10 (feature last exists); S11+ feature removal resolves the occurrence but closes the opportunity for E2E test. Promote to S10 to add proper integration test coverage before feature refactoring in S11." .

