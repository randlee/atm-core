<urn:atm:triage:finding/AD-ADVISORY-RELOCATE-001>
  a triage:Finding ;
  triage:findingId "AD-ADVISORY-RELOCATE-001" ;
  triage:title "Graft Boundary Surface Not Deleted Per AD.12" ;
  triage:description "Sprint AD.14 was supposed to delete the graft-only advisory session/stream protocol surface (AdvisorySessionPort, AdvisorySession/SessionState, AdvisorySessionRegistration/Unregistration, AdvisoryFetch/Drain/Stream Request/Response, dispatch_advisory_stream) from the shared atm-core/atm-daemon-client boundary per AD.12's ratified unary-only RequestDispatcher/AtmGraftClient interfaces. Instead, the surface was relocated verbatim into crates/atm-daemon-client/src/graft_rpc.rs and crates/atm-daemon/src/advisory_runtime.rs + graft_dispatch.rs, with boundary documentation re-ratified as permanent architecture without ADR." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ATQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-05T00:00:00Z"^^xsd:dateTime ;
