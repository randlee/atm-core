<urn:atm:triage:finding/AD-ADVISORY-RELOCATE-001>
  a triage:Finding ;
  triage:findingId "AD-ADVISORY-RELOCATE-001" ;
  triage:title "Graft Boundary Surface Not Deleted Per AD.12" ;
  triage:description "Sprint AD.14 relocated the graft-only advisory session/stream protocol surface (AdvisorySessionPort, AdvisorySession/SessionState, AdvisorySessionRegistration/Unregistration, AdvisoryFetch/Drain/Stream Request/Response, dispatch_advisory_stream) into crates/atm-daemon-client/src/graft_rpc.rs and crates/atm-daemon/src/advisory_runtime.rs + graft_dispatch.rs. Per AD.12's ratified unary-only RequestDispatcher/AtmGraftClient interfaces, this surface must be deleted entirely from the boundary. Sprint AD.15 deleted advisory_runtime.rs and graft_dispatch.rs but left graft_rpc.rs, leaving the relocation incomplete." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:category "ATQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD-ADVISORY-RELOCATE-001/AD14/1> ;
