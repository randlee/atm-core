<urn:atm:triage:finding/AD4-OBS-001>
  a triage:Finding ;
  triage:findingId "AD4-OBS-001" ;
  triage:title "retained dead reconcile/watch protocol DTOs missing sprint's own required obsolescence marker" ;
  triage:description "crates/atm-core/src/protocol.rs:744-880 -- sprint AD.4's own Obsolescence Instructions require any retained reconcile/watch DTO that cannot be deleted immediately to be marked `Phase AD obsolete: historical reconcile/watch only`. The retained WatchSubscriptionRequest, WatchEventBatch, ReconcileRequest, ReconcileResult structs and NotificationKind::ReconcileComplete variant have zero construction/call sites workspace-wide (confirmed by 3 independent reviewers) but carry no obsolescence marker -- unlike DaemonInboxIngress in crates/atm-daemon/src/boundary_adapters.rs:88-93, which correctly carries #[deprecated(note = \"Phase AD obsolete: ...\")]." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "OBS" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/protocol.rs:744-880" ;
  triage:severity "important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-03T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD4-OBS-001/pAD-s4/1> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s4> ;
  triage:promoteTo <urn:atm:triage:worktree/pAD-s4> .

