<urn:atm:triage:finding/ATM-QA-001-CLAP-LONG>
  a triage:Finding ;
  triage:findingId "ATM-QA-001-CLAP-LONG" ;
  triage:title "SetNudgeTemplateCommand/DisableNudgeTemplateCommand/ClearNudgeTemplateCommand missing #[arg(long)] on team/kind fields" ;
  triage:description "AD25-QA-2 verdict (req-qa) found crates/atm/src/commands/teams.rs declares SetNudgeTemplateCommand, DisableNudgeTemplateCommand (s25 only), and ClearNudgeTemplateCommand (s25 only) with team and kind as String fields without #[arg(long)] attributes. This causes clap to treat them as positional arguments, contradicting sprint-AD25.md documented `--team <team> --kind <kind>` flag syntax. Finding predates AD25-QA-2, was not promoted in that round, and teams.rs was not modified by that fix round." ;
  triage:category "ATM-QA" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:severity "important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T00:00:00Z"^^xsd:dateTime ;
