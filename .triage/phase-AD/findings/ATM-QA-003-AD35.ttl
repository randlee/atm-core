<urn:atm:triage:finding/ATM-QA-003-AD35>
  a triage:Finding ;
  triage:findingId "ATM-QA-003-AD35" ;
  triage:title "No test for cross-agent ack reply not re-promoted into pending-ack scenario" ;
  triage:description "There is no test anywhere in the test suite asserting that when an agent sends an ack-reply message to another agent, that ack-reply itself does not get re-promoted back into the recipient's pending-ack queue (which would create an infinite ack-ack loop)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:category "ATM-QA" ;
  triage:severity "blocking" ;
  triage:status "open" ;
