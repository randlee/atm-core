<urn:atm:triage:finding/AD16-DROP-001>
  a triage:Finding ;
  triage:findingId "AD16-DROP-001" ;
  triage:title "Undocumented blocking Drop behavior" ;
  triage:description "Drop impl for GraftSession calls close_internal() which performs blocking thread join (waiting for receive loop thread) without documentation explaining this blocking behavior. Regression: documentation was present in AD.14/15, removed in AD.16/17." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "minor" ;
  triage:severity "minor" ;
