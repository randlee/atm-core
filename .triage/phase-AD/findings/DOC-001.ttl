<urn:atm:triage:occurrence/DOC-001/S1/1>
  a triage:Occurrence ;
  triage:file "CLAUDE.md" ;
  triage:line 150 ;
  triage:snippet ".atm.toml at repo root sets `identity = \"team-lead\"` and `default_team = \"atm-dev\"`, so all ATM CLI commands automatically use the correct identity and team. No need to prefix with `ATM_IDENTITY=` or `--team`." ;
