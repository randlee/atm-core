<urn:atm:triage:finding/DOC-001>
  a triage:Finding ;
  triage:findingId "DOC-001" ;
  triage:title "CLAUDE.md still documents .atm.toml [atm].identity fallback, contradicting AD.2's own acceptance criterion" ;
  triage:description "CLAUDE.md:150 says '.atm.toml at repo root sets identity ... no need to prefix with ATM_IDENTITY=' -- directly contradicts AD.2's acceptance criterion that ATM_IDENTITY (env or explicit override) is the only accepted runtime identity source. CLAUDE.md was an explicit Exact Target in sprint-AD2.md left unmodified. Found by quality-mgr during AD.2-QA-1 on PR #450." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "DOC" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "closed" ;
  triage:dispatchReady false ;
