<urn:atm:triage:finding/AUDIT-COMMAND-MISLABEL-001>
  a triage:Finding ;
  triage:findingId "AUDIT-COMMAND-MISLABEL-001" ;
  triage:title "peek's audit CommandEvent hardcodes command:\"read\", indistinguishable from atm read in audit trail" ;
  triage:description "CommandEvent hardcodes command: \"read\" even when called via peek, despite a CommandAction::Peek variant already existing and being unused for this purpose. This makes peek and read indistinguishable in the audit trail." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "AUDIT-COMMAND-MISLABEL" ;
  triage:severity "minor" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:highestOpenBranch "AD.35" ;
  triage:promoteTowardsBranch "AD.35" ;
