<urn:atm:triage:finding/BLOCKING-PRECEDENCE-UNTESTED>
  a triage:Finding ;
  triage:findingId "BLOCKING-PRECEDENCE-UNTESTED" ;
  triage:title "Nudge template precedence rules lack regression test coverage" ;
  triage:description "In internal_nudge.rs:172-186 and hook.rs:93-118 on feature/pAD-s21-built-in-nudge-hardening (AD.21), the sprint doc's Acceptance Criteria require regression tests proving (a) external post_send_hooks still wins over the built-in path, and (b) an override row replaces only its addressed template kind while other kinds fall back to default. Neither test exists. The same missing tests propagate through feature/pAD-s22-built-in-nudge-hardening-part2 (AD.22), which depends on AD.21 completion." ;
  triage:category "blocking" ;
