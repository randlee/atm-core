<urn:atm:triage:finding/CI-001>
  a triage:Finding ;
  triage:findingId "CI-001" ;
  triage:title "10 tests fail under real CI conditions (ATM_IDENTITY/ATM_TEAM unset)" ;
  triage:description "CORRECTION PASS: prior initial_pass incorrectly marked AD.1 as fixed without running tests. Actual test execution with env -u ATM_IDENTITY -u ATM_TEAM cargo test --workspace confirms: AD.1-3 FAIL, AD.4+ PASS. The fix was implemented in sprint AD.4 (feature/pAD-s4-reconcile-runtime-removal). All 10 tests (commands::ack::tests::build_request_rejects_empty_message_id, build_request_rejects_whitespace_only_message_id, commands::clear::tests::build_query_rejects_invalid_target_before_core, commands::list::tests::build_query_preserves_limit_and_filters, commands::log::tests::run_snapshot_reads_real_retained_log_without_daemon, run_snapshot_succeeds_with_fake_observability_snapshot, run_snapshot_surfaces_observability_query_error, commands::members::tests::run_lists_member_roster_without_daemon, commands::read::tests::build_query_propagates_filters_and_exact_message_id, commands::send::tests::build_request_supports_file_with_trailing_inline_note) now pass in AD.4+. Branches AD.1-3 still require fix." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:category "CI" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "workspace test suite: log, members, list, read, send, clear, ack command tests" ;
  triage:pattern "test-suite-depends-on-ambient-shell-env-not-explicit-context" ;
  triage:status "fixed" ;
  triage:dispatchReady false ;
  triage:triagedAt "2026-07-03T16:20:00Z"^^xsd:dateTime ;
