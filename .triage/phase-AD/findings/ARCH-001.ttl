<urn:atm:triage:finding/ARCH-001>
  a triage:Finding ;
  triage:findingId "ARCH-001" ;
  triage:title "NudgeTemplateOverrideStore boundary not updated for AD.25 live wiring" ;
  triage:description "Sprint AD.25 wires atm-daemon-bootstrap (crates/atm-daemon-bootstrap/src/lib.rs:40-46) and atm (crates/atm/src/commands/internal_nudge.rs:19,174-178; crates/atm/src/commands/teams.rs:230,254,273) as live dependents/referencers of NudgeTemplateOverrideStore. The boundary TOML file was never updated to add these dependents to [dependencies].allowed_dependents, and the contradictory forbidden entry for atm::commands::internal_nudge was not reconciled. The precedent in boundaries/atm-core/roster-store.toml includes similar dependents with an explanatory comment." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RULE-012" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
