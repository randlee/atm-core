<urn:atm:triage:finding/AD-LEGACY-STORAGE-ADAPTERS-001>
  a triage:Finding ;
  triage:findingId "AD-LEGACY-STORAGE-ADAPTERS-001" ;
  triage:title "legacy_storage_adapters module is a self-documented temporary compile bridge pending AC.4 consumer cutover" ;
  triage:description "Discovered during the Phase-AD phase-ending review's follow-up 'legacy message key' investigation. crates/atm-runtime/src/lib.rs:10 and crates/atm-runtime/src/composition.rs:15 both declare 'mod legacy_storage_adapters;', marked #[allow(deprecated, reason=\"AC.4 keeps the legacy mail bootstrap surface as a temporary compile bridge until atm-core consumer cutover is complete.\")]. The whole module is self-documented as a temporary bridge pending the AC.4 atm-core consumer cutover. Repo owner explicitly directed that this be removed in the next cleanup pass once that cutover is confirmed complete; recorded here so it is tracked rather than forgotten." ;
  triage:category "cleanup/dead-code-scheduled" ;
  triage:phaseId "phase-AD" ;
