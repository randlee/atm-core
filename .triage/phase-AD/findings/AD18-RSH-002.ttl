  a triage:Finding ;
  triage:findingId "AD18-RSH-002" ;
  triage:title "ATM_HOME has no length/UTF-8 bound" ;
  triage:description "rust-service-hardening RSH-002: ATM_HOME environment variable lacks length and UTF-8 validation bounds. Same root cause as AD18-RSH-001 in crates/atm-core/src/home.rs — input validation gap in the atm_home() function. Could surface as obscure low-level socket-path errors deep in an unrelated subsystem." ;
