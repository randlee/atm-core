<urn:atm:triage:finding/AD9-AUTHCHECK-001>
  a triage:Finding ;
  triage:findingId "AD9-AUTHCHECK-001" ;
  triage:title "caller_identity/caller_team plumbed into UpdateMemberRequest but never read by update_member_from_roster_store -- no auth check, no audit trail" ;
  triage:description "AD.9-QA-1 verdict (important, QA-001) on branch feature/pAD-s9-update-member-cli-and-roster-repair-path (PR #457) reports caller_identity and caller_team fields are threaded into UpdateMemberRequest but the actual mutation function update_member_from_roster_store never reads them -- meaning no authorization check is performed and no audit trail is recorded for who performed the update, despite this being an explicit sprint acceptance criterion (caller identity/team enforcement)." ;
  triage:category "AD9" ;
  triage:severity "important" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm-core/src/team_admin.rs (UpdateMemberRequest, update_member_from_roster_store), crates/atm/src/commands/members.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-03T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD9-AUTHCHECK-001/s9/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD9-AUTHCHECK-001/s10/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD9-AUTHCHECK-001/s11/1> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s9/138e85ea> ;
