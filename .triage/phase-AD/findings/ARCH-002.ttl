<urn:atm:triage:finding/ARCH-002>
  a triage:Finding ;
  triage:findingId "ARCH-002" ;
  triage:title "RULE-012 boundary-doc update skipped for NudgeTemplateOverrideStore widening" ;
  triage:description "AD25-QA-2 verdict found that boundaries/atm-core/nudge-template-override-store.toml's allowed_dependents was correctly widened to include atm-daemon-bootstrap and atm (fixing ARCH-001's TOML side), and the contradictory forbidden entry for atm::commands::internal_nudge was correctly removed -- but docs/atm-core/boundaries.md:179-201 (the paired human-readable boundary record RULE-012 requires be updated as part of the mandatory relaxation path) was NOT updated to reflect either change." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
