<urn:atm:triage:finding/CI-ACK-FIXTURE-001>
  a triage:Finding ;
  triage:findingId "CI-ACK-FIXTURE-001" ;
  triage:title "pending_ack_message() test fixture missing requires_ack:true breaks cargo test --workspace on all 3 CI platforms" ;
  triage:description "req-qa (ATM-QA-004 on AD.32) reports crates/atm/src/composition.rs's pending_ack_message() test fixture sets pending_ack_at but never sets requires_ack:true on the seeded InboxMessage. Since ack eligibility is now gated purely on the durable requires_ack-derived AckState, the seeded envelope is ineligible for acknowledgement, breaking loopback_transport_ack_appends_reply_without_daemon (composition.rs:1325) and cli_composition_supports_graft_client_surface_without_daemon (composition.rs:1362) -- both assert .ack()/.acknowledge_message() succeeds. This is the confirmed likely cause of Test failing on macos/ubuntu/windows CI on both PR #503 and #504." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "CI-ACK" ;
  triage:severity "blocking" ;
  triage:repeatable false ;
  triage:sweepScope "crates/atm/src/composition.rs" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T20:25:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-ACK-FIXTURE-001/AD31/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/CI-ACK-FIXTURE-001/AD32/1> ;
