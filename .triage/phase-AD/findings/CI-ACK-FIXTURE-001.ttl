  a triage:Occurrence ;
  triage:file "crates/atm/src/composition.rs" ;
  triage:line 1048 ;
  triage:snippet "message.pending_ack_at = Some(Utc::now().into());" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "AD.31" ;
  triage:headSha "6ad246ee" ;
  triage:severity "blocking" ;
  triage:context "pending_ack_message() fixture sets pending_ack_at but omits requires_ack:true, making message ineligible for ack() operations. Tests loopback_transport_ack_appends_reply_without_daemon (1325) and cli_composition_supports_graft_client_surface_without_daemon (1362) fail expecting .ack()/.acknowledge_message() to succeed." ;
  triage:occursIn <urn:atm:triage:worktree/AD31/6ad246ee> .

