<urn:atm:triage:finding/AD16-TMPPATH-001>
  a triage:Finding ;
  triage:findingId "AD16-TMPPATH-001" ;
  triage:title "New hardcoded /tmp/... path literals in atm-graft test fixtures" ;
  triage:description "crates/atm-graft/src/lib.rs:631,699,700,714,715,734,735 and crates/atm-graft/src/runtime.rs:419,481,526,598 contain new hardcoded /tmp/... PathBuf literals introduced on pAD-s16, confirmed absent from integrate/phase-AD baseline. Violates docs/cross-platform-guidelines.md ban on hardcoded /tmp paths. Reported by rust-qa-agent as QA-001 in AD16-QA-1 (PR #481). Fix: replace with tempfile::tempdir()-derived paths, already used elsewhere in the same test modules." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "FTQ" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
