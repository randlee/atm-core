<urn:atm:triage:finding/AD30-QA-002>
  a triage:Finding ;
  triage:findingId "AD30-QA-002" ;
  triage:title "direct-fix-track.md lacks substantive accepted-line evidence for AD9-BLANKPANE-001/ERRDOC-001 (adjudicated dispute)" ;
  triage:description "direct-fix-track.md restates the requirement table but does not cite actual accepted-line evidence. Team-lead ruling: since AD.30 is the final phase-closure sprint, the substantive-evidence bar (req-qa's reading) applies, not the literal-presence bar. The file must cite concrete accepted-line evidence (code, tests, or documentation) that closes the specified acceptance criteria." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
