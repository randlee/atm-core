<urn:atm:triage:finding/ACK-INTENT-DUP-CONSTRUCTION-001>
  a triage:Finding ;
  triage:findingId "ACK-INTENT-DUP-CONSTRUCTION-001" ;
  triage:title "three-field ack-intent invariant hand-duplicated at every construction site instead of one constructor" ;
  triage:description "The three-field ack-intent invariant (requires_ack, pending_ack_at, acknowledged_at) is hand-duplicated at multiple construction sites across ack/mod.rs, threading.rs, send/mod.rs and related modules instead of being derived from a single centralized constructor. This lacks compile-time protection against future drift." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "RBP-F002" ;
  triage:severity "minor" ;
  triage:repeatable true ;
  triage:sweepScope "workspace" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-09T22:30:00Z"^^xsd:dateTime ;
