<urn:atm:triage:finding/AD14-RSH-002>
  a triage:Finding ;
  triage:findingId "AD14-RSH-002" ;
  triage:title "Advisory-stream connections can starve the unary control plane" ;
  triage:description "MAX_CONCURRENT_CONNECTIONS = 64 (local_ipc_transport.rs) but each open advisory stream held a connection slot for its full session lifetime, while MAX_ADVISORY_SESSIONS = 128 (advisory_runtime.rs) permitted double that many concurrent sessions -- a burst of long-lived graft streams could exhaust the connection cap and start rejecting Send/List/Doctor/Heartbeat traffic. Reported on AD14-QA-1 (PR #478). AD15-QA-1 (PR #480) reports this is now CLOSED as a direct, correct side effect of AD.15's daemon-side advisory runtime deletion (rust-service-hardening-agent confirmed)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:category "RSH" ;
  triage:severity "important" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime ;
