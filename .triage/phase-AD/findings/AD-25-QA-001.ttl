<urn:atm:triage:finding/AD-25-QA-001>
  a triage:Finding ;
  triage:findingId "AD-25-QA-001" ;
  triage:title "Missing direct schema-upgrade migration test" ;
  triage:description "The schema-upgrade migration path (ensure_team_nudge_template_override_columns: ALTER TABLE ADD COLUMN mode ... then UPDATE legacy empty rows to disabled) is not directly tested with a pre-migration fixture DB lacking the mode column. Only the load-time normalize_loaded_override_mode path (a separate, independently-tested mechanism) is exercised by sqlite_override_store_migrates_legacy_empty_rows_to_disabled, because ensure_schema already runs (creating the column) before that test manually inserts its legacy row. This mirrors pre-existing convention: ensure_mail_message_columns and ensure_team_roster_columns also lack dedicated schema-upgrade-path tests." ;
  triage:phaseId "phase-AD" ;
  triage:category "QA" ;
  triage:severity "minor" ;
  triage:triageMode "followup_pass" ;
