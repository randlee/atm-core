<urn:atm:triage:finding/AD7-TIMEOUT-001>
  a triage:Finding ;
  triage:findingId "AD7-TIMEOUT-001" ;
  triage:title "Unbounded tmux subprocess calls with no timeout in local post-send emitter" ;
  triage:description "AD.7-QA-1 verdict (PR #455, important finding) reports unbounded tmux subprocess calls with no timeout in the local-tmux post-send emitter path. Subprocess calls via Command::new(\"tmux\").output() will hang indefinitely if tmux server becomes unresponsive. The s11 branch fixed the timeout gap at commit 26c57de5; earlier sprint branches remain open until the standard merge-forward lands on integrate/phase-AD." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:category "AD7" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-03T19:45:22Z"^^xsd:dateTime ;
  triage:highestOpenBranch "feature/pAD-s10-directory-metadata-and-doctor-contract-cleanup" ;
