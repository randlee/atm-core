<urn:atm:triage:finding/AD18-RBP-F001>
  a triage:Finding ;
  triage:findingId "AD18-RBP-F001" ;
  triage:title "bootstrap()'s invocation_dir/atm_home params are not type-distinguished" ;
  triage:description "rust-best-practices RBP-F001: bootstrap()'s invocation_dir and atm_home parameters are both bare &Path with no type-level distinction across all call sites -- a future refactor could silently transpose them." ;
