<urn:atm:triage:finding/AD18-ARCH-004>
  a triage:Finding ;
  triage:findingId "AD18-ARCH-004" ;
  triage:title "RULE-001 scope ambiguity -- output.rs/commands/log.rs reference sc_observability_types" ;
  triage:description "crates/atm/src/output.rs and crates/atm/src/commands/log.rs reference sc_observability_types, but these are binary-crate-internal modules (not a separate library crate). Arch-qa flagged this as needing an explicit team-lead scope ruling on whether RULE-001's 'library crate' zero-tolerance policy extends to binary-crate-internal modules, rather than a clear-cut violation." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "ARCH" ;
  triage:severity "important" ;
  triage:repeatable true ;
  triage:sweepScope "crates/atm/src/output.rs, crates/atm/src/commands/log.rs" ;
  triage:status "open" ;
  triage:dispatchReady false ;
  triage:requiresScopeRuling true ;
  triage:scopeRulingReason "Ambiguity: RULE-001 scope coverage for binary-crate-internal modules vs library-only crates. Requires explicit team-lead guidance on policy intent before fix dispatch." ;
  triage:triagedAt "2026-07-06T11:05:00Z" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD18-ARCH-004/pAD-s13/1> ;
