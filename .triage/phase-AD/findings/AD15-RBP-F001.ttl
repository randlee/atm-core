<urn:atm:triage:finding/AD15-RBP-F001>
  a triage:Finding ;
  triage:findingId "AD15-RBP-F001" ;
  triage:title "atm-graft client's advisory session/stream surface still fully wired to a daemon protocol that no longer exists" ;
  triage:description "crates/atm-graft/src/{lib.rs,transport.rs,runtime.rs} -- AdvisorySessionPort's register/unregister/fetch/drain/open_advisory_stream methods connect to resolve_daemon_local_ipc_endpoint() (the same socket as ordinary CLI traffic) and encode graft-specific message kinds (0x0008-0x100c, defined in atm-daemon-client/src/graft_rpc.rs) that atm-core/src/protocol.rs::MessageKind::try_from does not recognize -- any real invocation surfaces a generic, misleadingly-worded protocol-version-skew validation error instead of a clean typed failure." ;
  triage:category "RBP" ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady false ;
  triage:highestOpenBranch "feature/pAD-s15-daemon-advisory-runtime-deletion" ;
  triage:highestFixedBranch "feature/pAD-s16-thin-graft-receiver-reset" ;
  triage:promoteToBranch "feature/pAD-s15-daemon-advisory-runtime-deletion" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/AD15-RBP-F001/pAD-s15/1> ;
  triage:openOn <urn:atm:triage:worktree/pAD-s15/0ab5d105> ;
  triage:fixedOn <urn:atm:triage:worktree/pAD-s16/c4653158> ;
  triage:triagedAt "2026-07-06T00:00:00Z"^^xsd:dateTime .

