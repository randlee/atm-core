<urn:atm:triage:finding/ACKMODE-DEAD-PARAM-001>
  a triage:Finding ;
  triage:findingId "ACKMODE-DEAD-PARAM-001" ;
  triage:title "AckActivationMode is a single-variant enum still threaded as a live parameter, masking the peek-mutation bug" ;
  triage:description "arch-qa (ARCH-002 on AD.32) reports AckActivationMode is now a single-variant enum (ReadOnly only) but is still threaded as a live parameter through ReadQuery/apply_display_mutations_to_store/CLI/graft call sites where it can never vary -- dead structural weight that also masked PEEK-MUTATION-001 (the peek-mutation bug, since a single-variant enum gives the false impression of a real intent-branch when there is none)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "AckActivationMode call sites in ReadQuery/apply_display_mutations_to_store/CLI/graft" ;
  triage:category "structural" ;
  triage:severity "important" ;
  triage:status "fixed_partial" ;
  triage:dispatchReady true ;
  triage:relatedFinding "PEEK-MUTATION-001" ;
  triage:relatedFindingNote "Directly related to PEEK-MUTATION-001 (same root file/region); should likely be fixed together but tracked separately due to distinct structural complaint (dead parameter vs. missing behavior)" ;
  triage:highestOpenBranch "AD.35" ;
  triage:promoteTowardBranch "AD.35" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ACKMODE-DEAD-PARAM-001/AD32/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/ACKMODE-DEAD-PARAM-001/AD33/1> ;
