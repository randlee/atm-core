<urn:atm:triage:finding/ACKMODE-DEAD-PARAM-001>
  a triage:Finding ;
  triage:findingId "ACKMODE-DEAD-PARAM-001" ;
  triage:title "AckActivationMode is a single-variant enum still threaded as a live parameter, masking the peek-mutation bug" ;
  triage:description "arch-qa (ARCH-002 on AD.32) reports AckActivationMode is now a single-variant enum (ReadOnly only) but is still threaded as a live parameter through ReadQuery/apply_display_mutations_to_store/CLI/graft call sites where it can never vary -- dead structural weight that also masked PEEK-MUTATION-001 (the peek-mutation bug, since a single-variant enum gives the false impression of a real intent-branch when there is none). AD35-QA-2 confirms finding status unchanged: AckActivationMode remains a single-variant enum still threaded live with no behavioral branching. Per ATM-QA-007 language, 'dead parameter, not removed.' Reconciled with single canonical ACKMODE-DEAD-PARAM-001 record per AD35-QA-2 notes (do not create separate ATM-QA-007-AD35 entry)." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "followup_pass" ;
  triage:repeatable false ;
  triage:sweepScope "crate" ;
  triage:category "structural" ;
  triage:severity "important" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:relatedFinding "PEEK-MUTATION-001" ;
  triage:relatedFindingNote "Directly related to PEEK-MUTATION-001 (same root file/region); should likely be fixed together but tracked separately due to distinct structural complaint (dead parameter vs. missing behavior)" ;
  triage:highestOpenBranch "AD.35" ;
  triage:promoteTo <urn:atm:triage:worktree/AD35/afdaf3c5d16f2560ea9b86a58becd85458a0cd91> ;
