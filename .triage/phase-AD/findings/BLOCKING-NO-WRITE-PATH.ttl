<urn:atm:triage:finding/BLOCKING-NO-WRITE-PATH>
  a triage:Finding ;
  triage:findingId "BLOCKING-NO-WRITE-PATH" ;
  triage:title "NudgeTemplateOverrideStore has no write/save method or CLI surface" ;
  triage:description "In nudge_template_override_store.rs, the NudgeTemplateOverrideStore trait only exposes load_template_override() for reads. There is no write, save, create, or update method on the trait. The boundary is incomplete. Production code cannot create or update nudge template override rows; only raw SQL in tests can insert them. This makes the deliverable operationally unusable." ;
  triage:phaseId "phase-AD" ;
  triage:triageMode "initial_pass" ;
  triage:category "blocking" ;
  triage:severity "blocking" ;
  triage:repeatable true ;
  triage:sweepScope "crate" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:triagedAt "2026-07-08T00:00:00Z"^^xsd:dateTime ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BLOCKING-NO-WRITE-PATH/s21/1> ;
  triage:hasOccurrence <urn:atm:triage:occurrence/BLOCKING-NO-WRITE-PATH/s22/1> ;
  triage:openOn <urn:atm:triage:worktree/s21/7543fa7> ;
