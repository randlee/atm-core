---
metadata:
  name: benchmark-phase-report
  description: Offline benchmark candlesticks and immutable campaign panels for one phase
required_variables:
  - title
  - phase
  - charts
  - campaigns
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title | e }}</title>
  <style>
    body { font: 16px system-ui,sans-serif; max-width: 90rem; margin: 2rem auto; padding: 0 1rem; color:#1f2937 } .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem } .chart { border:1px solid #cbd5e1; padding:.5rem } .candle.FAIL rect { fill:none; stroke:#dc2626; stroke-width:3 } .candle.PASS rect { stroke-width:1 } .baseline { stroke-dasharray:4 3; stroke-width:1.5 } table { width:100%; border-collapse:collapse } th,td { border:1px solid #cbd5e1;padding:.45rem;text-align:left } th { background:#f1f5f9 } .panel { margin:2rem 0;border-top:2px solid #94a3b8 }
  </style>
</head>
<body>
  <h1>{{ title | e }}</h1><p>Phase {{ phase | e }}. Charts use immutable campaign values; times default to Pacific and localize in the viewer.</p>
  <section class="grid" aria-label="Benchmark candlesticks">
{% for chart in charts %}
    <article class="chart" data-target="{{ chart.target | e }}"><h2>{{ chart.label | e }}</h2><svg viewBox="0 0 560 230" role="img" aria-label="{{ chart.label | e }} candlestick chart"><line x1="50" y1="200" x2="550" y2="200" stroke="#475569" /><line x1="50" y1="20" x2="50" y2="200" stroke="#475569" />
{% for line in chart.baseline_lines %}<line class="baseline" x1="50" y1="{{ line.y }}" x2="550" y2="{{ line.y }}" stroke="{{ line.color | e }}" /><text x="52" y="{{ line.y }}" fill="{{ line.color | e }}">{{ '%.0f' | format(line.floor) }}</text>{% endfor %}
{% for candle in chart.candles %}<g class="candle {{ candle.status | e }}" data-target="{{ chart.target | e }}" data-host="{{ candle.host_label | e }}"><line x1="{{ candle.x }}" y1="{{ candle.low }}" x2="{{ candle.x }}" y2="{{ candle.high }}" stroke="{{ candle.color | e }}" /><rect x="{{ candle.x - 6 }}" y="{{ candle.p95 }}" width="12" height="{{ candle.p50 - candle.p95 }}" fill="{{ candle.color | e }}" /><line x1="{{ candle.x - 8 }}" y1="{{ candle.p50 }}" x2="{{ candle.x + 8 }}" y2="{{ candle.p50 }}" stroke="{{ candle.color | e }}" stroke-width="3" /><title>{{ candle.host_label | e }}</title></g>{% endfor %}
    </svg><p>Range {{ '%.0f' | format(chart.axis_min) }}–{{ '%.0f' | format(chart.axis_max) }} msg/sec.{% for series in chart.series %} <span style="color:{{ series.color | e }}">● {{ series.host_label | e }}</span>{% endfor %}</p><ol class="chart-axis">{% for candle in chart.candles %}<li><time datetime="{{ candle.timestamp.datetime | e }}">{{ candle.timestamp.text | e }}</time> · {{ candle.host_label | e }}</li>{% endfor %}</ol></article>
{% endfor %}
  </section>
{% for campaign in campaigns %}
  <article class="panel" data-campaign="{{ campaign.campaign_id | e }}"><h2>{{ campaign.host_label | e }} · <code>{{ campaign.source_revision | e }}</code></h2><p><time datetime="{{ campaign.started_at.datetime | e }}">{{ campaign.started_at.text | e }}</time> · <strong>{{ campaign.status | e }}</strong></p><table><thead><tr><th>Test</th><th>p50</th><th>p95</th><th>p99</th><th>Durable write proof</th><th>Baseline</th><th>Margin</th><th>Verdict</th></tr></thead><tbody>{% for row in campaign.rows %}<tr data-target="{{ row.target | e }}"><td>{{ row.label | e }}</td><td>{{ 'n/a' if row.p50 is none else '%.2f' | format(row.p50) }}</td><td>{{ 'n/a' if row.p95 is none else '%.2f' | format(row.p95) }}</td><td>{{ 'n/a' if row.p99 is none else '%.2f' | format(row.p99) }}</td><td>{{ row.durable_counts | e }}</td><td>{{ 'n/a' if row.baseline is none else '%.2f' | format(row.baseline) }}</td><td>{{ 'n/a' if row.margin is none else '%+.2f' | format(row.margin) }}</td><td>{{ row.status | e }}</td></tr>{% endfor %}</tbody></table>{% if campaign.incomplete_reason %}<aside><strong>Incomplete campaign:</strong> {{ campaign.incomplete_reason | e }}</aside>{% endif %}</article>
{% endfor %}
  <script>(() => { const f = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short", hourCycle: "h23", timeZoneName: "short" }); document.querySelectorAll("time[datetime]").forEach((node) => { node.textContent = f.format(new Date(node.dateTime)); }); })();</script>
</body>
</html>
