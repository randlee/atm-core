---
required_variables:
  - title
  - generated_at
  - status
  - source_revision
  - image_digest
  - container
  - procedure_label
  - procedure_href
  - procedure_note
  - sections_html
defaults: {}
metadata:
  purpose: One colima integration run; verdict banner, provenance, then every step panel in order
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title | e }}</title>
    <style>
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, sans-serif; color: #1b1b1b; }
      header { padding: 1rem 2rem; border-bottom: 1px solid #c9c9c9; }
      header p { margin: .25rem 0 0; color: #555; }
      .banner { display: inline-block; font-weight: 700; font-size: 1.1rem; padding: .2rem .7rem; border-radius: .3rem; margin-left: .5rem; }
      .pass { background: #e8f5e9; color: #1a7f37; } .fail { background: #ffebee; color: #c62828; }
      main { padding: 1rem 2rem; }
      section { border: 1px solid #c9c9c9; border-radius: .25rem; overflow: hidden; margin: 0 0 1.25rem; }
      section h2 { font-size: 1rem; margin: 0; padding: .7rem 1rem; background: #f7f9fa; display: flex; gap: 1rem; align-items: baseline; }
      section h2 .verdict { font-weight: 700; padding: 0 .5rem; border-radius: .25rem; }
      section h2 a { font-weight: normal; font-size: .85rem; margin-left: auto; color: #0b57d0; }
      iframe { border: 0; display: block; width: 100%; min-height: 40rem; }
      code { font-size: .9em; }
    </style>
  </head>
  <body>
    <header>
      <strong>{{ title | e }}</strong><span class="banner {{ status | lower | e }}">{{ status | e }}</span>
      <p>Generated {{ generated_at | e }} · Test plan: <a href="{{ procedure_href | e }}">{{ procedure_label | e }}</a>{{ procedure_note | e }}</p>
      <p>Source revision <code>{{ source_revision | e }}</code> · Container <code>{{ container | e }}</code> · Image <code>{{ image_digest | e }}</code></p>
    </header>
    <main>{{ sections_html | safe }}</main>
  </body>
</html>
