---
required_variables:
  - title
  - generated_at
  - pane_html
defaults: {}
metadata:
  purpose: Browser-friendly combined review page for ATM peer-smoke XHTML panes
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <style>
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, sans-serif; color: #1b1b1b; }
      header { padding: 1rem 2rem; border-bottom: 1px solid #c9c9c9; }
      header p { margin: .25rem 0 0; color: #555; }
      main { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(38rem, 1fr)); padding: 1rem; }
      section { border: 1px solid #c9c9c9; border-radius: .25rem; overflow: hidden; }
      section h2 { font-size: 1rem; margin: 0; padding: .7rem 1rem; background: #f7f9fa; }
      iframe { border: 0; display: block; width: 100%; min-height: 32rem; }
    </style>
  </head>
  <body>
    <header><strong>{{ title }}</strong><p>Generated {{ generated_at }}</p></header>
    <main>{{ pane_html }}</main>
  </body>
</html>
