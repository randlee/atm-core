---
name: scoop-manifest
version: 1.0.0
description: Scoop manifest rendered by sc-publish for the Windows release asset.
format: json
required_variables:
  - version
  - description
  - homepage
  - license
  - windows_url
  - windows_sha256
  - extract_dir
  - binary
---
{
  "version": {{ version | tojson }},
  "description": {{ description | tojson }},
  "homepage": {{ homepage | tojson }},
  "license": {{ license | tojson }},
  "architecture": {
    "64bit": {
      "url": {{ windows_url | tojson }},
      "hash": {{ windows_sha256 | tojson }},
      "extract_dir": {{ extract_dir | tojson }},
      "bin": {{ binary | tojson }}
    }
  }
}
