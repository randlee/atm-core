# Git hooks are POSIX shell scripts executed by Git's bundled sh on every
# platform, including Git for Windows. A CRLF checkout (core.autocrlf=true)
# breaks the shebang line, so pin LF regardless of the client's autocrlf.

# Templates embedded with include_str! must retain LF across CRLF checkouts.
crates/atm-core/templates/* text eol=lf
crates/atm/assets/cli-reference/* text eol=lf
docs/user-documents/cli-reference.md text eol=lf
site/cli/index.html text eol=lf
site/cli/cli-reference.css text eol=lf
site/cli/cli-reference.js text eol=lf
crates/atm/tests/cli_surface_baseline.json text eol=lf

# The sc-lint kit-drift check byte-compares these managed files with the LF
# output of plugins/sc-lint/install.py, so a CRLF checkout reads as drift.
sc-lint.toml text eol=lf
Justfile text eol=lf
.sc-lint/install.json text eol=lf
